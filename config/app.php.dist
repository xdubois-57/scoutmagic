<?php

return [
    'debug' => false,
    'site_name' => 'Unité scoute',
    'base_url' => 'http://localhost',

    // ScoutMagic is never served publicly over HTTP. While this is true
    // the session cookie is always Secure and Strict-Transport-Security
    // is always sent, whatever scheme PHP itself sees — which is what a
    // host terminating TLS in front of PHP needs. Set it to false only
    // for a development or test server deliberately running over plain
    // http://. See SECURITY.md § 9.
    'https_required' => true,

    // Trust the "X-Forwarded-Proto" header to tell whether the visitor
    // reached the site over HTTPS. Leave this false unless a TLS
    // terminator you control (load balancer, CDN, reverse proxy) sits in
    // front of this installation AND rewrites that header on every
    // request. See SECURITY.md § 9 — turning it on where no such
    // terminator exists lets any visitor claim HTTPS, which breaks
    // sessions and emits a bogus HSTS header.
    'trust_forwarded_proto' => false,
];
