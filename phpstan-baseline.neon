parameters:
	ignoreErrors:
		-
			message: "#^Method Modules\\\\Registration\\\\Controller\\\\PublicRegistrationController\\:\\:buildPageContext\\(\\) has parameter \\$stickyValues with no value type specified in iterable type array\\.$#"
			count: 1
			path: modules/registration/src/Controller/PublicRegistrationController.php

		-
			message: "#^PHPDoc tag @param for parameter \\$stickyValues with type array\\<string, mixed\\>\\|null is not subtype of native type array\\.$#"
			count: 1
			path: modules/registration/src/Controller/PublicRegistrationController.php

		-
			message: "#^Method Modules\\\\Registration\\\\Service\\\\PassageService\\:\\:decryptName\\(\\) has parameter \\$firstNameEncrypted with no type specified\\.$#"
			count: 1
			path: modules/registration/src/Service/PassageService.php

		-
			message: "#^Method Modules\\\\Registration\\\\Service\\\\PassageService\\:\\:decryptName\\(\\) has parameter \\$lastNameEncrypted with no type specified\\.$#"
			count: 1
