<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true">
    <testsuites>
        <testsuite name="Core">
            <directory>tests/Core</directory>
        </testsuite>
        <testsuite name="Modules">
            <directory>tests/Modules</directory>
        </testsuite>
        <testsuite name="Bootstrap">
            <directory>tests/Bootstrap</directory>
        </testsuite>
        <!--
            Security and Integration existed as directories long before they
            were listed here, which meant `vendor/bin/phpunit` — the command
            CI runs, and the one scripts/release.sh's tests gate runs —
            never executed a single one of them. Eight files, including the
            SQL-injection, encryption, file-access and upload-MIME audits
            AGENTS.md § Security checklist leans on, silently stopped being
            run at all and drifted out of date. A test suite that is not in
            this file does not exist.
        -->
        <testsuite name="Security">
            <directory>tests/Security</directory>
        </testsuite>
        <testsuite name="Integration">
            <directory>tests/Integration</directory>
        </testsuite>
        <!--
            The module-boundary net (ARCHITECTURE.md §7.5): outside a
            module's own code, only its Api\ namespace may be named.
        -->
        <testsuite name="Architecture">
            <directory>tests/Architecture</directory>
        </testsuite>
    </testsuites>
    <!--
        No <groups><exclude> here, deliberately: every test runs by default,
        `database`-tagged ones included. That group used to be excluded so a
        machine without MySQL could still run the suite — but the exclusion
        applied everywhere the suite ran, so the `database` tests were absent
        from the coverage report CI feeds SonarQube Cloud, and whole modules
        whose tests are almost entirely `database`-tagged (groups, gallery)
        read as near-zero coverage on new code. Most of that group needs no
        MySQL at all (Tests\DatabaseTestHelper builds an in-memory SQLite
        database); only the six files reading TEST_DB_* env vars do, and CI
        provisions a MySQL service container for them. See README.md
        § Intégration continue, and scripts/release.sh's own tests gate.
    -->
    <source>
        <include>
            <directory>core</directory>
            <directory>modules</directory>
        </include>
    </source>
</phpunit>
