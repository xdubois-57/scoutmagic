# Dependencies
vendor/
!public/assets/vendor/
node_modules/

# Environment and secrets
.env
.sonar-token
storage/keys/
storage/config/
storage/temp/
storage/finance/
storage/news/
storage/gallery/
storage/maintenance/
storage/core/
storage/mass_mail/
storage/section_documents/

# Local configuration
config/app.php

# IDE files
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# PHPUnit test cache
.phpunit.result.cache

# SonarQube Cloud analysis artifacts (generated in CI, never committed)
coverage.xml
phpunit-report.xml
.scannerwork/

# Vitest JavaScript coverage output (coverage/js/lcov.info — generated
# locally and in CI, never committed, see sonar-project.properties)
coverage/
*.vitest-temp/

# PHPStan cache
storage/temp/phpstan/

# Twig cache
storage/temp/twig_cache/

# Release artifacts
release-*.zip

# Claude Code: the SessionStart hook and the shared settings that register it
# are versioned (they are what makes `composer install`, phpunit and phpstan
# work in a Claude Code on the web session); everything else under .claude/,
# including per-developer settings.local.json, stays local.
.claude/*
!.claude/hooks/
!.claude/settings.json
.claude/settings.local.json
