# Dependencies
vendor/
!public/assets/vendor/
node_modules/

# Environment and secrets
.env
.sonar-token
# All runtime storage content is ignored so a new module writing to
# storage/<name>/ can never produce files that are untracked but NOT ignored
# (and so accidentally committed). .gitkeep files preserve the directory
# structure (audit hardening).
storage/**
!storage/**/
!storage/**/.gitkeep

# Local configuration
config/app.php

# IDE files
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# PHPUnit test cache
.phpunit.result.cache

# SonarQube Cloud analysis artifacts (generated in CI, never committed).
# coverage-e2e.xml is the end-to-end run's own Clover report, produced by
# `E2E_COVERAGE=1 npm run e2e` (scripts/e2e.sh) next to PHPUnit's.
coverage.xml
coverage-e2e.xml
phpunit-report.xml
.scannerwork/

# Vitest JavaScript coverage output (coverage/js/lcov.info — generated
# locally and in CI, never committed, see sonar-project.properties)
coverage/
*.vitest-temp/

# Playwright end-to-end output (tests/e2e/, scripts/e2e.sh — generated
# locally, in CI, and by the release E2E gate, never committed). The
# throwaway application instance and its database live outside the repo
# entirely (a mktemp directory) and are removed by the harness itself.
tests/e2e/test-results/
tests/e2e/playwright-report/
tests/e2e/.playwright-artifacts-*/
# ...and the same output at the repository root, which is where Playwright
# writes when it is invoked directly (`npx playwright test`) instead of
# through scripts/e2e.sh: `outputDir` in tests/e2e/playwright.config.js is
# relative to that config, so bypassing it falls back to Playwright's own
# default of ./test-results. A failed run committed its traces here once.
/test-results/
/playwright-report/

# PHPStan cache
storage/temp/phpstan/

# Twig cache
storage/temp/twig_cache/

# Release artifacts
release-*.zip

# Claude Code: the SessionStart hook and the shared settings that register it
# are versioned (they are what makes `composer install`, phpunit and phpstan
# work in a Claude Code on the web session); everything else under .claude/,
# including per-developer settings.local.json, stays local.
.claude/*
!.claude/hooks/
!.claude/settings.json
.claude/settings.local.json
