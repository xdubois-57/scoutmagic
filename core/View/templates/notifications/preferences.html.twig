{% extends 'base.html.twig' %}
{% block title %}Préférences de notification — {{ site_name }}{% endblock %}
{% block content %}
<div class="page-narrow" id="notification-preferences" data-vapid-public-key="{{ vapid_public_key }}">
    {% include 'partials/page_header.html.twig' with {
        title: 'Préférences de notification',
        subtitle: "Un canal grisé est fixé par le site et ne peut pas être modifié. La colonne « Push » reste désactivée tant que ton navigateur n'a pas donné la permission.",
    } only %}

    <p class="text-body-secondary small mb-3 d-none" id="push-permission-notice">
        La colonne « Push » est désactivée : active d'abord les notifications push pour cet appareil depuis
        <a href="/account">Mon compte</a>.
    </p>

    {% for group_name, items in groups %}
        <div class="card mb-3">
            <div class="card-body">
                <h2 class="h5 mb-3">{{ group_name }}</h2>
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead>
                            <tr>
                                <th scope="col">Type</th>
                                <th scope="col" class="text-center" style="width:90px;">Site</th>
                                <th scope="col" class="text-center" style="width:90px;">Push</th>
                                <th scope="col" class="text-center" style="width:90px;">Mail</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for item in items %}
                                <tr>
                                    <td>
                                        <div class="fw-semibold">{{ item.type.label }}</div>
                                        {#
                                          On a wide screen the explanation sits under its own
                                          label, where there is room for it. On a phone the
                                          "Type" column is whatever is left of 360px after
                                          three 90px switch columns — about a word per line —
                                          so the same sentence is rendered once more below,
                                          across the whole row (the `d-md-none` row further
                                          down). Two renderings, one source string.
                                        #}
                                        <div class="text-body-secondary small d-none d-md-block">{{ item.type.description }}</div>
                                    </td>
                                    {% for channel in ['in_app', 'push', 'email'] %}
                                        <td class="text-center">
                                            <div class="form-check form-switch d-inline-block">
                                                <input class="form-check-input notification-channel-toggle" type="checkbox" role="switch"
                                                       data-type-id="{{ item.type.id }}"
                                                       data-channel="{{ channel }}"
                                                       aria-label="{{ channel == 'in_app' ? 'Site' : (channel == 'push' ? 'Push' : 'Mail') }} — {{ item.type.label }}"
                                                       {% if channel == 'push' %}data-is-push="1"{% endif %}
                                                       {% if item.channels[channel].value %}checked{% endif %}
                                                       aria-checked="{{ item.channels[channel].value ? 'true' : 'false' }}"
                                                       {% if item.channels[channel].locked %}disabled{% endif %}>
                                            </div>
                                        </td>
                                    {% endfor %}
                                </tr>
                                {#
                                  Mobile only: the explanation on a line of its own, under
                                  the type and its switches. `border-0 pt-0` so it reads as
                                  a continuation of the row above rather than as an entry
                                  of its own.
                                #}
                                <tr class="d-md-none">
                                    <td colspan="4" class="border-0 pt-0 text-body-secondary small">
                                        {{ item.type.description }}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    {% endfor %}

    <div class="card mb-3">
        <div class="card-body">
            <h2 class="h5 mb-3">Heures calmes et discrétion</h2>
            <div class="row g-3 align-items-end">
                {# No `field_name`: notification-preferences.js reads these
                   by id and saves them itself. #}
                <div class="col-6 col-sm-3">
                    {% include 'partials/form_field.html.twig' with {
                        field_id: 'quiet-hours-start', label: 'Début (facultatif)', type: 'time',
                        value: quiet_hours_start ? quiet_hours_start[:5] : '',
                        size: 'sm', wrapper_class: '',
                    } only %}
                </div>
                <div class="col-6 col-sm-3">
                    {% include 'partials/form_field.html.twig' with {
                        field_id: 'quiet-hours-end', label: 'Fin', type: 'time',
                        value: quiet_hours_end ? quiet_hours_end[:5] : '',
                        size: 'sm', wrapper_class: '',
                    } only %}
                </div>
                <div class="col-12 col-sm-6">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" role="switch" id="notification-discretion" {% if notification_discretion %}checked{% endif %} aria-checked="{{ notification_discretion ? 'true' : 'false' }}">
                        <label class="form-check-label small" for="notification-discretion">
                            Discrétion — masquer le contenu sur l'écran verrouillé
                        </label>
                    </div>
                </div>
            </div>
            {#
              Said in the direction somebody actually reads it: what
              happens when the two boxes are FILLED IN. The old wording
              only explained the empty case, which is the state you are
              already in and the one you came here to leave.
            #}
            <p class="text-body-secondary small mt-2 mb-0">
                Renseigne un début et une fin : entre ces deux heures, aucune notification push ne
                s'affiche sur ton appareil — elle attend et arrive à la fin de la plage. Une plage qui
                passe minuit (22:00 → 07:00) fonctionne. Les notifications sur le site restent visibles
                à tout moment. Sans ces deux valeurs, c'est la plage générale du site qui s'applique.
            </p>
            <output class="text-success small mt-2 mb-0 d-none d-block" id="account-settings-saved-notice">Enregistré.</output>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script src="{{ asset('/assets/js/notification-preferences.js') }}" defer nonce="{{ csp_nonce }}"></script>
{% endblock %}
