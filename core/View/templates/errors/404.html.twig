{% extends "base.html.twig" %}

{% block title %}Page non trouvée — {{ site_name }}{% endblock %}

{% block content %}
<div class="text-center py-5">
    {# The status code is decoration; the words are the heading. #}
    <p class="display-1 text-muted mb-0" aria-hidden="true">404</p>
    <h1>Page non trouvée</h1>
    <p class="lead text-muted">La page que vous recherchez n'existe pas ou a été déplacée.</p>
    <a href="/" class="btn btn-primary mt-3">Retour à l'accueil</a>
</div>
{% endblock %}
