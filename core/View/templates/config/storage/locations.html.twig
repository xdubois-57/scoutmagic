{#
  « Stockage » — one card per location.

  A card each rather than a table, which is what the mockup asks for and
  what the content needs: an error sentence, a protection badge and a set
  of consequences do not fit in a cell, and the table this replaces had
  already been squeezed into seven columns on a phone.

  **What is shown is consequences, never capabilities** (D3). Nobody
  chooses a storage type on « lecture par plage d'octets » — the
  enumeration stays in the code and produces these sentences. The same
  source feeds the comparison table at the foot of the page (IT-07): the
  cards answer « what does THIS location do », the table answers « which
  kind should I declare next », and both are computed, so neither can
  contradict the other.
#}
{% extends 'base.html.twig' %}

{% block title %}Emplacements de stockage — {{ site_name }}{% endblock %}

{% block content %}
    {% include 'partials/page_header.html.twig' with {
        title: 'Stockage',
        subtitle: "Les destinations déclarées, et ce que chacune sait faire.",
        action_label: 'Ajouter un emplacement',
        action_url: '/config/stockage/emplacements/nouveau',
    } only %}

    {% include 'config/storage/_nav.html.twig' with {current_path: current_path} only %}

    {% for location in locations %}
        <div class="card mb-3" data-location-card="{{ location.id }}">
            <div class="card-body">
                <div class="d-flex flex-wrap align-items-center gap-2">
                    <span class="flex-grow-1 fw-medium">{{ location.label }}</span>
                    <span class="badge text-bg-secondary">{{ location.type.frenchLabel }}</span>
                    {% if location.isDefault %}
                        <span class="badge text-bg-primary">
                            <i class="bi bi-star-fill" aria-hidden="true"></i> Par défaut
                        </span>
                    {% endif %}
                    <span class="storage-location-status" data-location-id="{{ location.id }}">
                        {% if location.lastCheckOk == true %}
                            <span class="badge text-bg-success">Joignable</span>
                        {% elseif location.lastCheckOk == false %}
                            <span class="badge text-bg-danger">En erreur</span>
                        {% else %}
                            <span class="badge text-bg-secondary">Non testé</span>
                        {% endif %}
                    </span>
                    {# Computed by the rule the dashboard's « unprotected »
                       list uses (StorageConfigController::
                       locationsWithoutAWorkingCopy()): a relation that is
                       paused, has never completed a pass, or failed its last
                       one protects nothing tonight. Never from the type. #}
                    {% if location.id in unprotected_ids %}
                        <span class="badge text-bg-danger" data-protection="none">
                            <i class="bi bi-shield-exclamation" aria-hidden="true"></i> Non protégé par une sauvegarde
                        </span>
                    {% else %}
                        <span class="badge text-bg-success" data-protection="active">
                            <i class="bi bi-shield-check" aria-hidden="true"></i> Protégé par une sauvegarde
                        </span>
                    {% endif %}
                </div>

                <div class="small text-body-secondary text-break mt-1">{{ location.describe }}</div>

                {% if location.lastCheckOk == false and location.lastCheckError %}
                    <div class="alert alert-danger small mt-2 mb-0">{{ location.lastCheckError }}</div>
                {% endif %}

                {# What the last restore did to this location (#832). It
                   stays until somebody opens « Modifier » and saves: the
                   note asks to be looked at, and that is the looking. #}
                {% if location.reconciliationNote %}
                    <div class="alert alert-warning small mt-2 mb-0" data-reconciliation-note>
                        <strong>Après la restauration :</strong> {{ location.reconciliationNote }}
                        Enregistrez l'emplacement depuis « Modifier » une fois vérifié.
                    </div>
                {% endif %}

                {# A copy that failed its last pass says why, here: that is an
                   error the operator can act on (#718 § C point 10.6). #}
                {% set protection = protections[location.id] ?? null %}
                {% if protection and protection.lastError %}
                    <div class="alert alert-warning small mt-2 mb-0">{{ protection.lastError }}</div>
                {% endif %}

                {# ————— The Google connection, on the location's own card —————

                   IT-05: a Drive folder is a storage location, so the account,
                   the consent screen and the warning about it belong here and
                   not under « Sauvegarde hors site ». When the grant ends is
                   said from what Google announced (_drive_expiry.html.twig),
                   never guessed from the project's status. #}
                {% if location.type.value == 'google_drive' %}
                    {% set drive = drive_secrets[location.id] %}
                    <div class="border rounded p-3 mt-3">
                        <div class="d-flex flex-wrap align-items-center gap-2">
                            <span class="fw-medium small flex-grow-1">Compte Google</span>
                            {% if drive and drive.hasGrant %}
                                <span class="badge text-bg-success">Raccordé</span>
                            {% else %}
                                <span class="badge text-bg-secondary">Non raccordé</span>
                            {% endif %}
                        </div>

                        {% if drive and drive.hasGrant %}
                            <div class="small text-body-secondary mt-1">
                                {{ drive.account }}
                                {% if location.config.connectedAt %}
                                    — depuis le {{ location.config.connectedAt|date_fr }}
                                {% endif %}
                            </div>
                        {% endif %}

                        {% include 'config/storage/_drive_expiry.html.twig' with {
                            expiry: drive_expiries[location.id] ?? null,
                        } only %}
                    </div>
                {% endif %}

                {# The consequences, produced from the capabilities the backend
                   declares — never the capabilities themselves (D3). #}
                <div class="small fw-medium mt-2">Fonctionnalités du volume :</div>
                <ul class="list-unstyled small text-body-secondary mb-0">
                    {% for consequence in location.consequences %}
                        <li><i class="bi bi-dot" aria-hidden="true"></i>{{ consequence.sentence }}</li>
                    {% endfor %}
                </ul>

                {# Everything that configures the location — the check, the
                   default, the Google account, the safety copy, the deletion
                   — is on its edit page (#718 § C point 10.7). #}
                <a href="/config/stockage/emplacements/{{ location.id }}/modification"
                   class="btn btn-outline-secondary btn-sm mt-3">Modifier</a>
            </div>
        </div>
    {% else %}
        {% include 'partials/empty_state.html.twig' with {
            message: 'Aucun emplacement déclaré.',
        } only %}
    {% endfor %}

    {#
      The choosing aid, and the reason it is a TABLE where the cards are
      not: here the whole point is reading one line across the options,
      which is the one thing a stack of cards cannot do. Four rows, because
      those are the four questions the mockup found an administrator
      actually asks.

      Every cell comes from StorageConsequence::comparison(), which asks
      the backend classes what they declare — so this cannot drift from the
      cards above, and a fifth type appears here on the day it exists
      without anyone remembering to add a column.

      Wrapped in `table-responsive`: four types plus a label do not fit a
      phone, and this is the one kind of content AGENTS.md allows to scroll
      sideways rather than be cut.
    #}
    <div class="card mb-3">
        <div class="card-body">
            <h2 class="h6 mb-1">Comparer les types de stockage</h2>
            <p class="text-muted small mb-3">
                Ce que chaque type sait faire, pour choisir avant d'en déclarer un.
            </p>
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <caption class="visually-hidden">
                        Comparaison des types de stockage sur quatre critères
                    </caption>
                    <thead>
                        <tr>
                            <th scope="col"></th>
                            {% for type in comparison_types %}
                                <th scope="col" class="fw-medium">{{ type.frenchLabel }}</th>
                            {% endfor %}
                        </tr>
                    </thead>
                    <tbody>
                        {% for row in comparison %}
                            <tr>
                                <th scope="row" class="fw-medium">{{ row.label }}</th>
                                {% for cell in row.cells %}
                                    {# The detail carries the « why », and it is the
                                       sentence the card prints — so it is a title
                                       rather than a second column that would make
                                       the table unreadable. #}
                                    <td title="{{ cell.detail }}">
                                        {% if cell.verdict == 'non' %}
                                            <span class="text-danger">{{ cell.verdict }}</span>
                                        {% else %}
                                            {{ cell.verdict }}
                                        {% endif %}
                                    </td>
                                {% endfor %}
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
{% endblock %}

{% block scripts %}
    <script src="{{ asset('/assets/js/storage-locations.js') }}" defer></script>
{% endblock %}
