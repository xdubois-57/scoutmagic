{#
  « Stockage » — one card per location.

  A card each rather than a table, which is what the mockup asks for and
  what the content needs: an error sentence, a « Sert : … » line and a set
  of consequences do not fit in a cell, and the table this replaces had
  already been squeezed into seven columns on a phone.

  **What is shown is consequences, never capabilities** (D3). Nobody
  chooses a storage type on « lecture par plage d'octets » — the
  enumeration stays in the code and produces these sentences. The
  comparison table that turns the same source into a choosing aid is
  IT-07, and the « Protection » block the mockup shows on each card is
  IT-04: a tab pointing at something that does not exist yet is worse than
  no tab.
#}
{% extends 'base.html.twig' %}

{% block title %}Emplacements de stockage — {{ site_name }}{% endblock %}

{% block content %}
    {% include 'partials/page_header.html.twig' with {
        title: 'Stockage',
        subtitle: "Les destinations déclarées, et ce que chacune sait faire.",
        action_label: 'Ajouter un emplacement',
        action_url: '/config/stockage/emplacements/nouveau',
    } only %}

    {% include 'config/storage/_nav.html.twig' with {current_path: current_path} only %}

    {% for location in locations %}
        {% set usages = location_usages[location.id] ?? [] %}
        <div class="card mb-3" data-location-card="{{ location.id }}">
            <div class="card-body">
                <div class="d-flex flex-wrap align-items-center gap-2">
                    <span class="flex-grow-1 fw-medium">{{ location.label }}</span>
                    <span class="badge text-bg-secondary">{{ location.type.frenchLabel }}</span>
                    {% if location.isDefault %}
                        <span class="badge text-bg-primary">
                            <i class="bi bi-star-fill" aria-hidden="true"></i> Par défaut
                        </span>
                    {% endif %}
                    <span class="storage-location-status" data-location-id="{{ location.id }}">
                        {% if location.lastCheckOk == true %}
                            <span class="badge text-bg-success">Joignable</span>
                        {% elseif location.lastCheckOk == false %}
                            <span class="badge text-bg-danger">En erreur</span>
                        {% else %}
                            <span class="badge text-bg-secondary">Non testé</span>
                        {% endif %}
                    </span>
                </div>

                <div class="small text-body-secondary text-break mt-1">{{ location.describe }}</div>

                {% if location.lastCheckOk == false and location.lastCheckError %}
                    <div class="alert alert-danger small mt-2 mb-0">{{ location.lastCheckError }}</div>
                {% endif %}

                {# **What no archive covers, said on the card that could act
                   on it.** Since D10 a file archive contains `storage/`
                   minus every declared location, so this is true of every
                   card here and not of some of them — which is exactly why
                   it belongs on each one rather than in a note at the top
                   of the page that a reader scrolls past.

                   Since IT-04 the sentence names the remedy on the same
                   line, because the remedy is now one form away: what
                   replaces an archive is the location's own copy. A card
                   that already has one says so instead. #}
                {% set protection = protections[location.id] ?? null %}
                {% if protection is null %}
                    <div class="small text-warning-emphasis mt-2">
                        <i class="bi bi-shield-exclamation" aria-hidden="true"></i>
                        Le contenu de cet emplacement n'est repris dans aucune archive de sauvegarde, et il
                        n'a pas de copie de secours.
                    </div>
                {% elseif not protection.enabled %}
                    <div class="small text-warning-emphasis mt-2">
                        <i class="bi bi-shield-exclamation" aria-hidden="true"></i>
                        La copie de secours de cet emplacement est en pause : rien n'est copié.
                    </div>
                {% else %}
                    <div class="small text-success-emphasis mt-2">
                        <i class="bi bi-shield-check" aria-hidden="true"></i>
                        Copié vers « {{ location_labels[protection.destinationLocationId] ?? 'un emplacement supprimé' }} »
                        {% if protection.lastCompletedPassAt %}
                            — dernière passe {{ protection.lastCompletedPassAt|relative_date }}.
                        {% else %}
                            — aucune passe n'est encore arrivée à son terme.
                        {% endif %}
                    </div>
                    {% if protection.lastError %}
                        <div class="alert alert-warning small mt-2 mb-0">{{ protection.lastError }}</div>
                    {% endif %}
                {% endif %}

                {# The consequences, produced from the capabilities the backend
                   declares — never the capabilities themselves (D3). #}
                <ul class="list-unstyled small text-body-secondary mt-2 mb-0">
                    {% for consequence in location.consequences %}
                        <li><i class="bi bi-dot" aria-hidden="true"></i>{{ consequence.sentence }}</li>
                    {% endfor %}
                </ul>

                <div class="d-flex flex-wrap align-items-center gap-3 small mt-2">
                    <span class="text-body-secondary">
                        {% if location.lastCheckedAt %}
                            Vérifié {{ location.lastCheckedAt|relative_date }} par écriture d'un fichier témoin
                        {% else %}
                            Jamais vérifié
                        {% endif %}
                    </span>
                    <button type="button" class="btn btn-link btn-sm p-0 storage-location-test"
                            data-id="{{ location.id }}">Tester</button>
                    <a href="/config/stockage/emplacements/{{ location.id }}/modification"
                       class="btn btn-link btn-sm p-0">Modifier</a>
                    {% if not location.isDefault %}
                        <button type="button" class="btn btn-link btn-sm p-0 storage-location-set-default"
                                data-id="{{ location.id }}">Définir par défaut</button>
                    {% endif %}
                    {# Destructive, so a POST form with its CSRF token and the
                       shared data-confirm attribute — the shape
                       config/maintenance.html.twig and
                       config/outbound_mail/providers.html.twig already use —
                       rather than a button only a script can actuate. This
                       action has no second door: on a page whose JavaScript
                       did not load, a script-only button leaves no way to
                       delete a location at all. #}
                    {% if usages is empty %}
                        <form method="post"
                              action="/config/stockage/emplacements/{{ location.id }}/suppression"
                              data-confirm="Supprimer l'emplacement « {{ location.label }} » ? Les fichiers déjà écrits à la destination ne sont pas effacés : le site cesse seulement de la connaître."
                              data-confirm-label="Supprimer"
                              class="d-inline">
                            {{ csrf_field()|raw }}
                            <button type="submit" class="btn btn-link btn-sm p-0 text-danger">Supprimer</button>
                        </form>
                    {% endif %}
                </div>

                {% if usages is not empty %}
                    <div class="small text-body-secondary mt-1">
                        Sert : {{ usages|join(', ') }} — suppression impossible tant qu'un usage en dépend.
                    </div>
                {% endif %}

                {# ————— The safety copy (IT-04) —————

                   In a <details> rather than open on the card: a location
                   that has one says so in a line above, and the form is
                   what somebody opens on the day they change it. Four
                   controls open at once on every card would bury the
                   consequences the card exists to show (D3).

                   The destination list holds every OTHER location, with no
                   filtering: which pairings are refused — a cycle, a
                   destination that publishes what the source does not — is
                   the service's to say in a sentence. A destination
                   missing from a picker because the screen guessed it was
                   invalid is a destination nobody can find out why they
                   cannot choose. #}
                {% if protection_offered %}
                    {% set destinations = locations|filter(c => c.id != location.id) %}
                    <details class="mt-3">
                        <summary class="small">Copie de secours</summary>
                        {# **Nothing to copy TO is a state, not a form.** On a
                           site with a single location the list below is
                           empty, and a required picker with no options plus
                           an « Enregistrer » that cannot succeed is the worst
                           of both: the administrator is told to choose and
                           given nothing to choose from. #}
                        {% if destinations is empty %}
                            <p class="small text-body-secondary mt-2 mb-0">
                                Une copie de secours s'écrit dans un autre emplacement, et celui-ci est
                                le seul déclaré. Ajoutez-en un second — un disque, un NAS, un stockage
                                objet — puis revenez le désigner ici.
                            </p>
                        {% else %}
                        <form method="post"
                              action="/config/stockage/emplacements/{{ location.id }}/protection"
                              class="mt-2">
                            {{ csrf_field()|raw }}
                            <div class="row g-2 align-items-end">
                                <div class="col-12 col-md-5">
                                    <label class="form-label small"
                                           for="destination-{{ location.id }}">Destination</label>
                                    <select class="form-select form-select-sm" required
                                            id="destination-{{ location.id }}" name="destination_location_id">
                                        {# `|filter`, not the inline `for … if`, which Twig 3
                                           removed. #}
                                        {% for candidate in destinations %}
                                            <option value="{{ candidate.id }}"
                                                {{ protection and protection.destinationLocationId == candidate.id
                                                    ? 'selected' : '' }}>{{ candidate.label }}</option>
                                        {% endfor %}
                                    </select>
                                </div>
                                <div class="col-6 col-md-3">
                                    <label class="form-label small" for="grace-{{ location.id }}">
                                        Délai de grâce (jours)
                                    </label>
                                    <input class="form-control form-control-sm" type="number" min="1" required
                                           id="grace-{{ location.id }}" name="grace_period_days"
                                           value="{{ protection ? protection.gracePeriodDays : 30 }}">
                                </div>
                                <div class="col-6 col-md-2">
                                    <label class="form-label small" for="cadence-{{ location.id }}">
                                        Cadence (heures)
                                    </label>
                                    <input class="form-control form-control-sm" type="number" min="1" required
                                           id="cadence-{{ location.id }}" name="cadence_hours"
                                           value="{{ protection ? protection.cadenceHours : 24 }}">
                                </div>
                                <div class="col-12 col-md-2">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox"
                                               id="enabled-{{ location.id }}" name="enabled"
                                               {{ protection is null or protection.enabled ? 'checked' : '' }}>
                                        <label class="form-check-label small"
                                               for="enabled-{{ location.id }}">Active</label>
                                    </div>
                                </div>
                            </div>

                            {# **Arithmetic, not documentation.** Restoring a
                               database older than the grace period brings
                               back rows whose files the copy has already
                               purged: the albums come back holed, for ever,
                               and nothing anywhere says why. #}
                            {% if restorable_horizon_days is not null %}
                                <p class="form-text mb-2">
                                    Votre plus ancienne sauvegarde restaurable date de
                                    {{ restorable_horizon_days }} jours. Un délai de grâce plus court
                                    signifie qu'une restauration ferait réapparaître des albums dont les
                                    fichiers auraient déjà été effacés de la copie.
                                </p>
                            {% endif %}

                            <button type="submit" class="btn btn-outline-primary btn-sm mt-2">
                                Enregistrer la copie de secours
                            </button>
                        </form>
                        {% endif %}

                        {% if protection %}
                            <div class="d-flex flex-wrap gap-3 small mt-2">
                                <form method="post"
                                      action="/config/stockage/emplacements/{{ location.id }}/protection/rapatriement"
                                      data-confirm="Rapatrier depuis la copie les fichiers que « {{ location.label }} » n'a plus ? Rien n'est écrasé : seuls les fichiers absents sont remis en place."
                                      data-confirm-label="Rapatrier"
                                      class="d-inline">
                                    {{ csrf_field()|raw }}
                                    <button type="submit" class="btn btn-link btn-sm p-0">
                                        Rapatrier depuis la copie
                                    </button>
                                </form>
                                <form method="post"
                                      action="/config/stockage/emplacements/{{ location.id }}/protection/suppression"
                                      data-confirm="Retirer la copie de secours de « {{ location.label }} » ? Les fichiers déjà copiés restent à la destination : c'est la relation qui s'arrête."
                                      data-confirm-label="Retirer"
                                      class="d-inline">
                                    {{ csrf_field()|raw }}
                                    <button type="submit" class="btn btn-link btn-sm p-0 text-danger">
                                        Retirer la copie de secours
                                    </button>
                                </form>
                            </div>
                        {% endif %}
                    </details>
                {% endif %}
            </div>
        </div>
    {% else %}
        {% include 'partials/empty_state.html.twig' with {
            message: 'Aucun emplacement déclaré.',
        } only %}
    {% endfor %}
{% endblock %}

{% block scripts %}
    <script src="{{ asset('/assets/js/storage-locations.js') }}" defer></script>
{% endblock %}
