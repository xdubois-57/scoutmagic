{% extends 'base.html.twig' %}
{% block title %}Maintenance — {{ param('site_name') }}{% endblock %}

{% macro backup_type_label(type) %}
    {%- if type == 'database' -%}Base de données seule
    {%- elseif type == 'full_config' -%}Configuration seule
    {%- elseif type == 'full_no_gallery' -%}Site complet, sans galerie
    {%- elseif type == 'full_with_gallery' -%}Site complet, avec galerie
    {%- elseif type == 'auto_update' -%}Automatique (avant mise à jour)
    {%- elseif type == 'auto_reset' -%}Automatique (avant réinitialisation)
    {%- elseif type == 'auto_backup' -%}Automatique (planifiée)
    {%- endif -%}
{% endmacro %}

{% block content %}
    <h1 class="mb-4">Maintenance</h1>

    {# ————— Mise à jour ————— #}
    <div class="card mb-4" id="maintenance-update">
        <div class="card-body">
            <h2 class="h5 mb-3">Mise à jour</h2>

            <p class="small text-body-secondary mb-1">
                Version installée : <strong>{{ installed_version }}</strong>{% if installed_version_commit %} <span class="text-body-secondary">({{ installed_version_commit }})</span>{% endif %}
                {% if installed_version_notes_url %}
                    (<a href="{{ installed_version_notes_url }}" target="_blank" rel="noopener">notes de version</a>)
                {% endif %}
            </p>
            {% if installed_version_notes %}
                <div class="small text-body-secondary mb-1">{{ installed_version_notes|markdown }}</div>
            {% endif %}
            <p class="small text-body-secondary">
                Dernière vérification :
                {% if update_checked_at %}{{ update_checked_at }}{% else %}jamais{% endif %}
            </p>

            <button type="button" class="btn btn-outline-secondary btn-sm mb-3" id="update-check-now">
                <i class="bi bi-arrow-repeat"></i> Vérifier maintenant
            </button>
            <div class="mt-2 mb-3 small d-none" id="update-check-now-progress">
                <span class="spinner-border spinner-border-sm"></span> Vérification en cours…
            </div>
            <div class="mt-2 mb-3 small text-danger d-none" id="update-check-now-error"></div>

            {# Populated by JS from POST /config/maintenance/update/check-now
               — a manual, on-demand equivalent of the alert below, which
               only reflects the webhook's last cached result. Its install
               form POSTs to the same /config/maintenance/update/install
               endpoint and is polled the same way (see maintenance.js). #}
            <div class="alert alert-primary d-none" id="update-check-now-dialog">
                <p class="mb-2" id="update-check-now-message"></p>
                <div class="small mb-3" id="update-check-now-notes"></div>
                <form id="update-check-now-install-form">
                    {{ csrf_field()|raw }}
                    <button type="submit" class="btn btn-primary btn-sm" id="update-check-now-install-submit">
                        <i class="bi bi-cloud-arrow-down"></i> Installer maintenant
                    </button>
                    <button type="button" class="btn btn-outline-secondary btn-sm" id="update-check-now-dismiss">Plus tard</button>
                    <div class="mt-2 small d-none" id="update-check-now-install-progress">
                        <span class="spinner-border spinner-border-sm"></span> Installation en cours…
                    </div>
                    <div class="mt-2 small text-danger d-none" id="update-check-now-install-error"></div>
                </form>
            </div>

            {% if update_available %}
                <div class="alert alert-primary">
                    <p class="mb-2">
                        Une nouvelle version est disponible : <strong>{{ update_latest_version }}</strong>
                        {% if update_release_html_url %}
                            (<a href="{{ update_release_html_url }}" target="_blank" rel="noopener">notes de version</a>)
                        {% endif %}
                    </p>
                    {% if update_release_notes %}
                        <div class="small mb-2">{{ update_release_notes|markdown }}</div>
                    {% endif %}
                    {% if update_dependencies_changed %}
                        <div class="alert alert-warning small mb-2">
                            Cette version modifie les dépendances (composer.lock changé). Vérifiez la compatibilité avant d'installer.
                        </div>
                    {% endif %}
                    <p class="small mb-3">
                        Une sauvegarde complète (base de données + fichiers) sera prise automatiquement avant l'installation.
                    </p>
                    <form id="update-install-form">
                        {{ csrf_field()|raw }}
                        <button type="submit" class="btn btn-primary btn-sm" id="update-install-submit">
                            <i class="bi bi-cloud-arrow-down"></i> Installer la mise à jour
                        </button>
                        <div class="mt-2 small d-none" id="update-install-progress">
                            <span class="spinner-border spinner-border-sm"></span> Installation en cours…
                        </div>
                        <div class="mt-2 small text-danger d-none" id="update-install-error"></div>
                    </form>
                </div>
            {% else %}
                <p class="small mb-0">Le site est à jour.</p>
            {% endif %}

            {% if update_history is not empty %}
                <hr class="my-4">
                <h3 class="h6">Historique des mises à jour</h3>
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Version</th>
                                <th>Date</th>
                                <th>Statut</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for entry in update_history %}
                                <tr>
                                    <td class="small text-nowrap">{{ entry.versionFrom }} → {{ entry.versionTo }}</td>
                                    <td class="small text-nowrap">{{ entry.startedAt }}</td>
                                    <td class="small">
                                        {% if entry.status == 'completed' %}
                                            <span class="badge text-bg-success">Réussie</span>
                                        {% elseif entry.status == 'failed' %}
                                            <span class="badge text-bg-danger" title="{{ entry.errorMessage }}">Échouée</span>
                                        {% elseif entry.status == 'rolled_back' %}
                                            <span class="badge text-bg-warning" title="{{ entry.errorMessage }}">Échouée — restaurée automatiquement</span>
                                        {% else %}
                                            <span class="badge text-bg-primary">En cours ({{ entry.status }})</span>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>
    </div>

    {# ————— Mises à jour automatiques ————— #}
    <div class="card mb-4" id="maintenance-auto-update">
        <div class="card-body">
            <h2 class="h5 mb-3">Mises à jour automatiques</h2>

            {% if webhook_warning %}
                <div class="alert alert-warning small">
                    Les mises à jour automatiques sont activées mais le webhook GitHub n'est pas configuré.
                    Les nouvelles versions ne seront pas détectées automatiquement.
                </div>
            {% endif %}

            <div class="form-check form-switch mb-3">
                <input class="form-check-input" type="checkbox" id="auto-update-enabled" {{ auto_update_enabled ? 'checked' : '' }}>
                <label class="form-check-label" for="auto-update-enabled">Activer les mises à jour automatiques</label>
            </div>

            <div id="auto-update-details" class="{{ auto_update_enabled ? '' : 'd-none' }}">
                <h3 class="h6">Types de versions à installer</h3>
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="auto-update-level" id="auto-update-level-patch" value="patch" {{ auto_update_level == 'patch' ? 'checked' : '' }}>
                    <label class="form-check-label small" for="auto-update-level-patch">
                        Patch uniquement (ex : 2.4.1 → 2.4.2)
                    </label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="auto-update-level" id="auto-update-level-minor" value="minor" {{ auto_update_level == 'minor' ? 'checked' : '' }}>
                    <label class="form-check-label small" for="auto-update-level-minor">
                        Patch + Mineur (ex : 2.4.1 → 2.5.0) <span class="badge text-bg-success">Recommandé</span>
                    </label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="auto-update-level" id="auto-update-level-major" value="major" {{ auto_update_level == 'major' ? 'checked' : '' }}>
                    <label class="form-check-label small" for="auto-update-level-major">
                        Patch + Mineur + Majeur (ex : 2.4.1 → 3.0.0) <span class="badge text-bg-danger">⚠ Risqué</span>
                    </label>
                </div>
                <div class="form-check mb-2">
                    <input class="form-check-input" type="radio" name="auto-update-level" id="auto-update-level-dev" value="dev" {{ auto_update_level == 'dev' ? 'checked' : '' }}>
                    <label class="form-check-label small" for="auto-update-level-dev">
                        Développement (installation immédiate à chaque commit d'une branche) <span class="badge text-bg-danger">⚠ Réservé aux tests</span>
                    </label>
                </div>
                <div class="alert alert-danger small {{ auto_update_level == 'major' ? '' : 'd-none' }}" id="auto-update-major-warning">
                    Les versions majeures peuvent modifier le fonctionnement du site de manière significative.
                    Il est recommandé de ne pas installer ces versions automatiquement sur un site en production.
                </div>
                <div class="alert alert-danger small {{ auto_update_level == 'dev' ? '' : 'd-none' }}" id="auto-update-dev-warning">
                    Réservé aux environnements de test. Chaque commit poussé sur la branche ci-dessous est installé
                    automatiquement et immédiatement (sans attendre de créneau planifié) — ces versions peuvent être
                    instables, incomplètes, ou contenir des bugs. Ne jamais activer sur un site en production.
                </div>

                <p class="small mb-2">
                    <a href="#" id="auto-update-semver-toggle">Qu'est-ce que ça veut dire ?</a>
                </p>
                <div class="small text-body-secondary mb-3 d-none" id="auto-update-semver-explainer">
                    <p class="mb-1"><strong>Z (Patch)</strong> : corrections de bugs et de sécurité, aucun changement fonctionnel.</p>
                    <p class="mb-1"><strong>Y (Mineur)</strong> : nouvelles fonctionnalités, compatibles avec l'existant.</p>
                    <p class="mb-0"><strong>X (Majeur)</strong> : changements importants, potentiellement incompatibles.</p>
                </div>

                <div id="auto-update-webhook-section" class="{{ auto_update_level == 'dev' ? '' : 'd-none' }}">
                    <h3 class="h6">Détection des nouvelles versions</h3>
                    <p class="small mb-2">
                        Webhook GitHub :
                        <span class="badge {{ webhook_configured ? 'text-bg-success' : 'text-bg-secondary' }}" id="webhook-status-badge">
                            {{ webhook_configured ? '✓ Configuré' : '✗ Non configuré' }}
                        </span>
                    </p>
                    <div class="small mb-3 {{ webhook_configured ? 'd-none' : '' }}" id="webhook-setup-instructions">
                        <p class="mb-1">Dans les paramètres du dépôt GitHub (Settings → Webhooks → Add webhook), configurez :</p>
                        <ul class="mb-2">
                            <li>Payload URL : <code>{{ webhook_url }}</code></li>
                            <li>Content type : <code>application/json</code></li>
                            <li>Events : « Releases » et « Pushes »</li>
                        </ul>
                    </div>
                    <button type="button" class="btn btn-outline-{{ webhook_configured ? 'secondary' : 'primary' }} btn-sm mb-2" id="webhook-generate-secret">
                        <i class="bi {{ webhook_configured ? 'bi-arrow-repeat' : 'bi-key' }}"></i>
                        <span id="webhook-generate-secret-label">{{ webhook_configured ? 'Régénérer le secret' : 'Générer le secret' }}</span>
                    </button>
                    <div class="mt-2 mb-3 d-none" id="webhook-secret-display">
                        <p class="small mb-1 text-danger">Copiez ce secret maintenant — il ne sera plus jamais affiché :</p>
                        <code class="user-select-all d-block p-2 bg-body-secondary rounded" id="webhook-secret-value"></code>
                    </div>
                </div>

                <div id="auto-update-schedule-section" class="{{ auto_update_level == 'dev' ? 'd-none' : '' }}">
                    <h3 class="h6">Moment d'installation</h3>
                    <p class="small text-body-secondary mb-2">
                        Quand une nouvelle version est détectée, elle sera installée automatiquement au prochain créneau prévu
                        (heure locale belge — Europe/Bruxelles).
                    </p>
                    <div class="d-flex align-items-center gap-2 flex-wrap mb-3">
                        <select class="form-select form-select-sm w-auto" id="auto-update-day" aria-label="Jour de la semaine">
                            <option value="monday" {{ auto_update_day == 'monday' ? 'selected' : '' }}>Lundi</option>
                            <option value="tuesday" {{ auto_update_day == 'tuesday' ? 'selected' : '' }}>Mardi</option>
                            <option value="wednesday" {{ auto_update_day == 'wednesday' ? 'selected' : '' }}>Mercredi</option>
                            <option value="thursday" {{ auto_update_day == 'thursday' ? 'selected' : '' }}>Jeudi</option>
                            <option value="friday" {{ auto_update_day == 'friday' ? 'selected' : '' }}>Vendredi</option>
                            <option value="saturday" {{ auto_update_day == 'saturday' ? 'selected' : '' }}>Samedi</option>
                            <option value="sunday" {{ auto_update_day == 'sunday' ? 'selected' : '' }}>Dimanche</option>
                        </select>
                        <input type="time" class="form-control form-control-sm w-auto" id="auto-update-time" value="{{ auto_update_time }}" aria-label="Heure d'installation">
                    </div>
                </div>

                <div id="auto-update-branch-section" class="{{ auto_update_level == 'dev' ? '' : 'd-none' }}">
                    <h3 class="h6">Branche à surveiller</h3>
                    <p class="small text-body-secondary mb-2">
                        Chaque commit poussé sur cette branche sera installé immédiatement.
                    </p>
                    <input type="text" class="form-control form-control-sm mb-3" id="auto-update-branch" value="{{ dev_update_branch }}" style="max-width:300px;" aria-label="Nom de la branche">
                </div>
            </div>

            <button type="button" class="btn btn-primary btn-sm" id="auto-update-save">Enregistrer</button>
            <span class="small text-success d-none" id="auto-update-saved">Enregistré</span>
            <div class="mt-2 small text-danger d-none" id="auto-update-error"></div>
        </div>
    </div>

    {# ————— Sauvegardes ————— #}
    <div class="card mb-4" id="maintenance-backups">
        <div class="card-body">
            <h2 class="h5 mb-3">Sauvegardes</h2>

            <div class="d-flex align-items-center gap-2 flex-wrap mb-1">
                <label class="form-label small mb-0" for="auto-backup-frequency">Sauvegarde automatique complète (sans galerie)</label>
                <select class="form-select form-select-sm w-auto" id="auto-backup-frequency">
                    <option value="none" {{ backup_auto_frequency == 'none' ? 'selected' : '' }}>Aucune</option>
                    <option value="daily" {{ backup_auto_frequency == 'daily' ? 'selected' : '' }}>Quotidienne</option>
                    <option value="weekly" {{ backup_auto_frequency == 'weekly' ? 'selected' : '' }}>Hebdomadaire</option>
                    <option value="biweekly" {{ backup_auto_frequency == 'biweekly' ? 'selected' : '' }}>Toutes les 2 semaines</option>
                    <option value="monthly" {{ backup_auto_frequency == 'monthly' ? 'selected' : '' }}>Mensuelle</option>
                </select>
                <span class="small text-success d-none" id="auto-backup-frequency-saved">Enregistré</span>
            </div>
            <p class="small text-body-secondary mb-3">
                {% if backup_auto_last_run %}
                    Dernière sauvegarde automatique : {{ backup_auto_last_run }}.
                {% else %}
                    Aucune sauvegarde automatique effectuée pour le moment.
                {% endif %}
                Comptée dans les 5 sauvegardes conservées ci-dessous.
            </p>

            {% if not zip_encryption_supported %}
                <div class="alert alert-warning small">
                    Le serveur ne supporte pas le chiffrement des archives — la sauvegarde complète est indisponible.
                    Contactez votre hébergeur. La sauvegarde de la base de données seule reste utilisable.
                </div>
            {% endif %}

            <div class="row g-4">
                <div class="col-12 col-md-6">
                    <h3 class="h6">Base de données seule</h3>
                    <p class="text-body-secondary small">
                        Export SQL complet de la base de données. Les champs personnels y restent chiffrés,
                        mais le fichier reste sensible — réservé aux administrateurs.
                    </p>
                    <form method="post" action="/config/maintenance/backup/database">
                        {{ csrf_field()|raw }}
                        <button type="submit" class="btn btn-outline-primary btn-sm">
                            <i class="bi bi-database-down"></i> Générer
                        </button>
                    </form>
                </div>

                <div class="col-12 col-md-6">
                    <h3 class="h6">Sauvegarde complète (chiffrée)</h3>
                    <p class="text-body-secondary small">
                        Archive ZIP protégée par mot de passe, générée en arrière-plan. Vous recevrez une
                        notification lorsqu'elle sera prête.
                    </p>
                    <form id="full-backup-form" {{ not zip_encryption_supported ? 'class="d-none"' : '' }}>
                        <div class="mb-2">
                            <label class="form-label small">Portée</label>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="scope" id="scope-config" value="full_config" checked>
                                <label class="form-check-label small" for="scope-config">Configuration seule (paramètres, structure — sans les données membres)</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="scope" id="scope-no-gallery" value="full_no_gallery">
                                <label class="form-check-label small" for="scope-no-gallery">Site complet, sans la galerie photo</label>
                            </div>
                            {% if gallery_enabled %}
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="scope" id="scope-with-gallery" value="full_with_gallery">
                                    <label class="form-check-label small" for="scope-with-gallery">Site complet, avec la galerie photo</label>
                                </div>
                            {% endif %}
                        </div>
                        <div class="mb-2">
                            <label class="form-label small" for="full-backup-password">Mot de passe de l'archive</label>
                            <input type="password" class="form-control form-control-sm" id="full-backup-password" required>
                        </div>
                        <button type="submit" class="btn btn-primary btn-sm" id="full-backup-submit">
                            <i class="bi bi-shield-lock"></i> Générer
                        </button>
                        <div class="mt-2 small d-none" id="full-backup-progress">
                            <span class="spinner-border spinner-border-sm"></span> Génération en cours…
                        </div>
                        <div class="mt-2 small text-danger d-none" id="full-backup-error"></div>
                    </form>
                </div>
            </div>

            <hr class="my-4">

            <h3 class="h6">Sauvegardes récentes</h3>
            {% if backups is empty %}
                <p class="text-body-secondary small mb-0">Aucune sauvegarde pour le moment.</p>
            {% else %}
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Type</th>
                                <th>Date</th>
                                <th>Statut</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for backup in backups %}
                                <tr>
                                    <td class="small">{{ _self.backup_type_label(backup.type) }}</td>
                                    <td class="small text-nowrap">{{ backup.createdAt }}</td>
                                    <td>
                                        {% if backup.status == 'completed' %}
                                            <span class="badge text-bg-success">Terminée</span>
                                        {% elseif backup.status == 'in_progress' %}
                                            <span class="badge text-bg-warning">En cours</span>
                                        {% elseif backup.status == 'pending' %}
                                            <span class="badge text-bg-primary">En attente</span>
                                        {% elseif backup.status == 'failed' %}
                                            <span class="badge text-bg-danger" title="{{ backup.errorMessage }}">Échouée</span>
                                        {% endif %}
                                    </td>
                                    <td class="text-end">
                                        {% if backup.status == 'completed' and backup.fileId %}
                                            <a href="/files/{{ backup.fileId }}" class="btn btn-sm btn-outline-secondary">
                                                <i class="bi bi-download"></i> Télécharger
                                            </a>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>
    </div>

    {# ————— Réinitialisation ————— #}
    <div class="card mb-4 border-danger" id="maintenance-reset">
        <div class="card-body">
            <h2 class="h5 mb-3 text-danger"><i class="bi bi-exclamation-triangle"></i> Réinitialisation</h2>
            <p class="text-body-secondary small">
                Ces actions sont irréversibles sans restauration manuelle. Une sauvegarde de sécurité est prise
                automatiquement avant chaque action.
            </p>

            <div class="row g-4">
                <div class="col-12 col-md-4">
                    <h3 class="h6">Paramètres par défaut</h3>
                    <p class="text-body-secondary small">
                        Réinitialise tous les paramètres (généraux et modules) à leurs valeurs par défaut. Ne
                        touche ni aux comptes, ni aux membres, ni aux contenus, ni aux fichiers.
                    </p>
                    <form id="reset-settings-form">
                        {{ csrf_field()|raw }}
                        <label class="form-label small" for="reset-settings-keyword">Tapez <strong>REINITIALISER</strong> pour confirmer</label>
                        <input type="text" class="form-control form-control-sm mb-2" id="reset-settings-keyword" autocomplete="off">
                        <button type="submit" class="btn btn-outline-danger btn-sm" id="reset-settings-submit" disabled>
                            Réinitialiser les paramètres
                        </button>
                        <div class="mt-2 small d-none" id="reset-settings-progress"><span class="spinner-border spinner-border-sm"></span> En cours…</div>
                        <div class="mt-2 small text-danger d-none" id="reset-settings-error"></div>
                    </form>
                </div>

                <div class="col-12 col-md-4">
                    <h3 class="h6">Restaurer un backup</h3>
                    <p class="text-body-secondary small">
                        Restaure la base de données et les fichiers depuis une sauvegarde existante ou un fichier
                        téléversé.
                    </p>
                    <form id="restore-backup-form" method="post" action="/config/maintenance/reset/restore" enctype="multipart/form-data">
                        {{ csrf_field()|raw }}
                        <div class="mb-2">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="source" id="restore-source-server" value="server" checked>
                                <label class="form-check-label small" for="restore-source-server">Depuis le serveur</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="source" id="restore-source-upload" value="upload">
                                <label class="form-check-label small" for="restore-source-upload">Depuis un fichier téléversé</label>
                            </div>
                        </div>
                        <div class="mb-2" id="restore-server-picker">
                            <label class="visually-hidden" for="restore-backup-id">Sauvegarde à restaurer</label>
                            <select class="form-select form-select-sm" name="backup_id" id="restore-backup-id" {% if backups is empty %}disabled{% endif %}>
                                {% for backup in backups %}
                                    {% if backup.status == 'completed' %}
                                        <option value="{{ backup.id }}">{{ _self.backup_type_label(backup.type) }} — {{ backup.createdAt }}</option>
                                    {% endif %}
                                {% endfor %}
                            </select>
                        </div>
                        <div class="mb-2 d-none" id="restore-upload-picker">
                            <input type="file" class="form-control form-control-sm" name="backup_file" id="restore-backup-file" accept=".zip" aria-label="Fichier de sauvegarde">
                        </div>
                        <div class="mb-2">
                            <label class="form-label small" for="restore-backup-password">Mot de passe de l'archive (si chiffrée)</label>
                            <input type="password" class="form-control form-control-sm" name="password" id="restore-backup-password">
                        </div>
                        <label class="form-label small" for="restore-backup-keyword">Tapez <strong>RESTAURER</strong> pour confirmer</label>
                        <input type="text" class="form-control form-control-sm mb-2" name="confirm_keyword" id="restore-backup-keyword" autocomplete="off">
                        <button type="submit" class="btn btn-outline-danger btn-sm" id="restore-backup-submit" disabled>
                            Restaurer
                        </button>
                        <div class="mt-2 small d-none" id="restore-backup-progress"><span class="spinner-border spinner-border-sm"></span> Restauration en cours…</div>
                        <div class="mt-2 small text-danger d-none" id="restore-backup-error"></div>
                    </form>
                </div>

                <div class="col-12 col-md-4">
                    <h3 class="h6">Réinitialisation complète</h3>
                    <p class="text-body-secondary small">
                        Efface définitivement toutes les données du site. Le prochain accès déclenchera
                        l'assistant d'installation, comme pour un site neuf.
                    </p>
                    <form id="full-reset-form">
                        {{ csrf_field()|raw }}
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" id="full-reset-checkbox">
                            <label class="form-check-label small" for="full-reset-checkbox">
                                Je comprends que toutes les données seront définitivement supprimées
                            </label>
                        </div>
                        <label class="form-label small" for="full-reset-keyword">Tapez <strong>EFFACER</strong> pour confirmer</label>
                        <input type="text" class="form-control form-control-sm mb-2" id="full-reset-keyword" autocomplete="off">
                        <button type="submit" class="btn btn-danger btn-sm" id="full-reset-submit" disabled>
                            Tout effacer
                        </button>
                        <div class="mt-2 small d-none" id="full-reset-progress"><span class="spinner-border spinner-border-sm"></span> Réinitialisation en cours — ne fermez pas cette page…</div>
                        <div class="mt-2 small text-danger d-none" id="full-reset-error"></div>
                    </form>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block scripts %}
    <script src="/assets/js/maintenance.js" defer nonce="{{ csp_nonce }}"></script>
{% endblock %}
