{% extends 'base.html.twig' %}
{% block title %}Modèles d'e-mails — {{ site_name }}{% endblock %}
{% block content %}
{% include 'partials/page_header.html.twig' with {
    title: "Modèles d'e-mails",
    subtitle: "Tous les emails que le site envoie tout seul. Chacun peut être réécrit — sujet et corps — sauf ceux qui servent à se connecter ou à confirmer une adresse.",
} only %}

{% for group in groups %}
    <div class="card mb-3">
        <div class="card-body">
            <h2 class="h5 mb-3">{{ group.label }}</h2>
            {% include 'partials/email_template_table.html.twig' with {
                templates: group.templates,
                page_url: page_url|default('/config/emails'),
            } only %}
        </div>
    </div>
{% else %}
    {% include 'partials/empty_state.html.twig' with {
        message: "Aucun email déclaré — ce qui ne devrait jamais arriver, le site en envoie forcément.",
    } only %}
{% endfor %}
{% endblock %}
