{% extends 'base.html.twig' %}
{% block title %}Actions planifiées — {{ param('site_name') }}{% endblock %}
{% block content %}
    {% include 'partials/page_header.html.twig' with {
        title: 'Actions planifiées',
        subtitle: total ~ ' action' ~ (total > 1 ? 's' : '') ~ ' au total',
    } only %}

    {# Desktop table #}
    <div class="d-none d-md-block">
        <div class="table-responsive">
            <table class="table table-sm table-hover">
                <thead>
                    <tr>
                        <th>Module</th>
                        <th>Tâche</th>
                        <th>Référence</th>
                        <th>Exécution prévue</th>
                        <th>Statut</th>
                        <th>Tentatives</th>
                        <th>Créée le</th>
                    </tr>
                </thead>
                <tbody>
                    {% for action in actions %}
                    <tr class="action-row" data-error="{{ action.last_error|default('')|e('html_attr') }}"
                        data-reveal="next:.error-row">
                        <td class="small">{{ action.module_id }}</td>
                        <td class="small">{{ action.task_key }}</td>
                        <td class="small">{{ action.reference ?? '—' }}</td>
                        <td class="small text-nowrap">{{ action.run_at }}</td>
                        <td>
                            {% if action.status == 'pending' %}
                                {% include 'partials/status_badge.html.twig' with { status: 'pending', label: 'En attente' } only %}
                            {% elseif action.status == 'processing' %}
                                {% include 'partials/status_badge.html.twig' with { status: 'in_progress', label: 'En cours' } only %}
                            {% elseif action.status == 'done' %}
                                {% include 'partials/status_badge.html.twig' with { status: 'done', label: 'Terminé' } only %}
                            {% elseif action.status == 'failed' %}
                                {% include 'partials/status_badge.html.twig' with { status: 'failed', label: 'Échoué' } only %}
                            {% elseif action.status == 'canceled' %}
                                {% include 'partials/status_badge.html.twig' with { status: 'cancelled', label: 'Annulé' } only %}
                            {% endif %}
                        </td>
                        <td class="small text-center">{{ action.attempts }}</td>
                        <td class="small text-nowrap">{{ action.created_at }}</td>
                    </tr>
                    {% if action.last_error %}
                    <tr class="d-none error-row">
                        <td colspan="7">
                            <pre class="bg-body-tertiary p-2 rounded small mb-0 text-danger">{{ action.last_error }}</pre>
                        </td>
                    </tr>
                    {% endif %}
                    {% else %}
                    {% include 'partials/empty_state.html.twig' with {
                        message: 'Aucune action planifiée.',
                        colspan: 7,
                    } only %}
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    {# Mobile cards #}
    <div class="d-md-none">
        {% for action in actions %}
        <div class="card mb-2">
            <div class="card-body py-2 px-3">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="fw-semibold small">{{ action.task_key }}</span>
                    {% if action.status == 'pending' %}
                        {% include 'partials/status_badge.html.twig' with { status: 'pending', label: 'En attente' } only %}
                    {% elseif action.status == 'processing' %}
                        {% include 'partials/status_badge.html.twig' with { status: 'in_progress', label: 'En cours' } only %}
                    {% elseif action.status == 'done' %}
                        {% include 'partials/status_badge.html.twig' with { status: 'done', label: 'Terminé' } only %}
                    {% elseif action.status == 'failed' %}
                        {% include 'partials/status_badge.html.twig' with { status: 'failed', label: 'Échoué' } only %}
                    {% elseif action.status == 'canceled' %}
                        {% include 'partials/status_badge.html.twig' with { status: 'cancelled', label: 'Annulé' } only %}
                    {% endif %}
                </div>
                <div class="text-body-secondary" style="font-size:0.7rem;">
                    {{ action.module_id }} · Prévu : {{ action.run_at }}
                </div>
                {% if action.last_error %}
                <pre class="bg-body-tertiary p-2 rounded small mb-0 mt-1 text-danger">{{ action.last_error }}</pre>
                {% endif %}
            </div>
        </div>
        {% else %}
        {% include 'partials/empty_state.html.twig' with {
            message: 'Aucune action planifiée.',
            compact: true,
        } only %}
        {% endfor %}
    </div>

    <div class="mt-3">
        {% include 'partials/pagination.html.twig' with {
            page: page,
            total_pages: total_pages,
            base_url: '?page=',
            label: 'Pagination des actions planifiées',
            centered: true,
        } only %}
    </div>
{% endblock %}

{% block scripts %}
<script src="{{ asset('/assets/js/reveal-details.js') }}" defer></script>
{% endblock %}
