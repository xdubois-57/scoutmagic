{% extends 'config/maintenance/_layout.html.twig' %}
{% import 'config/maintenance/_macros.html.twig' as m %}

{% block maintenance_title %}Réinitialisation{% endblock %}

{% block maintenance_content %}
    {# ————— Réinitialisation ————— #}
    <div class="card mb-4 border-danger" id="maintenance-reset">
        <div class="card-body">
            {{ m.section_header('maintenance-reset-body', 'Réinitialisation', true, 'exclamation-triangle', 'text-danger') }}
            <div class="collapse show mt-3" id="maintenance-reset-body">
                <p class="text-body-secondary small">
                    Ces actions sont irréversibles sans restauration manuelle. Une sauvegarde de sécurité est prise
                    automatiquement avant chaque action.
                </p>
                {# Restoring moved to « Sauvegardes récentes » (issue #619,
                   IT-06): it is what a backup is for, not a reset. This
                   sentence stays for whoever still looks for it here. #}
                <p class="small">
                    Pour revenir à une sauvegarde, c'est dans
                    <a href="/config/maintenance/sauvegardes-recentes#maintenance-restore">Sauvegardes récentes</a>.
                </p>

                <div class="row g-4">
                    <div class="col-12 col-md-6">
                        <h3 class="h6">Paramètres par défaut</h3>
                        <p class="text-body-secondary small">
                            Réinitialise tous les paramètres (généraux et modules) à leurs valeurs par défaut. Ne
                            touche ni aux comptes, ni aux membres, ni aux contenus, ni aux fichiers.
                        </p>
                        <form id="reset-settings-form">
                            {{ csrf_field()|raw }}
                            <label class="form-label small" for="reset-settings-keyword">Tapez <strong>REINITIALISER</strong> pour confirmer</label>
                            <input type="text" class="form-control form-control-sm mb-2" id="reset-settings-keyword" autocomplete="off">
                            <button type="submit" class="btn btn-outline-danger btn-sm" id="reset-settings-submit" disabled>
                                Réinitialiser les paramètres
                            </button>
                            <output class="mt-2 small d-none d-block" id="reset-settings-progress"><span class="spinner-border spinner-border-sm"></span> En cours…</output>
                            <div class="mt-2 small text-danger d-none" id="reset-settings-error" role="alert"></div>
                        </form>
                    </div>

                    <div class="col-12 col-md-6">
                        <h3 class="h6">Réinitialisation complète</h3>
                        <p class="text-body-secondary small">
                            Efface définitivement toutes les données du site. Le prochain accès déclenchera
                            l'assistant d'installation, comme pour un site neuf.
                        </p>
                        <p class="text-body-secondary small">
                            Les dossiers déclarés comme
                            <a href="/config/stockage">emplacements de stockage</a> ne sont pas effacés&nbsp;:
                            leur contenu n'est repris dans aucune archive, il serait donc perdu sans retour.
                            Le site, lui, ne les référencera plus&nbsp;; supprimez-les vous-même si vous
                            vouliez repartir d'un disque vide.
                        </p>
                        <form id="full-reset-form">
                            {{ csrf_field()|raw }}
                            {# The safety copy is encrypted and its password is
                               erased with everything else (issue #619,
                               IT-03b): shown, and noted, before the reset. #}
                            {% if zip_encryption_supported %}
                                <div class="mb-2" id="full-reset-password-block">
                                    <p class="small mb-1">
                                        Une copie de sécurité chiffrée est prise avant l'effacement. Son mot de passe
                                        est effacé avec tout le reste&nbsp;: affichez-le et notez-le maintenant, personne
                                        ne pourra vous le redire ensuite.
                                    </p>
                                    <button type="button" class="btn btn-outline-secondary btn-sm" id="full-reset-password-reveal">
                                        <i class="bi bi-key" aria-hidden="true"></i> Afficher le mot de passe de la copie de sécurité
                                    </button>
                                    <output class="d-block small mt-1 d-none" id="full-reset-password" aria-live="polite"></output>
                                    <div class="form-check mt-2">
                                        <input class="form-check-input" type="checkbox" id="full-reset-password-noted" disabled>
                                        <label class="form-check-label small" for="full-reset-password-noted">
                                            J'ai noté le mot de passe de la copie de sécurité
                                        </label>
                                    </div>
                                </div>
                            {% endif %}
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="checkbox" id="full-reset-checkbox">
                                <label class="form-check-label small" for="full-reset-checkbox">
                                    Je comprends que toutes les données seront définitivement supprimées
                                </label>
                            </div>
                            <label class="form-label small" for="full-reset-keyword">Tapez <strong>EFFACER</strong> pour confirmer</label>
                            <input type="text" class="form-control form-control-sm mb-2" id="full-reset-keyword" autocomplete="off">
                            <button type="submit" class="btn btn-danger btn-sm" id="full-reset-submit" disabled>
                                Tout effacer
                            </button>
                            <output class="mt-2 small d-none d-block" id="full-reset-progress"><span class="spinner-border spinner-border-sm"></span> Réinitialisation en cours — ne fermez pas cette page…</output>
                            <div class="mt-2 small text-danger d-none" id="full-reset-error" role="alert"></div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
