{% extends 'config/maintenance/_layout.html.twig' %}
{% import 'config/maintenance/_macros.html.twig' as m %}

{% block maintenance_title %}Santé de l'hébergement{% endblock %}

{% block maintenance_content %}
    {# ————— What the site depends on at the host —————
       One line per dependency, built and worded by
       Core\Maintenance\Health\HostHealth: its state, what stops working
       without it, and — only when it is not ok — what to ask the host.
       The summary above them counts every line that is not ok, degraded
       ones included: a fallback that works less well is still something
       to ask about. #}
    {% set _icons = {
        'ok': 'bi-check-circle-fill text-success',
        'degraded': 'bi-exclamation-triangle-fill text-warning',
        'missing': 'bi-x-circle-fill text-danger'
    } %}
    {% set _labels = {'ok': 'En ordre', 'degraded': 'Dégradé', 'missing': 'Absent'} %}
    {% set _problems = host_checks|filter(c => not c.isOk())|length %}

    {% if _problems == 0 %}
        <div class="alert alert-success" id="host-health-summary">
            Tout ce dont le site dépend chez l'hébergeur répond.
        </div>
    {% else %}
        <div class="alert {{ host_checks|filter(c => c.state == 'missing')|length > 0 ? 'alert-danger' : 'alert-warning' }}" id="host-health-summary" role="alert">
            <strong>{{ _problems }} point{{ _problems > 1 ? 's' : '' }} à régler chez l'hébergeur.</strong>
            Chaque ligne concernée dit ce qui ne marche plus et quoi lui demander.
        </div>
    {% endif %}

    <div class="card mb-4" id="maintenance-health">
        <div class="card-body">
            {{ m.section_header('Ce dont le site dépend') }}
            <div class="mt-3" id="maintenance-health-body">
                <ul class="list-unstyled mb-0" id="host-health-checks">
                    {% for check in host_checks %}
                        <li class="d-flex gap-3 align-items-start {{ loop.last ? '' : 'mb-3' }}" id="host-check-{{ check.key }}" data-state="{{ check.state }}">
                            <i class="bi {{ _icons[check.state] }} fs-5" aria-hidden="true"></i>
                            <div class="flex-grow-1">
                                <div class="fw-semibold">
                                    {{ check.label }}
                                    <span class="visually-hidden">({{ _labels[check.state] }})</span>
                                    <span class="fw-normal text-body-secondary">— {{ check.status }}</span>
                                </div>
                                <div class="small text-body-secondary">{{ check.consequence }}</div>
                                {% if not check.isOk() and check.ask %}
                                    <div class="small mt-1"><span class="fw-semibold">À demander à l'hébergeur :</span> {{ check.ask }}</div>
                                {% endif %}

                                {% if check.key == 'cron' and not check.isOk() %}
                                    <div class="alert alert-danger small mt-2 mb-0" role="alert" id="maintenance-cron-warning">
                                        <div class="input-group input-group-sm mb-2">
                                            <input type="text" class="form-control font-monospace" value="{{ cron_crontab_line }}" readonly id="maintenance-cron-line" aria-label="Ligne crontab">
                                        </div>
                                        <p class="mb-0">
                                            Le mot <code>php</code> au début est obligatoire : un panneau d'hébergement qui
                                            accepte un simple chemin de fichier n'exécute rien du tout, et ne le signale pas.
                                        </p>
                                    </div>
                                {% endif %}
                            </div>
                        </li>
                    {% endfor %}
                </ul>
            </div>
        </div>
    </div>

    {# Disk space is measured once, volume by volume, on the storage page:
       a second figure here would be a second answer to the same question. #}
    <p class="small text-body-secondary" id="host-health-disk">
        L'espace disque se lit volume par volume sur
        <a href="/config/stockage">Configuration › Stockage</a>. L'état des mises à jour automatiques
        est sur la page <a href="/config/maintenance/mise-a-jour">Mise à jour</a>.
    </p>
{% endblock %}
