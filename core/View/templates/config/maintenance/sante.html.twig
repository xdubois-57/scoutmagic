{% extends 'config/maintenance/_layout.html.twig' %}
{% import 'config/maintenance/_macros.html.twig' as m %}

{% block maintenance_title %}Santé de l'hébergement{% endblock %}

{% block maintenance_content %}
    {# ————— État —————
       Two lines, at the top, because these are the two mechanisms whose
       failure is silent by nature: a cron that does not run raises no
       error, and an automatic update that fails leaves the page « up to
       date » as far as the installed version goes. The cron's verdict
       comes from Core\Scheduler\CronHealth, the same source as the
       Installation & serveur page and the support package. #}
    <div class="card mb-4" id="maintenance-health">
        <div class="card-body">
            {{ m.section_header('maintenance-health-body', 'État', true) }}
            <div class="collapse show mt-3" id="maintenance-health-body">
                {% set _cadence = null %}
                {% if cron_median_interval_seconds %}
                    {% set _cadence = cron_median_interval_seconds < 60
                        ? cron_median_interval_seconds ~ ' s'
                        : (cron_median_interval_seconds // 60) ~ ' min' %}
                {% endif %}
                <p class="small mb-2" id="maintenance-cron-health">
                    <span class="text-body-secondary">Tâche cron réelle :</span>
                    {% if cron_state == 'active' %}
                        <span class="badge text-bg-success">Actif</span>
                        <span class="text-body-secondary">— dernier passage il y a {{ cron_seconds_since_last_pass ?? 0 }} s{% if _cadence %}, cadence ~{{ _cadence }}{% endif %}</span>
                    {% elseif cron_state == 'stale' %}
                        <span class="badge text-bg-danger">Plus détecté</span>
                        <span class="text-body-secondary">— dernier passage il y a {{ (cron_seconds_since_last_pass ?? 0) // 60 }} min</span>
                    {% else %}
                        <span class="badge text-bg-danger">Jamais détecté</span>
                    {% endif %}
                </p>

                {% if cron_state != 'active' %}
                    <div class="alert alert-danger small" role="alert" id="maintenance-cron-warning">
                        <p class="mb-2">
                            Sans tâche cron, rien ne tourne en dehors des visites : ni sauvegarde automatique,
                            ni mise à jour, ni rappel, ni notification. Ajoutez cette ligne chez votre hébergeur
                            (rubrique « Tâches planifiées » ou « Cron ») :
                        </p>
                        <div class="input-group input-group-sm mb-2">
                            <input type="text" class="form-control font-monospace" value="{{ cron_crontab_line }}" readonly id="maintenance-cron-line" aria-label="Ligne crontab">
                        </div>
                        <p class="mb-0">
                            Le mot <code>php</code> au début est obligatoire : un panneau d'hébergement qui
                            accepte un simple chemin de fichier n'exécute rien du tout, et ne le signale pas.
                        </p>
                    </div>
                {% endif %}

                <p class="small mb-0" id="maintenance-auto-update-health">
                    <span class="text-body-secondary">Mise à jour automatique :</span>
                    {% if auto_update_last_success %}
                        <strong>{{ auto_update_last_success|datetime_fr }}</strong>
                        {%- if auto_update_last_success_version %} ({{ auto_update_last_success_version }}){% endif -%}
                        {%- if auto_update_silent_days is not null %}
                            <span class="text-body-secondary"> — il y a {{ auto_update_silent_days }} jour{{ auto_update_silent_days > 1 ? 's' : '' }}</span>
                        {%- endif -%}
                    {% else %}
                        <span class="text-body-secondary">aucune installée à ce jour</span>
                    {% endif %}
                </p>

                {% if update_last_attempt_failed %}
                    <p class="small text-danger mb-0 mt-1" id="maintenance-update-last-attempt">
                        La dernière tentative
                        {%- if update_last_attempt_at %} ({{ update_last_attempt_at|datetime_fr }}){% endif %}
                        {{ update_last_attempt_status == 'rolled_back'
                            ? 'a échoué et le site a été restauré automatiquement'
                            : 'a échoué' }} — voir l'historique des mises à jour sur la page
                    <a href="/config/maintenance/mise-a-jour">Mise à jour</a>.
                    </p>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}
