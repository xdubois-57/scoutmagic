{# The macros the Maintenance sub-pages share (issue #619), imported by
   each of them as . #}

{# One row of « Sauvegardes récentes ». A macro because the list is cut
   in two — the five shown, then the rest inside a <details> — and two
   copies of the same row would drift apart at the first fix. Every
   string it displays (the type label, the family's label and colour, the
   size) arrives already written from
   Core\Http\Controller\MaintenanceController::backupList(): a choice
   made in a Twig file is a choice nobody can test, and the deletion
   confirmation must name the backup in exactly the words of the row. #}
{% macro backup_rows(rows) %}
    <ul class="list-unstyled mb-0">
        {% for backup in rows %}
            <li class="d-flex flex-wrap align-items-center gap-2 border-bottom py-2">
                <div class="flex-grow-1">
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <span class="badge {{ backup.familyClass }}">{{ backup.typeLabel }}</span>
                        {% if backup.integrityLabel %}
                            <span class="badge {{ backup.integrityClass }}"
                                  {% if backup.integrityExplanation %}title="{{ backup.integrityExplanation }}"{% endif %}>
                                {{ backup.integrityLabel }}
                            </span>
                        {% endif %}
                        {% if backup.status == 'in_progress' %}
                            {% include 'partials/status_badge.html.twig' with { status: 'in_progress', label: 'En cours' } only %}
                        {% elseif backup.status == 'pending' %}
                            {% include 'partials/status_badge.html.twig' with { status: 'pending', label: 'En attente' } only %}
                        {% elseif backup.status == 'failed' %}
                            {# title tooltip (error detail) — kept out of the shared partial #}
                            <span class="badge text-bg-danger" title="{{ backup.errorMessage }}">Échouée</span>
                        {% endif %}
                    </div>
                    <div class="small text-body-secondary mt-1">
                        {{ backup.createdAt }}{% if backup.sizeLabel %} · {{ backup.sizeLabel }}{% endif %}
                    </div>
                </div>
                {# Two icons rather than two labelled buttons. A row
                   already carries up to three badges, a date and a size;
                   « Télécharger » and « Supprimer » spelled out wrapped it
                   onto a second line as soon as an integrity badge
                   appeared — on a phone and on a wide screen alike. The
                   accessible name stays whole and names the backup: there
                   are up to fifteen rows, and fifteen identical
                   « Supprimer » tell them apart for nobody (design.md
                   §7.4 — an icon-only action carries its wording in title
                   and aria-label). #}
                {% if backup.status == 'completed' and backup.fileId %}
                    {% include 'partials/file_link.html.twig' with {
                        href: '/files/' ~ backup.fileId,
                        label: '',
                        aria_label: 'Télécharger la sauvegarde « ' ~ backup.typeLabel ~ ' » du ' ~ backup.createdAt,
                        title: 'Télécharger',
                        classes: 'btn btn-sm btn-outline-secondary',
                        icon: 'download',
                    } only %}
                    {# The generated password, revealed on demand (IT-03):
                       POST and journaled, never printed in the page. #}
                    {% if backup.hasPassword %}
                        <button type="button" class="btn btn-sm btn-outline-secondary"
                                data-backup-password="{{ backup.id }}" title="Afficher le mot de passe"
                                aria-controls="backup-password-{{ backup.id }}"
                                aria-label="Afficher le mot de passe de la sauvegarde « {{ backup.typeLabel }} » du {{ backup.createdAt }}">
                            <i class="bi bi-key" aria-hidden="true"></i>
                        </button>
                    {% endif %}
                {% endif %}
                {# The confirmation is `data-confirm` on the FORM
                   (design.md §7.5) and names the backup. No keyword to
                   type: that level is kept for the three reset actions
                   (§8.18), and making it routine would weaken it where it
                   really matters.

                   A « before an operation » backup adds a sentence: it is
                   the one an automatic rollback depends on. The hard
                   refusal only applies while a task references it and is
                   running — Core\Maintenance\BackupSafetyNet decides that
                   on the server and says why. #}
                <form method="post" action="/config/maintenance/backup/{{ backup.id }}/delete"
                      data-confirm="Supprimer la sauvegarde « {{ backup.typeLabel }} » du {{ backup.createdAt }}{% if backup.sizeLabel %} ({{ backup.sizeLabel }}){% endif %} ?{% if backup.isOperational %} C'est la sauvegarde de sécurité d'une opération : tant qu'elle existe, un retour en arrière automatique reste possible.{% endif %}"
                      data-confirm-label="Supprimer">
                    {{ csrf_field()|raw }}
                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Supprimer"
                            aria-label="Supprimer la sauvegarde « {{ backup.typeLabel }} » du {{ backup.createdAt }}">
                        <i class="bi bi-trash" aria-hidden="true"></i>
                    </button>
                </form>
                {% if backup.hasPassword %}
                    <output class="w-100 small d-none" id="backup-password-{{ backup.id }}" aria-live="polite"></output>
                {% endif %}
            </li>
        {% endfor %}
    </ul>
{% endmacro %}

{# The title of one box on a Maintenance sub-page (issue #744).

   It used to be a button folding the box's body — the move that made
   sense when one page carried eight boxes. Since #619 each sub-page holds
   one or two, and a box is the reason the visitor opened its page: a
   fold there was a control that could only hide what was asked for. So
   it is a plain heading now, still an <h2>, so the <h3> sections each
   box holds keep a parent in the document outline. #}
{% macro section_header(title, icon, heading_class) %}
    <h2 class="h5 mb-0 d-flex align-items-center gap-2{{ heading_class ? ' ' ~ heading_class }}">
        {% if icon %}<i class="bi bi-{{ icon }}" aria-hidden="true"></i>{% endif %}
        <span>{{ title }}</span>
    </h2>
{% endmacro %}
