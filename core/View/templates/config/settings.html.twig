{% extends 'base.html.twig' %}
{% block title %}Réglages — {{ param('site_name') }}{% endblock %}
{% block content %}
    {% include 'partials/page_header.html.twig' with { title: 'Réglages' } only %}

    {# One collapsible section per module group, all folded.
       Flat, this page measured over 11 000 px — every setting of every
       module in one uninterrupted wall, with no way to see what modules
       even have settings without scrolling through all of them. Folded,
       the page is its own table of contents: ~20 headers, each opening
       on demand. The rows inside a folded section are still in the DOM,
       so settings.js's row wiring is untouched. #}
    {% for group_id, group in setting_groups %}
        <div class="mb-3">
            <button type="button"
                    class="btn w-100 d-flex align-items-center gap-2 border rounded-3 p-3 text-start collapsed"
                    data-bs-toggle="collapse" data-bs-target="#settings-group-{{ group_id }}"
                    aria-expanded="false" aria-controls="settings-group-{{ group_id }}">
                <i class="bi {{ group.icon ?? 'bi-gear' }} text-body-secondary" aria-hidden="true"></i>
                <span class="flex-grow-1">
                    <span class="h5 mb-0 d-block">{{ group.label }}</span>
                    {% if group.description %}
                        <span class="text-body-secondary small d-block">{{ group.description }}</span>
                    {% endif %}
                </span>
                <span class="badge text-bg-secondary">{{ group.settings|length }}</span>
                <i class="bi bi-chevron-down text-body-tertiary" aria-hidden="true"></i>
            </button>
            <div class="collapse mt-2" id="settings-group-{{ group_id }}">
            <div class="border rounded-3 overflow-hidden">
                {% for setting in group.settings %}
                    {% if setting.editable %}
                        <div class="d-flex align-items-center justify-content-between p-3 border-bottom setting-row"
                             data-module="{{ group_id }}" data-key="{{ setting.setting_key }}"
                             data-type="{{ setting.setting_type }}" data-regex="{{ setting.validation_regex }}"
                             data-label="{{ setting.label }}" data-description="{{ setting.description }}"
                             data-value="{{ setting.setting_value }}"
                             data-options='{{ setting.select_options|default("[]") }}'
                             style="cursor:pointer;">
                            <div>
                                <div class="small fw-semibold">{{ setting.label }}</div>
                                <div class="text-body-secondary" style="font-size:0.75rem;">
                                    {{ setting.description }}
                                </div>
                            </div>
                            <div class="d-flex align-items-center gap-2 text-nowrap">
                                <span class="text-body-secondary small">
                                    {% if setting.setting_type == 'boolean' %}
                                        {{ setting.setting_value == '1' ? 'Oui' : 'Non' }}
                                    {% elseif setting.setting_type == 'color' %}
                                        <span class="d-inline-block rounded"
                                              style="width:14px;height:14px;background:{{ setting.setting_value }};vertical-align:middle;"></span>
                                        {{ setting.setting_value }}
                                    {% else %}
                                        {{ setting.setting_value|length > 40 ? setting.setting_value[:40] ~ '…' : setting.setting_value }}
                                    {% endif %}
                                </span>
                                <i class="bi bi-chevron-right text-body-tertiary small" aria-hidden="true"></i>
                            </div>
                        </div>
                    {% else %}
                        <div class="d-flex align-items-center justify-content-between p-3 border-bottom"
                             style="opacity:0.5;">
                            <div>
                                <div class="small fw-semibold">{{ setting.label }}</div>
                                <div class="text-body-secondary" style="font-size:0.75rem;">
                                    {{ setting.description }}
                                </div>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <span class="text-body-secondary small">{{ setting.setting_value }}</span>
                                <i class="bi bi-lock text-body-tertiary small" aria-hidden="true"></i>
                            </div>
                        </div>
                    {% endif %}
                {% endfor %}
            </div>
            </div>
        </div>
    {% endfor %}

{# Edit dialog modal — the title text is filled by settings.js, which
   targets the skeleton's canonical '{id}-title' id. #}
{% embed 'partials/modal.html.twig' with { id: 'settingEditModal', title: '' } only %}
    {% block body %}
        <p class="text-body-secondary small" id="settingEditDescription"></p>
        <div class="form-label" id="settingEditLabel"></div>
        <div id="settingEditInputContainer"></div>
        <div class="text-danger small mt-1 d-none" id="settingEditError" role="alert"></div>
        <p class="text-body-secondary mt-2" style="font-size:0.7rem;" id="settingEditType"></p>
    {% endblock %}
    {% block footer %}
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Annuler</button>
        <button type="button" class="btn btn-primary" id="settingEditSave">Enregistrer</button>
    {% endblock %}
{% endembed %}
{% endblock %}

{% block scripts %}
<script src="/assets/js/settings.js" defer></script>
{% endblock %}
