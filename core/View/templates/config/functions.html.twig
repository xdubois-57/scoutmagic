{% extends 'base.html.twig' %}
{% block title %}Correspondances Desk — {{ site_name }}{% endblock %}
{% block content %}
    {% include 'partials/page_header.html.twig' with { title: 'Correspondances Desk' } only %}

    {#
      What the import could not match to anything this site knows
      (issue #356). It sits above the page's own sections because it is the
      one thing on this screen that is about the LAST import rather than
      about the site's settled configuration — and because a branch nobody
      recognised is otherwise announced nowhere at all: it has no
      « à confirmer » state of its own, it just sorts last, for ever.

      Each kind gets its own sentence and its own action: « corriger »
      means giving a role or choosing a logo, and a single generic button
      would send half of them to the wrong place.
    #}
    {% if mapping_gaps|length > 0 %}
        <div class="card border-warning mb-4">
            <div class="card-header bg-warning-subtle fw-semibold">
                <i class="bi bi-question-circle" aria-hidden="true"></i>
                {{ mapping_gaps|length > 1
                    ? mapping_gaps|length ~ ' valeurs que le site ne connaît pas'
                    : 'Une valeur que le site ne connaît pas' }}
            </div>
            <div class="card-body">
                <p class="small text-body-secondary">
                    L'import a rencontré des valeurs pour lesquelles le site n'a pas de correspondance.
                    Il les a créées telles quelles, avec les réglages les plus prudents.
                    Vous pouvez les corriger ici sans attendre.
                </p>

                <ul class="list-unstyled mb-0">
                    {% for gap in mapping_gaps %}
                        <li class="border-top pt-3 mt-3">
                            <div class="d-flex flex-wrap align-items-baseline gap-2">
                                <span class="badge text-bg-light">
                                    {% if gap.kind == 'function' %}Fonction
                                    {% else %}Branche
                                    {% endif %}
                                </span>
                                <span class="fw-semibold flex-grow-1">{{ gap.value }}</span>
                                {% if gap.affected > 0 %}
                                    <span class="small text-body-secondary">
                                        {{ gap.affected }}
                                        {% if gap.kind == 'branch' %}
                                            {{ gap.affected > 1 ? 'sections' : 'section' }}
                                        {% else %}
                                            {{ gap.affected > 1 ? 'membres' : 'membre' }}
                                        {% endif %}
                                    </span>
                                {% endif %}
                            </div>
                            <p class="small mb-1">
                                {% if gap.kind == 'function' %}
                                    {% if gap.affected > 0 %}
                                        {{ gap.affected > 1
                                            ? gap.affected ~ ' personnes ont cette fonction. Elles ne voient'
                                            : 'Une personne a cette fonction. Elle ne voit' }}
                                        rien de plus qu'un membre ordinaire tant que vous ne lui donnez pas un rôle.
                                    {% else %}
                                        Personne ne porte cette fonction cette année. Donnez-lui quand même un rôle :
                                        le prochain import s'en servira.
                                    {% endif %}
                                {% else %}
                                    Le site ne reconnaît pas cette branche : elle n'a pas de logo
                                    et se range en dernier dans toutes les listes.
                                {% endif %}
                            </p>
                            {% if gap.action_url is not null %}
                                <a class="small" href="{{ gap.action_url }}">{{ gap.action_label }}</a>
                            {% endif %}
                        </li>
                    {% endfor %}
                </ul>

                {#
                  The counterpart of sending: a chief is told that the
                  labels travel, on the screen where they are shown. Only
                  when the daily report is actually enabled — saying it on
                  an installation that switched reporting off would be
                  false in the other direction.
                #}
                {% if param('statistics_enabled') == '1' %}
                    <p class="small text-body-secondary mt-3 mb-0">
                        Ces valeurs sont aussi signalées au mainteneur du site, pour qu'il les ajoute
                        aux versions suivantes. Seul le libellé est transmis.
                    </p>
                {% endif %}
            </div>
        </div>
    {% endif %}

    <h2 class="h4" id="fonctions">Fonctions</h2>
    <p class="text-body-secondary mb-4">
        Associez chaque fonction importée depuis Desk à un rôle sur le site.
        Les fonctions non confirmées ont le rôle "Animé" par défaut —
        aucun accès élevé n'est accordé automatiquement.
    </p>
    <p class="text-body-secondary small">
        Les changements de rôle prennent effet à la prochaine connexion des membres concernés.
    </p>

    {# Unconfirmed functions #}
    {% if unconfirmed|length > 0 %}

        <div class="border rounded-3 overflow-hidden mb-4">
            {% for func in unconfirmed %}
                <div class="d-flex align-items-center justify-content-between p-3 border-bottom function-row"
                     data-id="{{ func.id }}">
                    <div>
                        <span class="fw-semibold">{{ func.desk_code }}</span>
                        <span class="ms-2">{% include 'partials/status_badge.html.twig' with { status: 'pending', label: 'Non confirmée' } only %}</span>
                    </div>
                    <label class="visually-hidden" for="unconfirmed-role-{{ func.id }}">Rôle pour {{ func.desk_code }}</label>
                    <select class="form-select form-select-sm w-auto role-select" id="unconfirmed-role-{{ func.id }}" data-id="{{ func.id }}">
                        {% for role in roles %}
                            <option value="{{ role.value }}"
                                    {{ func.role == role.value ? 'selected' : '' }}>
                                {{ role.label }}
                            </option>
                        {% endfor %}
                    </select>
                </div>
            {% endfor %}
        </div>
    {% endif %}

    {# Confirmed functions grouped by role #}
    {% for role_value, role_group in confirmed_by_role %}
        <div class="mb-4">
            <h2 class="h6 d-flex align-items-center gap-2 mb-2">
                <span class="badge {{ role_group.badge_class }}">{{ role_group.label }}</span>
                <span class="text-body-secondary small">{{ role_group.functions|length }} fonction(s)</span>
            </h2>
            <div class="border rounded-3 overflow-hidden">
                {% for func in role_group.functions %}
                    <div class="d-flex align-items-center justify-content-between p-3 border-bottom function-row"
                         data-id="{{ func.id }}">
                        <div>
                            <span class="fw-semibold">{{ func.desk_code }}</span>
                            {% if func.label != func.desk_code %}
                                <span class="text-body-secondary small ms-1">({{ func.label }})</span>
                            {% endif %}
                        </div>
                        <div class="d-flex align-items-center gap-3">
                            {% if function_flags is not null and role_value in ['chief', 'admin'] %}
                                {% set is_lead = function_flags.flags[func.id]|default(false) %}
                                <div class="d-flex align-items-center gap-2 small text-body-secondary flags-group" data-id="{{ func.id }}">
                                    <label class="d-flex align-items-center gap-1 mb-0">
                                        <input type="checkbox" class="form-check-input flag-lead" {{ is_lead ? 'checked' : '' }}>
                                        {{ function_flags.lead_label }}
                                    </label>
                                </div>
                            {% endif %}
                            {% include 'partials/form_field.html.twig' with {
                                field_id: 'confirmed-role-' ~ func.id,
                                label: 'Rôle pour ' ~ func.desk_code,
                                label_visually_hidden: true,
                                type: 'select', size: 'sm', wrapper_class: '',
                                control_class_extra: 'w-auto role-select',
                                data: { id: func.id },
                                options: roles|default([])|map(role => {
                                    value: role.value, label: role.label,
                                    selected: func.role == role.value,
                                }),
                            } only %}
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    {% endfor %}

    {% if function_flags is not null %}
        <p class="text-body-secondary small">
            <i class="bi bi-info-circle" aria-hidden="true"></i> {{ function_flags.section_label }} :
            « {{ function_flags.lead_label }} » s'applique aux fonctions Chef et Chef d'Unité ci-dessus.
        </p>
    {% endif %}

    {% if unconfirmed is empty and confirmed_by_role is empty %}
        {% include 'partials/empty_state.html.twig' with {
            message: 'Aucune fonction importée. Les fonctions apparaîtront après le premier import Desk.',
            compact: true,
        } only %}
    {% endif %}

    <hr class="my-4">

    <h2 class="h4">Sections</h2>
    <p class="text-body-secondary mb-4">
        Renommez une section, définissez son email organisationnel (utilisé
        pour les communications avec les parents), changez sa couleur ou
        masquez-la des sélecteurs de section du site (Staffs, Trombinoscope,
        calendrier, statistiques, page publique Sections). Par défaut, la couleur suit
        la branche d'âge (Baladins, Louveteaux, Éclaireurs, Pionniers) ou
        est celle du Staff d'U ; le bouton <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>
        efface une couleur personnalisée et revient à cette valeur par
        défaut. Une section sans aucun membre à l'import Desk devient
        automatiquement inactive et disparaît de partout, y compris de
        cette page — elle n'est jamais supprimée, et redevient active (et
        gérable ici) dès qu'un import lui redonne des membres.
    </p>

    {% if section_groups|length > 0 %}
        {% for group in section_groups %}
            <div class="mb-4">
                <h2 class="h6 mb-2">{{ group.branch_name }}</h2>
                <div class="border rounded-3 overflow-hidden">
                    {% for section in group.sections %}
                        <div class="border-bottom section-row" data-id="{{ section.id }}">
                        <div class="d-flex flex-wrap align-items-center gap-2 gap-md-3 p-3">
                            <span class="text-body-secondary small text-nowrap">{{ section.desk_code }}</span>
                            <input type="text" class="form-control form-control-sm section-name-input flex-grow-1"
                                   value="{{ section.name }}" placeholder="{{ section.desk_code }}"
                                   aria-label="Nom de la section {{ section.desk_code }}"
                                   style="min-width:120px;">
                            <input type="email" class="form-control form-control-sm section-email-input flex-grow-1"
                                   value="{{ section.email }}" placeholder="section@unite-exemple.be"
                                   aria-label="Email de la section {{ section.desk_code }}"
                                   style="min-width:160px;">
                            <div class="d-flex align-items-center gap-1">
                                <input type="color" class="form-control form-control-color section-color-input"
                                       value="{{ section.effective_color }}" title="Couleur de la section"
                                       aria-label="Couleur de la section"
                                       data-has-override="{{ section.color ? '1' : '0' }}">
                                <button type="button" class="btn btn-sm btn-outline-secondary section-color-reset"
                                        title="Revenir à la couleur par défaut" aria-label="Revenir à la couleur par défaut" {{ section.color ? '' : 'disabled' }}>
                                    <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>
                                </button>
                            </div>
                            <div class="form-check form-switch ms-auto text-nowrap">
                                <input type="checkbox" class="form-check-input section-visible-input" role="switch"
                                       id="section-visible-{{ section.id }}"
                                       {{ section.is_visible ? 'checked' : '' }}
                                       aria-checked="{{ section.is_visible ? 'true' : 'false' }}">
                                <label class="form-check-label small" for="section-visible-{{ section.id }}">Visible</label>
                            </div>
                        </div>
                        {# The DMARC warning for an address this site cannot sign for (issue #418). The
                           element is always in the page, hidden when there is nothing to say, so a save
                           has somewhere to write its answer without rebuilding the row. #}
                        <div class="px-3 pb-3 pt-0 small text-warning-emphasis section-email-warning{{ section.alignment_warning is empty ? ' d-none' : '' }}"
                             role="status">
                            <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
                            <span class="section-email-warning-text">{{ section.alignment_warning }}</span>
                        </div>
                        </div>
                    {% endfor %}
                </div>
            </div>
        {% endfor %}
    {% else %}
        {% include 'partials/empty_state.html.twig' with {
            message: 'Aucune section importée. Les sections apparaîtront après le premier import Desk.',
            compact: true,
        } only %}
    {% endif %}

    <hr class="my-4">

    <h2 class="h4" id="branches">Branches</h2>
    <p class="text-body-secondary mb-4">
        Configurez, pour chaque branche d'âge, le logo fédéral et le lien
        d'explication affichés sur la carte de branche de l'espace animés.
        Sans logo téléversé, un logo par défaut est utilisé quand
        il existe ; sans lien personnalisé, le lien par défaut de la
        fédération Les Scouts est utilisé.
    </p>

    {% if branches|length > 0 %}
        <div class="border rounded-3 overflow-hidden mb-4">
            {% for branch in branches %}
                <div class="d-flex flex-wrap align-items-center gap-2 gap-md-3 p-3 border-bottom branch-row" data-id="{{ branch.id }}">
                    <div class="d-flex align-items-center gap-2" style="min-width:64px;">
                        {% if branch.logo_file_id %}
                            <img src="{{ file_url(branch.logo_file_id, 'md') }}" alt="{{ branch.label }}" class="rounded" style="width:48px;height:48px;object-fit:contain;">
                        {% elseif branch.default_logo %}
                            <img src="{{ asset('/assets/img/branches/' ~ branch.default_logo) }}" alt="{{ branch.label }}" class="rounded" style="width:48px;height:48px;object-fit:contain;">
                        {% else %}
                            <div class="d-flex align-items-center justify-content-center bg-body-tertiary rounded" style="width:48px;height:48px;">
                                <i class="bi bi-image text-body-secondary" aria-hidden="true"></i>
                            </div>
                        {% endif %}
                        <a class="btn btn-sm btn-outline-secondary" href="/upload?context=age_branch_logo&key={{ branch.id }}&return=/config/functions">
                            {{ branch.logo_file_id ? 'Changer' : 'Ajouter' }}
                        </a>
                    </div>
                    <span class="fw-semibold text-nowrap" style="min-width:100px;">{{ branch.label }}</span>
                    <input type="url" class="form-control form-control-sm branch-url-input flex-grow-1"
                           value="{{ branch.explanation_url }}" placeholder="https://lesscouts.be/..."
                           aria-label="Lien d'explication de la branche {{ branch.label }}"
                           style="min-width:220px;">
                </div>
            {% endfor %}
        </div>
    {% else %}
        {% include 'partials/empty_state.html.twig' with {
            message: "Aucune branche d'âge importée. Les branches apparaîtront après le premier import Desk.",
            compact: true,
        } only %}
    {% endif %}
{% endblock %}

{% block scripts %}
<script src="{{ asset('/assets/js/config-functions.js') }}" defer></script>
{% endblock %}
