{% extends "base.html.twig" %}

{% block title %}Confirmation d'adresse email — {{ site_name }}{% endblock %}

{% block content %}
<div class="page-narrow">
    <h1 class="mb-4 text-center">Confirmation d'adresse email</h1>

    <div class="card">
        <div class="card-body text-center py-4">
            {% if confirmed %}
                <p class="text-success mb-3"><i class="bi bi-check-circle"></i> Votre adresse email a bien été confirmée.</p>
            {% else %}
                <p class="text-danger mb-3">Ce lien de confirmation n'est plus valide (expiré, déjà utilisé, ou incorrect).</p>
            {% endif %}
            <a href="/login" class="btn btn-outline-secondary">Retour à la connexion</a>
        </div>
    </div>
</div>
{% endblock %}
