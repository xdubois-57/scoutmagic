{% extends 'base.html.twig' %}
{% block title %}{{ member|display_name }} — {{ site_name }}{% endblock %}
{# member_photo()/section_photo() sizing (.member-photo-header, .member-photo
   etc.) lives in components.css, which base.html.twig does NOT load by
   default — every other page using these components (Staffs, trombinoscope,
   calendar) links it explicitly via this same block. Without this link the
   photo/placeholder has no sizing rule at all and the <img> renders at its
   raw intrinsic size, which is the actual root cause of the member photo
   "taking the whole screen" — not the CSS technique itself. #}
{% block stylesheets %}
<link rel="stylesheet" href="/assets/css/components.css">
{% endblock %}
{% block content %}
    {# Header — photo (replaceable by the member themselves outside config
       mode via the $editable param), sized to match the two-line text
       beside it: name/totem, then section/year. Same sizing technique as
       the trombinoscope/Staffs photos (member_photo() with a
       width+aspect-ratio class, no wrapper) — see .member-photo-header
       in components.css for why that matters. #}
    <div class="d-flex align-items-center gap-3 mb-4">
        {{ member_photo(member.memberId, member|display_name, 'rounded-circle member-photo-header', is_self) }}
        <div>
            <h1 class="h5 mb-0">{{ member|display_name_full }}</h1>
            <div class="text-body-secondary small">
                {% if section_info %}{{ section_info.section.name ?? section_info.section.desk_code }} — {% endif %}{{ member.scoutYearLabel }}
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-12 col-lg-8">
            {# §3 — Informations essentielles — always shown; falls back to
               a plain message when the member has no section at all. #}
            <div class="card mb-3">
                <div class="card-body">
                    <h2 class="h5 mb-3">Informations essentielles</h2>
                    {% if not section_info %}
                        {% include 'partials/empty_state.html.twig' with {
                            message: 'Aucune section connue pour ce membre.',
                            compact: true,
                        } only %}
                    {% else %}
                        <div class="mb-3">
                            <span class="text-body-secondary d-block small">Section</span>
                            {{ section_info.section.name ?? section_info.section.desk_code }}
                            {% if section_info.section.email %}
                                <div class="small">
                                    <i class="bi bi-envelope text-body-secondary" aria-hidden="true"></i>
                                    <a href="mailto:{{ section_info.section.email }}">{{ section_info.section.email }}</a>
                                </div>
                            {% endif %}
                        </div>

                        {% if section_info.responsable %}
                            <div class="mb-3">
                                <span class="text-body-secondary d-block small">Responsable</span>
                                {{ section_info.responsable|display_name_full }}
                                {% if section_info.responsable.addresses|length > 0 %}
                                    <div class="small text-body-secondary">{{ section_info.responsable.addresses[0].format()|normalize_address }}</div>
                                {% endif %}
                            </div>
                        {% endif %}

                        {% if section_info.badge_assignments|length > 0 %}
                            <div class="mb-3">
                                <span class="text-body-secondary d-block small">Badges de la section</span>
                                <ul class="list-unstyled mb-0 small">
                                    {% for badge_name, holders in section_info.badge_assignments %}
                                        <li>
                                            {{ badge_name }} —
                                            {% for holder in holders %}{{ holder|display_name_full }}{% if not loop.last %}, {% endif %}{% endfor %}
                                        </li>
                                    {% endfor %}
                                </ul>
                            </div>
                        {% endif %}

                        {% if section_info.referent_holders|length > 0 %}
                            <div class="mb-3">
                                <span class="text-body-secondary d-block small">Référent(s) Staff d'U</span>
                                <span class="small">
                                    {% for holder in section_info.referent_holders %}{{ holder|display_name_full }}{% if not loop.last %}, {% endif %}{% endfor %}
                                </span>
                            </div>
                        {% endif %}

                        {% if calendar_enabled and section_info.next_event %}
                            <div class="mb-3">
                                <span class="text-body-secondary d-block small">Prochain évènement</span>
                                <span class="small">{{ section_info.next_event.title }} — {{ section_info.next_event.startDate|french_date }}</span>
                            </div>
                        {% endif %}

                        {% if section_info.functions_this_year|length > 0 %}
                            <div class="mb-3">
                                <span class="text-body-secondary d-block small">Fonctions cette année</span>
                                <ul class="list-unstyled mb-0 small">
                                    {% for func in section_info.functions_this_year %}
                                        <li>{{ func.functionLabel }}</li>
                                    {% endfor %}
                                </ul>
                            </div>
                        {% endif %}

                        {% if trombinoscope_enabled or calendar_enabled %}
                            <div class="d-flex flex-wrap gap-2 mt-3">
                                {% if trombinoscope_enabled %}
                                    <a href="/trombinoscope?section={{ section_info.section.id }}" class="btn btn-sm btn-outline-secondary">
                                        <i class="bi bi-people" aria-hidden="true"></i> Trombinoscope de la section
                                    </a>
                                {% endif %}
                                {% if calendar_enabled %}
                                    <a href="/calendar?section={{ section_info.section.id }}" class="btn btn-sm btn-outline-secondary">
                                        <i class="bi bi-calendar3" aria-hidden="true"></i> Calendrier de la section
                                    </a>
                                {% endif %}
                            </div>
                        {% endif %}
                    {% endif %}
                </div>
            </div>

            {# §4 — Communications récentes — always shown when mass_mail is
               enabled, with an empty-state message when there's nothing yet
               (an empty array alone can't tell "no data" from "disabled"). #}
            {% if mass_mail_enabled %}
                <div class="card mb-3">
                    <div class="card-body">
                        <h2 class="h5 mb-3">Communications récentes</h2>
                        {% if recent_mass_mail_emails|length > 0 %}
                            <ul class="list-unstyled mb-0 small">
                                {% for item in recent_mass_mail_emails %}
                                    <li class="d-flex justify-content-between border-bottom py-2">
                                        <a href="/members/{{ member.memberYearId }}/emails/{{ item.id }}" class="text-decoration-none">{{ item.subject }}</a>
                                        <span class="text-body-secondary">{{ item.section_name }} · {{ item.sent_at|french_date }}</span>
                                    </li>
                                {% endfor %}
                            </ul>
                        {% else %}
                            {% include 'partials/empty_state.html.twig' with {
                                message: 'Aucune communication pour le moment.',
                                compact: true,
                            } only %}
                        {% endif %}
                    </div>
                </div>
            {% endif %}

            {# §5 — Documents privés (self only, no staff bypass) — always
               shown to the member themselves, empty-state when there's
               nothing yet. #}
            {% if is_self %}
                <div class="card mb-3">
                    <div class="card-body">
                        <h2 class="h5 mb-3">Documents privés</h2>
                        {% if member_documents|length > 0 %}
                            <ul class="list-unstyled mb-0 small">
                                {% for document in member_documents %}
                                    <li class="d-flex justify-content-between border-bottom py-2">
                                        <a href="{{ file_url(document.fileId) }}" class="text-decoration-none">
                                            <i class="bi bi-file-earmark-lock" aria-hidden="true"></i> {{ document.title }}
                                        </a>
                                        <span class="text-body-secondary">{{ document.createdAt|french_date }}</span>
                                    </li>
                                {% endfor %}
                            </ul>
                        {% else %}
                            {% include 'partials/empty_state.html.twig' with {
                                message: 'Aucun document privé pour le moment.',
                                compact: true,
                            } only %}
                        {% endif %}
                    </div>
                </div>
            {% endif %}

            {# §5bis — Documents de section: every past/present section the
               member was active in that has staff-uploaded documents, most
               recent year first (module addendum). Unlike Documents privés
               above, shown to both the member and a viewing chief/admin —
               staff-shared content, not a private upload — and the whole
               card is simply omitted when there's nothing to show, since
               member_section_documents is already pre-filtered server-side
               to years that actually have documents. #}
            {% if member_section_documents|length > 0 %}
                <div class="card mb-3">
                    <div class="card-body">
                        <h2 class="h5 mb-3">Documents de section</h2>
                        {% for year_block in member_section_documents %}
                            <div class="mb-3">
                                <div class="fw-semibold small text-body-secondary mb-1">
                                    {{ year_block.section.name ?? year_block.section.desk_code }} — {{ year_block.scout_year.label }}
                                </div>
                                <ul class="list-unstyled mb-0 small">
                                    {% for document in year_block.documents %}
                                        <li class="d-flex justify-content-between border-bottom py-2">
                                            <a href="{{ file_url(document.fileId) }}" class="text-decoration-none" target="_blank" rel="noopener">
                                                <i class="bi bi-file-earmark-arrow-down" aria-hidden="true"></i> {{ document.title }}
                                                {% if document.description %}
                                                    <span class="text-body-secondary">— {{ document.description }}</span>
                                                {% endif %}
                                            </a>
                                        </li>
                                    {% endfor %}
                                </ul>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            {% endif %}

            {# §6 — Galeries photos (gallery module, optional) — always shown
               when the module is enabled, empty-state when there's nothing
               yet. #}
            {% if gallery_enabled %}
                <div class="card mb-3">
                    <div class="card-body">
                        <h2 class="h5 mb-3">Galeries photos</h2>
                        {% if gallery_albums|length > 0 %}
                            <div class="row g-2">
                                {% for album in gallery_albums %}
                                    <div class="col-6 col-md-4 col-lg-2">
                                        {# Real attributes, not an emitted attribute string: autoescaping
                                           turns the quotes into &quot;, leaving a named target of
                                           «"_blank"» and no noopener protection on an outbound link
                                           (Modules\Gallery\Api\GalleryAlbumProvider hands back the
                                           third-party album URL verbatim). #}
                                        <a href="{{ album.url }}" class="text-decoration-none text-body"
                                           {% if album.url starts with 'http' %}target="_blank" rel="noopener noreferrer"{% endif %}>
                                            <div class="bg-body-tertiary rounded d-flex align-items-center justify-content-center" style="aspect-ratio:1/1;overflow:hidden;">
                                                {% if album.cover_url %}
                                                    <img src="{{ album.cover_url }}" alt="" class="w-100 h-100" style="object-fit:cover;">
                                                {% else %}
                                                    <i class="bi bi-images text-body-secondary" aria-hidden="true"></i>
                                                {% endif %}
                                            </div>
                                            <p class="small mb-0 mt-1 text-truncate">{{ album.title }}</p>
                                        </a>
                                    </div>
                                {% endfor %}
                            </div>
                        {% else %}
                            {% include 'partials/empty_state.html.twig' with {
                                message: 'Aucune galerie pour le moment.',
                                compact: true,
                            } only %}
                        {% endif %}
                    </div>
                </div>
            {% endif %}

            {# §7bis — Adresses email (self-service only, no chief/admin
               bypass — module addendum: "a member manages ONLY their own
               secondary emails"). The Desk-imported address is always
               shown first, never editable/deletable, and stays 'valide'
               unless it was unsubscribed from mass-mail (see
               Core\Member\MemberEmailService::listForMember()). #}
            {% if is_self %}
                <div class="card mb-3">
                    <div class="card-body">
                        <h2 class="h5 mb-3">Adresses email</h2>
                        <p class="small text-body-secondary">Les emails qui vous concernent seront envoyés à toutes les adresses ci-dessous, et chacune d'elles peut être utilisée pour vous connecter.</p>
                        {% for row in member_emails %}
                            <div class="d-flex justify-content-between align-items-start border-bottom py-2 flex-wrap gap-2">
                                <div>
                                    <div>
                                        {{ row.email }}
                                        {% if row.status == 'valid' %}
                                            {% include 'partials/status_badge.html.twig' with { status: 'confirmed', label: 'Valide' } only %}
                                        {% elseif row.status == 'pending' %}
                                            {% include 'partials/status_badge.html.twig' with { status: 'pending', label: 'En attente de confirmation' } only %}
                                        {% else %}
                                            {% include 'partials/status_badge.html.twig' with { status: 'inactive', label: 'Inactif' } only %}
                                        {% endif %}
                                    </div>
                                    {% if row.source == 'desk' %}
                                        <div class="small text-body-secondary">Adresse importée depuis la base de données de la fédération</div>
                                        {% if row.status == 'inactive' %}
                                            <div class="small text-body-secondary">Désinscrit(e) des emails groupés le {{ row.deactivatedAt|french_date }}</div>
                                        {% endif %}
                                    {% elseif row.status == 'valid' %}
                                        <div class="small text-body-secondary">Confirmée le {{ row.confirmedAt|french_date }}</div>
                                    {% elseif row.status == 'pending' %}
                                        <div class="small text-body-secondary">Email de confirmation envoyé le {{ row.lastConfirmationSentAt|french_date }}</div>
                                    {% elseif row.status == 'inactive' %}
                                        <div class="small text-body-secondary">Désinscrit(e) des emails groupés le {{ row.deactivatedAt|french_date }}</div>
                                    {% endif %}
                                </div>
                                <div class="d-flex flex-wrap gap-2">
                                    {% if row.status == 'pending' %}
                                        {% set cooldown = member_email_resend_cooldown_minutes[row.id] ?? 0 %}
                                        <form method="post" action="/members/{{ member.memberYearId }}/emails/{{ row.id }}/resend">
                                            {{ csrf_field() }}
                                            <button type="submit" class="btn btn-sm btn-outline-secondary" {% if cooldown > 0 %}disabled title="Veuillez patienter avant de renvoyer"{% endif %}>
                                                Renvoyer{% if cooldown > 0 %} (dans {{ cooldown }} min){% endif %}
                                            </button>
                                        </form>
                                    {% endif %}
                                    {% if row.status == 'inactive' %}
                                        <form method="post" action="/members/{{ member.memberYearId }}/emails/{{ row.id }}/reactivate">
                                            {{ csrf_field() }}
                                            <button type="submit" class="btn btn-sm btn-outline-primary">Réactiver</button>
                                        </form>
                                    {% endif %}
                                    {% if row.source != 'desk' %}
                                        <form method="post" action="/members/{{ member.memberYearId }}/emails/{{ row.id }}/delete" data-confirm="{% if row.status == 'pending' %}Annuler l'ajout de cette adresse email ?{% else %}Supprimer cette adresse email ?{% endif %}">
                                            {{ csrf_field() }}
                                            <button type="submit" class="btn btn-sm btn-outline-danger">{% if row.status == 'pending' %}Annuler{% else %}Supprimer{% endif %}</button>
                                        </form>
                                    {% endif %}
                                </div>
                            </div>
                        {% endfor %}

                        <form method="post" action="/members/{{ member.memberYearId }}/emails" class="d-flex flex-wrap gap-2 mt-3">
                            {{ csrf_field() }}
                            <input type="email" name="email" class="form-control form-control-sm" style="max-width:260px;" placeholder="nouvelle-adresse@example.com" aria-label="Nouvelle adresse email" required>
                            <button type="submit" class="btn btn-sm btn-primary text-nowrap">Ajouter une adresse</button>
                        </form>
                    </div>
                </div>
            {% endif %}

            {# §8 — Informations personnelles #}
            {% if show_contact %}
                <div class="card mb-3">
                    <div class="card-body">
                        <h2 class="h5 mb-3">Informations personnelles</h2>
                        <p class="small text-body-secondary">
                            Ces informations sont exportées de la base de donnée de la fédération et ne peuvent pas être modifiées via le site. Merci de contacter le staff d'U si une modification importante est nécessaire.
                        </p>
                        <div class="row g-3 small">
                            <div class="col-6 col-md-4">
                                <span class="text-body-secondary d-block">Nom complet</span>
                                {{ member|full_name }}
                            </div>
                            {% if member.phone %}
                                <div class="col-6 col-md-4">
                                    <span class="text-body-secondary d-block">Téléphone</span>
                                    <a href="tel:{{ member.phone|normalize_phone|replace({' ': ''}) }}">{{ member.phone|normalize_phone }}</a>
                                </div>
                            {% endif %}
                            {% if member.mobile %}
                                <div class="col-6 col-md-4">
                                    <span class="text-body-secondary d-block">GSM</span>
                                    <a href="tel:{{ member.mobile|normalize_phone|replace({' ': ''}) }}">{{ member.mobile|normalize_phone }}</a>
                                </div>
                            {% endif %}
                            {% if member.totem %}
                                <div class="col-6 col-md-4">
                                    <span class="text-body-secondary d-block">Totem</span>
                                    {{ member.totem|normalize_totem }}{% if member.quali %} — {{ member.quali }}{% endif %}
                                </div>
                            {% endif %}
                            {% if member.birthDate %}
                                <div class="col-6 col-md-4">
                                    <span class="text-body-secondary d-block">Date de naissance</span>
                                    {{ member.birthDate|date_fr }}
                                </div>
                            {% endif %}
                            {% if member.gender %}
                                <div class="col-6 col-md-4">
                                    <span class="text-body-secondary d-block">Genre</span>
                                    {{ member.gender }}
                                </div>
                            {% endif %}
                            {% if member.patrol %}
                                <div class="col-6 col-md-4">
                                    <span class="text-body-secondary d-block">Sizaine / Patrouille</span>
                                    {{ member.patrol }}
                                </div>
                            {% endif %}
                            {% if member.formationLevel %}
                                <div class="col-6 col-md-4">
                                    <span class="text-body-secondary d-block">Formation</span>
                                    {{ member.formationLevel }}
                                </div>
                            {% endif %}
                            {% if member.handicap %}
                                <div class="col-6 col-md-4">
                                    <span class="text-body-secondary d-block">Handicap</span>
                                    {% if member.handicap == 'true' %}Oui{% elseif member.handicap == 'false' %}Non{% else %}{{ member.handicap }}{% endif %}
                                </div>
                            {% endif %}
                            {% if member.supplementaryInsurance %}
                                <div class="col-6 col-md-4">
                                    <span class="text-body-secondary d-block">Assurance complémentaire</span>
                                    {{ member.supplementaryInsurance }}
                                </div>
                            {% endif %}
                        </div>
                        {% if show_addresses and member.addresses|length > 0 %}
                            <div class="mt-3">
                                <span class="text-body-secondary d-block small">Adresse(s)</span>
                                {% for address in member.addresses %}
                                    <div class="small {% if not loop.last %}mb-2{% endif %}">
                                        <span class="badge text-bg-secondary mb-1">{{ address.type }}</span>
                                        <div>{{ address.format()|normalize_address }}</div>
                                    </div>
                                {% endfor %}
                            </div>
                        {% endif %}
                    </div>
                </div>
            {% endif %}
        </div>

        {# §2 — Right column: ordered, extensible stack of cards. Branch
           card first, then the section's staff photo — both optional,
           each independently absent when its data isn't available, but
           kept in one column so they stack directly under each other
           rather than wrapping onto a new row. #}
        {% if branch_card or (section_info and trombinoscope_enabled) %}
            <div class="col-12 col-lg-4">
                {% if branch_card %}
                    <div class="card mb-3">
                        <div class="card-body text-center">
                            {% if branch_card.logo_file_id %}
                                <img src="{{ file_url(branch_card.logo_file_id, 'md') }}" alt="{{ branch_card.label }}" class="img-fluid mb-2" style="max-height:120px;">
                            {% elseif branch_card.default_logo %}
                                <img src="/assets/img/branches/{{ branch_card.default_logo }}" alt="{{ branch_card.label }}" class="img-fluid mb-2" style="max-height:120px;">
                            {% endif %}
                            <h2 class="h6 mb-2">{{ branch_card.label }}</h2>
                            <a href="{{ branch_card.explanation_url }}" target="_blank" rel="noopener" class="btn btn-sm btn-outline-primary">
                                En savoir plus <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i>
                            </a>
                        </div>
                    </div>
                {% endif %}

                {% if section_info and trombinoscope_enabled %}
                    <div class="card mb-3">
                        <div class="card-body text-center">
                            <h2 class="h6 mb-2">Staff {{ section_info.section.name ?? section_info.section.desk_code }}</h2>
                            {{ section_photo(section_info.section.id, section_info.section.name ?? section_info.section.desk_code) }}
                            <a href="/trombinoscope?section={{ section_info.section.id }}" class="btn btn-sm btn-outline-primary mt-2">
                                Voir dans le trombinoscope <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i>
                            </a>
                        </div>
                    </div>
                {% endif %}
            </div>
        {% endif %}
    </div>
{% endblock %}
