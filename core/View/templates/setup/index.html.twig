{% extends "base.html.twig" %}

{% block title %}{% if not is_initialized %}Installation — {{ site_name }}{% else %}Configuration — {{ site_name }}{% endif %}{% endblock %}

{% block content %}
<div class="page-narrow" id="scoutmagic-setup-wizard">

{% if not is_initialized %}
    {% include 'partials/page_header.html.twig' with {
        title: 'Installation',
        subtitle: 'Bienvenue ! Configurez les paramètres de base pour initialiser le site.',
    } only %}
{% else %}
    {% include 'partials/page_header.html.twig' with { title: 'Configuration du site' } only %}
{% endif %}

<form method="post" action="/setup/save" id="setup-form" data-initialized="{{ is_initialized ? '1' : '0' }}" novalidate>
    <input type="hidden" name="_csrf_token" value="{{ csrf_token }}">

    {# Section 1: General settings — first card on the page (moved ahead
       of Base de données): this is the section a returning admin reaches
       for most often, and it now also hosts the unit logo upload block
       below. #}
    <div class="card mb-4">
        <div class="card-body">
            <h2 class="card-title h5 mb-3">Paramètres généraux</h2>

            <div class="mb-3">
                <label for="site_name" class="form-label">Nom de l'unité</label>
                <input type="text" class="form-control{% if errors.site_name is defined %} is-invalid{% endif %}" id="site_name" name="site_name" value="{{ values.site_name ?? '' }}" required>
                <div class="form-text">Nom complet de l'unité, affiché dans le header et le titre du site.</div>
                {% if errors.site_name is defined %}<div class="invalid-feedback">{{ errors.site_name }}</div>{% endif %}
            </div>

            <div class="mb-3">
                <label for="short_name" class="form-label">Nom court</label>
                <input type="text" class="form-control{% if errors.short_name is defined %} is-invalid{% endif %}" id="short_name" name="short_name" value="{{ values.short_name ?? '' }}" maxlength="5" pattern="[A-Za-z0-9]{1,5}" required>
                <div class="form-text">Identifiant court (5 caractères maximum), utilisé comme préfixe du sujet de tous les emails envoyés par le site, par exemple [25SV].</div>
                {% if errors.short_name is defined %}<div class="invalid-feedback">{{ errors.short_name }}</div>{% endif %}
            </div>

            <div class="mb-3">
                <label for="base_url" class="form-label">URL de base</label>
                <input type="url" class="form-control{% if errors.base_url is defined %} is-invalid{% endif %}" id="base_url" name="base_url" value="{{ values.base_url ?? '' }}" placeholder="https://www.unite-exemple.be" required>
                <div class="form-text">Adresse complète du site (ex. https://www.unite-exemple.be). Utilisée pour générer les liens dans les emails.</div>
                {% if errors.base_url is defined %}<div class="invalid-feedback">{{ errors.base_url }}</div>{% endif %}
            </div>

            {% if is_initialized %}
            {# Logo de l'unité — moved here from Configuration > Réglages
               (config/settings.html.twig) so it lives in this page's own
               "Paramètres généraux" card instead. Not a key/value setting
               row (see Core\Photo\UnitLogoService's own docblock —
               is_file() is the entire state), same reasoning as before.
               Gated on is_initialized: during first-run (before
               secrets.enc exists) there is no database, so UnitLogoService
               isn't available at all (SetupController::$unitLogoService
               stays null) — nothing to upload to yet, so the block simply
               doesn't render rather than showing a broken image or a
               link into a flow that can't work without a session/DB. #}
            <hr class="my-4">
            <div class="border rounded-3 p-3 d-flex flex-wrap align-items-center gap-3">
                <img src="/pwa/icon-64.png?v={{ pwa_icon_version|default(1) }}" alt="" width="64" height="64" class="rounded border">
                <div class="flex-grow-1">
                    <div class="fw-semibold small">Logo de l'unité</div>
                    <p class="text-body-secondary small mb-2">
                        Utilisé comme favicon, comme icône de l'application installée, et dans le pied de page.
                        Image carrée, fond transparent ou uni, idéalement 512×512 px ou plus (PNG, JPEG ou WebP).
                    </p>
                    <div class="d-flex gap-2">
                        <a href="/upload?context=unit_logo&return=/setup" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-upload" aria-hidden="true"></i> Envoyer un logo
                        </a>
                        {% if unit_logo_is_custom %}
                        <button type="button" class="btn btn-sm btn-outline-danger" id="unit-logo-delete-btn">
                            <i class="bi bi-trash" aria-hidden="true"></i> Supprimer
                        </button>
                        {% endif %}
                    </div>
                    {# The iOS home-screen-icon warning itself is part of
                       UploadController::store()'s success flash message for
                       this context (shown once, right after a successful
                       upload, via base.html.twig's generic get_flash()
                       rendering) — not a permanent fixture here, since it
                       only matters in the moment right after a change (see
                       ARCHITECTURE §8.23: iOS can never refresh an
                       already-installed icon, no web API for it). #}
                    {% if unit_logo_is_custom %}
                    <p class="text-body-secondary small mt-2 mb-0">
                        <i class="bi bi-info-circle" aria-hidden="true"></i>
                        Notifier les membres ayant installé l'application sur iOS qu'un nouveau logo est
                        disponible (ils devront supprimer puis réinstaller l'application pour le voir) :
                        <button type="button" class="btn btn-link btn-sm p-0 align-baseline" id="unit-logo-notify-ios-btn">envoyer une notification</button>.
                    </p>
                    {% endif %}
                </div>
            </div>
            {% endif %}
        </div>
    </div>

    {# Section 2: Database #}
    <div class="card mb-4">
        <div class="card-body">
            <h2 class="card-title h5 mb-3">Base de données</h2>

            <div class="mb-3">
                <label for="db_host" class="form-label">Hôte</label>
                <input type="text" class="form-control{% if errors.db_host is defined %} is-invalid{% endif %}" id="db_host" name="db_host" value="{{ values.db_host ?? 'localhost' }}" required>
                {% if errors.db_host is defined %}<div class="invalid-feedback">{{ errors.db_host }}</div>{% endif %}
            </div>

            <div class="mb-3">
                <label for="db_port" class="form-label">Port</label>
                <input type="number" class="form-control{% if errors.db_port is defined %} is-invalid{% endif %}" id="db_port" name="db_port" value="{{ values.db_port ?? '3306' }}" min="1" max="65535" required>
                {% if errors.db_port is defined %}<div class="invalid-feedback">{{ errors.db_port }}</div>{% endif %}
            </div>

            <div class="mb-3">
                <label for="db_name" class="form-label">Nom de la base de données</label>
                <input type="text" class="form-control{% if errors.db_name is defined %} is-invalid{% endif %}" id="db_name" name="db_name" value="{{ values.db_name ?? '' }}" required>
                {% if errors.db_name is defined %}<div class="invalid-feedback">{{ errors.db_name }}</div>{% endif %}
            </div>

            <div class="mb-3">
                <label for="db_user" class="form-label">Utilisateur</label>
                <input type="text" class="form-control{% if errors.db_user is defined %} is-invalid{% endif %}" id="db_user" name="db_user" value="{{ values.db_user ?? '' }}" required>
                {% if errors.db_user is defined %}<div class="invalid-feedback">{{ errors.db_user }}</div>{% endif %}
            </div>

            <div class="mb-3">
                <label for="db_password" class="form-label">Mot de passe</label>
                <input type="password" class="form-control{% if errors.db_password is defined %} is-invalid{% endif %}" id="db_password" name="db_password" {% if not is_initialized %}required{% endif %}>
                {% if is_initialized %}<div class="form-text">Laisser vide pour conserver le mot de passe actuel.</div>{% endif %}
                {% if errors.db_password is defined %}<div class="invalid-feedback">{{ errors.db_password }}</div>{% endif %}
            </div>

            <button type="button" class="btn btn-outline-secondary" id="btn-test-db" data-action="{{ not is_initialized ? '/setup/install-database' : '/setup/test-db' }}">
                <output class="spinner-border spinner-border-sm d-none" id="db-spinner"></output>
                {{ not is_initialized ? 'Installer la base de données' : 'Tester la connexion' }}
            </button>
            <span id="db-test-result" class="ms-2"></span>

            {% if not is_initialized %}
            <div id="db-not-empty-warning" class="alert alert-warning mt-3 d-none">
                <p class="mb-2">Cette base de données contient déjà des tables (<span id="db-not-empty-count"></span>). Poursuivre l'installation dessus provoquera des erreurs (les données existantes ont été chiffrées avec une ancienne clé qui n'existe plus). Sauvegardez son contenu puis videz-la avant de continuer, ou choisissez une autre base de données.</p>
                <button type="button" class="btn btn-warning btn-sm" id="btn-backup-empty-db">
                    <output class="spinner-border spinner-border-sm d-none" id="backup-empty-spinner"></output>
                    Sauvegarder puis vider la base
                </button>
                <button type="button" class="btn btn-outline-danger btn-sm d-none" id="btn-empty-without-backup">
                    Vider sans sauvegarde
                </button>
                <span id="backup-empty-result" class="ms-2"></span>
            </div>
            {% endif %}
        </div>
    </div>

    {# Section 3: Email settings #}
    <div class="card mb-4">
        <div class="card-body">
            <h2 class="card-title h5 mb-3">Envoi d'email</h2>

            <div class="mb-3">
                <label for="mail_mode" class="form-label">Mode d'envoi</label>
                <select class="form-select{% if errors.mail_mode is defined %} is-invalid{% endif %}" id="mail_mode" name="mail_mode" required>
                    <option value="smtp"{% if (values.mail_mode ?? 'smtp') == 'smtp' %} selected{% endif %}>SMTP</option>
                    <option value="local"{% if (values.mail_mode ?? '') == 'local' %} selected{% endif %}>Local</option>
                </select>
                <div class="form-text">Relais SMTP (recommandé) ou envoi depuis le serveur. La fiabilité en mode local dépend de la réputation de l'hébergeur.</div>
                {% if errors.mail_mode is defined %}<div class="invalid-feedback">{{ errors.mail_mode }}</div>{% endif %}
            </div>

            <div id="smtp-fields">
                <div class="mb-3">
                    <label for="smtp_host" class="form-label">Hôte SMTP</label>
                    <input type="text" class="form-control{% if errors.smtp_host is defined %} is-invalid{% endif %}" id="smtp_host" name="smtp_host" value="{{ values.smtp_host ?? '' }}">
                    <div class="form-text">Adresse du serveur SMTP relais.</div>
                    {% if errors.smtp_host is defined %}<div class="invalid-feedback">{{ errors.smtp_host }}</div>{% endif %}
                </div>

                <div class="mb-3">
                    <label for="smtp_port" class="form-label">Port SMTP</label>
                    <input type="number" class="form-control{% if errors.smtp_port is defined %} is-invalid{% endif %}" id="smtp_port" name="smtp_port" value="{{ values.smtp_port ?? '587' }}" min="1" max="65535">
                    <div class="form-text">Port du serveur SMTP (587 pour STARTTLS, 465 pour SSL).</div>
                    {% if errors.smtp_port is defined %}<div class="invalid-feedback">{{ errors.smtp_port }}</div>{% endif %}
                </div>

                <div class="mb-3">
                    <label for="smtp_user" class="form-label">Utilisateur SMTP</label>
                    <input type="text" class="form-control{% if errors.smtp_user is defined %} is-invalid{% endif %}" id="smtp_user" name="smtp_user" value="{{ values.smtp_user ?? '' }}">
                    <div class="form-text">Identifiant de connexion au serveur SMTP.</div>
                    {% if errors.smtp_user is defined %}<div class="invalid-feedback">{{ errors.smtp_user }}</div>{% endif %}
                </div>

                <div class="mb-3">
                    <label for="smtp_password" class="form-label">Mot de passe SMTP</label>
                    <input type="password" class="form-control{% if errors.smtp_password is defined %} is-invalid{% endif %}" id="smtp_password" name="smtp_password">
                    <div class="form-text">Mot de passe de connexion au serveur SMTP.</div>
                    {% if is_initialized %}<div class="form-text">Laisser vide pour conserver le mot de passe actuel.</div>{% endif %}
                    {% if errors.smtp_password is defined %}<div class="invalid-feedback">{{ errors.smtp_password }}</div>{% endif %}
                </div>
            </div>

            <div class="mb-3">
                <label for="mail_from_address" class="form-label">Adresse d'expédition</label>
                <input type="email" class="form-control{% if errors.mail_from_address is defined %} is-invalid{% endif %}" id="mail_from_address" name="mail_from_address" value="{{ values.mail_from_address ?? '' }}" required>
                <div class="form-text">Adresse email affichée comme expéditeur pour tous les emails envoyés par le site.</div>
                {% if errors.mail_from_address is defined %}<div class="invalid-feedback">{{ errors.mail_from_address }}</div>{% endif %}
            </div>

            <div class="mb-3">
                <label for="mail_from_name" class="form-label">Nom d'expédition</label>
                <input type="text" class="form-control{% if errors.mail_from_name is defined %} is-invalid{% endif %}" id="mail_from_name" name="mail_from_name" value="{{ values.mail_from_name ?? '' }}" required>
                <div class="form-text">Nom affiché comme expéditeur, en complément de l'adresse email.</div>
                {% if errors.mail_from_name is defined %}<div class="invalid-feedback">{{ errors.mail_from_name }}</div>{% endif %}
            </div>

            <div class="mb-3">
                <label for="dkim_selector" class="form-label">Sélecteur DKIM</label>
                <input type="text" class="form-control{% if errors.dkim_selector is defined %} is-invalid{% endif %}" id="dkim_selector" name="dkim_selector" value="{{ values.dkim_selector ?? 's2026' }}" pattern="[a-z0-9]+" required>
                <div class="form-text">Identifiant technique de la clé DKIM utilisée pour signer les emails, présent dans l'enregistrement DNS correspondant. La valeur pré-remplie convient dans la grande majorité des cas (convention "s" + année, pour faciliter une rotation future) — vous pouvez la laisser telle quelle.</div>
                {% if errors.dkim_selector is defined %}<div class="invalid-feedback">{{ errors.dkim_selector }}</div>{% endif %}
            </div>

            <div class="mb-3">
                <label for="dmarc_report_email" class="form-label">Email rapports DMARC <span class="text-body-secondary fw-normal">(optionnel)</span></label>
                <input type="email" class="form-control{% if errors.dmarc_report_email is defined %} is-invalid{% endif %}" id="dmarc_report_email" name="dmarc_report_email" value="{{ values.dmarc_report_email ?? '' }}" placeholder="{{ values.mail_from_address ?? '' }}">
                <div class="form-text">Adresse à laquelle les fournisseurs de messagerie envoient un résumé périodique des emails reçus au nom du domaine. Certains services externes traitent automatiquement ces résumés. Laissez vide pour utiliser l'adresse d'expédition ci-dessus — modifiable à tout moment par la suite.</div>
                {% if errors.dmarc_report_email is defined %}<div class="invalid-feedback">{{ errors.dmarc_report_email }}</div>{% endif %}
            </div>

            {# DKIM key — generation can happen ahead of the rest of setup
               via the button below, so the public key is available for
               DNS configuration without waiting for the final save. #}
            <div class="mb-3">
                <h3 class="h6 mb-2">Clé DKIM</h3>
                <div id="dkim-key-section">
                    {% if has_dkim_key %}
                        <p class="mb-2 small">Clé DKIM générée. Sélecteur : <strong>{{ values.dkim_selector ?? '—' }}</strong>.</p>
                        <div class="mb-2">
                            <small class="text-body-secondary">Clé publique (pour l'enregistrement DNS) :</small>
                            <div class="input-group input-group-sm mt-1">
                                <input type="text" class="form-control font-monospace" value="{{ dkim_public_key }}" readonly id="dkim-pubkey-display" aria-label="Clé publique DKIM">
                                <button type="button" class="btn btn-outline-secondary btn-copy-value" data-copy-target="dkim-pubkey-display">Copier</button>
                            </div>
                        </div>
                        {% if is_initialized %}
                        <div class="form-check mt-2">
                            <input class="form-check-input" type="checkbox" id="regenerate_dkim" name="regenerate_dkim" value="1">
                            <label class="form-check-label" for="regenerate_dkim">Régénérer la clé DKIM</label>
                            <div class="form-text text-warning">Attention : si vous régénérez la clé, vous devrez mettre à jour l'enregistrement DNS correspondant.</div>
                        </div>
                        {% endif %}
                    {% else %}
                        <p class="text-body-secondary small">Aucune clé DKIM pour le moment — une clé sera générée automatiquement lors de l'enregistrement final, mais la propagation DNS peut prendre du temps : générez-la dès maintenant si vous voulez configurer l'enregistrement DNS DKIM sans attendre la fin de l'installation.</p>
                        <div class="mb-2">
                            <button type="button" class="btn btn-outline-secondary btn-sm" id="btn-generate-dkim">
                                <output class="spinner-border spinner-border-sm d-none" id="dkim-gen-spinner"></output>
                                Générer la clé maintenant
                            </button>
                            <span id="dkim-gen-result" class="small ms-2"></span>
                        </div>
                    {% endif %}
                </div>
            </div>

            {# SMTP test #}
            <div class="mt-3 mb-3">
                <label for="test_email_recipient" class="form-label">Tester l'envoi d'email</label>
                <div class="input-group">
                    <input type="email" class="form-control" id="test_email_recipient" placeholder="destinataire@exemple.be">
                    <button type="button" class="btn btn-outline-secondary" id="btn-test-email">
                        <output class="spinner-border spinner-border-sm d-none" id="email-spinner"></output>
                        Envoyer un test
                    </button>
                </div>
                <div class="form-text">Teste les paramètres SMTP actuellement saisis ci-dessus (pas encore besoin d'enregistrer).</div>
                <span id="email-test-result" class="small"></span>
            </div>

            {# DNS records panel #}
            <div class="card bg-body-tertiary mt-3">
                <div class="card-body">
                    <h3 class="h6 mb-2">Configuration DNS requise</h3>
                    <p class="text-body-secondary small mb-2">Un domaine ne peut avoir qu'un seul enregistrement TXT SPF et qu'un seul enregistrement <code>_dmarc</code> : si une valeur actuelle est déjà affichée ci-dessous, la valeur suggérée l'intègre automatiquement (elle ne supprime rien de votre configuration existante) — remplacez l'enregistrement existant par cette valeur suggérée plutôt que d'en ajouter un second. Le DKIM utilise en revanche un sous-domaine dédié au sélecteur choisi ci-dessus : il n'entre jamais en conflit avec un enregistrement existant sous un autre nom, et nécessite d'avoir généré la clé DKIM (section « Clé DKIM » ci-dessus) pour connaître sa valeur.</p>
                    <p class="text-body-secondary small mb-2">Pour le SPF en mode SMTP, la valeur suggérée autorise directement l'adresse IP de votre serveur SMTP (<code>a:{hôte}</code>) — cela convient à la plupart des hébergeurs mutualisés. Si votre fournisseur SMTP est un grand service tiers (Google, SendGrid, Mailgun, Office 365…), il publie généralement sa propre valeur <code>include:</code> à ajouter à la place : consultez sa documentation SPF, la valeur suggérée ici ne peut pas la deviner automatiquement.</p>
                    <div id="dns-records">
                        <p class="text-body-secondary small mb-2">Complétez les champs ci-dessus puis cliquez sur « Vérifier les DNS » pour afficher les enregistrements requis.</p>
                    </div>
                    <button type="button" class="btn btn-outline-secondary btn-sm" id="btn-check-dns">
                        <output class="spinner-border spinner-border-sm d-none" id="dns-spinner"></output>
                        Vérifier les DNS
                    </button>
                </div>
            </div>
        </div>
    </div>

    {# ————— Tâche cron —————
       Informational only, no form fields, so it stays outside the numbered
       sections above. Le chip d'état est rempli par setup.js, qui interroge
       GET /setup/cron-status toutes les cinq secondes ; tant qu'il n'est
       pas vert lors d'une première installation, le bouton d'installation
       reste désactivé (SetupController::save() refuse de son côté). #}
    <div class="card mb-4" id="setup-cron-card">
        <div class="card-body">
            <h2 class="card-title h5 mb-3">Tâche cron</h2>

            <p class="small">
                <strong>Une vraie tâche cron est indispensable.</strong> C'est elle qui fait tourner
                tout ce que le site fait sans visiteur : sauvegardes automatiques, mises à jour,
                rappels, notifications, purges. Sans elle, le site ne travaille qu'au rythme des
                visites — et rien ne se passe la nuit, ni pendant les vacances.
            </p>

            <p class="small mb-1">Ajoutez cette ligne dans votre crontab (ou dans la section « Tâches planifiées »/« Cron » du panneau de contrôle de votre hébergeur) :</p>
            <div class="input-group input-group-sm mt-1 mb-2">
                <input type="text" class="form-control font-monospace" value="{{ cron_crontab_line ?? '* * * * * php /chemin/vers/le/site/public/cron.php' }}" readonly id="cron-line-display" aria-label="Ligne crontab">
                <button type="button" class="btn btn-outline-secondary btn-copy-value" data-copy-target="cron-line-display">Copier</button>
            </div>

            <div class="alert alert-warning small" role="alert">
                Le mot <code>php</code> au début n'est pas facultatif. Certains panneaux d'hébergement
                proposent un champ « Adresse du script » ou « Commande » et acceptent un simple chemin
                de fichier : dans ce cas, <strong>rien ne s'exécute</strong>, sans le moindre message
                d'erreur. Indiquez toujours <code>php</code> (ou le chemin complet de l'exécutable, par
                exemple <code>/usr/bin/php8.3</code>, si votre hébergeur en exige un précis) devant le
                chemin du script.
            </div>

            <p class="small mb-1">État détecté :</p>
            <p class="mb-2" id="cron-status-line">
                <span class="badge text-bg-secondary" id="cron-status-chip"
                      data-initial-state="{{ cron_state ?? 'never' }}">Vérification…</span>
            </p>
            <p class="text-body-secondary small mb-0">
                Le script se protège lui-même contre les exécutions simultanées et doit être lancé
                une fois par minute. Après avoir enregistré la ligne chez votre hébergeur, laissez
                cette page ouverte : l'état passe au vert tout seul, en une minute au plus.
            </p>
        </div>
    </div>

    {# Section 4: Admin account #}
    <div class="card mb-4">
        <div class="card-body">
            <h2 class="card-title h5 mb-3">{% if not is_initialized %}Administrateur initial{% else %}Compte administrateur{% endif %}</h2>

            <div class="mb-3">
                <label for="admin_email" class="form-label">Email administrateur</label>
                <input type="email" class="form-control{% if errors.admin_email is defined %} is-invalid{% endif %}" id="admin_email" name="admin_email" value="{{ values.admin_email ?? '' }}" {% if not is_initialized %}required{% endif %}>
                {% if not is_initialized %}
                <div class="form-text">Adresse email de la première personne administratrice. Un compte sera créé avec le rôle administrateur.</div>
                {% else %}
                <div class="form-text">Remplissez pour créer ou mettre à jour le compte administrateur. Laissez vide pour ne rien changer.</div>
                {% endif %}
                {% if errors.admin_email is defined %}<div class="invalid-feedback">{{ errors.admin_email }}</div>{% endif %}
            </div>

            {#
              The same field the account page and the password-reset page use
              (partials/password_field.html.twig), with the same live rules
              and the same confirmation. This page used to have neither, and
              accepted eight characters where the rest of the site requires
              twelve — on the form that creates the SUPER-ADMIN account, of
              all of them.
            #}
            {% include 'partials/password_field.html.twig' with {
                field_id: 'admin_password',
                field_name: 'admin_password',
                label: 'Mot de passe administrateur',
                confirm_name: 'admin_password_confirm',
                required: not is_initialized,
                help: is_initialized
                    ? 'Laissez vide pour conserver le mot de passe actuel.'
                    : 'Ce mot de passe permet de se connecter sans attendre un import Desk.',
            } %}
            {% if errors.admin_password is defined %}
                <div class="text-danger small mb-3">{{ errors.admin_password }}</div>
            {% endif %}
        </div>
    </div>

    {# Usage statistics — Core\Statistics, ARCHITECTURE.md §8.47. Only on a
       first install: afterwards the switch lives on Configuration > Support,
       next to the payload preview and the full explanation. #}
    {% if not is_initialized %}
    <div class="card mb-4">
        <div class="card-body">
            <h2 class="card-title h5 mb-3">Statistiques d'utilisation</h2>

            <div class="form-check form-switch mb-2">
                <input class="form-check-input" type="checkbox" role="switch" id="statistics_enabled"
                       name="statistics_enabled" value="1"
                       {% if values.statistics_enabled is not defined or values.statistics_enabled == '1' %}checked aria-checked="true"{% else %}aria-checked="false"{% endif %}>
                <label class="form-check-label" for="statistics_enabled">
                    Envoyer des statistiques d'utilisation
                </label>
            </div>

            <p class="text-body-secondary small mb-2">
                Un rapport agrégé est envoyé une fois par jour à l'équipe qui développe ScoutMagic. Il sert à vous
                fournir un meilleur support en cas de problème, à repérer les fonctionnalités réellement utilisées
                et à décider des développements à venir. <strong>Ce rapport n'est pas anonyme</strong> : il contient
                l'adresse de ce site. Il ne contient aucune donnée de membre.
            </p>

            <details class="small">
                <summary>Voir ce qui sera envoyé</summary>
                {# The payload itself cannot be built at this point — the
                   database is not configured yet, so there is no settings
                   table, no module registry and no installation identity.
                   The categories of data are shown instead; the exact
                   document is on Configuration > Support afterwards. #}
                <ul class="mt-2 mb-0">
                    <li>l'adresse de ce site et un identifiant d'installation aléatoire ;</li>
                    <li>la version de ScoutMagic installée et la liste des modules avec leur version ;</li>
                    <li>le nombre de membres et de sections actifs, et le libellé de l'année scoute ;</li>
                    <li>des informations techniques sur l'hébergement : version de PHP, moteur et version de
                        base de données, famille de système d'exploitation, architecture, HTTPS, mode d'envoi
                        des emails, mode d'exécution des tâches planifiées, espace disque libre ;</li>
                    <li>les dates d'installation et de dernière mise à jour, et les réglages de mise à jour
                        automatique.</li>
                </ul>
                <p class="text-body-secondary mt-2 mb-0">
                    Le contenu exact est consultable après l'installation, sur la page Configuration &gt; Support.
                </p>
            </details>

            <p class="text-body-secondary small mt-2 mb-0">
                Ce choix est modifiable à tout moment. Le refuser n'empêche rien d'autre : la page Support et la
                génération d'une archive de diagnostic restent disponibles.
            </p>
        </div>
    </div>
    {% endif %}

    {# Save button #}
    <div class="d-grid mb-4">
        <button type="submit" class="btn btn-primary btn-lg" id="btn-save" disabled>
            {% if not is_initialized %}Installer{% else %}Enregistrer{% endif %}
        </button>
        <div class="form-text text-center mt-1" id="save-hint">{% if not is_initialized %}Installez la base de données avant de pouvoir continuer.{% else %}Testez la connexion à la base de données avant de pouvoir enregistrer.{% endif %}</div>
        {# Première installation uniquement : la tâche cron est une condition
           d'installation, pas un conseil. Sur un site déjà configuré, cette
           page est « Installation & serveur » et l'absence de cron ne bloque
           jamais un enregistrement — voir SetupController::save(). #}
        {% if not is_initialized %}
        <div class="form-text text-center mt-1 text-danger d-none" id="cron-save-hint">
            Aucune tâche cron n'a encore été détectée. Configurez-la chez votre hébergeur
            (section « Tâche cron » ci-dessus) : l'installation reste bloquée tant qu'elle
            n'a pas tourné au moins une fois.
        </div>
        {% endif %}
    </div>
</form>

</div>
{% endblock %}

{% block scripts %}
{# The admin password's live rules and its confirmation check — see
   partials/password_field.html.twig. Nothing on this page wires them. #}
<script type="module" src="{{ asset('/assets/js/password-field.js') }}"></script>
<script src="{{ asset('/assets/js/setup.js') }}"></script>
{% if is_initialized and unit_logo_is_custom %}
<script src="{{ asset('/assets/js/unit-logo.js') }}" defer></script>
<script src="{{ asset('/assets/js/unit-logo-notify-ios.js') }}" defer></script>
{% endif %}
{% endblock %}
