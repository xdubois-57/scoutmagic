{% extends "base.html.twig" %}

{% block title %}Installation — Vérification{% endblock %}

{% block content %}
<div class="page-narrow" id="scoutmagic-setup-wizard">
{% include 'partials/page_header.html.twig' with { title: 'Installation' } only %}

{% if state == 'missing' %}
<div class="alert alert-warning">
    <p><strong>Jeton d'installation requis.</strong></p>
    <p>Pour des raisons de sécurité, l'assistant de configuration ne peut être ouvert qu'après la création d'un fichier <code>token.php</code> à la racine du site (via FTP) — ce site ne génère jamais ce jeton lui-même tant que le fichier n'existe pas.</p>
    <p>Créez un fichier nommé <code>token.php</code> à la racine de votre site, avec exactement ce contenu :</p>
    <pre class="bg-light p-2 rounded"><code>{{ example_content }}</code></pre>
    <p class="mb-0">Rechargez ensuite cette page, puis saisissez la même valeur ci-dessous.</p>
</div>
{% elseif state == 'locked' %}
<div class="alert alert-danger">
    <p><strong>Trop de tentatives.</strong></p>
    <p class="mb-0">Réessayez dans {{ (retry_after / 60)|round(0, 'ceil') }} minute(s).</p>
</div>
{% else %}
<div class="card">
    <div class="card-body">
        <p>Saisissez le jeton contenu dans <code>token.php</code> (à la racine du site, créé via FTP) pour accéder à l'assistant de configuration.</p>
        {% if error %}<div class="alert alert-danger py-2">{{ error }}</div>{% endif %}
        <form method="post" action="/setup/verify-token">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token }}">
            <div class="mb-3">
                <label for="token" class="form-label">Jeton</label>
                <input type="text" class="form-control font-monospace" id="token" name="token" autocomplete="off" required autofocus>
            </div>
            <button type="submit" class="btn btn-primary">Continuer</button>
        </form>
    </div>
</div>
{% endif %}
</div>
{% endblock %}
