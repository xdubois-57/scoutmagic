{% extends 'base.html.twig' %}
{% block title %}Journal — {{ param('site_name') }}{% endblock %}
{% block content %}
    {% include 'partials/page_header.html.twig' with { title: 'Journal' } only %}

    {# Filter bar #}
    <form method="get" action="/admin/journal" class="card mb-3">
        <div class="card-body">
            <div class="row g-2 align-items-end">
                <div class="col-12 col-md-2">
                    <label class="form-label small" for="journal-filter-category">Catégorie</label>
                    <select id="journal-filter-category" name="category" class="form-select form-select-sm">
                        <option value="">Toutes</option>
                        {% for cat in categories %}
                            <option value="{{ cat }}" {{ filter_category == cat ? 'selected' : '' }}>{{ cat }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label small" for="journal-filter-level">Niveau</label>
                    <select id="journal-filter-level" name="level" class="form-select form-select-sm">
                        <option value="">Tous</option>
                        <option value="info" {{ filter_level == 'info' ? 'selected' : '' }}>Info</option>
                        <option value="security" {{ filter_level == 'security' ? 'selected' : '' }}>Sécurité</option>
                    </select>
                </div>
                <div class="col-12 col-md-3">
                    <label class="form-label small" for="journal-filter-search">Recherche</label>
                    <input type="text" id="journal-filter-search" name="search" class="form-control form-control-sm"
                           value="{{ filter_search }}" placeholder="Texte...">
                </div>
                <div class="col-12 col-md-3">
                    <label class="form-label small" for="journal-filter-email">Email</label>
                    <input type="email" id="journal-filter-email" name="email" class="form-control form-control-sm"
                           value="{{ filter_email }}" placeholder="nom@exemple.be">
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label small" for="journal-filter-ip">Adresse IP</label>
                    <input type="text" id="journal-filter-ip" name="ip" class="form-control form-control-sm"
                           value="{{ filter_ip }}" placeholder="192.168...">
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label small" for="journal-filter-date-from">Du</label>
                    <input type="date" id="journal-filter-date-from" name="date_from" class="form-control form-control-sm"
                           value="{{ filter_date_from }}">
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label small" for="journal-filter-date-to">Au</label>
                    <input type="date" id="journal-filter-date-to" name="date_to" class="form-control form-control-sm"
                           value="{{ filter_date_to }}">
                </div>
                <div class="col-12 col-md-2">
                    <button type="submit" class="btn btn-primary btn-sm w-100">Filtrer</button>
                </div>
            </div>
        </div>
    </form>

    <p class="text-body-secondary small mb-2">{{ total }} entrée{{ total > 1 ? 's' : '' }}</p>

    {# Desktop table #}
    <div class="d-none d-md-block">
        <div class="table-responsive">
            <table class="table table-sm table-hover">
                <thead>
                    <tr>
                        <th style="width:140px;">Date</th>
                        <th style="width:80px;">Niveau</th>
                        <th style="width:100px;">Catégorie</th>
                        <th style="width:180px;">Utilisateur</th>
                        <th style="width:120px;">IP</th>
                        <th>Description</th>
                    </tr>
                </thead>
                <tbody>
                    {% for entry in entries %}
                    <tr class="journal-row" data-context='{{ entry.context|default("")|e('html_attr') }}'
                        data-reveal="next:.context-row" style="cursor:pointer;">
                        <td class="text-nowrap small">{{ entry.logged_at }}</td>
                        <td>
                            {% if entry.level == 'security' %}
                                <span class="badge text-bg-warning">sécurité</span>
                            {% else %}
                                <span class="badge text-bg-info">info</span>
                            {% endif %}
                        </td>
                        <td class="small">{{ entry.category }}</td>
                        <td class="small text-truncate" style="max-width:180px;">{{ entry.user_email ?? '—' }}</td>
                        <td class="small text-nowrap">{{ entry.ip_address ?? '—' }}</td>
                        <td class="small">{{ entry.description }}</td>
                    </tr>
                    {% if entry.context %}
                    <tr class="d-none context-row">
                        <td colspan="6">
                            <pre class="bg-body-tertiary p-2 rounded small mb-0">{{ entry.context }}</pre>
                        </td>
                    </tr>
                    {% endif %}
                    {% else %}
                    {% include 'partials/empty_state.html.twig' with {
                        message: 'Aucune entrée trouvée.',
                        colspan: 6,
                    } only %}
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    {# Mobile cards #}
    <div class="d-md-none">
        {% for entry in entries %}
        <div class="card mb-2 journal-card" data-context='{{ entry.context|default("")|e('html_attr') }}'
             data-reveal=".context-detail">
            <div class="card-body py-2 px-3">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-body-secondary" style="font-size:0.7rem;">{{ entry.logged_at }}</span>
                    {% if entry.level == 'security' %}
                        <span class="badge text-bg-warning" style="font-size:0.65rem;">sécurité</span>
                    {% else %}
                        <span class="badge text-bg-info" style="font-size:0.65rem;">info</span>
                    {% endif %}
                </div>
                <div class="small">{{ entry.description }}</div>
                <div class="text-body-secondary" style="font-size:0.7rem;">
                    {{ entry.category }}
                    {% if entry.user_email %} · {{ entry.user_email }}{% endif %}
                    {% if entry.ip_address %} · {{ entry.ip_address }}{% endif %}
                </div>
                {% if entry.context %}
                <pre class="bg-body-tertiary p-2 rounded small mb-0 mt-1 d-none context-detail">{{ entry.context }}</pre>
                {% endif %}
            </div>
        </div>
        {% else %}
        {% include 'partials/empty_state.html.twig' with {
            message: 'Aucune entrée trouvée.',
            compact: true,
        } only %}
        {% endfor %}
    </div>

    <div class="mt-3">
        {% include 'partials/pagination.html.twig' with {
            page: page,
            total_pages: total_pages,
            base_url: '?category=' ~ filter_category ~ '&level=' ~ filter_level ~ '&search=' ~ filter_search ~ '&email=' ~ filter_email ~ '&ip=' ~ filter_ip ~ '&date_from=' ~ filter_date_from ~ '&date_to=' ~ filter_date_to ~ '&page=',
            label: 'Pagination du journal',
            centered: true,
        } only %}
    </div>
{% endblock %}

{% block scripts %}
<script src="/assets/js/reveal-details.js" defer></script>
{% endblock %}
