{# One read-only "label — value" row of the Desk half of the member page
   (admin/members/show.html.twig). Extracted from the detail card this
   page replaced, unchanged: an icon, a muted label, and the value right-
   aligned, falling back to an em dash rather than rendering an empty
   row that reads as a missing section. #}
{% macro field(icon, label, value) %}
    <div class="d-flex justify-content-between align-items-start gap-3 py-2 border-bottom">
        <span class="text-body-secondary d-flex align-items-center gap-2 flex-shrink-0">
            <i class="bi {{ icon }}" aria-hidden="true"></i> {{ label }}
        </span>
        <span class="text-end">{{ value|default('—') }}</span>
    </div>
{% endmacro %}
