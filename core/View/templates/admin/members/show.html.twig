{% extends 'base.html.twig' %}
{% block title %}{{ member.lastName|normalize_name }} {{ member.firstName|normalize_name }} — Membres — {{ param('site_name') }}{% endblock %}

{% block content %}
{% import 'admin/members/_field.html.twig' as ui %}

{% set mainFn = member.getMainFunction() %}

{% include 'partials/page_header.html.twig' with {
    title: member.lastName|normalize_name ~ ' ' ~ member.firstName|normalize_name,
    subtitle: (mainFn ? (mainFn.sectionName ?? mainFn.sectionCode) ~ ' — ' ~ mainFn.functionLabel : null),
    badge: year_label,
} only %}

<div class="page-wide">
    {# The page always shows the member's LAST KNOWN year, whichever one a
       search matched — and says which. Without that sentence a chef
       d'unité reads a former member's 2019 details as current and phones
       a number that stopped working years ago. #}
    {% if is_past_year|default(false) %}
        <output class="alert alert-warning d-flex align-items-start gap-2">
            <i class="bi bi-calendar-event flex-shrink-0" aria-hidden="true"></i>
            <div>
                Données de l'année scoute <strong>{{ year_label }}</strong> — la dernière année
                où ce membre est connu. Les coordonnées d'une année antérieure peuvent différer.
            </div>
        </output>
    {% endif %}

    <div class="row g-3">
        <div class="col-12 col-lg-6">
            {# Données Desk — read-only, hence the padlock. The Desk/site
               split is structural, not decorative: nothing on this half
               can be changed here, because Desk is the source of record. #}
            <section class="card mb-3">
                <div class="card-header d-flex align-items-center gap-2">
                    <i class="bi bi-lock" aria-hidden="true"></i>
                    <h2 class="h6 mb-0">Données Desk</h2>
                </div>
                <div class="card-body">
                    <p class="text-body-secondary small mb-3">Informations importées depuis Desk — lecture seule.</p>

                    {{ ui.field('bi-person', 'Nom', member.lastName|normalize_name) }}
                    {{ ui.field('bi-person', 'Prénom', member.firstName|normalize_name) }}
                    {{ ui.field('bi-calendar', 'Date de naissance', member.birthDate ? member.birthDate|date_fr : '') }}
                    {{ ui.field('bi-gender-ambiguous', 'Sexe', member.gender) }}
                    {{ ui.field('bi-feather', 'Totem', member.totem ? member.totem|normalize_totem : '') }}
                    {{ ui.field('bi-people', 'Section', mainFn ? (mainFn.sectionName ?? mainFn.sectionCode) : '') }}
                    {{ ui.field('bi-briefcase', 'Fonction', mainFn ? mainFn.functionLabel : '') }}

                    {{ ui.field('bi-house', 'Adresse', member.addresses|length > 0 ? member.addresses[0].format()|normalize_address : '') }}

                    <div class="d-flex justify-content-between align-items-start gap-3 py-2 border-bottom">
                        <span class="text-body-secondary d-flex align-items-center gap-2 flex-shrink-0"><i class="bi bi-envelope" aria-hidden="true"></i> Email</span>
                        <span class="text-end">
                            {% if member.email %}<a href="mailto:{{ member.email }}" class="link-primary">{{ member.email }}</a>{% else %}—{% endif %}
                        </span>
                    </div>

                    {# Desk provides two numbers: Tél (fixe) and GSM. #}
                    <div class="d-flex justify-content-between align-items-start gap-3 py-2 border-bottom">
                        <span class="text-body-secondary d-flex align-items-center gap-2 flex-shrink-0"><i class="bi bi-telephone" aria-hidden="true"></i> Tél. parent 1</span>
                        <span class="text-end">
                            {% if member.phone %}<a href="tel:{{ member.phone|normalize_phone|replace({' ': ''}) }}">{{ member.phone|normalize_phone }}</a>{% else %}—{% endif %}
                        </span>
                    </div>
                    <div class="d-flex justify-content-between align-items-start gap-3 py-2 border-bottom">
                        <span class="text-body-secondary d-flex align-items-center gap-2 flex-shrink-0"><i class="bi bi-phone" aria-hidden="true"></i> Tél. parent 2</span>
                        <span class="text-end">
                            {% if member.mobile %}<a href="tel:{{ member.mobile|normalize_phone|replace({' ': ''}) }}">{{ member.mobile|normalize_phone }}</a>{% else %}—{% endif %}
                        </span>
                    </div>

                    {# Administrative (clear text). #}
                    {{ ui.field('bi-shield-check', 'Assurance complémentaire', member.supplementaryInsurance) }}

                    {# Health data (encrypted). Desk exports true/false. #}
                    <div class="d-flex justify-content-between align-items-start gap-3 py-2">
                        <span class="text-body-secondary d-flex align-items-center gap-2 flex-shrink-0"><i class="bi bi-heart-pulse" aria-hidden="true"></i> Handicap</span>
                        <span class="text-end">
                            {% if member.handicap == 'true' %}Oui{% elseif member.handicap == 'false' %}Non{% else %}{{ member.handicap|default('—') }}{% endif %}
                        </span>
                    </div>

                    {# Secondary addresses: shown, never editable. They are
                       strict self-service (ARCHITECTURE.md §8.27) — the
                       member alone manages them, with no chief or admin
                       bypass — so there is no control here at all rather
                       than one that would be refused server-side. #}
                    {% if member_emails is not empty %}
                        <div class="mt-3 border-top pt-3">
                            <p class="small fw-medium text-body-secondary mb-2">Adresses secondaires</p>
                            <ul class="list-unstyled mb-2">
                                {% for row in member_emails %}
                                    <li class="d-flex justify-content-between align-items-center gap-2 py-1">
                                        <span class="text-break">{{ row.address }}</span>
                                        {% if row.status == 'valid' %}
                                            {% include 'partials/status_badge.html.twig' with { status: 'active', label: 'active' } only %}
                                        {% elseif row.status == 'pending' %}
                                            {% include 'partials/status_badge.html.twig' with { status: 'pending', label: 'à confirmer' } only %}
                                        {% else %}
                                            {% include 'partials/status_badge.html.twig' with { status: 'inactive', label: 'désactivée' } only %}
                                        {% endif %}
                                    </li>
                                {% endfor %}
                            </ul>
                            <p class="small text-body-secondary d-flex align-items-start gap-2 mb-0">
                                <i class="bi bi-lock" aria-hidden="true"></i>
                                <span>En lecture seule : le membre gère lui-même ses adresses, sans intervention du staff.</span>
                            </p>
                        </div>
                    {% endif %}
                </div>
            </section>

            {# The three site actions are three cards now: the old
               « Données du site » heading stopped meaning anything once
               the page grew — everything below is site data. #}
            <section class="card mb-3">
                <div class="card-header d-flex align-items-center gap-2">
                    <i class="bi bi-calendar" aria-hidden="true"></i>
                    <h2 class="h6 mb-0">Année dans la branche</h2>
                </div>
                <div class="card-body" id="scout-year-offset-card" data-member-year-id="{{ member.memberYearId }}">
                    <p class="text-body-secondary small mb-2">
                        Ajustez si ce membre est en avance ou en retard d'un an sur l'année habituelle de sa section.
                    </p>
                    <fieldset class="btn-group" aria-label="Année dans la branche">
                        <button type="button" class="btn btn-outline-secondary offset-btn{{ member.scoutYearOffset == -1 ? ' active' : '' }}" data-offset="-1">−1 an</button>
                        <button type="button" class="btn btn-outline-secondary offset-btn{{ member.scoutYearOffset == 0 ? ' active' : '' }}" data-offset="0">Normal</button>
                        <button type="button" class="btn btn-outline-secondary offset-btn{{ member.scoutYearOffset == 1 ? ' active' : '' }}" data-offset="1">+1 an</button>
                    </fieldset>
                    <div class="mt-3">
                        <span class="badge rounded-pill text-bg-light border d-inline-flex align-items-center gap-2">
                            <span class="rounded-circle d-inline-block" id="scout-year-offset-dot"
                                  style="width:10px;height:10px;background-color:{{ effective_age.branchColor|default('#adb5bd') }};"></span>
                            <span id="scout-year-offset-label">{{ effective_age.getBranchYearLabel()|default('') != '' ? effective_age.getBranchYearLabel() : '—' }}</span>
                        </span>
                    </div>
                </div>
            </section>

            {# What this person does and has earned THIS year — the same
               subject as the two cards above, so they sit under them
               rather than opening the other column. The columns split by
               subject: this one is the person and their current year, the
               other everything the unit has accumulated about them over
               time. It also stops the right column from carrying nine of
               the page's fourteen cards, which is what it did. #}
            {% if functions is not empty %}
                <section class="card mb-3">
                    <div class="card-header d-flex align-items-center gap-2">
                        <i class="bi bi-briefcase" aria-hidden="true"></i>
                        <h2 class="h6 mb-0">Fonctions de l'année</h2>
                    </div>
                    <div class="card-body">
                        <ul class="list-unstyled mb-0">
                            {% for fn in functions %}
                                <li class="d-flex justify-content-between align-items-center gap-2 py-1">
                                    <span>
                                        {{ fn.label }}
                                        {% if fn.section %}<span class="text-body-secondary">· {{ fn.section }}</span>{% endif %}
                                    </span>
                                    {% if fn.is_main %}<span class="badge text-bg-light border flex-shrink-0">Principale</span>{% endif %}
                                </li>
                            {% endfor %}
                        </ul>
                    </div>
                </section>
            {% endif %}

            {% if badges is not empty %}
                <section class="card mb-3">
                    <div class="card-header d-flex align-items-center gap-2">
                        <i class="bi bi-award" aria-hidden="true"></i>
                        <h2 class="h6 mb-0">Badges</h2>
                    </div>
                    <div class="card-body">
                        <div class="d-flex flex-wrap gap-2">
                            {% for badge in badges %}
                                <span class="badge text-bg-light border">{{ badge.name }}</span>
                            {% endfor %}
                        </div>
                        <p class="small text-body-secondary mb-0 mt-2">Attribués pour l'année {{ year_label }}.</p>
                    </div>
                </section>
            {% endif %}

            {# D'où vient cette personne — un lien, jamais une copie. La
               demande garde sa propre page, construite par le module qui la
               possède ; en recopier trois champs ici créerait un second
               endroit à tenir à jour. Les deux pages sont role_min: admin,
               donc quiconque voit ce lien peut l'ouvrir.

               Absent pour un membre importé de Desk avant l'existence du
               module, ou arrivé autrement : c'est le cas courant. #}
            {% if registration_origin %}
                <section class="card mb-3">
                    <div class="card-header d-flex align-items-center gap-2">
                        <i class="bi bi-signpost-split" aria-hidden="true"></i>
                        <h2 class="h6 mb-0">Demande d'inscription d'origine</h2>
                    </div>
                    <a href="{{ registration_origin.path }}"
                       class="card-body d-flex align-items-center gap-3 text-decoration-none text-body">
                        <span class="flex-grow-1">
                            <span class="fw-medium d-block">{{ registration_origin.label }}</span>
                            <span class="text-body-secondary small">{{ registration_origin.statusLabel }}</span>
                        </span>
                        <i class="bi bi-chevron-right text-body-secondary flex-shrink-0" aria-hidden="true"></i>
                    </a>
                </section>
            {% endif %}

            {# Core\Member\DepartureService — the same fact the registration
               module's « Départs » page marks (ARCHITECTURE.md §8.37),
               reachable here for any member found by search, staff
               included, rather than only the animés of a section a chief
               actually staffs. #}
            <section class="card mb-3">
                <div class="card-header d-flex align-items-center gap-2">
                    <i class="bi bi-box-arrow-right" aria-hidden="true"></i>
                    <h2 class="h6 mb-0">Départ</h2>
                </div>
                <div class="card-body" id="departure-card" data-member-year-id="{{ member.memberYearId }}">
                    <p class="text-body-secondary small mb-2">
                        Indique que ce membre ne reviendra probablement pas l'année scoute prochaine.
                    </p>
                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" id="departure-checkbox" {{ departure_leaving|default(false) ? 'checked' : '' }}>
                        <label class="form-check-label" for="departure-checkbox">Part l'année prochaine</label>
                    </div>
                    <div class="mt-2" id="departure-comment-row" style="{{ departure_leaving|default(false) ? '' : 'display:none;' }}">
                        <label class="form-label small mb-1" for="departure-comment">Commentaire</label>
                        <textarea class="form-control form-control-sm" id="departure-comment" rows="2" maxlength="1000"
                            placeholder="Commentaire facultatif (motif du départ)">{{ departure_comment|default('') }}</textarea>
                    </div>
                </div>
            </section>

            {# ARCHITECTURE.md §8.42. This card does not change the member:
               it changes the session of whoever is reading. The « Votre
               session » label in the header is the whole distinguishing
               treatment — the card stays identical to the others, because
               a visual exception would read as a warning rather than as a
               fact. The full text matters: without the last sentence
               nobody dares click. #}
            <section class="card mb-3">
                <div class="card-header d-flex align-items-center gap-2">
                    <i class="bi bi-person-walking" aria-hidden="true"></i>
                    <h2 class="h6 mb-0">Voir le site à sa place</h2>
                    <span class="ms-auto small text-body-secondary text-uppercase">Votre session</span>
                </div>
                <div class="card-body">
                    <p class="text-body-secondary small mb-2">
                        Ajoute ce membre à votre liste d'animés pour la durée de votre session,
                        afin de voir le site comme il le voit et d'agir en son nom.
                        Aucune modification n'est enregistrée : le retrait ou la déconnexion annule tout.
                    </p>
                    {% if is_temporary_member|default(false) %}
                        <form method="post" action="/admin/members/temporary-access/remove">
                            {{ csrf_field()|raw }}
                            <button type="submit" class="btn btn-outline-danger">
                                <i class="bi bi-person-dash" aria-hidden="true"></i> Retirer de ma liste
                            </button>
                        </form>
                    {% else %}
                        <form method="post" action="/admin/members/{{ member.memberYearId }}/temporary-access">
                            {{ csrf_field()|raw }}
                            <button type="submit" class="btn btn-outline-primary">
                                <i class="bi bi-person-plus" aria-hidden="true"></i> Voir le site à sa place
                            </button>
                        </form>
                    {% endif %}
                </div>
            </section>
        </div>

        <div class="col-12 col-lg-6">
            {% if photo_file_id %}
                <section class="card mb-3">
                    <div class="card-header d-flex align-items-center gap-2">
                        <i class="bi bi-person-badge" aria-hidden="true"></i>
                        <h2 class="h6 mb-0">Photo</h2>
                    </div>
                    <div class="card-body text-center">
                        <img src="{{ file_url(photo_file_id, 'md') }}" alt="" class="rounded img-fluid" style="max-height:260px;" decoding="async">
                    </div>
                </section>
            {% endif %}

            {# Argent — alimenté par Core\Module\MemberPaymentProvider, que
               le module finance implémente. Le bloc n'existe pas du tout si
               le module est désactivé ou si la personne n'a jamais rien dû :
               c'est le cas courant, pas une anomalie, et « aucune donnée »
               n'apprendrait rien à personne.

               Pas de QR ni d'IBAN ici, contrairement à la page du membre :
               un chef d'unité regarde où en est un paiement, il ne le fait
               pas à la place de la famille. Ce qui appelle une action est
               en haut ; l'historique est replié. #}
            {% if open_payments is not empty or settled_payments is not empty %}
                <section class="card mb-3">
                    <div class="card-header d-flex align-items-center gap-2">
                        <i class="bi bi-cash-coin" aria-hidden="true"></i>
                        <h2 class="h6 mb-0">Paiements</h2>
                    </div>
                    {% if open_payments is not empty %}
                        <ul class="list-group list-group-flush">
                            {% for payment in open_payments %}
                                <li class="list-group-item d-flex justify-content-between align-items-start gap-3">
                                    <span>
                                        <span class="fw-medium">{{ payment.label }}</span>
                                        <span class="d-block text-body-secondary small font-monospace">{{ payment.communication }}</span>
                                        {% if payment.isPartiallyPaid %}
                                            <span class="d-block text-body-secondary small">
                                                {{ payment.amountReceivedCents|money_cents }} reçus sur {{ payment.amountDueCents|money_cents }}.
                                            </span>
                                        {% endif %}
                                    </span>
                                    <span class="text-end flex-shrink-0">
                                        <span class="fw-semibold">{{ payment.amountRemainingCents|money_cents }}</span>
                                        <span class="d-block">
                                            {% include 'partials/status_badge.html.twig' with { status: 'pending', label: 'à payer' } only %}
                                        </span>
                                    </span>
                                </li>
                            {% endfor %}
                        </ul>
                    {% endif %}

                    {% if settled_payments is not empty %}
                        <div class="card-body {% if open_payments is not empty %}border-top{% endif %} py-2">
                            <button class="btn btn-sm btn-outline-secondary w-100" type="button"
                                    data-bs-toggle="collapse" data-bs-target="#member-settled-payments"
                                    aria-expanded="false" aria-controls="member-settled-payments">
                                Voir les paiements clôturés ({{ settled_payments|length }})
                            </button>
                        </div>
                        <div class="collapse" id="member-settled-payments">
                            <ul class="list-group list-group-flush border-top">
                                {% for payment in settled_payments %}
                                    <li class="list-group-item d-flex justify-content-between align-items-start gap-3">
                                        <span>
                                            <span class="fw-medium">{{ payment.label }}</span>
                                            {% if payment.settledOn %}
                                                <span class="d-block text-body-secondary small">{{ payment.settledOn|date('d/m/Y') }}</span>
                                            {% endif %}
                                        </span>
                                        <span class="text-end flex-shrink-0">
                                            <span class="text-body-secondary">{{ payment.amountReceivedCents|money_cents }}</span>
                                            <span class="d-block">
                                                {% if payment.status == 'paid' %}
                                                    {% include 'partials/status_badge.html.twig' with { status: 'confirmed', label: 'payé' } only %}
                                                {% elseif payment.status == 'overpayment_refunded' %}
                                                    {% include 'partials/status_badge.html.twig' with { status: 'cancelled', label: 'trop-perçu remboursé' } only %}
                                                {% else %}
                                                    {% include 'partials/status_badge.html.twig' with { status: 'inactive', label: 'abandonné' } only %}
                                                {% endif %}
                                            </span>
                                        </span>
                                    </li>
                                {% endfor %}
                            </ul>
                            {% if settled_payments_capped %}
                                {# Dit plutôt que sous-entendu : une liste tronquée
                                   en silence se lit comme une liste complète. #}
                                <div class="card-body pt-2">
                                    <p class="small text-body-secondary mb-0">
                                        Les {{ settled_payments|length }} plus récents. L'historique complet est dans
                                        le module Finance.
                                    </p>
                                </div>
                            {% endif %}
                        </div>
                    {% endif %}
                </section>
            {% endif %}

            {% if section_history is not empty %}
                <section class="card mb-3">
                    <div class="card-header d-flex align-items-center gap-2">
                        <i class="bi bi-clock-history" aria-hidden="true"></i>
                        <h2 class="h6 mb-0">Parcours dans l'unité</h2>
                    </div>
                    <div class="card-body">
                        <ol class="list-unstyled mb-0">
                            {% for entry in section_history %}
                                <li class="d-flex gap-3 py-1">
                                    <span class="text-body-secondary small flex-shrink-0" style="min-width:6rem;">{{ entry.scout_year_label }}</span>
                                    <span class="fw-medium">{{ entry.section_name }}</span>
                                    {% if entry.is_current %}<span class="badge text-bg-light border ms-auto flex-shrink-0">En cours</span>{% endif %}
                                </li>
                            {% endfor %}
                        </ol>
                    </div>
                </section>
            {% endif %}

            {# Parcours de formation — alimenté par
               Core\Module\FormationPathProvider, que le module leadership
               implémente. Sur la page du membre lui-même ce bloc est
               réservé à lui seul ; ici il est visible du Staff d'Unité, et
               c'est délibéré : « /admin/leadership/training » porte
               exactement le même plancher `admin`, donc rien n'apparaît ici
               qu'un lecteur ne puisse déjà ouvrir à un menu de distance. #}
            {% if formation_path %}
                <section class="card mb-3">
                    <div class="card-header d-flex align-items-center gap-2">
                        <i class="bi bi-mortarboard" aria-hidden="true"></i>
                        <h2 class="h6 mb-0">Parcours de formation</h2>
                    </div>
                    <div class="card-body">
                        {% if formation_path.isRecognised %}
                            <ol class="list-unstyled d-flex flex-wrap gap-2 mb-3">
                                {% for step in formation_path.steps %}
                                    <li class="badge rounded-pill {{ step.reached ? 'text-bg-primary' : 'text-bg-light border' }}">
                                        {{ step.label }}{% if step.current %} <span class="visually-hidden">(étape actuelle)</span>{% endif %}
                                    </li>
                                {% endfor %}
                            </ol>
                        {% endif %}
                        <p class="small mb-0">
                            {{ formation_path.currentLabel }}.
                            {% if formation_path.nextLabel %}
                                Prochaine étape connue : {{ formation_path.nextLabel }}.
                            {% endif %}
                        </p>
                        {% if not formation_path.isRecognised %}
                            <p class="small text-body-secondary mb-0 mt-2">
                                Le site ne sait pas à quelle étape rattacher ce qui est encodé dans Desk ;
                                rien n'est déduit tant qu'on ne le lui indique pas.
                            </p>
                        {% endif %}
                    </div>
                </section>
            {% endif %}

            {# Camps — rien n'enregistre les participants d'un camp un par
               un : ce sont des SECTIONS qui partent. Une ligne apparaît
               donc quand la section de la personne est partie une année où
               elle en faisait partie. C'est ce que le site sait ; un bloc
               qui prétendrait à une liste de participants l'inventerait. #}
            {% if camp_stays is not empty %}
                <section class="card mb-3">
                    <div class="card-header d-flex align-items-center gap-2">
                        <i class="bi bi-tree" aria-hidden="true"></i>
                        <h2 class="h6 mb-0">Camps</h2>
                    </div>
                    <ul class="list-group list-group-flush">
                        {% for stay in camp_stays %}
                            <li class="list-group-item p-0">
                                <a href="{{ stay.path }}" class="d-flex align-items-center gap-3 p-3 text-decoration-none text-body">
                                    <span class="flex-grow-1 min-w-0">
                                        <span class="fw-medium d-block">{{ stay.placeLabel }}</span>
                                        <span class="text-body-secondary small">
                                            {{ stay.periodLabel ?: stay.scoutYearLabel }} · {{ stay.sectionName }}
                                        </span>
                                    </span>
                                    <i class="bi bi-chevron-right text-body-secondary flex-shrink-0" aria-hidden="true"></i>
                                </a>
                            </li>
                        {% endfor %}
                    </ul>
                    {% if camp_stays_capped %}
                        <div class="card-body pt-2">
                            <p class="small text-body-secondary mb-0">
                                Les {{ camp_stays|length }} plus récents.
                            </p>
                        </div>
                    {% endif %}
                </section>
            {% endif %}

            {# Groupes de discussion — l'appartenance, et rien d'autre :
               aucun message, aucune réponse, aucun décompte. Un chef
               d'unité a besoin de savoir par quels groupes la personne est
               joignable ; ce que les gens s'écrivent n'est pas un fait à
               résumer sur une page de staff.

               Seules les appartenances explicites : un membre « dérivé »
               l'est à cause de sa section, ce que la carte « Parcours dans
               l'unité » dit déjà. #}
            {% if discussion_groups is not empty %}
                <section class="card mb-3">
                    <div class="card-header d-flex align-items-center gap-2">
                        <i class="bi bi-chat-dots" aria-hidden="true"></i>
                        <h2 class="h6 mb-0">Groupes de discussion</h2>
                    </div>
                    <ul class="list-group list-group-flush">
                        {% for group in discussion_groups %}
                            <li class="list-group-item p-0">
                                <a href="{{ group.path }}" class="d-flex align-items-center gap-2 p-3 text-decoration-none text-body">
                                    <span class="flex-grow-1 min-w-0">{{ group.name }}</span>
                                    {% if group.isModerator %}
                                        <span class="badge text-bg-light border flex-shrink-0">Animateur</span>
                                    {% endif %}
                                    {% if group.isClosed %}
                                        {% include 'partials/status_badge.html.twig' with { status: 'closed', label: 'clôturé' } only %}
                                    {% endif %}
                                    <i class="bi bi-chevron-right text-body-secondary flex-shrink-0" aria-hidden="true"></i>
                                </a>
                            </li>
                        {% endfor %}
                    </ul>
                </section>
            {% endif %}

            {# Documents privés — visibles ici depuis que le contournement
               « Staff d'Unité » existe sur files.owner_member_id
               (ARCHITECTURE.md §8.3, SECURITY.md §6). La carte existe pour
               répondre à une famille qui n'a rien reçu ; toutes années
               confondues, parce que la question porte presque toujours sur
               une saison passée.

               Chaque ouverture est consignée au journal au niveau
               « sécurité » : c'est ce qui remplace la barrière retirée, et
               la phrase ci-dessous le dit au lecteur plutôt que de le
               laisser le découvrir. #}
            <section class="card mb-3">
                <div class="card-header d-flex align-items-center gap-2">
                    <i class="bi bi-file-earmark-lock" aria-hidden="true"></i>
                    <h2 class="h6 mb-0">Documents privés</h2>
                </div>
                {% if member_documents is not empty %}
                    <ul class="list-group list-group-flush">
                        {% for row in member_documents %}
                            <li class="list-group-item">
                                <div class="d-flex flex-wrap align-items-center gap-2">
                                    <a href="{{ file_url(row.document.fileId) }}"
                                       class="flex-grow-1 min-w-0 text-decoration-none">
                                        <span class="d-block text-truncate">{{ row.document.title }}</span>
                                        <span class="small text-body-secondary">
                                            {{ row.year_label }}{% if row.year_label %} — {% endif %}{{ row.document.createdAt|date_fr }}
                                        </span>
                                    </a>
                                    {% if member.email %}
                                        <form method="post"
                                              action="/admin/members/{{ member.memberYearId }}/documents/{{ row.document.id }}/renvoyer"
                                              data-confirm="Renvoyer « {{ row.document.title }} » à {{ member.email }} ?">
                                            {{ csrf_field()|raw }}
                                            <button type="submit" class="btn btn-sm btn-outline-secondary">
                                                <i class="bi bi-envelope" aria-hidden="true"></i> Renvoyer par e-mail
                                            </button>
                                        </form>
                                    {% endif %}
                                </div>
                            </li>
                        {% endfor %}
                    </ul>
                {% else %}
                    <div class="card-body">
                        {% include 'partials/empty_state.html.twig' with {
                            message: 'Aucun document privé pour ce membre.',
                            compact: true,
                        } only %}
                    </div>
                {% endif %}
                <div class="card-footer small text-body-secondary d-flex align-items-start gap-2">
                    <i class="bi bi-shield-lock mt-1" aria-hidden="true"></i>
                    <span>
                        Ces documents appartiennent au membre. Vous y avez accès pour répondre à sa
                        famille : chaque ouverture est consignée au journal du site.
                        Un animateur de section n'y a pas accès.
                    </span>
                </div>
            </section>
        </div>
    </div>

    {# Notes internes — dated entries, never one field: a member stays ten
       years and passes through several staffs, and a single field would
       let one chief silently overwrite what another wrote three years
       earlier. Reserved to the Staff d'Unité by the route's own role_min;
       never visible to the member or their parents, and never in an
       export. #}
    <section class="card mt-3 border-2">
        <div class="card-header d-flex align-items-center gap-2 bg-body-tertiary">
            <i class="bi bi-lock" aria-hidden="true"></i>
            <h2 class="h6 mb-0">Notes internes</h2>
            <span class="ms-auto small text-body-secondary text-uppercase">Staff d'unité uniquement</span>
        </div>
        <div class="card-body border-bottom">
            <form method="post" action="/admin/members/{{ member.memberYearId }}/notes">
                {{ csrf_field()|raw }}
                {% include 'partials/form_field.html.twig' with {
                    field_id: 'member-note-body',
                    field_name: 'body',
                    label: 'Ajouter une note',
                    type: 'textarea',
                    rows: 2,
                    maxlength: note_max_length,
                    required: true,
                    help: "Jamais visible par le membre ni par ses parents, et jamais incluse dans un export.",
                } only %}
                <button type="submit" class="btn btn-primary btn-sm">Ajouter</button>
            </form>
        </div>

        {% if notes is empty %}
            <div class="card-body">
                {% include 'partials/empty_state.html.twig' with {
                    message: 'Aucune note interne.',
                    compact: true,
                } only %}
            </div>
        {% else %}
            <ul class="list-group list-group-flush">
                {% for note in notes %}
                    <li class="list-group-item">
                        <p class="mb-2" style="white-space:pre-wrap;">{{ note.body }}</p>
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <span class="small text-body-secondary">
                                {{ note.authorName ?? 'Auteur inconnu' }} — {{ note.createdAt|date('d/m/Y') }}
                                {%- if note.wasEdited() %} · modifiée le {{ note.updatedAt|date('d/m/Y') }}{% endif %}
                            </span>
                            <div class="ms-auto d-flex gap-2">
                                <button type="button" class="btn btn-sm btn-outline-secondary member-note-edit-btn"
                                        data-note-id="{{ note.id }}" aria-label="Modifier la note">
                                    <i class="bi bi-pencil" aria-hidden="true"></i>
                                </button>
                                {# design.md §7.5: data-confirm on the FORM,
                                   never on the button — the global handler
                                   listens on submit. #}
                                <form method="post" action="/admin/members/{{ member.memberYearId }}/notes/{{ note.id }}/delete"
                                      data-confirm="Supprimer cette note ? Elle disparaîtra définitivement.">
                                    {{ csrf_field()|raw }}
                                    <button type="submit" class="btn btn-sm btn-outline-danger" aria-label="Supprimer la note">
                                        <i class="bi bi-trash" aria-hidden="true"></i>
                                    </button>
                                </form>
                            </div>
                        </div>
                        <form method="post" action="/admin/members/{{ member.memberYearId }}/notes/{{ note.id }}"
                              class="mt-2 d-none" id="member-note-edit-{{ note.id }}">
                            {{ csrf_field()|raw }}
                            {% include 'partials/form_field.html.twig' with {
                                field_id: 'member-note-body-' ~ note.id,
                                field_name: 'body',
                                label: 'Modifier la note',
                                label_visually_hidden: true,
                                type: 'textarea',
                                rows: 2,
                                maxlength: note_max_length,
                                value: note.body,
                                required: true,
                                size: 'sm',
                            } only %}
                            <button type="submit" class="btn btn-sm btn-primary">Enregistrer</button>
                        </form>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </section>
</div>
{% endblock %}

{% block scripts %}
{# The scout-year offset buttons and the departure controls —
   public/assets/js/member-search.js, which guards each of its sections on
   its own anchor in the DOM and so is a no-op for the export-selection
   half that only exists on the search page. #}
<script src="{{ asset('/assets/js/member-search.js') }}" defer></script>
{% endblock %}
