{# One PERSON in the result list — `group` is a
   Core\Member\Service\GroupedMemberSearchResult, not one annual row. A
   member present for five years is one line carrying the years they were
   found in, never five near-identical ones.

   `group.latest` is the most recent annual row and is what the line
   shows: someone looking up a former member wants their last known
   section, function and status. #}
{% set member = group.latest %}
<div class="d-flex align-items-center gap-2">
    {# The export-selection checkbox sits OUTSIDE the card link so ticking
       it never navigates; its name feeds the export form's selected[].
       A former member has no row in the effective year, so there is
       nothing for the canonical member export to write — the box is not
       rendered at all rather than shown and silently dropped later. #}
    {% if not group.isFormerMember %}
        <label class="d-flex align-items-center justify-content-center flex-shrink-0 m-0 px-2 tap-target" style="cursor:pointer;">
            <input class="form-check-input member-export-checkbox m-0" type="checkbox" name="selected[]"
                   value="{{ member.memberYearId }}" style="width:1.25rem;height:1.25rem;"
                   aria-label="Sélectionner {{ member.lastName|normalize_name }} {{ member.firstName|normalize_name }} pour l'export">
        </label>
    {% else %}
        <span class="flex-shrink-0 px-2" style="width:2.25rem;" aria-hidden="true"></span>
    {% endif %}
    <a href="/admin/members/{{ member.memberYearId }}"
       class="text-decoration-none text-body flex-grow-1">
        <div class="border rounded-3 p-3 d-flex align-items-center gap-3">
            <div class="rounded-circle bg-primary-subtle d-flex align-items-center justify-content-center flex-shrink-0"
                 style="width:40px;height:40px;">
                <span class="small fw-semibold text-primary">{{ member.initials }}</span>
            </div>
            <div class="flex-grow-1 min-w-0">
                <div class="fw-semibold">
                    {{ member.lastName|normalize_name }}, {{ member.firstName|normalize_name }}{% if member.totem %} · {{ member.totem|normalize_totem }}{% endif %}
                </div>
                <div class="text-body-secondary small">
                    {{ member.sectionName ?? '—' }} · {{ member.functionLabel ?? '—' }}
                    {%- if group.isFormerMember and group.yearsSummary() %} — {{ group.yearsSummary() }}{% endif %}
                </div>
            </div>
            <span class="flex-shrink-0">
                {% if group.isFormerMember %}
                    {% include 'partials/status_badge.html.twig' with { status: 'inactive', label: 'ancien' } only %}
                {% elseif member.isActive %}
                    {% include 'partials/status_badge.html.twig' with { status: 'active', label: 'inscrit' } only %}
                {% else %}
                    {% include 'partials/status_badge.html.twig' with { status: 'inactive', label: 'non inscrit' } only %}
                {% endif %}
            </span>
            <i class="bi bi-chevron-right text-body-secondary flex-shrink-0" aria-hidden="true"></i>
        </div>
    </a>
</div>
