<div class="d-flex align-items-center gap-2">
    {# The export-selection checkbox sits OUTSIDE the card link so ticking
       it never navigates; its name feeds the export form's selected[]. #}
    <label class="d-flex align-items-center justify-content-center flex-shrink-0 m-0 px-2 tap-target" style="cursor:pointer;">
        <input class="form-check-input member-export-checkbox m-0" type="checkbox" name="selected[]"
               value="{{ member.memberYearId }}" style="width:1.25rem;height:1.25rem;"
               aria-label="Sélectionner {{ member.lastName|normalize_name }} {{ member.firstName|normalize_name }} pour l'export">
    </label>
    <a href="/admin/members?q={{ query|url_encode }}&member={{ member.memberYearId }}#member-detail"
       class="text-decoration-none text-body flex-grow-1">
        <div class="border rounded-3 p-3 d-flex align-items-center gap-3 {{ selected ? 'border-primary bg-primary-subtle' : '' }}">
            <div class="rounded-circle bg-primary-subtle d-flex align-items-center justify-content-center flex-shrink-0"
                 style="width:40px;height:40px;">
                <span class="small fw-semibold text-primary">{{ member.initials }}</span>
            </div>
            <div class="flex-grow-1">
                <div class="fw-semibold">
                    {{ member.lastName|normalize_name }}, {{ member.firstName|normalize_name }}{% if member.totem %} · {{ member.totem|normalize_totem }}{% endif %}
                </div>
                <div class="text-body-secondary small">
                    {{ member.sectionName ?? '—' }} · {{ member.functionLabel ?? '—' }}
                </div>
            </div>
            <span class="flex-shrink-0">
                {% if member.isActive %}
                    {% include 'partials/status_badge.html.twig' with { status: 'active', label: 'inscrit' } only %}
                {% else %}
                    {% include 'partials/status_badge.html.twig' with { status: 'inactive', label: 'non inscrit' } only %}
                {% endif %}
            </span>
        </div>
    </a>
</div>
