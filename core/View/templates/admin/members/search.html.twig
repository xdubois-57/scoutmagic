{% extends 'base.html.twig' %}
{% block title %}Membres — {{ param('site_name') }}{% endblock %}
{% block content %}
    {% include 'partials/page_header.html.twig' with {
        title: 'Membres',
        subtitle: "Recherche parmi les membres de l'année " ~ year_label ~ '.',
    } only %}

    <form method="get" action="/admin/members" class="mb-4">
        <div class="input-group">
            <input type="search" name="q" class="form-control" value="{{ query }}"
                   placeholder="Nom, prénom, email, téléphone…" aria-label="Recherche" autofocus>
            <button type="submit" class="btn btn-primary">Rechercher</button>
        </div>
    </form>

    {% if query is empty %}
        <p class="text-body-secondary fst-italic">
            Entrez un nom, prénom, email ou téléphone pour rechercher un membre.
        </p>
    {% elseif results is empty %}
        {% include 'partials/empty_state.html.twig' with {
            message: 'Aucun membre trouvé pour « ' ~ query ~ ' ».',
            compact: true,
        } only %}
    {% else %}
        {# The whole result list lives inside the export form: the rows'
           selected[] checkboxes feed « Exporter la sélection » without any
           JavaScript, while « Exporter les résultats » re-runs the same
           search server-side from ?q= alone. Both produce the canonical
           member export (Core\Member\Export), reusable as-is as a
           mail-merge audience. #}
        <form method="get" action="/admin/members/export" id="member-export-form">
            <input type="hidden" name="q" value="{{ query }}">
            <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                <label class="d-flex align-items-center gap-2 m-0 small text-body-secondary tap-target" style="cursor:pointer;">
                    <input class="form-check-input m-0" type="checkbox" id="member-export-select-all" style="width:1.25rem;height:1.25rem;">
                    Tout sélectionner
                </label>
                <span class="small text-body-secondary ms-1">{{ results|length }} résultat{{ results|length > 1 ? 's' : '' }}</span>
                <div class="d-flex flex-wrap gap-2 ms-auto">
                    <a href="/admin/members/export?q={{ query|url_encode }}" class="btn btn-sm btn-outline-primary">
                        <i class="bi bi-file-earmark-spreadsheet" aria-hidden="true"></i> Exporter les résultats
                    </a>
                    {# Not disabled in the markup: without JS the form still
                       submits (an empty selection falls back server-side to
                       "all results of ?q="); the script only adds the
                       disabled state and the live count. #}
                    <button type="submit" class="btn btn-sm btn-outline-primary" id="member-export-selection-btn">
                        <i class="bi bi-file-earmark-spreadsheet" aria-hidden="true"></i> Exporter la sélection<span id="member-export-selection-count"></span>
                    </button>
                </div>
            </div>
            <div class="d-flex flex-column gap-2">
                {% for member in results %}
                    {% include 'admin/members/_result_row.html.twig' with {
                        member: member,
                        query: query,
                        selected: member.memberYearId == selected_member_id
                    } %}
                {% endfor %}
            </div>
        </form>
    {% endif %}

    {% if detail %}
        {% include 'admin/members/_detail_card.html.twig' with { member: detail, effective_age: effective_age, is_temporary_member: is_temporary_member } %}
    {% endif %}
{% endblock %}

{% block scripts %}
{# Export-selection conveniences on the result list, and the detail card's
   scroll-into-view, scout-year offset buttons and departure controls —
   public/assets/js/member-search.js, which guards each of those four
   sections on its own anchor in the DOM. #}
{% if results is not empty or detail %}
<script src="/assets/js/member-search.js" defer></script>
{% endif %}
{% endblock %}
