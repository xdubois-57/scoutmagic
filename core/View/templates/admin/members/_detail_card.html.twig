{% import _self as ui %}

{% macro field(icon, label, value) %}
    <div class="d-flex justify-content-between align-items-start gap-3 py-2 border-bottom">
        <span class="text-body-secondary d-flex align-items-center gap-2 flex-shrink-0">
            <i class="bi {{ icon }}"></i> {{ label }}
        </span>
        <span class="text-end">{{ value|default('—') }}</span>
    </div>
{% endmacro %}

<div class="card mt-4" id="member-detail" style="scroll-margin-top: 1rem;">
    <div class="card-body">
        {# Données Desk — read-only #}
        <h2 class="h5 d-flex align-items-center gap-2 mb-1"><i class="bi bi-lock"></i> Données Desk</h2>
        <p class="text-body-secondary small mb-3">Informations importées depuis Desk — lecture seule.</p>

        {% set mainFn = member.getMainFunction() %}
        {{ ui.field('bi-person', 'Nom', member.lastName|normalize_name) }}
        {{ ui.field('bi-person', 'Prénom', member.firstName|normalize_name) }}
        {{ ui.field('bi-calendar', 'Date de naissance', member.birthDate ? member.birthDate|date_fr : '') }}
        {{ ui.field('bi-gender-ambiguous', 'Sexe', member.gender) }}
        {{ ui.field('bi-feather', 'Totem', member.totem ? member.totem|normalize_totem : '') }}
        {{ ui.field('bi-people', 'Section', mainFn ? (mainFn.sectionName ?? mainFn.sectionCode) : '') }}
        {{ ui.field('bi-briefcase', 'Fonction', mainFn ? mainFn.functionLabel : '') }}

        {# Email — accent color, mailto link #}
        <div class="d-flex justify-content-between align-items-start gap-3 py-2 border-bottom">
            <span class="text-body-secondary d-flex align-items-center gap-2 flex-shrink-0"><i class="bi bi-envelope"></i> Email</span>
            <span class="text-end">
                {% if member.email %}<a href="mailto:{{ member.email }}" class="link-primary">{{ member.email }}</a>{% else %}—{% endif %}
            </span>
        </div>

        {# Phones — tel: links. Desk provides two numbers: Tél (fixe) and GSM. #}
        <div class="d-flex justify-content-between align-items-start gap-3 py-2 border-bottom">
            <span class="text-body-secondary d-flex align-items-center gap-2 flex-shrink-0"><i class="bi bi-telephone"></i> Tél. parent 1</span>
            <span class="text-end">
                {% if member.phone %}<a href="tel:{{ member.phone|normalize_phone|replace({' ': ''}) }}">{{ member.phone|normalize_phone }}</a>{% else %}—{% endif %}
            </span>
        </div>
        <div class="d-flex justify-content-between align-items-start gap-3 py-2 border-bottom">
            <span class="text-body-secondary d-flex align-items-center gap-2 flex-shrink-0"><i class="bi bi-phone"></i> Tél. parent 2</span>
            <span class="text-end">
                {% if member.mobile %}<a href="tel:{{ member.mobile|normalize_phone|replace({' ': ''}) }}">{{ member.mobile|normalize_phone }}</a>{% else %}—{% endif %}
            </span>
        </div>

        {# Address #}
        {{ ui.field('bi-house', 'Adresse', member.addresses|length > 0 ? member.addresses[0].format()|normalize_address : '') }}

        {# Assurance complémentaire — administrative (clear text). #}
        {{ ui.field('bi-shield-check', 'Assurance complémentaire', member.supplementaryInsurance) }}

        {# Handicap — health data (encrypted). Desk exports true/false. #}
        <div class="d-flex justify-content-between align-items-start gap-3 py-2 border-bottom">
            <span class="text-body-secondary d-flex align-items-center gap-2 flex-shrink-0"><i class="bi bi-heart-pulse"></i> Handicap</span>
            <span class="text-end">
                {% if member.handicap == 'true' %}Oui{% elseif member.handicap == 'false' %}Non{% else %}{{ member.handicap|default('—') }}{% endif %}
            </span>
        </div>

        <hr class="my-4">

        {# Données du site #}
        <h2 class="h5 d-flex align-items-center gap-2 mb-3"><i class="bi bi-globe"></i> Données du site</h2>

        <div id="scout-year-offset-card" data-member-year-id="{{ member.memberYearId }}">
            <div class="form-label fw-semibold mb-1">Décalage année scoute</div>
            <p class="text-body-secondary small mb-2">
                Ajuster si ce membre est en avance ou en retard d'un an.
            </p>

            <div class="btn-group" role="group" aria-label="Décalage année scoute">
                <button type="button"
                        class="btn btn-outline-secondary offset-btn{{ member.scoutYearOffset == -1 ? ' active' : '' }}"
                        data-offset="-1">−1 an</button>
                <button type="button"
                        class="btn btn-outline-secondary offset-btn{{ member.scoutYearOffset == 0 ? ' active' : '' }}"
                        data-offset="0">Normal</button>
                <button type="button"
                        class="btn btn-outline-secondary offset-btn{{ member.scoutYearOffset == 1 ? ' active' : '' }}"
                        data-offset="1">+1 an</button>
            </div>

            <div class="mt-3">
                <span class="badge rounded-pill text-bg-light border d-inline-flex align-items-center gap-2">
                    <span class="rounded-circle d-inline-block" id="scout-year-offset-dot"
                          style="width:10px;height:10px;background-color:{{ effective_age.branchColor|default('#adb5bd') }};"></span>
                    <span id="scout-year-offset-label">{{ effective_age.getBranchYearLabel()|default('') != '' ? effective_age.getBranchYearLabel() : '—' }}</span>
                </span>
            </div>
        </div>

        {# Ajout temporaire (ARCHITECTURE.md §8.42) — ajoute ce membre à la
           liste d'animés de la session en cours, pour voir le site comme il
           le voit et agir en son nom. Rien n'est écrit en base : le retrait,
           la déconnexion et la désactivation du mode configuration suffisent
           à tout annuler. #}
        <div class="mt-4">
            <div class="form-label fw-semibold mb-1">Ajout temporaire à ma liste</div>
            <p class="text-body-secondary small mb-2">
                Ajoute ce membre à votre liste d'animés pour la durée de votre session,
                afin de voir le site comme il le voit et d'agir en son nom.
                Aucune modification n'est enregistrée : le retrait ou la déconnexion annule tout.
            </p>
            {% if is_temporary_member|default(false) %}
                <form method="post" action="/admin/members/temporary-access/remove">
                    {{ csrf_field()|raw }}
                    <button type="submit" class="btn btn-outline-danger">
                        <i class="bi bi-person-dash"></i> Retirer de ma liste
                    </button>
                </form>
            {% else %}
                <form method="post" action="/admin/members/{{ member.memberYearId }}/temporary-access">
                    {{ csrf_field()|raw }}
                    <button type="submit" class="btn btn-outline-primary">
                        <i class="bi bi-person-plus"></i> Ajouter temporairement à ma liste
                    </button>
                </form>
            {% endif %}
        </div>

        {# Départ — exactly Core\Member\DepartureService, the same fact the
           registration module's "Départs" page marks (ARCHITECTURE.md
           §8.37), reachable here for any member found by search — staff
           included — rather than only the animés of a section a chief
           actually staffs. #}
        <div class="mt-4" id="departure-card" data-member-year-id="{{ member.memberYearId }}">
            <div class="form-label fw-semibold mb-1">Départ prévu l'année prochaine</div>
            <p class="text-body-secondary small mb-2">
                Indique que ce membre ne reviendra probablement pas l'année scoute prochaine.
            </p>
            <div class="form-check">
                <input type="checkbox" class="form-check-input" id="departure-checkbox" {{ departure_leaving|default(false) ? 'checked' : '' }}>
                <label class="form-check-label" for="departure-checkbox">Part l'année prochaine</label>
            </div>
            <div class="mt-2" id="departure-comment-row" style="{{ departure_leaving|default(false) ? '' : 'display:none;' }}">
                <label class="form-label small mb-1" for="departure-comment">Commentaire</label>
                <textarea class="form-control form-control-sm" id="departure-comment" rows="2" maxlength="1000"
                    placeholder="Commentaire facultatif (motif du départ)">{{ departure_comment|default('') }}</textarea>
            </div>
        </div>
    </div>
</div>
