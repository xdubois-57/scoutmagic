{% extends 'base.html.twig' %}
{#
 ⚠ THIS PAGE IS THE SPECIFICATION FOR THE "scout year transition"
 END-TO-END TEST: tests/e2e/specs/scout-year-transition.spec.js.

 That test replays, in a real browser, exactly the workflow described
 below — the three phases, every step in order, the steps that vanish
 when their module is off, the ones a human marks versus the ones the
 site observes, the fact that the order is advice rather than a gate,
 the blocks that are real (an import before the staff year; the staff
 year, the import and the registration veto before the public one), the
 preview that is scoped to one
 session, the staff year that the public must not see, and the final
 switch that clears the staff year. It reads the labels off this page
 rather than copying them, but it cannot guess a change of plan.

 **Any change to this workflow must be reflected in that test, in the same
 change**: a step added, removed or reordered, a new blocking condition, a
 new control, or simply rewording a label the test relies on. The steps
 and phases themselves come from Core\ScoutYear\ScoutYearTransitionService,
 which carries the same reminder.

 The test is blocking: it fails CI (the "End-to-end (browser)" job) and
 the release, whose CI gate requires that job green. See
 docs/developpement.md § Tests de bout en bout.
#}
{% block title %}Année scoute — {{ param('site_name') }}{% endblock %}
{% block content %}
    {% include 'partials/page_header.html.twig' with {
        title: 'Année scoute',
        subtitle: "Gérez l'année scoute affichée par le site : préparez la prochaine avec les staffs, encodez-la dans Desk, importez-la, puis basculez tout le monde le moment venu.",
    } only %}

    {% if public_year_ended %}
    <div class="alert alert-warning d-flex align-items-center gap-2" role="alert">
        <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
        <div>
            L'année publique actuellement affichée ({{ public_year.label }}) est terminée depuis le
            {{ public_year.end_date }}. Le site continuera à l'afficher tant que personne n'aura suivi les étapes
            ci-dessous pour basculer vers l'année suivante.
        </div>
    </div>
    {% endif %}

    {# Current public year #}
    <div class="card mb-3">
        <div class="card-body">
            <div class="d-flex align-items-center gap-2 flex-wrap mb-1">
                <h2 class="h5 mb-0">Année publique</h2>
                {% include 'partials/status_badge.html.twig' with { status: 'active', label: 'Active' } only %}
            </div>
            <p class="fs-5 fw-semibold mb-0">{{ public_year.label }}</p>
            <p class="text-body-secondary small mb-0">Année vue par tout le monde.</p>
        </div>
    </div>

    {# Staff year (only when set) #}
    {% if staff_year %}
    <div class="card mb-3">
        <div class="card-body">
            <div class="d-flex align-items-center gap-2 flex-wrap mb-1">
                <h2 class="h5 mb-0">Année du staff</h2>
                <span class="badge text-bg-info">Staff</span>
            </div>
            <p class="fs-5 fw-semibold mb-1">{{ staff_year.label }}</p>
            <p class="text-body-secondary small mb-3">Vue par les animateurs et intendants uniquement.</p>
            <form method="post" action="/admin/scout-year/deactivate-staff">
                {{ csrf_field()|raw }}
                <button type="submit" class="btn btn-outline-secondary btn-sm">Désactiver l'année du staff</button>
            </form>
        </div>
    </div>
    {% endif %}

    {# Status tiles for the year currently in effect for you #}
    {% include 'partials/stat_tiles.html.twig' with {
        tiles: [
            { label: 'Membre(s) — ' ~ effective_year.label, value: member_count, icon: 'bi-people-fill' },
            { label: 'Section(s) configurée(s)', value: section_count, icon: 'bi-flag-fill' },
        ],
        columns: 2,
    } only %}

    {# Transition workflow — phased, stepped guide toward the next year.
       Every value below comes from Core\ScoutYear\Step\TransitionWorkflow
       (ScoutYearTransitionService::buildWorkflow()); the step's own check
       content lives in admin/scout_year/steps/{key}.html.twig. #}
    <div class="card mb-3">
        <div class="card-body">
            <h2 class="h5 mb-1">Changer d'année</h2>
            <p class="text-body-secondary small mb-2">
                {{ workflow.stepCount }} étapes, en trois temps. L'ordre est un conseil, pas un verrou : vous pouvez agir
                à tout moment sur n'importe quelle étape. Seuls trois points bloquent réellement, et le serveur les
                vérifie : le marquage de l'étape des départs tant que la campagne de réinscription n'est pas terminée,
                l'activation pour les staffs sans import réussi, et la bascule publique. Les dates des phases sont de
                simples repères, configurables dans les paramètres : sur cette page, elles ne déclenchent et ne bloquent
                jamais rien.
            </p>
            {% if workflow.lastPublicSwitch %}
            {% set last_switch = workflow.lastPublicSwitch %}
            <p class="text-body-secondary small mb-4" data-last-switch>
                Dernière bascule :
                {% if last_switch.fromLabel %}{{ last_switch.fromLabel }} → {% endif %}{{ last_switch.toLabel }},
                le {{ last_switch.switchedAt|date_fr }}{% if last_switch.switchedBy %} par {{ last_switch.switchedBy }}{% endif %}.
            </p>
            {% else %}
            <div class="mb-4"></div>
            {% endif %}

            {% for phase in workflow.phases %}
            <section class="mb-4" data-phase="{{ phase.key }}">
                <div class="d-flex align-items-center gap-2 flex-wrap mb-1">
                    <h3 class="h6 mb-0">{{ phase.title }}</h3>
                    {% if phase.current %}
                        <span class="badge text-bg-primary">Période en cours</span>
                    {% endif %}
                </div>
                {% if phase.subtitle %}
                    <p class="text-body-secondary small mb-2">{{ phase.subtitle }}</p>
                {% endif %}
                {% if phase.note %}
                <div class="alert alert-info d-flex align-items-start gap-2 py-2 px-3 mb-3" role="note">
                    <i class="bi bi-info-circle-fill mt-1" aria-hidden="true"></i>
                    <div class="small">{{ phase.note }}</div>
                </div>
                {% endif %}

                <ol class="list-unstyled step-list mb-0">
                    {% for step in phase.steps %}
                    {% set is_current = step.number == workflow.currentStepNumber %}
                    <li class="step-item d-flex gap-3 {% if not loop.last %}pb-4{% endif %} {{ step.done ? 'step-item--done' : (is_current ? 'step-item--current' : 'step-item--upcoming') }}"
                        data-step="{{ step.key }}" data-state="{{ step.state.value }}" data-nature="{{ step.nature.value }}">
                        <div class="step-item__marker flex-shrink-0">
                            <span class="step-circle {{ step.done ? 'step-circle--done' : 'step-circle--pending' }}"
                                  aria-hidden="true">
                                {% if step.done %}<i class="bi bi-check-lg" aria-hidden="true"></i>{% else %}{{ step.number }}{% endif %}
                            </span>
                        </div>
                        <div class="flex-grow-1 pt-1">
                            <div class="d-flex flex-wrap align-items-center gap-2">
                                <span class="fw-semibold {{ step.done ? 'text-success-emphasis' : '' }}">{{ step.title }}</span>
                                <span class="badge text-bg-light border">{{ step.nature.label }}</span>
                                {% if step.blocked %}<span class="badge text-bg-danger">{{ step.state.label }}</span>{% endif %}
                                {% if step.pointsToCheckCount > 0 %}
                                    <span class="badge text-bg-warning">{{ step.pointsToCheckCount }} à vérifier</span>
                                {% endif %}
                            </div>
                            <p class="text-body-secondary small mb-2">{{ step.description }}</p>

                            {% include step.detailTemplate with { step: step } only %}

                            {% if step.pointsToCheck is not empty %}
                            <ul class="small mb-2">
                                {% for point in step.pointsToCheck %}<li>{{ point }}</li>{% endfor %}
                            </ul>
                            {% endif %}

                            {% if step.blockReason %}
                            <div class="alert alert-danger d-flex align-items-start gap-2 py-2 px-3 mb-2" role="alert">
                                <i class="bi bi-x-octagon-fill mt-1" aria-hidden="true"></i>
                                <div class="small">{{ step.blockReason }}</div>
                            </div>
                            {% endif %}
                            {% if step.markRefusal and not step.done %}
                            <div class="alert alert-danger d-flex align-items-start gap-2 py-2 px-3 mb-2" role="alert">
                                <i class="bi bi-x-octagon-fill mt-1" aria-hidden="true"></i>
                                <div class="small">{{ step.markRefusal }}</div>
                            </div>
                            {% endif %}

                            {% if step.key == 'activate_staff' and blocking_request_count > 0 and not step.done %}
                            <div class="alert alert-warning d-flex align-items-start gap-2 py-2 px-3 mb-2" role="alert">
                                <i class="bi bi-exclamation-triangle-fill mt-1" aria-hidden="true"></i>
                                <div class="small">
                                    {{ blocking_request_count }} demande(s) d'inscription ne sont pas encore clôturées
                                    (toutes années confondues). Cela n'empêche pas d'activer l'année pour le staff, mais
                                    bloquera l'activation pour tout le monde tant qu'elles restent ouvertes.
                                    <a href="/config/inscriptions/demandes">Aller à la gestion des inscriptions</a>.
                                </div>
                            </div>
                            {% endif %}

                            {% if step.key == 'preview' %}
                                <form method="post" action="/admin/scout-year/preview"
                                      class="d-flex flex-wrap gap-2 align-items-end">
                                    {{ csrf_field()|raw }}
                                    <div>
                                        {% include 'partials/form_field.html.twig' with {
                                            field_id: 'preview-year', field_name: 'scout_year_id',
                                            label: 'Année', type: 'select', size: 'sm', wrapper_class: '',
                                            options: years|default([])|map(y => {
                                                value: y.id, label: y.label, selected: y.id == target_year.id,
                                            }),
                                        } only %}
                                    </div>
                                    <button type="submit"
                                            class="btn btn-sm {{ is_current ? 'btn-primary' : 'btn-outline-secondary' }}">
                                        Prévisualiser
                                    </button>
                                </form>
                                {% if effective_year.override_type == 'session' %}
                                <form method="post" action="/admin/scout-year/clear-preview" class="mt-2">
                                    {{ csrf_field()|raw }}
                                    <button type="submit" class="btn btn-sm btn-outline-secondary">Revenir à l'année courante</button>
                                </form>
                                {% endif %}

                            {% elseif step.key == 'activate_staff' %}
                                {% for action in step.actions|filter(a => a.link) %}
                                    <a href="{{ action.url }}" class="btn btn-sm btn-primary mb-2">{{ action.label }}</a>
                                {% endfor %}
                                {# Refused server-side without a successful import of the
                                   year (Core\ScoutYear\ScoutYearAdminService::activateStaffYear());
                                   the disabled button only shows that answer. #}
                                <form method="post" action="/admin/scout-year/activate-staff"
                                      class="d-flex flex-wrap gap-2 align-items-end">
                                    {{ csrf_field()|raw }}
                                    <div>
                                        {% include 'partials/form_field.html.twig' with {
                                            field_id: 'staff-year', field_name: 'scout_year_id',
                                            label: 'Année', type: 'select', size: 'sm', wrapper_class: '',
                                            disabled: step.blocked,
                                            options: years|default([])|map(y => {
                                                value: y.id, label: y.label, selected: y.id == target_year.id,
                                            }),
                                        } only %}
                                    </div>
                                    <button type="submit"
                                            class="btn btn-sm {{ is_current ? 'btn-primary' : 'btn-outline-secondary' }}"
                                            {{ step.blocked ? 'disabled' : '' }}>
                                        Activer pour le staff
                                    </button>
                                </form>

                            {% elseif step.key == 'activate_public' %}
                                {# Refused server-side while the staff year is not the
                                   target, the target has no successful import, or the
                                   registration module vetoes (specifications.md §19.2) —
                                   Core\ScoutYear\ScoutYearAdminService::activatePublicYear().
                                   The confirmation is `data-confirm` on the FORM (design.md
                                   §7.5): confirm.js stops the submission, asks, and replays it
                                   with its original submitter. #}
                                <form method="post" action="/admin/scout-year/activate-public" id="activate-public-form"
                                      class="d-flex flex-wrap gap-2 align-items-end"
                                      data-confirm="Activer cette année pour tout le monde ? Le public verra immédiatement cette année. Aucun e-mail n'est envoyé."
                                      data-confirm-label="Activer">
                                    {{ csrf_field()|raw }}
                                    <div>
                                        {% include 'partials/form_field.html.twig' with {
                                            field_id: 'public-year', field_name: 'scout_year_id',
                                            label: 'Année', type: 'select', size: 'sm', wrapper_class: '',
                                            disabled: step.blocked,
                                            options: years|default([])|map(y => {
                                                value: y.id, label: y.label, selected: y.id == target_year.id,
                                            }),
                                        } only %}
                                    </div>
                                    <button type="submit"
                                            class="btn btn-sm {{ is_current ? 'btn-danger' : 'btn-outline-secondary' }}"
                                            {{ step.blocked ? 'disabled' : '' }}>
                                        Activer pour tout le monde
                                    </button>
                                </form>

                            {% else %}
                                {% for action in step.actions|filter(a => a.link) %}
                                    <a href="{{ action.url }}"
                                       class="btn btn-sm {{ is_current and loop.first ? 'btn-primary' : 'btn-outline-secondary' }}">
                                        {{ action.label }}
                                    </a>
                                {% endfor %}
                            {% endif %}

                            {% if step.human %}
                            {# A human step is done when someone marks it — never by a
                               check, whose findings stay points to check. `done` is explicit, never a toggle. #}
                            <form method="post" action="/admin/scout-year/step" class="mt-2 js-step-form">
                                {{ csrf_field()|raw }}
                                <input type="hidden" name="step_key" value="{{ step.key }}">
                                <input type="hidden" name="done" value="{{ step.done ? '0' : '1' }}">
                                <div class="form-check">
                                    <input class="form-check-input js-step-checkbox" type="checkbox"
                                           id="step-check-{{ step.key }}"
                                           {{ step.done ? 'checked' : '' }}>
                                    <label class="form-check-label small" for="step-check-{{ step.key }}">
                                        {% if step.done %}
                                            Fait{% if step.mark and step.mark.doneBy %} par {{ step.mark.doneBy }}{% endif %}
                                            {%- if step.mark %} le {{ step.mark.doneAt|date_fr }}{% endif %}
                                        {% else %}
                                            Marquer cette étape comme faite
                                        {% endif %}
                                    </label>
                                </div>
                                <noscript>
                                    <button type="submit" class="btn btn-sm btn-outline-secondary mt-1">
                                        {{ step.done ? 'Remettre à faire' : 'Marquer comme fait' }}
                                    </button>
                                </noscript>
                            </form>
                            {% endif %}
                        </div>
                    </li>
                    {% endfor %}
                </ol>
            </section>
            {% endfor %}
        </div>
    </div>
{% endblock %}

{% block scripts %}
<script src="{{ asset('/assets/js/admin-scout-year.js') }}" defer nonce="{{ csp_nonce }}"></script>
{% endblock %}
