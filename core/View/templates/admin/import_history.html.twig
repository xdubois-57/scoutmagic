{% extends 'base.html.twig' %}
{% block title %}Historique des imports — {{ site_name }}{% endblock %}

{#
   The Desk import history (Core\Http\Controller\ImportController::history).

   Each row is one import and everything it produced: its counters, the
   roster snapshot it froze, and the CSV it consumed — downloadable, and
   only through /files/{id}. The purge is shown rather than left as an
   unexplained gap in the year picker: a season that has gone should say
   so.
#}

{% block content %}
    {% include 'partials/page_header.html.twig' with {
        title: 'Historique des imports',
        badge: selected_year.label,
        subtitle: "Chaque import conserve son fichier chiffré et l'instantané du roster qu'il a figé.",
    } only %}

    <div class="row row-cols-3 g-2 g-sm-3 mb-3">
        <div class="col">
            <div class="card h-100">
                <div class="card-body p-3">
                    <p class="h5 text-primary mb-0">{{ rows|length }}</p>
                    <p class="small text-body-secondary mb-0">import{{ rows|length > 1 ? 's' : '' }} cette année</p>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card h-100">
                <div class="card-body p-3">
                    <p class="h5 mb-0">{{ retention_years }} année{{ retention_years > 1 ? 's' : '' }}</p>
                    <p class="small text-body-secondary mb-0">durée de conservation</p>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card h-100">
                <div class="card-body p-3">
                    <p class="h5 mb-0">{{ (total_bytes / 1024)|round }} Ko</p>
                    <p class="small text-body-secondary mb-0">fichiers conservés</p>
                </div>
            </div>
        </div>
    </div>

    {% include 'partials/nav_rail.html.twig' with {
        picker_id: 'import-history-years',
        items: years|map(y => {
            id: y.id,
            label: y.label,
            selected: y.id == selected_year.id,
        }),
        base_url: '/admin/import/historique?annee=',
        aria_label: 'Année scoute',
    } only %}

    {% if rows is empty %}
        {% include 'partials/empty_state.html.twig' with {
            icon: 'bi-clock-history',
            message: 'Aucun import conservé pour ' ~ selected_year.label ~ '.',
        } only %}
    {% else %}
        <div class="mt-3">
            {% for row in rows %}
                {% set import = row.import %}
                <div class="card mb-2">
                    <div class="card-body">
                        <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                            <span class="fw-semibold">{{ import.importedAt|date('d/m/Y, H:i') }}</span>
                            {% if row.first_of_season %}
                                <span class="badge text-bg-secondary">Premier de la saison</span>
                            {% endif %}
                            {% if import.newFunctionsCount > 0 %}
                                <span class="badge text-bg-warning">{{ import.newFunctionsCount }} à qualifier</span>
                            {% endif %}
                        </div>
                        <p class="small text-body-secondary mb-2">
                            {% if row.author %}par {{ row.author }} — {% endif %}
                            {{ import.memberCount }} membre{{ import.memberCount > 1 ? 's' : '' }},
                            {{ import.lineCount }} ligne{{ import.lineCount > 1 ? 's' : '' }}
                        </p>

                        <dl class="row small mb-0">
                            <dt class="col-7 col-sm-5 fw-normal text-body-secondary">Année scoute</dt>
                            <dd class="col-5 col-sm-7 mb-1">{{ selected_year.label }}</dd>
                            <dt class="col-7 col-sm-5 fw-normal text-body-secondary">Instantané du roster</dt>
                            <dd class="col-5 col-sm-7 mb-0">
                                {% if row.snapshot %}
                                    conservé — {{ row.snapshot.memberCount }} membre{{ row.snapshot.memberCount > 1 ? 's' : '' }}
                                {% else %}
                                    indisponible
                                {% endif %}
                            </dd>
                        </dl>
                    </div>
                    <div class="card-footer d-flex flex-wrap align-items-center gap-2">
                        <a href="/admin/import/{{ import.id }}/rapport" class="btn btn-outline-secondary btn-sm">
                            Voir le rapport
                        </a>
                        {% if row.file %}
                            <a href="{{ file_url(row.file.id) }}" class="btn btn-outline-secondary btn-sm">
                                <i class="bi bi-download" aria-hidden="true"></i>
                                {{ row.file.originalName }}
                            </a>
                            <span class="small text-body-secondary">
                                <i class="bi bi-lock" aria-hidden="true"></i>
                                chiffré · {{ (row.file.sizeBytes / 1024)|round }} Ko · téléchargement journalisé
                            </span>
                        {% else %}
                            <span class="small text-body-secondary">
                                <i class="bi bi-lock" aria-hidden="true"></i>
                                Aucun fichier conservé pour cet import.
                            </span>
                        {% endif %}
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}

    {# La purge est visible : on sait ce qui a disparu, et pourquoi. #}
    <section class="mt-4">
        <h2 class="h6">Saisons supprimées</h2>
        {% if purged_years is empty %}
            <p class="small text-body-secondary mb-2">
                Aucune saison n'a encore atteint la fin de sa durée de conservation.
            </p>
        {% else %}
            <ul class="list-unstyled small mb-2">
                {% for year in purged_years %}
                    <li class="mb-1">
                        <span class="fw-medium">{{ year.label }}</span>
                        — imports supprimés, fichiers et instantanés compris
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
        <div class="alert alert-secondary small mb-0" role="note">
            La suppression porte sur une saison entière : ligne d'import, fichier chiffré et instantané
            du roster partent ensemble. Les instantanés de l'année en cours ne sont jamais supprimés,
            quel que soit le nombre d'imports — la vérification des factures de cotisation en dépend
            jusqu'à la régularisation de fin d'année.
        </div>
    </section>
{% endblock %}
