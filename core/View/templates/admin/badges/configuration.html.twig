{% extends "base.html.twig" %}

{% block title %}Configuration des badges — {{ site_name }}{% endblock %}

{#
  Moved as it was from Configuration > Badges (issue #621): same fields,
  same switches, same deletion rules, same texts. The one change is the
  row below the md breakpoint — the name takes the whole width and the
  switch, its « Actif » label and the bin drop to the line below, the bin
  pushed to the right. From md up the row is what it always was.
#}
{% block content %}
    {% include 'admin/badges/_nav.html.twig' %}
    {% include 'partials/page_header.html.twig' with { title: 'Configuration des badges' } only %}

    <p class="text-body-secondary small mb-3">
        Rôles transversaux assignables aux animateurs et chefs d'unité (ex: Infirmier, Trésorier),
        affichés sur le trombinoscope. Les badges par défaut ne peuvent pas être renommés ni
        supprimés, seulement désactivés. Un badge « Référent {section} » est en outre créé
        automatiquement pour chaque section visible (renommé automatiquement si la section
        l'est) — assignable uniquement à des membres du Staff d'U, activable/désactivable
        comme n'importe quel autre badge.
    </p>

    <div class="d-flex flex-column gap-2 mb-3" id="badge-list">
        {% for badge in badges %}
            {% include 'admin/badges/_row.html.twig' with { badge: badge, blocked_reason: undeletable_badge_reasons[badge.id] ?? null } only %}
        {% endfor %}
    </div>

    {# What config-badges.js clones for a badge created without a reload: the
       same row, from the same partial. A new badge is custom and unassigned,
       so it can be renamed, switched and deleted at once. #}
    <template id="badge-row-template">
        {% include 'admin/badges/_row.html.twig' with { badge: { id: 0, name: '', isDefault: false, isActive: true, referentSectionId: null }, blocked_reason: null } only %}
    </template>

    <div class="border rounded-3 p-3 d-flex flex-wrap align-items-center gap-2 mb-4" id="badge-add-form">
        <input type="text" class="form-control form-control-sm flex-grow-1" id="new-badge-name" placeholder="Communication" style="max-width:220px;min-width:120px;" aria-label="Nom du nouveau badge">
        <button type="button" class="btn btn-sm btn-primary" id="badge-add-btn">
            <i class="bi bi-plus-lg" aria-hidden="true"></i> Ajouter
        </button>
    </div>
{% endblock %}

{% block scripts %}
<script src="{{ asset('/assets/js/config-badges.js') }}" defer></script>
{% endblock %}
