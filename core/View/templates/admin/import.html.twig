{% extends 'base.html.twig' %}
{% block title %}Import Desk — {{ site_name }}{% endblock %}
{% block content %}
    {% include 'partials/page_header.html.twig' with { title: 'Import Desk' } only %}

    {# Scout year info #}
    <div class="card mb-3">
        <div class="card-body">
            <h2 class="h5">Année scoute</h2>
            <p class="text-body-secondary small mb-0">
                L'année publique actuelle est <strong>{{ current_year.label }}</strong>.
                Vous pouvez importer les données de n'importe quelle année ci-dessous — y compris
                l'année prochaine — sans changer l'année vue par le public.
            </p>
        </div>
    </div>

    {# Unconfirmed functions warning #}
    {% if unconfirmed_count > 0 %}
        <div class="alert alert-warning">
            <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
            {{ unconfirmed_count }} fonction(s) importée(s) n'ont pas encore de rôle confirmé.
            Les membres avec ces fonctions ont le rôle « Animé » par défaut.
            <a href="/config/functions">Configurer les fonctions</a>
        </div>
    {% endif %}

    {# Upload form #}
    <div class="card mb-3">
        <div class="card-body">
            <h2 class="h5">Importer un fichier CSV</h2>
            <p class="text-body-secondary small">
                Exportez la liste des membres depuis Desk, puis téléchargez le fichier CSV ici.
                Les données existantes pour l'année sélectionnée seront mises à jour.
            </p>
            <form method="post" action="/admin/import" enctype="multipart/form-data">
                {{ csrf_field()|raw }}
                {# The public year's own entry says so in its label, so the one
                   year the import is NOT about by default is named, not just
                   pre-selected. #}
                {% set _year_options = years|map(y => {
                    value: y.id,
                    label: y.label ~ (y.id == current_year.id ? ' — année publique' : ''),
                    selected: y.id == current_year.id,
                }) %}
                {% include 'partials/form_field.html.twig' with {
                    field_id: 'scout-year-id', field_name: 'scout_year_id', type: 'select',
                    label: 'Année scoute cible', options: _year_options,
                } only %}
                <div class="mb-3">
                    <input type="file" name="csv_file" accept=".csv" class="form-control" required aria-label="Fichier CSV à importer">
                </div>
                <button type="submit" class="btn btn-primary">Importer</button>
            </form>
        </div>
    </div>

    {# La conservation est annoncée AVANT le dépôt, pas découverte après. #}
    <div class="alert alert-warning d-flex gap-2" role="note">
        <i class="bi bi-lock flex-shrink-0" aria-hidden="true"></i>
        <span>
            <strong>Ce fichier sera conservé, chiffré, pendant {{ retention_years }} année{{ retention_years > 1 ? 's' : '' }}
            scoute{{ retention_years > 1 ? 's' : '' }}.</strong>
            Il contient les données personnelles de toute l'unité. Seuls les chefs d'unité peuvent le
            télécharger, et chaque téléchargement est journalisé. Passé ce délai, il est supprimé
            définitivement avec l'instantané du roster qui l'accompagne.
        </span>
    </div>

    {# Last import info #}
    <div class="card mb-3">
        <div class="card-body">
            <h2 class="h5">Dernier import</h2>
            {% if last_import %}
                <p class="small text-body-secondary mb-2">
                    {{ last_import.imported_at|datetime_fr }}
                    {% if last_import_author %} — par {{ last_import_author }}{% endif %}
                    — {{ last_import.member_count }} membres,
                    {{ last_import.line_count }} lignes
                    {% if last_import.new_functions_count > 0 %}
                        , {{ last_import.new_functions_count }} nouvelle(s) fonction(s)
                    {% endif %}
                </p>
            {% else %}
                <p class="small text-body-secondary mb-2">Aucun import pour l'année publique.</p>
            {% endif %}
            {% if last_import %}
                <a href="/admin/import/{{ last_import.id }}/rapport" class="btn btn-outline-secondary btn-sm">Voir son rapport</a>
            {% endif %}
            <a href="/admin/import/historique" class="btn btn-outline-secondary btn-sm">Historique complet</a>
        </div>
    </div>

    {# Import result (shown after successful import) #}
    {% if import_result %}
        <div class="alert alert-success">
            <strong>Import réussi.</strong>
            {{ import_result.memberCount }} membres importés ({{ import_result.lineCount }} lignes).
            {% if import_result.newFunctionsCount > 0 %}
                {{ import_result.newFunctionsCount }} nouvelle(s) fonction(s) créée(s)
                — <a href="/config/functions">configurer les rôles</a>.
            {% endif %}
            {% if last_import %}
                <a href="/admin/import/{{ last_import.id }}/rapport">Voir le rapport de cet import</a>.
            {% endif %}
        </div>
        {% if import_result.warnings|length > 0 %}
            <div class="alert alert-warning">
                <strong>Avertissements :</strong>
                <ul class="mb-0">
                    {% for warning in import_result.warnings %}
                        <li>{{ warning }}</li>
                    {% endfor %}
                </ul>
            </div>
        {% endif %}
    {% endif %}
{% endblock %}
