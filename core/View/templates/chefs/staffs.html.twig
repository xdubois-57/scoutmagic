{% extends 'base.html.twig' %}
{% block title %}Staffs — {{ site_name }}{% endblock %}
{% block stylesheets %}
<link rel="stylesheet" href="/assets/css/components.css">
{% endblock %}
{% block content %}
    <h1 class="mb-3">Staffs</h1>

    {% if sections|length > 0 %}
        {% include 'partials/section_picker.html.twig' with {
            sections: sections,
            selected_id: current_section.id|default(0),
            base_url: '/chefs/staffs?section='
        } %}
    {% endif %}

    {% if current_section %}
        <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
            <span class="fw-semibold fs-5">{{ current_section.name ?? current_section.desk_code }}</span>
            <span class="badge bg-secondary-subtle text-secondary-emphasis">
                {{ current_section.branch_name }}
            </span>
            <span class="text-body-secondary small">{{ staff|length }} animateur{{ staff|length > 1 ? 's' : '' }}</span>
        </div>
        <p class="text-body-secondary small mb-3">
            {{ current_section.email ?? 'Aucun email configuré' }}
            {% if current_section.id > 0 %}
            · code {{ current_section.desk_code }}
        {% endif %}
        </p>

        {% if not current_section.name and current_section.id > 0 %}
            <div class="alert alert-warning small py-2 mb-3">
                <i class="bi bi-exclamation-triangle"></i>
                Cette section n'a pas encore de nom configuré.
                {% if can_edit_section %}
                    Ce réglage se fait sur la page « Config Desk ».
                {% endif %}
            </div>
        {% endif %}

        {% if current_section.id > 0 %}
            <div class="mb-3">
                {{ section_photo(current_section.id, current_section.name ?? current_section.desk_code) }}
            </div>
        {% endif %}

        <div class="d-flex flex-column gap-2">
            {% for member in staff %}
                <div class="card">
                    <div class="card-body p-3">
                        <div class="d-flex align-items-center gap-3 mb-2">
                            <div class="rounded-circle bg-primary-subtle d-flex align-items-center justify-content-center"
                                 style="width:40px;height:40px;min-width:40px;">
                                <span class="small fw-semibold text-primary">
                                    {{ member.getDisplayName()[:2] }}
                                </span>
                            </div>
                            <div>
                                <span class="fw-semibold">{{ member|display_name|normalize_name }}</span>
                                {% if member.getMainFunction() %}
                                <div class="text-body-secondary small">
                                    {{ member.getMainFunction().functionLabel }}
                                </div>
                                {% endif %}
                            </div>
                        </div>

                        {% if can_edit_section and available_badges|length > 0 %}
                            {% set badge_items = [] %}
                            {% for badge in available_badges %}
                                {% set assigned = false %}
                                {% for mb in member.badges %}
                                    {% if mb.id == badge.id %}{% set assigned = true %}{% endif %}
                                {% endfor %}
                                {% set badge_items = badge_items|merge([{
                                    id: badge.id,
                                    label: badge.name,
                                    selected: assigned,
                                }]) %}
                            {% endfor %}
                            <div class="badge-picker" data-member-year-id="{{ member.memberYearId }}">
                                {% include 'partials/chip_picker.html.twig' with {
                                    picker_id: 'badge-picker-' ~ member.memberYearId,
                                    items: badge_items,
                                    mode: 'multi',
                                    sheet_title: 'Choisir les badges',
                                    empty_text: 'Aucun badge disponible.',
                                } %}
                            </div>
                        {% elseif member.badges|length > 0 %}
                            <div class="d-flex flex-wrap gap-1 mb-2">
                                {% for badge in member.badges %}
                                    <span class="badge bg-info-subtle text-info-emphasis d-inline-flex align-items-center gap-1">
                                        {{ badge.name }}
                                    </span>
                                {% endfor %}
                            </div>
                        {% endif %}

                        <div class="d-flex flex-wrap gap-3 small">
                            {% if member.formationLevel %}
                                <span>
                                    <i class="bi bi-mortarboard text-body-secondary"></i>
                                    {{ member.formationLevel }}
                                </span>
                            {% endif %}
                            {% if member.mobile %}
                                <a href="tel:{{ member.mobile|normalize_phone|replace({' ': ''}) }}" class="text-decoration-none">
                                    <i class="bi bi-phone text-body-secondary"></i>
                                    {{ member.mobile|normalize_phone }}
                                </a>
                            {% elseif member.phone %}
                                <a href="tel:{{ member.phone|normalize_phone|replace({' ': ''}) }}" class="text-decoration-none">
                                    <i class="bi bi-telephone text-body-secondary"></i>
                                    {{ member.phone|normalize_phone }}
                                </a>
                            {% endif %}
                            {% if member.email %}
                                <a href="mailto:{{ member.email }}" class="text-decoration-none text-truncate"
                                   style="max-width:200px;">
                                    <i class="bi bi-envelope text-body-secondary"></i>
                                    {{ member.email }}
                                </a>
                            {% endif %}
                        </div>
                    </div>
                </div>
            {% else %}
                <p class="text-body-secondary fst-italic">Aucun animateur dans cette section.</p>
            {% endfor %}
        </div>

        <div class="card mt-4">
            <div class="card-body p-3">
                <div class="d-flex align-items-center justify-content-between mb-2 flex-wrap gap-2">
                    <h2 class="h5 mb-0">Documents de section</h2>
                    {% if can_edit_section %}
                        <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#sectionDocumentAddModal">
                            <i class="bi bi-plus-lg"></i> Ajouter un document
                        </button>
                    {% endif %}
                </div>

                {% if section_document_compression_backend_none %}
                    <div class="alert alert-warning small py-2 mb-3">
                        <i class="bi bi-exclamation-triangle"></i>
                        Aucun outil de compression PDF n'est disponible sur ce serveur — les documents PDF ajoutés ne seront pas compressés automatiquement.
                        {% if can_edit_section %}
                            Pour l'activer&nbsp;: installez Ghostscript (<code>apt install ghostscript</code> ou <code>yum install ghostscript</code>) sur le serveur, ou vérifiez que <code>proc_open</code> n'est pas désactivé dans la configuration PHP (<code>disable_functions</code>). Sur un hébergement mutualisé où vous ne pouvez pas installer de logiciel, contactez votre hébergeur.
                        {% endif %}
                    </div>
                {% endif %}

                <div class="accordion" id="sectionDocumentAccordion">
                    {% for year_block in section_document_years %}
                        <div class="accordion-item">
                            <h2 class="accordion-header">
                                <button class="accordion-button {{ year_block.is_current ? '' : 'collapsed' }}" type="button"
                                        data-bs-toggle="collapse" data-bs-target="#sdYear{{ year_block.scout_year.id }}">
                                    {{ year_block.scout_year.label }}
                                    <span class="badge bg-secondary-subtle text-secondary-emphasis ms-2">
                                        {{ year_block.documents|length }} document{{ year_block.documents|length > 1 ? 's' : '' }}
                                    </span>
                                </button>
                            </h2>
                            <div id="sdYear{{ year_block.scout_year.id }}"
                                 class="accordion-collapse collapse {{ year_block.is_current ? 'show' : '' }}"
                                 data-bs-parent="#sectionDocumentAccordion">
                                <div class="accordion-body">
                                    {% embed 'partials/list_editor.html.twig' with {
                                        list_id: 'section-document-list-' ~ year_block.scout_year.id,
                                        items: year_block.documents,
                                        reorder_url: can_edit_section ? '/chefs/staffs/documents/reorder' : '',
                                        delete_url: can_edit_section ? '/chefs/staffs/documents/delete' : '',
                                        empty_label: 'Aucun document pour cette année.'
                                    } %}
                                        {% block item_content %}
                                            <div class="section-document-row" data-id="{{ item.id }}">
                                                {% if can_edit_section %}
                                                    <label class="visually-hidden" for="section-document-title-{{ item.id }}">Titre du document</label>
                                                    <input type="text" class="form-control form-control-sm mb-1 section-document-title-input"
                                                           id="section-document-title-{{ item.id }}"
                                                           value="{{ item.title }}" placeholder="Titre" data-id="{{ item.id }}">
                                                    <label class="visually-hidden" for="section-document-description-{{ item.id }}">Description du document</label>
                                                    <textarea class="form-control form-control-sm mb-1 section-document-description-input" rows="1"
                                                              id="section-document-description-{{ item.id }}"
                                                              placeholder="Description (optionnel)" data-id="{{ item.id }}">{{ item.description }}</textarea>
                                                {% else %}
                                                    <div class="fw-semibold">{{ item.title }}</div>
                                                    {% if item.description %}
                                                        <div class="text-body-secondary small">{{ item.description }}</div>
                                                    {% endif %}
                                                {% endif %}
                                                <div class="small text-body-secondary">
                                                    <a href="{{ file_url(item.fileId) }}" target="_blank" rel="noopener">
                                                        <i class="bi bi-file-earmark-arrow-down"></i> Télécharger
                                                    </a>
                                                    {% if item.compressionStatus == 'compressed' %}
                                                        · <span class="badge bg-success-subtle text-success-emphasis">
                                                            {{ (item.sizeBeforeBytes / 1024 / 1024)|number_format(1) }}&nbsp;Mo → {{ (item.sizeAfterBytes / 1024 / 1024)|number_format(1) }}&nbsp;Mo
                                                        </span>
                                                    {% elseif item.compressionStatus == 'pending' %}
                                                        · <span class="badge bg-secondary-subtle text-secondary-emphasis">Compression en cours…</span>
                                                    {% endif %}
                                                </div>
                                            </div>
                                        {% endblock %}
                                    {% endembed %}
                                </div>
                            </div>
                        </div>
                    {% else %}
                        <p class="text-body-secondary fst-italic mb-0">Aucun document pour cette section.</p>
                    {% endfor %}
                </div>
            </div>
        </div>

        {% if can_edit_section %}
            <div class="modal fade" id="sectionDocumentAddModal" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog">
                    <form method="post" action="/chefs/staffs/documents" enctype="multipart/form-data" id="section-document-add-form">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title">Ajouter un document</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
                            </div>
                            <div class="modal-body">
                                {{ csrf_field() }}
                                <input type="hidden" name="section_id" value="{{ current_section.id }}">
                                <div class="mb-2">
                                    <label class="form-label small" for="section-document-add-scout-year">Année scoute</label>
                                    <select name="scout_year_id" id="section-document-add-scout-year" class="form-select">
                                        {% for year_block in section_document_years %}
                                            <option value="{{ year_block.scout_year.id }}" {{ year_block.is_current ? 'selected' : '' }}>
                                                {{ year_block.scout_year.label }}
                                            </option>
                                        {% endfor %}
                                    </select>
                                </div>
                                <div class="mb-2">
                                    <label class="form-label small" for="section-document-file-input">Fichier</label>
                                    <input type="file" name="file" class="form-control" required id="section-document-file-input"
                                           accept=".pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.odt,.ods,.odp,.txt,.csv">
                                    <div class="form-text">PDF, Word, Excel, PowerPoint, OpenDocument, texte, CSV — 20 Mo maximum.</div>
                                </div>
                                <div class="mb-2">
                                    <label class="form-label small" for="section-document-add-title">Titre</label>
                                    <input type="text" name="title" class="form-control" id="section-document-add-title" placeholder="Nom du fichier par défaut">
                                </div>
                                <div class="mb-0">
                                    <label class="form-label small" for="section-document-add-description">Description</label>
                                    <textarea name="description" class="form-control" id="section-document-add-description" rows="2"></textarea>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                                <button type="submit" class="btn btn-primary">Ajouter</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        {% endif %}
    {% else %}
        <p class="text-body-secondary">
            Aucune section disponible. Les sections apparaîtront après le premier import Desk.
        </p>
    {% endif %}
{% endblock %}

{% block scripts %}
{% if can_edit_section is defined and can_edit_section %}
<script src="/assets/js/list-editor.js" defer></script>
<script nonce="{{ csp_nonce }}">
// Documents de section — title/description auto-save on blur (no save
// button, module addendum), separate from list-editor.js's own
// reorder/delete wiring (loaded above) since it has no concept of
// per-item editable fields.
document.querySelectorAll('.section-document-title-input, .section-document-description-input').forEach(function (field) {
    field.addEventListener('blur', function () {
        var row = field.closest('.section-document-row');
        var title = row.querySelector('.section-document-title-input').value;
        var description = row.querySelector('.section-document-description-input').value;
        var csrf = document.querySelector('meta[name="csrf-token"]')?.content;

        fetch('/chefs/staffs/documents/' + row.dataset.id, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ title: title, description: description, _csrf_token: csrf })
        })
        .then(function (res) { return res.json(); })
        .then(function (data) {
            if (!data.success) alert(data.error || 'Erreur.');
        });
    });
});

// Oversize warning — shown only when no compression backend is
// available server-side (module addendum: never when one is, whatever
// the file size, since the server shrinks it itself in that case).
// Purely advisory: it never blocks the upload, it only offers to shrink
// the file first via iLovePDF or an offline alternative.
{% if section_document_compression_backend_none %}
(function () {
    var input = document.getElementById('section-document-file-input');
    if (!input) return;
    var thresholdBytes = {{ section_document_oversize_warning_mb|default(5) }} * 1024 * 1024;

    input.addEventListener('change', function () {
        var file = input.files[0];
        if (!file || file.size <= thresholdBytes) return;

        var sizeMb = (file.size / 1024 / 1024).toFixed(1);
        var proceed = confirm(
            'Ce fichier fait ' + sizeMb + ' Mo. Aucun outil de compression n\'est disponible sur ce serveur pour le réduire automatiquement.\n\n' +
            'Vous pouvez le réduire vous-même avant de l\'ajouter : en ligne via iLovePDF (ilovepdf.com), ou hors ligne avec Aperçu (macOS) ' +
            'ou un outil équivalent sous Windows/Linux.\n\n' +
            'Attention si ce document contient des données personnelles avant de le transmettre à un service en ligne tiers.\n\n' +
            'Cliquez sur OK pour ajouter ce fichier tel quel, ou sur Annuler pour choisir un autre fichier.'
        );
        if (!proceed) {
            input.value = '';
        }
    });
})();
{% endif %}

// Badge picker per staff member — partials/chip_picker.html.twig in
// mode:multi, same component as the section picker above. chip-picker.js
// already flips the chip/sheet-row visual state optimistically on click
// and dispatches chip-picker:change with the picker's full new selection
// (docs/module-development.md); this only needs to translate that into
// the existing single-badge-toggle AJAX endpoint (one member_year_id +
// the one badge_id that just changed) and revert the optimistic state if
// the server rejects the toggle.
document.querySelectorAll('.badge-picker').forEach(wrapper => {
    const picker = wrapper.querySelector('.chip-picker');
    if (!picker) return;

    const memberYearId = wrapper.dataset.memberYearId;
    let previousSelected = new Set(
        Array.prototype.slice
            .call(picker.querySelectorAll('.chip-picker-item[data-selected="true"]'))
            .map(el => el.dataset.id)
    );

    picker.addEventListener('chip-picker:change', async (e) => {
        const nextSelected = new Set(e.detail.selectedIds);
        let badgeId = null;
        nextSelected.forEach(id => { if (!previousSelected.has(id)) badgeId = id; });
        if (badgeId === null) {
            previousSelected.forEach(id => { if (!nextSelected.has(id)) badgeId = id; });
        }
        if (badgeId === null) return;

        const assigned = nextSelected.has(badgeId);
        const csrf = document.querySelector('meta[name="csrf-token"]')?.content;

        const res = await fetch('/chefs/staffs/badge-toggle', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ member_year_id: parseInt(memberYearId), badge_id: parseInt(badgeId), _csrf_token: csrf })
        });
        const data = await res.json();

        if (data.success) {
            previousSelected = nextSelected;
        } else {
            window.ChipPicker.setSelected(picker.id, badgeId, !assigned);
            alert(data.error);
        }
    });
});
</script>
{% endif %}
{% endblock %}
