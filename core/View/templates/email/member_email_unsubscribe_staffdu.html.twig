{% extends 'email/base.html.twig' %}
{% block content %}
    <h2 style="margin:0 0 20px;font-size:20px;line-height:1.3;color:#212529;">Une adresse s'est désinscrite des envois groupés</h2>
    <p style="margin:0 0 16px;">Bonjour,</p>
    <p style="margin:0 0 16px;">
        L'adresse <strong>{{ unsubscribed_email }}</strong> vient de se désinscrire des emails
        groupés de l'unité.
    </p>
    {% if member_names %}
        <p style="margin:0 0 16px;">Membre(s) concerné(s) : <strong>{{ member_names }}</strong>.</p>
    {% endif %}
    <p style="margin:0 0 16px;">
        Cette adresse ne recevra plus aucun envoi groupé. La personne peut toujours
        se connecter au site et recevoir les messages personnels qui la concernent.
    </p>
{% endblock %}
