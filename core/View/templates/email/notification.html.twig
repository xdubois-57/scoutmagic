 The email copy of a notification (ARCHITECTURE.md §8.24). With discretion
 on, `body` carries the neutral stand-in sentence instead of the
 notification's own text — the same substitution the push payload makes —
 and the link is the only way to the content. The choice is made by
 Core\Notification\NotificationMailer so that this template, and a body an
 administrator reworded, say exactly the same thing.
#}
{% extends 'email/base.html.twig' %}
{% block content %}
    <h2 style="margin:0 0 20px;font-size:20px;line-height:1.3;color:#212529;">{{ title }}</h2>
    <p style="margin:0 0 16px;">Bonjour,</p>
    <p style="margin:0 0 16px;">{{ body|nl2br }}</p>
    <p style="margin:24px 0;text-align:center;">
        <a href="{{ url }}"
           style="display:inline-block;padding:12px 28px;background-color:#0d6efd;color:#ffffff;text-decoration:none;border-radius:6px;font-weight:bold;">
            Ouvrir sur le site
        </a>
    </p>
    <p style="margin:0;font-size:13px;color:#6c757d;">
        Vous recevez ce message parce que le canal « Mail » est actif pour ce type de
        notification. <a href="{{ preferences_url }}" style="color:#0d6efd;">Modifier mes préférences</a>.
    </p>
{% endblock %}
