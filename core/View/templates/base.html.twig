<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="csrf-token" content="{{ csrf_token() }}">
    <title>{% block title %}{{ site_name }}{% endblock %}</title>
    {# Installable PWA (Lot 1) — manifest values (name, colors, icons) all
       come from Core\Config\SettingService via PwaController::manifest(),
       never hardcoded (ARCHITECTURE §1). theme-color must match the
       manifest's own for a consistent OS status-bar/task-switcher color
       whether the site is installed or just open in a tab. #}
    <link rel="manifest" href="/manifest.webmanifest">
    <link rel="apple-touch-icon" href="/pwa/icon-180.png?v={{ pwa_icon_version|default(1) }}">
    {# Unit logo feature — favicons derived from the same uploaded logo as
       the PWA icons above (Core\Photo\UnitLogoService). The 32/16 PNGs
       here are what every current browser actually uses; /favicon.ico
       (no <link> needed — browsers request it implicitly at the root) is
       the legacy fallback for the rest, see PwaController::favicon(). #}
    {% if unit_logo_available|default(false) %}
    <link rel="icon" type="image/png" sizes="32x32" href="/pwa/icon-32.png?v={{ pwa_icon_version|default(1) }}">
    <link rel="icon" type="image/png" sizes="16x16" href="/pwa/icon-16.png?v={{ pwa_icon_version|default(1) }}">
    {% endif %}
    <meta name="theme-color" content="{{ pwa_theme_color|default('#0d6efd') }}">
    {% block head_meta %}{% endblock %}
    <link rel="stylesheet" href="/assets/vendor/bootstrap/css/bootstrap.min.css">
    <link rel="stylesheet" href="/assets/vendor/bootstrap-icons/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/assets/css/app.css">
    {# editable.css styles both .editable-content (rich text — config mode
       only) and .editable-image (member_photo()'s $editable flag lets a
       member replace their own photo outside configuration mode too, see
       the editable.js include below) — must load unconditionally, or
       .editable-image never gets its position:relative and the overlay
       button positions itself against the wrong ancestor. #}
    <link rel="stylesheet" href="/assets/css/editable.css">
    {% block stylesheets %}{% endblock %}
</head>
<body>
    {% block nav %}
    {% if menus is defined and menus is not null %}
        {% include 'partials/nav.html.twig' with {
            menus: menus,
            current_path: current_path|default('/'),
            is_authenticated: is_authenticated|default(false),
            user_display_name: current_user_display_name|default(''),
            user_role_label: current_user_role_label|default(''),
            site_name: site_name|default('Unité scoute'),
            active_menu_id: active_menu_id|default('')
        } %}
    {% endif %}
    {% endblock %}

    {% include 'partials/breadcrumb_bar.html.twig' %}

    {% if config_mode is defined and config_mode %}
    <div class="alert alert-warning d-flex align-items-center gap-2 rounded-0 mb-0 border-start-0 border-end-0" role="alert">
        <i class="bi bi-exclamation-triangle"></i>
        <span>Mode configuration actif — les textes et images du site sont éditables.</span>
        <form method="post" action="/config-mode/deactivate" class="ms-auto">
            {{ csrf_field()|raw }}
            <button type="submit" class="btn btn-sm btn-outline-warning">Désactiver</button>
        </form>
    </div>
    {% endif %}

    {% if year_override_type is defined and year_override_type == 'session' %}
    <div class="alert alert-warning d-flex align-items-center gap-2 rounded-0 mb-0 border-start-0 border-end-0" role="alert">
        <i class="bi bi-clock-history"></i>
        <span>Vous visualisez le site en {{ effective_scout_year }} (session uniquement).</span>
        <form method="post" action="/admin/scout-year/clear-preview" class="ms-auto">
            {{ csrf_field()|raw }}
            <button type="submit" class="btn-close" aria-label="Revenir à l'année courante"></button>
        </form>
    </div>
    {% elseif year_override_type is defined and year_override_type == 'staff' %}
    <div class="alert alert-info d-flex align-items-center gap-2 rounded-0 mb-0 border-start-0 border-end-0" role="alert">
        <i class="bi bi-info-circle"></i>
        <span>Le staff voit actuellement l'année {{ effective_scout_year }}.</span>
    </div>
    {% endif %}

    <main class="container py-3">
        {% set flash = get_flash() %}
        {% if flash %}
        <div class="alert alert-{{ flash.type == 'error' ? 'danger' : flash.type }} alert-dismissible fade show" role="alert">
            {{ flash.message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
        </div>
        {% endif %}
        {% block content %}{% endblock %}
    </main>

    {% block footer %}
    <footer class="border-top py-3 mt-4">
        <div class="container d-flex flex-wrap justify-content-between align-items-center small text-body-secondary">
            <span class="d-flex align-items-center gap-2">
                {# Same logo as the favicon/PWA icons (Core\Photo\
                   UnitLogoService) — nothing rendered when neither an
                   upload nor a shipped default resolves, rather than a
                   broken image (same "nothing if absent" principle as
                   section_photo(), ARCHITECTURE §8.10). alt="" is
                   deliberate: decorative, the unit name text sits right
                   next to it, so a redundant alt would just be screen-
                   reader noise. #}
                {% if unit_logo_available|default(false) %}
                <img src="/pwa/icon-64.png?v={{ pwa_icon_version|default(1) }}" alt="" width="24" height="24">
                {% endif %}
                {{ site_name }}
            </span>
            <div class="d-flex gap-3">
                <a href="/rgpd" class="text-body-secondary text-decoration-none">Protection des données</a>
                <a href="/cookies" class="text-body-secondary text-decoration-none">Préférences cookies</a>
                <a href="https://github.com/xdubois-57/scoutmagic" class="text-body-secondary text-decoration-none" target="_blank" rel="noopener">GitHub</a>
            </div>
        </div>
    </footer>
    {% endblock %}

    <script src="/assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="/assets/js/nav.js"></script>
    {# partials/breadcrumb_bar.html.twig's parent buttons — opens the
       matching menu section rather than navigating. Loads unconditionally
       like nav.js above: the breadcrumb bar itself is CSS-hidden except in
       installed-PWA mode, but costs nothing to include either way. #}
    <script src="/assets/js/breadcrumb.js"></script>
    {# partials/chip_picker.html.twig's JS — truncation + mode:multi
       toggling. Loads unconditionally: the public calendar page
       (role_min: public) uses a chip picker too, not just
       identified-only pages. #}
    <script src="/assets/js/chip-picker.js" defer></script>
    {% if config_mode is defined and config_mode %}
    {% include 'partials/rich_text_editor.html.twig' %}
    {% endif %}
    {# editable.js wires up both .editable-content (rich text — needs the
       modal above, only rendered in configuration mode) and .editable-image
       (needs no modal at all — a plain navigation to /upload). The member
       page uses .editable-image outside configuration mode (member_photo()'s
       $editable flag lets a member replace their own photo), so this script
       must load unconditionally; editable.js itself gates its modal-
       dependent code on the modal's presence. #}
    <script src="/assets/js/editable.js" defer></script>
    <script src="/assets/js/cookie-consent.js" defer></script>
    {% if is_authenticated %}
    <script src="/assets/js/notification-badge.js" defer></script>
    {% endif %}
    {# Installable PWA (Lot 1) — appVersion (Core\Maintenance\VersionFile)
       is the entire update mechanism: the query string changes on every
       release, so the browser treats /sw.js as a new script and installs
       it, purging every stale app-shell cache (see public/sw.js's own
       activate handler). updateViaCache: 'none' additionally stops the
       browser from serving the WORKER SCRIPT ITSELF from its own HTTP
       cache — without it, a changed ?v= alone can still resolve to a
       byte-identical cached sw.js response on some browsers.

       `iv` (pwa_icon_version, Core\Photo\UnitLogoService) rides the same
       query string, same mechanism, entirely independent of `v` — a logo
       upload bumps pwa_icon_version without touching app_version at all,
       and public/sw.js folds both into its precache's cache name so an
       icon-only change still purges/re-precaches the icons instead of
       silently keeping the stale ones (see that file's own comments). #}
    <script nonce="{{ csp_nonce }}">
    if ('serviceWorker' in navigator) {
        window.addEventListener('load', function () {
            navigator.serviceWorker.register('/sw.js?v={{ app_version|default('0.0.0') }}&iv={{ pwa_icon_version|default(1) }}', { updateViaCache: 'none' });
        });
    }
    </script>
    {# Offline content caching (Lot 3/4) — the single server-side source of
       truth (Core\Offline\OfflineWhitelist + the offline_cache_staleness_days
       setting), handed to both public/assets/js/offline-cache.js (which
       relays it to the service worker via postMessage — see public/sw.js's
       own 'message' handler, never hardcoded there) and offline-nav.js
       (greys out unavailable links while offline, opens the unavailability
       dialog below). type="application/json" so this never executes and
       needs no CSP nonce. Rendered unconditionally — public pages are
       cacheable for a logged-out visitor too (offline_account_scope is
       'guest' in that case). #}
    <script type="application/json" id="offline-config-data">{{ {
        stalenessDays: offline_cache_staleness_days|default(30),
        consent: offline_functional_consent|default(false),
        whitelist: offline_whitelist|default([]),
        accountScope: offline_account_scope|default('guest'),
        version: app_version|default('0.0.0')
    }|json_encode|raw }}</script>
    <script src="/assets/js/offline-cache.js" defer></script>
    <script src="/assets/js/offline-nav.js" defer></script>
    <script src="/assets/js/offline-prefetch.js" defer></script>
    {# Generic "unavailable offline" dialog (Lot 4, offline-nav.js) — one
       modal for the whole site, no per-page wiring: a click on a
       non-whitelisted link, any form submission, or any non-GET fetch()
       call opens this with the matching French message, while leaving
       the underlying page (and any filled-in form fields) untouched.
       Dismissing it is the only way out — never a navigation. #}
    <div class="modal fade" id="offline-dialog" tabindex="-1" aria-labelledby="offline-dialog-label" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="offline-dialog-label"><i class="bi bi-wifi-off"></i> Hors ligne</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
                </div>
                <div class="modal-body">
                    <p id="offline-dialog-message" class="mb-0"></p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Compris</button>
                </div>
            </div>
        </div>
    </div>
    {% block scripts %}{% endblock %}

    {% if cookie_consent_given is defined and not cookie_consent_given %}
        {% include 'partials/cookie_banner.html.twig' %}
    {% endif %}
</body>
</html>
