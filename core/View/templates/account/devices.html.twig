{% extends 'base.html.twig' %}
{% block title %}Synchroniser mes contacts — Mon compte — {{ param('site_name') }}{% endblock %}

{% block content %}
{% include 'partials/page_header.html.twig' with {
    title: 'Synchroniser mes contacts',
    subtitle: 'Retrouvez les contacts des animateurs et du Staff d\'U dans le carnet d\'adresses de votre téléphone ou de votre ordinateur.',
} only %}

<div class="page-narrow">
    {% if not sync_enabled %}
        <output class="alert alert-warning d-flex align-items-start gap-2">
            <i class="bi bi-plug flex-shrink-0" aria-hidden="true"></i>
            <div>
                La synchronisation est <strong>coupée pour tout le site</strong>. Vos accès
                restent valides, mais aucun appareil ne peut se synchroniser tant qu'un
                superadministrateur ne l'a pas réactivée.
            </div>
        </output>
    {% endif %}

    {# The unpleasant truth, said before the button and not after it. #}
    <div class="card mb-3">
        <div class="card-body">
            <h2 class="h5 mb-3">Ce que cela veut dire</h2>
            <p class="small text-body-secondary mb-2">
                Un appareil autorisé recopie le carnet d'adresses des animateurs et du Staff d'U
                dans votre téléphone ou votre ordinateur. Cette copie vous appartient : elle suit
                les sauvegardes de l'appareil, elle part avec lui, et
                <strong>la révoquer ici n'efface rien de ce qui est déjà descendu</strong> — cela
                arrête seulement les synchronisations suivantes.
            </p>
            <p class="small text-body-secondary mb-0">
                Votre identifiant d'appareil suit votre rôle : si vous quittez le Staff d'unité, la
                synchronisation s'arrête d'elle-même, sans attendre que quiconque y pense.
            </p>
        </div>
    </div>

    {# What to type into a phone, and the one button that answers « est-ce
       que cet hébergeur laisse passer la synchronisation ? » — a question
       nobody can answer from the other end, where the only symptom is a
       client that says « impossible de se connecter ». #}
    <div class="card mb-3">
        <div class="card-body">
            <h2 class="h5 mb-3">Adresse à donner à votre carnet d'adresses</h2>
            <dl class="row small mb-3">
                <dt class="col-sm-4">Type de compte</dt>
                <dd class="col-sm-8">CardDAV</dd>
                <dt class="col-sm-4">Serveur</dt>
                <dd class="col-sm-8"><code class="user-select-all">{{ site_url }}{{ carddav_collection_path }}</code></dd>
                <dt class="col-sm-4">Nom d'utilisateur</dt>
                <dd class="col-sm-8"><code class="user-select-all">{{ account_email }}</code></dd>
                <dt class="col-sm-4">Mot de passe</dt>
                <dd class="col-sm-8">celui affiché une seule fois à la création de l'accès</dd>
            </dl>
            <p class="small text-body-secondary mb-3">
                Sur iPhone : <strong>Réglages → Contacts → Comptes → Ajouter un compte → Autre →
                Ajouter un compte CardDAV</strong>, et collez cette adresse complète dans le champ
                <strong>Serveur</strong>.
            </p>
            <p class="small text-body-secondary mb-3">
                Certaines applications acceptent le domaine seul,
                <code class="user-select-all">{{ site_url }}</code> : elles cherchent alors
                <code>/.well-known/carddav</code>, que <strong>certains hébergements bloquent avant
                même que le site ne réponde</strong>. L'adresse complète évite ce détour, et c'est
                pourquoi c'est elle qui est donnée ci-dessus.
            </p>
            <p class="small text-body-secondary mb-3">
                Le carnet est en <strong>lecture seule</strong> : les modifications faites sur
                l'appareil ne remontent jamais, et seront écrasées à la synchronisation suivante.
            </p>

            <div id="carddav-probe-section">
                <button type="button" class="btn btn-outline-secondary btn-sm" id="carddav-probe-btn">
                    <i class="bi bi-activity" aria-hidden="true"></i>
                    Vérifier que cet hébergement laisse passer la synchronisation
                </button>
                <output id="carddav-probe-result" class="d-block small mt-2"></output>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-body">
            <h2 class="h5 mb-3">Mes accès</h2>

            <div id="device-error" class="alert alert-danger d-none" role="alert"></div>

            {# Filled once, by public/assets/js/device-credentials.js, with
               the only cleartext copy of the secret there will ever be. #}
            <div id="device-secret-panel" class="alert alert-success d-none">
                <p class="mb-2 fw-semibold">
                    <i class="bi bi-check2-circle" aria-hidden="true"></i>
                    Accès créé. Copiez ces informations maintenant.
                </p>
                <p class="small mb-2">
                    Le mot de passe ne sera <strong>plus jamais affiché</strong>. Si vous le perdez,
                    révoquez cet accès et créez-en un autre.
                </p>
                {# The three values a phone asks for, together. The server
                   address used to be further up the page only, so the one
                   screen where somebody is configuring their phone gave
                   them two of the three and left them to scroll for the
                   third (#483). #}
                <dl class="row small mb-0">
                    <dt class="col-sm-4">Serveur</dt>
                    <dd class="col-sm-8">
                        <code class="user-select-all">{{ site_url }}{{ carddav_collection_path }}</code>
                    </dd>
                    <dt class="col-sm-4">Nom d'utilisateur</dt>
                    <dd class="col-sm-8"><code class="user-select-all">{{ account_email }}</code></dd>
                    <dt class="col-sm-4">Mot de passe</dt>
                    <dd class="col-sm-8"><code id="device-secret-value" class="user-select-all"></code></dd>
                </dl>
            </div>

            <div id="device-list">
                {% for credential in credentials %}
                    <div class="d-flex align-items-center justify-content-between border rounded p-2 mb-2">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-phone text-body-secondary" aria-hidden="true"></i>
                            <div>
                                <span class="small">{{ credential.label }}</span>
                                <span class="text-body-secondary d-block" style="font-size:0.75rem;">
                                    {% if credential.isRevoked %}
                                        Révoqué le {{ credential.revokedAt|date_fr }}
                                    {% elseif credential.hasNeverSynchronised %}
                                        Créé le {{ credential.createdAt|date_fr }} — jamais synchronisé
                                    {% else %}
                                        Dernière synchronisation : {{ credential.lastSyncAt|date_fr }}
                                    {% endif %}
                                </span>
                            </div>
                        </div>
                        {% if not credential.isRevoked %}
                            <form method="post" action="/account/devices/{{ credential.id }}/revoke"
                                  data-confirm="Révoquer « {{ credential.label }} » ? Il ne pourra plus se synchroniser, et la copie déjà descendue restera sur l'appareil.">
                                {{ csrf_field()|raw }}
                                <button type="submit" class="btn btn-sm btn-outline-danger"
                                        aria-label="Révoquer {{ credential.label }}">
                                    <i class="bi bi-trash" aria-hidden="true"></i> Révoquer
                                </button>
                            </form>
                        {% endif %}
                    </div>
                {% else %}
                    {% include 'partials/empty_state.html.twig' with {
                        message: 'Aucun accès créé.',
                        compact: true,
                    } only %}
                {% endfor %}
            </div>

            {% if can_create %}
                <div class="mt-3" id="device-add-section" data-csrf="{{ csrf_token() }}">
                    <label class="form-label small" for="device-label">Nom de cet accès</label>
                    <input type="text" id="device-label" class="form-control form-control-sm mb-2"
                           placeholder="ex. Téléphone de la chef d'unité" maxlength="{{ max_label_length|default(100) }}">
                    <button type="button" class="btn btn-outline-primary w-100 w-sm-auto" id="device-add-btn">
                        <i class="bi bi-plus-lg" aria-hidden="true"></i> Créer un accès
                    </button>
                </div>
            {% else %}
                <p class="small text-body-secondary mt-3 mb-0">
                    Vous avez atteint la limite de {{ max_per_account }} accès. Révoquez-en un
                    pour pouvoir en créer un autre.
                </p>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script src="{{ asset('/assets/js/device-credentials.js') }}" defer></script>
<script src="{{ asset('/assets/js/carddav-probe.js') }}" defer></script>
{% endblock %}
