{% extends 'base.html.twig' %}
{% block title %}Mon compte — {{ site_name }}{% endblock %}
{% block content %}
<div class="page-narrow">
    <h1>Mon compte</h1>
    <p class="text-body-secondary mb-4">{{ current_user_email }}</p>

    {#
      The photo of this LOGIN — the shared avatar (person_avatar(),
      Core\View\PersonAvatar), the same component that draws this person
      in the header, in the menu and beside their messages. `editable`
      only offers the overlay; Core\Http\Controller\UploadController
      re-checks that the account being changed is the caller's own.
    #}
    <div class="card mb-3">
        <div class="card-body d-flex align-items-center gap-3 flex-wrap">
            {{ person_avatar(
                (account.firstName ~ ' ' ~ account.lastName)|trim ?: (current_user_display_name|default('')),
                { account_id: account.id, size: 96, editable: true }
            ) }}
            <div class="flex-grow-1" style="min-width:200px;">
                <h2 class="h5 mb-1">Photo</h2>
                <p class="text-body-secondary small mb-2">
                    Elle vous représente partout sur le site : dans le menu, en haut de l'écran et à côté
                    de vos messages dans les groupes. Sans photo, ce sont vos initiales qui s'affichent.
                </p>
                {% if has_account_photo|default(false) %}
                    <form method="post" action="/account/photo/delete" class="m-0"
                          data-confirm="Retirer votre photo ? Vos initiales seront affichées à la place.">
                        {{ csrf_field() }}
                        <button type="submit" class="btn btn-sm btn-outline-secondary" style="min-height:44px;">
                            Retirer la photo
                        </button>
                    </form>
                {% endif %}
            </div>
        </div>
    </div>

    {# Profile section #}
    <div class="card mb-3">
        <div class="card-body">
            <h2 class="h5 mb-3">Profil</h2>
            <form method="post" action="/account/profile">
                {{ csrf_field() }}
                <div class="row g-3 mb-3">
                    <div class="col-12 col-sm-6">
                        <label class="form-label" for="account-first-name">Prénom</label>
                        <input type="text" name="first_name" id="account-first-name" class="form-control"
                               value="{{ account.firstName }}">
                    </div>
                    <div class="col-12 col-sm-6">
                        <label class="form-label" for="account-last-name">Nom</label>
                        <input type="text" name="last_name" id="account-last-name" class="form-control"
                               value="{{ account.lastName }}">
                    </div>
                </div>
                <button type="submit" class="btn btn-primary">Enregistrer</button>
            </form>
        </div>
    </div>

    {# Password section #}
    <div class="card mb-3">
        <div class="card-body">
            <h2 class="h5 mb-3">Mot de passe</h2>
            {% if has_password %}
                <p class="text-body-secondary small mb-1">
                    Mot de passe configuré. Vous pouvez le changer ci-dessous.
                </p>
                {% if password_changed_at %}
                    <p class="text-body-secondary small mb-3">
                        Dernière modification : {{ password_changed_at|date('d/m/Y à H:i') }}
                    </p>
                {% endif %}
                <form method="post" action="/account/password" id="account-password-form">
                    {{ csrf_field() }}
                    <div class="mb-3">
                        <label class="form-label" for="account-current-password">Mot de passe actuel</label>
                        <input type="password" name="current_password" id="account-current-password" class="form-control" required autocomplete="current-password">
                    </div>
                    {% include 'partials/password_field.html.twig' with {
                        field_id: 'account-new-password',
                        field_name: 'new_password',
                        label: 'Nouveau mot de passe',
                        confirm_name: 'confirm_password',
                        confirm_label: 'Confirmer le nouveau mot de passe',
                    } %}
                    <button type="submit" class="btn btn-primary">Changer le mot de passe</button>
                </form>
            {% else %}
                <p class="text-body-secondary small mb-3">
                    Non configuré — le lien magique reste utilisable pour se connecter.
                </p>
                <form method="post" action="/account/password" id="account-password-form">
                    {{ csrf_field() }}
                    {% include 'partials/password_field.html.twig' with {
                        field_id: 'account-new-password',
                        field_name: 'new_password',
                        label: 'Nouveau mot de passe',
                        confirm_name: 'confirm_password',
                    } %}
                    <button type="submit" class="btn btn-primary">Définir un mot de passe</button>
                </form>
            {% endif %}
        </div>
    </div>

    {# Passkey section #}
    <div class="card mb-3">
        <div class="card-body">
            <h2 class="h5 mb-3">Clés numériques</h2>

            <div id="passkey-list">
                {% for key in passkeys %}
                    <div class="d-flex align-items-center justify-content-between border rounded p-2 mb-2"
                         data-passkey-id="{{ key.id }}">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-fingerprint text-body-secondary"></i>
                            <div>
                                <span class="small">{{ key.device_label ?? 'Clé sans nom' }}</span>
                                {% if key.last_used_at %}
                                    <span class="text-body-secondary d-block"
                                          style="font-size:0.75rem;">
                                        Dernière utilisation :
                                        {{ key.last_used_at|date('d/m/Y') }}
                                    </span>
                                {% endif %}
                            </div>
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-danger passkey-delete-btn"
                                data-id="{{ key.id }}" title="Supprimer">
                            <i class="bi bi-trash"></i>
                        </button>
                    </div>
                {% else %}
                    <p class="text-body-secondary small" id="no-passkeys-msg">
                        Aucune clé enregistrée.
                    </p>
                {% endfor %}
            </div>

            <div id="passkey-add-section">
                <div class="mb-2" id="passkey-label-input" style="display:none;">
                    <label class="form-label small" for="passkey-device-label">Nom de cette clé</label>
                    <input type="text" id="passkey-device-label" class="form-control form-control-sm"
                           placeholder="ex. iPhone de Jean" maxlength="100">
                </div>
                <button type="button" class="btn btn-outline-primary w-100" id="passkey-add-btn">
                    <i class="bi bi-plus"></i> Ajouter une clé
                </button>
            </div>

            <div id="passkey-unsupported-notice" class="text-warning small mt-2 d-none">
                Votre navigateur ne supporte pas les clés numériques.
            </div>
        </div>
    </div>

    {# Push notifications section #}
    <div class="card mb-3">
        <div class="card-body">
            <h2 class="h5 mb-3">Notifications</h2>
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" role="switch" id="push-toggle" aria-checked="false"
                       data-vapid-public-key="{{ vapid_public_key }}">
                <label class="form-check-label" for="push-toggle">Notifications push</label>
            </div>
            <p class="text-body-secondary small mb-0 mt-1">
                Recevoir une notification quand une tâche en arrière-plan est terminée.
            </p>
            <p class="text-body-secondary small mb-0">
                Activer cette option demandera la permission de votre navigateur.
            </p>
            <p class="text-warning small mb-0 mt-2 d-none" id="push-denied-notice">
                Votre navigateur a refusé les notifications. Vous pouvez modifier ce choix dans les paramètres de votre navigateur.
            </p>
            <p class="text-warning small mb-0 mt-2 d-none" id="push-unsupported-notice">
                Votre navigateur ne supporte pas les notifications push.
            </p>
            <p class="text-danger small mb-0 mt-2 d-none" id="push-error-notice">
                Une erreur est survenue. Veuillez réessayer.
            </p>
        </div>
    </div>

    {# Cookie preferences link #}
    <div class="card mb-3">
        <div class="card-body">
            <h2 class="h5 mb-3">Préférences cookies</h2>
            <p class="text-body-secondary small mb-3">
                Gérez vos préférences concernant les cookies utilisés par le site.
            </p>
            <a href="/cookies" class="btn btn-outline-secondary">Modifier les préférences cookies</a>
        </div>
    </div>

</div>
{% endblock %}

{% block scripts %}
<script src="/assets/js/push-notifications.js" defer nonce="{{ csp_nonce }}"></script>
{% if has_password is defined %}
{# The checklist and the confirmation check come with the field itself
   (partials/password_field.html.twig) — this page writes none of it. #}
<script type="module" src="/assets/js/password-field.js"></script>
{% endif %}
<script nonce="{{ csp_nonce }}">
(function() {
    function getCsrf() {
        var el = document.querySelector('input[name="_csrf_token"]');
        return el ? el.value : '';
    }

    function base64ToBuffer(b64) {
        var bin = atob(b64.replace(/-/g, '+').replace(/_/g, '/'));
        return Uint8Array.from(bin, function(c) { return c.charCodeAt(0); }).buffer;
    }
    function bufferToBase64(buf) {
        return btoa(String.fromCharCode.apply(null, new Uint8Array(buf)))
            .replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
    }

    // Check WebAuthn support
    if (!window.PublicKeyCredential) {
        document.getElementById('passkey-add-btn').disabled = true;
        document.getElementById('passkey-unsupported-notice').classList.remove('d-none');
    }

    // Add passkey flow
    var addBtn = document.getElementById('passkey-add-btn');
    if (addBtn) {
        addBtn.addEventListener('click', async function() {
            var labelInput = document.getElementById('passkey-label-input');
            if (labelInput.style.display === 'none') {
                labelInput.style.display = 'block';
                document.getElementById('passkey-device-label').focus();
                return;
            }

            var deviceLabel = document.getElementById('passkey-device-label').value || 'Clé sans nom';

            try {
                var optRes = await fetch('/account/passkey/register-options');
                var options = await optRes.json();

                options.challenge = base64ToBuffer(options.challenge);
                options.user.id = base64ToBuffer(options.user.id);
                if (options.excludeCredentials) {
                    options.excludeCredentials = options.excludeCredentials.map(function(c) {
                        return Object.assign({}, c, { id: base64ToBuffer(c.id) });
                    });
                }

                var credential = await navigator.credentials.create({ publicKey: options });

                var verifyRes = await fetch('/account/passkey/register', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': getCsrf() },
                    body: JSON.stringify({
                        id: credential.id,
                        rawId: bufferToBase64(credential.rawId),
                        response: {
                            attestationObject: bufferToBase64(credential.response.attestationObject),
                            clientDataJSON: bufferToBase64(credential.response.clientDataJSON)
                        },
                        type: credential.type,
                        device_label: deviceLabel
                    })
                });
                var result = await verifyRes.json();

                if (result.success) {
                    window.location.reload();
                } else {
                    alert(result.error || 'L\'enregistrement a échoué.');
                }
            } catch (err) {
                if (err && err.name === 'InvalidStateError') {
                    // The platform authenticator already holds a key for this account
                    // on this device (excludeCredentials prevents a duplicate).
                    alert('Cet appareil possède déjà une clé enregistrée pour ce compte.');
                } else if (err && err.name === 'NotAllowedError') {
                    alert('L\'enregistrement a été annulé.');
                } else {
                    alert('L\'enregistrement a échoué.');
                }
            }
        });
    }

    // Delete passkey
    document.querySelectorAll('.passkey-delete-btn').forEach(function(btn) {
        btn.addEventListener('click', async function() {
            if (!confirm('Supprimer cette clé ?')) return;
            var id = btn.dataset.id;
            var res = await fetch('/account/passkey/delete', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': getCsrf() },
                body: JSON.stringify({ id: parseInt(id) })
            });
            if (res.ok) {
                btn.closest('[data-passkey-id]').remove();
                if (document.querySelectorAll('[data-passkey-id]').length === 0) {
                    var msg = document.getElementById('no-passkeys-msg');
                    if (msg) msg.classList.remove('d-none');
                }
            }
        });
    });
})();
</script>
{% endblock %}
