{% extends "base.html.twig" %}

{% block title %}Réinitialiser le mot de passe — {{ site_name }}{% endblock %}

{% block content %}
<div class="page-narrow">
    {% include 'partials/page_header.html.twig' with { title: 'Réinitialiser le mot de passe' } only %}

    {# The token lives in the URL fragment, which the server never receives.
       Which of the three panels below is shown is therefore decided
       client-side, once the script has checked the fragment against
       /password-reset/{id}/check. #}
    <div class="card" id="reset-checking">
        <div class="card-body text-center py-4">
            <p class="mb-0 text-body-secondary">Vérification du lien…</p>
        </div>
    </div>

    <div class="card d-none" id="reset-invalid">
        <div class="card-body text-center py-4">
            <p class="text-danger mb-3">Ce lien de réinitialisation n'est plus valide (expiré, déjà utilisé, ou incorrect).</p>
            <a href="/login" class="btn btn-outline-secondary">Se connecter</a>
        </div>
    </div>

    <div class="card d-none" id="reset-panel">
        <div class="card-body">
            <form method="post" action="/password-reset/{{ reset_id }}" id="reset-form">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token }}">
                <input type="hidden" name="token" value="" id="reset-token">
                {% include 'partials/password_field.html.twig' with {
                    field_id: 'reset-new-password',
                    field_name: 'new_password',
                    label: 'Nouveau mot de passe',
                    confirm_name: 'confirm_password',
                    confirm_label: 'Confirmer le nouveau mot de passe',
                } %}
                <button type="submit" class="btn btn-primary w-100" id="reset-submit-btn">Réinitialiser le mot de passe</button>
            </form>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
{# The checklist and the confirmation check come with the field itself
   (partials/password_field.html.twig): this page only decides WHEN to reveal
   the form, never how the password is checked. #}
<script type="module" src="/assets/js/password-field.js"></script>
<script nonce="{{ csp_nonce }}">
(function () {
    var resetId = {{ reset_id }};
    var csrf = document.querySelector('#reset-form input[name="_csrf_token"]').value;

    // The fragment never left the browser — read it, then strip it from the
    // address bar so it doesn't linger in history or get shared by accident.
    var token = window.location.hash.replace(/^#/, '');
    try {
        token = decodeURIComponent(token);
    } catch (e) { /* not percent-encoded — use as-is */ }

    if (window.history && window.history.replaceState) {
        window.history.replaceState(null, '', window.location.pathname + window.location.search);
    }

    var checking = document.getElementById('reset-checking');
    var invalid = document.getElementById('reset-invalid');
    var panel = document.getElementById('reset-panel');

    function show(el) {
        checking.classList.add('d-none');
        invalid.classList.add('d-none');
        panel.classList.add('d-none');
        el.classList.remove('d-none');
    }

    function showForm() {
        document.getElementById('reset-token').value = token;
        show(panel);
    }

    if (!token) {
        show(invalid);
        return;
    }

    fetch('/password-reset/' + resetId + '/check', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: 'token=' + encodeURIComponent(token) + '&_csrf_token=' + encodeURIComponent(csrf)
    })
        .then(function (r) { return r.json(); })
        .then(function (data) {
            if (data && data.valid) {
                showForm();
            } else {
                show(invalid);
            }
        })
        .catch(function () { show(invalid); });
})();
</script>
{% endblock %}
