{# Mobile header bar — visible below lg #}
<header class="d-lg-none d-flex align-items-center px-3 border-bottom bg-white" style="height:56px;">
    <button class="btn btn-link text-dark p-2 me-auto d-inline-flex align-items-center justify-content-center" type="button" data-bs-toggle="offcanvas" data-bs-target="#navOffcanvas" style="min-width:44px;min-height:44px;">
        <i class="bi bi-list fs-3" aria-hidden="true"></i>
        <span class="visually-hidden">Menu</span>
    </button>
    <span class="fw-semibold text-truncate" style="min-width:0;">{{ site_name }}</span>
    {% if is_authenticated %}
    {% include 'partials/notification_dropdown.html.twig' %}
    {# Direct link to "Mon compte" — deliberately not the offcanvas, which
       is already reachable via the hamburger button. Public visitors keep
       this header exactly as before (no "Se connecter" added here — it
       stays in the offcanvas footer, unchanged). #}
    <a href="/account" class="text-decoration-none ms-1" title="Mon compte">
        {% include 'partials/account_avatar.html.twig' with {size: 36, font_size: '.8rem'} %}
        <span class="visually-hidden">Mon compte</span>
    </a>
    {% endif %}
</header>

{# Mobile offcanvas — slides from left #}
<div class="offcanvas offcanvas-start d-lg-none" tabindex="-1" id="navOffcanvas" aria-label="Navigation">
    <div class="offcanvas-header border-bottom">
        <h5 class="offcanvas-title">{{ site_name }}</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Fermer"></button>
    </div>
    <div class="offcanvas-body d-flex flex-column p-0">
        {% if is_authenticated %}
        <div class="d-flex align-items-center gap-2 p-3 border-bottom bg-light">
            {# Both the avatar and the name link to /account — a single
               "Mon compte" destination, never /notifications (see
               partials/notification_dropdown.html.twig for the separate
               notifications indicator, to the right of this row). #}
            <a href="/account" class="d-flex align-items-center gap-2 text-decoration-none text-body flex-grow-1">
                {% include 'partials/account_avatar.html.twig' with {size: 40, font_size: '.9rem'} %}
                <div>
                    <div class="fw-semibold small text-truncate" style="max-width:140px;">{{ current_user_display_name }}</div>
                    <div class="text-muted" style="font-size:.75rem;">
                        {{ current_user_role_label }}
                        {% if current_user_member_count > 0 %}
                            · {{ current_user_member_count }} membre{{ current_user_member_count > 1 ? 's' : '' }}
                        {% endif %}
                    </div>
                </div>
            </a>
            {% include 'partials/notification_dropdown.html.twig' %}
        </div>
        {% endif %}

        <div class="accordion accordion-flush flex-grow-1 overflow-auto" id="mobileMenuAccordion">
            {% for menu in menus %}
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button {% if not menu.id == active_menu_id %}collapsed{% endif %}" type="button" data-bs-toggle="collapse" data-bs-target="#mob-{{ menu.id }}" aria-expanded="{{ menu.id == active_menu_id ? 'true' : 'false' }}">
                        <i class="bi {{ menu.icon }} me-2"></i> {{ menu.label }}
                    </button>
                </h2>
                <div id="mob-{{ menu.id }}" class="accordion-collapse collapse {% if menu.id == active_menu_id %}show{% endif %}" data-bs-parent="#mobileMenuAccordion">
                    <div class="accordion-body p-0">
                        <ul class="list-group list-group-flush">
                            {% for page in menu.pages %}
                                {% if page.isDynamic %}
                                    {# No Bootstrap `active` class here: `.list-group-item.active` paints a
                                       solid --bs-primary background (not !important), while the `text-primary`
                                       below is a color utility and IS !important — together that's blue text
                                       on a blue background, invisible. Bold blue text on the plain list
                                       background is the highlight instead. #}
                                    <li class="list-group-item list-group-item-action border-0 ps-4" style="min-height:44px;">
                                        <a href="{{ page.url }}" class="d-flex align-items-center gap-2 text-decoration-none{% if current_path == page.url %} fw-semibold text-primary{% else %} text-dark{% endif %}"{{ current_path == page.url ? ' aria-current="page"' : '' }}>
                                            {#
                                              The member this entry is for, drawn by the shared
                                              component (person_avatar(), Core\View\PersonAvatar):
                                              their photo for the year in effect when one exists,
                                              their initials otherwise — the same circle the header
                                              draws for the person connected. The two-letters-of-a-
                                              label version this replaced was the look every other
                                              avatar on the site is now modelled on.
                                            #}
                                            {{ person_avatar(page.label, { member_id: page.avatarMemberId|default(0), size: 32 }) }}
                                            <div class="lh-sm">
                                                <span class="d-block small">{{ page.label }}</span>
                                                {% if page.subtitle %}
                                                    <span class="d-block text-body-secondary" style="font-size:0.75rem;">{{ page.subtitle }}</span>
                                                {% endif %}
                                            </div>
                                        </a>
                                    </li>
                                {% else %}
                                    {# Same reasoning as the dynamic-entry branch above: no Bootstrap
                                       `active` class, since it would paint the same blue background that
                                       the (!important) text-primary color below turns invisible against. #}
                                    <li class="list-group-item list-group-item-action border-0 ps-4 d-flex align-items-center" style="min-height:44px;">
                                        {#
                                          An icon in the same 32px box a member entry's avatar
                                          occupies, so every label in a menu starts at the same
                                          x — a list where the member pages are indented and
                                          everything else is not reads as two lists.
                                          `page.icon` is what the entry declared
                                          (Core\View\MenuBuilder::addPage(), module.json's
                                          `menu_icon`); the fallback keeps the alignment for an
                                          entry that declared none rather than leaving a hole.
                                        #}
                                        <a href="{{ page.url }}" class="d-flex align-items-center gap-2 text-decoration-none{% if active_page_url|default('') == page.url %} fw-semibold text-primary{% else %} text-dark{% endif %}"{{ active_page_url|default('') == page.url ? ' aria-current="page"' : '' }}>
                                            <span class="d-inline-flex align-items-center justify-content-center text-body-secondary"
                                                  style="width:32px;min-width:32px;" aria-hidden="true">
                                                <i class="bi {{ page.icon|default('') ?: 'bi-dot' }}"></i>
                                            </span>
                                            <span>{{ page.label }}</span>
                                        </a>
                                    </li>
                                {% endif %}
                            {% endfor %}
                        </ul>
                    </div>
                </div>
            </div>
            {% endfor %}
        </div>

        <div class="p-3 border-top mt-auto">
            {% if is_authenticated %}
            <form method="post" action="/logout">
                {{ csrf_field()|raw }}
                <button type="submit" class="btn btn-outline-secondary btn-sm w-100">Se déconnecter</button>
            </form>
            {% else %}
            <a href="/login" class="btn btn-primary btn-sm w-100">Se connecter</a>
            {% endif %}
        </div>
    </div>
</div>

{# Desktop navigation — visible at lg and above #}
<nav class="d-none d-lg-block border-bottom bg-white" id="desktopNav">
    <div class="container-fluid d-flex align-items-center px-3" style="height:56px;">
        <a href="/" class="text-decoration-none text-dark fw-semibold me-4">{{ site_name }}</a>

        <div class="d-flex align-items-center gap-1 flex-grow-1" id="desktopMenus">
            {% for menu in menus %}
            <button type="button"
                    class="btn btn-sm {% if menu.id == active_menu_id %}btn-primary{% else %}btn-outline-secondary{% endif %} desktop-menu-btn"
                    data-menu-id="{{ menu.id }}">
                <i class="bi {{ menu.icon }} me-1"></i>{{ menu.label }}
            </button>
            {% endfor %}
        </div>

        <div class="ms-auto">
            {% if is_authenticated %}
            <div class="d-flex align-items-center gap-2">
                {% include 'partials/notification_dropdown.html.twig' %}
                {# Avatar and name are a single /account link — never
                   /notifications, see partials/notification_dropdown.
                   html.twig for the separate indicator to its left. #}
                <a href="/account" class="d-flex align-items-center gap-2 text-decoration-none text-body">
                    {% include 'partials/account_avatar.html.twig' with {size: 32, font_size: '.8rem'} %}
                    <span class="small text-truncate" style="max-width:160px;">{{ current_user_display_name }}</span>
                    {% if current_user_member_count > 0 %}
                        <span class="text-muted" style="font-size:.75rem;">· {{ current_user_member_count }} membre{{ current_user_member_count > 1 ? 's' : '' }}</span>
                    {% endif %}
                </a>
                <form method="post" action="/logout" class="d-inline ms-2">
                    {{ csrf_field()|raw }}
                    <button type="submit" class="btn btn-outline-secondary btn-sm">Se déconnecter</button>
                </form>
            </div>
            {% else %}
            <a href="/login" class="btn btn-primary btn-sm">Se connecter</a>
            {% endif %}
        </div>
    </div>

    {# Sub-menu bars #}
    {% for menu in menus %}
    <div class="desktop-submenu border-top bg-light {% if menu.id != active_menu_id %}d-none{% endif %}" data-submenu-id="{{ menu.id }}">
        <div class="container-fluid px-3 py-2 d-flex flex-wrap gap-2">
            {% for page in menu.pages %}
                {% if page.isDynamic %}
                    {# Same component as the mobile entry above, smaller: one
                       definition of what a person looks like on this site. #}
                    <a href="{{ page.url }}"
                       class="btn btn-sm {% if current_path == page.url %}btn-primary{% else %}btn-outline-secondary{% endif %} d-flex align-items-center gap-1">
                        {{ person_avatar(page.label, { member_id: page.avatarMemberId|default(0), size: 20 }) }}
                        <span>{{ page.label }}</span>
                    </a>
                {% else %}
                    <a href="{{ page.url }}"
                       class="btn btn-sm {% if active_page_url|default('') == page.url %}btn-primary{% else %}btn-outline-secondary{% endif %}">
                        {{ page.label }}
                    </a>
                {% endif %}
            {% endfor %}
        </div>
    </div>
    {% endfor %}
</nav>
