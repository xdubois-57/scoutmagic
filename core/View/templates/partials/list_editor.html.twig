{#
  Generic, reusable list editor — add / drag-and-drop reorder / activate
  toggle / delete for any collection of configurable items (module.json
  banners today; a future module's FAQ entries, useful links, etc. can
  reuse this unchanged). Knows nothing about what an item "is" — the
  caller supplies each item's own content via the item_content block, and
  optionally an edit trigger (icon button) via the item_edit block (both
  Twig embed — see usage below), so this partial only owns the list
  chrome (drag handle, edit/active/delete icons in one row, add button)
  and the JS wiring (public/assets/js/list-editor.js) that persists
  ordering, activation, and deletion against caller-supplied endpoints.

  Usage:
  {% embed 'partials/list_editor.html.twig' with {
      list_id: 'banner-list',
      items: banners,
      add_url: '/config/banner/add',
      reorder_url: '/config/banner/reorder',
      active_url: '/config/banner/active',
      delete_url: '/config/banner/delete',
      add_label: 'Ajouter une bannière',
      empty_label: 'Aucune bannière configurée.'
  } %}
      {% block item_content %}
          // item is in scope here — this is what makes reuse possible
          {% include 'partials/rich_text_field.html.twig' with {
              content_key: 'banner_content_' ~ item.id,
              content_value: item.content
          } %}
      {% endblock %}
      {% block item_edit %}
          {% include 'partials/rich_text_edit_button.html.twig' with {
              content_key: 'banner_content_' ~ item.id,
              save_url: '/api/rich-text-content'
          } %}
      {% endblock %}
  {% endembed %}

  Each item array may optionally carry:
  - `can_delete` (bool, default true) and `delete_blocked_reason` (string)
    — when false, the delete button is disabled with that reason as its
    title, same "used elsewhere, deactivate instead" pattern already
    established for Badges/Functions deletions.

  item_edit is optional — leave it undeclared (or empty) for a list whose
  items need no separate edit affordance (e.g. content editable in place).

  Set add_mode: 'custom' to suppress this partial's own "Ajouter" wiring
  (a blind create + reload) — for a caller whose add flow needs to collect
  data first (e.g. opening the rich text dialog before an item exists at
  all, so nothing empty ever appears in the list); the caller then wires
  the `.list-editor-add-btn` itself, calling add_url however it needs to.

  active_url, delete_url and add_url are all optional — a caller that
  passes none of them (e.g. a reorder-only list, like the general
  configuration page's module list) gets pure drag/reorder chrome with
  no activate/delete/add affordances at all.
  Set sortable: false for a list whose order is not the manager's to
  choose (e.g. a register sorted by date): no drag handle, no move
  arrows, and the rows are not draggable. Omitted, a list stays sortable
  exactly as before.

  An item may also carry `delete_confirm` (string): the question asked
  before deleting it, in place of the generic one — when deleting has a
  consequence worth saying.

  Set in_place: true for a list that changes without reloading the page:
  the caller's `add_form` block (a form with the add fields, and its own
  submit button) replaces the "Ajouter" button, its fields are posted as
  JSON to add_url, and the server answers {success, html, message?} where
  `html` holds the new row — typically this same embed rendered with that
  one item — which is inserted at the end of the list. A deletion then
  removes its row instead of reloading. Lists that leave it out behave
  exactly as before.
#}
{# `default()` would turn an explicit false back into true — it treats
   false as empty — so the flag is read this way instead. #}
{% set is_sortable = sortable is not defined or sortable %}
<div class="list-editor" id="{{ list_id }}"
     data-reorder-url="{{ reorder_url }}"
     data-active-url="{{ active_url }}"
     data-delete-url="{{ delete_url }}"
     data-add-url="{{ add_url|default('') }}"
     data-add-mode="{{ add_mode|default('default') }}"
     data-empty-label="{{ empty_label|default('Aucun élément.') }}"
     {%- if not is_sortable %} data-sortable="false"{% endif %}
     {%- if in_place is defined and in_place %} data-in-place="true"{% endif %}
     {#- Opt-in connected lists (issue #752): lists sharing a
         `sortable_group` accept each other's items, and post their
         `group_key` with their order. Absent, the list is on its own. #}
     {%- if sortable_group is defined and sortable_group %}
     data-sortable-group="{{ sortable_group }}" data-group-key="{{ group_key|default('') }}"
     {%- endif %}>
    <div class="list-editor-items d-flex flex-column gap-2 mb-3">
        {% for item in items %}
            {% set can_delete = item.can_delete is not defined or item.can_delete %}
            {#
              `flex-wrap` is what lets the action block below drop under
              the item's own text on a phone rather than sharing its line:
              four controls wide (edit, visibility, activate, delete), it
              was leaving a couple of words per line to the text it acts
              on. The width that actually forces the wrap is in app.css —
              Bootstrap has no responsive width utility to say it here.
            #}
            <div class="list-editor-item border rounded-3 p-3 d-flex align-items-start gap-2 flex-wrap" draggable="{{ is_sortable ? 'true' : 'false' }}" data-id="{{ item.id }}"
                 {%- if item.delete_confirm is defined and item.delete_confirm %} data-delete-confirm="{{ item.delete_confirm }}"{% endif %}>
                {% if is_sortable %}
                <span class="list-editor-drag-handle text-body-secondary d-none d-lg-inline" title="Glisser pour réordonner" style="cursor:grab;">
                    <i class="bi bi-grip-vertical" aria-hidden="true"></i>
                </span>
                {# Touch reorder: move up/down buttons visible only on coarse pointer / below lg #}
                <span class="list-editor-move-btns d-lg-none d-inline-flex flex-column gap-0 flex-shrink-0">
                    <button type="button" class="btn btn-sm btn-link text-body-secondary p-0 list-editor-move-up" data-id="{{ item.id }}" aria-label="Monter"{% if loop.first %} disabled{% endif %}>
                        <i class="bi bi-chevron-up" aria-hidden="true"></i>
                    </button>
                    <button type="button" class="btn btn-sm btn-link text-body-secondary p-0 list-editor-move-down" data-id="{{ item.id }}" aria-label="Descendre"{% if loop.last %} disabled{% endif %}>
                        <i class="bi bi-chevron-down" aria-hidden="true"></i>
                    </button>
                </span>
                {% endif %}
                <div class="list-editor-item-content flex-grow-1">
                    {% block item_content %}{% endblock %}
                </div>
                <div class="list-editor-item-actions d-flex flex-row align-items-center gap-2 flex-shrink-0">
                    {% block item_edit %}{% endblock %}
                    {% if active_url is defined and active_url %}
                        <button type="button" class="btn btn-sm {{ item.is_active ? 'btn-outline-success' : 'btn-outline-secondary' }} list-editor-active-toggle"
                                data-id="{{ item.id }}" data-active="{{ item.is_active ? '1' : '0' }}"
                                aria-label="{{ item.is_active ? 'Actif — cliquer pour désactiver' : 'Inactif — cliquer pour activer' }}"
                                title="{{ item.is_active ? 'Actif — cliquer pour désactiver' : 'Inactif — cliquer pour activer' }}">
                            <i class="bi {{ item.is_active ? 'bi-toggle-on' : 'bi-toggle-off' }}" aria-hidden="true"></i>
                        </button>
                    {% endif %}
                    {% if delete_url is defined and delete_url %}
                        <button type="button" class="btn btn-sm btn-outline-danger list-editor-delete-btn" data-id="{{ item.id }}"
                                {{ can_delete ? '' : 'disabled' }}
                                aria-label="{{ can_delete ? 'Supprimer' : item.delete_blocked_reason|default('Suppression impossible.') }}"
                                title="{{ can_delete ? 'Supprimer' : item.delete_blocked_reason|default('Suppression impossible.') }}">
                            <i class="bi bi-trash" aria-hidden="true"></i>
                        </button>
                    {% endif %}
                </div>
            </div>
        {% endfor %}
        {# Always rendered, hidden while there are items: a connected list
           that is emptied by a drag must be able to say so, and one that
           receives a drop must be able to stop saying it. #}
        <p class="text-body-secondary fst-italic mb-0 list-editor-empty{{ items is empty ? '' : ' d-none' }}">{{ empty_label|default('Aucun élément.') }}</p>
    </div>
    {% if in_place is defined and in_place %}
        <div class="list-editor-add-form-slot">{% block add_form %}{% endblock %}</div>
    {% elseif add_url is defined and add_url %}
        <button type="button" class="btn btn-sm btn-primary list-editor-add-btn" data-url="{{ add_url }}">
            <i class="bi bi-plus-lg" aria-hidden="true"></i> {{ add_label|default('Ajouter') }}
        </button>
    {% endif %}
</div>
