{# The contextual help panel (ARCHITECTURE.md §8.64) — a Bootstrap
   offcanvas, bottom sheet on mobile and right-hand drawer at lg and up
   (.help-offcanvas in app.css; Bootstrap has no responsive placement of
   its own, same reason the chip picker's sheet carries custom CSS).
   Included by base.html.twig ONLY when route_help is non-empty, next to
   #offline-dialog.

   Every matched topic's content is rendered server-side into this
   markup — no fetch on open, so the panel works offline exactly like the
   page it ships inside. One topic → its content directly. Several (e.g.
   /config/maintenance: sauvegardes, mises à jour, réinitialisation) → a
   title+summary list first, public/assets/js/help-panel.js swaps the
   visible topic inside the same panel.

   data-* only, no inline handlers (CSP — design.md §7.5). #}
<div class="offcanvas offcanvas-bottom help-offcanvas" tabindex="-1" id="help-panel" aria-labelledby="help-panel-title">
    <div class="offcanvas-header border-bottom">
        <h5 class="offcanvas-title d-flex align-items-center gap-2" style="min-width:0;" id="help-panel-title">
            <i class="bi bi-question-circle" aria-hidden="true"></i>
            <span class="text-truncate">Aide{% if route_breadcrumb|default(null) %} · {{ breadcrumb_current|default(route_breadcrumb.label) }}{% endif %}</span>
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Fermer"></button>
    </div>
    <div class="offcanvas-body">
        {% if route_help|length > 1 %}
            {# The topic list — the panel's landing view when several
               topics cover this page. help-panel.js shows one topic on
               click and brings this list back via the « Tous les sujets
               de cette page » control below. #}
            <div data-help-list>
                <p class="small text-body-secondary">Plusieurs sujets concernent cette page :</p>
                <div class="list-group list-group-flush">
                    {% for entry in route_help %}
                        <button type="button" class="list-group-item list-group-item-action border-0 px-0 py-2 text-start"
                                data-help-open="{{ entry.id }}">
                            <span class="fw-semibold d-block">{{ entry.title }}</span>
                            <span class="small text-body-secondary">{{ entry.summary }}</span>
                        </button>
                    {% endfor %}
                </div>
            </div>
        {% endif %}

        {% for entry in route_help %}
            <article class="help-content rich-text{% if route_help|length > 1 %} d-none{% endif %}" data-help-topic="{{ entry.id }}">
                {% if route_help|length > 1 %}
                    <button type="button" class="btn btn-link btn-sm p-0 mb-2 text-decoration-none" data-help-back>
                        <i class="bi bi-arrow-left" aria-hidden="true"></i> Tous les sujets de cette page
                    </button>
                {% endif %}
                <h6 class="fw-semibold">{{ entry.title }}</h6>
                {{ entry.html|raw }}
            </article>
        {% endfor %}
    </div>
    <div class="offcanvas-footer border-top p-3 d-flex justify-content-between align-items-center gap-2">
        {# « Ouvrir dans l'aide » targets the visible topic — help-panel.js
           keeps the href in step when the visitor switches topics, and
           hides the link while the multi-topic list view is showing. #}
        <a href="/aide/{{ (route_help|first).id }}" class="small text-decoration-none{% if route_help|length > 1 %} invisible{% endif %}" data-help-open-full>
            Ouvrir dans l'aide
        </a>
        <a href="/aide" class="small text-decoration-none">Tous les sujets</a>
    </div>
</div>
