{% extends 'base.html.twig' %}
{% block title %}Télécharger un fichier — {{ site_name }}{% endblock %}

{% block content %}
<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
        {% include 'partials/page_header.html.twig' with { title: 'Télécharger un fichier' } only %}

        <form method="post" action="/upload" enctype="multipart/form-data" id="upload-form">
            {{ csrf_field()|raw }}
            <input type="hidden" name="context" value="{{ context }}">
            <input type="hidden" name="key" value="{{ key }}">
            <input type="hidden" name="return_url" value="{{ return_url }}">

            {# The shared drop zone with its own controls: this screen offers
               a picker AND a camera capture, so it renders the two inputs
               itself (each inside its <label class="btn">) rather than take
               the partial's single hidden one — and upload.js binds the zone
               with pickOnClick:false so a click does not open a third. #}
            {% embed 'partials/drop_zone.html.twig' with {
                id: 'drop-zone',
                size: 'lg',
                class_extra: 'mb-3',
            } only %}
                {% block message %}
                    <p class="mt-2 text-body">Glissez-déposez un fichier ici</p>
                    <p class="mb-0">ou</p>
                {% endblock %}
                {% block actions %}
                    <div class="d-flex flex-column flex-sm-row gap-2 justify-content-center mt-2">
                        <label class="btn btn-outline-primary">
                            Choisir un fichier
                            <input type="file" name="file" accept="image/*" class="d-none" id="file-input">
                        </label>
                        <label class="btn btn-outline-secondary">
                            <i class="bi bi-camera" aria-hidden="true"></i> Prendre une photo
                            <input type="file" name="file_camera" accept="image/*" capture="environment" class="d-none" id="camera-input">
                        </label>
                    </div>
                {% endblock %}
            {% endembed %}

            <div id="preview-container" class="mb-3 d-none text-center">
                <img id="preview-img" src="" alt="Aperçu" class="img-fluid rounded" style="max-height:300px;">
                <p class="small text-body-secondary mt-1" id="preview-name"></p>
            </div>

            <button type="submit" class="btn btn-primary w-100 w-sm-auto" id="upload-btn" disabled>
                <i class="bi bi-upload" aria-hidden="true"></i> Envoyer
            </button>
        </form>

        <a href="{{ return_url }}" class="btn btn-outline-secondary mt-2">Annuler</a>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script src="{{ asset('/assets/js/drop-zone.js') }}" defer></script>
<script src="{{ asset('/assets/js/upload.js') }}" defer></script>
{% endblock %}
