{% extends "base.html.twig" %}

{% block title %}Bienvenue — {{ site_name }}{% endblock %}

{% block content %}
    <div class="row g-4">
        <div class="col-12 col-lg-8">
            {% if banner_html is not empty %}
                <div class="alert alert-info mb-4">{{ banner_html|raw }}</div>
            {% endif %}

            {#
              "Something happened in your groups" — the one surface every
              visitor passes through, for the member the notification bell
              never reaches (no push permission granted, or simply never
              looked at it). Only ever non-zero for a signed-in member of
              a group with waiting activity: the provider
              (Core\Module\HomeGroupActivityProvider, implemented by
              Modules\Groups\Api\HomeActivityService) resolves the caller
              itself and returns zeros for anyone else, so no membership
              check belongs in this template.

              Deliberately the same one-line alert shape as the banner
              above rather than a card of its own: this is a nudge toward
              a conversation, not a second feed competing with the news
              column. It used to enumerate each group with its name and a
              relative timestamp, which made the page open on a block
              taller than the welcome text it was supposed to introduce.
              Naming no group also means it says nothing about who is
              talking to whom on a shared family screen — the counts are
              the whole message, and the group list one tap away carries
              the detail.
            #}
            {% set ga = groups_activity|default({'posts': 0, 'activity': 0, 'mentions': 0}) %}
            {% if ga.posts or ga.activity or ga.mentions %}
                {# One flowing sentence, link included, rather than flex items
                   with the link pushed to its own end: three flex children
                   wrap onto three lines on a phone, which is the height this
                   block exists to avoid. #}
                <div class="alert alert-info d-flex align-items-baseline gap-2 mb-4" role="status">
                    <i class="bi bi-chat-dots flex-shrink-0" aria-hidden="true"></i>
                    <span>
                        {%- set parts = [] -%}
                        {%- if ga.posts -%}
                            {%- set parts = parts|merge([ga.posts ~ ' nouveau' ~ (ga.posts > 1 ? 'x' : '') ~ ' message' ~ (ga.posts > 1 ? 's' : '')]) -%}
                        {%- endif -%}
                        {%- if ga.activity -%}
                            {%- set parts = parts|merge([ga.activity ~ ' réaction' ~ (ga.activity > 1 ? 's' : '') ~ ' ou réponse' ~ (ga.activity > 1 ? 's' : '')]) -%}
                        {%- endif -%}
                        {%- if ga.mentions -%}
                            {%- set parts = parts|merge([ga.mentions ~ ' mention' ~ (ga.mentions > 1 ? 's' : '')]) -%}
                        {%- endif -%}
                        Dans vos groupes : {{ parts|join(', ') }}.
                        <a href="/groups" class="alert-link text-nowrap">Voir mes groupes</a>
                    </span>
                </div>
            {% endif %}
            <div class="mb-4">
                {{ editable_image('home.hero', 'Photo d\'accueil', 'img-fluid rounded w-100') }}
            </div>
            {{ editable('home.intro', '<h1>Bienvenue</h1><p>Bienvenue sur le site de notre unité scoute.</p>') }}
        </div>

        {% if news_articles is not empty %}
            <div class="col-12 col-lg-4">
                <h2 class="h5 mb-3">Actualités</h2>
                <div class="d-flex flex-column gap-3">
                    {% for article in news_articles %}
                        <div class="card">
                            <div class="card-body d-flex gap-2">
                                {% if article.image_url %}
                                    <img src="{{ article.image_url }}" alt="" class="rounded flex-shrink-0" style="width:56px;height:56px;object-fit:cover;">
                                {% endif %}
                                <div class="flex-grow-1" style="min-width:0;">
                                    <h3 class="h6 mb-1">
                                        <a href="/news/{{ article.id }}" class="text-decoration-none stretched-link">{{ article.title }}</a>
                                    </h3>
                                    {% if article.summary %}<p class="small text-body-secondary mb-0 text-truncate">{{ article.summary }}</p>{% endif %}
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
                <a href="/news" class="btn btn-sm btn-outline-secondary mt-2 w-100">Toutes les actualités</a>
            </div>
        {% endif %}
    </div>
{% endblock %}
