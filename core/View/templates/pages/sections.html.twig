{% extends "base.html.twig" %}

{% block title %}Sections — {{ site_name }}{% endblock %}

{% block content %}
    {% include 'partials/page_header.html.twig' with { title: 'Sections' } only %}
        {{ editable('sections.intro', '<p>Voici les sections de notre unité.</p>') }}

        {% if section_groups is empty %}
        {% include 'partials/empty_state.html.twig' with {
            message: 'Aucune section pour le moment. Les sections apparaîtront ici après le premier import depuis Desk.',
            icon: 'bi-flag',
        } only %}
        {% else %}
            {% for group in section_groups %}
            <h3 class="mt-4 mb-3">{{ group.branch_label }}</h3>
            <div class="row g-3">
                {% for section in group.sections %}
                <div class="col-12 col-sm-6 col-md-4">
                    <div class="card h-100">
                        {{ section_photo(section.id, section.name ?? section.desk_code, 'w-100 card-img-top') }}
                        <div class="card-body">
                            <h5 class="card-title"><i class="bi bi-flag-fill" aria-hidden="true"></i> {{ section.name ?? section.desk_code }}</h5>
                            {#
                              Two namings of the same person, and which one a
                              visitor gets is an RGPD line rather than a taste.

                              This page is role_min 'public' (public/index.php).
                              The RGPD notice says the designated responsable's
                              FULL NAME « n'est jamais publique » — it is shown on
                              a member's own page, to the accounts linked to that
                              member. So an anonymous visitor keeps the totem
                              alone, exactly as before, and the surname never
                              leaves the site to a search engine.

                              A signed-in member gets display_name_full, « Totem
                              (Prénom Nom) » — the filter the member page already
                              uses for this same field — because a bare totem
                              names nobody: a parent looking up who runs their
                              child's section has never heard it (issue #359).

                              The icon is for everyone: it matches the e-mail line
                              just below, which was the only other fact on this
                              card that had one.
                            #}
                            {% if section.responsable %}
                            <p class="card-text small mb-1"><i class="bi bi-person" aria-hidden="true"></i> {{ is_authenticated ? section.responsable|display_name_full : section.responsable|display_name|normalize_name }}</p>
                            {% endif %}
                            {% if section.email %}
                            <p class="card-text small"><i class="bi bi-envelope" aria-hidden="true"></i> <a href="mailto:{{ section.email }}">{{ section.email }}</a></p>
                            {% endif %}
                            <div class="small">
                                {{ editable('section.' ~ section.desk_code ~ '.text', '') }}
                            </div>
                        </div>
                    </div>
                </div>
                {% endfor %}
            </div>
            {% endfor %}
        {% endif %}
{% endblock %}
