{% extends "base.html.twig" %}

{% block title %}Galerie photos et vidéos — {{ site_name }}{% endblock %}

{% block content %}
    {% include 'partials/page_header.html.twig' with { title: 'Galerie photos et vidéos' } only %}

    {% if submit_error %}
        <div class="alert alert-danger">{{ submit_error }}</div>
    {% endif %}

    {% if not ffmpeg_available %}
        <div class="alert alert-warning">
            <strong>FFmpeg n'est pas disponible sur ce serveur.</strong>
            L'envoi de vidéos est désactivé tant que ce binaire système optionnel n'est pas installé
            (le traitement des photos fonctionne normalement, indépendamment de FFmpeg).
        </div>
    {% endif %}

    {#
      Four tabs, one route, one query parameter. They are four views of one
      configuration — same controller, same context — which is exactly the
      case partials/page_picker.html.twig documents for a synthetic path.

      Each tab posts back to its own `onglet`, and the controller writes
      that tab's keys and no others. That is not tidiness: an unchecked
      checkbox submits NOTHING, so a page writing every boolean it knows
      about on every save would quietly switch off « autoriser les vidéos »
      each time somebody edited the photo limits.
    #}
    {% set _pages = [] %}
    {% for key, definition in tabs %}
        {% set _pages = _pages|merge([{'url': '/config/gallery?onglet=' ~ key, 'label': definition.label}]) %}
    {% endfor %}
    {% include 'partials/page_picker.html.twig' with {
        picker_id: 'gallery-config-picker',
        pages: _pages,
        current_path: '/config/gallery?onglet=' ~ tab,
    } only %}

    {# No novalidate: every field on these tabs is a bounded number input or
       a checkbox, and the browser's own min/max is the first line of defence
       behind Controller\GalleryConfigController::NUMERIC_SETTINGS. #}
    <form method="post" action="/config/gallery?onglet={{ tab }}">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token }}">

        {% if tab == 'general' %}
        <div class="card mb-4">
            <div class="card-body">
                <h2 class="h6 mb-3">Général</h2>
                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="gallery-allow-external" name="gallery_allow_external" value="1" {{ gallery_allow_external ? 'checked' : '' }}>
                            <label class="form-check-label" for="gallery-allow-external">Autoriser les albums en lien externe</label>
                        </div>
                        <div class="form-text">
                            Permet de créer un album dont les photos/vidéos restent hébergées ailleurs (ex. Google Photos) :
                            il suffit d'indiquer le lien de l'album externe, qui apparaît alors mêlé aux autres albums sur
                            la page Galerie.
                        </div>
                    </div>
                    <div class="col-12 col-md-6">
                        {% include 'partials/form_field.html.twig' with {
                            field_id: 'gallery-max-media', field_name: 'gallery_max_media_per_album',
                            label: 'Nombre maximum de médias par album', type: 'number', min: 1,
                            value: gallery_max_media_per_album, size: 'sm', wrapper_class: '',
                        } only %}
                    </div>
                </div>
            </div>
        </div>

            <div class="card mb-4">
                <div class="card-body">
                    <h2 class="h6 mb-3">Emplacement des nouveaux albums</h2>
                    <label class="form-label small" for="gallery-new-album-location">Emplacement</label>
                    <select class="form-select form-select-sm" id="gallery-new-album-location"
                            name="gallery_new_album_location_id">
                        <option value="0" {{ new_album_location_id == 0 ? 'selected' : '' }}>
                            Emplacement par défaut du site
                        </option>
                        {% for location in locations %}
                            <option value="{{ location.id }}" {{ new_album_location_id == location.id ? 'selected' : '' }}>
                                {{ location.label }} ({{ location.type.frenchLabel }})
                            </option>
                        {% endfor %}
                    </select>
                    {#
                      « nouveaux » is the whole of this setting's meaning, and
                      saying it once in the label is not enough: an
                      administrator who reads it as « où vit la galerie » will
                      expect yesterday's albums to follow, and nothing will
                      have moved.
                    #}
                    <div class="form-text">
                        S'applique aux albums créés à partir de maintenant. <strong>Les albums existants
                        restent où ils sont</strong> — pour en déplacer un, voir l'onglet « Albums ».
                        Les emplacements se déclarent dans
                        <a href="/config/stockage/emplacements">Configuration › Stockage</a>.
                    </div>
                </div>
            </div>
        {% endif %}

        {% if tab == 'photos' %}
        <div class="card mb-4">
            <div class="card-body">
                <h2 class="h6 mb-3">Photos</h2>
                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        {% include 'partials/form_field.html.twig' with {
                            field_id: 'photo-max-upload', field_name: 'gallery_max_photo_upload_mb',
                            label: "Taille maximale d'envoi (Mo)", type: 'number', min: 1,
                            value: gallery_max_photo_upload_mb, size: 'sm', wrapper_class: '',
                            help: "Un fichier dépassant cette taille est refusé à l'envoi.",
                        } only %}
                    </div>
                    <div class="col-12 col-md-6">
                        {% include 'partials/form_field.html.twig' with {
                            field_id: 'photo-max-dimension', field_name: 'gallery_photo_max_dimension',
                            label: 'Dimension maximale (px, plus long côté)', type: 'number', min: 500,
                            value: gallery_photo_max_dimension, size: 'sm', wrapper_class: '',
                            help: 'La photo est redimensionnée (jamais recadrée, jamais rejetée) pour que son plus long côté ne dépasse pas cette valeur ; c\'est cette version, plus légère, qui est ensuite servie.',
                        } only %}
                    </div>
                </div>
            </div>
        </div>

        {% endif %}

        {% if tab == 'videos' %}
        <div class="card mb-4">
            <div class="card-body">
                <h2 class="h6 mb-3">Vidéos</h2>
                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="gallery-allow-video" name="gallery_allow_video" value="1" {{ gallery_allow_video ? 'checked' : '' }}>
                            <label class="form-check-label" for="gallery-allow-video">Autoriser l'envoi de vidéos</label>
                        </div>
                        {% if not ffmpeg_available %}
                            <div class="form-text text-warning">FFmpeg indisponible — l'envoi de vidéos restera désactivé même si cette option est cochée.</div>
                        {% endif %}
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="gallery-keep-original" name="gallery_keep_original_video" value="1" {{ gallery_keep_original_video ? 'checked' : '' }}>
                            <label class="form-check-label" for="gallery-keep-original">Conserver le fichier vidéo original (en plus des versions transcodées)</label>
                        </div>
                    </div>
                    <div class="col-12 col-md-6">
                        {% include 'partials/form_field.html.twig' with {
                            field_id: 'video-max-upload', field_name: 'gallery_max_video_upload_mb',
                            label: "Taille maximale d'envoi (Mo)", type: 'number', min: 1,
                            value: gallery_max_video_upload_mb, size: 'sm', wrapper_class: '',
                        } only %}
                    </div>
                    <div class="col-12 col-md-6">
                        {% include 'partials/form_field.html.twig' with {
                            field_id: 'video-max-duration', field_name: 'gallery_max_video_duration_sec',
                            label: 'Durée maximale (secondes)', type: 'number', min: 1,
                            value: gallery_max_video_duration_sec, size: 'sm', wrapper_class: '',
                        } only %}
                    </div>
                </div>
            </div>
        </div>

            <div class="alert alert-warning small">
                Une vidéo n'est lisible que sur un emplacement qui sait lire par plage d'octets — sans
                quoi le lecteur peut démarrer le film mais jamais y avancer. L'onglet « Emplacements »
                de <a href="/config/stockage/emplacements">Configuration › Stockage</a> le dit
                emplacement par emplacement, sur la ligne « Vidéos ».
            </div>
        {% endif %}

        {% if tab == 'albums' %}
        <div class="card mb-4">
            <div class="card-body">
                <h2 class="h6 mb-3">Migration d'album</h2>
                <p class="small text-body-secondary">
                    Déplace les photos/vidéos d'un album local d'un emplacement de stockage vers un autre, en arrière-plan —
                    l'album est indisponible pour les membres pendant l'opération.
                </p>
                {#
                  One table for both kinds. A delegated album — one another
                  module owns and access-controls, such as a discussion
                  group's photos — is absent from every other gallery page on
                  purpose, but it takes real space on a real location and
                  moving it is gallery's job. Listing it nowhere is how an
                  administrator ends up unable to explain their storage bill.
                #}
                {# location_id is the album's EFFECTIVE location, resolved by the
                   controller: an album that pins nothing is sitting on the default,
                   and the raw column would say « Non défini » about it and offer it
                   its own location to move to. #}
                {% set migratable = [] %}
                {% for row in local_albums %}
                    {% set migratable = migratable|merge([{album: row.album, location_id: row.location_id, label: row.album.title, owner: null}]) %}
                {% endfor %}
                {% for row in delegated_albums %}
                    {% set migratable = migratable|merge([{album: row.album, location_id: row.location_id, label: row.owner_label, owner: row.album.ownerType}]) %}
                {% endfor %}

                {% if migratable is empty %}
                    {% include 'partials/empty_state.html.twig' with {
                        message: 'Aucun album local.',
                        compact: true,
                    } only %}
                {% else %}
                    <div class="table-responsive">
                        <table class="table table-sm align-middle">
                            <thead>
                                <tr>
                                    <th>Album</th>
                                    <th>Emplacement actuel</th>
                                    <th>Statut</th>
                                    <th class="text-end">Migrer vers</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for entry in migratable %}
                                    {% set album = entry.album %}
                                    {% set current_location = locations|filter(l => l.id == entry.location_id)|first %}
                                    {# A delegated album must stay somewhere ScoutMagic can serve
                                       it through an access-controlled path: migrating one onto a
                                       public-prefix location would publish a group's photos to
                                       anyone holding the URL. The server refuses it either way
                                       (Service\AlbumService::startMigration); not offering it is
                                       so nobody has to find out by trying. #}
                                    {% set other_locations = locations|filter(l =>
                                        l.id != entry.location_id
                                        and (entry.owner is null or not l.servesPubliclyWithoutExpiry)
                                    ) %}
                                    <tr>
                                        <td>
                                            {{ entry.label }}
                                            {% if entry.owner %}
                                                <span class="badge rounded-pill text-bg-light border ms-1"
                                                      title="Album géré par un autre module : son contenu et ses accès ne se configurent pas ici.">
                                                    <i class="bi bi-box-arrow-in-right" aria-hidden="true"></i> Album délégué
                                                </span>
                                            {% endif %}
                                        </td>
                                        <td>{{ current_location ? current_location.label ~ ' (' ~ current_location.type.frenchLabel ~ ')' : 'Non défini' }}</td>
                                        <td class="gallery-album-migration-status" data-album-id="{{ album.id }}">
                                            {% if album.migrationStatus == 'in_progress' %}
                                                <span class="badge text-bg-info"><span class="spinner-border spinner-border-sm"></span> En cours</span>
                                            {% elseif album.migrationStatus == 'failed' %}
                                                <span class="badge text-bg-danger" title="{{ album.migrationError }}">Échec — nouvelle tentative possible</span>
                                            {% else %}
                                                <span class="text-body-secondary">—</span>
                                            {% endif %}
                                        </td>
                                        <td class="text-end">
                                            {% if album.migrationStatus == 'in_progress' %}
                                                <span class="text-body-secondary small">Migration en cours…</span>
                                            {% elseif other_locations is empty %}
                                                <span class="text-body-secondary small">Aucun autre emplacement disponible</span>
                                            {% else %}
                                                <div class="d-inline-flex gap-2 align-items-center">
                                                    <label class="visually-hidden" for="gallery-migrate-target-{{ album.id }}">Emplacement de destination pour {{ entry.label }}</label>
                                                    <select class="form-select form-select-sm gallery-migrate-target" id="gallery-migrate-target-{{ album.id }}" data-album-id="{{ album.id }}" style="width:auto;">
                                                        {% for location in other_locations %}
                                                            <option value="{{ location.id }}">{{ location.label }} ({{ location.type.frenchLabel }})</option>
                                                        {% endfor %}
                                                    </select>
                                                    <button type="button" class="btn btn-sm btn-outline-primary gallery-migrate-start"
                                                            data-album-id="{{ album.id }}" data-url="/config/gallery/albums/{{ album.id }}/migrate">
                                                        <i class="bi bi-arrow-left-right" aria-hidden="true"></i> {{ album.migrationStatus == 'failed' ? 'Réessayer' : 'Migrer' }}
                                                    </button>
                                                </div>
                                            {% endif %}
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% endif %}
            </div>
        </div>

        {% endif %}

        {% if tab != 'albums' %}
            <button type="submit" class="btn btn-primary">Enregistrer</button>
        {% endif %}
    </form>
{% endblock %}

{% block scripts %}
    <script src="{{ asset('/assets/js/gallery-album-migration.js') }}" defer></script>
{% endblock %}
