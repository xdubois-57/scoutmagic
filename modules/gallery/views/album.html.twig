{% extends "base.html.twig" %}

{% block title %}{{ album.title }} — Galerie — {{ site_name }}{% endblock %}

{% block content %}
    {% if has_downloadable_media %}
        {% include 'partials/page_header.html.twig' with {
            title: album.title,
            subtitle: (album.subtitle ? album.subtitle ~ ' · ' : '') ~ album.albumDate|french_date,
            action_label: "Télécharger l'album (ZIP)",
            action_url: '/gallery/' ~ album.id ~ '/download',
            action_icon: 'bi-file-earmark-zip',
        } only %}
    {% else %}
        {% include 'partials/page_header.html.twig' with {
            title: album.title,
            subtitle: (album.subtitle ? album.subtitle ~ ' · ' : '') ~ album.albumDate|french_date,
        } only %}
    {% endif %}

    {% if storage_unavailable %}
        <div class="alert alert-warning text-center">
            <i class="bi bi-exclamation-triangle" aria-hidden="true"></i> Cet album est temporairement indisponible{{ storage_unavailable_reason ? ' : ' ~ storage_unavailable_reason : '.' }}
        </div>
    {% elseif media is empty %}
        {% include 'partials/empty_state.html.twig' with {
            message: 'Aucun média dans cet album.',
            icon: 'bi-images',
        } only %}
    {% else %}
        {% include '@gallery/partials/media_grid.html.twig' with { rows: media } %}

        {% include '@gallery/partials/lightbox.html.twig' %}
    {% endif %}
{% endblock %}

{% block scripts %}
    <script src="{{ asset('/assets/js/gallery.js') }}" defer></script>
{% endblock %}
