{% extends "base.html.twig" %}

{% block title %}{{ album.title }} — Galerie — {{ site_name }}{% endblock %}

{% block content %}
    <div class="d-flex justify-content-between align-items-start mb-3 flex-wrap gap-2">
        <div>
            <h1 class="h4 mb-1">{{ album.title }}</h1>
            {% if album.subtitle %}<p class="text-body-secondary mb-0">{{ album.subtitle }}</p>{% endif %}
            <p class="small text-body-secondary mb-0">{{ album.albumDate|french_date }}</p>
        </div>
        <div class="d-flex gap-2">
            {% if has_downloadable_media %}
                <a href="/gallery/{{ album.id }}/download" class="btn btn-sm btn-outline-primary">
                    <i class="bi bi-file-earmark-zip"></i> Télécharger l'album (ZIP)
                </a>
            {% endif %}
            <a href="/gallery" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left"></i> Retour</a>
        </div>
    </div>

    {% if media is empty %}
        <p class="text-body-secondary text-center py-5">Aucun média dans cet album.</p>
    {% else %}
        <div class="row g-2" id="gallery-media-grid">
            {% for row in media %}
                {% set m = row.media %}
                <div class="col-4 col-md-3 col-lg-2">
                    <button type="button" class="btn p-0 border-0 w-100 gallery-lightbox-trigger" style="aspect-ratio:1/1;overflow:hidden;background:#eee;"
                            data-index="{{ loop.index0 }}"
                            data-type="{{ m.mediaType }}"
                            data-medium-url="{{ row.medium_url }}"
                            data-large-url="{{ row.large_url }}">
                        {% if m.processingStatus == 'done' %}
                            <img src="{{ row.thumb_url }}" alt="" class="w-100 h-100" style="object-fit:cover;">
                            {% if m.mediaType == 'video' %}
                                <span class="position-absolute top-50 start-50 translate-middle text-white" style="font-size:2rem;text-shadow:0 0 6px rgba(0,0,0,.6);">
                                    <i class="bi bi-play-circle-fill"></i>
                                </span>
                            {% endif %}
                        {% elseif m.processingStatus == 'failed' %}
                            <span class="d-flex align-items-center justify-content-center h-100 text-danger" title="Échec du traitement">
                                <i class="bi bi-exclamation-triangle"></i>
                            </span>
                        {% else %}
                            <span class="d-flex align-items-center justify-content-center h-100 text-body-secondary">
                                <span class="spinner-border spinner-border-sm"></span>
                            </span>
                        {% endif %}
                    </button>
                </div>
            {% endfor %}
        </div>

        {% include '@gallery/partials/lightbox.html.twig' %}
    {% endif %}
{% endblock %}

{% block scripts %}
    <script src="/assets/js/gallery.js" defer></script>
{% endblock %}
