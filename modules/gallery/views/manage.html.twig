{% extends "base.html.twig" %}

{% block title %}Gérer la galerie — {{ site_name }}{% endblock %}

{% block content %}
    {% if allow_local or allow_external %}
        {% include 'partials/page_header.html.twig' with {
            title: 'Gérer la galerie',
            action_label: 'Nouvel album',
            action_url: '/gallery/create',
        } only %}
    {% else %}
        {% include 'partials/page_header.html.twig' with { title: 'Gérer la galerie' } only %}
    {% endif %}

    {% if albums is empty %}
        {# The creation action already lives in the page header above (one
           btn-primary per screen, design.md §7.4). #}
        {% include 'partials/empty_state.html.twig' with {
            message: 'Aucun album pour le moment.',
            icon: 'bi-images',
        } only %}
    {% else %}
        <div class="d-flex flex-column gap-2">
            {% for row in albums %}
                {% set album = row.album %}
                <div class="card">
                    <div class="card-body d-flex align-items-center gap-3">
                        <span class="badge rounded-pill text-bg-light border flex-shrink-0">
                            {% if album.type == 'external' %}<i class="bi bi-box-arrow-up-right"></i> Lien externe
                            {% else %}<i class="bi bi-images"></i> Local
                            {% endif %}
                        </span>
                        {% if album.migrationStatus == 'in_progress' %}
                            <span class="badge rounded-pill text-bg-info flex-shrink-0">
                                <i class="bi bi-arrow-left-right"></i> Migration en cours
                            </span>
                        {% elseif album.migrationStatus == 'failed' %}
                            <span class="badge rounded-pill text-bg-danger flex-shrink-0" title="{{ album.migrationError }}">
                                <i class="bi bi-exclamation-triangle"></i> Migration échouée
                            </span>
                        {% endif %}
                        <div class="flex-grow-1" style="min-width:0;">
                            <h2 class="h6 mb-0 text-truncate">{{ album.displayTitle() }}</h2>
                            <p class="small text-body-secondary mb-0">
                                {{ album.albumDate|french_date }}
                                {# Literal text in the else branch, not a string expression: an
                                   apostrophe inside {{ ... }} comes out as &#039;. #}
                                · {% if row.section_label %}{{ row.section_label }}{% else %}Toute l'unité{% endif %}
                            </p>
                        </div>
                        {% if row.can_edit %}
                            <a href="/gallery/{{ album.id }}/edit" class="btn btn-sm btn-outline-secondary flex-shrink-0">
                                <i class="bi bi-pencil"></i> <span class="d-none d-sm-inline">Éditer</span>
                            </a>
                        {% endif %}
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}
