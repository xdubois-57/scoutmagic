{% extends "base.html.twig" %}

{% block title %}Galerie — {{ site_name }}{% endblock %}

{% block content %}
    {% include 'partials/page_header.html.twig' with { title: 'Galerie' } only %}

    {% if albums is empty %}
        {% include 'partials/empty_state.html.twig' with {
            message: 'Aucun album pour le moment.',
            icon: 'bi-images',
        } only %}
    {% else %}
        <div class="row g-3">
            {% for row in albums %}
                {% set album = row.album %}
                <div class="col-6 col-md-4 col-lg-3">
                    {% if row.storage_unavailable %}
                        <div class="card h-100">
                            <div class="bg-body-tertiary d-flex flex-column align-items-center justify-content-center text-body-secondary" style="aspect-ratio:1/1;overflow:hidden;">
                                <i class="bi bi-exclamation-triangle" style="font-size:2rem;" aria-hidden="true"></i>
                                <span class="small mt-1">Indisponible</span>
                            </div>
                            <div class="card-body p-2">
                                <h2 class="h6 mb-1 text-truncate">{{ row.display_title }}</h2>
                                <p class="small text-body-secondary mb-0">{{ album.albumDate|french_date }}</p>
                            </div>
                        </div>
                    {% else %}
                        {# The target/rel pair has to be written as real attributes: emitted from a
                           string expression, autoescaping turns the quotes into &quot; and the browser
                           ends up with a named target of «"_blank"» and no noopener protection at all
                           — on a link pointing at an arbitrary third-party site. #}
                        <a href="{{ album.type == 'external' ? album.externalUrl : '/gallery/' ~ album.id }}"
                           class="text-decoration-none text-body"
                           {% if album.type == 'external' %}target="_blank" rel="noopener noreferrer"{% endif %}>
                            <div class="card h-100">
                                <div class="bg-body-tertiary d-flex align-items-center justify-content-center" style="aspect-ratio:1/1;overflow:hidden;">
                                    {% if row.cover_url %}
                                        <img src="{{ row.cover_url }}" alt="" class="w-100 h-100" style="object-fit:cover;">
                                    {% else %}
                                        <i class="bi bi-images text-body-secondary" style="font-size:2rem;" aria-hidden="true"></i>
                                    {% endif %}
                                </div>
                                <div class="card-body p-2">
                                    <h2 class="h6 mb-1 text-truncate">{{ row.display_title }}</h2>
                                    <p class="small text-body-secondary mb-0">{{ album.albumDate|french_date }}</p>
                                </div>
                            </div>
                        </a>
                    {% endif %}
                </div>
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}
