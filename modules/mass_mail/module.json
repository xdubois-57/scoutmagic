  "settings": [
    {
      "key": "batch_size",
      "default_value": "20",
      "type": "number",
      "label": "Taille des lots d'envoi",
      "description": "Nombre d'emails envoyés à chaque passage du planificateur. Réglage global à tout le site."
    },
    {
      "key": "batch_interval_minutes",
      "default_value": "5",
      "type": "number",
      "label": "Intervalle entre les lots (minutes)",
      "description": "Délai entre deux lots d'envoi. Réglage global à tout le site, s'applique à tous les emails de masse en cours d'envoi."
    },
    {
      "key": "merge_retention_months",
      "default_value": "18",
      "type": "number",
      "editable": false,
      "label": "Rétention des audiences de publipostage (mois)",
      "description": "Durée de conservation des données importées d'un fichier Excel de publipostage après l'envoi de l'email, avant leur suppression définitive. Paramètre en lecture seule."
    },
    {
      "key": "mass_mail_list_addresses_max",
      "default_value": "2000",
      "type": "number",
      "label": "Adresses par liste de diffusion (maximum)",
      "description": "Nombre maximum d'adresses propres qu'une liste de diffusion peut contenir. Deux raisons, et elles sont indépendantes. Techniquement, ces adresses sont chiffrées : ouvrir l'écran des adresses les déchiffre toutes en PHP, ce qu'un hébergement mutualisé fait mal passé quelques milliers. Et pratiquement, une liste de dix mille adresses achetées abîmerait la réputation d'envoi du domaine — donc de tous les emails de l'unité, y compris ceux qui partent aux familles — bien plus vite que le site ne s'en remettrait."
    },
    {
      "key": "previous_year_active_cutoff",
      "default_value": "07-31",
      "type": "text",
      "validation_regex": "^(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$",
      "label": "Date de référence « année précédente » (MM-JJ)",
      "description": "Repère indicatif affiché dans la fenêtre d'envoi pour expliquer ce que représente la liste de l'année scoute précédente (les membres actifs lors du dernier import Desk de cette année, généralement autour de cette date). N'affecte pas la résolution réelle de la liste."
    }
  ],
