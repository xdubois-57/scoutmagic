{% extends "base.html.twig" %}

{% block title %}Configuration envoi de mails — {{ site_name }}{% endblock %}

{% block content %}
    {% include 'partials/page_header.html.twig' with { title: 'Configuration envoi de mails' } only %}

    <div class="card mb-4">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 class="h5 mb-0">Listes de diffusion</h2>
                <button type="button" class="btn btn-sm btn-primary" id="cfg-new-list-btn"><i class="bi bi-plus-lg" aria-hidden="true"></i> Nouvelle liste</button>
            </div>

            <ul class="list-group mb-2">
                {% for list in default_lists %}
                    <li class="list-group-item">
                        <div class="d-flex align-items-center">
                            <i class="bi bi-lock text-body-secondary me-2" title="Liste par défaut — non modifiable"></i>
                            <span>{{ list.label }}</span>
                        </div>
                        <p class="text-body-secondary small mb-0 mt-1">{{ list.description }}</p>
                    </li>
                {% endfor %}
            </ul>

            <ul class="list-group" id="cfg-custom-lists">
                {% for list in custom_lists %}
                    <li class="list-group-item" data-id="{{ list.id }}">
                        <div class="d-flex justify-content-between align-items-center">
                            <span>{{ list.name }}{% if not list.isActive %} {% include 'partials/status_badge.html.twig' with { status: 'inactive', label: 'Désactivée' } only %}{% endif %}</span>
                            <span class="text-nowrap">
                                <button type="button" class="btn btn-sm btn-outline-secondary cfg-edit-list-btn"
                                        data-id="{{ list.id }}" data-name="{{ list.name }}" data-description="{{ list.description }}"
                                        data-function-ids="{{ custom_list_criteria[list.id].function_ids|join(',') }}"
                                        data-section-ids="{{ custom_list_criteria[list.id].section_ids|join(',') }}"
                                        aria-label="Modifier la liste">
                                    <i class="bi bi-pencil" aria-hidden="true"></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-secondary cfg-toggle-list-btn" data-id="{{ list.id }}" data-active="{{ list.isActive ? '1' : '0' }}" aria-label="{{ list.isActive ? 'Désactiver la liste' : 'Activer la liste' }}">
                                    <i class="bi {{ list.isActive ? 'bi-eye-slash' : 'bi-eye' }}" aria-hidden="true"></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-danger cfg-delete-list-btn" data-id="{{ list.id }}" aria-label="Supprimer la liste"><i class="bi bi-trash" aria-hidden="true"></i></button>
                            </span>
                        </div>
                        <p class="text-body-secondary small mb-0 mt-1">{{ list.description }}</p>
                    </li>
                {% else %}
                    <li class="list-group-item">
                        {% include 'partials/empty_state.html.twig' with {
                            message: 'Aucune liste personnalisée.',
                            compact: true,
                        } only %}
                    </li>
                {% endfor %}
            </ul>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <h2 class="h5 mb-3">Vitesse d'envoi</h2>
            <p class="text-body-secondary small">
                Ce réglage est <strong>global à tout le site</strong> — il s'applique à tous les emails de masse en cours d'envoi, quel que soit leur expéditeur.
            </p>
            <form id="cfg-settings-form" class="d-flex align-items-center flex-wrap gap-2">
                <span>Envoyer</span>
                <input type="number" min="1" class="form-control form-control-sm" style="width:6rem;" id="cfg-batch-size" value="{{ batch_size }}" aria-label="Nombre d'emails par envoi">
                <span>emails toutes les</span>
                <input type="number" min="1" class="form-control form-control-sm" style="width:6rem;" id="cfg-batch-interval" aria-label="Intervalle en minutes entre les envois">
                <span id="cfg-batch-interval-label">minutes</span>
                <button type="submit" class="btn btn-sm btn-primary ms-2">Enregistrer</button>
            </form>
        </div>
    </div>

    {# The title id the JS targets (cfg-list-modal-title) is exactly the
       embed's {id}-title convention. #}
    {% embed 'partials/modal.html.twig' with {
        id: 'cfg-list-modal',
        title: 'Nouvelle liste',
        all_functions: all_functions,
        all_sections: all_sections,
    } only %}
        {% block body %}
            <div class="alert alert-danger d-none" id="cfg-list-error"></div>
            <div class="mb-3">
                <label class="form-label small" for="cfg-list-name">Nom</label>
                <input type="text" class="form-control form-control-sm" id="cfg-list-name">
            </div>
            <div class="mb-3">
                <label class="form-label small" for="cfg-list-description">Description</label>
                <textarea class="form-control form-control-sm" id="cfg-list-description" rows="2" maxlength="500"
                          placeholder="À qui s'adresse cette liste, dans quel but — affiché aux animateurs qui la choisissent."></textarea>
            </div>
            <div class="mb-3">
                <div class="form-label small d-block">Fonctions (au moins une)</div>
                <div class="border rounded p-2" style="max-height:160px;overflow-y:auto;">
                    {% for f in all_functions %}
                        <div class="form-check">
                            <input class="form-check-input cfg-function-checkbox" type="checkbox" value="{{ f.id }}" id="cfg-fn-{{ f.id }}">
                            <label class="form-check-label small" for="cfg-fn-{{ f.id }}">{{ f.label }}</label>
                        </div>
                    {% endfor %}
                </div>
            </div>
            <div class="mb-3">
                <div class="form-label small d-block">Sections (au moins une)</div>
                <div class="border rounded p-2" style="max-height:160px;overflow-y:auto;">
                    {% for s in all_sections %}
                        <div class="form-check">
                            <input class="form-check-input cfg-section-checkbox" type="checkbox" value="{{ s.id }}" id="cfg-sec-{{ s.id }}">
                            <label class="form-check-label small" for="cfg-sec-{{ s.id }}">{{ s.name }}</label>
                        </div>
                    {% endfor %}
                </div>
            </div>
        {% endblock %}
        {% block footer %}
            <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Annuler</button>
            <button type="button" class="btn btn-sm btn-primary" id="cfg-list-save-btn">Enregistrer</button>
        {% endblock %}
    {% endembed %}
{% endblock %}

{% block scripts %}
{# Server data as a JSON ISLAND, read by mass-mail-config.js through
   ScoutMagicApi.pageData(): data to the parser rather than code, so the
   template needs no nonce for it. #}
{% set json_flags = constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_UNESCAPED_UNICODE') %}
<script type="application/json" id="mass-mail-config-data">
{{ {
    batchIntervalMinutes: batch_interval_minutes
}|json_encode(json_flags)|raw }}
</script>
<script src="/assets/js/mass-mail-config.js" defer></script>
{% endblock %}
