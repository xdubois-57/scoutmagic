{% extends "base.html.twig" %}

{% block title %}Listes de diffusion — {{ site_name }}{% endblock %}

{% block content %}
    {% include 'partials/page_header.html.twig' with { title: 'Listes de diffusion' } only %}

    <div class="card mb-4">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 class="h5 mb-0">Listes de diffusion</h2>
                <button type="button" class="btn btn-sm btn-primary" id="cfg-new-list-btn"><i class="bi bi-plus-lg" aria-hidden="true"></i> Nouvelle liste</button>
            </div>

            {# A list has no scout year of its own — it is a set of criteria,
               and the year is chosen at composition. Saying so here is what
               makes the warning in the compose dialog make sense when it
               appears (it names the year, which is not a property of
               anything on this page). #}
            <p class="text-body-secondary small">
                Une liste ne vise aucune année scoute : elle décrit qui recevoir, et l'année se choisit au moment
                d'écrire l'email. {% if future_audience_notice %}{{ future_audience_notice }}{% endif %}
            </p>

            <ul class="list-group mb-2">
                {% for list in default_lists %}
                    <li class="list-group-item">
                        <div class="d-flex align-items-center">
                            <i class="bi bi-lock text-body-secondary me-2" title="Liste par défaut — non modifiable"></i>
                            <span>{{ list.label }}</span>
                        </div>
                        <p class="text-body-secondary small mb-0 mt-1">{{ list.description }}</p>
                    </li>
                {% endfor %}
            </ul>

            <ul class="list-group" id="cfg-custom-lists">
                {% for list in custom_lists %}
                    <li class="list-group-item" data-id="{{ list.id }}">
                        <div class="d-flex justify-content-between align-items-center">
                            <span>{{ list.name }}{% if not list.isActive %} {% include 'partials/status_badge.html.twig' with { status: 'inactive', label: 'Désactivée' } only %}{% endif %}</span>
                            <span class="text-nowrap">
                                <button type="button" class="btn btn-sm btn-outline-secondary cfg-edit-list-btn"
                                        data-id="{{ list.id }}" data-name="{{ list.name }}" data-description="{{ list.description }}"
                                        data-function-ids="{{ custom_list_criteria[list.id].function_ids|join(',') }}"
                                        data-section-ids="{{ custom_list_criteria[list.id].section_ids|join(',') }}"
                                        data-badge-ids="{{ custom_list_criteria[list.id].badge_ids|join(',') }}"
                                        aria-label="Modifier la liste">
                                    <i class="bi bi-pencil" aria-hidden="true"></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-secondary cfg-toggle-list-btn" data-id="{{ list.id }}" data-active="{{ list.isActive ? '1' : '0' }}" aria-label="{{ list.isActive ? 'Désactiver la liste' : 'Activer la liste' }}">
                                    <i class="bi {{ list.isActive ? 'bi-eye-slash' : 'bi-eye' }}" aria-hidden="true"></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-danger cfg-delete-list-btn" data-id="{{ list.id }}" aria-label="Supprimer la liste"><i class="bi bi-trash" aria-hidden="true"></i></button>
                            </span>
                        </div>
                        <p class="text-body-secondary small mb-0 mt-1">{{ list.description }}</p>

                        {# Collapsed by default, and its summary is the only
                           thing rendered server-side: the count is a COUNT(*),
                           so a list that is nothing but criteria never pays
                           the cost of decrypting addresses nobody asked to
                           see. Opening it fetches them, once. #}
                        <details class="mt-2 mml-addresses" data-list-id="{{ list.id }}">
                            <summary class="tap-target small text-body-secondary">
                                Adresses de cette liste —
                                <span data-address-count>
                                    {% set counts = custom_list_criteria[list.id].address_counts %}
                                    {{ counts.total }} adresse{{ counts.total > 1 ? 's' : '' }}{% if counts.unsubscribed > 0 %}, dont {{ counts.unsubscribed }} désinscrite{{ counts.unsubscribed > 1 ? 's' : '' }}{% endif %}
                                </span>
                            </summary>

                            <div class="border rounded p-2 mt-2">
                                <div class="d-flex flex-wrap gap-2 align-items-center mb-2">
                                    <input type="search" class="form-control form-control-sm" style="max-width:16rem;"
                                           data-address-search placeholder="Rechercher un nom ou une adresse"
                                           aria-label="Rechercher dans les adresses de cette liste">
                                    <div class="form-check form-switch mb-0">
                                        <input class="form-check-input" type="checkbox"
                                               id="cfg-unsub-only-{{ list.id }}" data-address-unsubscribed-only>
                                        <label class="form-check-label small" for="cfg-unsub-only-{{ list.id }}">
                                            Désinscrites seulement
                                        </label>
                                    </div>
                                </div>

                                <div class="alert alert-danger d-none small py-1 px-2" data-address-error></div>

                                <ul class="list-group list-group-flush mb-2" data-address-rows></ul>
                                <p class="text-body-secondary small mb-2 d-none" data-address-empty>
                                    Aucune adresse ne correspond.
                                </p>
                                <button type="button" class="btn btn-sm btn-outline-secondary d-none mb-2"
                                        data-address-more>Afficher plus</button>

                                <form class="d-flex flex-wrap gap-2 align-items-start mb-3" data-address-add-form>
                                    <input type="text" class="form-control form-control-sm" style="max-width:12rem;"
                                           data-address-new-name placeholder="Nom" aria-label="Nom" maxlength="150">
                                    <input type="email" class="form-control form-control-sm" style="max-width:16rem;"
                                           data-address-new-email placeholder="adresse@exemple.be" required
                                           aria-label="Adresse email">
                                    <button type="submit" class="btn btn-sm btn-primary">Ajouter</button>
                                </form>

                                {# The Excel round trip: the working tool for
                                   anything at scale, and the only operation
                                   here with no way back — hence the preview
                                   between the file and the replacement. #}
                                <div class="border-top pt-2">
                                    <div class="d-flex flex-wrap gap-2 align-items-center">
                                        <a class="btn btn-sm btn-outline-secondary"
                                           href="/admin/listes-de-diffusion/lists/{{ list.id }}/addresses/export">
                                            Exporter en Excel
                                        </a>
                                        <label class="btn btn-sm btn-outline-secondary mb-0">
                                            Remplacer depuis Excel
                                            <input type="file" accept=".xlsx" class="d-none" data-address-import-input>
                                        </label>
                                    </div>
                                    <p class="form-text mb-0">
                                        Le fichier remplace toutes les adresses de cette liste. Les adresses
                                        désinscrites sont conservées et restent exclues des envois.
                                    </p>

                                    <div class="alert alert-warning mt-2 d-none" data-address-import-preview>
                                        <p class="mb-1 fw-semibold" data-address-import-summary></p>
                                        <ul class="small mb-2 d-none" data-address-import-errors></ul>
                                        <button type="button" class="btn btn-sm btn-danger"
                                                data-address-import-confirm>Remplacer les adresses</button>
                                        <button type="button" class="btn btn-sm btn-outline-secondary"
                                                data-address-import-cancel>Annuler</button>
                                    </div>
                                </div>
                            </div>
                        </details>
                    </li>
                {% else %}
                    <li class="list-group-item">
                        {% include 'partials/empty_state.html.twig' with {
                            message: 'Aucune liste personnalisée.',
                            compact: true,
                        } only %}
                    </li>
                {% endfor %}
            </ul>
        </div>
    </div>

    {# The title id the JS targets (cfg-list-modal-title) is exactly the
       embed's {id}-title convention. #}
    {% embed 'partials/modal.html.twig' with {
        id: 'cfg-list-modal',
        title: 'Nouvelle liste',
        all_functions: all_functions,
        all_sections: all_sections,
        all_badges: all_badges,
        effective_year_label: effective_year_label,
    } only %}
        {% block body %}
            <div class="alert alert-danger d-none" id="cfg-list-error"></div>
            <div class="mb-3">
                <label class="form-label small" for="cfg-list-name">Nom</label>
                <input type="text" class="form-control form-control-sm" id="cfg-list-name">
            </div>
            <div class="mb-3">
                <label class="form-label small" for="cfg-list-description">Description</label>
                <textarea class="form-control form-control-sm" id="cfg-list-description" rows="2" maxlength="500"
                          placeholder="À qui s'adresse cette liste, dans quel but — affiché aux animateurs qui la choisissent."></textarea>
            </div>
            {# Three axes, three select bars (design.md §1.4 / §7.10.1):
               each list is open-ended, comes from the database and carries
               long labels, which is what the select bar is for. It also
               brings, at no cost here, the things a hand-rolled row of
               controls gets wrong — a real 44px tap target from
               `.tap-target`, a panel that scrolls itself instead of the
               page, and nothing hidden behind a « +N ». #}
            <div class="mb-3">
                {% include 'partials/select_bar.html.twig' with {
                    picker_id: 'cfg-function-picker',
                    label: 'Fonctions',
                    items: all_functions|map(f => { id: f.id, label: f.label, selected: false }),
                    mode: 'multi',
                    none_selected_text: 'Toutes les fonctions',
                    count_label: 'fonctions',
                    empty_text: 'Aucune fonction — importez Desk pour en disposer.',
                } only %}
            </div>
            <div class="mb-3">
                {% include 'partials/select_bar.html.twig' with {
                    picker_id: 'cfg-section-picker',
                    label: 'Sections',
                    items: all_sections|map(s => { id: s.id, label: s.name, selected: false }),
                    mode: 'multi',
                    none_selected_text: 'Toutes les sections',
                    count_label: 'sections',
                    empty_text: 'Aucune section — importez Desk pour en disposer.',
                } only %}
            </div>
            <div class="mb-3">
                {% include 'partials/select_bar.html.twig' with {
                    picker_id: 'cfg-badge-picker',
                    label: 'Badges',
                    items: all_badges|map(b => { id: b.id, label: b.name, selected: false }),
                    mode: 'multi',
                    none_selected_text: 'Tous les badges',
                    count_label: 'badges',
                    empty_text: 'Aucun badge actif.',
                } only %}
            </div>

            {# What the three selections add up to, in a sentence, rebuilt
               at every toggle — the combination is the one thing the
               controls themselves cannot show, and it is where the AND
               between axes stops being a guess. #}
            <div class="border rounded p-2 bg-body-tertiary">
                <p class="small mb-1" id="cfg-criteria-sentence"></p>
                <p class="small mb-0" id="cfg-criteria-count"
                   data-year-label="{{ effective_year_label }}"></p>
            </div>
        {% endblock %}
        {% block footer %}
            <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Annuler</button>
            <button type="button" class="btn btn-sm btn-primary" id="cfg-list-save-btn">Enregistrer</button>
        {% endblock %}
    {% endembed %}
{% endblock %}

{% block scripts %}
{# select-bar.js is loaded by base.html.twig, before this block and with
   the same `defer`, so it has already run and window.SelectBar exists by
   the time this file drives the three pickers. #}
<script src="{{ asset('/assets/js/mass-mail-lists.js') }}" defer></script>
<script src="{{ asset('/assets/js/mass-mail-list-addresses.js') }}" defer></script>
{% endblock %}
