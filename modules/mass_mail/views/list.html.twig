{% extends "base.html.twig" %}

{% block title %}Envoi de mails — {{ site_name }}{% endblock %}

{% block content %}
    {% include 'partials/page_header.html.twig' with { title: 'Envoi de mails' } only %}

    {# The creation action opens the compose dialog (JS), so it cannot ride
       the page_header's link action — it keeps its own right-aligned row. #}
    <div class="d-flex justify-content-end mb-3">
        <button type="button" class="btn btn-primary w-100 w-sm-auto" id="mm-new-btn"><i class="bi bi-plus-lg" aria-hidden="true"></i> Nouvel email</button>
    </div>

    <form method="get" action="/mass-mail" class="row g-2 align-items-end mb-3">
        <div class="col-12 col-md-4">
            {% include 'partials/form_field.html.twig' with {
                field_id: 'mm-filter-search', field_name: 'search', label: 'Recherche',
                value: search, placeholder: 'Sujet, section, liste...',
                size: 'sm', wrapper_class: '',
            } only %}
        </div>
        <div class="col-6 col-md-3">
            {% include 'partials/form_field.html.twig' with {
                field_id: 'mm-filter-status', field_name: 'status', label: 'Statut',
                type: 'select', size: 'sm', wrapper_class: '',
                options: [{ value: '', label: 'Tous', selected: status == '' }]
                    |merge(statuses|default([])|map(s => {
                        value: s,
                        label: s == 'draft' ? 'Brouillon'
                            : (s == 'test' ? 'Test'
                            : (s == 'sending' ? 'Envoi en cours' : 'Envoyé')),
                        selected: status == s,
                    })),
            } only %}
        </div>
        <div class="col-6 col-md-3">
            {% include 'partials/form_field.html.twig' with {
                field_id: 'mm-filter-section', field_name: 'section_id', label: 'Section',
                type: 'select', size: 'sm', wrapper_class: '',
                options: [{ value: '', label: 'Toutes', selected: not section_id }]
                    |merge(sections|default([])|map(section => {
                        value: section.id, label: section.name,
                        selected: section_id == section.id,
                    })),
            } only %}
        </div>
        <div class="col-12 col-md-2">
            {# The page's one primary action is « Nouvel email » above
               (design.md §7.4) — the filter button is neutral. #}
            <button type="submit" class="btn btn-sm btn-outline-secondary">Filtrer</button>
            <a href="/mass-mail" class="btn btn-sm btn-outline-secondary">Réinitialiser</a>
        </div>
    </form>

    <div class="table-responsive">
        <table class="table table-sm align-middle">
            <thead>
                <tr>
                    <th>Sujet</th>
                    <th>Section</th>
                    <th>Liste</th>
                    <th>Année</th>
                    <th>Statut</th>
                    <th class="text-end">Destinataires</th>
                    <th>Date</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for email in emails %}
                    <tr>
                        <td>{{ email.subject }}</td>
                        <td>{{ sections_by_id[email.sectionId] ?? '—' }}</td>
                        <td>
                            {% if email.listType == 'default_active_members' %}Membres actifs
                            {% elseif email.listType == 'default_chiefs' %}Animateurs uniquement
                            {% elseif email.listType == 'default_section' %}Section - {{ sections_by_id[email.listSectionId] ?? '?' }}
                            {% elseif email.listType == 'mail_merge' %}Publipostage
                            {% else %}{{ custom_lists_by_id[email.listId] ?? 'Liste personnalisée' }}
                            {% endif %}
                        </td>
                        {# Two list types are not scout-year-scoped, and showing a year for
                           them would name one that was never used: a mail merge takes its
                           recipients from the uploaded file, and an external list
                           (Email::LIST_TYPE_EXTERNAL) always targets the fixed year of the
                           module that contributes it. #}
                        <td>{{ email.listType in ['mail_merge', 'external'] ? '—' : email.scoutYearIds|map(yid => scout_years_by_id[yid] ?? '?')|join(', ') }}</td>
                        <td>
                            {% include 'partials/status_badge.html.twig' with {
                                status: email.status == 'draft' ? 'draft' : (email.status == 'test' ? 'pending' : (email.status == 'sending' ? 'in_progress' : 'done')),
                                label: email.status == 'draft' ? 'Brouillon' : (email.status == 'test' ? 'Test' : (email.status == 'sending' ? 'Envoi en cours' : 'Envoyé')),
                            } only %}
                        </td>
                        <td class="text-end">{{ recipient_counts[email.id] ?? 0 }}</td>
                        <td>{{ email.createdAt|date_fr }}</td>
                        <td class="text-end text-nowrap">
                            <button type="button" class="btn btn-sm btn-outline-secondary mm-open-btn" data-id="{{ email.id }}" title="Ouvrir"><i class="bi bi-eye"></i></button>
                            {% if email.status in ['sending', 'sent'] %}
                                <a href="/mass-mail/{{ email.id }}/tracking" class="btn btn-sm btn-outline-secondary" title="Suivi"><i class="bi bi-bar-chart-line"></i></a>
                            {% endif %}
                        </td>
                    </tr>
                {% else %}
                    {% include 'partials/empty_state.html.twig' with {
                        message: 'Aucun email.',
                        colspan: 8,
                        icon: 'bi-envelope',
                    } only %}
                {% endfor %}
            </tbody>
        </table>
    </div>

    {% include 'partials/pagination.html.twig' with {
        page: page,
        total_pages: total_pages,
        base_url: '?'
            ~ (search ? 'search=' ~ search|url_encode ~ '&' : '')
            ~ (status ? 'status=' ~ status|url_encode ~ '&' : '')
            ~ (section_id ? 'section_id=' ~ section_id ~ '&' : '')
            ~ 'page=',
        label: 'Pagination des emails',
    } only %}

    {% include '@mass_mail/_compose_dialog.html.twig' %}
{% endblock %}

{% block scripts %}
{# Server data as a JSON ISLAND, not an inline assignment: an island is
   data to the parser, so a list name that manages to contain a
   tag-closing sequence cannot end the block in the middle of an object
   literal, and the template needs no nonce for it.
   JSON_HEX_TAG/JSON_HEX_AMP escape those characters anyway.
   mass-mail-list.js reads it through ScoutMagicApi.pageData(). #}
{% set json_flags = constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_UNESCAPED_UNICODE') %}
<script type="application/json" id="mass-mail-list-data">
{{ {
    sections: sections,
    defaultLists: default_lists,
    customLists: custom_lists|map(l => {id: l.id, name: l.name, description: l.description}),
    scoutYears: scout_years,
    currentUserEmail: current_user_email,
    unrestricted: unrestricted,
    userSectionIds: user_section_ids,
    forcedSectionId: forced_section_id,
    previousYearCutoff: previous_year_cutoff
}|json_encode(json_flags)|raw }}
</script>
<script src="{{ asset('/assets/js/mass-mail-list.js') }}" defer></script>
{% endblock %}
