{% extends 'email/base.html.twig' %}
{% block content %}
    <h2 style="margin:0 0 20px;font-size:20px;line-height:1.3;color:#212529;">Nouvelles réponses — {{ article_title }}</h2>
    <p style="margin:0 0 16px;">Bonjour,</p>
    <p style="margin:0 0 16px;">
        Le formulaire de <strong>{{ article_title }}</strong> a reçu de nouvelles réponses depuis le
        dernier résumé.
    </p>
    <p style="margin:0 0 16px;">Nombre de nouvelles réponses : <strong>{{ count }}</strong>.</p>
    <p style="margin:24px 0;text-align:center;">
        <a href="{{ responses_url }}"
           style="display:inline-block;padding:12px 28px;background-color:#0d6efd;color:#ffffff;text-decoration:none;border-radius:6px;font-weight:bold;">
            Voir les réponses
        </a>
    </p>
    <p style="margin:0;font-size:13px;color:#6c757d;">
        Vous recevez ce résumé parce que vous êtes l'auteur de cette annonce.
    </p>
{% endblock %}
