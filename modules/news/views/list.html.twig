{% extends "base.html.twig" %}

{% block title %}{{ manage ? 'Rédiger les actualités' : 'Actualités' }} — {{ site_name }}{% endblock %}

{% block stylesheets %}<link rel="stylesheet" href="{{ asset('/assets/css/components.css') }}">{% endblock %}

{% block content %}
    {% if manage %}
        {% include 'partials/page_header.html.twig' with {
            title: 'Rédiger les actualités',
            action_label: 'Nouvel article',
            action_url: '/news/create',
        } only %}
    {% else %}
        {% include 'partials/page_header.html.twig' with { title: 'Actualités' } only %}
    {% endif %}

    {% if articles is empty %}
        {# The creation action already lives in the page header above for a
           manager (one btn-primary per screen, design.md §7.4) — the empty
           state states the fact and never doubles the button. #}
        {% include 'partials/empty_state.html.twig' with {
            message: 'Aucune actualité pour le moment.',
            icon: 'bi-newspaper',
        } only %}
    {% else %}
        <div class="d-flex flex-column gap-3 mx-auto" style="max-width: 720px;">
            {% for row in articles %}
                {% set article = row.article %}
                {#
                  One row, one target. A managing chief goes to the
                  article's management page — where the responses, the
                  preview and the door screen are — and a visitor goes to
                  the public article. The row used to carry both: a
                  stretched-link over the whole card to the public view,
                  and an « Éditer » button escaping it with a
                  position-absolute and a z-index. That is the pattern for
                  a row with a main and a secondary use, except the
                  secondary one was the main one, and the button lied
                  harder with every tab this module gained. The public
                  preview is not lost — it is the « Aperçu » tab.
                #}
                <div class="card">
                    <div class="card-body news-card{{ article.imageFileId or row.is_imported ? '' : ' news-card--no-image' }}">
                        {% if article.imageFileId %}
                            <img src="{{ file_url(article.imageFileId, 'thumb') }}" alt="" class="news-card__image rounded flex-shrink-0"
                                 style="width:100px;height:100px;object-fit:cover;" loading="lazy" decoding="async">
                        {% elseif row.is_imported %}
                            {# D4: an article of the old site may have had no
                               picture, and none is invented — a neutral tile
                               says so, the list keeping its rhythm. #}
                            <div class="news-card__image rounded flex-shrink-0 border bg-body-tertiary text-body-secondary small d-flex align-items-center justify-content-center text-center"
                                 style="width:100px;height:100px;" aria-hidden="true">Pas d'image</div>
                        {% endif %}
                        <div class="news-card__header">
                            <h2 class="h5 mb-1">
                                {# An imported article has no management page (D11):
                                   even a manager lands on the article itself. #}
                                <a href="{{ manage and not row.is_imported ? '/news/' ~ article.id ~ '/gerer' : '/news/' ~ article.id }}" class="text-decoration-none stretched-link">{{ article.title }}</a>
                            </h2>
                            <div class="d-flex flex-wrap align-items-center gap-2 small text-body-secondary mb-2">
                                {% if row.is_imported %}
                                    {% include '@news/partials/_imported_badge.html.twig' only %}
                                {% endif %}
                                {#
                                  The publication state, first and solid,
                                  so it stands out from the light badges
                                  after it (issue #845) — on the manager's
                                  list only: the public one holds nothing
                                  but published articles. The date is the
                                  one the list sorts on: publication, or
                                  creation for a draft.
                                #}
                                {% if manage %}
                                    {% if row.state == 'draft' %}
                                        {% include 'partials/status_badge.html.twig' with { solid: 'dark', label: 'Brouillon' } only %}
                                        <span>Créée le {{ row.date|french_date }}</span>
                                    {% elseif row.state == 'scheduled' %}
                                        {% include 'partials/status_badge.html.twig' with { solid: 'primary', label: row.scheduled_label, wrap: true } only %}
                                    {% else %}
                                        {% include 'partials/status_badge.html.twig' with { solid: 'success', label: 'Publiée' } only %}
                                        <span>Publiée le {{ row.date|french_date }}</span>
                                    {% endif %}
                                {% else %}
                                    <span>{{ row.date|french_date }}</span>
                                {% endif %}
                                {% if row.form_badge == 'open' %}
                                    {% include 'partials/status_badge.html.twig' with { status: 'active', label: 'Formulaire ouvert' } only %}
                                {% elseif row.form_badge == 'closed' %}
                                    {% include 'partials/status_badge.html.twig' with { status: 'closed', label: 'Formulaire fermé' } only %}
                                {% endif %}
                                {% if manage %}
                                    <span class="badge rounded-pill text-bg-light border">
                                        {% if article.visibility == 'public' %}Public
                                        {% elseif article.visibility == 'identified' %}Membres connectés
                                        {% elseif article.visibility == 'chief' %}Chefs
                                        {% elseif article.visibility == 'admin' %}Chefs d'Unité
                                        {% else %}Lien direct
                                        {% endif %}
                                    </span>
                                    {% if row.author_name %}<span>· {{ row.author_name }}</span>{% endif %}
                                {% endif %}
                            </div>
                        </div>
                        {#
                          The summary is read whole (#1359): under the picture
                          and the header on a phone, so it has the card's full
                          width, and beside the picture on a wide screen —
                          one paragraph, placed by the grid (components.css,
                          .news-card), never repeated per screen size. No
                          summary is invented for an imported article that had
                          none (D4): the paragraph is left out.
                        #}
                        {% if row.excerpt %}
                            <p class="news-card__excerpt mb-0">{{ row.excerpt }}</p>
                        {% endif %}
                    </div>
                </div>
            {% endfor %}
        </div>

        {% include 'partials/pagination.html.twig' with {
            page: page,
            total_pages: total_pages,
            base_url: (manage ? '/news/manage' : '/news') ~ '?page=',
            label: 'Pagination des actualités',
        } only %}
    {% endif %}
{% endblock %}
