{% extends "base.html.twig" %}

{% block title %}Actualités — {{ site_name }}{% endblock %}

{% block content %}
    {% if manage %}
        {% include 'partials/page_header.html.twig' with {
            title: 'Actualités',
            action_label: 'Nouvel article',
            action_url: '/news/create',
        } only %}
    {% else %}
        {% include 'partials/page_header.html.twig' with { title: 'Actualités' } only %}
    {% endif %}

    {% if articles is empty %}
        {# The creation action already lives in the page header above for a
           manager (one btn-primary per screen, design.md §7.4) — the empty
           state states the fact and never doubles the button. #}
        {% include 'partials/empty_state.html.twig' with {
            message: 'Aucune actualité pour le moment.',
            icon: 'bi-newspaper',
        } only %}
    {% else %}
        <div class="d-flex flex-column gap-3 mx-auto" style="max-width: 720px;">
            {% for row in articles %}
                {% set article = row.article %}
                <div class="card position-relative">
                    <div class="card-body d-flex gap-3">
                        {% if article.imageFileId %}
                            <img src="{{ file_url(article.imageFileId) }}" alt="" class="rounded flex-shrink-0"
                                 style="width:100px;height:100px;object-fit:cover;">
                        {% endif %}
                        <div class="flex-grow-1" style="min-width:0;">
                            <h2 class="h5 mb-1">
                                <a href="/news/{{ article.id }}" class="text-decoration-none stretched-link">{{ article.title }}</a>
                            </h2>
                            <div class="d-flex flex-wrap align-items-center gap-2 small text-body-secondary mb-2">
                                <span>{{ article.createdAt|french_date }}</span>
                                {% if row.form_badge == 'open' %}
                                    {% include 'partials/status_badge.html.twig' with { status: 'active', label: 'Formulaire ouvert' } only %}
                                {% elseif row.form_badge == 'closed' %}
                                    {% include 'partials/status_badge.html.twig' with { status: 'closed', label: 'Formulaire fermé' } only %}
                                {% endif %}
                                {% if manage %}
                                    <span class="badge rounded-pill text-bg-light border">
                                        {% if article.visibility == 'public' %}Public
                                        {% elseif article.visibility == 'chief' %}Chefs
                                        {% elseif article.visibility == 'admin' %}Chefs d'Unité
                                        {% else %}Lien direct
                                        {% endif %}
                                    </span>
                                    {% if row.author_name %}<span>· {{ row.author_name }}</span>{% endif %}
                                {% endif %}
                            </div>
                            <p class="mb-0" style="display:-webkit-box;-webkit-line-clamp:2;line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;">{{ row.excerpt }}</p>
                        </div>
                    </div>
                    {% if manage %}
                        <a href="/news/{{ article.id }}/edit" class="btn btn-sm btn-outline-secondary position-absolute top-0 end-0 m-2" style="z-index:2;">
                            <i class="bi bi-pencil"></i> Éditer
                        </a>
                    {% endif %}
                </div>
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}
