{% extends "base.html.twig" %}

{% block title %}Confirmation — {{ article.title }} — {{ site_name }}{% endblock %}

{% block head_meta %}
    <meta name="robots" content="noindex">
{% endblock %}

{% block content %}
    <div class="mx-auto" style="max-width: 640px;">
        <div class="text-center mb-4">
            <div style="font-size: 3rem; color: #198754;"><i class="bi bi-check-circle" aria-hidden="true"></i></div>
            <h1 class="h3">Votre réponse a été enregistrée</h1>
        </div>

        <div class="card mb-3">
            <div class="card-body">
                <p><strong>Email de contact :</strong> {{ response.contactEmail }}</p>
                {% for line in answers %}
                    <p class="mb-1"><strong>{{ line.label }} :</strong> {{ line.value }}</p>
                {% endfor %}
            </div>
        </div>

        {% if payment %}
            <div class="card mb-3 border-primary">
                <div class="card-body">
                    <p class="fw-bold fs-5">Montant à payer : {{ payment.total|money }}</p>
                    {# After an edit that raised the amount (issue #1525):
                       what is asked is the difference, and this says why. #}
                    {% if payment.received|default(0) > 0 %}
                        <p class="mb-1">Déjà reçu : {{ payment.received|money }}</p>
                    {% endif %}
                    <p class="mb-1">Compte : {{ payment.beneficiary }}</p>
                    <p class="mb-1">IBAN : {{ payment.iban }}</p>
                    <p class="mb-3">Communication structurée : <strong>{{ payment.communication }}</strong></p>
                    <div class="text-center">
                        <img src="{{ payment.qr_data_uri }}" alt="QR code SEPA" width="200" height="200">
                    </div>
                    <p class="text-body-secondary small text-center mt-2 mb-0">
                        Scannez ce QR code avec votre application bancaire pour effectuer le paiement.
                    </p>
                </div>
            </div>
        {% endif %}

        {# Nothing left to pay on a response that was paid, after an edit
           (issue #1525): the new total and what came in are still said,
           without a payment card asking for nothing. #}
        {% if not payment and amount_received|default(0) > 0 %}
            <div class="card mb-3">
                <div class="card-body">
                    <p class="fw-bold mb-1">Montant de votre réponse : {{ amount_total|money }}</p>
                    <p class="mb-0">Déjà reçu : {{ amount_received|money_cents }}</p>
                </div>
            </div>
        {% endif %}

        {# A paid response corrected down below what came in (issue #1525):
           the family is told the unit owes them the difference, rather than
           left to wonder where their money went. #}
        {% if amount_owed_back|default(0) > 0 %}
            <output class="alert alert-info d-block">
                Vous avez payé {{ amount_owed_back|money_cents }} de plus que le nouveau montant de votre réponse.
                L'unité vous remboursera cette différence : vous n'avez rien à faire.
            </output>
        {% endif %}

        <div class="d-flex flex-column flex-sm-row gap-2 justify-content-center">
            {% if edit_url %}
                <a href="{{ edit_url }}" class="btn btn-outline-primary">Modifier mes réponses</a>
            {% endif %}
            <a href="/news/{{ article.id }}" class="btn btn-outline-secondary">Voir l'article</a>
        </div>
    </div>
{% endblock %}
