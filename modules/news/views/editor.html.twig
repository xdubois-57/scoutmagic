{% extends "base.html.twig" %}

{% block title %}{{ article ? article.title : 'Nouvel article' }} — Actualités — {{ site_name }}{% endblock %}

{% block content %}
    {#
      The <h1> is the article's own title, matching the page's <title>
      (design.md §7.6). This page no longer only EDITS the article — it is
      where its views, its responses and its door screen are reached from,
      which is also why its route reads /gerer rather than /edit.
    #}
    {% include 'partials/page_header.html.twig' with { title: article ? article.title : 'Nouvel article' } only %}

    {% include '@news/partials/_form_tabs.html.twig' with {
        article_id: article ? article.id : null,
        form_id: form_id|default(null),
        active: preview is defined and preview ? 'preview' : 'edit',
        can_view_responses: form is not null,
        finance_link: finance_link|default(null),
    } only %}

    {% if preview is defined and preview %}
        {% include '@news/partials/_editor_preview.html.twig' %}
    {% else %}
        <form method="POST" action="{{ article ? '/news/' ~ article.id : '/news' }}" id="news-editor-form" enctype="multipart/form-data">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token }}">
            <input type="hidden" name="fields_json" id="fields_json_input" value="">

            {% if submit_error %}<div class="alert alert-danger">{{ submit_error }}</div>{% endif %}

            <div class="card mb-3">
                <div class="card-body">
                    <h2 class="h6">Informations générales</h2>
                    <div class="row g-3 align-items-center">
                        <div class="col-12 col-md-3">
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <label for="image" class="editable-image d-inline-block flex-shrink-0" style="cursor:pointer;max-width:140px;" aria-label="Modifier l'image de l'article">
                                    <div class="editable-overlay">
                                        <i class="bi bi-camera text-white fs-4" aria-hidden="true"></i>
                                    </div>
                                    <img id="news-image-preview" src="{{ (article and article.imageFileId) ? file_url(article.imageFileId) : '' }}" alt=""
                                         class="rounded d-block {{ (article and article.imageFileId) ? '' : 'd-none' }}" style="max-width:140px;max-height:140px;width:auto;height:auto;">
                                    <div id="news-image-placeholder" class="d-flex align-items-center justify-content-center bg-body-tertiary rounded {{ (article and article.imageFileId) ? 'd-none' : '' }}" style="width:110px;height:110px;">
                                        <i class="bi bi-image text-body-secondary" style="font-size:1.5rem;" aria-hidden="true"></i>
                                    </div>
                                </label>
                                <span id="news-image-label" class="fw-medium {{ (article and article.imageFileId) ? 'd-none' : '' }}">Image <span class="text-danger">*</span></span>
                            </div>
                            <input type="file" class="visually-hidden" name="image" id="image" accept="image/jpeg,image/png,image/webp,image/gif" {{ (article and article.imageFileId) ? '' : 'required' }}>
                            <div class="form-text">
                                {% if article and article.imageFileId %}Cliquez sur l'image pour la remplacer.{% endif %}
                                Format carré ou paysage, en haute résolution pour le partage sur les réseaux sociaux.
                            </div>
                        </div>
                        <div class="col-12 col-md-9">
                            {# Visually hidden rather than aria-label: a real, linked label
                               element is announced by every assistive technology and is
                               what the rest of this codebase uses. The placeholder carries
                               the same wording for sighted users, so nothing changes
                               visually. (No literal HTML tag in this comment: Twig comments
                               are not HTML comments, so an analyser reading the source text
                               takes one for a real, unlabelled form control.) #}
                            <label class="visually-hidden" for="news-title">Titre de l'article</label>
                            <input type="text" class="form-control form-control-lg mb-3" id="news-title" name="title"
                                   placeholder="Titre de l'article" value="{{ title_value }}" required>

                            <label class="form-label" for="summary">Résumé en une phrase <span class="text-danger">*</span></label>
                            <div class="d-flex gap-2">
                                <input type="text" class="form-control" name="summary" id="summary" maxlength="300" placeholder="Ex : Venez nombreux au camp d'été 2026 !"
                                       value="{{ summary_value }}" required>
                                {% if seo_ai_available %}
                                    {% include 'partials/ai_button.html.twig' with {
                                        id: 'news-ai-summary-btn', label: "Générer avec l'IA", disabled: true,
                                    } only %}
                                {% endif %}
                            </div>
                            <div class="form-text">Affiché dans la liste des actualités, sur l'affiche, et lors du partage sur les réseaux sociaux. Doit donner envie de cliquer !</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-body">
                    <h2 class="h6">Visibilité</h2>
                    <div class="btn-group d-flex flex-wrap" role="group" id="news-visibility-group">
                        <input type="radio" class="btn-check" name="visibility" id="vis-public" value="public" {{ visibility_value == 'public' ? 'checked' : '' }}>
                        <label class="btn btn-outline-primary" for="vis-public">Public</label>
                        <input type="radio" class="btn-check" name="visibility" id="vis-identified" value="identified" {{ visibility_value == 'identified' ? 'checked' : '' }}>
                        <label class="btn btn-outline-primary" for="vis-identified">Membres connectés</label>
                        <input type="radio" class="btn-check" name="visibility" id="vis-chief" value="chief" {{ visibility_value == 'chief' ? 'checked' : '' }}>
                        <label class="btn btn-outline-primary" for="vis-chief">Animateurs</label>
                        <input type="radio" class="btn-check" name="visibility" id="vis-admin" value="admin" {{ visibility_value == 'admin' ? 'checked' : '' }}>
                        <label class="btn btn-outline-primary" for="vis-admin">Chefs d'Unité</label>
                        <input type="radio" class="btn-check" name="visibility" id="vis-direct_link" value="direct_link" {{ visibility_value == 'direct_link' ? 'checked' : '' }}>
                        <label class="btn btn-outline-primary" for="vis-direct_link">Lien direct</label>
                    </div>
                    <p class="form-text d-none" id="news-direct-link-help">
                        Cet article n'apparaîtra dans aucune liste. Il sera accessible uniquement par son URL ou via le QR code de l'affiche.
                    </p>
                    <p class="form-text d-none" id="news-identified-help">
                        Cet article sera visible par les animés, leurs parents et les animateurs, une fois connectés. Il ne sera pas référencé, et un lien partagé sur les réseaux sociaux n'affichera ni titre, ni résumé, ni image.
                    </p>
                    <p class="form-text">
                        Public et Lien direct ne nécessitent pas de connexion pour répondre au formulaire ; Membres connectés, Animateurs et Chefs d'Unité si.
                    </p>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-body">
                    <h2 class="h6" id="news-form-box-heading">Article</h2>
                    <div id="news-form-builder">
                        {% include '@news/partials/_form_builder.html.twig' %}
                    </div>
                </div>
            </div>

            <div class="card mb-3 d-none" id="news-form-settings">
                <div class="card-body">
                    <h2 class="h6">Paramètres du formulaire</h2>
                    {% include '@news/partials/_form_settings.html.twig' %}
                </div>
            </div>

            <div class="card mb-3" id="news-seo-section">
                <div class="card-body">
                    <h2 class="h6">Référencement</h2>
                    <div class="form-check form-switch mb-2">
                        <input class="form-check-input" type="checkbox" role="switch" name="is_indexed" id="is_indexed" value="1"
                               aria-checked="{{ is_indexed_value ? 'true' : 'false' }}">
                        <label class="form-check-label" for="is_indexed">Indexer cette page dans les moteurs de recherche</label>
                    </div>
                    <div id="news-seo-fields" class="{{ is_indexed_value ? '' : 'd-none' }}">
                        <div class="mb-2">
                            <label class="form-label" for="seo_keywords">Mots-clés</label>
                            <div class="d-flex gap-2">
                                <input type="text" class="form-control" name="seo_keywords" id="seo_keywords" value="{{ seo_keywords_value }}" placeholder="camp, été, inscription">
                                {% if seo_ai_available %}
                                    {% include 'partials/ai_button.html.twig' with {
                                        id: 'news-ai-keywords-btn', label: "Générer les mots-clés avec l'IA", disabled: true,
                                    } only %}
                                {% endif %}
                            </div>
                        </div>
                        <div class="mb-2">
                            <label class="form-label" for="seo_stop_date">Arrêter l'indexation le</label>
                            <input type="date" class="form-control" name="seo_stop_date" id="seo_stop_date" value="{{ seo_stop_date_value }}">
                        </div>
                    </div>
                </div>
            </div>

            {% if article %}
                <div class="card mb-3">
                    <div class="card-body">
                        <h2 class="h6">Affiche &amp; QR code</h2>
                        {% if short_url %}
                            <p class="mb-2">Affiche A4 avec QR code vers {{ short_url }}</p>
                            <a href="/news/{{ article.id }}/poster" class="btn btn-outline-secondary">
                                <i class="bi bi-file-earmark-pdf" aria-hidden="true"></i> Télécharger le PDF
                            </a>
                        {% else %}
                            <p class="text-body-secondary mb-0">Enregistrez l'article pour générer le lien court.</p>
                        {% endif %}
                    </div>
                </div>
            {% endif %}

            <div class="d-flex flex-column flex-sm-row gap-2 justify-content-between">
                <button type="submit" class="btn btn-primary">Enregistrer</button>
                {% if article %}
                    <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#news-delete-modal">Supprimer</button>
                {% endif %}
            </div>
        </form>

        {% if article %}
            {# article_id rides along in the embed context: with `only`, the
               blocks below no longer see this template's own variables. #}
            {% embed 'partials/modal.html.twig' with { id: 'news-delete-modal', title: 'Confirmer la suppression', article_id: article.id } only %}
                {% block body %}
                    Supprimer cet article et son formulaire ? Cette action est irréversible.
                {% endblock %}
                {% block footer %}
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Annuler</button>
                    <button type="button" class="btn btn-danger" id="news-delete-confirm-btn" data-id="{{ article_id }}">Supprimer</button>
                {% endblock %}
            {% endembed %}
        {% endif %}
    {% endif %}
{% endblock %}

{% block scripts %}
{# Server data as a JSON ISLAND, not an inline assignment: an island is
   data to the parser, so a field label or a confirmation text — free
   text an animateur types — cannot end the block in the middle of an
   object literal, and the template needs no nonce for it.
   news-form-builder.js reads it through ScoutMagicApi.pageData(). #}
{% set json_flags = constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_UNESCAPED_UNICODE') %}
<script type="application/json" id="news-editor-data">
{{ {
    articleId: article ? article.id : null,
    fields: fields_override is defined ? fields_override : fields|map(f => {
        id: f.id, field_type: f.fieldType, label: f.label, is_required: f.isRequired,
        options_source: f.optionsSource, options_manual: f.optionsManual,
        capacity_max: f.capacityMax, price_per_unit: f.pricePerUnit,
        confirmation_text: f.confirmationText
    }),
    financeAvailable: finance_available,
    financeAccounts: finance_accounts,
    form: form ? {
        access: form.access, response_limit: form.responseLimit,
        opens_at: form.opensAt, closes_at: form.closesAt,
        is_force_closed: form.isForceClosed, response_role_min: form.responseRoleMin,
        daily_digest_enabled: form.dailyDigestEnabled,
        finance_account_id: form.financeAccountId
    } : null
}|json_encode(json_flags)|raw }}
</script>
<script src="{{ asset('/assets/js/news-form-builder.js') }}" defer></script>
{% endblock %}
