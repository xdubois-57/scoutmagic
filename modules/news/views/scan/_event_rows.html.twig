{#
  One row per controllable event. Rendered server-side on first load AND
  rebuilt client-side as the search is typed — news-scan-events.js
  reproduces this markup, so the two must be changed together.

  A plain <a>: choosing an event navigates (see index.html.twig).
#}
{% for event in events %}
    <a href="/news/scan/{{ event.form_id }}" class="list-group-item list-group-item-action d-flex align-items-center gap-3">
        <i class="bi bi-ticket-perforated fs-4 text-body-secondary" aria-hidden="true"></i>
        <span class="flex-grow-1 min-w-0">
            <span class="d-block fw-semibold text-truncate">{{ event.title }}</span>
            <span class="d-block small text-body-secondary text-truncate">
                {% if event.event_date %}{{ event.event_date|french_date }}{% else %}date non renseignée{% endif %}
                {%- if event.event_location %} — {{ event.event_location }}{% endif %}
            </span>
        </span>
        <span class="small text-body-secondary text-nowrap">{{ event.seats }} place{{ event.seats > 1 ? 's' : '' }}</span>
    </a>
{% else %}
    <p class="text-body-secondary fst-italic mb-0 px-1">Aucun évènement ne correspond.</p>
{% endfor %}
