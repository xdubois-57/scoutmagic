      "menu_icon": "bi-pencil-square",
      "breadcrumb": { "label": "Actualités", "parents": ["Espace chefs"] }
    },
    {
      "path": "/news/create",
      "method": "GET",
      "controller": "Modules\\News\\Controller\\NewsController",
      "action": "create",
      "menu": "espace_chefs",
      "role_min": "chief",
      "label": "",
      "breadcrumb": { "label": "Nouvel article", "parents": ["Espace chefs"] }
    },
