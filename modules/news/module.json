{
  "id": "news",
  "name": "Actualités",
  "description": "Articles d'actualité avec formulaires intégrés (inscriptions, paiements optionnels), référencement SEO et affiche A4 avec QR code.",
  "version": "1.7.0",
  "enabled_by_default": true,
  "routes": [
    {
      "path": "/news",
      "method": "GET",
      "controller": "Modules\\News\\Controller\\NewsController",
      "action": "index",
      "menu": "notre_unite",
      "role_min": "public",
      "label": "Actualités",
      "menu_icon": "bi-newspaper",
      "breadcrumb": { "label": "Actualités", "parents": ["Notre unité"] }
    },
    {
      "path": "/news/manage",
      "method": "GET",
      "controller": "Modules\\News\\Controller\\NewsController",
      "action": "manage",
      "menu": "espace_chefs",
      "role_min": "chief",
      "label": "Actualités",
      "menu_icon": "bi-pencil-square",
      "menu_group": "communication",
      "breadcrumb": { "label": "Actualités", "parents": ["Espace animateurs"] }
    },
    {
      "path": "/news/create",
      "method": "GET",
      "controller": "Modules\\News\\Controller\\NewsController",
      "action": "create",
      "menu": "espace_chefs",
      "role_min": "chief",
      "label": "",
      "breadcrumb": { "label": "Nouvel article", "parents": ["Espace animateurs"], "ancestors": [{ "label": "Actualités", "path": "/news/manage" }] }
    },
    {
      "path": "/news/seo/generate-keywords",
      "method": "POST",
      "controller": "Modules\\News\\Controller\\NewsController",
      "action": "generateSeoKeywords",
      "menu": "espace_chefs",
      "role_min": "chief",
      "label": ""
    },
    {
      "path": "/news/seo/generate-summary",
      "method": "POST",
      "controller": "Modules\\News\\Controller\\NewsController",
      "action": "generateSummary",
      "menu": "espace_chefs",
      "role_min": "chief",
      "label": ""
    },
    {
      "path": "/news/images/upload",
      "method": "POST",
      "controller": "Modules\\News\\Controller\\NewsController",
      "action": "uploadBodyImage",
      "menu": "espace_chefs",
      "role_min": "chief",
      "label": ""
    },
    {
      "path": "/news",
      "method": "POST",
      "controller": "Modules\\News\\Controller\\NewsController",
      "action": "store",
      "menu": "espace_chefs",
      "role_min": "chief",
      "label": "",
      "breadcrumb": { "label": "Nouvel article", "parents": ["Espace animateurs"] }
    },
    {
      "path": "/news/qr/{reference}/{token}",
      "method": "GET",
      "controller": "Modules\\News\\Controller\\TicketQrController",
      "action": "png",
      "menu": "notre_unite",
      "role_min": "public",
      "label": ""
    },
    {
      "path": "/news/scan",
      "method": "GET",
      "controller": "Modules\\News\\Controller\\ScanController",
      "action": "index",
      "menu": "espace_chefs",
      "role_min": "chief",
      "label": "",
      "breadcrumb": { "label": "Scanner un billet", "parents": ["Espace animateurs"], "ancestors": [{ "label": "Actualités", "path": "/news/manage" }] }
    },
    {
      "path": "/news/scan/events",
      "method": "GET",
      "controller": "Modules\\News\\Controller\\ScanController",
      "action": "searchEvents",
      "menu": "espace_chefs",
      "role_min": "chief",
      "label": ""
    },
    {
      "path": "/news/scan/{form_id}",
      "method": "GET",
      "controller": "Modules\\News\\Controller\\ScanController",
      "action": "event",
      "menu": "espace_chefs",
      "role_min": "chief",
      "label": "",
      "breadcrumb": { "label": "Scanner un billet", "parents": ["Espace animateurs"], "ancestors": [{ "label": "Actualités", "path": "/news/manage" }] }
    },
    {
      "path": "/news/scan/{form_id}/lookup",
      "method": "GET",
      "controller": "Modules\\News\\Controller\\ScanController",
      "action": "lookup",
      "menu": "espace_chefs",
      "role_min": "chief",
      "label": ""
    },
    {
      "path": "/news/scan/{form_id}/validate",
      "method": "POST",
      "controller": "Modules\\News\\Controller\\ScanController",
      "action": "validate",
      "menu": "espace_chefs",
      "role_min": "chief",
      "label": ""
    },
    {
      "path": "/news/scan/{form_id}/liste",
      "method": "GET",
      "controller": "Modules\\News\\Controller\\ScanController",
      "action": "printableList",
      "menu": "espace_chefs",
      "role_min": "chief",
      "label": ""
    },
    {
      "path": "/news/{id}",
      "method": "GET",
      "controller": "Modules\\News\\Controller\\NewsController",
      "action": "show",
      "menu": "notre_unite",
      "role_min": "public",
      "label": "",
      "breadcrumb": { "label": "Actualité", "parents": ["Notre unité"], "ancestors": [{ "label": "Actualités", "path": "/news" }] }
    },
    {
      "path": "/news/{id}/gerer",
      "method": "GET",
      "controller": "Modules\\News\\Controller\\NewsController",
      "action": "edit",
      "menu": "espace_chefs",
      "role_min": "chief",
      "label": "",
      "breadcrumb": { "label": "Gérer l'article", "parents": ["Espace animateurs"], "ancestors": [{ "label": "Actualités", "path": "/news/manage" }] }
    },
    {
      "path": "/news/{id}",
      "method": "POST",
      "controller": "Modules\\News\\Controller\\NewsController",
      "action": "update",
      "menu": "espace_chefs",
      "role_min": "chief",
      "label": "",
      "breadcrumb": { "label": "Gérer l'article", "parents": ["Espace animateurs"] }
    },
    {
      "path": "/news/{id}",
      "method": "DELETE",
      "controller": "Modules\\News\\Controller\\NewsController",
      "action": "delete",
      "menu": "espace_chefs",
      "role_min": "chief",
      "label": ""
    },
    {
      "path": "/news/{id}/poster",
      "method": "GET",
      "controller": "Modules\\News\\Controller\\NewsController",
      "action": "poster",
      "menu": "espace_chefs",
      "role_min": "chief",
      "label": ""
    },
    {
      "path": "/news/{id}/form/submit",
      "method": "POST",
      "controller": "Modules\\News\\Controller\\FormController",
      "action": "submit",
      "menu": "notre_unite",
      "role_min": "public",
      "label": "",
      "breadcrumb": { "label": "Actualité", "parents": ["Notre unité"] }
    },
    {
      "path": "/news/{id}/form/responses",
      "method": "GET",
      "controller": "Modules\\News\\Controller\\FormController",
      "action": "responses",
      "menu": "espace_chefs",
      "role_min": "intendant",
      "label": "",
      "breadcrumb": { "label": "Réponses au formulaire", "parents": ["Espace animateurs"] }
    },
    {
      "path": "/news/{id}/form/responses/export",
      "method": "GET",
      "controller": "Modules\\News\\Controller\\FormController",
      "action": "exportResponses",
      "menu": "espace_chefs",
      "role_min": "intendant",
      "label": ""
    },
    {
      "path": "/news/{id}/form/responses/mail-draft",
      "method": "POST",
      "controller": "Modules\\News\\Controller\\FormController",
      "action": "createMailDraft",
      "menu": "espace_chefs",
      "role_min": "chief",
      "label": ""
    },
    {
      "path": "/news/{id}/form/responses/{response_id}/edit",
      "method": "GET",
      "controller": "Modules\\News\\Controller\\FormController",
      "action": "editResponse",
      "menu": "notre_unite",
      "role_min": "public",
      "label": "",
      "breadcrumb": { "label": "Modifier ma réponse", "parents": ["Notre unité"] }
    },
    {
      "path": "/news/{id}/form/responses/{response_id}/edit",
      "method": "POST",
      "controller": "Modules\\News\\Controller\\FormController",
      "action": "updateResponse",
      "menu": "notre_unite",
      "role_min": "public",
      "label": "",
      "breadcrumb": { "label": "Modifier ma réponse", "parents": ["Notre unité"] }
    },
    {
      "path": "/news/{id}/form/fields/reorder",
      "method": "PATCH",
      "controller": "Modules\\News\\Controller\\FormController",
      "action": "reorderFields",
      "menu": "espace_chefs",
      "role_min": "chief",
      "label": ""
    }
  ],
  "settings": [],
  "cookies": [],
  "scheduled_tasks": [
    {
      "key": "send_response_digest",
      "handler": "Modules\\News\\Task\\SendResponseDigestHandler"
    },
    {
      "key": "generate_image_variants",
      "handler": "Modules\\News\\Task\\GenerateImageVariantsHandler"
    },
    {
      "key": "send_pending_tickets",
      "handler": "Modules\\News\\Task\\SendPendingTicketsHandler"
    }
  ],
  "storage": {
    "images": {
      "role_min": "public"
    }
  },
  "emails": [
    {
      "id": "news.confirmation",
      "label": "Confirmation d'inscription à une activité",
      "description": "Envoyé à qui vient de répondre au formulaire d'un article, avec le récapitulatif de sa réponse.",
      "default_subject": "Confirmation — {{ article_title }}",
      "template": "@news/email/confirmation.html.twig",
      "variables": [
        {
          "name": "article_title",
          "label": "Titre de l'article",
          "example": "Week-end de Pâques"
        },
        {
          "name": "answers_summary",
          "label": "Récapitulatif des réponses",
          "example": "Nom de l'enfant : Camille Dupont\nTaille du t-shirt : 140"
        },
        {
          "name": "payment_summary",
          "label": "Détails du paiement",
          "example": "Montant à payer : 45,00 €\nCompte : Unité Saint-Georges\nIBAN : BE68 5390 0754 7034\nCommunication structurée : +++123/4567/89012+++"
        },
        {
          "name": "edit_url",
          "label": "Lien pour modifier la réponse",
          "example": "https://exemple.be/news/12/reponse/abc"
        },
        {
          "name": "ticket_reference",
          "label": "Référence du billet",
          "example": "X7K2-9QMF-A3"
        },
        {
          "name": "event_summary",
          "label": "Date et lieu de l'évènement",
          "example": "Date : 14/03/2026\nLieu : Salle paroissiale, Ottignies"
        }
      ]
    },
    {
      "id": "news.ticket",
      "label": "Billet d'un évènement",
      "description": "Envoyé aux personnes déjà inscrites le jour où la billetterie est activée sur le formulaire, pour qu'elles ne se présentent pas les mains vides. Les inscriptions suivantes reçoivent leur billet dans l'e-mail de confirmation.",
      "default_subject": "Votre billet — {{ article_title }}",
      "template": "@news/email/ticket.html.twig",
      "variables": [
        {
          "name": "article_title",
          "label": "Titre de l'article",
          "example": "Souper spaghetti"
        },
        {
          "name": "ticket_reference",
          "label": "Référence du billet",
          "example": "X7K2-9QMF-A3"
        },
        {
          "name": "event_summary",
          "label": "Date et lieu de l'évènement",
          "example": "Date : 14/03/2026\nLieu : Salle paroissiale, Ottignies"
        }
      ]
    },
    {
      "id": "news.digest",
      "label": "Résumé des nouvelles réponses",
      "description": "Envoyé à l'auteur d'un article quand de nouvelles réponses à son formulaire sont arrivées.",
      "default_subject": "Nouvelles réponses — {{ article_title }}",
      "template": "@news/email/digest.html.twig",
      "variables": [
        {
          "name": "article_title",
          "label": "Titre de l'article",
          "example": "Week-end de Pâques"
        },
        {
          "name": "count",
          "label": "Nombre de nouvelles réponses",
          "example": "3"
        },
        {
          "name": "responses_url",
          "label": "Lien vers les réponses",
          "example": "https://exemple.be/news/12/reponses"
        }
      ]
    }
  ]
}
