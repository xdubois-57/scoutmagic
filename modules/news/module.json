      "controller": "Modules\\News\\Controller\\NewsController",
      "action": "index",
      "menu": "notre_unite",
      "role_min": "public",
      "label": "Actualités",
      "menu_icon": "bi-newspaper",
      "breadcrumb": { "label": "Actualités", "parents": ["Notre unité"] }
    },
    {
