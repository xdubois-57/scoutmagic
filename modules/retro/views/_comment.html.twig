{# comment: the same {id, column, body, votes, hidden, youVoted} shape RetroBoardController::serializeComment()
   sends to the JS poller — body/votes are null when hidden from a non-unit-chief viewer (see
   RetroBoardController::isUnitChief() — narrower than any chief). youVoted reflects
   this viewer's own vote and must survive a poll re-render (see retro-board.js), otherwise the
   like button silently resets to "not liked" every few seconds even though the vote is still recorded.
   Inherits board/is_unit_chief/can_vote from the including template's scope (Twig's default
   include behavior merges, rather than replaces, context). #}
<div class="border rounded p-2 retro-comment" data-comment-id="{{ comment.id }}" data-hidden="{{ comment.hidden ? '1' : '0' }}">
    {% if comment.body is null %}
        <p class="mb-0 small fst-italic text-body-secondary" data-comment-body>Mot masqué.</p>
    {% else %}
        {% if comment.hidden %}
            <span class="badge text-bg-warning mb-1">Masqué — visible par le chef d'unité uniquement</span>
        {% endif %}
        <p class="mb-1 small {{ comment.hidden ? 'text-decoration-line-through text-body-secondary' : '' }}" data-comment-body>{{ comment.body }}</p>
        <div class="d-flex justify-content-between align-items-center gap-2">
            <div class="d-flex align-items-center gap-1">
                {% if board.status == 'open' and can_vote %}
                    {% if board.voteMode == 'unlimited' %}
                        <button type="button" class="btn btn-sm py-0 px-2 retro-vote-like {{ comment.youVoted ? 'btn-danger' : 'btn-outline-danger' }}"
                                data-comment-id="{{ comment.id }}" title="J'aime" aria-label="J'aime">
                            <i class="bi bi-heart{{ comment.youVoted ? '-fill' : '' }}" aria-hidden="true"></i>
                        </button>
                    {% else %}
                        <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2 retro-vote-remove" data-comment-id="{{ comment.id }}" title="Retirer un point" aria-label="Retirer un point">−</button>
                        <button type="button" class="btn btn-sm btn-outline-success py-0 px-2 retro-vote-add" data-comment-id="{{ comment.id }}" title="Ajouter un point" aria-label="Ajouter un point">+</button>
                    {% endif %}
                {% endif %}
                <span class="small text-body-secondary" data-comment-votes>{{ comment.votes is null ? '—' : comment.votes }}</span>
            </div>
            {% if is_unit_chief %}
                <button type="button" class="btn btn-sm {{ comment.hidden ? 'btn-outline-success' : 'btn-outline-warning' }} {{ comment.hidden ? 'retro-unhide' : 'retro-hide' }}"
                        data-comment-id="{{ comment.id }}">
                    <i class="bi bi-{{ comment.hidden ? 'eye' : 'eye-slash' }}" aria-hidden="true"></i> {{ comment.hidden ? 'Réafficher' : 'Masquer' }}
                </button>
            {% endif %}
        </div>
    {% endif %}
</div>
