{% extends 'base.html.twig' %}
{% block title %}{{ board.title }} — {{ param('site_name') }}{% endblock %}
{% block content %}
    <div class="container py-4" id="retro-board"
         data-token="{{ token }}"
         data-csrf="{{ csrf_token }}"
         data-poll-interval="{{ polling_interval_seconds }}"
         data-status="{{ board.status }}"
         data-can-vote="{{ can_vote ? '1' : '0' }}"
         data-vote-mode="{{ board.voteMode }}"
         data-is-unit-chief="{{ is_unit_chief ? '1' : '0' }}"
         data-max-length="{{ board.maxCommentLength }}"
         data-ai-available="{{ ai_available ? '1' : '0' }}"
         data-remaining-budget="{{ remaining_budget !== null ? remaining_budget : '' }}">
        <div class="d-flex align-items-start justify-content-between gap-2 mb-2">
            <h1 class="h3 mb-0">{{ board.title }}</h1>
            <span class="badge {{ board.status == 'open' ? 'text-bg-success' : 'text-bg-secondary' }}">
                {{ board.status == 'open' ? 'Ouvert' : 'Clôturé' }}
            </span>
        </div>
        {% if board.voteMode == 'budget' and board.status == 'open' and can_vote %}
            <p class="small text-body-secondary mb-2">
                <i class="bi bi-coin"></i> Il te reste <strong id="retro-budget-remaining">{{ remaining_budget !== null ? remaining_budget : board.voteBudget }}</strong> point(s) à distribuer.
            </p>
        {% endif %}
        <p class="text-body-secondary small">
            Dis ce que tu penses, en toute liberté — personne ne saura qui a écrit quoi.
        </p>

        <button class="btn btn-link btn-sm p-0 mb-2" type="button" data-bs-toggle="collapse" data-bs-target="#retro-anonymity-info">
            <i class="bi bi-shield-check"></i> Pourquoi c'est vraiment anonyme ?
        </button>
        <div class="collapse mb-3" id="retro-anonymity-info">
            <div class="alert alert-success small mb-0">
                <p class="mb-2">Tes mots ne sont jamais associés à ton compte : rien dans la base de données ne permet de savoir qui a écrit quoi — même les chefs d'unité et les administrateurs du site n'y ont pas accès.</p>
                {% if vote_requires_auth %}
                    <p class="mb-2">Se connecter sert uniquement à vérifier que tu ne votes pas deux fois pour le même mot. Cette vérification passe par un code à sens unique : personne ne peut s'en servir pour retrouver ton identité.</p>
                {% endif %}
                <p class="mb-0">Un chef d'unité peut masquer un mot en cas de propos injurieux ou d'attaque personnelle, mais ne verra jamais qui l'a écrit.</p>
            </div>
        </div>

        {% if is_unit_chief %}
            <div class="alert alert-warning small d-flex gap-2">
                <i class="bi bi-exclamation-triangle flex-shrink-0"></i>
                <span>Masquer un mot est une mesure de <strong>dernier recours</strong> — réservée aux propos injurieux ou aux attaques personnelles, jamais à un simple désaccord. L'action reste réversible. Seul le chef d'unité peut voir et lever un masquage.</span>
            </div>
        {% endif %}

        {% if vote_requires_auth and not can_vote %}
            <div class="alert alert-info small d-flex gap-2">
                <i class="bi bi-box-arrow-in-right flex-shrink-0"></i>
                <span>Tu peux toujours ajouter des mots anonymement. Pour voter, connecte-toi avec ton email — juste pour s'assurer qu'une même personne ne vote pas deux fois, ton identité reste invisible des autres.</span>
            </div>
        {% endif %}

        <div class="d-flex align-items-center gap-2 bg-white border rounded px-3 py-2 mb-1 flex-wrap">
            <span class="text-body-secondary small text-truncate flex-grow-1">{{ public_url }}</span>
            <button type="button" class="btn btn-sm btn-outline-secondary" id="retro-qr-toggle">
                <i class="bi bi-qr-code"></i> QR code
            </button>
            <button type="button" class="btn btn-sm btn-outline-secondary" id="retro-copy-link" data-url="{{ public_url }}">
                <i class="bi bi-clipboard"></i> Copier
            </button>
        </div>
        <div class="d-none mb-3" id="retro-qr-container">
            <img src="/r/{{ token }}/qr" alt="QR code" class="border rounded p-2 bg-white" style="width: 180px; height: 180px;">
        </div>

        {% if board.status == 'closed' and board.aiSummary %}
            <div class="alert alert-info">
                <div class="fw-semibold small mb-1"><i class="bi bi-stars"></i> Synthèse générée automatiquement</div>
                <div class="small" style="white-space: pre-line;">{{ board.aiSummary }}</div>
            </div>
        {% endif %}

        <div class="row g-3 mt-1">
            {% set col_colors = {'good': 'success', 'improve': 'warning', 'suggestion': 'primary'} %}
            {% for col, label in {'good': "Ce qui a bien marché", 'improve': "À améliorer", 'suggestion': "Autres suggestions"} %}
                <div class="col-12 col-md-4">
                    <div class="card h-100 border-top-0">
                        <div class="card-header d-flex justify-content-between align-items-center border-top border-3 border-{{ col_colors[col] }}">
                            <span class="fw-semibold small text-{{ col_colors[col] }}">{{ label }}</span>
                            <span class="badge text-bg-secondary" data-count-for="{{ col }}">{{ columns[col]|length }}</span>
                        </div>
                        <div class="card-body d-flex flex-column gap-3">
                            {% if board.status == 'open' %}
                                <form class="retro-comment-form" data-column="{{ col }}">
                                    {# Client-side ceiling only, independent of the board's own configured
                                       max — never blocks typing before the counter can even turn red;
                                       the server always re-validates against board.maxCommentLength. #}
                                    <textarea class="form-control form-control-sm mb-1" rows="2" maxlength="300"
                                              placeholder="Ajouter un mot…" data-draft-input></textarea>
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="small text-danger d-none" data-draft-error></span>
                                        <span class="small text-body-secondary ms-auto" data-draft-counter>0/{{ board.maxCommentLength }}</span>
                                    </div>
                                    <button type="button" class="btn btn-sm btn-outline-primary d-none" data-shorten-btn>
                                        <i class="bi bi-magic"></i> Raccourcir avec l'IA
                                    </button>
                                    <button type="submit" class="btn btn-sm btn-success">
                                        <i class="bi bi-plus-lg"></i> Ajouter
                                    </button>
                                    <div class="d-none mt-2" data-moderation-alert></div>
                                </form>
                            {% endif %}

                            <div class="d-flex flex-column gap-2" data-comment-list="{{ col }}">
                                {% for comment in columns[col] %}
                                    {% include '@retro/_comment.html.twig' with { comment: comment } %}
                                {% else %}
                                    <p class="text-body-secondary small fst-italic mb-0">Aucun mot pour l'instant.</p>
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
{% endblock %}

{% block scripts %}
    {# retro-board.js builds each comment card's markup directly in JS (mirroring
       retro/_comment.html.twig's structure) using the #retro-board container's
       data-* attributes above (vote-mode/is-chief/can-vote/status) — a poll response
       only ever carries the {id, column, body, votes, hidden} fields themselves. #}
    <script src="/assets/js/retro-board.js" defer nonce="{{ csp_nonce }}"></script>
{% endblock %}
