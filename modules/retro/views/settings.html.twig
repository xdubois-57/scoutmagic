{% extends "base.html.twig" %}

{% block title %}Rétrospectives — Configuration — {{ site_name }}{% endblock %}

{% block content %}
    {% include 'partials/page_header.html.twig' with { title: 'Rétrospectives — Configuration' } only %}

    {% if submit_error %}
        <div class="alert alert-danger">{{ submit_error }}</div>
    {% endif %}

    <form method="post" action="/config/retro" novalidate>
        <input type="hidden" name="_csrf_token" value="{{ csrf_token }}">

        <div class="card mb-4">
            <div class="card-body">
                <h2 class="h6 mb-3">Rôles</h2>
                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        {% include 'partials/form_field.html.twig' with {
                            field_id: 'retro-role-min-create', field_name: 'retro_role_min_create_board',
                            label: 'Rôle minimum pour créer un board', type: 'select', size: 'sm',
                            wrapper_class: '',
                            options: {'intendant': 'Intendant', 'chief': 'Chef', 'admin': "Chef d'Unité"}|map((label, value) => {
                                value: value, label: label, selected: retro_role_min_create_board == value
                            }),
                        } only %}
                    </div>
                    <div class="col-12 col-md-6">
                        {% include 'partials/form_field.html.twig' with {
                            field_id: 'retro-role-min-close', field_name: 'retro_role_min_close_board',
                            label: 'Rôle minimum pour clôturer un board', type: 'select', size: 'sm',
                            wrapper_class: '',
                            options: {'chief': 'Chef', 'admin': "Chef d'Unité"}|map((label, value) => {
                                value: value, label: label, selected: retro_role_min_close_board == value
                            }),
                        } only %}
                    </div>
                </div>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-body">
                <h2 class="h6 mb-3">Valeurs par défaut</h2>
                <div class="row g-3">
                    <div class="col-12 col-md-4">
                        {% include 'partials/form_field.html.twig' with {
                            field_id: 'retro-max-length', field_name: 'retro_default_max_comment_length',
                            label: "Longueur max. d'un mot par défaut", type: 'number', min: 120, max: 200,
                            value: retro_default_max_comment_length, size: 'sm', wrapper_class: '',
                            help: 'Entre 120 et 200 caractères.',
                        } only %}
                    </div>
                    <div class="col-12 col-md-4">
                        {% include 'partials/form_field.html.twig' with {
                            field_id: 'retro-vote-budget', field_name: 'retro_default_vote_budget',
                            label: 'Budget de points par défaut', type: 'number', min: 1,
                            value: retro_default_vote_budget, size: 'sm', wrapper_class: '',
                        } only %}
                    </div>
                    <div class="col-12 col-md-4">
                        {% include 'partials/form_field.html.twig' with {
                            field_id: 'retro-polling-interval', field_name: 'retro_polling_interval_seconds',
                            label: "Intervalle d'actualisation (secondes)", type: 'number', min: 3, max: 60,
                            value: retro_polling_interval_seconds, size: 'sm', wrapper_class: '',
                            help: 'Entre 3 et 60 secondes — fréquence à laquelle une rétrospective ouverte vérifie les nouveaux mots/votes.',
                        } only %}
                    </div>
                </div>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-body">
                <h2 class="h6 mb-3">Modération automatique par IA</h2>
                {% if not ai_available %}
                    <div class="alert alert-warning small py-2 mb-3">
                        Aucun connecteur IA actif — seule l'option « Désactivée » a un effet tant qu'aucun n'est configuré.
                    </div>
                {% endif %}
                <label class="form-label small" for="retro-moderation-mode">Mode de modération</label>
                <select class="form-select" id="retro-moderation-mode" name="retro_moderation_mode" style="max-width: 20rem;" {{ ai_available ? '' : 'disabled' }}>
                    <option value="disabled" {{ retro_moderation_mode == 'disabled' ? 'selected' : '' }}>Désactivée</option>
                    <option value="warning" {{ retro_moderation_mode == 'warning' ? 'selected' : '' }}>Avertissement (le participant choisit)</option>
                    <option value="enforced" {{ retro_moderation_mode == 'enforced' ? 'selected' : '' }}>Obligatoire (reformulation exigée)</option>
                </select>
                {% if not ai_available %}
                    {# A disabled select is never submitted — mirror its value via a hidden field so
                       saving other settings on this page doesn't silently reset moderation to
                       "disabled". (No literal HTML tag in this comment: Twig comments are not HTML
                       comments, so an analyser reading the source text takes one for a real,
                       unlabelled form control.) #}
                    <input type="hidden" name="retro_moderation_mode" value="{{ retro_moderation_mode }}" aria-label="Mode de modération">
                {% endif %}
                <div class="form-text">
                    « Avertissement » : le participant est averti si son mot est jugé irrespectueux mais peut le publier tel quel ou accepter une reformulation suggérée par l'IA.
                    « Obligatoire » : il doit reformuler ou accepter la suggestion avant de pouvoir publier.
                </div>
            </div>
        </div>

        <button type="submit" class="btn btn-primary">Enregistrer</button>
    </form>
{% endblock %}
