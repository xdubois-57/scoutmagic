{% extends 'email/base.html.twig' %}
{% block content %}
    <h2 style="margin:0 0 4px;font-size:20px;">{{ board_title }}</h2>
    <p style="margin:0 0 20px;color:#666;">Rétrospective clôturée le {{ board_date }}</p>

    {% for col, label in {'good': "Ce qui a bien marché", 'improve': "À améliorer", 'suggestion': "Autres suggestions"} %}
        <h3 style="margin:20px 0 8px;font-size:16px;">{{ label }}</h3>
        {% if columns[col] is empty %}
            <p style="margin:0;color:#999;font-style:italic;">Aucun mot dans cette colonne.</p>
        {% else %}
            <ul style="margin:0;padding-left:20px;">
                {% for body in columns[col] %}
                    <li style="margin-bottom:4px;">{{ body }}</li>
                {% endfor %}
            </ul>
        {% endif %}
    {% endfor %}

    {% if ai_summary %}
        <h3 style="margin:24px 0 8px;font-size:16px;">Synthèse générée par IA</h3>
        <div style="background-color:#f5f5f5;border-radius:6px;padding:12px 16px;white-space:pre-line;">{{ ai_summary }}</div>
    {% endif %}

    <p style="text-align:center;margin:28px 0 0;">
        <a href="{{ board_url }}"
           style="display:inline-block;padding:12px 32px;background-color:#0d6efd;color:#ffffff;text-decoration:none;border-radius:6px;font-weight:bold;">
            Voir la rétrospective
        </a>
    </p>
{% endblock %}
