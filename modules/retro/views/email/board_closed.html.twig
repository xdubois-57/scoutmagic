{#
  The closing summary of a retrospective.

  `board_content` arrives as PLAIN TEXT — the three columns, one word per
  line — and is rendered here with `|nl2br`. It is a declared variable
  (module.json) rather than a loop over the columns for one reason: a unit
  that reworded this e-mail substitutes strings, and a loop would leave it
  with a message that says a retrospective was closed and never says what
  was in it.
#}
{% extends 'email/base.html.twig' %}
{% block content %}
    <h2 style="margin:0 0 4px;font-size:20px;line-height:1.3;color:#212529;">{{ board_title }}</h2>
    <p style="margin:0 0 20px;font-size:13px;color:#6c757d;">Rétrospective clôturée le {{ board_date }}</p>
    <p style="margin:0 0 16px;">Bonjour,</p>
    <p style="margin:0 0 16px;">
        La rétrospective <strong>{{ board_title }}</strong> vient d'être clôturée. Voici ce qui y a
        été déposé :
    </p>
    <p style="margin:0 0 16px;padding:12px 16px;background-color:#f8f9fa;border-radius:6px;">{{ board_content|nl2br }}</p>
    {% if ai_summary %}
        <p style="margin:0 0 8px;"><strong>Synthèse générée par IA</strong></p>
        <p style="margin:0 0 16px;padding:12px 16px;background-color:#f8f9fa;border-radius:6px;">{{ ai_summary|nl2br }}</p>
    {% endif %}
    <p style="margin:24px 0;text-align:center;">
        <a href="{{ board_url }}"
           style="display:inline-block;padding:12px 28px;background-color:#0d6efd;color:#ffffff;text-decoration:none;border-radius:6px;font-weight:bold;">
            Voir la rétrospective
        </a>
    </p>
{% endblock %}
