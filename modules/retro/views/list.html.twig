{% extends 'base.html.twig' %}
{% block title %}Rétrospectives — {{ param('site_name') }}{% endblock %}
{% block content %}
    {% include 'partials/page_header.html.twig' with {
        title: 'Rétrospectives',
        subtitle: 'Un mot, un vote — sans jamais savoir qui a dit quoi.',
        action_label: can_create ? 'Nouvelle' : '',
        action_url: '/retro/create',
    } only %}

    {% if boards is empty and archived_boards is empty %}
        {% include 'partials/empty_state.html.twig' with {
            message: 'Aucune rétrospective pour le moment.',
            icon: 'bi-chat-square-text',
        } only %}
    {% else %}
        {% if boards is empty %}
            {% include 'partials/empty_state.html.twig' with {
                message: 'Aucune rétrospective active pour le moment.',
                icon: 'bi-chat-square-text',
            } only %}
        {% else %}
            <div class="d-flex flex-column gap-3">
                {% for entry in boards %}
                    {% include '@retro/_board_card.html.twig' with { entry: entry, can_close: can_close } %}
                {% endfor %}
            </div>
        {% endif %}

        {% if archived_boards is not empty %}
            <button class="btn btn-link btn-sm p-0 mt-4" type="button" data-bs-toggle="collapse" data-bs-target="#retro-archived">
                <i class="bi bi-archive"></i> Rétrospectives archivées ({{ archived_boards|length }})
            </button>
            <div class="collapse mt-2" id="retro-archived">
                <div class="d-flex flex-column gap-3">
                    {% for entry in archived_boards %}
                        {% include '@retro/_board_card.html.twig' with { entry: entry, can_close: can_close } %}
                    {% endfor %}
                </div>
            </div>
        {% endif %}
    {% endif %}
{% endblock %}
