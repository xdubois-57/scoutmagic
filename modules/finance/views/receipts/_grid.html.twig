{#
    Initial server-rendered paint of the receipts grid — mirrors exactly
    what receiptCardHtml()/paginationHtml() build client-side in
    public/assets/js/finance-receipts.js, so the very first page load
    shows content instantly (no fetch round-trip) while every filter/
    search/pagination interaction after that re-renders via JS from
    GET /finance/receipts/search. The pagination below is the shared
    partial in AJAX mode (data-page) — paginationHtml() in the JS
    generates the SAME markup; keep the two in step.
#}
<div class="row g-3">
    {% for row in rows %}
        {% set attachment = row.attachment %}
        <div class="col-12 col-md-4" data-receipt-id="{{ attachment.id }}">
            <div class="border rounded-3 p-3 h-100 d-flex flex-column gap-2">
                {# Ouvre la visionneuse intégrée (partials/file_viewer.html.twig)
                   plutôt que de naviguer : dans l'application installée, une
                   navigation vers une image remplace la fenêtre et il n'y a
                   plus rien pour revenir. Le href reste, pour le cas sans
                   JavaScript — FileController répond alors « attachment » à
                   une navigation, ce qui télécharge sans bouger la page. #}
                <a href="/files/{{ attachment.fileId }}"
                   data-file-viewer="/files/{{ attachment.fileId }}"
                   data-file-name="{{ attachment.originalFilename }}"
                   data-file-image="{{ attachment.mimeType starts with 'image/' ? '1' : '0' }}"
                   download="{{ attachment.originalFilename }}" target="_blank" rel="noopener">
                    {% if attachment.mimeType starts with 'image/' %}
                        <img src="/files/{{ attachment.fileId }}" alt="{{ attachment.originalFilename }}" class="img-fluid rounded" style="max-height:160px;object-fit:cover;width:100%;">
                    {% elseif attachment.mimeType == 'application/pdf' %}
                        <img src="/files/{{ attachment.fileId }}/thumbnail" alt="{{ attachment.originalFilename }}" class="img-fluid rounded pdf-thumbnail" style="max-height:160px;object-fit:cover;width:100%;">
                    {% else %}
                        <div class="d-flex align-items-center justify-content-center bg-body-secondary rounded" style="height:160px;">
                            <i class="bi bi-file-earmark-word fs-1" aria-hidden="true"></i>
                        </div>
                    {% endif %}
                </a>
                <div class="fw-semibold text-truncate" title="{{ attachment.originalFilename }}">{{ attachment.originalFilename }}</div>
                <div class="text-body-secondary small">{{ attachment.uploadedAt }}</div>
                {% if attachment.suggestedAmount or attachment.suggestedDate or attachment.suggestedLabel %}
                    <div class="small">
                        {% if attachment.suggestedAmount %}{{ attachment.suggestedAmount|money }}{% endif %}
                        {% if attachment.suggestedDate %} — {{ attachment.suggestedDate }}{% endif %}
                        {% if attachment.suggestedSource == 'ai' %}<span class="badge text-bg-info">IA</span>{% endif %}
                        {% if attachment.suggestedLabel %}
                            <div class="text-body-secondary">{{ attachment.suggestedLabel }}</div>
                        {% endif %}
                        {% if attachment.suggestedDescription %}
                            <div class="text-body-secondary fst-italic">{{ attachment.suggestedDescription }}</div>
                        {% endif %}
                    </div>
                {% endif %}
                <div>
                    {% if row.is_pending %}
                        <span class="badge text-bg-warning">En attente</span>
                        {% if attachment.matchingAiAttemptedAt %}
                            <span class="badge text-bg-secondary" title="Le rapprochement automatique par IA a déjà été tenté pour ce reçu, sans résultat certain.">IA : aucun mouvement trouvé</span>
                        {% endif %}
                    {% else %}
                        <button type="button" class="btn btn-sm btn-link p-0 movements-btn" data-id="{{ attachment.id }}">
                            <span class="badge text-bg-success">{{ row.movement_count }} mouvement(s) lié(s)</span>
                        </button>
                    {% endif %}
                </div>
                <div class="d-flex flex-wrap gap-2 mt-auto">
                    {# A receipt with no account has no movements to be
                       associated with: ReceiptService::associate() refuses
                       a movement from another account, and the pile is not
                       one. Giving it a compte is the gesture that unblocks
                       everything else, so that is the button it gets. #}
                    {% if selected_account %}
                        <button type="button" class="btn btn-sm btn-outline-primary associate-btn" data-id="{{ attachment.id }}" data-suggested-date="{{ attachment.suggestedDate }}">Associer</button>
                    {% endif %}
                    <button type="button" class="btn btn-sm btn-outline-secondary change-account-btn"
                            data-id="{{ attachment.id }}" data-movement-count="{{ row.movement_count }}">Changer de compte</button>
                    <a href="/finance/receipts/new?replace={{ attachment.id }}" class="btn btn-sm btn-outline-secondary">Remplacer</a>
                    <button type="button" class="btn btn-sm btn-outline-danger delete-btn" data-id="{{ attachment.id }}">Supprimer</button>
                </div>
            </div>
        </div>
    {% else %}
        <div class="col-12">
            {% include 'partials/empty_state.html.twig' with {
                message: selected_account ? 'Aucun reçu.' : 'Aucun reçu à trier.',
                compact: true,
            } only %}
        </div>
    {% endfor %}
</div>

{% include 'partials/pagination.html.twig' with {
    page: page,
    total_pages: total_pages,
    data_attr: 'data-page',
    label: 'Pagination des reçus',
} only %}
