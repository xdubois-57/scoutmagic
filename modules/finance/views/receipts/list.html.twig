{% extends "base.html.twig" %}

{% block title %}Reçus — Finances — {{ site_name }}{% endblock %}

{% block content %}
    {% include 'partials/page_header.html.twig' with {
        title: 'Reçus',
    } only %}

    {% include '@finance/_nav.html.twig' with {'hide_account_picker': true} %}

    <p class="text-body-secondary small mb-3">
        Gérez ici les reçus et justificatifs de dépense du compte sélectionné : ajoutez-les (individuellement ou
        plusieurs à la fois), associez-les aux mouvements correspondants, et suivez ceux qui attendent encore
        d'être traités.
    </p>

    {# One list, built once: the filter bar's picker and the « Changer de
       compte » dialog must offer exactly the same places, or a receipt
       could be sent somewhere the page cannot then show it. #}
    {% set account_options = accounts|default([])|map(account => {
        value: account.id, label: account.name,
        selected: selected_account and account.id == selected_account.id,
    }) %}
    {% if may_sort_the_pile|default(false) %}
        {% set account_options = account_options|merge([{
            value: 'unassigned',
            label: 'Compte inconnu' ~ (unassigned_count > 0 ? ' (' ~ unassigned_count ~ ')' : ''),
            selected: selected_account is not defined or not selected_account,
        }]) %}
    {% endif %}

    {% if not no_accounts %}
        {# « Ajouter un reçu » is still the page's one primary action, but it
           sits BELOW the sub-navigation rather than riding page_header's
           action slot: the rail says which finance page you are on and
           belongs directly under the title, and an action between the two
           pushed the rail away from the <h1> it navigates. Same right-
           aligned row as the « Nouveau compte » action on
           @finance/config/accounts.html.twig. #}
        {# A receipt is always added ONTO an account: there is no "add to
           the sorting pile" gesture, because the pile is where things land
           when nobody could say where they belong, never somewhere anybody
           files on purpose. #}
        {% if selected_account %}
            <div class="d-flex justify-content-end mb-3">
                <a href="/finance/receipts/new?account_id={{ selected_account.id }}"
                   class="btn btn-primary w-100 w-sm-auto">
                    <i class="bi bi-plus-lg" aria-hidden="true"></i> Ajouter un reçu
                </a>
            </div>
        {% endif %}
    {% endif %}

    {% if no_accounts %}
        {% include 'partials/empty_state.html.twig' with {
            message: 'Aucun compte visible pour votre rôle.',
            icon: 'bi-wallet2',
        } only %}
    {% else %}
    {% if selected_account %}
        <h2 class="h5 mb-3">{{ selected_account.name }}</h2>
    {% else %}
        <h2 class="h5 mb-1">Compte inconnu</h2>
        <p class="text-body-secondary small mb-3">
            Des reçus arrivés par courrier que rien n'a permis de rattacher : ni IBAN d'un de vos comptes
            dans le message, ni adresse d'un animateur d'un seul staff. Donnez-leur un compte avec
            « Changer de compte » — vous pourrez ensuite les associer à un mouvement de ce compte.
        </p>
    {% endif %}

    <div class="row g-2 align-items-end mb-3">
        {# No `field_name`: finance-receipts.js reads these by id and drives
           the live search itself — nothing here is ever submitted. #}
        <div class="col-6 col-md-3">
            {% include 'partials/form_field.html.twig' with {
                field_id: 'receipts-account', label: 'Compte', type: 'select',
                size: 'sm', wrapper_class: '',
                options: account_options,
            } only %}
        </div>
        <div class="col-12 col-md-5">
            {% include 'partials/form_field.html.twig' with {
                field_id: 'receipts-search', label: 'Recherche', value: search,
                placeholder: 'Rechercher (nom de fichier, commerçant, description, date, montant...)',
                size: 'sm', wrapper_class: '',
            } only %}
        </div>
        <div class="col-auto">
            <div class="form-label small d-block">&nbsp;</div>
            <div class="form-check">
                <input type="checkbox" class="form-check-input" id="receipts-pending-only" {{ pending_only ? 'checked' : '' }}>
                <label class="form-check-label small" for="receipts-pending-only">En attente uniquement</label>
            </div>
        </div>
        <div class="col-auto">
            <div class="form-label small d-block">&nbsp;</div>
            {# The page's one primary action is « Ajouter un reçu » in the
               row below the sub-navigation (design.md §7.4) — the filter
               button is neutral. #}
            <button type="button" class="btn btn-sm btn-outline-secondary" id="receipts-filter-btn">Filtrer</button>
            <button type="button" class="btn btn-sm btn-outline-secondary" id="receipts-reset-btn">Réinitialiser</button>
        </div>
    </div>

    {# The account key, not the id: 'unassigned' is a place with no id, and
       finance-receipts.js passes this string through to
       /finance/receipts/search verbatim. #}
    <div id="receipts-grid" data-account-id="{{ selected_key }}">
        {% include '@finance/receipts/_grid.html.twig' %}
    </div>

    {% embed 'partials/modal.html.twig' with { id: 'associate-modal', title: 'Associer à un mouvement' } only %}
        {% block body %}
            <input type="text" class="form-control form-control-sm mb-2" id="associate-search" placeholder="Rechercher un mouvement (libellé)..." aria-label="Rechercher un mouvement par libellé">
            <div id="associate-results" class="d-flex flex-column gap-1"></div>
        {% endblock %}
    {% endembed %}

    {% embed 'partials/modal.html.twig' with { id: 'movements-modal', title: 'Mouvements liés' } only %}
        {% block body %}
            <div id="movements-list" class="d-flex flex-column gap-2"></div>
        {% endblock %}
    {% endembed %}

    {% embed 'partials/modal.html.twig' with {
        id: 'change-account-modal',
        title: 'Changer le compte du reçu',
        options: account_options,
    } only %}
        {% block body %}
            {% include 'partials/form_field.html.twig' with {
                field_id: 'change-account-select', label: 'Nouveau compte', type: 'select',
                size: 'sm', wrapper_class: '', options: options,
            } only %}
            {# Filled by finance-receipts.js from the card's own movement
               count — no round-trip, and the number is the one the reader
               is looking at. Hidden when there is nothing to lose: a
               warning shown every time is a warning nobody reads. #}
            <div class="alert alert-warning mt-3 d-none" id="change-account-warning" role="alert"></div>
        {% endblock %}
        {% block footer %}
            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Annuler</button>
            <button type="button" class="btn btn-primary" id="change-account-confirm">Déplacer le reçu</button>
        {% endblock %}
    {% endembed %}
    {% endif %}
{% endblock %}

{% block scripts %}
{# The page's whole behaviour lives in public/assets/js/finance-receipts.js
   (extracted from an inline block so tests/js/finance-receipts.test.js can
   exercise the production code directly). The one server-side value it
   needs — the selected account — travels via data-account-id on
   #receipts-grid above. #}
{% if not no_accounts %}
<script src="{{ asset('/assets/js/pdf-thumbnail.js') }}" defer nonce="{{ csp_nonce }}"></script>
<script src="{{ asset('/assets/js/finance-receipts.js') }}" defer nonce="{{ csp_nonce }}"></script>
{% endif %}
{% endblock %}
