{% extends "base.html.twig" %}

{% block title %}Reçus — Finances — {{ site_name }}{% endblock %}

{% block content %}
    <h1 class="mb-4">Finances</h1>

    {% include '@finance/_nav.html.twig' with {'hide_account_picker': true} %}

    <p class="text-body-secondary small mb-3">
        Gérez ici les reçus et justificatifs de dépense du compte sélectionné : ajoutez-les (individuellement ou
        plusieurs à la fois), associez-les aux mouvements correspondants, et suivez ceux qui attendent encore
        d'être traités.
    </p>

    {% if no_accounts %}
        <p class="text-body-secondary fst-italic">Aucun compte visible pour votre rôle.</p>
    {% else %}
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="h5 mb-0">Reçus — {{ selected_account.name }}</h2>
        <a href="/finance/receipts/new?account_id={{ selected_account.id }}" class="btn btn-sm btn-primary">Ajouter un reçu</a>
    </div>

    <div class="row g-2 align-items-end mb-3">
        <div class="col-6 col-md-3">
            <label class="form-label small" for="receipts-account">Compte</label>
            <select class="form-select form-select-sm" id="receipts-account">
                {% for account in accounts %}
                    <option value="{{ account.id }}" {{ selected_account and account.id == selected_account.id ? 'selected' : '' }}>{{ account.name }}</option>
                {% endfor %}
            </select>
        </div>
        <div class="col-12 col-md-5">
            <label class="form-label small" for="receipts-search">Recherche</label>
            <input type="text" class="form-control form-control-sm" id="receipts-search" placeholder="Rechercher (nom de fichier, commerçant, description, date, montant...)" value="{{ search }}">
        </div>
        <div class="col-auto">
            <div class="form-label small d-block">&nbsp;</div>
            <div class="form-check">
                <input type="checkbox" class="form-check-input" id="receipts-pending-only" {{ pending_only ? 'checked' : '' }}>
                <label class="form-check-label small" for="receipts-pending-only">En attente uniquement</label>
            </div>
        </div>
        <div class="col-auto">
            <div class="form-label small d-block">&nbsp;</div>
            <button type="button" class="btn btn-sm btn-primary" id="receipts-filter-btn">Filtrer</button>
            <button type="button" class="btn btn-sm btn-outline-secondary" id="receipts-reset-btn">Réinitialiser</button>
        </div>
    </div>

    <div id="receipts-grid" data-account-id="{{ selected_account.id }}">
        {% include '@finance/receipts/_grid.html.twig' %}
    </div>

    <div class="modal fade" id="associate-modal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Associer à un mouvement</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="text" class="form-control form-control-sm mb-2" id="associate-search" placeholder="Rechercher un mouvement (libellé)..." aria-label="Rechercher un mouvement par libellé">
                    <div id="associate-results" class="d-flex flex-column gap-1"></div>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="movements-modal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Mouvements liés</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div id="movements-list" class="d-flex flex-column gap-2"></div>
                </div>
            </div>
        </div>
    </div>
    {% endif %}
{% endblock %}

{% block scripts %}
{# The page's whole behaviour lives in public/assets/js/finance-receipts.js
   (extracted from an inline block so tests/js/finance-receipts.test.js can
   exercise the production code directly). The one server-side value it
   needs — the selected account — travels via data-account-id on
   #receipts-grid above. #}
{% if not no_accounts %}
<script src="/assets/js/finance-receipts.js" defer nonce="{{ csp_nonce }}"></script>
{% endif %}
{% endblock %}
