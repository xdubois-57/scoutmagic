{% extends "base.html.twig" %}

{% block title %}{{ replace_id ? 'Remplacer' : 'Nouveau' }} reçu — Finances — {{ site_name }}{% endblock %}

{% block content %}
    {% include 'partials/page_header.html.twig' with {
        title: replace_id ? 'Remplacer le reçu' : 'Nouveau reçu',
    } only %}

    {% if error %}
        <div class="alert alert-danger">{{ error }}</div>
    {% endif %}

    {% if not replace_id and accounts is empty %}
        {% include 'partials/empty_state.html.twig' with {
            message: 'Aucun compte visible pour votre rôle.',
            icon: 'bi-wallet2',
        } only %}
    {% else %}
    <form method="post" action="{{ replace_id ? '/finance/receipts/' ~ replace_id ~ '/replace' : '/finance/receipts/new' }}"
          enctype="multipart/form-data" class="border rounded-3 p-3" id="receipt-form">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token() }}">
        <div class="row g-2">
            {% if not replace_id %}
                <div class="col-12">
                    <label class="form-label small" for="receipt-account">Compte</label>
                    <select class="form-select form-select-sm" id="receipt-account" name="account_id" required>
                        {% for account in accounts %}
                            <option value="{{ account.id }}" {{ selected_account and account.id == selected_account.id ? 'selected' : '' }}>{{ account.name }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-12">
                    {# The drop zone is not a button and no longer pretends to be
                       one with role/tabindex: the real control is the file input
                       it contains, which the label above now points at. Visually
                       hidden rather than d-none so it stays focusable — a file
                       input opens its picker on Enter and Space natively, which
                       is the keyboard equivalent this site's CSP would not let
                       an inline onKeyDown attribute provide. Clicking the drop
                       zone still opens the picker; that part is script (below)
                       because a label element may not wrap this layout. #}
                    <label class="form-label small" for="receipt-files">Reçus (PDF, JPEG ou PNG) — jusqu'à 10 à la fois</label>
                    <div id="drop-zone" class="receipt-drop-zone border border-2 border-dashed rounded-3 p-4 text-center text-body-secondary">
                        <i class="bi bi-cloud-arrow-up fs-2 d-block mb-2" aria-hidden="true"></i>
                        <span>Glissez-déposez vos reçus ici, ou cliquez pour parcourir</span>
                        <input type="file" class="visually-hidden" id="receipt-files" name="receipts[]" accept=".pdf,.jpg,.jpeg,.png" multiple>
                    </div>
                    <ul class="list-unstyled small mt-2 mb-0" id="receipt-files-list"></ul>
                    <div class="form-text small" id="receipt-file-status"></div>
                </div>
            {% else %}
                <div class="col-12">
                    <label class="form-label small" for="receipt-file">Fichier (PDF, JPEG ou PNG)</label>
                    <input type="file" class="form-control form-control-sm" id="receipt-file" name="receipt" accept=".pdf,.jpg,.jpeg,.png" required>
                    <div class="form-text small" id="receipt-file-status"></div>
                </div>
            {% endif %}
            <div class="col-12">
                <button type="submit" class="btn btn-sm btn-primary">{{ replace_id ? 'Remplacer' : 'Ajouter' }}</button>
                <a href="/finance/receipts{{ selected_account ? '?account_id=' ~ selected_account.id : '' }}" class="btn btn-sm btn-outline-secondary">Annuler</a>
            </div>
        </div>
    </form>
    {% endif %}
{% endblock %}

{% block scripts %}
{# The whole behaviour of this form — the drop zone, the file list and the
   client-side image compression, in both the « Nouveau » and the
   « Remplacer » shape — lives in public/assets/js/finance-receipt-form.js
   (extracted from an inline block so tests/js/finance-receipt-form.test.js
   can exercise the production code directly). It tells the two shapes apart
   from the DOM (#receipt-file vs #drop-zone), where a Twig condition inside
   the script used to; there is no server-side value to hand over. #}
{% if replace_id or accounts is not empty %}
<script src="/assets/js/finance-receipt-form.js" defer></script>
{% endif %}
{% endblock %}
