{% extends "base.html.twig" %}
{% block stylesheets %}<link rel="stylesheet" href="{{ asset('/assets/css/components.css') }}">{% endblock %}

{% block title %}Tableau de bord — Finances — {{ site_name }}{% endblock %}

{% block content %}
    {% include 'partials/page_header.html.twig' with { title: 'Tableau de bord' } only %}

    {% include '@finance/_nav.html.twig' with {'hide_account_picker': true} %}

    <p class="text-body-secondary small mb-3">
        Le tableau de bord donne une vue d'ensemble du compte sélectionné : en haut ce qu'il faut savoir, juste
        en dessous ce qui attend une action, puis l'évolution du solde et le bilan par catégorie de l'exercice.
    </p>

    {% if no_accounts %}
        {% include 'partials/empty_state.html.twig' with {
            message: 'Aucun compte visible pour votre rôle.',
            icon: 'bi-wallet2',
        } only %}
    {% else %}
        <h2 class="h5 mb-3">{{ selected_account.name }}</h2>

        <form method="get" action="/finance" class="row g-2 align-items-end mb-3">
            <div class="col-6 col-md-3">
                {% include 'partials/form_field.html.twig' with {
                    field_id: 'filter-account', field_name: 'account_id', label: 'Compte',
                    type: 'select', required: true, size: 'sm', wrapper_class: '',
                    options: accounts|default([])|map(account => {
                        value: account.id, label: account.name,
                        selected: selected_account and account.id == selected_account.id,
                    }),
                } only %}
            </div>
            <div class="col-6 col-md-3">
                {% include 'partials/form_field.html.twig' with {
                    field_id: 'filter-fiscal-year', field_name: 'fiscal_year_id', label: 'Exercice',
                    type: 'select', required: true, size: 'sm', wrapper_class: '',
                    options: fiscal_years|default([])|map(fiscalYear => {
                        value: fiscalYear.id, label: fiscalYear.label,
                        selected: selected_fiscal_year and fiscalYear.id == selected_fiscal_year.id,
                    }),
                } only %}
            </div>
            <div class="col-12">
                <button type="submit" class="btn btn-sm btn-primary">Filtrer</button>
                <a href="/finance" class="btn btn-sm btn-outline-secondary">Réinitialiser</a>
            </div>
        </form>

        {# Two rows of four (issue #838): the first says what the account
           looks like, the second what is waiting for the treasurer. Every
           action tile is a count linking to the screen where it is dealt
           with — the lists themselves live there, not here.

           « Paiements à traiter » names what its figure is made of, which
           says which tab to open first. #}
        {% set reconciliation_parts = [] %}
        {% if reconciliation_counts.split|default(0) > 0 %}
            {% set reconciliation_parts = reconciliation_parts|merge([reconciliation_counts.split ~ ' à répartir']) %}
        {% endif %}
        {% if reconciliation_counts.orphans|default(0) > 0 %}
            {% set reconciliation_parts = reconciliation_parts|merge([reconciliation_counts.orphans ~ ' non imputé' ~ (reconciliation_counts.orphans > 1 ? 's' : '')]) %}
        {% endif %}
        {% if reconciliation_counts.overpaid|default(0) > 0 %}
            {% set reconciliation_parts = reconciliation_parts|merge([reconciliation_counts.overpaid ~ ' trop-perçu' ~ (reconciliation_counts.overpaid > 1 ? 's' : '')]) %}
        {% endif %}
        {% if reconciliation_counts.cross_account|default(0) > 0 %}
            {% set reconciliation_parts = reconciliation_parts|merge([reconciliation_counts.cross_account ~ ' sur un autre compte']) %}
        {% endif %}
        {% set reconciliation_breakdown = reconciliation_parts|join(' · ') %}
        {% set year_query = selected_fiscal_year ? '&fiscal_year_id=' ~ selected_fiscal_year.id : '' %}

        <h2 class="visually-hidden">Situation du compte</h2>
        {% include 'partials/stat_tiles.html.twig' with {
            tiles: [
                {
                    label: 'Solde actuel',
                    value: balance is not null ? balance|money : 'Solde inconnu',
                },
                {
                    label: 'Solde le plus bas',
                    value: lowest_balance_18_months is not null ? lowest_balance_18_months|money : 'Inconnu',
                    sublabel: '18 derniers mois',
                },
                {
                    label: 'Dernier extrait importé',
                    value: last_import ? last_import.importedAt|date_fr : 'Aucun import',
                    link_label: 'Importer →',
                    link_url: '/finance/import?account_id=' ~ selected_account.id,
                },
                {
                    label: 'Paiements encore attendus',
                    value: expected_cents|money_cents,
                    sublabel: 'Reste dû sur les créances de ce compte',
                    link_label: 'Contrôle des créances →',
                    link_url: '/finance/receivables',
                },
            ],
            columns: 4,
        } only %}

        <h2 class="visually-hidden">À traiter</h2>
        {% include 'partials/stat_tiles.html.twig' with {
            tiles: [
                {
                    label: 'Mouvements non catégorisés',
                    value: uncategorized_count,
                    sublabel: selected_fiscal_year ? 'Exercice ' ~ selected_fiscal_year.label : null,
                    link_label: 'Catégoriser →',
                    link_url: '/finance/movements?account_id=' ~ selected_account.id ~ year_query ~ '&category_id=none',
                },
                {
                    label: 'Reçus à associer',
                    value: pending_receipts_count,
                    sublabel: 'Reçus sans mouvement',
                    link_label: 'Associer →',
                    link_url: '/finance/receipts?account_id=' ~ selected_account.id ~ '&pending=1',
                },
                {
                    label: 'Paiements à traiter',
                    value: reconciliation_pending|default(0),
                    sublabel: reconciliation_pending|default(0) > 0
                        ? reconciliation_breakdown
                        : 'Aucun paiement n’attend de décision',
                    link_label: 'Traiter les paiements →',
                    link_url: '/finance/reconciliation?account_id=' ~ selected_account.id,
                },
                {
                    label: 'Campagnes ouvertes',
                    value: open_campaigns_count,
                    link_label: 'Voir les campagnes →',
                    link_url: '/finance/campaigns',
                },
            ],
            columns: 4,
        } only %}

        <div class="d-flex flex-column flex-sm-row gap-2 mb-4">
            <a href="/finance/import?account_id={{ selected_account.id }}" class="btn btn-outline-primary">Importer un extrait bancaire →</a>
            <a href="/finance/receipts/new?account_id={{ selected_account.id }}" class="btn btn-outline-primary">Ajouter un reçu →</a>
        </div>

        {% if selected_fiscal_year and category_summary %}
            <div class="row g-3 mb-3">
                <div class="col-12 col-md-6">
                    <div class="border rounded-3 p-3 h-100">
                        <div class="small text-body-secondary mb-2">Évolution du solde</div>
                        <div style="height: 320px; max-height: 50vh;">
                            <canvas id="chart-balance-line"></canvas>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-md-6">
                    <div class="border rounded-3 p-3 h-100">
                        <div class="small text-body-secondary mb-2">Répartition nette par catégorie</div>
                        <div style="height: 320px; max-height: 50vh;">
                            <canvas id="chart-net-category-pie"></canvas>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row g-3 mb-4">
                <div class="col-12">
                    <div class="border rounded-3 p-3">
                        <div class="small text-body-secondary mb-2">Recettes vs dépenses par catégorie</div>
                        <div style="height: 320px; max-height: 50vh;">
                            <canvas id="chart-income-expense-bar"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        {% endif %}

        {% if selected_fiscal_year %}
            <h2 class="h5 mb-3">Bilan par catégorie — {{ selected_fiscal_year.label }}</h2>
            <div class="table-responsive mb-4">
                <table class="table table-sm align-middle">
                    <thead>
                        <tr>
                            <th>Catégorie</th>
                            <th class="text-end">Recettes</th>
                            <th class="text-end">Dépenses</th>
                            <th class="text-end">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for row in category_summary %}
                            <tr>
                                <td>
                                    <a href="/finance/movements?account_id={{ selected_account.id }}&fiscal_year_id={{ selected_fiscal_year.id }}&category_id={{ row.category_id ? row.category_id : 'none' }}">
                                        {{ row.category_name ?? 'Non catégorisé' }}
                                    </a>
                                </td>
                                <td class="text-end text-success">{{ row.income|money }}</td>
                                <td class="text-end text-danger">{{ row.expense|money }}</td>
                                <td class="text-end">{{ row.total|money }}</td>
                            </tr>
                        {% else %}
                            {% include 'partials/empty_state.html.twig' with {
                                message: 'Aucun mouvement pour cet exercice.',
                                colspan: 4,
                            } only %}
                        {% endfor %}
                    </tbody>
                    {% if category_summary %}
                        <tfoot>
                            <tr class="fw-bold">
                                <td>Bilan</td>
                                <td class="text-end text-success">{{ bilan.income|money }}</td>
                                <td class="text-end text-danger">{{ bilan.expense|money }}</td>
                                <td class="text-end">{{ bilan.total|money }}</td>
                            </tr>
                        </tfoot>
                    {% endif %}
                </table>
            </div>
        {% endif %}

    {% endif %}
{% endblock %}

{% block scripts %}
    {% if not no_accounts %}
        {% if selected_fiscal_year and category_summary %}
            {#
              A JSON island, not an inline assignment: the parser reads it
              as data, so a category named with a « < » cannot end the
              block early, and it needs no nonce. JSON_HEX_TAG/JSON_HEX_AMP
              escape those characters anyway, so the island cannot be
              closed from inside either (base.html.twig's
              `offline-config-data` is the same shape).
            #}
            {% set json_flags = constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_UNESCAPED_UNICODE') %}
            <script type="application/json" id="finance-dashboard-data">
{{ {
                categoryLabels: category_summary|map(row => row.category_name ?? 'Non catégorisé'),
                categoryIncome: category_summary|map(row => row.income),
                categoryExpense: category_summary|map(row => row.expense),
                evolutionLabels: balance_evolution|map(point => point.month),
                evolutionBalances: balance_evolution|map(point => point.balance),
                netPositive: net_category_breakdown.positive,
                netNegative: net_category_breakdown.negative
            }|json_encode(json_flags)|raw }}
            </script>
            <script src="{{ asset('/assets/vendor/chartjs/chart.umd.min.js') }}"></script>
        {% endif %}
        <script src="{{ asset('/assets/js/finance-dashboard.js') }}" defer></script>
    {% endif %}
{% endblock %}
