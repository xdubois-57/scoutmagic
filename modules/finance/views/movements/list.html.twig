{% extends "base.html.twig" %}

{% block title %}Mouvements — Finances — {{ site_name }}{% endblock %}

{% block stylesheets %}
<style nonce="{{ csp_nonce }}">
    .movement-row { cursor: pointer; }
</style>
{% endblock %}

{% block content %}
    {% include 'partials/page_header.html.twig' with { title: 'Mouvements' } only %}

    {% include '@finance/_nav.html.twig' with {'hide_account_picker': true} %}

    <p class="text-body-secondary small mb-3">
        Cette page liste tous les mouvements du compte sélectionné (import bancaire ou saisie manuelle). Vous
        pouvez catégoriser chaque mouvement, y ajouter un commentaire, lui associer un ou plusieurs reçus, et
        rechercher dans tout l'historique.
    </p>

    {% if no_accounts %}
        {% include 'partials/empty_state.html.twig' with {
            message: 'Aucun compte visible pour votre rôle.',
            icon: 'bi-wallet2',
        } only %}
    {% else %}
    <h2 class="h5 mb-3">{{ selected_account.name }}</h2>

    <form method="get" action="/finance/movements" class="row g-2 align-items-end mb-3">
        <div class="col-6 col-md-3">
            {% include 'partials/form_field.html.twig' with {
                field_id: 'filter-account', field_name: 'account_id', label: 'Compte',
                type: 'select', required: true, size: 'sm', wrapper_class: '',
                options: accounts|default([])|map(account => {
                    value: account.id, label: account.name,
                    selected: selected_account and account.id == selected_account.id,
                }),
            } only %}
        </div>
        <div class="col-6 col-md-3">
            {% include 'partials/form_field.html.twig' with {
                field_id: 'filter-fiscal-year', field_name: 'fiscal_year_id', label: 'Exercice',
                type: 'select', size: 'sm', wrapper_class: '',
                options: [{ value: 'all', label: 'Tous', selected: filter_fiscal_year_id is null }]
                    |merge(fiscal_years|default([])|map(fiscalYear => {
                        value: fiscalYear.id, label: fiscalYear.label,
                        selected: filter_fiscal_year_id == fiscalYear.id,
                    })),
            } only %}
        </div>
        <div class="col-6 col-md-3">
            {% include 'partials/form_field.html.twig' with {
                field_id: 'filter-category', field_name: 'category_id', label: 'Catégorie',
                type: 'select', size: 'sm', wrapper_class: '',
                options: [
                    { value: 'all', label: 'Toutes', selected: filter_category_id == 'all' },
                    { value: 'none', label: 'Non catégorisé', selected: filter_category_id == 'none' },
                ]|merge(categories|default([])|map(category => {
                    value: category.id, label: category.name,
                    selected: filter_category_id == category.id,
                })),
            } only %}
        </div>
        <div class="col-6 col-md-3">
            {% include 'partials/form_field.html.twig' with {
                field_id: 'filter-search', field_name: 'q', label: 'Recherche',
                value: filter_search, placeholder: 'Libellé...', size: 'sm', wrapper_class: '',
            } only %}
        </div>
        <div class="col-12">
            <button type="submit" class="btn btn-sm btn-primary">Filtrer</button>
            <a href="/finance/movements" class="btn btn-sm btn-outline-secondary">Réinitialiser</a>
        </div>
    </form>

    {# Mobile card view — visible below md #}
    <div class="d-md-none d-flex flex-column gap-2 mb-3">
        {% for row in rows %}
            {% set movement = row.movement %}
            {# A real <button>: Enter and Space, focus and the announced role
               all come with the element instead of being borrowed from a
               role and a tabindex (Sonar Web:S6819). Its children are
               <span>s for the same reason — a button holds phrasing. #}
            <button type="button"
                 class="border rounded-3 p-3 w-100 text-start movement-row {{ movement.categoryId is null ? 'bg-warning-subtle' : '' }}"
                 data-id="{{ movement.id }}"
                 data-date="{{ movement.transactionDate }}"
                 data-label="{{ movement.label }}"
                 data-bank-reference="{{ movement.bankReference }}"
                 data-amount="{{ movement.amount }}"
                 data-source="{{ movement.source }}"
                 data-category-id="{{ movement.categoryId }}"
                 data-category-source="{{ movement.categorySource }}"
                 data-comment="{{ movement.comment }}"
                 data-fiscal-year-id="{{ movement.fiscalYearId }}"
                 data-counterparty-name="{{ movement.counterpartyName }}"
                 data-counterparty-account="{{ movement.counterpartyAccount }}"
                 data-extra-details="{{ movement.extraDetails }}">
                <span class="d-flex justify-content-between align-items-start mb-1">
                    <span class="text-body-secondary small">{{ movement.transactionDate }}</span>
                    <span class="fw-semibold {{ movement.amount < 0 ? 'text-danger' : 'text-success' }}">
                        {{ movement.amount|money }}
                    </span>
                </span>
                <span class="d-block fw-semibold small text-truncate">{{ row.counterparty ?: row.description }}</span>
                <span class="d-flex align-items-center gap-2 mt-1">
                    <span class="badge {{ movement.categoryId ? 'text-bg-light border' : 'text-bg-warning' }}">
                        {{ movement.categoryId and categories_by_id[movement.categoryId] is defined ? categories_by_id[movement.categoryId].name : 'À catégoriser' }}
                    </span>
                    {% if row.attachment_count > 0 %}
                        <span class="text-body-secondary small">📎 {{ row.attachment_count }}</span>
                    {% endif %}
                    {% if movement.isCategoryAutoAssigned %}
                        <span class="badge text-bg-light border">Auto</span>
                    {% endif %}
                </span>
            </button>
        {% else %}
            {% include 'partials/empty_state.html.twig' with {
                message: 'Aucun mouvement.',
                compact: true,
            } only %}
        {% endfor %}
    </div>

    {# Desktop table view — visible from md up #}
    <div class="table-responsive d-none d-md-block">
        <table class="table table-sm align-middle">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Catégorie</th>
                    <th>Contrepartie</th>
                    <th>Description</th>
                    <th class="text-end">Montant</th>
                    <th class="text-center">📎</th>
                </tr>
            </thead>
            <tbody>
                {% for row in rows %}
                    {% set movement = row.movement %}
                    <tr data-id="{{ movement.id }}"
                        data-date="{{ movement.transactionDate }}"
                        data-label="{{ movement.label }}"
                        data-bank-reference="{{ movement.bankReference }}"
                        data-amount="{{ movement.amount }}"
                        data-source="{{ movement.source }}"
                        data-category-id="{{ movement.categoryId }}"
                        data-category-source="{{ movement.categorySource }}"
                        data-comment="{{ movement.comment }}"
                        data-fiscal-year-id="{{ movement.fiscalYearId }}"
                        data-counterparty-name="{{ movement.counterpartyName }}"
                        data-counterparty-account="{{ movement.counterpartyAccount }}"
                        data-extra-details="{{ movement.extraDetails }}"
                        class="movement-row {{ movement.categoryId is null ? 'table-warning' : '' }}">
                        <td>{{ movement.transactionDate }}</td>
                        <td>
                            {{ movement.categoryId and categories_by_id[movement.categoryId] is defined ? categories_by_id[movement.categoryId].name : 'À catégoriser' }}
                            {% if movement.isCategoryAutoAssigned %}
                                <span class="badge text-bg-light border" title="Catégorie attribuée automatiquement (règle ou IA)">Auto</span>
                            {% endif %}
                        </td>
                        <td>{{ row.counterparty }}</td>
                        <td>{{ row.description }}</td>
                        <td class="text-end {{ movement.amount < 0 ? 'text-danger' : 'text-success' }}">
                            {{ movement.amount|money }}
                        </td>
                        <td class="text-center">
                            <button type="button" class="btn btn-sm btn-link p-0 attachment-btn" data-id="{{ movement.id }}" title="Reçus">
                                <span aria-hidden="true">📎</span><span class="visually-hidden">Reçus</span>{% if row.attachment_count > 0 %} <span class="badge text-bg-secondary">{{ row.attachment_count }}</span>{% endif %}
                            </button>
                            {% if row.suggested_receipt %}
                                <button type="button" class="btn btn-sm btn-outline-primary d-block mt-1 suggest-associate-btn"
                                        data-movement-id="{{ movement.id }}" data-attachment-id="{{ row.suggested_receipt.id }}">
                                    Associer ce reçu ?
                                </button>
                            {% endif %}
                        </td>
                    </tr>
                {% else %}
                    {% include 'partials/empty_state.html.twig' with {
                        message: 'Aucun mouvement.',
                        colspan: 6,
                    } only %}
                {% endfor %}
            </tbody>
        </table>
    </div>

    {#
       'all' is emitted explicitly rather than omitted: MovementController
       reads a *missing* fiscal_year_id as "the current exercice" and only
       the literal 'all' as "every exercice", so dropping the parameter
       silently reset the filter on page 2 and on the XLSX export. The
       search term is url_encode'd — an '&', '#' or '+' in it truncated the
       query string.
    #}
    {% set filters_query = '?account_id=' ~ selected_account.id
        ~ '&fiscal_year_id=' ~ (filter_fiscal_year_id ? filter_fiscal_year_id : 'all')
        ~ (filter_category_id and filter_category_id != 'all' ? '&category_id=' ~ filter_category_id|url_encode : '')
        ~ (filter_search ? '&q=' ~ filter_search|url_encode : '') %}
    <a href="/finance/movements/export{{ filters_query }}" class="btn btn-sm btn-outline-secondary mb-3">
        <i class="bi bi-file-earmark-spreadsheet"></i> Exporter en XLSX
    </a>

    {% include 'partials/pagination.html.twig' with {
        page: page,
        total_pages: total_pages,
        base_url: filters_query ~ '&page=',
        label: 'Pagination des mouvements',
    } only %}

    {# `only` isolates the embed's scope — the variables its blocks use
       are passed through explicitly alongside the modal's own options. #}
    {% embed 'partials/modal.html.twig' with {
        id: 'attachments-modal',
        title: 'Reçus associés',
        scrollable: true,
        pending_receipts: pending_receipts,
    } only %}
        {% block body %}
            <div id="attachments-list" class="d-flex flex-column gap-2 mb-3"></div>
            <div class="d-flex gap-2 mb-2">
                <label class="visually-hidden" for="attachments-add-select">Associer un reçu en attente</label>
                <select class="form-select form-select-sm" id="attachments-add-select">
                    <option value="">Associer un reçu en attente…</option>
                    {% for receipt in pending_receipts %}
                        <option value="{{ receipt.id }}">
                            {{ receipt.originalFilename }}{% if receipt.suggestedDate %} — {{ receipt.suggestedDate }}{% endif %}{% if receipt.suggestedLabel %} — {{ receipt.suggestedLabel }}{% endif %}{% if receipt.suggestedAmount %} — {{ receipt.suggestedAmount|money }}{% endif %}
                        </option>
                    {% endfor %}
                </select>
                <button type="button" class="btn btn-sm btn-primary" id="attachments-add-btn">Associer</button>
            </div>
            <div class="text-body-secondary small text-center mb-2">— ou —</div>
            <div class="d-flex gap-2">
                <input type="file" class="form-control form-control-sm" id="attachments-upload-input" accept=".pdf,.jpg,.jpeg,.png" aria-label="Téléverser un reçu">
                <button type="button" class="btn btn-sm btn-outline-primary text-nowrap" id="attachments-upload-btn">Téléverser et associer</button>
            </div>
            <div class="text-danger small mt-2 d-none" id="attachments-upload-error"></div>
        {% endblock %}
    {% endembed %}

    {% embed 'partials/modal.html.twig' with {
        id: 'movement-details-modal',
        title: 'Détails du mouvement',
        scrollable: true,
        categories: categories,
        fiscal_years: fiscal_years,
    } only %}
        {% block body %}
            <dl class="row small mb-3">
                <dt class="col-4">Date</dt><dd class="col-8" id="md-date"></dd>
                <dt class="col-4">Libellé</dt><dd class="col-8" id="md-label"></dd>
                <dt class="col-4">Référence bancaire</dt><dd class="col-8" id="md-bank-reference"></dd>
                <dt class="col-4">Montant</dt><dd class="col-8" id="md-amount"></dd>
                <dt class="col-4">Origine</dt><dd class="col-8" id="md-source"></dd>
                <dt class="col-4">Contrepartie</dt><dd class="col-8" id="md-counterparty-name"></dd>
                <dt class="col-4">Compte contrepartie</dt><dd class="col-8" id="md-counterparty-account"></dd>
                <dt class="col-4">Autres informations</dt><dd class="col-8" id="md-extra-details"></dd>
            </dl>
            {# No `field_name` in the dialog: finance-movements.js reads
               these by id and posts the movement itself. The « attribuée
               automatiquement » line is revealed by that same script, so it
               stays outside the partial and is wired with
               `describedby_extra`. #}
            <div class="mb-2">
                {% include 'partials/form_field.html.twig' with {
                    field_id: 'md-category', label: 'Catégorie', type: 'select',
                    size: 'sm', wrapper_class: '', describedby_extra: 'md-category-auto',
                    options: [{ value: '', label: 'À catégoriser' }]
                        |merge(categories|default([])|map(category => {
                            value: category.id, label: category.name,
                        })),
                } only %}
                <div class="form-text small d-none" id="md-category-auto">Catégorie attribuée automatiquement (règle ou IA). Changer la catégorie ici la rendra manuelle.</div>
            </div>
            {% include 'partials/form_field.html.twig' with {
                field_id: 'md-comment', label: 'Commentaire', size: 'sm', wrapper_class: 'mb-2',
            } only %}
            {% include 'partials/form_field.html.twig' with {
                field_id: 'md-fiscal-year', label: 'Exercice', type: 'select',
                size: 'sm', wrapper_class: 'mb-2',
                options: fiscal_years|default([])|map(fiscalYear => {
                    value: fiscalYear.id, label: fiscalYear.label,
                }),
            } only %}
        {% endblock %}
        {% block footer %}
            <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Annuler</button>
            <button type="button" class="btn btn-sm btn-primary" id="md-save-btn">Enregistrer</button>
        {% endblock %}
    {% endembed %}
    {% endif %}
{% endblock %}

{% block scripts %}
{% if not no_accounts %}
<script src="{{ asset('/assets/js/pdf-thumbnail.js') }}" defer></script>
<script src="{{ asset('/assets/js/finance-movements.js') }}" defer></script>
{% endif %}
{% endblock %}
