{% extends "base.html.twig" %}

{% block title %}Comptes — Finances — {{ site_name }}{% endblock %}

{% block content %}
    {% include 'partials/page_header.html.twig' with { title: 'Comptes' } only %}

    {% include '@finance/config/_nav.html.twig' %}

    <p class="text-body-secondary small mb-3">
        Un compte représente un compte bancaire (avec IBAN) ou une caisse de l'unité. Un compte reste en
        « Brouillon » tant qu'il lui manque un IBAN et un titulaire (une caisse, elle, s'active immédiatement) ;
        seuls les comptes actifs apparaissent dans le tableau de bord et permettent d'importer des relevés — un
        compte actif peut être désactivé temporairement (et réactivé) plutôt que supprimé, comme les catégories.
        « Visible à partir de » définit le rôle minimum requis pour voir ce compte. Activer un compte avec IBAN
        crée automatiquement une catégorie « Virement {{ '<nom du compte>' }} » avec une règle qui reconnaît les
        mouvements vers/depuis les autres comptes de l'unité — voir la page Catégories. Les comptes « Par défaut »
        (un par section) ne peuvent pas changer de nom, de type ou de section.
    </p>

    {# The creation action opens a dialog (JS), so it cannot ride the
       page_header's link action — it keeps its own right-aligned row. #}
    <div class="d-flex justify-content-end mb-3">
        <button type="button" class="btn btn-sm btn-primary" id="new-account-btn">Nouveau compte</button>
    </div>

    <div class="table-responsive mb-4">
        <table class="table table-sm align-middle">
            <thead>
                <tr>
                    <th>Nom</th>
                    <th>Type</th>
                    <th>Section</th>
                    <th>IBAN</th>
                    <th>Statut</th>
                    <th>Visible à partir de</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for account in accounts %}
                    <tr>
                        <td>
                            {{ account.name }}
                            {% if account.isDefault %}<span class="badge text-bg-light border">Par défaut</span>{% endif %}
                        </td>
                        <td>{{ account_types[account.accountType] ?? account.accountType }}</td>
                        <td>{{ account.sectionId and sections_by_id[account.sectionId] is defined ? (sections_by_id[account.sectionId].name ?? sections_by_id[account.sectionId].desk_code) : '—' }}</td>
                        <td>{{ account.iban ? account.iban|slice(0, 4) ~ ' •••• ' ~ account.iban|slice(-4) : '—' }}</td>
                        <td>
                            {% include 'partials/status_badge.html.twig' with {
                                status: account.status == 'active' ? 'active' : (account.status == 'archived' ? 'inactive' : 'draft'),
                                label: {'draft': 'Brouillon', 'active': 'Actif', 'archived': 'Inactif'}[account.status] ?? account.status,
                            } only %}
                        </td>
                        <td>{{ role_min_options[account.roleMinView] ?? account.roleMinView }}</td>
                        <td class="text-end">
                            <button type="button" class="btn btn-sm btn-outline-secondary edit-account-btn"
                                    data-id="{{ account.id }}" data-name="{{ account.name }}" data-account-type="{{ account.accountType }}"
                                    data-section-id="{{ account.sectionId }}" data-role-min-view="{{ account.roleMinView }}"
                                    data-iban="{{ account.iban }}" data-holder="{{ account.holderName }}"
                                    data-is-default="{{ account.isDefault ? '1' : '0' }}"
                                    title="Modifier" aria-label="Modifier"><i class="bi bi-pencil" aria-hidden="true"></i></button>
                            {% if account.status == 'draft' %}
                                <span class="text-body-secondary small fst-italic">IBAN et titulaire requis pour activer</span>
                            {% else %}
                                <button type="button" class="btn btn-sm {{ account.status == 'active' ? 'btn-outline-success' : 'btn-outline-secondary' }} toggle-account-btn"
                                        data-id="{{ account.id }}" data-active="{{ account.status == 'active' ? '1' : '0' }}"
                                        title="{{ account.status == 'active' ? 'Actif — cliquer pour désactiver' : 'Inactif — cliquer pour activer' }}" aria-label="{{ account.status == 'active' ? 'Actif — cliquer pour désactiver' : 'Inactif — cliquer pour activer' }}">
                                    <i class="bi {{ account.status == 'active' ? 'bi-toggle-on' : 'bi-toggle-off' }}" aria-hidden="true"></i>
                                </button>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    {# The form lives entirely in the body; the footer's submit button is
       associated through form="account-form", so it no longer needs to
       wrap body + footer (the modal embed owns that skeleton). The title
       id is the embed's convention, {id}-title. #}
    {% embed 'partials/modal.html.twig' with {
        id: 'account-modal',
        title: 'Nouveau compte',
        account_types: account_types,
        sections_by_id: sections_by_id,
        role_min_options: role_min_options,
    } only %}
        {% block body %}
                <form id="account-form">
                        <input type="hidden" id="account-id" value="">
                        <div class="row g-2">
                            <div class="col-12">
                                <label class="form-label small" for="account-name">Nom</label>
                                <input type="text" class="form-control form-control-sm" id="account-name" required>
                            </div>
                            <div class="col-6">
                                <label class="form-label small" for="account-type">Type</label>
                                <select class="form-select form-select-sm" id="account-type">
                                    {% for value, label in account_types %}
                                        <option value="{{ value }}">{{ label }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                            <div class="col-6">
                                <label class="form-label small" for="account-section">Section</label>
                                <select class="form-select form-select-sm" id="account-section">
                                    <option value="">—</option>
                                    {% for id, section in sections_by_id %}
                                        <option value="{{ id }}">{{ section.name ?? section.desk_code }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                            <div class="col-12">
                                <label class="form-label small" for="account-iban">IBAN</label>
                                <input type="text" class="form-control form-control-sm" id="account-iban" placeholder="ex. BE71 0961 2345 6769">
                            </div>
                            <div class="col-12">
                                <label class="form-label small" for="account-holder">Nom du titulaire</label>
                                <input type="text" class="form-control form-control-sm" id="account-holder">
                            </div>
                            <div class="col-12">
                                <label class="form-label small" for="account-role-min-view">Visible à partir de</label>
                                <select class="form-select form-select-sm" id="account-role-min-view">
                                    {% for value, label in role_min_options %}
                                        <option value="{{ value }}">{{ label }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                        </div>
                        <div class="text-danger small mt-2 d-none" id="account-form-error" role="alert"></div>
                </form>
        {% endblock %}
        {% block footer %}
            <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Annuler</button>
            <button type="submit" class="btn btn-sm btn-primary" form="account-form">Enregistrer</button>
        {% endblock %}
    {% endembed %}
{% endblock %}

{% block scripts %}
{# The page's behaviour — the account dialog and the activate/deactivate
   toggle — lives in public/assets/js/finance-accounts.js (extracted from an
   inline block so tests/js/finance-accounts.test.js can exercise the
   production code directly). Every value it needs rides the row buttons'
   data-* attributes, so there is nothing to interpolate here. #}
<script src="/assets/js/finance-accounts.js" defer></script>
{% endblock %}
