{% extends "base.html.twig" %}

{% block title %}Finances — {{ site_name }}{% endblock %}

{% block content %}
    {% include 'partials/page_header.html.twig' with { title: 'Finances' } only %}

    {% include '@finance/config/_nav.html.twig' %}

    <p class="text-body-secondary small mb-4">
        Vue d'ensemble de la configuration du module Finances. Un <strong>compte</strong> représente un compte
        bancaire ou une caisse de l'unité (voir « Gérer les comptes ») ; les <strong>catégories</strong> classent
        les mouvements pour le bilan (voir « Gérer les catégories », qui inclut aussi les règles de
        catégorisation automatique) ; un <strong>exercice</strong> correspond à une année scoute. La « Zone de
        danger » ci-dessous permet des suppressions définitives — à utiliser avec précaution.
    </p>

    {% include 'partials/stat_tiles.html.twig' with {
        tiles: [
            {
                label: 'Comptes',
                value: account_count,
                link_label: 'Gérer les comptes',
                link_url: '/config/finance/accounts',
            },
            {
                label: 'Catégories',
                value: category_count,
                link_label: 'Gérer les catégories',
                link_url: '/config/finance/categories',
            },
            {
                label: 'Exercice courant',
                value: current_fiscal_year ? current_fiscal_year.label : 'Aucun',
            },
        ],
        columns: 3,
    } only %}

    <hr class="my-4">

    <h2 class="h5 mb-3 text-danger">Zone de danger</h2>
    <div class="border border-danger rounded-3 p-3">
        <div class="mb-4">
            <h3 class="h6">Supprimer tous les mouvements d'un compte</h3>
            <p class="text-body-secondary small mb-2">
                Supprime définitivement tous les mouvements et soldes de référence du compte sélectionné. Cette action est irréversible.
            </p>
            <div class="row g-2 align-items-end">
                <div class="col-12 col-md-5">
                    <label class="form-label small" for="danger-movements-account">Compte</label>
                    <select class="form-select form-select-sm" id="danger-movements-account">
                        {% for account in accounts %}
                            <option value="{{ account.id }}">{{ account.name }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-12 col-md-4">
                    <button type="button" class="btn btn-sm btn-outline-danger" id="danger-movements-btn">Supprimer les mouvements</button>
                </div>
            </div>
        </div>

        <div>
            <h3 class="h6">Supprimer tous les reçus</h3>
            <p class="text-body-secondary small mb-2">
                Archive tous les reçus (les fichiers restent sur le disque, chiffrés). Cette action est irréversible.
            </p>
            <button type="button" class="btn btn-sm btn-outline-danger" id="danger-receipts-btn">Supprimer tous les reçus</button>
        </div>
    </div>
{% endblock %}

{% block scripts %}
<script src="/assets/js/finance-config.js" defer></script>
{% endblock %}
