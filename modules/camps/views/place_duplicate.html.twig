{% extends 'base.html.twig' %}

{#
  The submitted camp travels through both forms as hidden fields, so
  choosing an existing place — or insisting on a new one — costs the chief
  nothing they already typed. Written once as a macro because the two
  copies differed only in whether `place_id` was skipped, and a hidden
  field silently dropped from one of them is a form that loses a field
  with nothing on screen to show for it.
#}
{% macro submitted_fields(submitted, skip) %}
    {% for key, value in submitted %}
        {% if key != '_csrf_token' and key not in skip %}
            {% if value is iterable %}
                {% for item in value %}
                    <input type="hidden" name="{{ key }}[]" value="{{ item }}">
                {% endfor %}
            {% else %}
                <input type="hidden" name="{{ key }}" value="{{ value }}">
            {% endif %}
        {% endif %}
    {% endfor %}
{% endmacro %}

{% block title %}Ce lieu existe peut-être déjà — {{ site_name }}{% endblock %}
{% block content %}
    <div class="page-medium">
        {% include 'partials/page_header.html.twig' with {
            title: 'Ce lieu semble peut-être déjà exister',
            subtitle: 'Une unité retourne souvent sur le même terrain, encodé autrement des années plus tard.',
        } only %}

        <div class="list-group mb-4">
            {% for candidate in candidates %}
                <div class="list-group-item">
                    <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
                        <div class="min-w-0">
                            <div class="fw-semibold">{{ candidate.place.name }}</div>
                            {% if candidate.place.locality() %}
                                <div class="small text-body-secondary">{{ candidate.place.locality() }}</div>
                            {% endif %}
                            <div class="small text-body-secondary">{{ candidate.reason }}</div>
                        </div>
                        <form method="post" action="/chefs/camps">
                            {{ csrf_field() }}
                            {{ _self.submitted_fields(submitted, ['place_id']) }}
                            <input type="hidden" name="place_id" value="{{ candidate.place.id }}">
                            <button type="submit" class="btn btn-primary btn-sm">
                                C'est ce lieu
                            </button>
                        </form>
                    </div>
                </div>
            {% endfor %}
        </div>

        <form method="post" action="/chefs/camps">
            {{ csrf_field() }}
            {{ _self.submitted_fields(submitted, []) }}
            <input type="hidden" name="confirm_new" value="1">
            <button type="submit" class="btn btn-outline-secondary">
                Non, créer un nouveau lieu
            </button>
        </form>
    </div>
{% endblock %}
