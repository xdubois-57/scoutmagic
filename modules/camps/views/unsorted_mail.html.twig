{% extends 'base.html.twig' %}
{% block title %}Courrier des camps — {{ site_name }}{% endblock %}
{% block content %}
    <div class="page-wide">
        {% include 'partials/page_header.html.twig' with {
            title: 'Courrier des camps',
            subtitle: 'Les messages que le site rattache à un séjour, ceux qu\'il propose d\'y rattacher, et — sur une boîte dédiée aux camps — tout le reste de cette boîte.',
        } only %}

        {% if not has_inbound_mail %}
            {% include 'partials/empty_state.html.twig' with {
                message: 'Aucune boîte n\'est relevée par le site : rien n\'arrive ici. Un administrateur peut en raccorder une dans la configuration du module Courrier entrant.',
                icon: 'bi-envelope',
            } only %}
        {% elseif messages is empty %}
            {% include 'partials/empty_state.html.twig' with {
                message: 'Aucun message à trier.',
                icon: 'bi-envelope-check',
            } only %}
        {% else %}

            <div class="d-flex flex-column gap-3">
                {% for row in messages %}
                    <div class="card">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start gap-2 flex-wrap">
                                <div class="min-w-0">
                                    <div class="fw-semibold">{{ row.message.subject ?: 'Sans objet' }}</div>
                                    <div class="small text-body-secondary">{{ row.message.displayFrom() }}</div>
                                </div>
                                <span class="small text-body-secondary text-nowrap">
                                    {{ row.message.sentAt|date_fr }}
                                </span>
                            </div>

                            {% if row.has_body %}
                                {# Le message est lisible en entier ici. On ne
                                   supprime plus définitivement un courrier qu'on
                                   ne peut pas lire — et un extrait de 220
                                   caractères ne dit pas si le message parle du
                                   séjour de 2027 ou d'une facture. #}
                                <details class="mt-2">
                                    <summary class="small text-body-secondary">
                                        {{ row.excerpt }}{{ row.truncated ? '…' : '' }}
                                    </summary>
                                    <div class="mt-2 camps-message-body">
                                        {% if row.message.bodyHtml is not empty %}
                                            {# Déjà assaini et débarrassé des images
                                               distantes au stockage (§8.58). #}
                                            {{ row.message.bodyHtml|raw }}
                                        {% else %}
                                            <pre class="mb-0 text-body-secondary" style="white-space: pre-wrap;">{{ row.message.bodyText }}</pre>
                                        {% endif %}
                                    </div>
                                </details>
                            {% endif %}

                            {% if row.attachment_count > 0 %}
                                <div class="small mt-2">
                                    <i class="bi bi-paperclip" aria-hidden="true"></i>
                                    {{ row.attachment_count }} pièce{{ row.attachment_count > 1 ? 's' : '' }} jointe{{ row.attachment_count > 1 ? 's' : '' }}
                                </div>
                            {% endif %}

                            {# Ce que CE module en a fait, et rien d'autre : les
                               rattachements d'un autre module ne regardent pas
                               cet écran. #}
                            {% if row.links is not empty %}
                                <div class="mt-2 d-flex flex-wrap gap-1">
                                    {% for link in row.links %}
                                        <span class="badge text-bg-success">Rattaché — {{ link.businessReference }}</span>
                                    {% endfor %}
                                </div>
                            {% endif %}

                            {% if row.candidates is not empty %}
                                <div class="mt-3">
                                    <div class="small fw-semibold">Propositions à confirmer</div>
                                    <ul class="list-group list-group-flush">
                                        {% for candidate in row.candidates %}
                                            <li class="list-group-item px-0 d-flex flex-wrap justify-content-between align-items-center gap-2">
                                                <div>
                                                    <div>{{ candidate.label }}</div>
                                                    <div class="small text-body-secondary">{{ candidate.explanation }}</div>
                                                </div>
                                                <div class="d-flex gap-2">
                                                    <form method="post"
                                                          action="/chefs/camps/courrier/{{ row.message.id }}/proposition/confirmation">
                                                        {{ csrf_field()|raw }}
                                                        <input type="hidden" name="candidate_id" value="{{ candidate.id }}">
                                                        <button type="submit" class="btn btn-primary btn-sm">Rattacher</button>
                                                    </form>
                                                    <form method="post"
                                                          action="/chefs/camps/courrier/{{ row.message.id }}/proposition/rejet">
                                                        {{ csrf_field()|raw }}
                                                        <input type="hidden" name="candidate_id" value="{{ candidate.id }}">
                                                        <button type="submit" class="btn btn-outline-secondary btn-sm">Écarter</button>
                                                    </form>
                                                </div>
                                            </li>
                                        {% endfor %}
                                    </ul>
                                    {% if row.candidates|length > 1 %}
                                        <p class="small text-body-secondary mb-0">
                                            Plusieurs séjours correspondent : le site n'en choisit aucun tant que
                                            vous n'avez pas tranché.
                                        </p>
                                    {% endif %}
                                </div>
                            {% endif %}

                            <div class="d-flex flex-wrap align-items-end gap-2 mt-3">
                                <form method="post" action="/chefs/camps/courrier/{{ row.message.id }}/rattacher"
                                      class="d-flex flex-wrap align-items-end gap-2 flex-grow-1">
                                    {{ csrf_field()|raw }}
                                    <div class="flex-grow-1" style="min-width: 14rem;">
                                        {% include 'partials/form_field.html.twig' with {
                                            field_id: 'camp-' ~ row.message.id,
                                            field_name: 'camp_id',
                                            label: 'Rattacher à',
                                            type: 'select', size: 'sm',
                                            options: camp_options,
                                            wrapper_class: 'mb-0',
                                        } only %}
                                    </div>
                                    <button type="submit" class="btn btn-primary btn-sm">Rattacher</button>
                                </form>

                                {# Le message ne correspond à aucun séjour connu :
                                   en créer un depuis ce qu'il dit, plutôt que de
                                   retaper des dates qu'on a sous les yeux. #}
                                <a class="btn btn-outline-secondary btn-sm"
                                   href="/chefs/camps/nouveau?message={{ row.message.id }}">
                                    <i class="bi bi-plus-lg" aria-hidden="true"></i>
                                    Créer un camp depuis ce message
                                </a>

                                {% for link in row.links %}
                                    <form method="post" action="/chefs/camps/courrier/{{ row.message.id }}/supprimer"
                                          data-confirm="Retirer ce message du séjour ? Il reste dans le courrier de l'unité.">
                                        {{ csrf_field()|raw }}
                                        <input type="hidden" name="business_reference" value="{{ link.businessReference }}">
                                        <button type="submit" class="btn btn-outline-danger btn-sm">
                                            Retirer de {{ link.businessReference }}
                                        </button>
                                    </form>
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}

        <p class="text-body-secondary small mt-4">
            Un message que rien ne rattache et sur lequel aucune proposition ne subsiste est
            supprimé automatiquement au terme du délai de conservation réglé pour le courrier
            entrant.
        </p>
    </div>
{% endblock %}
