{% extends 'base.html.twig' %}
{% block title %}Courrier des camps — {{ site_name }}{% endblock %}
{% block content %}
    <div class="page-wide">
        {% include 'partials/page_header.html.twig' with {
            title: 'Courrier des camps',
            subtitle: 'Les messages que le site rattache à un séjour, ceux qu\'il propose d\'y rattacher, et — sur une boîte dédiée aux camps — tout le reste de cette boîte.',
        } only %}

        {# The screen is the component every module's triage shares
           (@inbound_mail/partials/triage.html.twig, issue #462): what is
           the camps' own here is only what their objects are called, where
           the actions post, and how a stay is picked. #}
        {% include '@inbound_mail/partials/triage.html.twig' with {
            messages: messages, status: status, counts: counts,
            include_bulk: include_bulk, bulk_count: bulk_count,
            triage_ui: {
                has_inbound_mail: has_inbound_mail,
                filter_url: '',
                urls: {
                    reanalyze: '/chefs/camps/courrier/relancer',
                    attach: '/chefs/camps/courrier/{id}/rattacher',
                    detach: '/chefs/camps/courrier/{id}/supprimer',
                    dismiss: '/chefs/camps/courrier/{id}/ecarter',
                    restore: '/chefs/camps/courrier/{id}/reprendre',
                    confirm: '/chefs/camps/courrier/{id}/proposition/confirmation',
                    reject: '/chefs/camps/courrier/{id}/proposition/rejet',
                },
                hidden: {},
                list_name: 'des camps',
                noun_from: 'du séjour',
                attach_other: 'Rattacher à un autre séjour',
                attach_also: 'Rattacher aussi à un autre séjour',
                labels: labels,
                reference_urls: reference_urls,
                can_search_stays: can_search_stays,
                picker_template: '@camps/partials/triage_picker.html.twig',
                row_extra_template: '@camps/partials/triage_create_camp.html.twig',
            },
        } only %}
    </div>
    {% include '@inbound_mail/partials/triage_dialog.html.twig' %}
{% endblock %}

{% block scripts %}
    <script src="{{ asset('/assets/js/mail-message-dialog.js') }}" defer></script>
    <script src="{{ asset('/assets/js/camps-stay-picker.js') }}" defer></script>
{% endblock %}
