{% extends 'base.html.twig' %}
{% block title %}Courrier des camps — {{ site_name }}{% endblock %}
{% block content %}
    <div class="page-wide">
        {% include 'partials/page_header.html.twig' with {
            title: 'Courrier des camps',
            subtitle: 'Les messages que le site rattache à un séjour, ceux qu\'il propose d\'y rattacher, et — sur une boîte dédiée aux camps — tout le reste de cette boîte.',
        } only %}

        {% if has_inbound_mail %}
            {# « Relancer l'analyse » — the site's knowledge moves and the
               mail already collected does not follow it. Attaching one
               e-mail of a thread to a stay makes the rest of that thread
               attributable, creating a place makes a farmer's address start
               matching; a message analysed the day it arrived was analysed
               against what the site knew that day.

               Shown even with nothing to triage: « rien ne remonte » is a
               question a chief asks on an empty screen too, and a button
               that appears only when it has work looks broken exactly then.
               Its answer says so plainly. #}
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                {# Unattached first, and by default: what a chief comes here
                   to do is decide about the mail nobody could attribute.
                   Counts on the tabs rather than beside them: « rien à
                   trier » and « le filtre cache tout » look identical on an
                   empty list, and only a number tells them apart. #}
                <ul class="nav nav-pills gap-1 mb-0" aria-label="Filtrer le courrier">
                    {% for key, label in {
                        'non_rattaches': 'À trier',
                        'rattaches': 'Rattachés',
                        'tous': 'Tous',
                    } %}
                        <li class="nav-item">
                            <a class="nav-link{{ status == key ? ' active' : '' }}"
                               href="?statut={{ key }}{{ include_bulk ? '&automatique=1' : '' }}"
                               {{ status == key ? 'aria-current="page"' : '' }}>
                                {{ label }}
                                <span class="badge rounded-pill text-bg-{{ status == key ? 'light' : 'secondary' }}">
                                    {{ counts[key] }}
                                </span>
                            </a>
                        </li>
                    {% endfor %}
                </ul>
                <form method="post" action="/chefs/camps/courrier/relancer">
                    {{ csrf_field()|raw }}
                    <button type="submit" class="btn btn-sm btn-outline-secondary"
                            title="Réexamine les messages qui ne sont rattachés à rien, avec ce que le site sait aujourd'hui. Rien n'est jamais détaché, et une proposition écartée le reste.">
                        <i class="bi bi-arrow-clockwise" aria-hidden="true"></i>
                        Relancer l'analyse
                    </button>
                </form>
            </div>
        {% endif %}

        {% if not has_inbound_mail %}
            {% include 'partials/empty_state.html.twig' with {
                message: 'Aucune boîte n\'est relevée par le site : rien n\'arrive ici. Un administrateur peut en raccorder une dans la configuration du module Courrier entrant.',
                icon: 'bi-envelope',
            } only %}
        {% elseif messages is empty %}
            {% include 'partials/empty_state.html.twig' with {
                message: counts.tous > 0
                    ? 'Aucun message dans ce filtre. Les autres sont sous les onglets ci-dessus.'
                    : 'Aucun message à trier.',
                icon: 'bi-envelope-check',
            } only %}
        {% else %}

            <div class="d-flex flex-column gap-3">
                {% for row in messages %}
                    <div class="card">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start gap-2 flex-wrap">
                                <div class="min-w-0">
                                    <div class="fw-semibold">{{ row.message.subject ?: 'Sans objet' }}</div>
                                    <div class="small text-body-secondary">{{ row.message.displayFrom() }}</div>
                                </div>
                                <span class="small text-body-secondary text-nowrap">
                                    {{ row.message.sentAt|date_fr }}
                                    {% if row.message.isBulk %}<span class="badge text-bg-light">automatique</span>{% endif %}
                                </span>
                            </div>

                            {% if row.has_body %}
                                {# One line, not a paragraph. The excerpt used to
                                   run to 220 characters — three lines per message,
                                   turning a list of decisions into a wall of text.
                                   It now fits one truncated line, and the whole
                                   message opens in a dialog.

                                   The body is rendered HERE, hidden, and MOVED
                                   into the dialog on opening: no HTML string
                                   travels through an attribute or innerHTML. It
                                   was sanitised and stripped of remote images when
                                   stored (§8.58); that is no reason to run it
                                   through a second parse in the browser. #}
                                <div class="small text-body-secondary text-truncate mt-2">{{ row.excerpt }}</div>
                                <button type="button" class="btn btn-link btn-sm p-0 mt-1"
                                        data-camps-message-open="camps-message-body-{{ row.message.id }}"
                                        data-camps-message-title="{{ row.message.subject ?: 'Sans objet' }}"
                                        data-camps-message-meta="{{ row.message.displayFrom() }} · {{ row.message.sentAt|datetime_fr }}">
                                    <i class="bi bi-envelope-open" aria-hidden="true"></i>
                                    Lire le message
                                </button>
                                <div class="d-none camps-message-body" id="camps-message-body-{{ row.message.id }}">
                                    {% include '@inbound_mail/partials/message_body.html.twig' with { message: row.message } only %}
                                </div>
                            {% endif %}

                            {% if row.message.hasAttachments or row.message.hasOmittedAttachments %}
                                {# Openable from the card: a chief decides about a
                                   contract by reading it, not by counting it. #}
                                <div class="mt-2">
                                    {% include '@inbound_mail/partials/attachments.html.twig' with { message: row.message, downloadable: true } only %}
                                </div>
                            {% endif %}

                            {# What THIS module made of it and nothing else:
                               another module's associations are not this
                               screen's business. #}
                            {% if row.links is not empty %}
                                <div class="mt-2 d-flex flex-wrap gap-1">
                                    {% for link in row.links %}
                                        {% set campId = link.businessReference|replace({'camp-': ''}) %}
                                        <a class="badge text-bg-success text-decoration-none" href="/chefs/camps/sejours/{{ campId }}">
                                            Rattaché — {{ row.labels[link.businessReference]|default(link.businessReference) }}
                                        </a>
                                    {% endfor %}
                                </div>
                            {% endif %}

                            {% if row.candidates is not empty %}
                                <div class="mt-3">
                                    <div class="small fw-semibold">Propositions à confirmer</div>
                                    <ul class="list-group list-group-flush">
                                        {% for candidate in row.candidates %}
                                            <li class="list-group-item px-0 d-flex flex-wrap justify-content-between align-items-center gap-2">
                                                <div>
                                                    <div>{{ candidate.label }}</div>
                                                    <div class="small text-body-secondary">{{ candidate.explanation }}</div>
                                                </div>
                                                <div class="d-flex gap-2">
                                                    <form method="post"
                                                          action="/chefs/camps/courrier/{{ row.message.id }}/proposition/confirmation">
                                                        {{ csrf_field()|raw }}
                                                        <input type="hidden" name="candidate_id" value="{{ candidate.id }}">
                                                        <button type="submit" class="btn btn-primary btn-sm">Rattacher</button>
                                                    </form>
                                                    <form method="post"
                                                          action="/chefs/camps/courrier/{{ row.message.id }}/proposition/rejet">
                                                        {{ csrf_field()|raw }}
                                                        <input type="hidden" name="candidate_id" value="{{ candidate.id }}">
                                                        <button type="submit" class="btn btn-outline-secondary btn-sm">Écarter</button>
                                                    </form>
                                                </div>
                                            </li>
                                        {% endfor %}
                                    </ul>
                                    {% if row.candidates|length > 1 %}
                                        <p class="small text-body-secondary mb-0">
                                            Plusieurs séjours correspondent : le site n'en choisit aucun tant que
                                            vous n'avez pas tranché.
                                        </p>
                                    {% endif %}
                                </div>
                            {% endif %}

                            {# ONE primary gesture per card. When the module
                               proposed something, or already filed the message,
                               the free picker sits behind a fold, so two
                               « Rattacher » buttons never face the chief at
                               once; with nothing proposed the picker IS the
                               gesture and stands on its own. #}
                            {% set folded = row.candidates is not empty or row.links is not empty %}
                            {% if folded %}
                            <details class="mt-3">
                                <summary class="btn btn-link btn-sm p-0">
                                    {{ row.links is empty ? 'Rattacher à un autre séjour' : 'Rattacher aussi à un autre séjour' }}
                                </summary>
                            {% else %}
                            <div class="mt-3">
                            {% endif %}
                                <div class="d-flex flex-wrap align-items-end gap-2 mt-2">
                                    <form method="post" action="/chefs/camps/courrier/{{ row.message.id }}/rattacher"
                                          class="d-flex flex-wrap align-items-end gap-2 flex-grow-1">
                                        {{ csrf_field()|raw }}
                                        <div class="flex-grow-1" style="min-width: 14rem;">
                                            {% include '@camps/partials/stay_picker.html.twig' with {
                                                message_id: row.message.id,
                                                options: row.camp_options,
                                                preferred_ids: row.preferred_stay_ids,
                                                searchable: can_search_stays,
                                            } only %}
                                        </div>
                                        <button type="submit" class="btn btn-primary btn-sm">Rattacher</button>
                                    </form>

                                    {# The message matches no known stay: create one
                                       from what it says rather than retype dates that
                                       are right there. #}
                                    <a class="btn btn-outline-secondary btn-sm"
                                       href="/chefs/camps/nouveau?message={{ row.message.id }}">
                                        <i class="bi bi-plus-lg" aria-hidden="true"></i>
                                        Créer un camp depuis ce message
                                    </a>
                                </div>
                            {% if folded %}
                            </details>
                            {% else %}
                            </div>
                            {% endif %}

                            {% if row.links is not empty %}
                                <div class="d-flex flex-wrap gap-2 mt-2">
                                    {% for link in row.links %}
                                        <form method="post" action="/chefs/camps/courrier/{{ row.message.id }}/supprimer"
                                              data-confirm="Détacher ce message du séjour ? Il reste dans le courrier de l'unité.">
                                            {{ csrf_field()|raw }}
                                            <input type="hidden" name="business_reference" value="{{ link.businessReference }}">
                                            <button type="submit" class="btn btn-outline-danger btn-sm">
                                                Détacher de « {{ row.labels[link.businessReference]|default(link.businessReference) }} »
                                            </button>
                                        </form>
                                    {% endfor %}
                                </div>
                            {% endif %}
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}

        {% if has_inbound_mail and bulk_count > 0 %}
            <p class="mt-3 mb-0">
                {% if include_bulk %}
                    <a href="?statut={{ status }}">Masquer le courrier automatique</a>
                {% else %}
                    <a href="?statut={{ status }}&automatique=1">Afficher le courrier automatique ({{ bulk_count }})</a>
                {% endif %}
            </p>
        {% endif %}

        <p class="text-body-secondary small mt-4">
            Un message que rien ne rattache et sur lequel aucune proposition ne subsiste est
            supprimé automatiquement au terme du délai de conservation réglé pour le courrier
            entrant.
        </p>
    </div>

    {# ONE dialog for the whole page, filled on opening by MOVING the body
       already rendered. A dialog per message would keep a hundred message
       bodies in the DOM of a screen that shows their titles. #}
    {% embed 'partials/modal.html.twig' with { id: 'camps-message-modal', title: 'Message', scrollable: true, size: 'lg' } only %}
        {% block body %}
            <p id="camps-message-modal-meta" class="small text-body-secondary"></p>
            <div id="camps-message-modal-body"></div>
        {% endblock %}
        {% block footer %}
            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Fermer</button>
        {% endblock %}
    {% endembed %}
{% endblock %}

{% block scripts %}
    <script src="{{ asset('/assets/js/camps-message-dialog.js') }}" defer></script>
    <script src="{{ asset('/assets/js/camps-stay-picker.js') }}" defer></script>
{% endblock %}
