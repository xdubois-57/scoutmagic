{% extends 'base.html.twig' %}
{% block title %}Camps — {{ site_name }}{% endblock %}
{% block content %}
    {% include 'partials/page_header.html.twig' with {
        title: archived ? 'Lieux archivés' : 'Camps',
        subtitle: archived
            ? 'Les lieux retirés des écrans courants. Rien n\'est supprimé.'
            : 'Les terrains où l\'unité a campé, et ce que les staffs d\'avant en ont pensé.',
        action_label: archived ? '' : 'Nouveau camp',
        action_url: '/chefs/camps/nouveau',
    } only %}

    <form method="get" action="/chefs/camps" class="mb-4" role="search">
        {% if archived %}<input type="hidden" name="archives" value="1">{% endif %}
        <div class="input-group">
            <span class="input-group-text" aria-hidden="true"><i class="bi bi-search"></i></span>
            <input type="search" name="q" value="{{ search_term }}" class="form-control"
                   placeholder="Lieu, adresse, code postal, ville…"
                   aria-label="Rechercher un lieu de camp">
            <button class="btn btn-outline-secondary" type="submit">Chercher</button>
        </div>
        {# The placeholder promises exactly what PlaceRepository::search()
           looks at. Contacts and the booking person are encrypted BLOBs
           and are deliberately not searched — promising them here and not
           finding them would be worse than not offering them. #}
    </form>

    {% if not archived %}
        <h2 class="h6 text-uppercase text-body-secondary mb-2">À venir · {{ upcoming|length }}</h2>
        {% if upcoming is empty %}
            {% include 'partials/empty_state.html.twig' with {
                message: search_term
                    ? 'Aucun camp à venir ne correspond à cette recherche.'
                    : 'Aucun camp prévu pour le moment.',
                compact: true,
            } only %}
        {% else %}
            <div class="row row-cols-1 row-cols-lg-2 g-3">
                {% for entry in upcoming %}
                    <div class="col">
                        {% include '@camps/_camp_card.html.twig' with { entry: entry, place: entry.place } only %}
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    {% endif %}

    <div class="d-flex align-items-baseline justify-content-between mt-4 mb-2">
        <h2 class="h6 text-uppercase text-body-secondary mb-0">Lieux · {{ places|length }}</h2>
        <a class="small" href="/chefs/camps{{ archived ? '' : '?archives=1' }}">
            {{ archived ? 'Retour aux lieux actifs' : 'Archives' }}
        </a>
    </div>

    {% if places is empty %}
        {% include 'partials/empty_state.html.twig' with {
            message: search_term
                ? 'Aucun lieu ne correspond à cette recherche.'
                : (archived ? 'Aucun lieu archivé.' : 'Aucun lieu enregistré pour le moment.'),
            icon: 'bi-geo-alt',
            action_label: (search_term or archived) ? '' : 'Nouveau camp',
            action_url: '/chefs/camps/nouveau',
        } only %}
    {% else %}
        <div class="row row-cols-1 row-cols-lg-2 g-3">
            {% for entry in places %}
                <div class="col">
                    <a href="/chefs/camps/lieux/{{ entry.place.id }}"
                       class="card text-decoration-none text-body h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start gap-2">
                                <div class="min-w-0">
                                    <div class="fw-semibold">{{ entry.place.name }}</div>
                                    {% if entry.place.locality() %}
                                        <div class="small text-body-secondary">{{ entry.place.locality() }}</div>
                                    {% endif %}
                                </div>
                                <i class="bi bi-chevron-right text-body-secondary" aria-hidden="true"></i>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mt-2">
                                {% if entry.latest_rating %}
                                    <span>
                                        {% include '@camps/_stars.html.twig' with { rating: entry.latest_rating.rating } only %}
                                        <span class="small text-body-secondary">{{ entry.latest_rating.year }}</span>
                                    </span>
                                {% else %}
                                    <span class="small text-body-secondary">Pas d'avis</span>
                                {% endif %}
                                <span class="small text-body-secondary">
                                    {{ entry.stay_count }} séjour{{ entry.stay_count > 1 ? 's' : '' }}
                                </span>
                            </div>
                        </div>
                    </a>
                </div>
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}
