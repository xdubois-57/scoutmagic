{% extends 'base.html.twig' %}
{% block title %}{{ place.name }} — {{ site_name }}{% endblock %}
{% block content %}
    <div class="page-wide">
        {% include 'partials/page_header.html.twig' with {
            title: place.name,
            subtitle: place.locality(),
            action_label: 'Nouveau camp ici',
            action_url: '/chefs/camps/nouveau?lieu=' ~ place.id,
        } only %}

        {% if latest_rating %}
            <p class="mb-3">
                {% include '@camps/_stars.html.twig' with { rating: latest_rating.rating } only %}
                <span class="small text-body-secondary">
                    — avis du séjour de {{ latest_rating.year }}. Ce lieu n'a pas de moyenne :
                    c'est le dernier avis chiffré qui compte.
                </span>
            </p>
        {% endif %}

        <div class="d-flex flex-wrap gap-2 mb-4">
            {% if place.address %}
                <span class="badge bg-body-tertiary border text-body-secondary">
                    <i class="bi bi-geo-alt" aria-hidden="true"></i> {{ place.address }}
                </span>
            {% endif %}
            {% if place.websiteUrl %}
                <a class="btn btn-sm btn-outline-secondary" href="{{ place.websiteUrl }}"
                   target="_blank" rel="noopener noreferrer">
                    <i class="bi bi-link-45deg" aria-hidden="true"></i> Site du lieu
                </a>
            {% endif %}
            {% if place.hasCoordinates() %}
                <span class="badge bg-body-tertiary border text-body-secondary">
                    <i class="bi bi-geo" aria-hidden="true"></i>
                    {{ place.latitude|number_format(5, ',', ' ') }}, {{ place.longitude|number_format(5, ',', ' ') }}
                </span>
            {% endif %}
            <a class="btn btn-sm btn-outline-secondary" href="/chefs/camps/lieux/{{ place.id }}/modifier">
                <i class="bi bi-pencil" aria-hidden="true"></i> Modifier le lieu
            </a>
        </div>

        {% if place.aiSummary or summary_available %}
            <div class="card bg-body-tertiary mb-4">
                <div class="card-body">
                    <div class="small text-uppercase text-body-secondary fw-semibold">
                        <i class="bi bi-stars" aria-hidden="true"></i> Résumé automatique
                    </div>
                    {% if place.aiSummary %}
                        <p class="mt-2 mb-2">{{ place.aiSummary }}</p>
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                            {# Dated, and explicitly not a source of truth: a
                               reader has to know how old it is and where the
                               real answer lives. #}
                            <span class="small text-body-secondary">
                                Généré le {{ place.aiSummaryGeneratedAt|date_fr }}
                                {%- if place.aiSummaryIsStale %}, à régénérer{% endif %} ·
                                écrit automatiquement à partir des avis — à vérifier dans les avis eux-mêmes.
                            </span>
                            {% if summary_available %}
                                <form method="post" action="/chefs/camps/lieux/{{ place.id }}/resume" data-summary-form>
                                    {{ csrf_field()|raw }}
                                    <button type="submit" class="btn btn-link btn-sm p-0">Régénérer</button>
                                </form>
                            {% endif %}
                        </div>
                    {% else %}
                        <p class="small text-body-secondary mt-2 mb-2">
                            Pas encore de résumé pour ce lieu. Il s'écrit tout seul une fois qu'il y a
                            des avis ou des prix à comparer.
                        </p>
                        <form method="post" action="/chefs/camps/lieux/{{ place.id }}/resume" data-summary-form>
                            {{ csrf_field()|raw }}
                            <button type="submit" class="btn btn-link btn-sm p-0">Écrire le résumé maintenant</button>
                        </form>
                    {% endif %}
                </div>
            </div>
        {% endif %}

        <h2 class="h6 text-uppercase text-body-secondary mb-2">Camps à venir</h2>
        {% if upcoming is empty %}
            {% include 'partials/empty_state.html.twig' with {
                message: 'Aucun séjour prévu ici.', compact: true,
            } only %}
        {% else %}
            <div class="row row-cols-1 row-cols-lg-2 g-3">
                {% for entry in upcoming %}
                    <div class="col">{% include '@camps/_camp_card.html.twig' with { entry: entry } only %}</div>
                {% endfor %}
            </div>
        {% endif %}

        <h2 class="h6 text-uppercase text-body-secondary mt-4 mb-2">Camps passés · {{ past_total }}</h2>
        {% if past_total > 0 or status_filter %}
            {# A filter rather than a page, but the set is fixed, declared
               in CampsChiefController::statusChips() and short-labelled —
               the nav rail's case per docs/module-development.md's rule.
               The ?statut= URL contract is unchanged. #}
            {% include 'partials/nav_rail.html.twig' with {
                picker_id: 'camps-past-status',
                items: status_chips,
                base_url: '/chefs/camps/lieux/' ~ place.id ~ '?statut=',
                aria_label: 'Filtrer les camps passés par statut',
            } %}
        {% endif %}

        <div class="row row-cols-1 row-cols-lg-2 g-3 mt-1">
            {% for entry in past %}
                <div class="col">
                    {% include '@camps/_camp_card.html.twig' with {
                        entry: entry|merge({ review: reviews[entry.camp.id]|default(null) })
                    } only %}
                </div>
            {% else %}
                <div class="col-12">
                    {% include 'partials/empty_state.html.twig' with {
                        message: status_filter ? 'Aucun séjour dans cette catégorie.' : 'Aucun séjour passé enregistré ici.',
                        compact: true,
                    } only %}
                </div>
            {% endfor %}
        </div>

        {% if past_page_count > 1 %}
            <div class="mt-3">
                {% include 'partials/pagination.html.twig' with {
                    page: past_page,
                    total_pages: past_page_count,
                    base_url: past_base_url,
                    label: 'Pagination des séjours passés',
                } only %}
            </div>
        {% endif %}

        {% if is_unit_chief %}
            <div class="d-flex flex-wrap gap-2 mt-4 pt-3 border-top">
                <a class="btn btn-outline-secondary btn-sm" href="/chefs/camps/lieux/{{ place.id }}/fusionner">
                    <i class="bi bi-signpost-split" aria-hidden="true"></i> Fusionner ce lieu
                </a>
                {% if place.isArchived %}
                    <form method="post" action="/chefs/camps/lieux/{{ place.id }}/restaurer">
                        {{ csrf_field()|raw }}
                        <button type="submit" class="btn btn-outline-secondary btn-sm">Restaurer</button>
                    </form>
                {% else %}
                    <form method="post" action="/chefs/camps/lieux/{{ place.id }}/archiver"
                          data-confirm="Archiver ce lieu ? Il disparaîtra des écrans courants et de la recherche. Rien n'est supprimé.">
                        {{ csrf_field()|raw }}
                        <button type="submit" class="btn btn-outline-secondary btn-sm">Archiver</button>
                    </form>
                {% endif %}
            </div>
            {% if archive_warning %}
                <p class="small text-body-secondary mt-2">{{ archive_warning }}</p>
            {% endif %}
        {% endif %}

        <h2 class="h6 text-uppercase text-body-secondary mt-4 mb-2">Historique</h2>
        {% include 'partials/audit_timeline.html.twig' with {
            entity_type: 'camp_place',
            entity_id: place.id,
            audit_page: audit_page,
            labels: audit_labels,
            collapsed: true,
        } only %}
    </div>
{% endblock %}

{% block scripts %}
    {# The summary is written by the LLM connector, which takes seconds:
       without a busy state the button looks inert and gets pressed twice,
       which is a second paid call for the same place. #}
    <script src="{{ asset('/assets/js/camps-place-summary.js') }}" defer></script>
{% endblock %}
