  "settings": [
    {
      "key": "camps_default_country",
      "default_value": "Belgique",
      "type": "text",
      "label": "Pays par défaut d'un nouveau lieu",
      "description": "Pré-rempli à la création d'un lieu de camp. La très grande majorité des terrains d'une unité sont dans un seul pays ; le champ reste modifiable lieu par lieu."
    },
    {
      "key": "camps_past_stays_per_page",
      "default_value": "20",
      "type": "number",
      "label": "Nombre de séjours passés affichés par lieu",
      "description": "Sur la fiche d'un lieu, nombre de séjours passés affichés avant de devoir en demander davantage."
    },
    {
      "key": "camps_geocoding_enabled",
      "default_value": "1",
      "type": "boolean",
      "label": "Géocoder automatiquement les lieux",
      "description": "Cherche les coordonnées d'un lieu à partir de son adresse, via OpenStreetMap (Nominatim). Un lieu dont les coordonnées ont été saisies ou corrigées à la main n'est jamais retouché. Désactivez ce réglage pour n'envoyer aucune adresse à un service extérieur."
    },
    {
      "key": "camps_dedicated_mailbox_ids",
      "default_value": "",
      "type": "text",
      "label": "Boîtes aux lettres dédiées aux camps",
      "description": "RÉGLAGE HISTORIQUE, plus lu par le module. Le choix se fait désormais sur Configuration > Courrier entrant, en déclarant la boîte « dédiée » au module Camps : c'est ce choix-là, et lui seul, qui autorise la création automatique d'un séjour. Cette valeur n'est conservée que pour la reprise automatique d'une installation qui n'a pas encore vu le nouvel écran."
    },
    {
      "key": "camps_short_stay_max_days",
      "default_value": "4",
      "type": "number",
      "label": "Durée maximale d'un petit camp (jours)",
      "description": "Un séjour de cette durée ou moins est un « Petit camp » ; au-delà, un « Grand camp ». Compté en jours entiers, arrivée et départ compris : un vendredi-dimanche fait trois jours. Sert uniquement à proposer un type quand les dates sont connues — depuis un message reçu, ou dans le formulaire prérempli — et un chef peut toujours en changer avant d'enregistrer."
    },
    {
      "key": "camps_auto_create_from_mail",
      "default_value": "1",
      "type": "boolean",
      "label": "Créer un camp depuis un message",
      "description": "Dans une boîte dédiée uniquement : si un message annonce des dates sans ambiguïté, un séjour est créé automatiquement, visiblement marqué comme tel. Le lieu est d'abord un terrain déjà connu ; un nouveau terrain n'est créé que si le module Connecteur Intelligence Artificielle est actif, son nom ET son adresse étant alors lus dans le contenu du message — objet, corps et pièces jointes — un contrat de location arrivant presque toujours en PDF avec un corps d'un mot ; un document scanné ou photographié est transcrit par le modèle, au plus une fois par message — mais jamais dans le nom de l'expéditeur. Sans ce réglage, ou faute de lieu, le message reste sans rattachement, avec une action « Créer un camp depuis ce message »."
    },
    {
      "key": "camps_ai_summary_enabled",
      "default_value": "1",
      "type": "boolean",
      "label": "Résumé automatique des lieux",
      "description": "Si le connecteur IA est actif : un court résumé de ce que les séjours et les avis d'un lieu racontent, régénéré une fois par jour quand quelque chose a changé. Il ne reçoit que les avis, notes, prix, statuts, dates, nombres de participants et sections — jamais les contacts ni les e-mails reçus."
    }
  ],
  "cookies": [
    {
      "name": "camps_map_collapsed",
      "category": "functional",
      "purpose": "Mémorisation du repli de la carte des lieux de camp, pour la retrouver telle que vous l'avez laissée à chaque visite.",
      "duration": "Jusqu'au retrait (suppression manuelle ou réouverture de la carte)"
    }
  ],
  "notifications": [
