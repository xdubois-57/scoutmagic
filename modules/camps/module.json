  "settings": [
    {
      "key": "camps_default_country",
      "default_value": "Belgique",
      "type": "text",
      "label": "Pays par défaut d'un nouveau lieu",
      "description": "Pré-rempli à la création d'un lieu de camp. La très grande majorité des terrains d'une unité sont dans un seul pays ; le champ reste modifiable lieu par lieu."
    },
    {
      "key": "camps_past_stays_per_page",
      "default_value": "20",
      "type": "number",
      "label": "Nombre de séjours passés affichés par lieu",
      "description": "Sur la fiche d'un lieu, nombre de séjours passés affichés avant de devoir en demander davantage."
    },
    {
      "key": "camps_geocoding_enabled",
      "default_value": "1",
      "type": "boolean",
      "label": "Géocoder automatiquement les lieux",
      "description": "Cherche les coordonnées d'un lieu à partir de son adresse, via OpenStreetMap (Nominatim). Un lieu dont les coordonnées ont été saisies ou corrigées à la main n'est jamais retouché. Désactivez ce réglage pour n'envoyer aucune adresse à un service extérieur."
    }
  ],
  "notifications": [
    {
      "id": "camps.review_due",
      "label": "Avis à donner sur un camp",
      "description": "Le lendemain de la fin d'un séjour, une invitation à laisser un avis pour les staffs suivants. Envoyée une seule fois, sans rappel.",
      "group": "Camps",
      "role_min": "chief",
      "channels": {
        "in_app": "default_on",
        "push": "default_on",
        "email": "default_off"
      }
    }
  ],
  "scheduled_tasks": [
