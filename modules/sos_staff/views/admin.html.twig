{% extends "base.html.twig" %}

{% block title %}Gérer le téléphone d'urgence — {{ site_name }}{% endblock %}

{% block stylesheets %}
{% if provider_configured %}
{# Desktop duty grid only. The phone layout below is plain Bootstrap
   utilities on purpose: it needs no rule of its own, and a rule of its
   own would have to live in public/assets/css/ (AGENTS.md § CSS). #}
<style nonce="{{ csp_nonce }}">
.sos-grid-wrapper { overflow-x: auto; }
.sos-grid { border-collapse: collapse; width: 100%; table-layout: fixed; }
.sos-grid th, .sos-grid td { border: 1px solid var(--bs-border-color, #dee2e6); padding: 0.25rem; text-align: center; }
.sos-grid th.sos-col-header { padding: 0.3rem 0.1rem 0; height: 7rem; width: 1.6rem; max-width: 1.6rem; vertical-align: bottom; font-weight: 600; }
.sos-grid th.sos-col-header .sos-col-header-label {
    writing-mode: vertical-rl;
    -webkit-writing-mode: vertical-rl;
    transform: rotate(180deg);
    display: inline-block;
    white-space: nowrap;
}
.sos-grid td.sos-day-label, .sos-grid th.sos-day-label-header { text-align: left; white-space: nowrap; font-weight: 600; width: 4.5rem; }
.sos-grid tbody tr.is-weekend td:not(.has-event):not(.state-oncall):not(.state-unavailable) { background-color: var(--bs-tertiary-bg, #f8f9fa); }
.sos-grid tbody tr.is-today td:not(.has-event):not(.state-oncall):not(.state-unavailable) { background-color: var(--bs-warning-bg-subtle, #fff3cd); }
.sos-section-divider { border-left: 3px solid var(--bs-secondary-color, #6c757d) !important; }
.sos-activity-cell { width: 1.6rem; max-width: 1.6rem; }
.sos-activity-cell.has-event { background-color: #fd7e14; }
.sos-oncall-cell { cursor: pointer; width: 1.6rem; max-width: 1.6rem; font-weight: 700; user-select: none; }
.sos-oncall-cell.state-oncall { background-color: #66bb6a; color: #fff; }
.sos-oncall-cell.state-unavailable { background-color: #ef5350; color: #fff; }
.sos-next-transition { background-color: var(--bs-warning-bg-subtle, #fff3cd); border-left: 4px solid var(--bs-warning, #ffc107) !important; }
</style>
{% endif %}
{% endblock %}

{% block content %}
    {% include 'partials/page_header.html.twig' with { title: "Gérer le téléphone d'urgence" } only %}

    {% if not provider_configured %}
        {# Issue #750: without a provider nothing on this page has any
           effect, so it says so once and shows nothing else. #}
        <div class="alert alert-warning" id="sos-not-configured">
            <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
            La téléphonie n'est pas encore configurée : le numéro SOS ne peut être redirigé vers personne.
            {% if can_configure %}
                <a href="/config/sos" class="alert-link">Configurer SOS Staff d'U</a>.
            {% else %}
                Un super-administrateur doit d'abord la configurer (Configuration › SOS Staff d'U).
            {% endif %}
        </div>
    {% else %}

    {# ------------------------------------------------------------------
       Where the calls go RIGHT NOW, as read from the provider — not what
       the planning says they should (issue #750). The planning below is
       the rule; this is the fact.
       ------------------------------------------------------------------ #}
    <section class="border rounded-3 p-3 mb-4 d-flex align-items-start gap-2" id="sos-status-banner"
             aria-labelledby="sos-status-title">
        {% if live_state.error %}
            {% set dot_class = 'text-danger' %}
        {% elseif live_state.active %}
            {% set dot_class = 'text-success' %}
        {% else %}
            {% set dot_class = 'text-body-secondary' %}
        {% endif %}
        <i class="bi bi-circle-fill small mt-1 {{ dot_class }}" aria-hidden="true"></i>
        <div>
            {% if live_state.error %}
                <h2 class="h6 mb-1 text-danger" id="sos-status-title">État de la redirection illisible chez le fournisseur</h2>
                <p class="small mb-0">{{ live_state.error }}</p>
            {% elseif live_state.active %}
                <h2 class="h6 mb-1" id="sos-status-title">Redirection active chez le fournisseur</h2>
                <p class="small mb-0">
                    Les appels{% if sos_number %} au {{ sos_number }}{% endif %} sont actuellement redirigés vers
                    <strong>{% if live_state.label %}{{ live_state.label }} — {% endif %}{{ live_state.number }}</strong>.
                </p>
            {% else %}
                <h2 class="h6 mb-1" id="sos-status-title">Redirection inactive chez le fournisseur</h2>
                <p class="small mb-0">
                    Les appels{% if sos_number %} au {{ sos_number }}{% endif %} ne sont actuellement redirigés vers aucun
                    téléphone.
                </p>
            {% endif %}
        </div>
    </section>

    <h2 class="h5 mb-2">Planning des gardes</h2>
    <p class="small text-body-secondary mb-3" id="sos-planning-explanation">
        Les appels sont redirigés vers le numéro par défaut (dans les réglages plus bas), sauf les jours où quelqu'un
        est de garde dans le planning. L'enregistrement est automatique.
    </p>

    {# ------------------------------------------------------------------
       Month navigation — shared by both layouts.
       ------------------------------------------------------------------ #}
    <div class="d-flex align-items-center justify-content-between mb-2">
        <a href="/admin/sos?month={{ prev_month_param }}{% if mobile_tab == 'me' %}&amp;tab=me{% endif %}"
           class="btn btn-sm btn-outline-secondary" aria-label="Mois précédent">
            <i class="bi bi-chevron-left" aria-hidden="true"></i>
        </a>
        <h3 class="h6 mb-0">{{ month_label }}</h3>
        <a href="/admin/sos?month={{ next_month_param }}{% if mobile_tab == 'me' %}&amp;tab=me{% endif %}"
           class="btn btn-sm btn-outline-secondary" aria-label="Mois suivant">
            <i class="bi bi-chevron-right" aria-hidden="true"></i>
        </a>
    </div>

    {# ==================================================================
       PHONE LAYOUT (below md). Two tabs, a day list, and one edit sheet
       shared by every day — see public/assets/js/sos-admin.js.
       ================================================================== #}
    <div class="d-md-none mb-4" id="sos-mobile">
        {% include 'partials/nav_rail.html.twig' with {
            picker_id: 'sos-mobile-tabs',
            base_url: '/admin/sos',
            aria_label: 'Vues du planning SOS',
            items: [
                { id: '?month=' ~ month_param, label: 'Le mois', selected: mobile_tab != 'me' },
                { id: '?month=' ~ month_param ~ '&tab=me', label: 'Ma disponibilité', selected: mobile_tab == 'me' },
            ],
        } only %}

        {# The anchor only means something when today is in the range shown
           — the current month starts at today, any other month has no
           today at all. #}
        {% if mobile_days|filter(day => day.is_today)|length > 0 %}
            <p class="mb-2">
                <a href="#sos-day-{{ today }}" class="small">Aller à aujourd'hui</a>
            </p>
        {% endif %}

        {# Legend — one per tab, because the dots do not say the same
           thing: on « Le mois » a day's dot is who receives the calls,
           on « Ma disponibilité » it is the signed-in member's own state. #}
        <p class="small text-body-secondary d-flex flex-wrap gap-3 mb-2" id="sos-legend">
            {% if mobile_tab == 'me' %}
                <span><i class="bi bi-circle-fill text-success" aria-hidden="true"></i> de garde</span>
                <span><i class="bi bi-circle-fill text-danger" aria-hidden="true"></i> indisponible</span>
            {% else %}
                <span><i class="bi bi-circle-fill text-success" aria-hidden="true"></i> quelqu'un de garde</span>
                <span><i class="bi bi-circle-fill text-body-secondary" aria-hidden="true"></i> numéro par défaut</span>
                <span><i class="bi bi-circle-fill text-danger" aria-hidden="true"></i> aucun numéro</span>
            {% endif %}
        </p>

        {% if mobile_tab == 'me' %}
            {# ----------------------------------------------------------
               « Ma disponibilité » — the same month, the signed-in
               roster member only, editable in place. The most frequent
               gesture on a phone, so it costs no sheet.
               ---------------------------------------------------------- #}
            {% if my_member_id is null %}
                {% include 'partials/empty_state.html.twig' with {
                    message: "Vous n'êtes pas sur la liste du Staff d'U de cette année — vous pouvez planifier les gardes des autres depuis l'onglet « Le mois ».",
                    icon: 'bi-person-slash',
                } only %}
            {% else %}
                <div class="list-group" id="sos-my-availability">
                    {% for day in mobile_days %}
                        {% set my_state = states[day.date][my_member_id] ?? null %}
                        <div class="list-group-item{{ day.is_today ? ' list-group-item-warning' : '' }}" id="sos-day-{{ day.date }}">
                            <div class="d-flex justify-content-between align-items-baseline gap-2">
                                <span class="fw-semibold">{{ day.day_name }} {{ day.day_number }}</span>
                                {% if day.activity|length > 0 %}
                                    <span class="small text-warning-emphasis text-truncate">{{ day.activity|join(' · ') }}</span>
                                {% endif %}
                            </div>
                            {% include '@sos_staff/partials/state_buttons.html.twig' with {
                                member_id: my_member_id,
                                date: day.date,
                                state: my_state,
                                group_label: 'Ma disponibilité du ' ~ day.date_label,
                            } only %}
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        {% else %}
            {# ----------------------------------------------------------
               « Le mois » — one row per day, read-only. Each row names
               the person who ACTUALLY receives the calls that day
               (OnCallService::resolveTargetsForMonth(), the §2.6
               roster-order rule) and opens the day's edit sheet.
               ---------------------------------------------------------- #}
            {# `data-default-target` is the sentence a row falls back to
               when nobody is on call — server-rendered, because the
               script may never carry a member's name (the JSON island is
               ids, dates and states only). #}
            {# Issue #750: a plain two-column table — the date, and who
               receives the calls that day. Section events are not
               columns here; they head the day's sheet instead. #}
            {% set default_target = default_number_label ? 'Par défaut — ' ~ default_number_label : 'Aucun' %}
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0" id="sos-day-list"
                       data-default-target="{{ default_target }}"
                       data-default-has-member="{{ default_number_label ? '1' : '0' }}">
                    <thead>
                        <tr>
                            <th scope="col">Date</th>
                            <th scope="col">Personne de garde</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for day in mobile_days %}
                            {% if day.target_label %}
                                {% set dot = 'text-success' %}
                            {% elseif default_number_label %}
                                {% set dot = 'text-body-secondary' %}
                            {% else %}
                                {% set dot = 'text-danger' %}
                            {% endif %}
                            <tr class="sos-day-row{{ day.is_today ? ' table-warning' : '' }}"
                                id="sos-day-{{ day.date }}"
                                data-date="{{ day.date }}"
                                data-date-label="{{ day.date_label }}"
                                data-activity="{{ day.activity|json_encode }}">
                                <th scope="row" class="text-nowrap fw-semibold">
                                    {% if day.is_today %}<span class="d-block small">Aujourd'hui</span>{% endif %}
                                    {{ day.day_name }} {{ day.day_number }}
                                </th>
                                <td>
                                    <button type="button" class="btn btn-link p-0 text-start text-reset text-decoration-none w-100 d-flex align-items-center gap-2"
                                            aria-label="Modifier les gardes du {{ day.date_label }}">
                                        <i class="bi bi-circle-fill small {{ dot }}" data-day-dot aria-hidden="true"></i>
                                        <span class="flex-grow-1{{ day.target_label ? '' : ' text-body-secondary' }}" data-day-target>{{ day.target_label ?: default_target }}</span>
                                        <i class="bi bi-people{{ day.oncall_count > 1 ? '' : ' d-none' }}"
                                           data-day-multiple
                                           title="Plusieurs personnes sont de garde ce jour — seule la première de la liste reçoit les appels."
                                           aria-hidden="true"></i>
                                        <i class="bi bi-chevron-right text-body-secondary" aria-hidden="true"></i>
                                    </button>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>

    {# The day's edit sheet — ONE for the whole month, filled by
       sos-admin.js from the row that was tapped. Rendering one per day
       is what made the old phone layout ~250 stacked buttons. #}
    <div class="offcanvas offcanvas-bottom d-md-none" tabindex="-1" id="sos-day-sheet" aria-labelledby="sos-day-sheet-title" data-date="">
        <div class="offcanvas-header">
            <h2 class="offcanvas-title h6 mb-0" id="sos-day-sheet-title">Journée</h2>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Fermer"></button>
        </div>
        <div class="offcanvas-body">
            {# The sections' events that day — the context a chief needs
               while choosing who is on call (issue #750). Filled by
               sos-admin.js from the tapped row; hidden when there are none. #}
            <div class="mb-3 d-none" id="sos-day-sheet-activity">
                <h3 class="h6 mb-1">Événements ce jour-là</h3>
                <ul class="small mb-0" id="sos-day-sheet-activity-list"></ul>
            </div>
            {% if staff_options is empty %}
                {% include 'partials/empty_state.html.twig' with {
                    message: "Aucun membre du Staff d'U n'a de numéro de mobile enregistré.",
                    compact: true,
                } only %}
            {% else %}
                {% for option in staff_options %}
                    <div class="mb-3" data-sheet-member-id="{{ option.member_id }}">
                        <div class="fw-semibold small mb-1" data-member-name>{{ option.label }}</div>
                        {% include '@sos_staff/partials/state_buttons.html.twig' with {
                            member_id: option.member_id,
                            date: '',
                            state: null,
                            group_label: 'État de ' ~ option.label,
                        } only %}
                    </div>
                {% endfor %}
            {% endif %}
            <div id="sos-day-sheet-status" class="small text-body-secondary" aria-live="polite"></div>
        </div>
    </div>

    {# ==================================================================
       DESKTOP GRID — unchanged.
       ================================================================== #}
    <div class="sos-grid-wrapper mb-4 d-none d-md-block">
        <table class="sos-grid">
            <thead>
                <tr>
                    <th class="sos-day-label-header"></th>
                    {% for column in section_activity %}
                        <th class="sos-col-header{{ loop.first ? ' sos-section-divider' : '' }}"><span class="sos-col-header-label">{{ column.label }}</span></th>
                    {% endfor %}
                    {% for option in staff_options %}
                        <th class="sos-col-header{{ loop.first ? ' sos-section-divider' : '' }}"><span class="sos-col-header-label">{{ option.label }}</span></th>
                    {% endfor %}
                </tr>
            </thead>
            <tbody>
                {% for day in days %}
                    <tr class="{{ day.is_weekend ? 'is-weekend' : '' }} {{ day.is_today ? 'is-today' : '' }}">
                        <td class="sos-day-label">{{ day.day_name }} {{ day.day_number }}</td>
                        {% for column in section_activity %}
                            {% set titles = column.events_by_day[day.date] ?? [] %}
                            <td class="sos-activity-cell{{ loop.first ? ' sos-section-divider' : '' }}{{ titles|length > 0 ? ' has-event' : '' }}"{% if titles|length > 0 %} title="{{ titles|join(', ') }}"{% endif %}></td>
                        {% endfor %}
                        {% for option in staff_options %}
                            {% set state = states[day.date][option.member_id] ?? null %}
                            <td class="sos-oncall-cell{{ loop.first ? ' sos-section-divider' : '' }}{{ state == 'oncall' ? ' state-oncall' : '' }}{{ state == 'unavailable' ? ' state-unavailable' : '' }}"
                                data-member-id="{{ option.member_id }}" data-date="{{ day.date }}">
                                {{ state == 'oncall' ? '✓' : (state == 'unavailable' ? '✗' : '') }}
                            </td>
                        {% endfor %}
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    <div id="oncall-save-status" class="small text-body-secondary mb-4" aria-live="polite"></div>

    <h2 class="h5 mb-3">Redirections planifiées</h2>
    <div id="planned-transitions-list">
        {% include '@sos_staff/partials/planned_transitions.html.twig' %}
    </div>

    {# ==================================================================
       SETTINGS — at the bottom, in plain sight (issue #750: no accordion,
       a click to reach three controls was one too many). Each control
       still saves exactly as it did (design.md §7.13).
       ================================================================== #}
    <section class="mt-4 mb-4" id="sos-settings" aria-labelledby="sos-settings-title">
        <h2 class="h5 mb-3" id="sos-settings-title">Réglages</h2>
                <div>
                    <p class="text-body-secondary small">L'enregistrement est automatique — il n'y a pas de bouton « Enregistrer », sauf pour le numéro par défaut.</p>
                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            {% if staff_options is empty %}
                                {# A <label> pointing at a control that is not rendered
                                   is a label for nothing — this branch has no select,
                                   so it carries a heading instead. #}
                                <p class="form-label small mb-1">Numéro par défaut</p>
                                <p class="text-danger small mb-0">
                                    <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
                                    Aucun membre du Staff d'U n'a de numéro de mobile enregistré — impossible de définir un numéro par défaut.
                                    Complétez un numéro de mobile pour au moins un membre du Staff d'U.
                                </p>
                            {% else %}
                                {#
                                  An explicit button, unlike the two controls beside
                                  it. This select decides which phone the unit's SOS
                                  number rings on every day nobody is on duty, and it
                                  used to save on `change` — so a mis-click, or an
                                  arrow key on a focused select, re-routed the unit's
                                  emergency line with nothing to confirm and nothing
                                  to cancel. The button is disabled until the value
                                  actually differs from what is stored, which is also
                                  what makes an accidental change visible.
                                #}
                                <div class="d-flex gap-2 align-items-end">
                                    {# `data-saved-value` is what sos-admin.js compares
                                       against to decide whether « Enregistrer » may be
                                       pressed at all. #}
                                    {% include 'partials/form_field.html.twig' with {
                                        field_id: 'default-number-member', label: 'Numéro par défaut',
                                        type: 'select', size: 'sm', wrapper_class: 'flex-grow-1',
                                        data: { 'saved-value': default_number_selection_member_id },
                                        options: staff_options|default([])|map(option => {
                                            value: option.member_id,
                                            label: option.label ~ ' (' ~ option.mobile ~ ')',
                                            selected: default_number_selection_member_id == option.member_id,
                                        }),
                                    } only %}
                                    <button type="button" class="btn btn-sm btn-primary text-nowrap" id="default-number-save" disabled>
                                        Enregistrer
                                    </button>
                                </div>
                                <p class="text-body-secondary small mt-1 mb-0">
                                    Numéro utilisé les jours sans garde explicite. Il doit toujours s'agir d'un membre du Staff d'U —
                                    par défaut, le/la responsable de la section Staff d'U ; choisissez un autre membre ci-dessus pour l'imposer explicitement.
                                </p>
                                {# Shown ONLY when saving would really change who the
                                   line rings today, i.e. when today has no explicit
                                   on-call and the default number governs it. A
                                   permanent warning that is wrong half the time ends
                                   up ignored. #}
                                {% if today_uses_default_number %}
                                    <p class="text-warning-emphasis small mt-1 mb-0" id="default-number-immediate-warning">
                                        <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
                                        Aujourd'hui n'a pas de garde attribuée : enregistrer ce numéro redirigera les appels immédiatement
                                        et préviendra les personnes concernées par e-mail.
                                    </p>
                                {% endif %}
                                <div class="text-danger small mt-1 d-none" id="default-number-error" role="alert"></div>
                            {% endif %}
                        </div>
                        <div class="col-6 col-md-3">
                            {% include 'partials/form_field.html.twig' with {
                                field_id: 'transition-hour', label: 'Heure de changement de garde',
                                type: 'time', value: transition_hour, size: 'sm', wrapper_class: '',
                            } only %}
                        </div>
                        <div class="col-12 col-md-3">
                            {# The switch and its label inside ONE .form-check:
                               a label outside it left the switch drawn over the
                               start of the sentence below (issue #750). #}
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" role="switch" id="email-notifications-toggle"
                                       aria-checked="{{ email_notifications_enabled ? 'true' : 'false' }}"
                                       aria-describedby="email-notifications-help"
                                       {{ email_notifications_enabled ? 'checked' : '' }}>
                                <label class="form-check-label small" for="email-notifications-toggle">Notifications de garde</label>
                            </div>
                            <p class="text-body-secondary small mt-1 mb-0" id="email-notifications-help">
                                Prévient la personne vers qui le numéro SOS est redirigé quand sa garde commence, et celle
                                dont la garde se termine. Chacun choisit ses canaux dans ses préférences de notifications.
                            </p>
                        </div>
                    </div>
                </div>
    </section>
    {% endif %}
{% endblock %}

{% block scripts %}
{% if provider_configured %}
{# Server data as a JSON ISLAND, read by sos-admin.js through
   ScoutMagicApi.pageData(). The payload is dates, member ids and duty
   states only — never a phone number, and never a member's name either
   (AGENTS.md § Security checklist). The names the phone layout shows are
   rendered server-side above; the script reads them back out of the DOM
   when it has to relabel a day. #}
{% set json_flags = constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_UNESCAPED_UNICODE') %}
<script type="application/json" id="sos-admin-data">
{{ {
    year: year,
    month: month,
    monthParam: month_param,
    states: states,
    orderedMemberIds: ordered_staff_member_ids
}|json_encode(json_flags)|raw }}
</script>
<script src="{{ asset('/assets/js/sos-admin.js') }}" defer></script>
{% endif %}
{% endblock %}
