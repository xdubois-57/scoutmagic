{% extends "base.html.twig" %}

{% block title %}Planning des gardes — {{ site_name }}{% endblock %}

{% block stylesheets %}
{# Desktop duty grid only. The phone layout below is plain Bootstrap
   utilities, plus ONE rule of its own — the day sheet's full-screen height,
   `.sos-day-sheet` in public/assets/css/app.css (issue #1024), where a rule
   belongs (AGENTS.md § CSS). #}
<style nonce="{{ csp_nonce }}">
.sos-grid-wrapper { overflow-x: auto; }
.sos-grid { border-collapse: collapse; width: 100%; table-layout: fixed; }
.sos-grid th, .sos-grid td { border: 1px solid var(--bs-border-color, #dee2e6); padding: 0.25rem; text-align: center; }
.sos-grid th.sos-col-header { padding: 0.3rem 0.1rem 0; height: 7rem; width: 1.6rem; max-width: 1.6rem; vertical-align: bottom; font-weight: 600; }
.sos-grid th.sos-col-header .sos-col-header-label {
    writing-mode: vertical-rl;
    -webkit-writing-mode: vertical-rl;
    transform: rotate(180deg);
    display: inline-block;
    white-space: nowrap;
}
.sos-grid td.sos-day-label, .sos-grid th.sos-day-label-header { text-align: left; white-space: nowrap; font-weight: 600; width: 4.5rem; }
.sos-grid tbody tr.is-weekend td:not(.has-event):not(.state-oncall):not(.state-unavailable) { background-color: var(--bs-tertiary-bg, #f8f9fa); }
.sos-grid tbody tr.is-today td:not(.has-event):not(.state-oncall):not(.state-unavailable) { background-color: var(--bs-warning-bg-subtle, #fff3cd); }
.sos-section-divider { border-left: 3px solid var(--bs-secondary-color, #6c757d) !important; }
.sos-activity-cell { width: 1.6rem; max-width: 1.6rem; }
.sos-activity-cell.has-event { background-color: #fd7e14; }
.sos-oncall-cell { cursor: pointer; width: 1.6rem; max-width: 1.6rem; font-weight: 700; user-select: none; }
.sos-oncall-cell.state-oncall { background-color: #66bb6a; color: #fff; }
.sos-oncall-cell.state-unavailable { background-color: #ef5350; color: #fff; }
</style>
{% endblock %}

{% block content %}
    {% include 'partials/page_header.html.twig' with { title: "Planning des gardes" } only %}

    {% include '@sos_staff/partials/nav.html.twig' %}

    <p class="small text-body-secondary mb-3" id="sos-planning-explanation">
        Les appels sont redirigés vers le numéro par défaut (dans <a href="/admin/sos/reglages">Réglages</a>), sauf les jours où quelqu'un
        est de garde dans le planning. L'enregistrement est automatique.
    </p>

    {# ------------------------------------------------------------------
       Month navigation — shared by both layouts.
       ------------------------------------------------------------------ #}
    <div class="d-flex align-items-center justify-content-between mb-2">
        <a href="/admin/sos/planning?month={{ prev_month_param }}"
           class="btn btn-sm btn-outline-secondary" aria-label="Mois précédent">
            <i class="bi bi-chevron-left" aria-hidden="true"></i>
        </a>
        <h2 class="h6 mb-0">{{ month_label }}</h2>
        <a href="/admin/sos/planning?month={{ next_month_param }}"
           class="btn btn-sm btn-outline-secondary" aria-label="Mois suivant">
            <i class="bi bi-chevron-right" aria-hidden="true"></i>
        </a>
    </div>

    {# ==================================================================
       PHONE LAYOUT (below md). A day list and one edit sheet shared by
       every day — see public/assets/js/sos-admin.js.
       ================================================================== #}
    <div class="d-md-none mb-4" id="sos-mobile">
        {# The anchor only means something when today is in the range shown
           — the current month starts at today, any other month has no
           today at all. #}
        {% if mobile_days|filter(day => day.is_today)|length > 0 %}
            <p class="mb-2">
                <a href="#sos-day-{{ today }}" class="small">Aller à aujourd'hui</a>
            </p>
        {% endif %}

        <p class="small text-body-secondary d-flex flex-wrap gap-3 mb-2" id="sos-legend">
            <span><i class="bi bi-circle-fill text-success" aria-hidden="true"></i> quelqu'un de garde</span>
            <span><i class="bi bi-circle-fill text-body-secondary" aria-hidden="true"></i> numéro par défaut</span>
            <span><i class="bi bi-circle-fill text-danger" aria-hidden="true"></i> aucun numéro</span>
        </p>

        {# One row per day, read-only. Each row names the person who
           ACTUALLY receives the calls that day
           (OnCallService::resolveTargetsForMonth(), the §2.6 roster-order
           rule) and opens the day's edit sheet. #}
        {# `data-default-target` is the sentence a row falls back to
           when nobody is on call — server-rendered, because the
           script may never carry a member's name (the JSON island is
           ids, dates and states only). #}
        {# Issue #750: a plain two-column table — the date, and who
           receives the calls that day. Section events are not
           columns here; they head the day's sheet instead. #}
        {% set default_target = default_number_label ? 'Par défaut — ' ~ default_number_label : 'Aucun' %}
        <div class="table-responsive">
            <table class="table table-sm align-middle mb-0" id="sos-day-list"
                   data-default-target="{{ default_target }}"
                   data-default-has-member="{{ default_number_label ? '1' : '0' }}">
                <thead>
                    <tr>
                        <th scope="col">Date</th>
                        <th scope="col">Personne de garde</th>
                    </tr>
                </thead>
                <tbody>
                    {% for day in mobile_days %}
                        {% if day.target_label %}
                            {% set dot = 'text-success' %}
                        {% elseif default_number_label %}
                            {% set dot = 'text-body-secondary' %}
                        {% else %}
                            {% set dot = 'text-danger' %}
                        {% endif %}
                        <tr class="sos-day-row{{ day.is_today ? ' table-warning' : '' }}"
                            id="sos-day-{{ day.date }}"
                            data-date="{{ day.date }}"
                            data-date-label="{{ day.date_label }}"
                            data-activity="{{ day.activity|json_encode }}">
                            <th scope="row" class="text-nowrap fw-semibold">
                                {% if day.is_today %}<span class="d-block small">Aujourd'hui</span>{% endif %}
                                {{ day.day_name }} {{ day.day_number }}
                            </th>
                            <td>
                                {# No aria-label: it would replace the visible recipient,
                                   which sos-admin.js keeps up to date. The row header
                                   already gives the date. #}
                                <button type="button" class="btn btn-link p-0 text-start text-reset text-decoration-none w-100 d-flex align-items-center gap-2">
                                    <i class="bi bi-circle-fill small {{ dot }}" data-day-dot aria-hidden="true"></i>
                                    <span class="flex-grow-1{{ day.target_label ? '' : ' text-body-secondary' }}" data-day-target>{{ day.target_label ?: default_target }}</span>
                                    <i class="bi bi-people{{ day.oncall_count > 1 ? '' : ' d-none' }}"
                                       data-day-multiple
                                       title="Plusieurs personnes sont de garde ce jour — seule la première de la liste reçoit les appels."
                                       aria-hidden="true"></i>
                                    <i class="bi bi-chevron-right text-body-secondary" aria-hidden="true"></i>
                                    <span class="visually-hidden">— modifier les gardes</span>
                                </button>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    {# The day's edit sheet — ONE for the whole month, filled by
       sos-admin.js from the row that was tapped. Rendering one per day
       is what made the old phone layout ~250 stacked buttons.

       FULL SCREEN on a phone (issue #1024): Bootstrap's bottom offcanvas
       is 30vh tall, which left the roster squeezed under a greyed-out
       planning with the second member cut off. `.sos-day-sheet` gives it
       the whole usable height. The header — the day, and a labelled
       « Fermer » — sits outside the scrolling body, so both stay in view
       however long the roster is. #}
    <div class="offcanvas offcanvas-bottom sos-day-sheet d-md-none" tabindex="-1" id="sos-day-sheet" aria-labelledby="sos-day-sheet-title" data-date="">
        <div class="offcanvas-header border-bottom">
            <h2 class="offcanvas-title h5 mb-0" id="sos-day-sheet-title">Journée</h2>
            <button type="button" class="btn btn-outline-secondary btn-sm tap-target text-nowrap" data-bs-dismiss="offcanvas">
                <i class="bi bi-x-lg" aria-hidden="true"></i> Fermer
            </button>
        </div>
        <div class="offcanvas-body">
            {# The sections' events that day — the context a chief needs
               while choosing who is on call (issue #750). Filled by
               sos-admin.js from the tapped row; hidden when there are none. #}
            <div class="mb-3 d-none" id="sos-day-sheet-activity">
                <h3 class="h6 mb-1">Événements ce jour-là</h3>
                <ul class="small mb-0" id="sos-day-sheet-activity-list"></ul>
            </div>
            {% if staff_options is empty %}
                {% include 'partials/empty_state.html.twig' with {
                    message: "Aucun membre du Staff d'U n'a de numéro de mobile enregistré.",
                    compact: true,
                } only %}
            {% else %}
                {% for option in staff_options %}
                    <div class="mb-3 pb-3{{ loop.last ? '' : ' border-bottom' }}" data-sheet-member-id="{{ option.member_id }}">
                        <div class="fw-semibold mb-1" data-member-name>{{ option.label }}</div>
                        {% include '@sos_staff/partials/state_buttons.html.twig' with {
                            member_id: option.member_id,
                            date: '',
                            state: null,
                            group_label: 'État de ' ~ option.label,
                        } only %}
                    </div>
                {% endfor %}
            {% endif %}
            <div id="sos-day-sheet-status" class="small text-body-secondary" aria-live="polite"></div>
        </div>
    </div>

    {# ==================================================================
       DESKTOP GRID — unchanged.
       ================================================================== #}
    <div class="sos-grid-wrapper mb-4 d-none d-md-block">
        <table class="sos-grid">
            <thead>
                <tr>
                    <th class="sos-day-label-header"></th>
                    {% for column in section_activity %}
                        <th class="sos-col-header{{ loop.first ? ' sos-section-divider' : '' }}"><span class="sos-col-header-label">{{ column.label }}</span></th>
                    {% endfor %}
                    {% for option in staff_options %}
                        <th class="sos-col-header{{ loop.first ? ' sos-section-divider' : '' }}"><span class="sos-col-header-label">{{ option.label }}</span></th>
                    {% endfor %}
                </tr>
            </thead>
            <tbody>
                {% for day in days %}
                    <tr class="{{ day.is_weekend ? 'is-weekend' : '' }} {{ day.is_today ? 'is-today' : '' }}">
                        <td class="sos-day-label">{{ day.day_name }} {{ day.day_number }}</td>
                        {% for column in section_activity %}
                            {% set titles = column.events_by_day[day.date] ?? [] %}
                            <td class="sos-activity-cell{{ loop.first ? ' sos-section-divider' : '' }}{{ titles|length > 0 ? ' has-event' : '' }}"{% if titles|length > 0 %} title="{{ titles|join(', ') }}"{% endif %}></td>
                        {% endfor %}
                        {% for option in staff_options %}
                            {% set state = states[day.date][option.member_id] ?? null %}
                            <td class="sos-oncall-cell{{ loop.first ? ' sos-section-divider' : '' }}{{ state == 'oncall' ? ' state-oncall' : '' }}{{ state == 'unavailable' ? ' state-unavailable' : '' }}"
                                data-member-id="{{ option.member_id }}" data-date="{{ day.date }}">
                                {{ state == 'oncall' ? '✓' : (state == 'unavailable' ? '✗' : '') }}
                            </td>
                        {% endfor %}
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    <div id="oncall-save-status" class="small text-body-secondary mb-4" aria-live="polite"></div>
{% endblock %}

{% block scripts %}
{# Server data as a JSON ISLAND, read by sos-admin.js through
   ScoutMagicApi.pageData(). The payload is dates, member ids and duty
   states only — never a phone number, and never a member's name either
   (AGENTS.md § Security checklist). The names the phone layout shows are
   rendered server-side above; the script reads them back out of the DOM
   when it has to relabel a day. #}
{% set json_flags = constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_UNESCAPED_UNICODE') %}
<script type="application/json" id="sos-admin-data">
{{ {
    year: year,
    month: month,
    monthParam: month_param,
    states: states,
    orderedMemberIds: ordered_staff_member_ids
}|json_encode(json_flags)|raw }}
</script>
<script src="{{ asset('/assets/js/sos-admin.js') }}" defer></script>
{% endblock %}
