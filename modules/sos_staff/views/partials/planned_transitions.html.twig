{#
  Shared between admin.html.twig's initial page render (via {% include %})
  and SosAdminController::plannedTransitions()'s AJAX pagination response —
  markup can never drift between the two.
#}
{% if planned_transitions is empty %}
    <div class="mb-4">
        {% include 'partials/empty_state.html.twig' with { message: 'Aucune redirection planifiée ce mois-ci.', compact: true } only %}
    </div>
{% else %}
    <ul class="list-group mb-2">
        {% for transition in planned_transitions %}
            <li class="list-group-item d-flex flex-wrap justify-content-between align-items-center gap-1{{ transition.is_next ? ' sos-next-transition' : '' }}">
                <div>
                    <span class="fw-semibold">{{ transition.run_at }}</span> — {{ transition.label }}
                    {% if transition.is_next %}<span class="badge text-bg-warning ms-2">Prochain changement</span>{% endif %}
                </div>
                {% include 'partials/status_badge.html.twig' with {
                    status: transition.status == 'actif' ? 'active' : (transition.status == 'à venir' ? 'scheduled' : 'archived'),
                    label: transition.status,
                } only %}
            </li>
        {% endfor %}
    </ul>
    <div class="mb-4">
        {% include 'partials/pagination.html.twig' with {
            page: planned_transitions_page,
            total_pages: planned_transitions_total_pages,
            data_attr: 'data-transitions-page',
            label: 'Pagination des redirections planifiées',
        } only %}
    </div>
{% endif %}
