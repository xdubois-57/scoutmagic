{% extends 'base.html.twig' %}
{% block title %}{{ carpool.title }} — {{ param('site_name') }}{% endblock %}
{#
  One carpool: its place, its dates, and its cars — the outbound and the
  return as two views of one page when there is a return. The place is the
  carpool's and every car shows it at the end it is fixed at.
#}
{% block content %}
<div class="page-medium">
    {% include 'partials/page_header.html.twig' with {
        title: carpool.title,
        subtitle: carpool.dates,
    } only %}

    {# The reader's trip of the day (#835): only when it is today and they
       take part in it. Built by Service\CarpoolBoard::dayBanner(), so a
       phone they may not see is null here and never printed. It carries no
       route link of its own (#1345): the « Itinéraire » button under the
       address is the one way to open a map, so no path goes round the
       choice of application. #}
    {% set _banner = carpool.day_banner %}
    {% if _banner %}
        <section class="alert alert-{{ _banner.tone }} mb-3" aria-label="Votre trajet d'aujourd'hui" data-carpool-day-banner>
            <div class="fw-semibold mb-1">
                <i class="bi bi-car-front" aria-hidden="true"></i>
                Aujourd'hui · {{ _banner.direction }} à {{ _banner.time }}
            </div>
            {% if _banner.role == 'driver' %}
                <div>Vous conduisez.</div>
            {% elseif _banner.role == 'confirmed' %}
                <div><strong>Votre place est confirmée</strong> pour {{ _banner.who|join(' et ') }}.</div>
            {% else %}
                <div><strong>Votre demande est toujours à confirmer</strong> pour {{ _banner.who|join(' et ') }} : ne comptez pas encore sur cette voiture.</div>
            {% endif %}
            <div>Rendez-vous : {{ _banner.meeting }}</div>
            <div>Destination : {{ _banner.destination }}</div>
            {% if _banner.role != 'driver' %}
                <div>Conducteur : {{ _banner.driver }}{% if _banner.driver_phone %} · <strong>{{ phone(_banner.driver_phone) }}</strong>{% endif %}</div>
            {% endif %}
            {% if _banner.role == 'driver' %}
                <div class="mt-2 fw-semibold">Vos passagers</div>
                {% if _banner.passengers is empty %}
                    <div class="small">Aucun passager pour le moment.</div>
                {% endif %}
                {% for passenger in _banner.passengers %}
                    <div class="small">
                        {{ passenger.who|join(', ') }} · {{ passenger.by }}
                        {% if passenger.phone %} · <strong>{{ phone(passenger.phone) }}</strong>{% endif %}
                        {% include 'partials/status_badge.html.twig' with {
                            status: passenger.confirmed ? 'confirmed' : 'pending',
                            label: passenger.confirmed ? 'Place confirmée' : 'À confirmer',
                        } only %}
                    </div>
                {% endfor %}
            {% endif %}
        </section>
    {% endif %}

    {# What the address IS depends on the direction (#703): every car of
       the outbound goes there, every car of the return leaves from there.
       The address stays readable text. The one « Itinéraire » button opens
       the sheet below, where the reader picks Plans, Google Maps or Waze
       (#1345); it is shown every time and remembers nothing. Without
       JavaScript the button is a plain link to Google Maps in the browser.
       The destination is the saved point, the address when there is none. #}
    <p class="mb-1">
        <span class="text-body-secondary">{{ direction == 'return' ? 'Départ' : 'Destination' }} :</span>
        {{ carpool.address }}
    </p>
    <p class="mb-1">
        <a href="{{ directions_url }}" class="btn btn-sm btn-outline-primary" role="button"
           data-bs-toggle="offcanvas" data-bs-target="#directions-sheet" aria-controls="directions-sheet"
           target="_blank" rel="noopener noreferrer">
            <i class="bi bi-sign-turn-right" aria-hidden="true"></i> Itinéraire
        </a>
    </p>
    <p class="small text-body-secondary mb-2">
        {% if carpool.point_line %}
            Point précis : {{ carpool.point_line }}
        {% else %}
            Aucun point enregistré : l'itinéraire ira à l'adresse.
        {% endif %}
    </p>
    {% if carpool.events|length > 1 %}
        <div class="d-flex flex-wrap gap-1 mb-3">
            {% for event in carpool.events %}
                <span class="badge text-bg-light border">{{ event }}</span>
            {% endfor %}
        </div>
    {% endif %}

    {% if carpool.return_day %}
        {% include 'partials/page_picker.html.twig' with {
            picker_id: 'carpool-direction',
            pages: [
                { url: '/covoiturage/' ~ carpool.id, label: 'Aller · ' ~ carpool.outbound_day },
                { url: '/covoiturage/' ~ carpool.id ~ '?sens=return', label: 'Retour · ' ~ carpool.return_day },
            ],
            current_path: direction == 'return' ? '/covoiturage/' ~ carpool.id ~ '?sens=return' : '/covoiturage/' ~ carpool.id,
            aria_label: 'Sens du trajet',
        } only %}
    {% endif %}

    {% if carpool.is_past %}
        <p class="small text-body-secondary">Ce covoiturage est passé : il n'accepte plus de voiture ni de demande.</p>
    {% else %}
        <a href="/covoiturage/{{ carpool.id }}/proposer{{ direction == 'return' ? '?sens=return' : '' }}"
           class="btn btn-primary w-100-below-sm mb-3">
            <i class="bi bi-plus-lg" aria-hidden="true"></i>
            Proposer des places{{ carpool.return_day ? (direction == 'return' ? ' pour le retour' : ' pour l\'aller') : '' }}
        </a>
    {% endif %}

    {% if carpool.creator_section %}
        {# Said on the page because this section grants access to the
           passengers and nothing else here would reveal it (issue #650):
           it comes from the carpool's creator, not from its events. #}
        <p class="small text-body-secondary mb-2">Géré aussi par : {{ carpool.creator_section }}</p>
    {% endif %}

    {% if carpool.staff_hides_passengers %}
        <p class="small text-body-secondary bg-body-tertiary rounded px-3 py-2">
            Vous ne voyez pas les passagers : ce covoiturage ne concerne pas votre section.
        </p>
    {% endif %}

    {% set _offers = carpool.directions[direction] %}
    {% if _offers is empty %}
        {% include 'partials/empty_state.html.twig' with {
            message: direction == 'return' ? 'Aucune voiture au retour pour le moment.' : 'Aucune voiture pour le moment.',
            icon: 'bi-car-front',
        } only %}
    {% endif %}
    {% for offer in _offers %}
        {% include '@covoiturage/_offer_card.html.twig' with { offer: offer, carpool: carpool, prefill: prefill } only %}
    {% endfor %}
</div>

{# The choice of map application (#1345): the look and the behaviour of the
   sheet a tapped phone number opens (partials/phone_sheet.html.twig) — an
   offcanvas-bottom with a list of actions — through the same .action-sheet
   styles. The three links are rendered here, by Core\Geo\MapsLink, which is
   the only place their format is written, so the choice works without a
   line of script of its own; directions-sheet.js only closes the sheet once
   one was taken. Nothing is stored. #}
<div class="offcanvas offcanvas-bottom action-sheet" tabindex="-1" id="directions-sheet"
     aria-labelledby="directions-sheet-title" data-directions-sheet>
    <div class="offcanvas-header border-bottom">
        <div>
            <h5 class="offcanvas-title mb-0" id="directions-sheet-title">Itinéraire</h5>
            <div class="small text-body-secondary">{{ direction == 'return' ? 'Départ' : 'Destination' }} : {{ carpool.address }}</div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Fermer"></button>
    </div>
    <div class="offcanvas-body p-0">
        <div class="list-group list-group-flush">
            {% for choice in directions_choices %}
                <a href="{{ choice.url }}" class="list-group-item list-group-item-action action-sheet-item"
                   target="_blank" rel="noopener noreferrer" data-directions-choice="{{ choice.key }}"
                   aria-label="Itinéraire avec {{ choice.label }}">
                    <i class="bi {{ choice.key == 'apple' ? 'bi-apple' : (choice.key == 'google' ? 'bi-google' : 'bi-signpost-2') }}" aria-hidden="true"></i><span>{{ choice.label }}</span>
                </a>
            {% endfor %}
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script src="{{ asset('/assets/js/directions-sheet.js') }}" defer></script>
{% endblock %}
