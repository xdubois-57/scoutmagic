{% extends 'base.html.twig' %}
{% block title %}{{ carpool.title }} — {{ param('site_name') }}{% endblock %}
{#
  One carpool: its place, its dates, and its cars — the outbound and the
  return as two views of one page when there is a return. The place is the
  carpool's and every car shows it at the end it is fixed at.
#}
{% block content %}
<div class="page-medium">
    {% include 'partials/page_header.html.twig' with {
        title: carpool.title,
        subtitle: carpool.dates,
    } only %}

    {# The reader's trip of the day (#835): only when it is today and they
       take part in it. Built by Service\CarpoolBoard::dayBanner(), so a
       phone they may not see is null here and never printed. The route link
       is the one below: no second way to open a map. #}
    {% set _banner = carpool.day_banner %}
    {% if _banner %}
        <div class="alert alert-{{ _banner.tone }} mb-3" role="region" aria-label="Votre trajet d'aujourd'hui" data-carpool-day-banner>
            <div class="fw-semibold mb-1">
                <i class="bi bi-car-front" aria-hidden="true"></i>
                Aujourd'hui · {{ _banner.direction }} à {{ _banner.time }}
            </div>
            {% if _banner.role == 'driver' %}
                <div>Vous conduisez.</div>
            {% elseif _banner.role == 'confirmed' %}
                <div><strong>Votre place est confirmée</strong> pour {{ _banner.who|join(' et ') }}.</div>
            {% else %}
                <div><strong>Votre demande est toujours à confirmer</strong> pour {{ _banner.who|join(' et ') }} : ne comptez pas encore sur cette voiture.</div>
            {% endif %}
            <div>Rendez-vous : {{ _banner.meeting }}</div>
            <div>Destination : {{ _banner.destination }}</div>
            {% if _banner.role != 'driver' %}
                <div>Conducteur : {{ _banner.driver }}{% if _banner.driver_phone %} · <strong>{{ _banner.driver_phone }}</strong>{% endif %}</div>
            {% endif %}
            <div class="small mt-1">
                <a href="{{ directions_url }}" target="_blank" rel="noopener noreferrer">Itinéraire vers {{ _banner.place }}</a>
            </div>
            {% if _banner.role == 'driver' %}
                <div class="mt-2 fw-semibold">Vos passagers</div>
                {% if _banner.passengers is empty %}
                    <div class="small">Aucun passager pour le moment.</div>
                {% endif %}
                {% for passenger in _banner.passengers %}
                    <div class="small">
                        {{ passenger.who|join(', ') }} · {{ passenger.by }}
                        {% if passenger.phone %} · <strong>{{ passenger.phone }}</strong>{% endif %}
                        {% include 'partials/status_badge.html.twig' with {
                            status: passenger.confirmed ? 'confirmed' : 'pending',
                            label: passenger.confirmed ? 'Place confirmée' : 'À confirmer',
                        } only %}
                    </div>
                {% endfor %}
            {% endif %}
        </div>
    {% endif %}

    {# What the address IS depends on the direction (#703): every car of
       the outbound goes there, every car of the return leaves from there.
       It opens a route from where the reader is, in their own map
       application. #}
    <p class="mb-1">
        <span class="text-body-secondary">{{ direction == 'return' ? 'Départ' : 'Destination' }} :</span>
        <a href="{{ directions_url }}" target="_blank" rel="noopener noreferrer"
           title="Itinéraire depuis votre position">{{ carpool.address }}</a>
    </p>
    <p class="small mb-1">
        <a href="{{ carpool.maps_url }}" target="_blank" rel="noopener noreferrer">Ouvrir sur une carte</a>
    </p>
    <p class="small text-body-secondary mb-2">
        {% if carpool.point_line %}
            Point précis : {{ carpool.point_line }}
        {% else %}
            Aucun point enregistré : la carte ouvrira l'adresse.
        {% endif %}
    </p>
    {% if carpool.events|length > 1 %}
        <div class="d-flex flex-wrap gap-1 mb-3">
            {% for event in carpool.events %}
                <span class="badge text-bg-light border">{{ event }}</span>
            {% endfor %}
        </div>
    {% endif %}

    {% if carpool.return_day %}
        {% include 'partials/page_picker.html.twig' with {
            picker_id: 'carpool-direction',
            pages: [
                { url: '/covoiturage/' ~ carpool.id, label: 'Aller · ' ~ carpool.outbound_day },
                { url: '/covoiturage/' ~ carpool.id ~ '?sens=return', label: 'Retour · ' ~ carpool.return_day },
            ],
            current_path: direction == 'return' ? '/covoiturage/' ~ carpool.id ~ '?sens=return' : '/covoiturage/' ~ carpool.id,
            aria_label: 'Sens du trajet',
        } only %}
    {% endif %}

    {% if carpool.is_past %}
        <p class="small text-body-secondary">Ce covoiturage est passé : il n'accepte plus de voiture ni de demande.</p>
    {% else %}
        <a href="/covoiturage/{{ carpool.id }}/proposer{{ direction == 'return' ? '?sens=return' : '' }}"
           class="btn btn-primary w-100 w-sm-auto mb-3">
            <i class="bi bi-plus-lg" aria-hidden="true"></i>
            Proposer des places{{ carpool.return_day ? (direction == 'return' ? ' pour le retour' : ' pour l\'aller') : '' }}
        </a>
    {% endif %}

    {% if carpool.creator_section %}
        {# Said on the page because this section grants access to the
           passengers and nothing else here would reveal it (issue #650):
           it comes from the carpool's creator, not from its events. #}
        <p class="small text-body-secondary mb-2">Géré aussi par : {{ carpool.creator_section }}</p>
    {% endif %}

    {% if carpool.staff_hides_passengers %}
        <p class="small text-body-secondary bg-body-tertiary rounded px-3 py-2">
            Vous ne voyez pas les passagers : ce covoiturage ne concerne pas votre section.
        </p>
    {% endif %}

    {% set _offers = carpool.directions[direction] %}
    {% if _offers is empty %}
        {% include 'partials/empty_state.html.twig' with {
            message: direction == 'return' ? 'Aucune voiture au retour pour le moment.' : 'Aucune voiture pour le moment.',
            icon: 'bi-car-front',
        } only %}
    {% endif %}
    {% for offer in _offers %}
        {% include '@covoiturage/_offer_card.html.twig' with { offer: offer, carpool: carpool, prefill: prefill } only %}
    {% endfor %}
</div>
{% endblock %}
