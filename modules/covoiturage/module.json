  "settings": [
    {
      "key": "covoiturage_retention_days",
      "default_value": "30",
      "type": "number",
      "label": "Durée de conservation (jours)",
      "description": "Nombre de jours après la dernière date d'un covoiturage au bout desquels il est effacé, avec ses voitures, ses demandes et les numéros de téléphone partagés. Les covoiturages passés restent visibles jusque-là, repliés."
    },
    {
      "key": "covoiturage_geocoding_enabled",
      "default_value": "1",
      "type": "boolean",
      "label": "Retrouver le point depuis l'adresse",
      "description": "Cherche automatiquement, en tâche de fond, le point sur la carte correspondant à l'adresse d'un covoiturage (service Nominatim d'OpenStreetMap). Sans point, le lien de cartes ouvre simplement l'adresse ; un point placé à la main n'est jamais modifié."
    }
  ],
  "cookies": [],
  "scheduled_tasks": [
