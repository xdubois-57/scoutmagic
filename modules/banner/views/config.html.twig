{% extends "base.html.twig" %}

{% block title %}Bannière — {{ site_name }}{% endblock %}

{% block content %}
    {% include 'partials/page_header.html.twig' with { title: 'Bannière' } only %}
    <p class="text-body-secondary small mb-3">
        À chaque chargement de la page d'accueil, une bannière est choisie aléatoirement parmi celles
        actives et visibles par le visiteur ci-dessous. Si aucune ne correspond, rien ne s'affiche.
        La visibilité (Public / Identifiés / Chefs) détermine qui peut voir une bannière — un visiteur
        non connecté ne voit jamais une bannière réservée aux identifiés ou aux animateurs. L'ordre ci-dessous
        n'a aucun effet sur l'affichage — il sert uniquement à organiser cette liste.
    </p>

    {% embed 'partials/list_editor.html.twig' with {
        list_id: 'banner-list',
        items: banners,
        add_url: '/config/banner/add',
        reorder_url: '/config/banner/reorder',
        active_url: '/config/banner/active',
        delete_url: '/config/banner/delete',
        add_label: 'Ajouter une bannière',
        empty_label: 'Aucune bannière configurée.',
        add_mode: 'custom'
    } %}
        {% block item_content %}
            {% include 'partials/rich_text_field.html.twig' with {
                content_key: 'banner_content_' ~ item.id,
                content_value: item.content
            } %}
        {% endblock %}
        {% block item_edit %}
            {% include 'partials/rich_text_edit_button.html.twig' with {
                content_key: 'banner_content_' ~ item.id,
                save_url: '/api/rich-text-content'
            } %}
            <select class="form-select form-select-sm banner-role-min-select" style="width:auto;"
                    data-id="{{ item.id }}" title="Visibilité minimale" aria-label="Visibilité minimale">
                <option value="public" {{ item.role_min == 'public' ? 'selected' : '' }}>Public</option>
                <option value="identified" {{ item.role_min == 'identified' ? 'selected' : '' }}>Identifiés</option>
                <option value="chief" {{ item.role_min == 'chief' ? 'selected' : '' }}>Animateurs</option>
            </select>
        {% endblock %}
    {% endembed %}

    {% include 'partials/rich_text_editor.html.twig' %}
{% endblock %}

{% block scripts %}
<script src="{{ asset('/assets/js/rich-text-field.js') }}" defer></script>
<script src="{{ asset('/assets/js/sortable.js') }}" defer></script>
<script src="{{ asset('/assets/js/list-editor.js') }}" defer></script>
<script src="{{ asset('/assets/js/banner-config.js') }}" defer></script>
{% endblock %}
