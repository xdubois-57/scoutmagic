{#
  One list of people to contact, drawn the same way on all three pages of
  this module.

  A list, never a table: every row is one person plus at most three short
  facts about them, which a phone renders as a readable stack and a table
  renders as four cramped columns with a horizontal scrollbar. This is the
  page a chef d'unité opens on a Sunday evening on their phone.

  `severity` colours the day count and nothing else — never the row, never
  the name. A person is not a status, and the only thing this module is
  ever entitled to shade is a number it computed itself (a steward's day
  count against the thresholds in LeadershipRules). Everywhere else the
  value is 'normal' and nothing is coloured at all.

  A list of people to contact is only useful if it can be acted on: every
  name links to that person's fiche, every address is a `mailto:`, and one
  button copies the whole list's addresses at once (public/assets/js/
  leadership-copy-emails.js). The people Desk holds no address for are
  COUNTED under the list rather than quietly dropped — a list that hides
  them reads as a complete list of people who were written to.

  Usage:
  {% include '@leadership/partials/_person_list.html.twig' with {
      lines: to_convince,
      list_id: 'training-to-convince',
      empty_message: 'Personne à convaincre cette année.',
  } only %}

  `list_id` is optional; without it the copy button is not offered.
#}
{% if lines|length > 0 %}
    {% set _with_email = lines|filter(l => l.email)|length %}
    {% if list_id|default('') and _with_email > 0 %}
        <div class="d-flex justify-content-end mb-2">
            <button type="button" class="btn btn-sm btn-outline-secondary"
                    data-copy-emails="{{ list_id }}">
                <i class="bi bi-clipboard" aria-hidden="true"></i>
                Copier les adresses
            </button>
        </div>
    {% endif %}
    <ul class="list-group list-group-flush" id="{{ list_id|default('') }}">
        {% for line in lines %}
            <li class="list-group-item px-0 py-3"
                {%- if line.email %} data-email="{{ line.email }}"{% endif %}>
                <div class="d-flex flex-wrap justify-content-between align-items-start gap-2">
                    <div class="min-w-0">
                        {# Full legal name first: these lists exist to go and
                           talk to somebody, or to look them up in Desk, and
                           Desk knows nobody by their totem. The totem is a
                           second line only when there is one — see
                           Value\PersonLine::$totem for why it is not the
                           site's usual `totem ?? first_name`. #}
                        <div class="fw-semibold">
                            <a href="/members/{{ line.memberYearId }}">{{ line.fullName }}</a>
                        </div>
                        {% if line.totem %}
                            <div class="small text-body-secondary">{{ line.totem }}</div>
                        {% endif %}
                        {% if line.email %}
                            <div class="small">
                                <a href="mailto:{{ line.email }}">{{ line.email }}</a>
                            </div>
                        {% endif %}
                    </div>
                    {% if line.days is not null %}
                        {# « 12 j » alone says nothing: on the obligations
                           page it is a birthday still to come, on the
                           stewards page a registration already running.
                           And the colour is the whole of the severity for
                           a sighted reader and none of it for anybody
                           else, so the word goes with it. #}
                        <span class="small fw-semibold flex-shrink-0
                            {%- if line.severity == 'critical' %} text-danger
                            {%- elseif line.severity == 'warning' %} text-warning-emphasis
                            {%- else %} text-body-secondary{% endif %}">
                            {% if line.severity == 'critical' %}
                                <span class="visually-hidden">Critique :</span>
                            {% elseif line.severity == 'warning' %}
                                <span class="visually-hidden">Attention :</span>
                            {% endif %}
                            {{ line.daysDirection == 'until' ? 'dans' : 'depuis' }} {{ line.days }} j
                        </span>
                    {% endif %}
                </div>
                {# Conditioned, not always drawn: a row with neither a
                   section nor a detail used to render an empty div, whose
                   only visible effect was a gap under the name. #}
                {% if line.sectionName or line.detail %}
                    <div class="small text-body-secondary mt-1">
                        {% if line.sectionName %}{{ line.sectionName }}{% endif %}
                        {%- if line.sectionName and line.detail %} — {% endif %}
                        {%- if line.detail %}{{ line.detail }}{% endif %}
                    </div>
                {% endif %}
                {% if line.note %}
                    <div class="small mt-1">{{ line.note }}</div>
                {% endif %}
            </li>
        {% endfor %}
    </ul>
    {% if lines|length > _with_email %}
        {# Dit à voix haute : sans cette phrase, une liste de seize personnes
           dont on n'écrit qu'à douze se lit comme seize personnes prévenues. #}
        <p class="small text-body-secondary mt-2 mb-0">
            {{ lines|length - _with_email }} personne{{ lines|length - _with_email > 1 ? 's' : '' }}
            sans adresse dans Desk : à contacter autrement.
        </p>
    {% endif %}
{% else %}
    {% include 'partials/empty_state.html.twig' with {
        message: empty_message,
        compact: true,
    } only %}
{% endif %}
