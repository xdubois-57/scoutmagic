{#
  One list of the Configuration page (#727): for each raw Desk value, how
  many people carry it this year, and one compact line — the step select
  and the trash — that saves itself (public/assets/js/
  leadership-configuration.js). No « Modifier », no « Rattachée à … »:
  the select says what it is attached to.

  Written once because the two lists it serves — « À configurer » and
  « Correspondances existantes » — are the same row: a row saved in the
  first moves to the second as it is, its trash revealed.

  A list, not a table: a select and a variable-length Desk string do not
  fit four columns on a 375px screen.

  This partial owns the surrounding list as well as each item: a partial
  holding a bare item has no way to show a static HTML checker that it is
  only ever rendered inside a list.

  Parameters:
    list_id   -- the <ul>'s id, which the script moves rows between
    rows      -- [{ raw_value, holders, selected }, …]
                 selected: the step currently chosen, or null for a value
                 nobody has decided yet
    steps     -- assignable_steps: [{ value, label }, …]
#}
<ul class="list-group list-group-flush leadership-mapping-list" id="{{ list_id }}">
    {% for row in rows %}
        {% set _selected = row.selected|default(null) %}
        <li class="list-group-item px-0 py-2 leadership-mapping-row" data-raw-value="{{ row.raw_value }}">
            <div class="fw-semibold text-break"><code>{{ row.raw_value }}</code></div>
            <div class="small text-body-secondary">
                {% if row.holders > 0 %}
                    {{ row.holders }} personne{{ row.holders > 1 ? 's' : '' }} cette année
                {% else %}
                    Plus utilisée cette année
                {% endif %}
            </div>
            <div class="d-flex gap-2 align-items-center mt-1">
                <select class="form-select form-select-sm w-auto leadership-mapping-select"
                        aria-label="Étape pour « {{ row.raw_value }} »">
                    {% if _selected is null %}
                        <option value="" selected>Choisir une étape…</option>
                    {% endif %}
                    {% for step in steps %}
                        <option value="{{ step.value }}"{{ _selected is not null and step.value == _selected ? ' selected' : '' }}>{{ step.label }}</option>
                    {% endfor %}
                </select>
                <button type="button" class="btn btn-sm btn-outline-danger leadership-mapping-delete{{ _selected is null ? ' d-none' : '' }}"
                        title="Supprimer le rattachement"
                        aria-label="Supprimer le rattachement de « {{ row.raw_value }} »">
                    <i class="bi bi-trash" aria-hidden="true"></i>
                </button>
            </div>
        </li>
    {% endfor %}
</ul>
