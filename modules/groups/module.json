  "settings": [
    {
      "key": "groups_report_hide_threshold",
      "default_value": "2",
      "type": "number",
      "label": "Signalements avant masquage automatique",
      "description": "Nombre de signalements à partir duquel un message ou une réponse est masqué automatiquement pour tout le monde, sauf pour les modérateurs du groupe. Le masquage est la seule conséquence automatique : rien n'est jamais supprimé sans l'action d'un modérateur."
    },
    {
      "key": "groups_ai_moderation_enabled",
      "default_value": "1",
      "type": "boolean",
      "label": "Modération automatique par IA",
      "description": "Vérifie chaque message et chaque réponse avant publication et propose une reformulation en cas d'attaque personnelle ou de propos irrespectueux. Sans le module « Connecteur IA » actif, ce réglage n'a aucun effet : les messages sont publiés sans vérification. Le signalement par les membres et la modération humaine restent la protection principale dans tous les cas."
    },
    {
      "key": "groups_reaction_notification_window_minutes",
      "default_value": "60",
      "type": "number",
      "label": "Délai entre deux notifications de réaction",
      "description": "Durée, en minutes, pendant laquelle un message ou une réponse ne génère qu'une seule notification de réaction pour son auteur. Sans ce délai, un message qui reçoit douze réactions enverrait douze notifications. Les réactions elles-mêmes restent toutes visibles sur le message : seule la notification est regroupée."
    },
    {
      "key": "groups_inactivity_close_months",
      "default_value": "12",
      "type": "number",
      "label": "Clôture automatique après inactivité (mois)",
      "description": "Nombre de mois sans aucun message, réponse ni réaction au bout desquels un groupe est clôturé automatiquement. Un groupe clôturé reste entièrement visible et consultable par ses membres : il n'accepte simplement plus de nouvelle publication. Un groupe qui n'a jamais rien contenu est compté à partir de sa date de création, pas depuis toujours."
    },
    {
      "key": "groups_post_retention_months",
      "default_value": "24",
      "type": "number",
      "label": "Conservation des messages (mois)",
      "description": "Nombre de mois après la dernière activité d'un message (sa publication, une réponse ou une réaction) au bout desquels ce message est supprimé définitivement, avec ses réponses, ses réactions, ses signalements, ses photos et l'image de son lien. Les messages épinglés ne sont jamais supprimés automatiquement, quel que soit leur âge."
    },
    {
      "key": "groups_closed_purge_months",
      "default_value": "12",
      "type": "number",
      "label": "Suppression des groupes clôturés (mois)",
      "description": "Nombre de mois après la clôture d'un groupe au bout desquels ce groupe est supprimé définitivement, avec tout son contenu et sa galerie. Un groupe de l'année scoute en cours ou d'une année à venir n'est jamais supprimé automatiquement, même clôturé."
    },
    {
      "key": "groups_max_created_per_member",
      "default_value": "5",
      "type": "number",
      "label": "Groupes créés par personne (maximum)",
      "description": "Nombre maximum de groupes sur invitation qu'une même personne peut avoir ouverts en même temps. Les groupes de section, créés automatiquement, ne sont pas comptés, et un groupe clôturé ne compte plus. Cette limite s'applique à tout le monde, administrateurs compris : elle évite l'encombrement de la liste des groupes, ce n'est pas une question de droits."
    }
  ],
