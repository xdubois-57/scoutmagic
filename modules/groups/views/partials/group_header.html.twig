{#
  Group header shared by the group page and its members page: title,
  badges, and the members link. Kept as a partial so the two pages can
  never drift apart.
#}
<div class="d-flex align-items-start justify-content-between gap-2 flex-wrap mb-3">
    <div>
        {#
          `group_label` is the group's name with the current scout year
          appended when it is tied to it — "Louveteaux (2025-2026)", one
          place, Support\GroupLabel. Falls back to the bare name for any
          caller that has not resolved it.
        #}
        <h1 class="h4 mb-1">{{ group_label|default(group.name) }}</h1>
        <div class="d-flex align-items-center gap-2 flex-wrap">
            {% if badges.is_invitation %}
                <span class="badge bg-secondary-subtle text-secondary-emphasis">Sur invitation</span>
            {% endif %}
            {% for name in badges.section_names %}
                <span class="badge bg-info-subtle text-info-emphasis">{{ name }}</span>
            {% endfor %}
            {% if badges.is_archived %}
                <span class="badge bg-secondary-subtle text-secondary-emphasis">Année passée</span>
            {% endif %}
            {% if group.isClosed %}
                <span class="badge bg-warning-subtle text-warning-emphasis">Clôturé</span>
            {% endif %}
            {% if badges.is_moderator %}
                <span class="badge bg-primary-subtle text-primary-emphasis">Modérateur</span>
            {% endif %}
        </div>
        {#
          Member-supplied plain text, escaped by Twig like every other one
          in this module. Under the badges rather than between the title
          and them, so the badges stay glued to the name they qualify.
        #}
        {% if group.description %}
            <p class="text-body-secondary small mb-0 mt-1" style="max-width:60ch;">{{ group.description }}</p>
        {% endif %}
    </div>
    <div class="d-flex gap-2 flex-wrap">
        {#
          Closing and reopening are a moderator's, and belong to the
          group's OWN page only: GroupController::show() is the sole
          caller that resolves `can_moderate` and `can_reopen` into this
          partial. The members page includes it with `only` and passes
          neither (its own context defines can_moderate for its member
          controls, which used to leak in here and put a Clôturer button
          on the members page); search and reports never receive them
          from their controllers at all.
        #}
        {% if can_moderate|default(false) %}
            {% if group.isClosed %}
                {% if can_reopen|default(false) %}
                    <form method="post" action="/groups/{{ group.id }}/reopen">
                        {{ csrf_field()|raw }}
                        <button type="submit" class="btn btn-outline-primary d-flex align-items-center" style="min-height:44px;">
                            <i class="bi bi-arrow-counterclockwise me-1"></i> Rouvrir
                        </button>
                    </form>
                {% endif %}
            {% else %}
                <form method="post" action="/groups/{{ group.id }}/close"
                      data-confirm="Clôturer ce groupe ? Il restera consultable, mais plus personne ne pourra y publier.">
                    {{ csrf_field()|raw }}
                    <button type="submit" class="btn btn-outline-secondary d-flex align-items-center" style="min-height:44px;">
                        <i class="bi bi-archive me-1"></i> Clôturer
                    </button>
                </form>
            {% endif %}
        {% endif %}
        {#
          A moderator's way to what has been signalé — shown only to them,
          and only once there is something to look at: an empty list is a
          button that says "nothing happened", which is noise on every
          other group's header.
        #}
        {% if can_moderate|default(false) and reported_count|default(0) > 0 %}
            <a class="btn btn-outline-warning d-flex align-items-center" style="min-height:44px;"
               href="/groups/{{ group.id }}/reports">
                <i class="bi bi-flag me-1"></i> Signalements
                <span class="badge bg-warning-subtle text-warning-emphasis ms-2">{{ reported_count }}</span>
            </a>
        {% endif %}
        <a class="btn btn-outline-secondary d-flex align-items-center" style="min-height:44px;" href="/groups/{{ group.id }}/gallery">
            <i class="bi bi-images me-1"></i> Galerie
        </a>
        <a class="btn btn-outline-secondary d-flex align-items-center" style="min-height:44px;" href="/groups/{{ group.id }}/members">
            <i class="bi bi-people me-1"></i> Membres
        </a>
    </div>
</div>

{#
  Why a moderator sees no "Rouvrir" here — said once, as a plain line
  rather than a second grey box stacked on the closed-group notice below,
  which is about publishing and not about reopening.
#}
{% if group.isClosed and can_moderate|default(false) and not can_reopen|default(false) %}
    <p class="small text-body-secondary mb-2">
        <i class="bi bi-info-circle me-1"></i>
        Ce groupe appartient à une année scoute passée : il ne peut plus être rouvert.
    </p>
{% endif %}

{% if post_permission is defined and not post_permission.allowed %}
    <div class="alert alert-secondary small" role="status">
        {{ post_permission.message }}
        {% if post_permission.actionUrl %}
            <a href="{{ post_permission.actionUrl }}">{{ post_permission.actionLabel }}</a>
        {% endif %}
    </div>
{% endif %}
