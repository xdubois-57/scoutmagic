{#
  A post's poll: the question, one row per option, and the tally.

  `poll` is Service\PollService::forPosts()' own shape — percentages
  already computed there so the bar's width and the number beside it can
  never disagree. Null when the post carries no poll, which renders
  nothing at all.

  Every option is a real form POST, so voting works with no JavaScript;
  groups.js upgrades the same POST to a fetch() and swaps this whole
  block with the server's freshly rendered response, exactly as it does
  for a reaction. `can_vote` is the group's own canPost() answer — a
  closed group or a past scout year shows the results and no buttons.

  Two things the poll's own settings change here (schema.sql):

  - `vote_scope: member` means one answer per MEMBER rather than per
    login, so an account linked to several members picks whose answer it
    is casting. WHICH of them is
    Service\GroupAccessService::memberIdsAllowedToVoteAsBySide(): a
    section group's poll is that section's question and offers only the
    members it holds; any other group offers every member the account
    reaches, its own first. Those from outside sit under a heading of
    their own — a parent scanning four totems cannot otherwise tell
    which of them this group is even about. Both headings, or neither:
    with everybody on the same side there is nothing to distinguish, and
    a lone heading over a whole list says nothing (a section group is
    always that case). The picker below is a plain <select> that works
    on its own; groups.js hides it and asks the same question in a small
    dialog at the moment of voting, which is where it belongs, reading
    the same two halves off the optgroups.
  - `allow_multiple` means a voter may hold several options at once, and
    tapping one they already hold takes it back — so the buttons are
    "pressed or not" rather than "one of these".
#}
{% if poll %}
    {% set is_member_scope = poll.vote_scope == 'member' %}
    {% set members = vote_members|default([]) %}
    {# The picker's own default, resolved once rather than as
       `members|first.id` inside the loop — that reads an attribute off a
       string when the list is empty, which is a template error rather
       than an empty value. #}
    {% set default_voter_id = members is not empty ? members|first.id : '' %}
    <div class="groups-poll border rounded p-2 mt-2" data-post-id="{{ post.id }}"
         data-multiple="{{ poll.allow_multiple ? '1' : '0' }}">
        <p class="fw-semibold mb-2 small">{{ poll.question }}</p>

        {% if can_vote and is_member_scope and members is not empty %}
            {# `is defined ? :` rather than `|default(true)`: the latter
               answers TRUE for a member who really is `false`, which is
               precisely the ones this heading exists to name.

               Counted before either list is drawn, because the headings
               are all-or-nothing — with everybody on one side there is
               nothing to distinguish and a lone heading says nothing. #}
            {% set in_group_members = members|filter(member => member.in_group is defined ? member.in_group : true) %}
            {% set outside_members = members|filter(member => not (member.in_group is defined ? member.in_group : true)) %}
            {% set split = in_group_members|length > 0 and outside_members|length > 0 %}
            <div class="mb-2 groups-poll-voter">
                <label class="form-label small mb-1" for="poll-voter-{{ post.id }}">Vous répondez pour</label>
                <select class="form-select form-select-sm" id="poll-voter-{{ post.id }}">
                    {% if split %}
                        <optgroup label="Dans ce groupe">
                            {% for member in in_group_members %}
                                <option value="{{ member.id }}">{{ member.name }}</option>
                            {% endfor %}
                        </optgroup>
                        <optgroup label="Hors de ce groupe">
                            {% for member in outside_members %}
                                <option value="{{ member.id }}">{{ member.name }}</option>
                            {% endfor %}
                        </optgroup>
                    {% else %}
                        {% for member in members %}
                            <option value="{{ member.id }}">{{ member.name }}</option>
                        {% endfor %}
                    {% endif %}
                </select>
            </div>
        {% endif %}

        {% for option in poll.options %}
            <div class="mb-1">
                {% if can_vote %}
                    <form method="post" action="/groups/{{ group.id }}/posts/{{ post.id }}/vote" class="groups-poll-form m-0">
                        {{ csrf_field()|raw }}
                        <input type="hidden" name="option_id" value="{{ option.id }}">
                        {#
                          Filled from the picker above — by the browser
                          when groups.js is running, by the select's own
                          value when it is not (the script copies it into
                          every form on change). Ignored outright by an
                          account-scoped poll, and re-checked against the
                          caller's own members either way
                          (Service\PollService::vote()).

                          No literal HTML tag in this comment: Twig comments
                          are not HTML comments, so an analyser reading the
                          rendered-source text would take one for a real
                          unlabelled control.
                        #}
                        {% if is_member_scope %}
                            <input type="hidden" name="voter_member_id" value="{{ default_voter_id }}"
                                   class="groups-poll-voter-input">
                        {% endif %}
                        <button type="submit"
                                class="btn btn-sm w-100 text-start d-flex align-items-center justify-content-between {{ option.is_own ? 'btn-primary' : 'btn-outline-secondary' }}"
                                aria-pressed="{{ option.is_own ? 'true' : 'false' }}">
                            <span>{{ option.label }}</span>
                            <span class="small ms-2">{{ option.votes }} · {{ option.percent }} %</span>
                        </button>
                    </form>
                {% else %}
                    <div class="d-flex align-items-center justify-content-between small py-1">
                        <span>{{ option.label }}{% if option.is_own %} <span class="text-primary">·  votre choix</span>{% endif %}</span>
                        <span>{{ option.votes }} · {{ option.percent }} %</span>
                    </div>
                {% endif %}
                {#
                  The bar carries no text of its own — the numbers are on
                  the row above it, so a reader who cannot see the bar
                  loses nothing. aria-hidden for the same reason.
                #}
                <div class="progress mt-1" style="height:4px;" aria-hidden="true">
                    <div class="progress-bar" style="width: {{ option.percent }}%;"></div>
                </div>
            </div>
        {% endfor %}

        {#
          "3 membres ont répondu" rather than "3 votes": a
          multiple-answer poll holds more answers than people, and the
          number a reader acts on is how many of them answered.
          Whitespace-controlled so the sentence is one line in the
          output, not three (a test reads it, and so does a screen
          reader).
        #}
        <p class="text-body-tertiary mb-0 mt-2" style="font-size:0.75rem;">{{ poll.total }} {{ is_member_scope ? 'membre' : 'personne' }}{{ poll.total > 1 ? 's' : '' }} {{ poll.total > 1 ? 'ont' : 'a' }} répondu{% if can_vote %} · {{ poll.allow_multiple ? 'plusieurs choix possibles' : 'un seul choix, modifiable' }}{% endif %}</p>
    </div>
{% endif %}
