{#
  One post. `row` carries the post plus everything already resolved for
  it: the two author names and which actions this viewer may take. Every
  one of those is re-checked server-side by the action itself — this only
  decides what the kebab menu offers.

  The body is plain text: escaped by Twig (never |raw), with line breaks
  preserved by nl2br on the already-escaped output.
#}
{#
  `row.is_hidden` is only ever true for a moderator: for everyone else an
  auto-hidden post is filtered out in the SQL and never reaches this
  template at all (Service\GroupFeedService). So the banner below is a
  moderator's view of something nobody else can see, not a hidden-by-CSS
  post.
#}
{# id is what a notification's deep link scrolls to — GroupController::post()
   redirects to /groups/{id}#post-{postId} after re-checking membership. #}
<article id="post-{{ row.post.id }}" class="card mb-2{% if row.is_hidden|default(false) %} groups-post-hidden{% endif %}">
    <div class="card-body py-3">
        {#
          Two states, one banner, and both are a moderator's alone
          (Service\GroupFeedService sets `report_count` to 0 for everyone
          else, and an auto-hidden post never reaches this template at
          all for them):

          - hidden — what reports did on their own, undone with Rétablir;
          - reported but still visible — what nothing has done yet, which
            is the state that used to have nowhere to act. Masquer is the
            judgement a count cannot make, Ignorer says the report was
            wrong and protects the item from a later automatic masking.
        #}
        {% if row.is_hidden|default(false) or row.report_count|default(0) > 0 %}
            <div class="alert {{ row.is_hidden|default(false) ? 'alert-warning' : 'alert-secondary' }} d-flex flex-wrap align-items-center gap-2 py-2 px-3 mb-2 small groups-hidden-banner">
                <span class="flex-grow-1">
                    {% if row.is_hidden|default(false) %}
                        <i class="bi bi-eye-slash me-1"></i>
                        Message masqué après {{ row.report_count }} signalement{{ row.report_count > 1 ? 's' : '' }}.
                        Vous seul, en tant que modérateur, le voyez.
                    {% else %}
                        <i class="bi bi-flag me-1"></i>
                        {{ row.report_count }} signalement{{ row.report_count > 1 ? 's' : '' }} sur ce message.
                        Il reste visible par tout le monde.
                    {% endif %}
                </span>
                {% if not row.is_hidden|default(false) %}
                    <form method="post" action="/groups/{{ group.id }}/posts/{{ row.post.id }}/hide" class="m-0"
                          data-confirm="Masquer ce message ? Seuls les modérateurs du groupe le verront encore.">
                        {{ csrf_field()|raw }}
                        {% if on_reports_page|default(false) %}
                            <input type="hidden" name="return_to" value="reports">
                        {% endif %}
                        <button type="submit" class="btn btn-sm btn-outline-secondary d-flex align-items-center">
                            Masquer
                        </button>
                    </form>
                {% endif %}
                <form method="post" action="/groups/{{ group.id }}/posts/{{ row.post.id }}/restore" class="m-0 groups-restore-form">
                    {{ csrf_field()|raw }}
                    <button type="submit" class="btn btn-sm btn-outline-secondary d-flex align-items-center">
                        {{ row.is_hidden|default(false) ? 'Rétablir' : 'Ignorer le signalement' }}
                    </button>
                </form>
            </div>
        {% endif %}
        <div class="d-flex justify-content-between align-items-start gap-2">
            {#
              Who wrote this, drawn by the shared component
              (person_avatar(), Core\View\PersonAvatar): the AUTHOR'S OWN
              login — their photo from "Mon compte" when they have set
              one, their initials otherwise. Keyed on the account rather
              than on the membership beside it, for the same reason the
              name above it is the account's: a message belongs to the
              address that wrote it (ARCHITECTURE.md §8.40).
            #}
            <div class="d-flex align-items-start gap-2 min-width-0">
                {{ person_avatar(row.identity.account_name, { account_id: row.post.authorUserAccountId, size: 40 }) }}
                <div class="min-width-0">
                    <p class="mb-1 small">
                        {% include '@groups/partials/identity.html.twig' with { identity: row.identity } only %}
                    </p>
                    <p class="text-body-tertiary mb-0" style="font-size:0.75rem;">
                        {{ row.post.createdAt|french_date }} à {{ row.post.createdAt|date('H:i') }}
                        {% if row.post.isEdited %}<span class="ms-1">· modifié</span>{% endif %}
                        {# The deadline is part of what a pin means here — one message at a
                           time, for as long as the moderator said — so it is shown rather
                           than left as something only they know. #}
                        {% if row.post.isPinned %}<span class="badge text-bg-warning ms-1">Épinglé{% if row.post.pinnedUntil %} jusqu'au {{ row.post.pinnedUntil|french_date }}{% endif %}</span>{% endif %}
                    </p>
                </div>
            </div>

            {% if row.can_edit or row.can_delete or row.can_pin or row.can_report|default(false) %}
                <div class="dropdown">
                    <button class="btn btn-sm btn-link text-body-secondary d-flex align-items-center justify-content-center"
                            type="button" data-bs-toggle="dropdown"
                            aria-expanded="false" aria-label="Actions sur ce message">
                        <i class="bi bi-three-dots-vertical"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        {#
                          The deep link already exists and is already
                          membership-checked on the way in
                          (Controller\GroupController::post() — a
                          non-member gets the module's usual 404), so this
                          only makes the URL notifications already send
                          reachable by hand. groups.js copies it; with no
                          clipboard API available it falls back to
                          prompting with the URL selected, so the entry is
                          never a dead end.
                        #}
                        <li>
                            <button class="dropdown-item d-flex align-items-center tap-target groups-copy-link"
                                    type="button" data-url="/groups/{{ group.id }}/posts/{{ row.post.id }}">
                                Copier le lien
                            </button>
                        </li>
                        {% if row.can_edit %}
                            <li>
                                <button class="dropdown-item d-flex align-items-center tap-target groups-edit-toggle"
                                        type="button" data-post="{{ row.post.id }}">
                                    Modifier
                                </button>
                            </li>
                        {% endif %}
                        {% if row.can_pin %}
                            <li>
                                {#
                                  Épingler is exclusive — the group keeps
                                  exactly one pinned message — so groups.js
                                  turns this submit into a dialog that says
                                  which message loses its pin
                                  (data-pinned-label) and asks how long this
                                  one stays up, writing the answer into the
                                  hidden field below.

                                  With no JavaScript the same form still
                                  posts, and the server pins for the default
                                  week: the plain control never becomes a
                                  dead end, exactly like every other one in
                                  this module.
                                #}
                                <form method="post" action="/groups/{{ group.id }}/posts/{{ row.post.id }}/{{ row.post.isPinned ? 'unpin' : 'pin' }}"
                                      {% if not row.post.isPinned %}class="groups-pin-form" data-pinned-label="{{ pinned_post_label|default('') }}"{% endif %}>
                                    {{ csrf_field()|raw }}
                                    {% if not row.post.isPinned %}
                                        <input type="hidden" name="duration"
                                               value="{{ constant('Modules\\Groups\\Service\\PostService::PIN_DURATION_DEFAULT') }}">
                                    {% endif %}
                                    <button type="submit" class="dropdown-item d-flex align-items-center tap-target">
                                        {{ row.post.isPinned ? 'Désépingler' : 'Épingler' }}
                                    </button>
                                </form>
                            </li>
                        {% endif %}
                        {% if row.can_report|default(false) %}
                            <li>
                                <form method="post" action="/groups/{{ group.id }}/posts/{{ row.post.id }}/report" class="groups-report-form"
                                      data-confirm="Signaler ce message aux modérateurs du groupe ?">
                                    {{ csrf_field()|raw }}
                                    <button type="submit" class="dropdown-item d-flex align-items-center tap-target">
                                        Signaler
                                    </button>
                                </form>
                            </li>
                        {% endif %}
                        {% if row.can_delete %}
                            <li>
                                <form method="post" action="/groups/{{ group.id }}/posts/{{ row.post.id }}/delete"
                                      class="groups-post-delete-form" data-confirm="Supprimer définitivement ce message ?">
                                    {{ csrf_field()|raw }}
                                    <button type="submit" class="dropdown-item text-danger d-flex align-items-center tap-target">
                                        Supprimer
                                    </button>
                                </form>
                            </li>
                        {% endif %}
                    </ul>
                </div>
            {% endif %}
        </div>

        {% if row.post.body %}
            {% include '@groups/partials/post_body.html.twig' with { post: row.post } only %}
        {% endif %}

        {% include '@groups/partials/post_media_grid.html.twig' with { media: row.media } %}
        {% include '@groups/partials/post_link.html.twig' with { link: row.link } %}
        {% include '@groups/partials/post_event.html.twig' with { event: row.event|default(null) } only %}
        {% include '@groups/partials/poll.html.twig' with {
            poll: row.poll|default(null),
            group: group,
            post: row.post,
            can_vote: participate_permission.allowed|default(false),
            vote_members: vote_members|default([])
        } only %}

        {#
          "Vu par N" — the author's own answer to "did this reach anyone?",
          and shown to nobody else (Service\GroupFeedService::decorate()
          sets the flag, Controller\PostController::seenBy() enforces it
          again on the dialog behind it). A plain <button> with no
          bootstrap attributes of its own: with no JS it is simply a line
          of text that does not open, exactly like the reaction tally
          above it.
        #}
        {% if row.can_see_seen_by|default(false) %}
            <p class="mb-0 mt-2" style="font-size:0.75rem;">
                <button type="button" class="btn btn-link p-0 border-0 text-body-tertiary text-decoration-none groups-seen-by"
                        style="font-size:0.75rem;" aria-haspopup="dialog"
                        data-url="/groups/{{ group.id }}/posts/{{ row.post.id }}/seen-by"
                        data-dialog-title="Vu par">
                    <i class="bi bi-eye me-1"></i>
                    {% if row.seen_count|default(0) > 0 %}
                        Vu par {{ row.seen_count }} membre{{ row.seen_count > 1 ? 's' : '' }}
                    {% else %}
                        Pas encore vu
                    {% endif %}
                </button>
            </p>
        {% endif %}

        {% include '@groups/partials/reactions.html.twig' with {
            summary: row.reactions,
            action: '/groups/' ~ group.id ~ '/posts/' ~ row.post.id ~ '/react',
            reactors_url: '/groups/' ~ group.id ~ '/posts/' ~ row.post.id ~ '/reactions',
            compact: false
        } only %}

        {% if row.can_edit %}
            <form method="post" action="/groups/{{ group.id }}/posts/{{ row.post.id }}/edit"
                  class="mt-2 d-none groups-edit-form" id="post-edit-{{ row.post.id }}">
                {{ csrf_field()|raw }}
                <label class="visually-hidden" for="post-edit-body-{{ row.post.id }}">Modifier le message</label>
                <textarea class="form-control mb-2" id="post-edit-body-{{ row.post.id }}" name="body" rows="3"
                          maxlength="5000" required>{{ row.post.body }}</textarea>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-sm btn-primary d-flex align-items-center">Enregistrer</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary d-flex align-items-center groups-edit-cancel"
                            data-post="{{ row.post.id }}">Annuler</button>
                </div>
            </form>
        {% endif %}

        {#
          Filled in by groups.js when a report goes through without a
          reload. Deliberately the one neutral sentence the server returns
          and nothing else: the reporter learns whether their report was
          received, never what came of it (Controller\ReportController's
          own docblock).
        #}
        <p class="small text-success mt-2 mb-0 d-none groups-report-confirmation" role="status"></p>

        {#
          The conversation under a message, folded away behind a native
          <details> so a feed of twenty messages reads as twenty messages
          rather than as a wall of everything anybody ever answered.

          <details>/<summary> rather than a Bootstrap collapse on purpose:
          it is the browser's own disclosure widget, so it opens, closes,
          takes focus and announces its expanded state with no JavaScript
          at all — the same promise every other control in this module
          keeps. groups.js only keeps the count in the summary honest as
          comments come and go.

          It opens by itself when something arrived since this reader's
          last visit: a badge you have to click to act on is a badge that
          gets ignored.
        #}
        {#
          `participate_permission`, not `post_permission`: publishing a
          message and answering one are two different permissions since
          the group gained a posting policy (Service\GroupAccessService::
          canPost() versus canParticipate()). Everything on a CARD —
          commenting, reacting, voting — is the second one.
        #}
        {% set can_reply = participate_permission.allowed|default(false) %}
        {% set new_replies = row.new_reply_count|default(0) %}
        {% if row.reply_count > 0 or can_reply %}
            <details class="groups-thread mt-2" id="post-thread-{{ row.post.id }}"
                     data-post="{{ row.post.id }}"
                     {%- if new_replies > 0 or (rejected_draft|default(null) and rejected_draft.post_id == row.post.id) %} open{% endif %}>
                <summary class="groups-thread-summary d-flex align-items-center gap-2">
                    <i class="bi bi-chat-left-text" aria-hidden="true"></i>
                    {#
                      data-count is what groups.js reads and rewrites when a
                      comment is added or deleted without a reload — the
                      number, never the sentence, so the two can never
                      disagree about the plural.
                    #}
                    <span class="groups-thread-count" data-count="{{ row.reply_count }}">
                        {%- if row.reply_count == 0 -%}
                            Commenter
                        {%- elseif row.reply_count == 1 -%}
                            1 commentaire
                        {%- else -%}
                            {{ row.reply_count }} commentaires
                        {%- endif -%}
                    </span>
                    {% if new_replies > 0 %}
                        <span class="badge text-bg-danger groups-thread-new">
                            {{ new_replies }} nouveau{{ new_replies > 1 ? 'x' : '' }}
                        </span>
                    {% endif %}
                </summary>

                <div class="groups-replies" id="post-replies-{{ row.post.id }}">
                    {% include '@groups/partials/reply_page.html.twig' with {
                        replies: row.replies,
                        group: group,
                        post: row.post,
                        replies_prev_before_id: row.replies_prev_before_id,
                        on_reports_page: on_reports_page|default(false)
                    } only %}
                </div>

                {% if can_reply %}
                {#
                  data-group-id/data-post-id name the browser-local draft
                  cache groups.js keeps for this one box (never the server
                  — the same "your text survives a lost connection" the
                  message composer already has, see show.html.twig). Read
                  from here rather than parsed out of the action, so the
                  key cannot drift if a route ever changes shape.
                #}
                <form method="post" action="/groups/{{ group.id }}/posts/{{ row.post.id }}/replies"
                      enctype="multipart/form-data" class="groups-reply-form mt-2"
                      data-group-id="{{ group.id }}" data-post-id="{{ row.post.id }}">
                    {{ csrf_field()|raw }}
                    <div class="d-flex align-items-center gap-2">
                        <label class="visually-hidden" for="reply-body-input-{{ row.post.id }}">Répondre</label>
                        {# Refilled only for the very post whose reply was refused, and only
                           for its own author — see show.html.twig's panel. #}
                        {# Same "@" autocomplete as the composer — see show.html.twig. #}
                        <input type="text" class="form-control form-control-sm" id="reply-body-input-{{ row.post.id }}"
                               name="body" placeholder="Répondre…"
                               data-mention-url="/groups/{{ group.id }}/mention-search"
                               value="{% if rejected_draft|default(null) and rejected_draft.post_id == row.post.id %}{{ rejected_draft.body }}{% endif %}"
                               maxlength="{{ constant('Modules\\Groups\\Service\\ReplyService::MAX_BODY_LENGTH') }}">
                        <label class="btn btn-sm btn-outline-secondary d-flex align-items-center mb-0"
                               aria-label="Joindre une image à la réponse">
                            <i class="bi bi-image"></i>
                            {# One image maximum — no `multiple`, and the server rejects a second one anyway. #}
                            <input type="file" name="image[]" class="visually-hidden groups-reply-image" accept="image/*">
                        </label>
                        <button type="submit" class="btn btn-sm btn-primary d-flex align-items-center"
                                aria-label="Envoyer la réponse">
                            <i class="bi bi-send"></i>
                        </button>
                    </div>
                    {#
                      The chosen photo, shown before the comment is sent —
                      groups.js fills this in from the file itself (an
                      object URL, never an upload), so "je l'ai bien
                      attachée ?" is answered by looking rather than by
                      sending. Empty and hidden until then; with no
                      JavaScript it simply stays that way and the plain
                      file input works exactly as it always has.
                    #}
                    <div class="d-none align-items-center gap-2 mt-2 groups-reply-image-preview">
                        <span class="position-relative groups-reply-image-thumb">
                            <img alt="" class="groups-reply-image-thumb-img">
                            <button type="button"
                                    class="btn btn-sm btn-dark position-absolute top-0 end-0 p-0 d-flex align-items-center justify-content-center groups-reply-image-remove"
                                    style="width:22px;height:22px;border-radius:50%;opacity:.85;"
                                    aria-label="Retirer cette photo">
                                <i class="bi bi-x" style="font-size:.9rem;" aria-hidden="true"></i>
                            </button>
                        </span>
                        <span class="small text-body-secondary groups-reply-image-name"></span>
                    </div>
                    {# Filled in by groups.js on a refused/failed dynamic submit —
                       see #groups-post-error's own comment in show.html.twig. #}
                    <p class="small text-danger mt-1 mb-0 d-none groups-reply-error" role="alert"></p>
                </form>
                {% endif %}
            </details>
        {% endif %}
    </div>
</article>
