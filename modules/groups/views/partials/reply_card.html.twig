{#
  One reply. `row` carries the reply plus everything already resolved for
  it: the two author names, its optional image, its reaction summary and
  which actions this viewer may take — every one of them re-checked
  server-side by the action itself.

  The body is plain text, never |raw: `autolink` escapes it and then
  turns its URLs into links and its newlines into <br> — same as a post's
  (partials/post_body.html.twig, Core\View\TextLinker).

  `row.is_hidden` is moderator-only, exactly as on a post: for anyone else
  an auto-hidden reply never comes back from the query
  (Service\ReplyPresenter and Repository\ReplyRepository).
#}
<div class="groups-reply d-flex gap-2 mt-2">
    <div class="flex-grow-1 min-width-0">
        {% if row.is_hidden|default(false) %}
            <div class="alert alert-warning d-flex flex-wrap align-items-center gap-2 py-1 px-2 mb-1 small groups-hidden-banner">
                <span class="flex-grow-1">
                    <i class="bi bi-eye-slash me-1"></i>
                    Réponse masquée après {{ row.report_count }} signalement{{ row.report_count > 1 ? 's' : '' }}.
                </span>
                <form method="post" action="/groups/{{ group.id }}/replies/{{ row.reply.id }}/restore" class="m-0 groups-restore-form">
                    {{ csrf_field()|raw }}
                    <button type="submit" class="btn btn-sm btn-outline-secondary d-flex align-items-center" style="min-height:44px;">
                        Rétablir
                    </button>
                </form>
            </div>
        {% endif %}
        <div class="groups-reply-bubble{% if row.is_hidden|default(false) %} groups-post-hidden{% endif %}">
            <div class="d-flex justify-content-between align-items-start gap-2">
                <p class="mb-1 small">
                    {% include '@groups/partials/identity.html.twig' with { identity: row.identity } only %}
                    <span class="text-body-tertiary ms-1" style="font-size:0.7rem;">
                        {{ row.reply.createdAt|french_date }} à {{ row.reply.createdAt|date('H:i') }}
                        {% if row.reply.isEdited %}· modifié{% endif %}
                    </span>
                </p>

                {% if row.can_edit or row.can_delete or row.can_report|default(false) %}
                    <div class="dropdown">
                        <button class="btn btn-sm btn-link text-body-secondary d-flex align-items-center justify-content-center p-0"
                                style="min-height:44px;min-width:44px;" type="button" data-bs-toggle="dropdown"
                                aria-expanded="false" aria-label="Actions sur cette réponse">
                            <i class="bi bi-three-dots"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            {% if row.can_edit %}
                                <li>
                                    <button class="dropdown-item d-flex align-items-center groups-reply-edit-toggle" style="min-height:44px;"
                                            type="button" data-reply="{{ row.reply.id }}">
                                        Modifier
                                    </button>
                                </li>
                            {% endif %}
                            {% if row.can_report|default(false) %}
                                <li>
                                    <form method="post" action="/groups/{{ group.id }}/replies/{{ row.reply.id }}/report" class="groups-report-form"
                                          data-confirm="Signaler cette réponse aux modérateurs du groupe ?">
                                        {{ csrf_field()|raw }}
                                        <button type="submit" class="dropdown-item d-flex align-items-center" style="min-height:44px;">
                                            Signaler
                                        </button>
                                    </form>
                                </li>
                            {% endif %}
                            {% if row.can_delete %}
                                <li>
                                    <form method="post" action="/groups/{{ group.id }}/replies/{{ row.reply.id }}/delete"
                                          class="groups-reply-delete-form" data-confirm="Supprimer définitivement cette réponse ?">
                                        {{ csrf_field()|raw }}
                                        <button type="submit" class="dropdown-item text-danger d-flex align-items-center" style="min-height:44px;">
                                            Supprimer
                                        </button>
                                    </form>
                                </li>
                            {% endif %}
                        </ul>
                    </div>
                {% endif %}
            </div>

            {% if row.reply.body %}
                <p class="mb-0 groups-post-body" id="reply-body-{{ row.reply.id }}">{{ row.reply.body|autolink }}</p>
            {% endif %}

            {% if row.media %}
                <a href="/gallery/media/{{ row.media.id }}/large" target="_blank" rel="noopener"
                   class="groups-reply-image-link d-block mt-2"
                   data-media-id="{{ row.media.id }}" data-status="{{ row.media.processingStatus }}">
                    {% include '@groups/partials/media_thumb.html.twig' with { media: row.media } %}
                </a>
            {% endif %}
        </div>

        {# Same neutral confirmation as a message's — see post_card.html.twig. #}
        <p class="small text-success mt-1 mb-0 d-none groups-report-confirmation" role="status"></p>

        {% include '@groups/partials/reactions.html.twig' with {
            summary: row.reactions,
            action: '/groups/' ~ group.id ~ '/replies/' ~ row.reply.id ~ '/react',
            reactors_url: '/groups/' ~ group.id ~ '/replies/' ~ row.reply.id ~ '/reactions',
            compact: true
        } only %}

        {% if row.can_edit %}
            <form method="post" action="/groups/{{ group.id }}/replies/{{ row.reply.id }}/edit"
                  class="mt-2 d-none groups-reply-edit-form" id="reply-edit-{{ row.reply.id }}">
                {{ csrf_field()|raw }}
                <label class="visually-hidden" for="reply-edit-body-{{ row.reply.id }}">Modifier la réponse</label>
                <textarea class="form-control mb-2" id="reply-edit-body-{{ row.reply.id }}" name="body" rows="2"
                          maxlength="{{ constant('Modules\\Groups\\Service\\ReplyService::MAX_BODY_LENGTH') }}">{{ row.reply.body }}</textarea>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-sm btn-primary d-flex align-items-center" style="min-height:44px;">Enregistrer</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary d-flex align-items-center groups-reply-edit-cancel"
                            style="min-height:44px;" data-reply="{{ row.reply.id }}">Annuler</button>
                </div>
            </form>
        {% endif %}
    </div>
</div>
