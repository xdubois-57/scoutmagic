{% extends "base.html.twig" %}

{% block title %}Groupes — {{ site_name }}{% endblock %}

{% block content %}
    {% include 'partials/page_header.html.twig' with { title: 'Groupes' } only %}

    {% include 'partials/page_picker.html.twig' with {
        picker_id: 'groups-page-picker',
        pages: [
            { url: '/groups', label: 'Mes groupes' },
            { url: '/groups/archives', label: archived_count > 0 ? 'Archives (' ~ archived_count ~ ')' : 'Archives' },
        ],
        current_path: is_archive_tab ? '/groups/archives' : '/groups',
        sheet_title: 'Choisir une page',
    } only %}

    {% if can_create %}
        {#
          Folded away by default: this page is a list of the groups you
          are in, and for a chief it was opening on a form for a group
          that does not exist yet. A native <details>, like every other
          disclosure in this module — it opens, closes and announces its
          own state with no JavaScript at all.
        #}
        <details class="card mb-3 groups-create">
            <summary class="card-body py-3 d-flex align-items-center gap-2 tap-target" style="cursor:pointer;">
                <i class="bi bi-plus-circle" aria-hidden="true"></i>
                <span class="h6 mb-0">Créer un groupe</span>
            </summary>
            <div class="card-body pt-0">
                <form method="post" action="/groups" class="row g-2">
                    {{ csrf_field()|raw }}
                    <div class="col-12 col-md-5">
                        <label class="form-label small mb-1" for="group-name">Nom du groupe</label>
                        <input type="text" class="form-control" id="group-name" name="name" maxlength="150" required
                               placeholder="Ex. : Louveteaux 2025-2026">
                    </div>
                    <div class="col-12 col-md-4">
                        <label class="form-label small mb-1" for="group-section">Section</label>
                        <select class="form-select" id="group-section" name="section_id">
                            <option value="0">Sur invitation (sans section)</option>
                            {% for section in sections %}
                                <option value="{{ section.id }}">{{ section.name ?? section.desk_code }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-12 col-md-3 d-flex align-items-end">
                        <button type="submit" class="btn btn-primary w-100">Créer</button>
                    </div>
                    <div class="col-12">
                        {# The whole row is the tap target (44px), not the 16px box itself. #}
                        <div class="form-check d-flex align-items-center gap-2 mb-0">
                            <input class="form-check-input mt-0" type="checkbox" value="1" id="group-tie-year" name="tie_to_year">
                            <label class="form-check-label small text-body-secondary d-flex align-items-center" for="group-tie-year">
                                Limiter ce groupe sur invitation à l'année scoute en cours
                            </label>
                        </div>
                    </div>
                </form>
            </div>
        </details>
    {% endif %}

    {% if items is empty %}
        {% include 'partials/empty_state.html.twig' with {
            message: is_archive_tab ? 'Aucun groupe archivé.' : "Vous ne faites partie d'aucun groupe pour le moment.",
            icon: 'bi-people',
        } only %}
    {% else %}
        <div class="list-group">
            {% for item in items %}
                {#
                  `has_unread` is "the group has been active since you last
                  opened it" (Service\GroupListService) — the name is bold
                  rather than merely badged, so the distinction survives
                  for someone who cannot rely on the badge's colour alone.
                #}
                <a class="list-group-item list-group-item-action py-3" href="/groups/{{ item.group.id }}">
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        {# The current year's groups carry it in their name here too —
                           this list is exactly where two years of the same section sit
                           side by side (Support\GroupLabel). #}
                        <span class="{{ item.has_unread ? 'fw-bold' : 'fw-semibold' }}">{{ item.label|default(item.group.name) }}</span>
                        {% if item.has_unread %}
                            <span class="badge text-bg-danger">Nouveau</span>
                        {% endif %}
                        {% if item.is_moderator %}
                            <span class="badge text-bg-primary">Modérateur</span>
                        {% endif %}
                        {% if item.is_archived %}
                            {% include 'partials/status_badge.html.twig' with { status: 'archived', label: 'Archivé' } only %}
                        {% endif %}
                        {% if item.group.isClosed %}
                            {% include 'partials/status_badge.html.twig' with { status: 'closed', label: 'Clôturé' } only %}
                        {% endif %}
                    </div>
                    {#
                      The moderator's one-liner, when there is one: an
                      invitation group's name rarely says what it is for,
                      and this is the list where that matters most.
                      Escaped plain text, same as the name above it.
                    #}
                    {% if item.group.description %}
                        <p class="small text-body-secondary mb-0 mt-1">{{ item.group.description }}</p>
                    {% endif %}
                    <p class="small text-body-secondary mb-0 mt-1 d-flex flex-wrap gap-2">
                        <span>{{ item.section_names is not empty ? item.section_names|join(', ') : 'Sur invitation' }}</span>
                        <span aria-hidden="true">·</span>
                        <span>Activité {{ item.group.lastActivityAt|relative_date }}</span>
                    </p>
                </a>
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}
