{% extends "base.html.twig" %}

{% block title %}{{ group_label|default(group.name) }} — {{ site_name }}{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" href="/assets/css/components.css">
{% endblock %}

{% block content %}
    {% include '@groups/partials/group_header.html.twig' %}
    {% include '@groups/partials/group_edit_form.html.twig' %}
    {#
      Above the composer rather than below the feed: a member arriving to
      find something said last month should not have to scroll past every
      message to discover that looking for it is possible.
    #}
    {% include '@groups/partials/search_form.html.twig' with { group: group } only %}

    {#
      A message the AI moderation refused, given back to its own author.
      This is the only place any part of a refused message is ever shown,
      and it is shown only to the person who wrote it: it travelled here
      in their own session and has already been cleared
      (Support\RejectedDraft). Nothing about it is stored or journaled.
    #}
    {% if rejected_draft|default(null) %}
        <div class="alert alert-warning" role="alert">
            <p class="fw-semibold mb-1">Votre message n'a pas été publié</p>
            {% if rejected_draft.suggestion %}
                <p class="mb-1 small">Voici une reformulation possible, que vous pouvez reprendre telle quelle :</p>
                <p class="mb-2 fst-italic groups-rejected-suggestion">{{ rejected_draft.suggestion }}</p>
            {% endif %}
            {% if rejected_draft.post_id %}
                <p class="mb-0 small">Votre texte a été conservé ci-dessous, dans le champ de réponse du message concerné.</p>
            {% else %}
                <p class="mb-0 small">Votre texte a été conservé dans le formulaire ci-dessous.</p>
            {% endif %}
        </div>
    {% endif %}

    {% if post_permission.allowed %}
        <form method="post" action="/groups/{{ group.id }}/posts" enctype="multipart/form-data" class="card mb-3" id="groups-post-form"
              data-max-media="{{ max_media_per_post|default(4) }}" data-group-id="{{ group.id }}" data-draft-ttl-minutes="{{ draft_ttl_minutes|default(60) }}">
            <div class="card-body">
                <label class="form-label small mb-1" for="post-body">Écrire un message</label>
                {{ csrf_field()|raw }}
                {#
                  data-mention-url turns on the "@" autocomplete
                  (groups.js): typing @ then a few letters offers the
                  group's own members, and picking one inserts their name
                  as plain text. Nothing about the mention is submitted
                  alongside the message — the server reads the names back
                  out of the stored body itself (Service\MentionService),
                  so a message typed with no JavaScript at all mentions
                  exactly the same people.
                #}
                <textarea class="form-control mb-2" id="post-body" name="body" rows="3"
                          data-mention-url="/groups/{{ group.id }}/mention-search"
                          maxlength="{{ max_body_length }}" placeholder="Votre message…">{% if rejected_draft|default(null) and not rejected_draft.post_id %}{{ rejected_draft.body }}{% endif %}</textarea>

                {#
                  Only rendered when the calendar module is enabled AND
                  has something in the window to offer — an empty picker
                  would advertise a feature this install does not have
                  (Service\PostEventService, Controller\GroupController::
                  show()). Optional: "Aucun" is the default, and the id is
                  re-resolved server-side before it is stored, so a value
                  typed in by hand cannot attach an event the member
                  cannot see.
                #}
                {% if event_options|default([]) is not empty %}
                    <label class="form-label small mb-1" for="post-event">Lier à un événement (facultatif)</label>
                    <select class="form-select mb-2" id="post-event" name="calendar_event_id">
                        <option value="">Aucun</option>
                        {% for event in event_options %}
                            <option value="{{ event.id }}">{{ event.title }} — {{ event.startDate|french_date }}</option>
                        {% endfor %}
                    </select>
                {% endif %}

                <div id="groups-media-previews" class="d-flex flex-wrap gap-2 mb-2"></div>
                <input type="file" name="media[]" id="groups-media-hidden" class="d-none" multiple aria-label="Fichiers média à publier">

                {#
                  Photos and poll side by side: they are the two things
                  you attach to a message, and stacking them put the poll
                  a scroll away from the button that opens it.

                  The poll is a native <details> so it opens, closes and
                  announces itself with no JavaScript — its summary is
                  styled as the button next to Photos, and app.css gives
                  the open panel the whole row (`.groups-poll-details[open]`)
                  so the fields are full width rather than squeezed into a
                  button-sized column. groups.js only adds the empty box
                  that always follows the last one; the boxes themselves
                  are real inputs in the DOM, and leaving them empty is
                  what makes a post without a poll —
                  Service\PollService::normalise() drops the blank rows
                  and refuses anything with fewer than two real options.
                #}
                <div class="d-flex align-items-center flex-wrap gap-2">
                    <label class="btn btn-outline-secondary d-flex align-items-center mb-0">
                        <i class="bi bi-image me-1" aria-hidden="true"></i> Photos{{ video_upload_allowed ? '/vidéos' : '' }}
                        <input type="file" id="groups-media-input" class="visually-hidden"
                               accept="{{ video_upload_allowed ? 'image/*,video/*' : 'image/*' }}" multiple>
                    </label>

                    <details class="groups-poll-details" id="groups-poll-details"
                             data-max-options="{{ constant('Modules\\Groups\\Service\\PollService::MAX_OPTIONS') }}">
                        <summary class="btn btn-outline-secondary d-flex align-items-center mb-0"
                                 style="list-style:none;cursor:pointer;">
                            <i class="bi bi-bar-chart me-1" aria-hidden="true"></i> Sondage
                        </summary>
                        <div class="border rounded p-2 mt-2">
                            <label class="form-label small mb-1" for="poll-question">Question</label>
                            <input type="text" class="form-control mb-2" id="poll-question" name="poll_question"
                                   maxlength="{{ constant('Modules\\Groups\\Service\\PollService::MAX_QUESTION_LENGTH') }}"
                                   placeholder="Ex. : Qui vient au week-end ?">

                            <div id="groups-poll-options">
                                {#
                                  Two boxes to fill in, then one empty one
                                  waiting — the shape the whole control
                                  keeps as it grows: groups.js appends a
                                  fresh empty box whenever the last one is
                                  typed into, and removes the extra empties
                                  when one is cleared, so there is always
                                  exactly one waiting at the end and never
                                  a form full of blanks. With no JavaScript
                                  these three are simply what you get.
                                #}
                                {% for i in 1..3 %}
                                    <div class="d-flex align-items-center gap-2 mb-1 groups-poll-option">
                                        <label class="visually-hidden" for="poll-option-{{ i }}">Choix {{ i }}</label>
                                        <input type="text" class="form-control" id="poll-option-{{ i }}" name="poll_options[]"
                                               maxlength="{{ constant('Modules\\Groups\\Service\\PollService::MAX_OPTION_LENGTH') }}"
                                               placeholder="Choix {{ i }}{{ i > 2 ? ' (facultatif)' : '' }}">
                                        <button type="button" class="btn btn-outline-secondary d-flex align-items-center groups-poll-option-remove"
                                                aria-label="Retirer le choix {{ i }}">
                                            <i class="bi bi-x-lg" aria-hidden="true"></i>
                                        </button>
                                    </div>
                                {% endfor %}
                            </div>

                            <div class="row g-2 mt-1">
                                <div class="col-12 col-md-6">
                                    <label class="form-label small mb-1" for="poll-vote-scope">Qui vote</label>
                                    <select class="form-select" id="poll-vote-scope" name="poll_vote_scope">
                                        <option value="{{ constant('Modules\\Groups\\Service\\PollService::SCOPE_ACCOUNT') }}" selected>
                                            Une réponse par personne connectée
                                        </option>
                                        <option value="{{ constant('Modules\\Groups\\Service\\PollService::SCOPE_MEMBER') }}">
                                            Une réponse par membre (un parent répond pour chaque enfant)
                                        </option>
                                    </select>
                                </div>
                                <div class="col-12 col-md-6 d-flex align-items-end">
                                    <div class="form-check d-flex align-items-center gap-2 mb-0">
                                        <input class="form-check-input mt-0" type="checkbox" value="1"
                                               id="poll-allow-multiple" name="poll_allow_multiple">
                                        <label class="form-check-label small text-body-secondary d-flex align-items-center"
                                               for="poll-allow-multiple">
                                            Plusieurs choix possibles
                                        </label>
                                    </div>
                                </div>
                            </div>

                            <p class="small text-body-secondary mb-0 mt-2">
                                Au moins {{ constant('Modules\\Groups\\Service\\PollService::MIN_OPTIONS') }} choix,
                                {{ constant('Modules\\Groups\\Service\\PollService::MAX_OPTIONS') }} au maximum.
                                Chacun peut changer d'avis tant que le groupe est ouvert.
                            </p>
                        </div>
                    </details>

                    <span class="small text-body-secondary ms-auto" id="groups-media-count">0 / {{ max_media_per_post }} médias</span>
                </div>
                <p class="small text-danger mt-1 mb-0 d-none" id="groups-media-limit-warning" role="alert">
                    Maximum {{ max_media_per_post }} médias par message — les fichiers en trop n'ont pas été ajoutés.
                </p>
                {% if not video_upload_allowed %}
                    <p class="small text-body-secondary mt-1 mb-0">L'envoi de vidéos est désactivé sur ce site.</p>
                {% endif %}

                {#
                  A link typed anywhere in the message above is detected
                  automatically — no separate field to fill in. groups.js
                  fills this in as-you-type (debounced: paused typing,
                  leaving the field, or a paste — never every keystroke,
                  to protect Service\LinkFetchThrottleService's shared
                  per-member budget) by POSTing here to
                  Controller\PostController::linkPreview(); hidden until
                  then, and hidden again if the URL is edited away.
                #}
                <div class="mt-2 d-none" id="groups-link-preview" data-preview-url="/groups/{{ group.id }}/link-preview"></div>

                {#
                  Filled in by groups.js when the dynamic submit (fetch())
                  itself fails or is refused — a stale CSRF token falls
                  back to a real form submit instead (see groups.js), so
                  this only ever shows a REFUSAL the server actually
                  returned, or a genuine network/connection failure.
                #}
                <p class="small text-danger mt-2 mb-0 d-none" id="groups-post-error" role="alert"></p>

                <button type="submit" class="btn btn-primary mt-2">Publier</button>
            </div>
        </form>
    {% endif %}

    {% if pinned is not empty %}
        {% for row in pinned %}
            {% include '@groups/partials/post_card.html.twig' with { row: row, group: group } %}
        {% endfor %}
        <hr class="my-3">
    {% endif %}

    <div id="groups-feed" data-group-id="{{ group.id }}">
        {#
          Always rendered, hidden while the group has something in it, and
          shown or hidden again by groups.js as messages come and go
          without a reload — publishing the group's very first message has
          to take this line away, and deleting its last one has to bring it
          back. Rendered rather than built in JS so the sentence exists in
          exactly one place.
        #}
        {# The wrapper keeps the id groups-feed-empty and the d-none toggling
           contract with groups.js; the sentence itself is rendered by the
           shared empty_state partial. #}
        <div id="groups-feed-empty"{% if posts is not empty or pinned is not empty %} class="d-none"{% endif %}>
            {% include 'partials/empty_state.html.twig' with {
                message: 'Aucun message dans ce groupe pour le moment.',
                icon: 'bi-chat-left-text',
            } only %}
        </div>
        {% if posts is not empty %}
            {% include '@groups/partials/feed_page.html.twig' with { posts: posts, group: group, next_cursor: next_cursor } %}
        {% endif %}
    </div>

    {% include '@groups/partials/detail_modal.html.twig' %}

    {#
      The photo viewer is gallery's own (@gallery/partials/lightbox.html.twig
      driven by /assets/js/gallery.js) rather than a second one written
      here: groups hard-requires gallery, every media in a post already
      lives in a gallery delegated album, and post_media_grid.html.twig's
      cells carry exactly the trigger attributes that lightbox reads.
      gallery.js's other blocks each guard on their own DOM first, so
      loading it on this page starts the lightbox and nothing else.
    #}
    {% include '@gallery/partials/lightbox.html.twig' %}
{% endblock %}

{% block scripts %}
<script src="/assets/js/gallery.js" defer nonce="{{ csp_nonce }}"></script>
<script src="/assets/js/groups.js" defer nonce="{{ csp_nonce }}"></script>
{% endblock %}
