{% extends "base.html.twig" %}

{% block title %}{{ group.name }} — {{ site_name }}{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" href="/assets/css/components.css">
{% endblock %}

{% block content %}
    {% include '@groups/partials/group_header.html.twig' %}
    {% include '@groups/partials/group_edit_form.html.twig' %}

    {#
      A message the AI moderation refused, given back to its own author.
      This is the only place any part of a refused message is ever shown,
      and it is shown only to the person who wrote it: it travelled here
      in their own session and has already been cleared
      (Support\RejectedDraft). Nothing about it is stored or journaled.
    #}
    {% if rejected_draft|default(null) %}
        <div class="alert alert-warning" role="alert">
            <p class="fw-semibold mb-1">Votre message n'a pas été publié</p>
            {% if rejected_draft.suggestion %}
                <p class="mb-1 small">Voici une reformulation possible, que vous pouvez reprendre telle quelle :</p>
                <p class="mb-2 fst-italic groups-rejected-suggestion">{{ rejected_draft.suggestion }}</p>
            {% endif %}
            {% if rejected_draft.post_id %}
                <p class="mb-0 small">Votre texte a été conservé ci-dessous, dans le champ de réponse du message concerné.</p>
            {% else %}
                <p class="mb-0 small">Votre texte a été conservé dans le formulaire ci-dessous.</p>
            {% endif %}
        </div>
    {% endif %}

    {% if post_permission.allowed %}
        <form method="post" action="/groups/{{ group.id }}/posts" enctype="multipart/form-data" class="card mb-3" id="groups-post-form" data-max-media="{{ max_media_per_post|default(4) }}">
            <div class="card-body">
                <label class="form-label small mb-1" for="post-body">Écrire un message</label>
                {{ csrf_field()|raw }}
                <textarea class="form-control mb-2" id="post-body" name="body" rows="3"
                          maxlength="{{ max_body_length }}" placeholder="Votre message…">{% if rejected_draft|default(null) and not rejected_draft.post_id %}{{ rejected_draft.body }}{% endif %}</textarea>

                {% if author_options is not empty %}
                    <label class="form-label small mb-1" for="post-author">Publier en tant que</label>
                    <select class="form-select mb-2" id="post-author" name="author_member_id" style="min-height:44px;">
                        {% for option in author_options %}
                            <option value="{{ option.id }}">{{ option.name }}</option>
                        {% endfor %}
                    </select>
                {% endif %}

                <div id="groups-media-previews" class="d-flex flex-wrap gap-2 mb-2"></div>
                <input type="file" name="media[]" id="groups-media-hidden" class="d-none" multiple>

                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                    <div class="d-flex gap-2">
                        <label class="btn btn-outline-secondary d-flex align-items-center mb-0" style="min-height:44px;">
                            <i class="bi bi-image me-1"></i> Photos{{ video_upload_allowed ? '/vidéos' : '' }}
                            <input type="file" id="groups-media-input" class="visually-hidden"
                                   accept="{{ video_upload_allowed ? 'image/*,video/*' : 'image/*' }}" multiple>
                        </label>
                        <button type="button" class="btn btn-outline-secondary d-flex align-items-center" style="min-height:44px;"
                                id="groups-link-toggle">
                            <i class="bi bi-link-45deg me-1"></i> Lien
                        </button>
                    </div>
                    <span class="small text-body-secondary" id="groups-media-count">0 / {{ max_media_per_post }} médias</span>
                </div>
                <p class="small text-danger mt-1 mb-0 d-none" id="groups-media-limit-warning">
                    Maximum {{ max_media_per_post }} médias par message — les fichiers en trop n'ont pas été ajoutés.
                </p>
                {% if not video_upload_allowed %}
                    <p class="small text-body-secondary mt-1 mb-0">L'envoi de vidéos est désactivé sur ce site.</p>
                {% endif %}

                <div class="mt-2 d-none" id="groups-link-field">
                    <label class="form-label small mb-1" for="post-link">Lien</label>
                    <input type="url" class="form-control" id="post-link" name="link"
                           placeholder="https://…" maxlength="2048">
                </div>

                <button type="submit" class="btn btn-primary mt-2" style="min-height:44px;">Publier</button>
            </div>
        </form>
    {% endif %}

    {% if pinned is not empty %}
        {% for row in pinned %}
            {% include '@groups/partials/post_card.html.twig' with { row: row, group: group } %}
        {% endfor %}
        <hr class="my-3">
    {% endif %}

    <div id="groups-feed" data-group-id="{{ group.id }}">
        {% if posts is empty and pinned is empty %}
            <p class="text-body-secondary text-center py-5 mb-0">Aucun message dans ce groupe pour le moment.</p>
        {% else %}
            {% include '@groups/partials/feed_page.html.twig' with { posts: posts, group: group, next_cursor: next_cursor } %}
        {% endif %}
    </div>

    {#
      One shared dialog for every reaction tally on the page — a tally's
      own click (groups.js) fetches partials/reactors_list.html.twig's
      rendered output and fills #groups-reactors-modal-body with it before
      showing this same modal, rather than one dialog per post/reply.
    #}
    <div class="modal fade" id="groups-reactors-modal" tabindex="-1" aria-labelledby="groups-reactors-modal-label" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title h5" id="groups-reactors-modal-label">Réactions</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
                </div>
                <div class="modal-body" id="groups-reactors-modal-body">
                    <div class="text-center py-3">
                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block scripts %}
<script src="/assets/js/groups.js" defer nonce="{{ csp_nonce }}"></script>
{% endblock %}
