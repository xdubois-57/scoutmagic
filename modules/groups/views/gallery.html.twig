{% extends "base.html.twig" %}

{% block title %}Galerie — {{ group.name }} — {{ site_name }}{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" href="/assets/css/components.css">
{% endblock %}
{#
  A group's photos, shown with gallery's OWN grid and gallery's own lightbox
  (@gallery/partials/media_grid + lightbox) rather than a second grid written
  here. The media already live in a gallery delegated album, so the only
  thing this page ever had of its own was a worse presentation: cells that
  opened each photo in a new browser tab instead of the viewer every other
  album on the site uses.

  What stays this module's own is the only thing that is: WHICH media are
  listed. A report-hidden post's photos are filtered out upstream, in
  Service\PostMediaService::groupGalleryMedia() — gallery knows nothing of
  this module's moderation state and must not.
#}
{% block content %}
    <div class="d-flex align-items-start justify-content-between gap-2 flex-wrap mb-3">
        <div>
            <h1 class="h4 mb-1">Galerie — {{ group.name }}</h1>
            <p class="text-body-secondary small mb-0">Tous les médias publiés dans ce groupe, du plus récent au plus ancien.</p>
        </div>
        <a class="btn btn-outline-secondary d-flex align-items-center" style="min-height:44px;" href="/groups/{{ group.id }}">
            <i class="bi bi-arrow-left me-1"></i> Retour au groupe
        </a>
    </div>

    {% if media is empty %}
        <p class="text-body-secondary text-center py-5 mb-0">Aucun média n'a encore été publié dans ce groupe.</p>
    {% else %}
        {#
          Every rendition is addressed through GET /gallery/media/{id}/{size},
          the same well-known route an ordinary album's own templates use —
          see Api\DelegatedMedia, which deliberately carries no URL of its
          own so the storage backend stays gallery's business.
        #}
        {% set rows = [] %}
        {% for m in media %}
            {% set rows = rows|merge([{
                media: m,
                thumb_url: '/gallery/media/' ~ m.id ~ '/thumb',
                medium_url: '/gallery/media/' ~ m.id ~ '/medium',
                large_url: '/gallery/media/' ~ m.id ~ (m.mediaType == 'video' ? '/original' : '/large'),
            }]) %}
        {% endfor %}

        {% include '@gallery/partials/media_grid.html.twig' with { rows: rows } %}

        {% include '@gallery/partials/lightbox.html.twig' %}
    {% endif %}
{% endblock %}

{% block scripts %}
    <script src="/assets/js/gallery.js" defer nonce="{{ csp_nonce }}"></script>
{% endblock %}
