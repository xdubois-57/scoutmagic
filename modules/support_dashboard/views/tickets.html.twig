{% extends 'base.html.twig' %}
{% block title %}Tickets de support — {{ site_name }}{% endblock %}

{# Les blocs <pre> de cette page (description, note, analyse, JSON brut)
   sont mis en forme dans components.css, que base.html.twig ne charge
   délibérément pas. Sans ce lien, une seule ligne longue pousse toute la
   page de côté à 375px. #}
{% block stylesheets %}
<link rel="stylesheet" href="{{ asset('/assets/css/components.css') }}">
{% endblock %}

{% block content %}

{% include 'partials/page_header.html.twig' with { title: 'Tickets de support' } only %}

{% include '@support_dashboard/_nav.html.twig' %}


{# Filtres et recherche vivent dans la query string et nulle part ailleurs
   (ARCHITECTURE.md §8.50) : la même URL montre toujours la même liste. #}
<div class="card mb-3">
    <div class="card-body">
        <form method="get" action="/support-dashboard/tickets" class="row g-2 align-items-end">
            <div class="col-12 col-md-4">
                <label class="form-label" for="ticket-search">Recherche</label>
                <input type="search" class="form-control" id="ticket-search" name="q"
                       value="{{ filters.search }}" placeholder="Description, référence, note…">
            </div>
            <div class="col-6 col-md-3">
                <label class="form-label" for="ticket-status">Statut</label>
                <select class="form-select" id="ticket-status" name="status">
                    <option value="open"{% if filters.status == 'open' %} selected{% endif %}>Ouverts</option>
                    <option value="closed"{% if filters.status == 'closed' %} selected{% endif %}>Clôturés</option>
                    <option value="all"{% if filters.status == 'all' %} selected{% endif %}>Tous</option>
                </select>
            </div>
            <div class="col-6 col-md-3">
                <label class="form-label" for="ticket-category">Catégorie</label>
                <select class="form-select" id="ticket-category" name="category">
                    <option value="">Toutes</option>
                    {% for category in categories %}
                        <option value="{{ category.value }}"{% if filters.category == category.value %} selected{% endif %}>
                            {{ category.label }}
                        </option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-12 col-md-2">
                <button type="submit" class="btn btn-primary w-100">Filtrer</button>
            </div>
        </form>
    </div>
</div>

{% if triage_token_available %}
{# Repliée par défaut : on la configure une fois, et elle occupait ensuite
   le haut d'une page dont l'objet est la file des tickets. L'en-tête
   porte l'état — c'est la seule chose qu'on revient y vérifier, et
   replier une boîte dont l'état ne se lit pas fermée revient à cacher la
   réponse. #}
<div class="card mb-3">
    <div class="card-body">
        <button type="button"
                class="btn w-100 d-flex align-items-center gap-2 border rounded-3 p-3 text-start collapsed"
                data-bs-toggle="collapse" data-bs-target="#triage-token"
                aria-expanded="false" aria-controls="triage-token">
            <span class="flex-grow-1">
                <span class="h5 mb-0 d-block">Triage automatique des issues GitHub</span>
                <span class="text-body-secondary small d-block">
                    {% if triage_token_configured %}
                        Jeton actif : le triage peut lire un extrait anonymisé de l'archive d'un ticket cité.
                    {% else %}
                        Aucun jeton : aucun extrait n'est servi au triage.
                    {% endif %}
                </span>
            </span>
            <i class="bi bi-chevron-down text-body-tertiary" aria-hidden="true"></i>
        </button>

        <div class="collapse mt-3" id="triage-token">

        {# Ce qui part, dit avant les boutons : un extrait réduit et
           anonymisé de l'archive d'un ticket, servi au triage
           automatique quand un signalement GitHub cite la référence du
           ticket. Le jeton est l'unique clé de cette route ; seule son
           empreinte est conservée ici (ARCHITECTURE.md §8.49sexies). #}
        <p class="small mb-2">
            Quand un signalement GitHub cite la référence d'un ticket, le triage automatique peut
            demander à ce site une <strong>copie réduite et anonymisée</strong> de l'archive de
            diagnostic : journaux et journal des événements avec les adresses IP, les comptes, les
            adresses e-mail et les identifiants de membres reconnaissables remplacés par des jetons,
            sans la configuration détaillée de PHP, sans les paramètres du site, sans la description
            du ticket. L'extrait est produit à la demande et jamais conservé ; chaque envoi est inscrit
            au journal. Tant qu'un jeton existe, GitHub et le fournisseur d'IA du triage figurent parmi
            les sous-traitants de la page RGPD de ce site.
        </p>
        <p class="small mb-3">
            {% if triage_token_configured %}
                {% include 'partials/status_badge.html.twig' with { status: 'done', label: 'Jeton actif' } only %}
                Un jeton est en place. Générer un nouveau jeton remplace l'ancien, qui cesse de fonctionner.
            {% else %}
                {% include 'partials/status_badge.html.twig' with { status: 'pending', label: 'Aucun jeton' } only %}
                Aucun jeton n'est en place : aucun extrait n'est servi. Générez-en un et copiez-le dans
                le secret <code>SUPPORT_TRIAGE_TOKEN</code> du dépôt GitHub — il ne s'affiche qu'une fois.
            {% endif %}
        </p>

        {# Les noms exacts, et où les saisir. Ils ne se lisent nulle part
           ailleurs qu'au fond d'un fichier de workflow : sans cette
           liste, configurer le triage commence par une fouille dans
           .github/workflows, et se termine souvent par un secret nommé
           presque juste. #}
        <div class="alert alert-secondary small mb-3">
            <p class="mb-2">
                <strong>À configurer dans le dépôt GitHub</strong>, sous
                <em>Settings → Secrets and variables → Actions</em> :
            </p>
            <ul class="mb-2">
                <li>
                    Onglet <em>Variables</em> — <code>SUPPORT_SITE_URL</code> : l'adresse publique de
                    ce site, celle que le triage interrogera pour obtenir l'extrait.
                </li>
                <li>
                    Onglet <em>Secrets</em> — <code>SUPPORT_TRIAGE_TOKEN</code> : le jeton généré
                    ci-dessous. C'est l'unique clé de cette route.
                </li>
            </ul>
            <p class="mb-0">
                Le triage lui-même a besoin d'un troisième réglage, indépendant de cette page :
                le secret <code>CLAUDE_CODE_OAUTH_TOKEN</code>, qui autorise l'action à appeler le
                modèle. Sans lui, aucun signalement n'est trié, avec ou sans jeton ici.
            </p>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <form method="post" action="/support-dashboard/tickets/triage-token"
                  data-confirm="Générer un nouveau jeton ? Le jeton actuel cesse immédiatement de fonctionner, et le nouveau devra être copié dans le secret SUPPORT_TRIAGE_TOKEN du dépôt GitHub.">
                {{ csrf_field()|raw }}
                <button type="submit" class="btn btn-outline-primary">Générer un nouveau jeton</button>
            </form>
            {% if triage_token_configured %}
                <form method="post" action="/support-dashboard/tickets/triage-token/revoke"
                      data-confirm="Révoquer le jeton ? Plus aucun extrait ne sera servi au triage GitHub tant qu'un nouveau jeton n'aura pas été généré.">
                    {{ csrf_field()|raw }}
                    <button type="submit" class="btn btn-outline-danger">Révoquer le jeton</button>
                </form>
            {% endif %}
        </div>
        </div>
    </div>
</div>
{% endif %}

{% if analysis_available %}
<div class="card mb-3">
    <div class="card-body">
        <h2 class="h5 mb-3">Analyse transversale</h2>

        {# Ce que l'envoi implique, dit avant le bouton et non après : les
           descriptions partent chez un fournisseur externe, ce qui en fait
           un sous-traitant (roadmap IT-28). #}
        <div class="alert alert-info small">
            <strong>Ce qui part :</strong> la catégorie, la description et la note de résolution des
            {{ analysis_pending }} ticket(s) les plus récents. Jamais l'adresse de contact, jamais l'URL
            de l'instance, jamais l'identifiant d'installation. Rien ne part tant que vous n'avez pas cliqué.
        </div>

        <form method="post" action="/support-dashboard/tickets/analyse">
            {{ csrf_field()|raw }}
            <button type="submit" class="btn btn-outline-primary"{% if analysis_pending == 0 %} disabled{% endif %}>
                Analyser les tickets
            </button>
        </form>

        {% if analysis %}
            <hr>
            <p class="small text-body-secondary mb-2">
                Analyse de {{ analysis.ticket_count }} ticket(s), le {{ analysis.requested_at }}.
            </p>
            {# Rendu en HTML par Core\View\MarkdownRenderer, qui échappe
               TOUT avant de réintroduire le balisage qu'il connaît : ce que
               le fournisseur renvoie ne peut donc pas devenir du HTML que
               cette page exécute, et le `|raw` porte sur la sortie du
               rendu, jamais sur le texte reçu. #}
            <div class="support-analysis border rounded p-3 bg-body-tertiary small mb-0">
                {{ analysis.result|markdown|raw }}
            </div>
        {% endif %}
    </div>
</div>
{% endif %}

<div class="card">
    <div class="card-body">
        {% if tickets is empty %}
            <p class="text-body-secondary mb-0">Aucun ticket ne correspond à ces critères.</p>
        {% else %}
            <div class="table-responsive">
                <table class="table table-sm align-middle">
                    <thead>
                        <tr>
                            <th scope="col" class="support-ticket-cell">Référence</th>
                            <th scope="col">Reçu</th>
                            <th scope="col">Catégorie</th>
                            <th scope="col">Instance</th>
                            <th scope="col">Statut</th>
                            <th scope="col">Archive</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for ticket in tickets %}
                            <tr>
                                <td class="support-ticket-cell">
                                    <a href="/support-dashboard/tickets/{{ ticket.id }}">
                                        <code>{{ ticket.reference }}</code>
                                    </a>
                                    {# Un extrait, pas la description entière : on
                                       cherche dans ce champ, et une liste de
                                       références sans un mot du texte ne se trie
                                       pas à l'œil. #}
                                    <div class="small text-body-secondary">
                                        {{ ticket.description|slice(0, 90) }}{% if ticket.description|length > 90 %}…{% endif %}
                                    </div>
                                </td>
                                <td class="small">{{ ticket.created_at }}</td>
                                <td class="small">{{ ticket.category ? ticket.category.label : 'Non précisée' }}</td>
                                <td class="small">
                                    {# Imprimée toujours, jamais rendue cliquable : la
                                       valeur vient d'un inconnu (ARCHITECTURE.md §8.50). #}
                                    {{ ticket.installation.instance_url|default('Installation inconnue') }}
                                </td>
                                <td>
                                    {% include 'partials/status_badge.html.twig' with {
                                        status: ticket.status == 'closed' ? 'done' : 'pending',
                                        label: ticket.status == 'closed' ? 'Clôturé' : 'Ouvert',
                                    } only %}
                                </td>
                                <td class="small">
                                    {% if ticket.archive_file_id %}
                                        <i class="bi bi-paperclip" aria-hidden="true"></i>
                                        <span class="visually-hidden">Archive transmise</span>
                                    {% else %}
                                        <span class="text-body-secondary">—</span>
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>
</div>

{% endblock %}
