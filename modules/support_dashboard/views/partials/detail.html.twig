{# Detail dialog body — rendered server-side so Twig escapes every value
   reported by a remote installation. Fetched on click rather than embedded
   once per row: a page of installations would otherwise carry a full JSON
   payload each. #}
{% macro metric(label, value) %}
    <div class="col-12 col-md-6">
        <p class="small text-body-secondary mb-0">{{ label }}</p>
        <p class="mb-2">{% if value is null or value == '' %}<span class="text-body-secondary">Non renseigné</span>{% else %}{{ value }}{% endif %}</p>
    </div>
{% endmacro %}
{% import _self as detail %}

<div class="row">
    {{ detail.metric('URL de l\'instance', installation.instance_url) }}
    {{ detail.metric('Identifiant d\'installation', installation.installation_id) }}
    {{ detail.metric('Version / build', installation.scoutmagic_version) }}
    {{ detail.metric('Build de développement', installation.is_dev_build is null ? null : (installation.is_dev_build ? 'Oui' : 'Non')) }}
    {{ detail.metric('Année scoute', installation.scout_year_label) }}
    {{ detail.metric('Membres actifs', installation.active_members) }}
    {{ detail.metric('Sections actives', installation.active_sections) }}
    {{ detail.metric('Méthode d\'installation', installation.installation_method) }}
    {{ detail.metric('Mises à jour automatiques', installation.auto_update_enabled is null ? null : (installation.auto_update_enabled ? 'Activées' : 'Désactivées')) }}
    {{ detail.metric('Niveau de mise à jour', installation.auto_update_level) }}
    {{ detail.metric('Date d\'installation', installation.installed_at) }}
    {{ detail.metric('Dernière mise à jour', installation.last_upgraded_at) }}
    {{ detail.metric('Première réception', installation.first_seen_at) }}
    {{ detail.metric('Dernière réception', installation.last_received_at) }}
    {{ detail.metric('Version de schéma des statistiques', installation.statistics_schema_version) }}
    {{ detail.metric('Statut', installation.telemetry_enabled
        ? (installation.is_active ? 'Active' : 'Obsolète')
        : "Sans télémétrie — enregistrée à l'occasion d'un ticket") }}
</div>

<h3 class="h6 mt-3">Modules</h3>
{% if installation.modules is empty %}
    <p class="small text-body-secondary">Non renseigné</p>
{% else %}
    <ul class="list-unstyled small mb-3">
        {% for moduleId, module in installation.modules %}
            <li>
                <code>{{ moduleId }}</code>
                {% include 'partials/status_badge.html.twig' with {
                    status: module.enabled ? 'active' : 'inactive',
                    label: module.enabled ? 'activé' : 'désactivé',
                } only %}
                {% if module.version %}<span class="text-body-secondary">{{ module.version }}</span>{% endif %}
            </li>
        {% endfor %}
    </ul>
{% endif %}

{# Les sondes e-mail de diagnostic (roadmap IT-27). Ici et nulle part
   ailleurs : la chaîne de relais, ce sont des adresses IP et des noms de
   serveurs, et ce dialogue est déjà réservé aux super-administrateurs. #}
<h3 class="h6">Sondes e-mail de diagnostic</h3>
{% if probes is empty %}
    <p class="small text-body-secondary mb-3">
        Cette installation n'a jamais demandé de sonde.
    </p>
{% else %}
    <div class="table-responsive mb-3">
        <table class="table table-sm align-middle small">
            <thead>
                <tr>
                    <th scope="col">Boîte</th>
                    <th scope="col">Émise</th>
                    <th scope="col">Réception</th>
                    <th scope="col">SPF</th>
                    <th scope="col">DKIM</th>
                    <th scope="col">DMARC</th>
                </tr>
            </thead>
            <tbody>
                {% for probe in probes %}
                    <tr>
                        <td>{{ probe.mailbox_address }}</td>
                        <td>{{ probe.issued_at }}</td>
                        <td>
                            {% if probe.received_at %}
                                {% include 'partials/status_badge.html.twig' with { status: 'done', label: 'Reçue' } only %}
                                {{ probe.received_at }}
                                {% if probe.delay_seconds is not null %}
                                    <span class="text-body-secondary">
                                        (en {{ probe.delay_seconds < 60
                                            ? probe.delay_seconds ~ ' s'
                                            : (probe.delay_seconds // 60) ~ ' min' }})
                                    </span>
                                {% endif %}
                            {% else %}
                                {# « Jamais reçue » et « expirée » sont deux
                                   faits différents : l'un peut encore
                                   changer, l'autre non. #}
                                {% include 'partials/status_badge.html.twig' with {
                                    status: 'pending',
                                    label: probe.expires_at < 'now'|date('Y-m-d H:i:s') ? 'Jamais reçue' : 'En attente',
                                } only %}
                            {% endif %}
                        </td>
                        {% for mechanism in ['spf', 'dkim', 'dmarc'] %}
                            <td>
                                {% if probe.authentication is null %}
                                    <span class="text-body-secondary">—</span>
                                {% else %}
                                    {% set verdict = probe.authentication[mechanism]|default('absent') %}
                                    {% if verdict == 'pass' %}
                                        <span class="text-success">réussi</span>
                                    {% elseif verdict == 'fail' %}
                                        <span class="text-danger">échec</span>
                                    {% elseif verdict == 'absent' %}
                                        <span class="text-body-secondary">non renseigné</span>
                                    {% elseif verdict == 'unverified' %}
                                        <span class="text-body-secondary">signée, non vérifiée</span>
                                    {% else %}
                                        <span class="text-body-secondary">{{ verdict }}</span>
                                    {% endif %}
                                {% endif %}
                            </td>
                        {% endfor %}
                    </tr>
                    {% if probe.authentication and probe.authentication.relays is not empty %}
                        <tr>
                            <td colspan="6" class="text-body-secondary">
                                <details>
                                    <summary>Chaîne de relais ({{ probe.authentication.relays|length }})</summary>
                                    <ol class="mb-0 mt-1">
                                        {% for relay in probe.authentication.relays %}
                                            <li><code>{{ relay }}</code></li>
                                        {% endfor %}
                                    </ol>
                                </details>
                            </td>
                        </tr>
                    {% endif %}
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endif %}

<h3 class="h6">JSON brut du dernier rapport accepté</h3>
<p class="small text-body-secondary">
    Le document exact reçu, champs inconnus de ce receveur compris. Aucun identifiant de sécurité n'y figure.
</p>
<pre class="border rounded p-3 bg-body-tertiary small mb-3 support-raw-json"><code>{{ installation.raw_json }}</code></pre>

{# Manual deletion, ahead of what retention would do on its own. The
   confirmation is mandatory (base.html.twig's delegated data-confirm
   handler); the CSRF token is what actually protects the endpoint. #}
<form method="post" action="/support-dashboard/installations/{{ installation.id }}/delete"
      data-confirm="Supprimer définitivement cet enregistrement ? L'identifiant, l'URL, le dernier rapport et l'empreinte du secret associé seront effacés. Les agrégats mensuels déjà finalisés ne sont pas modifiés.">
    {{ csrf_field()|raw }}
    <button type="submit" class="btn btn-sm btn-outline-danger">Supprimer cet enregistrement</button>
</form>
