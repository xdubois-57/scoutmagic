{% extends 'base.html.twig' %}
{% block title %}Tableau de bord support — {{ site_name }}{% endblock %}

{# Les blocs <pre> de cette page (description, note, analyse, JSON brut)
   sont mis en forme dans components.css, que base.html.twig ne charge
   délibérément pas. Sans ce lien, une seule ligne longue pousse toute la
   page de côté à 375px. #}
{% block stylesheets %}
<link rel="stylesheet" href="{{ asset('/assets/css/components.css') }}">
{% endblock %}

{% macro value_or_missing(value) %}{% if value is null or value == '' %}<span class="text-body-secondary">Non renseigné</span>{% else %}{{ value }}{% endif %}{% endmacro %}

{% block content %}
{% import _self as display %}

{% include 'partials/page_header.html.twig' with { title: 'Tableau de bord support' } only %}

{# ---------------------------------------------------------------- #}
{# Indicator tiles — always recomputed on the currently filtered set. #}
{# ---------------------------------------------------------------- #}
{% include 'partials/stat_tiles.html.twig' with {
    tiles: [
        {
            label: 'Installations actives',
            value: view.indicators.active_installations,
        },
        {
            label: 'Total membres actifs',
            value: display.value_or_missing(view.indicators.total_active_members),
        },
        {
            label: 'Total sections actives',
            value: display.value_or_missing(view.indicators.total_active_sections),
        },
        {
            label: 'Version la plus répandue',
            value: display.value_or_missing(view.indicators.most_common_version),
            sublabel: view.indicators.most_common_version_count
                ? view.indicators.most_common_version_count ~ ' installation(s)' : '',
        },
        {
            label: 'Mises à jour automatiques',
            value: view.indicators.auto_update_percentage is null
                ? display.value_or_missing(null)
                : view.indicators.auto_update_percentage ~ ' %',
            sublabel: view.indicators.auto_update_known_count
                ? 'sur ' ~ view.indicators.auto_update_known_count ~ ' renseignée(s)' : '',
        },
    ],
    columns: 5,
} only %}

{# ---------------------------------------------------------------- #}
{# Filters and search — plain GET form, so the whole view state is    #}
{# the query string and nothing is ever remembered between visits.    #}
{# ---------------------------------------------------------------- #}
<form method="get" action="/support-dashboard" class="card mb-4">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-12 col-lg-4">
                {% include 'partials/form_field.html.twig' with {
                    field_id: 'filter-q', field_name: 'q', type: 'search',
                    label: 'Recherche', value: filters.search,
                    placeholder: 'URL, identifiant, version, année scoute',
                } only %}
            </div>

            <div class="col-6 col-lg-2">
                {% include 'partials/form_field.html.twig' with {
                    field_id: 'filter-status', field_name: 'status', type: 'select',
                    label: 'Statut',
                    options: [
                        { value: 'active', label: 'Actives', selected: filters.status == 'active' },
                        { value: 'stale', label: 'Obsolètes', selected: filters.status == 'stale' },
                        { value: 'all', label: 'Toutes', selected: filters.status == 'all' },
                    ],
                } only %}
            </div>

            <div class="col-6 col-lg-2">
                {# The looped options are built just above each include so the
                   placeholder entry and the selected state stay side by side. #}
                {% set _version_options = [{ value: '', label: 'Toutes' }]|merge(
                    view.available.versions|map(version => {
                        value: version, label: version, selected: filters.version == version,
                    })
                ) %}
                {% include 'partials/form_field.html.twig' with {
                    field_id: 'filter-version', field_name: 'version', type: 'select',
                    label: 'Version / build', options: _version_options,
                } only %}
            </div>

            <div class="col-6 col-lg-2">
                {% set _method_options = [{ value: '', label: 'Toutes' }]|merge(
                    view.available.installation_methods|map(method => {
                        value: method, label: method, selected: filters.installationMethod == method,
                    })
                ) %}
                {% include 'partials/form_field.html.twig' with {
                    field_id: 'filter-method', field_name: 'installation_method', type: 'select',
                    label: "Méthode d'installation", options: _method_options,
                } only %}
            </div>

            <div class="col-6 col-lg-2">
                {% set _auto_update_options = [{ value: '', label: 'Toutes' }]|merge(
                    view.available.auto_update_levels|map(level => {
                        value: level.key, label: level.label, selected: filters.autoUpdate == level.key,
                    })
                ) %}
                {% include 'partials/form_field.html.twig' with {
                    field_id: 'filter-auto-update', field_name: 'auto_update', type: 'select',
                    label: 'Mise à jour automatique', options: _auto_update_options,
                } only %}
            </div>

            <div class="col-6 col-lg-3">
                {% set _module_options = [{ value: '', label: 'Tous' }]|merge(
                    view.available.modules|map(moduleId => {
                        value: moduleId, label: moduleId, selected: filters.moduleId == moduleId,
                    })
                ) %}
                {% include 'partials/form_field.html.twig' with {
                    field_id: 'filter-module', field_name: 'module', type: 'select',
                    label: 'Module', options: _module_options,
                } only %}
            </div>

            <div class="col-6 col-lg-3">
                {% include 'partials/form_field.html.twig' with {
                    field_id: 'filter-module-state', field_name: 'module_state', type: 'select',
                    label: 'État du module',
                    options: [
                        { value: '', label: 'Peu importe' },
                        { value: 'enabled', label: 'Activé', selected: filters.moduleEnabled is same as(true) },
                        { value: 'disabled', label: 'Désactivé', selected: filters.moduleEnabled is same as(false) },
                    ],
                } only %}
            </div>

            {# Every sortable field is reachable here, including the two the
               responsive table has no column for (date d'installation) or
               no header link on. The clickable column headers below are a
               shortcut onto the same query parameters, never a second,
               narrower vocabulary. #}
            <div class="col-6 col-lg-3">
                {% include 'partials/form_field.html.twig' with {
                    field_id: 'filter-sort', field_name: 'sort', type: 'select',
                    label: 'Trier par',
                    options: [
                        { value: 'last_received', label: 'Dernière réception', selected: filters.sort == 'last_received' },
                        { value: 'active_members', label: 'Membres actifs', selected: filters.sort == 'active_members' },
                        { value: 'version', label: 'Version / build', selected: filters.sort == 'version' },
                        { value: 'installed_at', label: "Date d'installation", selected: filters.sort == 'installed_at' },
                        { value: 'instance_url', label: "URL d'instance", selected: filters.sort == 'instance_url' },
                    ],
                } only %}
            </div>

            <div class="col-6 col-lg-3">
                {% include 'partials/form_field.html.twig' with {
                    field_id: 'filter-dir', field_name: 'dir', type: 'select',
                    label: 'Sens',
                    options: [
                        { value: 'desc', label: 'Décroissant', selected: filters.descending },
                        { value: 'asc', label: 'Croissant', selected: not filters.descending },
                    ],
                } only %}
            </div>

            <div class="col-12 col-lg-6 d-flex align-items-end gap-2">
                <button type="submit" class="btn btn-primary">Filtrer</button>
                <a href="/support-dashboard" class="btn btn-outline-secondary">Réinitialiser</a>
            </div>
        </div>
    </div>
</form>

{# ---------------------------------------------------------------- #}
{# Current-state charts — exactly two, recomputed on the filtered set. #}
{# ---------------------------------------------------------------- #}
<div class="row g-3 mb-4">
    <div class="col-12 col-lg-6">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h6">Répartition des versions / builds</h2>
                <div class="support-chart"><canvas id="chart-versions"></canvas></div>
            </div>
        </div>
    </div>
    <div class="col-12 col-lg-6">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h6">Répartition des modes de mise à jour automatique</h2>
                <div class="support-chart"><canvas id="chart-auto-update"></canvas></div>
            </div>
        </div>
    </div>
</div>

{# ---------------------------------------------------------------- #}
{# Historique mensuel — exactement un graphe, et totalement           #}
{# indépendant des filtres, de la recherche et du tri d'état courant. #}
{# Son propre formulaire ne transporte que sa période, ce qui rend    #}
{# cette indépendance structurelle et non déclarative.                #}
{# ---------------------------------------------------------------- #}
<div class="card mb-4">
    <div class="card-body">
        <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
            <div>
                <h2 class="h6 mb-1">Installations ayant émis, par mois</h2>
                <p class="small text-body-secondary mb-0">
                    Nombre d'installations distinctes ayant transmis au moins un rapport au cours du mois.
                    Cet historique est indépendant des filtres ci-dessus.
                </p>
            </div>
            <form method="get" action="/support-dashboard" class="d-flex align-items-center gap-2">
                <label for="history-period" class="form-label mb-0 small">Période</label>
                {# Submission on change is wired in support-dashboard.js —
                   an inline onchange= would be silently blocked by the CSP
                   (script-src carries no 'unsafe-inline', and a nonce never
                   covers an on* attribute), which is exactly how this
                   selector shipped dead once. The button stays visible for
                   everyone rather than <noscript>-only: with JS active it
                   is redundant but harmless, without it it is the only way
                   to apply the choice. #}
                <select class="form-select form-select-sm w-auto" id="history-period" name="history">
                    {% for months in history_choices %}
                        <option value="{{ months }}" {{ history.period.value == months ~ '' ? 'selected' : '' }}>{{ months }} mois</option>
                    {% endfor %}
                    <option value="all" {{ history.period.value == 'all' ? 'selected' : '' }}>Tout l'historique</option>
                </select>
                <button type="submit" class="btn btn-sm btn-outline-secondary">Afficher</button>
            </form>
        </div>

        {% if history.has_data %}
            <div class="support-chart"><canvas id="chart-history"></canvas></div>
        {% else %}
            {% include 'partials/empty_state.html.twig' with {
                message: "Aucun mois n'est encore finalisé. Un mois est finalisé peu après sa fin.",
                compact: true,
            } only %}
        {% endif %}
    </div>
</div>

{# ---------------------------------------------------------------- #}
{# Table — progressive columns, mobile first.                        #}
{# ---------------------------------------------------------------- #}
<div class="card">
    <div class="card-body">
        <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-2">
            <p class="small text-body-secondary mb-0">
                {{ view.filtered_count }} installation(s) affichée(s) sur {{ view.total_count }} conservée(s).
                Une installation est considérée active si son dernier rapport date de moins de
                {{ view.active_threshold_days }} jours. Au-delà de {{ view.retention_months }} mois sans
                rapport, son enregistrement est supprimé automatiquement.
            </p>
            {# Exports the whole filtered set, not the page: the same query
               string the table was built from is handed straight through. #}
            <a class="btn btn-sm btn-outline-primary"
               href="/support-dashboard/export{{ filters.queryString({'page': null}) }}">
                Exporter en XLSX
            </a>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th scope="col"><a href="/support-dashboard{{ filters.queryString({'sort': 'instance_url', 'dir': filters.sort == 'instance_url' and filters.descending ? 'asc' : null, 'page': null}) }}">URL</a></th>
                        <th scope="col"><a href="/support-dashboard{{ filters.queryString({'sort': 'version', 'dir': filters.sort == 'version' and filters.descending ? 'asc' : null, 'page': null}) }}">Version / build</a></th>
                        <th scope="col">Dernière mise à jour</th>
                        <th scope="col" class="d-none d-md-table-cell">Statut</th>
                        <th scope="col" class="d-none d-md-table-cell"><a href="/support-dashboard{{ filters.queryString({'sort': 'last_received', 'dir': filters.sort == 'last_received' and filters.descending ? 'asc' : null, 'page': null}) }}">Dernière réception</a></th>
                        <th scope="col" class="d-none d-lg-table-cell"><a href="/support-dashboard{{ filters.queryString({'sort': 'active_members', 'dir': filters.sort == 'active_members' and filters.descending ? 'asc' : null, 'page': null}) }}">Membres actifs</a></th>
                        <th scope="col" class="d-none d-lg-table-cell">Installation</th>
                        <th scope="col" class="d-none d-lg-table-cell">Mise à jour auto.</th>
                        <th scope="col" class="d-none d-xxl-table-cell">Sections actives</th>
                        <th scope="col" class="text-end">Détail</th>
                    </tr>
                </thead>
                <tbody>
                    {% for row in view.rows %}
                        <tr>
                            <td>
                                {# Linked only when the URL is http(s). The value comes from an
                                   unauthenticated remote installation, and Twig's HTML escaping
                                   says nothing about a `javascript:` scheme — so a URL that is
                                   not one is printed as plain text rather than made clickable. #}
                                {% if row.instance_url_href %}
                                    <a href="{{ row.instance_url_href }}" target="_blank" rel="noopener noreferrer">{{ row.instance_url }}</a>
                                {% elseif row.instance_url %}
                                    {{ row.instance_url }}
                                {% else %}
                                    <span class="text-body-secondary">Non renseigné</span>
                                {% endif %}
                            </td>
                            <td>
                                {{ display.value_or_missing(row.scoutmagic_version) }}
                                {% if row.is_dev_build %}<span class="badge text-bg-warning">dev</span>{% endif %}
                            </td>
                            <td>{{ display.value_or_missing(row.last_upgraded_at) }}</td>
                            <td class="d-none d-md-table-cell">
                                {# Three states, not two: a row created for a
                                   ticket by an installation that never agreed
                                   to report is not silent, it never spoke
                                   (roadmap IT-24). #}
                                {% if not row.telemetry_enabled %}
                                    {% include 'partials/status_badge.html.twig' with {
                                        status: 'neutral',
                                        label: 'Sans télémétrie',
                                    } only %}
                                {% else %}
                                    {% include 'partials/status_badge.html.twig' with {
                                        status: row.is_active ? 'active' : 'inactive',
                                        label: row.is_active ? 'Active' : 'Obsolète',
                                    } only %}
                                {% endif %}
                            </td>
                            <td class="d-none d-md-table-cell">{{ display.value_or_missing(row.last_received_at) }}</td>
                            <td class="d-none d-lg-table-cell">{{ display.value_or_missing(row.active_members) }}</td>
                            <td class="d-none d-lg-table-cell">{{ display.value_or_missing(row.installation_method) }}</td>
                            <td class="d-none d-lg-table-cell">
                                {% if row.auto_update_key is null %}
                                    <span class="text-body-secondary">Non renseigné</span>
                                {% else %}
                                    {{ row.auto_update_label }}
                                {% endif %}
                            </td>
                            <td class="d-none d-xxl-table-cell">{{ display.value_or_missing(row.active_sections) }}</td>
                            <td class="text-end">
                                <button type="button" class="btn btn-sm btn-outline-secondary support-detail-btn"
                                        data-installation-id="{{ row.id }}">
                                    Voir
                                </button>
                            </td>
                        </tr>
                    {% else %}
                        {% include 'partials/empty_state.html.twig' with {
                            message: 'Aucune installation ne correspond aux critères.',
                            colspan: 10,
                        } only %}
                    {% endfor %}
                </tbody>
            </table>
        </div>

        {# The shared partial appends the page number to base_url — the
           filter query (page dropped) is rebuilt in front of it so no link
           silently loses the filters the user is looking at. #}
        {% set _pager_query = filters.queryString({'page': null}) %}
        {% include 'partials/pagination.html.twig' with {
            page: view.page,
            total_pages: view.page_count,
            base_url: '/support-dashboard' ~ _pager_query ~ (_pager_query ? '&' : '?') ~ 'page=',
            label: 'Pagination des installations',
        } only %}
    </div>
</div>

{# The inner #support-detail-body div is the fragment target
   support-dashboard.js fills — the embed owns the .modal-body itself. #}
{% embed 'partials/modal.html.twig' with {
    id: 'support-detail-modal',
    title: "Détail de l'installation",
    size: 'lg',
    scrollable: true,
} only %}
    {% block body %}
        <div id="support-detail-body">
            <p class="text-body-secondary mb-0">Chargement…</p>
        </div>
    {% endblock %}
{% endembed %}
{% endblock %}

{% block scripts %}
<script src="{{ asset('/assets/vendor/chartjs/chart.umd.min.js') }}"></script>
{# Server data as a JSON ISLAND, read by support-dashboard.js through
   ScoutMagicApi.pageData(). A version string is reported by a REMOTE
   installation, so it is untrusted text: an island makes it data to the
   parser, and JSON_HEX_TAG/JSON_HEX_AMP escape the tag-closing
   characters on top of that. #}
{% set json_flags = constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_UNESCAPED_UNICODE') %}
<script type="application/json" id="support-dashboard-data">
{{ {
    versions: view.charts.versions,
    autoUpdate: view.charts.auto_update,
    history: history.series
}|json_encode(json_flags)|raw }}
</script>
<script src="{{ asset('/assets/js/support-dashboard.js') }}" defer></script>
{% endblock %}
