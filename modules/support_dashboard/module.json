{
  "id": "support_dashboard",
  "name": "Tableau de bord support",
  "description": "Réception et consultation des rapports d'utilisation envoyés par les installations ScoutMagic.",
  "version": "1.9.0",
  "enabled_by_default": false,
  "visible_when": ["statistics_receiver"],
  "routes": [
    {
      "path": "/api/statistics",
      "method": "POST",
      "controller": "Modules\\SupportDashboard\\Controller\\StatisticsIntakeController",
      "action": "receive",
      "menu": "notre_unite",
      "role_min": "public",
      "label": ""
    },
    {
      "path": "/api/support/tickets",
      "method": "POST",
      "controller": "Modules\\SupportDashboard\\Controller\\TicketIntakeController",
      "action": "receive",
      "menu": "notre_unite",
      "role_min": "public",
      "label": ""
    },
    {
      "path": "/api/support/tickets/{reference}/archive",
      "method": "POST",
      "controller": "Modules\\SupportDashboard\\Controller\\TicketIntakeController",
      "action": "receiveArchive",
      "menu": "notre_unite",
      "role_min": "public",
      "label": ""
    },
    {
      "path": "/api/support/mail-probes",
      "method": "POST",
      "controller": "Modules\\SupportDashboard\\Controller\\TicketIntakeController",
      "action": "mailProbes",
      "menu": "notre_unite",
      "role_min": "public",
      "label": ""
    },
    {
      "path": "/support-dashboard",
      "method": "GET",
      "controller": "Modules\\SupportDashboard\\Controller\\SupportDashboardController",
      "action": "index",
      "menu": "configuration",
      "role_min": "superadmin",
      "label": "Supervision",
      "menu_icon": "bi-speedometer2",
      "menu_group": "exploitation",
      "breadcrumb": { "label": "Supervision", "parents": ["Configuration"] }
    },
    {
      "path": "/support-dashboard/tickets",
      "method": "GET",
      "controller": "Modules\\SupportDashboard\\Controller\\SupportTicketController",
      "action": "index",
      "menu": "configuration",
      "role_min": "superadmin",
      "label": "",
      "breadcrumb": { "label": "Tickets de support", "parents": ["Configuration"] }
    },
    {
      "path": "/support-dashboard/tickets/{id}",
      "method": "GET",
      "controller": "Modules\\SupportDashboard\\Controller\\SupportTicketController",
      "action": "detail",
      "menu": "configuration",
      "role_min": "superadmin",
      "label": "",
      "breadcrumb": { "label": "Ticket", "parents": ["Configuration"] }
    },
    {
      "path": "/support-dashboard/tickets/{id}/close",
      "method": "POST",
      "controller": "Modules\\SupportDashboard\\Controller\\SupportTicketController",
      "action": "close",
      "menu": "configuration",
      "role_min": "superadmin",
      "label": ""
    },
    {
      "path": "/support-dashboard/tickets/analyse",
      "method": "POST",
      "controller": "Modules\\SupportDashboard\\Controller\\SupportTicketController",
      "action": "analyse",
      "menu": "configuration",
      "role_min": "superadmin",
      "label": ""
    },
    {
      "path": "/support-dashboard/installations/{id}",
      "method": "GET",
      "controller": "Modules\\SupportDashboard\\Controller\\SupportDashboardController",
      "action": "detail",
      "menu": "configuration",
      "role_min": "superadmin",
      "label": ""
    },
    {
      "path": "/support-dashboard/export",
      "method": "GET",
      "controller": "Modules\\SupportDashboard\\Controller\\SupportDashboardController",
      "action": "export",
      "menu": "configuration",
      "role_min": "superadmin",
      "label": ""
    },
    {
      "path": "/support-dashboard/installations/{id}/delete",
      "method": "POST",
      "controller": "Modules\\SupportDashboard\\Controller\\SupportDashboardController",
      "action": "delete",
      "menu": "configuration",
      "role_min": "superadmin",
      "label": ""
    }
  ],
  "settings": [
    {
      "key": "support_active_threshold_days",
      "default_value": "14",
      "type": "number",
      "label": "Seuil d'activité d'une installation (jours)",
      "description": "Nombre de jours sans rapport au-delà duquel une installation est considérée comme obsolète. Elle reste conservée et consultable via un filtre."
    },
    {
      "key": "support_retention_months",
      "default_value": "6",
      "type": "number",
      "label": "Durée de conservation d'une installation (mois)",
      "description": "Nombre de mois sans rapport accepté au-delà duquel l'enregistrement d'une installation est supprimé en entier. Les agrégats mensuels déjà finalisés ne sont jamais modifiés par cette suppression."
    }
  ],
  "cookies": [],
  "notifications": [
    {
      "id": "support_dashboard.ticket_received",
      "label": "Nouveau ticket de support",
      "description": "Quand une installation envoie un ticket de support à ce site. Le message ne porte que la référence et la catégorie — jamais ce qui a été écrit ni l'adresse de contact.",
      "group": "Supervision",
      "role_min": "superadmin",
      "channels": {
        "in_app": "default_on",
        "push": "default_on",
        "email": "default_off"
      }
    }
  ],
  "scheduled_tasks": [
    {
      "key": "purge_rate_limits",
      "handler": "Modules\\SupportDashboard\\Task\\PurgeRateLimitsHandler"
    },
    {
      "key": "purge_installations",
      "handler": "Modules\\SupportDashboard\\Task\\PurgeInstallationsHandler"
    },
    {
      "key": "finalize_monthly_aggregate",
      "handler": "Modules\\SupportDashboard\\Task\\FinalizeMonthlyAggregateHandler"
    },
    {
      "key": "purge_tickets",
      "handler": "Modules\\SupportDashboard\\Task\\PurgeTicketsHandler"
    }
  ],
  "storage": {}
}
