{% extends 'base.html.twig' %}
{% block title %}Trombinoscope — {{ site_name }}{% endblock %}
{% block stylesheets %}
<link rel="stylesheet" href="{{ asset('/assets/css/components.css') }}">
{% endblock %}

{% block content %}
    {% include 'partials/page_header.html.twig' with {
        title: 'Trombinoscope',
        badge: scout_year_label,
        action_label: 'Télécharger le PDF',
        action_url: '/trombinoscope/pdf',
        action_icon: 'bi-download',
    } only %}

    {# Nobody prints the whole document: the first page and your own
       section are enough, which is why each page carries its section's
       name where the print dialog shows it. #}
    <p class="text-body-secondary small">
        <i class="bi bi-printer" aria-hidden="true"></i>
        Un document de {{ pdf_page_count }} page{{ pdf_page_count > 1 ? 's' }} — l'annuaire des responsables,
        puis une page par section. Inutile de tout imprimer : la première page et celle de votre
        section suffisent.
        {%- if not show_contacts %} Les coordonnées personnelles y sont masquées par le réglage.{% endif %}
    </p>

    {% if picker_sections|length > 1 %}
        {% include 'partials/section_picker.html.twig' with {
            sections: picker_sections,
            selected_id: selected_id,
            base_url: '/trombinoscope?section='
        } %}
    {% endif %}

    {% if section_blocks is empty %}
        {% include 'partials/empty_state.html.twig' with {
            message: 'Aucune section disponible. Les sections apparaîtront après le premier import Desk.',
            icon: 'bi-people',
        } only %}
    {% endif %}

    {% for block in section_blocks %}
        <section class="mb-5">
            <div class="d-flex align-items-center gap-2 mb-3">
                {% if block.section.color %}
                    <span class="d-inline-block rounded-circle flex-shrink-0"
                          style="width:0.9rem;height:0.9rem;background-color:{{ block.section.color }};"></span>
                {% endif %}
                <h2 class="h5 mb-0">{{ block.section.name ?? block.section.desk_code }}</h2>
                <span class="text-body-secondary small">{{ block.section.branch_name }}</span>
            </div>

            {# A section's address is organizational (design.md §2.6): it belongs
               to the section rather than to whoever currently runs it, so it is
               shown whatever the contacts setting says. #}
            {% if block.section.email %}
                <p class="text-body-secondary small mb-3">
                    <i class="bi bi-envelope" aria-hidden="true"></i>
                    <a href="mailto:{{ block.section.email }}" class="link-body-emphasis text-break">{{ block.section.email }}</a>
                </p>
            {% endif %}

            {% if block.lead or block.staff|length > 0 %}
                <div class="row g-2 row-cols-1 row-cols-sm-2 row-cols-lg-3">
                    {% if block.lead %}
                        <div class="col">
                            <div class="d-flex align-items-center gap-3 p-2 h-100 rounded-3 border border-primary-subtle bg-primary-subtle bg-opacity-25">
                                {{ member_photo(block.lead.memberId, block.lead|display_name, 'member-photo flex-shrink-0') }}
                                <div>
                                    <div class="fw-bold">{{ block.lead|display_name|normalize_name }}</div>
                                    {% if block.lead.getMainFunction() %}
                                        <div class="text-body-secondary small">{{ block.lead.getMainFunction().functionLabel }}</div>
                                    {% endif %}
                                    <div class="d-flex flex-wrap gap-1 mt-1">
                                        <span class="badge text-bg-primary" style="font-size:var(--fs-micro);">Responsable</span>
                                        {% for badge in block.lead.badges %}
                                            <span class="badge text-bg-warning d-inline-flex align-items-center gap-1" style="font-size:var(--fs-micro);">
                                                {{ badge.name }}
                                            </span>
                                        {% endfor %}
                                    </div>
                                    {% if show_contacts %}
                                        {% include '@trombinoscope/partials/contacts.html.twig' with { member: block.lead } only %}
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    {% endif %}
                    {% for member in block.staff %}
                        <div class="col">
                            <div class="d-flex align-items-center gap-3 p-2 h-100">
                                {{ member_photo(member.memberId, member|display_name, 'member-photo flex-shrink-0') }}
                                <div>
                                    <div class="fw-semibold">{{ member|display_name|normalize_name }}</div>
                                    {% if member.getMainFunction() %}
                                        <div class="text-body-secondary small">{{ member.getMainFunction().functionLabel }}</div>
                                    {% endif %}
                                    {% if member.badges|length > 0 %}
                                        <div class="d-flex flex-wrap gap-1 mt-1">
                                            {% for badge in member.badges %}
                                                <span class="badge text-bg-warning d-inline-flex align-items-center gap-1" style="font-size:var(--fs-micro);">
                                                    {{ badge.name }}
                                                </span>
                                            {% endfor %}
                                        </div>
                                    {% endif %}
                                    {% if show_contacts %}
                                        {% include '@trombinoscope/partials/contacts.html.twig' with { member: member } only %}
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% else %}
                {% include 'partials/empty_state.html.twig' with { message: 'Aucun animateur configuré pour cette section.', compact: true } only %}
            {% endif %}
        </section>
    {% endfor %}
{% endblock %}
