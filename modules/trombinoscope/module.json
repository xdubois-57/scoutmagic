{
  "id": "trombinoscope",
  "name": "Trombinoscope",
  "description": "Annuaire photo des animés, classé par section, avec leurs coordonnées et leur fonction.",
  "version": "1.2.0",
  "enabled_by_default": true,
  "routes": [
    {
      "path": "/trombinoscope",
      "method": "GET",
      "controller": "Modules\\Trombinoscope\\Controller\\TrombinoscopeController",
      "action": "index",
      "menu": "espace_animes",
      "role_min": "identified",
      "label": "Trombinoscope",
      "menu_icon": "bi-person-badge",
      "menu_group": "pages",
      "menu_order": 5,
      "breadcrumb": { "label": "Trombinoscope", "parents": ["Espace membres"] }
    },
    {
      "path": "/trombinoscope/pdf",
      "method": "GET",
      "controller": "Modules\\Trombinoscope\\Controller\\TrombinoscopeController",
      "action": "pdf",
      "menu": "espace_animes",
      "role_min": "identified",
      "label": ""
    }
  ],
  "settings": [
    {
      "key": "trombinoscope_show_contacts",
      "default_value": "1",
      "type": "boolean",
      "label": "Afficher les coordonnées des animateurs",
      "description": "Affiche le téléphone et l'adresse e-mail personnels de chaque animateur, sur le trombinoscope et dans le document imprimable. Décochez pour ne montrer que les visages et les fonctions ; les adresses e-mail des sections, qui sont des adresses de service, restent visibles dans tous les cas."
    }
  ],
  "cookies": [],
  "scheduled_tasks": [],
  "storage": {},
  "offline": [
    {
      "path": "/trombinoscope",
      "label": "Trombinoscope",
      "match": "exact",
      "role_min": "identified",
      "prefetch": false
    }
  ]
}
