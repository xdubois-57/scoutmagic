{
  "id": "data_migration",
  "name": "Migration de données",
  "description": "Reprend une fois, depuis l'ancien site de l'unité, des données préparées en fichiers ZIP : chaque import se vérifie avant d'écrire et se relance sans doublon.",
  "version": "1.0.0",
  "category": "technique",
  "enabled_by_default": false,
  "routes": [
    {
      "path": "/config/migration-donnees",
      "method": "GET",
      "controller": "Modules\\DataMigration\\Controller\\DataMigrationController",
      "action": "index",
      "menu": "configuration",
      "role_min": "superadmin",
      "label": "Migration de données",
      "menu_icon": "bi-box-arrow-in-down",
      "menu_group": "donnees_sauvegardes",
      "menu_order": 170,
      "breadcrumb": {
        "label": "Migration de données",
        "parents": [
          "Configuration"
        ]
      }
    },
    {
      "path": "/config/migration-donnees/{importer}",
      "method": "GET",
      "controller": "Modules\\DataMigration\\Controller\\DataMigrationController",
      "action": "show",
      "menu": "configuration",
      "role_min": "superadmin",
      "label": "",
      "breadcrumb": {
        "label": "Import",
        "parents": [
          "Configuration"
        ],
        "ancestors": [
          {
            "label": "Migration de données",
            "path": "/config/migration-donnees"
          }
        ]
      }
    },
    {
      "path": "/config/migration-donnees/{importer}/depot",
      "method": "POST",
      "controller": "Modules\\DataMigration\\Controller\\DataMigrationController",
      "action": "uploadChunk",
      "menu": "configuration",
      "role_min": "superadmin",
      "label": ""
    },
    {
      "path": "/config/migration-donnees/{importer}/source",
      "method": "POST",
      "controller": "Modules\\DataMigration\\Controller\\DataMigrationController",
      "action": "submitSource",
      "menu": "configuration",
      "role_min": "superadmin",
      "label": ""
    },
    {
      "path": "/config/migration-donnees/{importer}/avancer",
      "method": "POST",
      "controller": "Modules\\DataMigration\\Controller\\DataMigrationController",
      "action": "advance",
      "menu": "configuration",
      "role_min": "superadmin",
      "label": ""
    },
    {
      "path": "/config/migration-donnees/{importer}/confirmer",
      "method": "POST",
      "controller": "Modules\\DataMigration\\Controller\\DataMigrationController",
      "action": "confirm",
      "menu": "configuration",
      "role_min": "superadmin",
      "label": ""
    },
    {
      "path": "/config/migration-donnees/{importer}/pause",
      "method": "POST",
      "controller": "Modules\\DataMigration\\Controller\\DataMigrationController",
      "action": "pause",
      "menu": "configuration",
      "role_min": "superadmin",
      "label": ""
    },
    {
      "path": "/config/migration-donnees/{importer}/reprendre",
      "method": "POST",
      "controller": "Modules\\DataMigration\\Controller\\DataMigrationController",
      "action": "resume",
      "menu": "configuration",
      "role_min": "superadmin",
      "label": ""
    },
    {
      "path": "/config/migration-donnees/{importer}/abandonner",
      "method": "POST",
      "controller": "Modules\\DataMigration\\Controller\\DataMigrationController",
      "action": "abandon",
      "menu": "configuration",
      "role_min": "superadmin",
      "label": ""
    },
    {
      "path": "/config/migration-donnees/{importer}/relancer",
      "method": "POST",
      "controller": "Modules\\DataMigration\\Controller\\DataMigrationController",
      "action": "restart",
      "menu": "configuration",
      "role_min": "superadmin",
      "label": ""
    }
  ],
  "settings": [],
  "cookies": [],
  "scheduled_tasks": [
    {
      "key": "purge_uploads",
      "handler": "Modules\\DataMigration\\Task\\PurgeUploadsHandler"
