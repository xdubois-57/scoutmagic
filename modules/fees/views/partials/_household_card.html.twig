{# Physical Desk size and retained tariff count are deliberately separate.
   Each row carries its own expected tariff and uncertainty, including IAmA
   and date-based guests. Real Desk codes are displayed without guessing. #}
<div class="card mb-3">
    <div class="card-body">
        <div class="d-flex flex-column flex-sm-row justify-content-between gap-2 mb-2">
            <div>
                <h3 class="h6 mb-1">{{ review.addressLabel }}</h3>
                <p class="small text-body-secondary mb-0">
                    {{ review.deskSize }} membre{{ review.deskSize > 1 ? 's' : '' }} dans Desk —
                    {% if review.retainedCount.minimum == review.retainedCount.maximum %}
                        {{ review.retainedCount.minimum }} retenu(s) pour le tarif du foyer
                    {% else %}
                        {{ review.retainedCount.minimum }} à {{ review.retainedCount.maximum }} retenus pour le tarif du foyer
                    {% endif %}
                    {% if review.expectedCategory %}
                        — tarif attendu {{ category_labels[review.expectedCategory.value] }}
                    {% elseif review.retainedCount.maximum == 0 %}
                        — uniquement des Invités
                    {% else %}
                        — tarif du foyer non déterminable
                    {% endif %}
                </p>
            </div>
            <div class="text-sm-end flex-shrink-0">
                {% if mode == 'corriger' and review.differenceCents is not null %}
                    <div class="fw-semibold">
                        {{ review.differenceCents > 0 ? '+' : '' }}{{ (review.differenceCents / 100)|money }}
                    </div>
                    <div class="small text-body-secondary">
                        {{ review.differenceCents > 0 ? 'à déclarer en plus' : 'déclaré en trop' }}
                    </div>
                {% elseif mode == 'prevoir' and review.projectedDifferenceCents is not null %}
                    <div class="fw-semibold">{{ (review.projectedDifferenceCents / 100)|money }}</div>
                    <div class="small text-body-secondary">à la bascule</div>
                {% endif %}
            </div>
        </div>

        {% if mode == 'prevoir' %}
            <p class="small mb-2">
                <i class="bi bi-hourglass-split" aria-hidden="true"></i>
                Passera à {{ category_labels[review.projectedCategory.value] }}
                ({{ review.projectedCount.minimum }}{% if review.projectedCount.minimum != review.projectedCount.maximum %} à {{ review.projectedCount.maximum }}{% endif %} retenu(s)) —
                {% for member in review.leavingMembers %}
                    {{ member.nameParts|display_name_full }} — départ annoncé{% if member.leavingMarkedAt %} le {{ member.leavingMarkedAt|date_fr }}{% endif %}{{ not loop.last or review.incomingRegistrations > 0 ? ' ; ' : '' }}
                {% endfor %}
                {% if review.incomingRegistrations > 0 %}
                    {{ review.incomingRegistrations }} inscription{{ review.incomingRegistrations > 1 ? 's' : '' }} acceptée{{ review.incomingRegistrations > 1 ? 's' : '' }} à cette adresse
                {% endif %}
            </p>
        {% endif %}

        {% if mode == 'ignores' and review.ignored %}
            <p class="small text-body-secondary mb-2">
                <i class="bi bi-eye-slash" aria-hidden="true"></i>
                Ignoré le {{ review.ignored.createdAt|date_fr }} : {{ review.ignored.reason }}
            </p>
        {% endif %}

        {% if review.projectionIndeterminate %}
            <p class="small text-body-secondary">Tarif futur non déterminable : le nombre de membres qui compteront pour le foyer reste incertain.</p>
        {% endif %}

        <div class="table-responsive">
            <table class="table table-sm align-middle mb-0">
                <thead>
                    <tr>
                        <th scope="col">Membre</th>
                        <th scope="col">Encodé dans Desk</th>
                        <th scope="col">Attendu</th>
                    </tr>
                </thead>
                <tbody>
                    {% for member in review.members %}
                        <tr>
                            <td><a href="/admin/members/{{ member.memberYearId }}">{{ member.nameParts|display_name_full }}</a></td>
                            <td>
                                {% if member.encodedDeskCode is not null %}
                                    <code class="text-body">{{ member.encodedDeskCode }}</code>
                                {% else %}
                                    {{ member.encodedFeeCategoryId is null ? 'aucun tarif' : '—' }}
                                {% endif %}
                            </td>
                            <td>
                                {% if member.guest.qualifies is same as(true) %}
                                    <span class="small fw-semibold">{{ member.statusLabel }}</span>
                                    <div class="small text-body-secondary">Ne compte pas pour le tarif Couple/Familial.</div>
                                {% elseif member.isIndeterminate %}
                                    <span class="small fw-semibold">{{ member.statusLabel }}</span>
                                    <div class="small text-body-secondary">{{ member.reasonLabel }}</div>
                                {% else %}
                                    {% if member.expectedDeskCodes is not empty %}
                                        <code class="text-body">{{ member.expectedDeskCodes|join(' ou ') }}</code>
                                    {% elseif member.expectedCategory %}
                                        <span class="small">Aucun code Desk n'est associé à {{ member.expectedCategory.label }} (à associer dans le barème).</span>
                                    {% endif %}
                                    <span class="small fw-semibold">{{ member.statusLabel }}</span>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <div class="d-flex flex-wrap gap-2 mt-3">
            {% if mode == 'ignores' %}
                <form method="post" action="/admin/fees/tarifs/reprendre" class="d-inline">
                    {{ csrf_field()|raw }}
                    <input type="hidden" name="address_blind_index" value="{{ review.addressBlindIndex }}">
                    <button type="submit" class="btn btn-sm btn-outline-secondary">
                        <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i> Remettre dans la vérification
                    </button>
                </form>
            {% else %}
                <button type="button" class="btn btn-sm btn-outline-secondary"
                        data-bs-toggle="collapse" data-bs-target="#fees-ignore-{{ review.addressBlindIndex }}"
                        aria-expanded="false" aria-controls="fees-ignore-{{ review.addressBlindIndex }}">
                    <i class="bi bi-eye-slash" aria-hidden="true"></i> Ignorer ce foyer
                </button>
            {% endif %}
        </div>

        {% if mode != 'ignores' %}
            <div class="collapse mt-3" id="fees-ignore-{{ review.addressBlindIndex }}">
                <form method="post" action="/admin/fees/tarifs/ignorer" class="row g-2 align-items-end">
                    {{ csrf_field()|raw }}
                    <input type="hidden" name="address_blind_index" value="{{ review.addressBlindIndex }}">
                    <div class="col-12 col-sm">
                        {% include 'partials/form_field.html.twig' with {
                            field_id: 'fees-reason-' ~ review.addressBlindIndex,
                            field_name: 'reason',
                            label: 'Pourquoi ignorer ce foyer ?',
                            type: 'text',
                            maxlength: 255,
                            required: true,
                            size: 'sm',
                            wrapper_class: 'mb-0',
                        } only %}
                    </div>
                    <div class="col-12 col-sm-auto">
                        <button type="submit" class="btn btn-sm btn-outline-secondary w-100-below-sm">Ignorer</button>
                    </div>
                    {# Under the row, not under the field — see design.md
                       §7.6: `align-items-end` aligns the bottoms of the
                       columns, not their controls. #}
                    <p class="form-text col-12 mb-0">
                        Garde alternée, colocation… Le foyer réapparaîtra si sa composition change.
                    </p>
                </form>
            </div>
        {% endif %}
    </div>
</div>
