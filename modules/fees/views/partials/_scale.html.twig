{# A lookup is a separate, persistent proposal. Only Save writes the scale. #}
{% set _suggested = scale_suggestion|default(null) %}
{% set _proposal = scale_proposal|default(null) %}
{% set _draft = scale_draft|default({}) %}
{% set _open = _suggested or _proposal or _draft %}
{% set _from = _draft.guest_from is defined ? _draft.guest_from : guest_period.from %}
{% set _until = _draft.guest_until is defined ? _draft.guest_until : guest_period.until %}
<div class="card mb-3">
    <div class="card-body py-2">
        <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none"
                data-bs-toggle="collapse" data-bs-target="#fees-scale"
                aria-expanded="{{ _open ? 'true' : 'false' }}" aria-controls="fees-scale">
            <i class="bi bi-sliders" aria-hidden="true"></i> Barème des cotisations
        </button>
        <div class="collapse mt-3{{ _open ? ' show' : '' }}" id="fees-scale">
            <p class="small text-body-secondary">
                Indiquez les montants fédéraux par personne pour {{ scale_year }} et les tarifs correspondants dans Desk.
                Un montant laissé vide reste inconnu : aucun écart en euros ne sera inventé.
            </p>
            {% if guest_period.year and guest_period.year != scale_year %}
                <p class="alert alert-warning small">
                    Le barème enregistré a été confirmé pour {{ guest_period.year }}. Vérifiez les valeurs pour
                    {{ scale_year }} avant de l’enregistrer pour cette année.
                </p>
            {% endif %}
            {% if _suggested %}
                <output class="alert alert-info py-2 small d-block">
                    Montants fédéraux <strong>{{ _suggested.year }}</strong>, relevés le
                    {{ _suggested.verified_on|french_date }} sur
                    <a href="{{ _suggested.url }}" target="_blank" rel="noopener noreferrer">{{ _suggested.host }}</a>
                    — vérifiez puis enregistrez. Seules les cotisations jamais enregistrées sont pré-remplies.
                    Rien n’est enregistré tant que vous n’avez pas cliqué sur « Enregistrer le barème ».
                </output>
            {% endif %}
            <form method="post" action="/admin/fees/tarifs/bareme" id="fees-scale-form">
                {{ csrf_field()|raw }}
                <input type="hidden" name="scale_year" value="{{ scale_year }}">
                <div class="row g-3">
                    {% for key, line in tariff_panel %}
                        {% set _amount_key = 'amount_' ~ key %}
                        {% set _category_key = 'fee_category_' ~ key %}
                        {% set _cents = _suggested.amount_cents[key] ?? line.amount_cents %}
                        {% set _amount = _draft[_amount_key] is defined ? _draft[_amount_key]
                            : (_cents is null ? '' : (_cents / 100)|number_format(2, ',', '')) %}
                        {% set _category = _draft[_category_key] is defined ? _draft[_category_key] : line.fee_category_id %}
                        <div class="col-12 col-md-6 col-xl-4">
                            <fieldset class="border rounded p-3 h-100">
                                <legend class="float-none w-auto fs-6 px-1">{{ line.category.label }}</legend>
                                {% include 'partials/form_field.html.twig' with {
                                    field_id: 'fees-amount-' ~ key, field_name: _amount_key,
                                    label: 'Montant par personne (€)', label_suffix: ' — ' ~ line.category.label,
                                    type: 'text', inputmode: 'decimal', value: _amount, size: 'sm',
                                } only %}
                                {% if key != 'guest' or line.suggested_fee_category_id is not null or _category %}
                                    {% set _options = [{ value: '', label: '— Deviné par le site —', selected: _category is null }] %}
                                    {% for category in fee_categories %}
                                        {% set _options = _options|merge([{
                                            value: category.id,
                                            label: category.label ~ (category.id == line.suggested_fee_category_id ? ' (deviné)' : ''),
                                        }]) %}
                                    {% endfor %}
                                    {% include 'partials/form_field.html.twig' with {
                                        field_id: 'fees-category-' ~ key, field_name: _category_key,
                                        label: 'Tarif Desk correspondant', label_suffix: ' — ' ~ line.category.label,
                                        type: 'select', options: _options, value: _category ?? '', size: 'sm',
                                        wrapper_class: 'mb-0',
                                    } only %}
                                {% else %}
                                    <input type="hidden" name="{{ _category_key }}" value="">
                                    <p class="small text-body-secondary mb-0">
                                        Aucun tarif Invités n’a été trouvé dans Desk. La période d’inscription détermine ce tarif.
                                    </p>
                                {% endif %}
                            </fieldset>
                        </div>
                    {% endfor %}
                </div>
                <fieldset class="border rounded p-3 mt-3">
                    <legend class="float-none w-auto fs-6 px-1">Période Invités</legend>
                    <div class="row g-3">
                        {% for key, label in {from: 'Du (jour/mois)', until: 'Au (jour/mois), inclus'} %}
                            <div class="col-12 col-sm-6">
                                {% include 'partials/form_field.html.twig' with {
                                    field_id: 'fees-guest-' ~ key, field_name: 'guest_' ~ key,
                                    label: label, type: 'text', value: key == 'from' ? _from : _until,
                                    placeholder: key == 'from' ? '01/06' : '31/08', maxlength: 5,
                                    size: 'sm', wrapper_class: 'mb-0', help: 'Format : jour/mois, par exemple 01/06.',
                                } only %}
                            </div>
                        {% endfor %}
                    </div>
                    <p class="small mt-3 mb-1" id="fees-guest-rule">
                        Pour {{ scale_year }}, la cotisation Invités s’applique aux nouvelles inscriptions du
                        {{ _from }} au {{ _until }} inclus, pendant l’année civile {{ scale_year|slice(5, 4) }}.
                    </p>
                    <p class="small text-body-secondary mb-0">
                        Une nouvelle inscription concerne une personne absente de l’année scoute précédente :
                        sa première date de fonction de l’année doit être dans cette période.
                        Une réinscription ou un changement de section n’est pas une nouvelle inscription.
                    </p>
                </fieldset>
                {# Save MUST remain the first submit: Enter must never call the AI. #}
                <div class="d-flex flex-wrap gap-2 mt-3">
                    <button type="submit" class="btn btn-sm btn-outline-secondary">Enregistrer le barème</button>
                    {% if scale_lookup_available|default(false) %}
                        <button type="submit" class="btn btn-sm btn-outline-secondary"
                                formaction="/admin/fees/tarifs/bareme/chercher">
                            <i class="bi bi-magic" aria-hidden="true"></i> Chercher les montants et la période
                        </button>
                    {% endif %}
                </div>
                {% if scale_lookup_available|default(false) %}
                    <p class="form-text mt-2 mb-0">
                        La recherche lit la page fédérale pour l’année affichée et propose les valeurs trouvées,
                        sans modifier vos champs. Choisissez ensuite quoi reprendre, vérifiez et enregistrez.
                    </p>
                {% endif %}
                {% if _proposal %}
                    <section class="alert alert-info mt-3 mb-0" aria-labelledby="fees-proposal-title">
                        <h3 class="h6" id="fees-proposal-title">Proposition fédérale pour {{ _proposal.year }}</h3>
                        <p class="small text-break">
                            Source : <a href="{{ _proposal.url }}" target="_blank" rel="noopener noreferrer">{{ _proposal.url }}</a>.
                            Rien n’est enregistré. Seules les valeurs trouvées remplaceront vos champs.
                        </p>
                        <ul class="small">
                            {% for key, cents in _proposal.amount_cents %}
                                <li>{{ tariff_panel[key].category.label }} : {{ (cents / 100)|number_format(2, ',', ' ') }} €</li>
                            {% endfor %}
                            {% if _proposal.guest_from %}<li>Début Invités : {{ _proposal.guest_from }}</li>{% endif %}
                            {% if _proposal.guest_until %}<li>Fin Invités : {{ _proposal.guest_until }}, inclus</li>{% endif %}
                        </ul>
                        {% if _proposal.missing_fields %}
                            <p class="small fw-semibold">À compléter : {{ _proposal.missing_fields|join(', ') }}.</p>
                        {% endif %}
                        <input type="hidden" name="proposal_token" value="{{ _proposal.token }}">
                        <div class="d-flex flex-wrap gap-2">
                            <button type="submit" class="btn btn-sm btn-outline-primary" name="apply_scale" value="amounts"
                                    formaction="/admin/fees/tarifs/bareme/appliquer">Reprendre les montants</button>
                            <button type="submit" class="btn btn-sm btn-outline-primary" name="apply_scale" value="all"
                                    formaction="/admin/fees/tarifs/bareme/appliquer">Reprendre les montants et la période</button>
                        </div>
                    </section>
                {% endif %}
            </form>
        </div>
    </div>
</div>
