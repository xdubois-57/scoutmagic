      "controller": "Modules\\Fees\\Controller\\FeeAccuracyController",
      "action": "unignore",
      "menu": "espace_admin",
      "label": "",
      "role_min": "admin"
    },
    {
      "path": "/admin/fees/factures",
      "method": "GET",
      "controller": "Modules\\Fees\\Controller\\InvoiceController",
      "action": "index",
      "menu": "espace_admin",
      "label": "",
      "role_min": "admin",
      "breadcrumb": { "label": "Factures de la fédération", "parents": ["Espace chefs d'U"] }
    },
    {
      "path": "/admin/fees/factures/import",
      "method": "GET",
      "controller": "Modules\\Fees\\Controller\\InvoiceController",
      "action": "form",
      "menu": "espace_admin",
      "label": "",
      "role_min": "admin",
