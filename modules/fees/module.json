  "settings": [
    {
      "key": "fees_federal_scale_url",
      "default_value": "https://www.lesscouts.be/fr/ressources-scouts/administratif-1/inscriptions-et-cotisations/inscriptions-et-cotisations",
      "type": "url",
      "label": "Page des cotisations de la fédération",
      "description": "Page lue par le bouton « Chercher les montants et la période » du barème, dans Justesse des tarifs. Le site n'utilise aucun moteur de recherche : le jour où la fédération déplace cette page, c'est ce champ qu'il faut corriger. Sans connecteur IA actif, ce réglage ne sert à rien et le bouton n'est pas proposé."
    },
    {
