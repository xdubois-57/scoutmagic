{% extends 'base.html.twig' %}
{% block title %}{{ asset.name }} — {{ site_name }}{% endblock %}
{#
  The availability grid (partials/month_day_grid.html.twig) is styled by
  components.css, which base.html.twig deliberately does NOT load — it is
  opt-in per page, the same way members/show.html.twig, chefs/staffs.html.twig
  and registration/departures.html.twig link it.

  Without this link every `.daygrid-week` falls back to `display: block` and
  the month renders as a vertical stack of 42 unstyled cells: the calendar is
  unreadable and, because the cells lose their sizing, effectively unusable.
  That is the actual root cause of "le calendrier ne s'affiche pas" — not the
  grid builder, which was producing the right cells all along.
#}
{% block stylesheets %}
<link rel="stylesheet" href="/assets/css/components.css">
{% endblock %}
{#
  One public asset: its editable presentation blocks, its availability
  calendar, and a live price estimate.

  What is NOT here is load-bearing (§6.6): no manager name, phone or email,
  no emergency number, nothing about any renter or booking, no price actually
  paid, no document, no access code, no internal comment. The calendar shows
  THAT a day is taken and never WHY — a booking, a hold and a manual block
  are one indistinguishable state.

  Rich text comes from editable() (§6.9), keyed per asset, so a chief edits it
  in place and this module never grows a rich-text column of its own — same
  mechanism as the banner module.
#}
{% block content %}
    <div class="page-medium">
        {% include 'partials/page_header.html.twig' with {
            title: asset.name,
            subtitle: asset.assetType,
        } only %}
        {% if can_manage %}
            {# Straight to THIS asset's managed space — landing on the
               list and having to find the asset again was a detour the
               button's own label promised not to take. Outline, not the
               page's primary: the visitor-facing estimate/request flow
               keeps the one btn-primary of this screen. #}
            <p class="mb-3">
                <a href="/mes-locations/{{ asset.slug }}" class="btn btn-outline-secondary">Gérer ce bien</a>
            </p>
        {% endif %}

        {% if not asset.isPubliclyVisible %}
            <div class="alert alert-warning">
                Ce bien n'est pas visible publiquement. Vous le voyez parce que vous le gérez.
            </div>
        {% endif %}

        <div class="mb-4">
            {{ editable(editable_prefix ~ '_intro', '<p>Présentez ce bien en quelques lignes.</p>')|raw }}
        </div>

        <div id="rental-calendar-fragment">
            {% include '@rental/public/_calendar.html.twig' %}
        </div>

        <div id="rental-estimate-fragment">
            {% include '@rental/public/_estimate.html.twig' %}
        </div>

        {# ── Practical information ─────────────────────────────────────── #}
        <div class="card mb-4">
            <div class="card-body">
                <h2 class="h5 mb-3">Informations pratiques</h2>
                <dl class="row">
                    {% if asset.capacity is not null %}
                        <dt class="col-sm-4">Capacité</dt>
                        <dd class="col-sm-8">{{ asset.capacity }} personnes</dd>
                    {% endif %}
                    {% if asset.isStock %}
                        <dt class="col-sm-4">Exemplaires</dt>
                        <dd class="col-sm-8">{{ asset.quantity }}</dd>
                    {% endif %}
                    {% if asset.arrivalTime %}
                        <dt class="col-sm-4">Heure d'arrivée</dt>
                        <dd class="col-sm-8">{{ asset.arrivalTime }}</dd>
                    {% endif %}
                    {% if asset.departureTime %}
                        <dt class="col-sm-4">Heure de départ</dt>
                        <dd class="col-sm-8">{{ asset.departureTime }}</dd>
                    {% endif %}
                    {% if constraints.minNights > 0 %}
                        <dt class="col-sm-4">Durée minimum</dt>
                        <dd class="col-sm-8">{{ constraints.minNights }} nuit{{ constraints.minNights > 1 ? 's' : '' }}</dd>
                    {% endif %}
                    {% if constraints.minNoticeDays > 0 %}
                        <dt class="col-sm-4">Préavis</dt>
                        <dd class="col-sm-8">{{ constraints.minNoticeDays }} jour{{ constraints.minNoticeDays > 1 ? 's' : '' }}</dd>
                    {% endif %}
                </dl>
                {{ editable(editable_prefix ~ '_practical', '<p>Décrivez ici l\'équipement, l\'accès, le parking…</p>')|raw }}
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-body">
                <h2 class="h5 mb-3">Ce qui est inclus</h2>
                {{ editable(editable_prefix ~ '_included', '<p>Précisez ce qui est inclus et ce qui ne l\'est pas.</p>')|raw }}
            </div>
        </div>

        <div class="card">
            <div class="card-body">
                <h2 class="h5 mb-3">Conditions</h2>
                {{ editable(editable_prefix ~ '_conditions', '<p>Conditions à connaître avant d\'introduire une demande.</p>')|raw }}
            </div>
        </div>
    </div>
{% endblock %}

{% block scripts %}
    {# type="module", not a classic script: this file uses `export` so its
       pure functions can be unit-tested against the real implementation
       rather than a copy (tests/js/rental-calendar.test.js). Loaded as a
       classic script the browser rejects the whole file with a
       SyntaxError and it silently never runs — which is exactly what had
       been happening. Modules are deferred by definition. #}
    <script type="module" src="/assets/js/rental-calendar.js"></script>
{% endblock %}
