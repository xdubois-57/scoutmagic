{% extends 'base.html.twig' %}
{% block title %}Suivi {{ booking.reference }} — {{ site_name }}{% endblock %}
{#
  The renter's tracking page (§6.26), reached with a capability token and no
  account at all.

  What it shows: the asset, the dates, the status, the FULL live price
  breakdown (every line, every change, immediately), the flagged managers'
  contact details, and the emergency number.

  What it must NEVER show: internal comments, notes on a damage still being
  assessed, or any downloadable file. An external renter downloads nothing
  from the site — their contract and invoice arrive by email only.

  The URL of this page contains the token, so it is never logged and never
  shown to anyone else.
#}
{% block content %}
    <div class="page-medium">
        {% include 'partials/page_header.html.twig' with {
            title: 'Votre demande ' ~ booking.reference,
            subtitle: asset.name,
        } only %}

        <div class="card mb-4">
            <div class="card-body">
                <h2 class="h5 mb-3">Où en est votre demande</h2>
                <p class="mb-2">
                    {% include '@rental/_status_badge.html.twig' with { status: booking.status } only %}
                </p>
                {% if booking.holdUntil %}
                    <p class="mb-0">
                        {{ booking.holdLabel }} jusqu'au
                        <strong>{{ booking.holdUntil|date_fr }}</strong>.
                    </p>
                {% endif %}
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-body">
                <h2 class="h5 mb-3">Votre séjour</h2>
                <dl class="row mb-0">
                    <dt class="col-sm-4">Du</dt>
                    <dd class="col-sm-8">{{ booking.arrivalDate|date_fr }}</dd>
                    <dt class="col-sm-4">Au</dt>
                    <dd class="col-sm-8">{{ booking.departureDate|date_fr }}</dd>
                    {% if booking.estimatedPersons %}
                        <dt class="col-sm-4">Participants</dt>
                        <dd class="col-sm-8">{{ booking.estimatedPersons }}</dd>
                    {% endif %}
                    {% if asset.arrivalTime %}
                        <dt class="col-sm-4">Heure d'arrivée</dt>
                        <dd class="col-sm-8">{{ asset.arrivalTime }}</dd>
                    {% endif %}
                    {% if asset.departureTime %}
                        <dt class="col-sm-4">Heure de départ</dt>
                        <dd class="col-sm-8">{{ asset.departureTime }}</dd>
                    {% endif %}
                </dl>
            </div>
        </div>

        {% if not quote or not quote.hasPricedLine %}
            {# An asset with no tariff configured quotes every line at zero.
               Rendered as a price table that reads "Total 0,00 €", a renter
               takes it for "free" and the unit spends its first email
               walking the figure back. Saying there is no price yet is both
               true and what happens next. #}
            <div class="card mb-4">
                <div class="card-body">
                    <h2 class="h5 mb-3">Prix</h2>
                    <p class="mb-0">
                        <strong>Tarif sur demande</strong> — l'unité vous répondra avec une
                        proposition de prix.
                    </p>
                </div>
            </div>
        {% else %}
            <div class="card mb-4">
                <div class="card-body">
                    <h2 class="h5 mb-3">Détail du prix</h2>
                    <div class="table-responsive">
                    <table class="table table-sm">
                        <caption class="visually-hidden">Détail du prix de votre location</caption>
                        <thead>
                            <tr>
                                <th scope="col">Détail</th>
                                <th scope="col" class="text-end">Montant</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for line in quote.lines %}
                                <tr{{ line.isInformational ? ' class="text-body-secondary fst-italic"' : '' }}>
                                    <td>
                                        {{ line.label }}
                                        {# The arithmetic in words, same rules as the public
                                           estimate: a renter reads "5,50 € par personne et par
                                           nuit", never a bare machine quantity. #}
                                        {% if line.isInformational and line.unitPriceCents is not null %}
                                            <span class="small d-block">
                                                Facturé après le séjour selon relevé —
                                                {{ line.unitPriceCents|money_cents }}{{ line.meta.meter_unit is defined and line.meta.meter_unit ? ' / ' ~ line.meta.meter_unit : '' }}
                                            </span>
                                        {% elseif line.rule == 'base' and line.unitPriceCents is not null %}
                                            <span class="small text-body-secondary d-block">
                                                {{ line.unitPriceCents|money_cents }} {{ quote.billingUnit.pricePhrase }}
                                            </span>
                                        {% elseif line.rule == 'fee_per_person' and line.unitPriceCents is not null %}
                                            <span class="small text-body-secondary d-block">
                                                {{ line.quantity }} pers. × {{ line.unitPriceCents|money_cents }}
                                            </span>
                                        {% endif %}
                                    </td>
                                    <td class="text-end">
                                        {{ line.isInformational
                                            ? 'Selon relevé'
                                            : line.amountCents|money_cents }}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                        <tfoot>
                            <tr class="fw-semibold">
                                <th scope="row" class="text-end">Total</th>
                                <td class="text-end">{{ quote.totalCents|money_cents }}</td>
                            </tr>
                        </tfoot>
                    </table>
                    </div>
                    <p class="small text-body-secondary mb-0">
                        Ce détail reflète en permanence l'état de votre dossier.
                    </p>
                </div>
            </div>
        {% endif %}

        {#
          Change requests and the manager's proposals (§6.16).

          Nothing here changes the booking on its own — that is the whole
          rule. A request the renter sends waits for a manager; a proposal a
          manager sent waits for the renter, right here.
        #}
        {#
          « Modifier votre demande » ships FOLDED (IT-03). It used to take
          half the page for something a renter uses about once in ten
          visits, above the dates and the price they actually came for.

          One exception, and it is the whole point of the page when it
          happens: a proposal from the unit waiting for an answer opens the
          box by itself. A fold that hides the one thing somebody has to
          act on is worse than no fold.
        #}
        {# `|filter` rather than a loop with a `set` inside it: Twig scopes a
           `set` to the loop body, so the flag would always read false out
           here. #}
        {% set awaiting_renter = change_requests|filter(c => c.isPending and c.origin.value == 'manager')|length > 0 %}
        {% if change_requests is not empty or not booking.status.isFinal %}
            <div class="card mb-4" id="modifier-demande">
                <h2 class="mb-0">
                    <button type="button"
                            class="btn w-100 d-flex align-items-center gap-2 p-3 text-start{{ awaiting_renter ? '' : ' collapsed' }}"
                            data-bs-toggle="collapse" data-bs-target="#modifier-demande-body"
                            aria-expanded="{{ awaiting_renter ? 'true' : 'false' }}"
                            aria-controls="modifier-demande-body">
                        <span class="h5 mb-0 flex-grow-1">Modifier votre demande</span>
                        {% if awaiting_renter %}
                            <span class="badge text-bg-warning">Réponse attendue</span>
                        {% endif %}
                        <i class="bi bi-chevron-down text-body-tertiary" aria-hidden="true"></i>
                    </button>
                </h2>
                <div class="collapse{{ awaiting_renter ? ' show' }}" id="modifier-demande-body">
                <div class="card-body pt-0">
                    {% if change_requests is not empty %}
                        <ul class="list-unstyled">
                            {% for change in change_requests %}
                                <li class="border-bottom py-2">
                                    <div class="d-flex justify-content-between align-items-start gap-2">
                                        <span>
                                            <span class="fw-semibold">{{ change.kind.label }}</span>
                                            <span class="text-body-secondary small d-block">{{ change.summary }}</span>
                                        </span>
                                        {% include 'partials/status_badge.html.twig' with { status: change.status.value, label: change.status.label } only %}
                                    </div>
                                    {% if change.isPending and change.origin.value == 'manager' %}
                                        <p class="small mb-2">
                                            L'unité vous propose ces dates. Tant que vous n'avez pas répondu,
                                            votre réservation reste inchangée.
                                        </p>
                                        <div class="d-flex gap-2">
                                            {# Answering the unit's proposal is the point of this page
                                               whenever one is waiting, so « Accepter » is its single
                                               primary. « Refuser » closes the proposal for good and
                                               therefore asks first (§7.5). #}
                                            <form method="post" action="/locations/suivi/{{ booking.id }}/{{ tracking_token }}/reponse">
                                                {{ csrf_field()|raw }}
                                                <input type="hidden" name="request_id" value="{{ change.id }}">
                                                <input type="hidden" name="decision" value="accept">
                                                <button type="submit" class="btn btn-sm btn-primary">Accepter</button>
                                            </form>
                                            <form method="post" action="/locations/suivi/{{ booking.id }}/{{ tracking_token }}/reponse"
                                                  data-confirm="Refuser cette proposition ? Votre réservation reste telle qu'elle est, et l'unité devra vous en proposer une autre."
                                                  data-confirm-label="Refuser">
                                                {{ csrf_field()|raw }}
                                                <input type="hidden" name="request_id" value="{{ change.id }}">
                                                <input type="hidden" name="decision" value="refuse">
                                                <button type="submit" class="btn btn-sm btn-outline-secondary">Refuser</button>
                                            </form>
                                        </div>
                                    {% endif %}
                                </li>
                            {% endfor %}
                        </ul>
                    {% endif %}


                    {% if not booking.status.isFinal %}
                        {#
                          **The renter no longer picks a type of request.**
                          The form is their own booking, pre-filled; what
                          they change is what they are asking for, and
                          `ChangeRequestKind::forChange()` names it. Asking
                          for other dates AND a smaller group used to be two
                          requests, each valid only if the other was
                          accepted too.
                        #}
                        <p class="text-body-secondary small">
                            Corrigez ce qui doit changer, dites-nous pourquoi, et envoyez. Votre
                            demande est transmise aux gestionnaires : elle ne change rien tant
                            qu'ils ne l'ont pas acceptée.
                        </p>
                        <form method="post" action="/locations/suivi/{{ booking.id }}/{{ tracking_token }}/demande"
                              class="row g-2 align-items-end">
                            {{ csrf_field()|raw }}
                            <div class="col-6 col-md-3">
                                {% include 'partials/form_field.html.twig' with {
                                    field_id: 'change-arrival',
                                    field_name: 'arrival',
                                    label: 'Du',
                                    type: 'date',
                                    size: 'sm',
                                    wrapper_class: 'mb-0',
                                    value: booking.arrivalDate,
                                } only %}
                            </div>
                            <div class="col-6 col-md-3">
                                {% include 'partials/form_field.html.twig' with {
                                    field_id: 'change-departure',
                                    field_name: 'departure',
                                    label: 'Au',
                                    type: 'date',
                                    size: 'sm',
                                    wrapper_class: 'mb-0',
                                    value: booking.departureDate,
                                } only %}
                            </div>
                            <div class="col-6 col-md-3">
                                {% include 'partials/form_field.html.twig' with {
                                    field_id: 'change-persons',
                                    field_name: 'persons',
                                    label: 'Participants',
                                    type: 'number',
                                    inputmode: 'numeric',
                                    min: 1,
                                    size: 'sm',
                                    wrapper_class: 'mb-0',
                                    value: booking.estimatedPersons,
                                } only %}
                            </div>
                            <div class="col-12">
                                {% include 'partials/form_field.html.twig' with {
                                    field_id: 'change-message',
                                    field_name: 'message',
                                    label: 'Pourquoi ce changement',
                                    type: 'textarea',
                                    rows: 2,
                                    size: 'sm',
                                    required: true,
                                    wrapper_class: 'mb-0',
                                    help: 'Une ligne suffit. Sans explication, un gestionnaire ne peut pas distinguer une demande ferme d\'une question.',
                                } only %}
                            </div>
                            <div class="col-12">
                                <button type="submit" class="btn btn-sm btn-primary">Envoyer ma demande</button>
                            </div>
                        </form>

                        {#
                          Cancelling is a button of its own, not one line of
                          a menu among « changer les dates » — which is the
                          surest way to end a stay by mistake. The word that
                          travels with it comes from the dialog, and stays
                          optional: somebody who has decided must not be
                          held up by a text field.
                        #}
                        <hr>
                        <form method="post" action="/locations/suivi/{{ booking.id }}/{{ tracking_token }}/demande"
                              data-confirm="Demander l'annulation de cette réservation ? Votre demande est transmise à l'unité ; elle ne libère les dates que lorsqu'un gestionnaire l'accepte."
                              data-confirm-label="Demander l'annulation"
                              data-confirm-note="Dire pourquoi, si vous le souhaitez (facultatif)"
                              data-confirm-note-name="message">
                            {{ csrf_field()|raw }}
                            <input type="hidden" name="demande" value="annulation">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                Demander l'annulation
                            </button>
                            <span class="form-text d-block">
                                Vos dates ne se libèrent qu'une fois l'annulation acceptée.
                            </span>
                        </form>
                    {% endif %}
                </div>
                </div>
            </div>
        {% endif %}

        {#
          **The billing coordinates, asked here and nowhere earlier**
          (§22.6). A visitor enquiring about a weekend has no reason to
          type a VAT number, and most renters never need one — so the
          public request form does not ask, and this block only appears
          once there is a booking to invoice.

          It presents itself as a task while it is empty, and folds away
          once filled: an open form over data somebody already gave reads
          as data that was not saved. A manager keeps the right to correct
          it from their side; this writes the same encrypted columns.
        #}
        {% if not booking.status.isFinal or booking.status.value == 'closed' %}
            {% set billing_is_empty = not (billing.name or billing.address or billing.vat_number
                or billing.enterprise_number or billing.email or billing.reference) %}
            <div class="card mb-4{{ billing_is_empty ? ' border-primary' }}" id="facturation">
                <h2 class="mb-0">
                    <button type="button"
                            class="btn w-100 d-flex align-items-center gap-2 p-3 text-start{{ billing_is_empty ? '' : ' collapsed' }}"
                            data-bs-toggle="collapse" data-bs-target="#facturation-body"
                            aria-expanded="{{ billing_is_empty ? 'true' : 'false' }}"
                            aria-controls="facturation-body">
                        <span class="h5 mb-0 flex-grow-1">Vos coordonnées de facturation</span>
                        <span class="text-body-secondary small">
                            {{ billing_is_empty ? 'À compléter' : 'Enregistrées' }}
                        </span>
                        <i class="bi bi-chevron-down text-body-tertiary" aria-hidden="true"></i>
                    </button>
                </h2>
                <div class="collapse{{ billing_is_empty ? ' show' }}" id="facturation-body">
                    <div class="card-body pt-0">
                        <p class="text-body-secondary small">
                            Utiles seulement si votre facture doit être établie au nom d'une
                            association ou d'une société. Un particulier peut laisser ces champs
                            vides. Tout est chiffré et n'est lu que par les gestionnaires du bien.
                        </p>
                        <form method="post" action="/locations/suivi/{{ booking.id }}/{{ tracking_token }}/facturation"
                              class="row g-2">
                            {{ csrf_field()|raw }}
                            <div class="col-12 col-md-6">
                                <label class="form-label" for="renter-billing-name">Raison sociale</label>
                                <input type="text" class="form-control form-control-sm" id="renter-billing-name"
                                       name="billing_name" value="{{ billing.name }}">
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label" for="renter-billing-email">Email de facturation</label>
                                <input type="email" class="form-control form-control-sm" id="renter-billing-email"
                                       name="billing_email" value="{{ billing.email }}">
                            </div>
                            <div class="col-12 col-md-8">
                                <label class="form-label" for="renter-billing-address">Adresse</label>
                                <input type="text" class="form-control form-control-sm" id="renter-billing-address"
                                       name="billing_address" value="{{ billing.address }}">
                            </div>
                            <div class="col-6 col-md-4">
                                <label class="form-label" for="renter-billing-country">Pays</label>
                                <input type="text" class="form-control form-control-sm" id="renter-billing-country"
                                       name="billing_country" maxlength="2" placeholder="BE"
                                       value="{{ billing.country }}"
                                       aria-describedby="renter-billing-country-help">
                                <div class="form-text" id="renter-billing-country-help">Deux lettres, par exemple BE.</div>
                            </div>
                            <div class="col-6 col-md-4">
                                <label class="form-label" for="renter-billing-vat">Numéro de TVA</label>
                                <input type="text" class="form-control form-control-sm" id="renter-billing-vat"
                                       name="billing_vat_number" value="{{ billing.vat_number }}">
                            </div>
                            <div class="col-6 col-md-4">
                                <label class="form-label" for="renter-billing-enterprise">Numéro d'entreprise</label>
                                <input type="text" class="form-control form-control-sm" id="renter-billing-enterprise"
                                       name="billing_enterprise_number" value="{{ billing.enterprise_number }}">
                            </div>
                            <div class="col-12 col-md-4">
                                <label class="form-label" for="renter-billing-reference">Votre référence</label>
                                <input type="text" class="form-control form-control-sm" id="renter-billing-reference"
                                       name="billing_reference" value="{{ billing.reference }}"
                                       aria-describedby="renter-billing-reference-help">
                                <div class="form-text" id="renter-billing-reference-help">
                                    Un numéro de bon de commande, si votre comptabilité en demande un.
                                </div>
                            </div>
                            <div class="col-12">
                                <button type="submit" class="btn btn-sm btn-outline-secondary">Enregistrer</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        {% endif %}

        {% if ics_available %}
            <p class="mb-4">
                <a href="/locations/suivi/{{ booking.id }}/{{ tracking_token }}/calendrier.ics"
                   class="btn btn-sm btn-outline-secondary">
                    Ajouter à mon agenda (.ics)
                </a>
                <span class="form-text d-block">
                    Ce lien contient votre code d'accès : ne le partagez qu'avec les personnes concernées.
                </span>
            </p>
        {% endif %}

        {% if renter_contacts is not empty or emergency_phone %}
            <div class="card">
                <div class="card-body">
                    <h2 class="h5 mb-3">Vos contacts</h2>
                    {#
                      Only the managers explicitly flagged as renter contacts
                      reach this list — the filter is in SQL, never here
                      (§6.3, §6.6). No manager's name, email or phone is ever
                      shown on a public page.
                    #}
                    {% if renter_contacts is not empty %}
                        <ul class="list-unstyled mb-2">
                            {% for contact in renter_contacts %}
                                <li class="mb-2">
                                    <strong>{{ contact.display_name }}</strong>
                                    {% if contact.email %}
                                        <br><a href="mailto:{{ contact.email }}">{{ contact.email }}</a>
                                    {% endif %}
                                    {% if contact.phone %}
                                        <br><a href="tel:{{ contact.phone|replace({' ': ''}) }}">{{ contact.phone }}</a>
                                    {% endif %}
                                </li>
                            {% endfor %}
                        </ul>
                    {% endif %}
                    {% if emergency_phone %}
                        <p class="mb-0">
                            <strong>Numéro d'urgence pendant votre séjour</strong> : {{ emergency_phone }}
                        </p>
                    {% endif %}
                </div>
            </div>
        {% endif %}
    </div>
{% endblock %}

{% block scripts %}
    {# Opens the folded box a fragment points at — « #facturation » from an
       email, « #modifier-demande » from anywhere. #}
    <script src="{{ asset('/assets/js/collapse-anchor.js') }}" defer></script>
{% endblock %}
