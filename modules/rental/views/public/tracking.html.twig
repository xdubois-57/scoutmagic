{% extends 'base.html.twig' %}
{% block title %}Suivi {{ booking.reference }} — {{ site_name }}{% endblock %}
{#
  The renter's tracking page (§6.26), reached with a capability token and no
  account at all.

  What it shows: the asset, the dates, the status, the FULL live price
  breakdown (every line, every change, immediately), the flagged managers'
  contact details, and the emergency number.

  What it must NEVER show: internal comments, notes on a damage still being
  assessed, or any downloadable file. An external renter downloads nothing
  from the site — their contract and invoice arrive by email only.

  The URL of this page contains the token, so it is never logged and never
  shown to anyone else.
#}
{% block content %}
    <div class="page-medium">
        {% include 'partials/page_header.html.twig' with {
            title: 'Votre demande ' ~ booking.reference,
            subtitle: asset.name,
        } only %}

        <div class="card mb-4">
            <div class="card-body">
                <h2 class="h5 mb-3">Où en est votre demande</h2>
                <p class="mb-2">
                    {% include '@rental/_status_badge.html.twig' with { status: booking.status } only %}
                </p>
                {% if booking.holdUntil %}
                    <p class="mb-0">
                        {{ booking.holdLabel }} jusqu'au
                        <strong>{{ booking.holdUntil|date_fr }}</strong>.
                    </p>
                {% endif %}
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-body">
                <h2 class="h5 mb-3">Votre séjour</h2>
                <dl class="row mb-0">
                    <dt class="col-sm-4">Du</dt>
                    <dd class="col-sm-8">{{ booking.arrivalDate|date_fr }}</dd>
                    <dt class="col-sm-4">Au</dt>
                    <dd class="col-sm-8">{{ booking.departureDate|date_fr }}</dd>
                    {% if booking.estimatedPersons %}
                        <dt class="col-sm-4">Participants</dt>
                        <dd class="col-sm-8">{{ booking.estimatedPersons }}</dd>
                    {% endif %}
                    {% if asset.arrivalTime %}
                        <dt class="col-sm-4">Heure d'arrivée</dt>
                        <dd class="col-sm-8">{{ asset.arrivalTime }}</dd>
                    {% endif %}
                    {% if asset.departureTime %}
                        <dt class="col-sm-4">Heure de départ</dt>
                        <dd class="col-sm-8">{{ asset.departureTime }}</dd>
                    {% endif %}
                </dl>
            </div>
        </div>

        {% if not quote or not quote.hasPricedLine %}
            {# An asset with no tariff configured quotes every line at zero.
               Rendered as a price table that reads "Total 0,00 €", a renter
               takes it for "free" and the unit spends its first email
               walking the figure back. Saying there is no price yet is both
               true and what happens next. #}
            <div class="card mb-4">
                <div class="card-body">
                    <h2 class="h5 mb-3">Prix</h2>
                    <p class="mb-0">
                        <strong>Tarif sur demande</strong> — l'unité vous répondra avec une
                        proposition de prix.
                    </p>
                </div>
            </div>
        {% else %}
            <div class="card mb-4">
                <div class="card-body">
                    <h2 class="h5 mb-3">Détail du prix</h2>
                    <div class="table-responsive">
                    <table class="table table-sm">
                        <caption class="visually-hidden">Détail du prix de votre location</caption>
                        <thead>
                            <tr>
                                <th scope="col">Détail</th>
                                <th scope="col" class="text-end">Montant</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for line in quote.lines %}
                                <tr{{ line.isInformational ? ' class="text-body-secondary fst-italic"' : '' }}>
                                    <td>
                                        {{ line.label }}
                                        {# The arithmetic in words, same rules as the public
                                           estimate: a renter reads "5,50 € par personne et par
                                           nuit", never a bare machine quantity. #}
                                        {% if line.isInformational and line.unitPriceCents is not null %}
                                            <span class="small d-block">
                                                Facturé après le séjour selon relevé —
                                                {{ line.unitPriceCents|money_cents }}{{ line.meta.meter_unit is defined and line.meta.meter_unit ? ' / ' ~ line.meta.meter_unit : '' }}
                                            </span>
                                        {% elseif line.rule == 'base' and line.unitPriceCents is not null %}
                                            <span class="small text-body-secondary d-block">
                                                {{ line.unitPriceCents|money_cents }} {{ quote.billingUnit.pricePhrase }}
                                            </span>
                                        {% elseif line.rule == 'fee_per_person' and line.unitPriceCents is not null %}
                                            <span class="small text-body-secondary d-block">
                                                {{ line.quantity }} pers. × {{ line.unitPriceCents|money_cents }}
                                            </span>
                                        {% endif %}
                                    </td>
                                    <td class="text-end">
                                        {{ line.isInformational
                                            ? 'Selon relevé'
                                            : line.amountCents|money_cents }}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                        <tfoot>
                            <tr class="fw-semibold">
                                <th scope="row" class="text-end">Total</th>
                                <td class="text-end">{{ quote.totalCents|money_cents }}</td>
                            </tr>
                        </tfoot>
                    </table>
                    </div>
                    <p class="small text-body-secondary mb-0">
                        Ce détail reflète en permanence l'état de votre dossier.
                    </p>
                </div>
            </div>
        {% endif %}

        {#
          Change requests and the manager's proposals (§6.16).

          Nothing here changes the booking on its own — that is the whole
          rule. A request the renter sends waits for a manager; a proposal a
          manager sent waits for the renter, right here.
        #}
        {% if change_requests is not empty or not booking.status.isFinal %}
            <div class="card mb-4">
                <div class="card-body">
                    <h2 class="h5 mb-2">Modifier votre demande</h2>

                    {% if change_requests is not empty %}
                        <ul class="list-unstyled">
                            {% for change in change_requests %}
                                <li class="border-bottom py-2">
                                    <div class="d-flex justify-content-between align-items-start gap-2">
                                        <span>
                                            <span class="fw-semibold">{{ change.kind.label }}</span>
                                            <span class="text-body-secondary small d-block">{{ change.summary }}</span>
                                        </span>
                                        {% include 'partials/status_badge.html.twig' with { status: change.status.value, label: change.status.label } only %}
                                    </div>
                                    {% if change.isPending and change.origin.value == 'manager' %}
                                        <p class="small mb-2">
                                            L'unité vous propose ces dates. Tant que vous n'avez pas répondu,
                                            votre réservation reste inchangée.
                                        </p>
                                        <div class="d-flex gap-2">
                                            {# Answering the unit's proposal is the point of this page
                                               whenever one is waiting, so « Accepter » is its single
                                               primary. « Refuser » closes the proposal for good and
                                               therefore asks first (§7.5). #}
                                            <form method="post" action="/locations/suivi/{{ booking.id }}/{{ tracking_token }}/reponse">
                                                {{ csrf_field()|raw }}
                                                <input type="hidden" name="request_id" value="{{ change.id }}">
                                                <input type="hidden" name="decision" value="accept">
                                                <button type="submit" class="btn btn-sm btn-primary">Accepter</button>
                                            </form>
                                            <form method="post" action="/locations/suivi/{{ booking.id }}/{{ tracking_token }}/reponse"
                                                  data-confirm="Refuser cette proposition ? Votre réservation reste telle qu'elle est, et l'unité devra vous en proposer une autre."
                                                  data-confirm-label="Refuser">
                                                {{ csrf_field()|raw }}
                                                <input type="hidden" name="request_id" value="{{ change.id }}">
                                                <input type="hidden" name="decision" value="refuse">
                                                <button type="submit" class="btn btn-sm btn-outline-secondary">Refuser</button>
                                            </form>
                                        </div>
                                    {% endif %}
                                </li>
                            {% endfor %}
                        </ul>
                    {% endif %}

                    {% if not booking.status.isFinal %}
                        <p class="text-body-secondary small">
                            Vous pouvez demander d'autres dates, un autre nombre de participants, ou
                            l'annulation. Votre demande est transmise aux gestionnaires : elle ne
                            change rien tant qu'ils ne l'ont pas acceptée.
                        </p>
                        <form method="post" action="/locations/suivi/{{ booking.id }}/{{ tracking_token }}/demande"
                              class="row g-2 align-items-end">
                            {{ csrf_field()|raw }}
                            <div class="col-12 col-md-4">
                                {% include 'partials/form_field.html.twig' with {
                                    field_id: 'change-kind',
                                    field_name: 'kind',
                                    label: 'Votre demande',
                                    type: 'select',
                                    size: 'sm',
                                    wrapper_class: 'mb-0',
                                    options: [
                                        { value: 'dates', label: 'Changer les dates' },
                                        { value: 'persons', label: 'Changer le nombre de participants' },
                                        { value: 'cancellation', label: 'Annuler ma demande' },
                                    ],
                                } only %}
                            </div>
                            <div class="col-6 col-md-2">
                                {% include 'partials/form_field.html.twig' with {
                                    field_id: 'change-arrival',
                                    field_name: 'arrival',
                                    label: 'Du',
                                    type: 'date',
                                    size: 'sm',
                                    wrapper_class: 'mb-0',
                                } only %}
                            </div>
                            <div class="col-6 col-md-2">
                                {% include 'partials/form_field.html.twig' with {
                                    field_id: 'change-departure',
                                    field_name: 'departure',
                                    label: 'Au',
                                    type: 'date',
                                    size: 'sm',
                                    wrapper_class: 'mb-0',
                                } only %}
                            </div>
                            <div class="col-6 col-md-2">
                                {% include 'partials/form_field.html.twig' with {
                                    field_id: 'change-persons',
                                    field_name: 'persons',
                                    label: 'Participants',
                                    type: 'number',
                                    inputmode: 'numeric',
                                    min: 1,
                                    size: 'sm',
                                    wrapper_class: 'mb-0',
                                } only %}
                            </div>
                            <div class="col-12">
                                {% include 'partials/form_field.html.twig' with {
                                    field_id: 'change-message',
                                    field_name: 'message',
                                    label: 'Message',
                                    type: 'textarea',
                                    rows: 2,
                                    size: 'sm',
                                    wrapper_class: 'mb-0',
                                } only %}
                            </div>
                            <div class="col-12">
                                <button type="submit" class="btn btn-sm btn-outline-secondary">Envoyer ma demande</button>
                            </div>
                        </form>
                    {% endif %}
                </div>
            </div>
        {% endif %}

        {% if ics_available %}
            <p class="mb-4">
                <a href="/locations/suivi/{{ booking.id }}/{{ tracking_token }}/calendrier.ics"
                   class="btn btn-sm btn-outline-secondary">
                    Ajouter à mon agenda (.ics)
                </a>
                <span class="form-text d-block">
                    Ce lien contient votre code d'accès : ne le partagez qu'avec les personnes concernées.
                </span>
            </p>
        {% endif %}

        {% if renter_contacts is not empty or emergency_phone %}
            <div class="card">
                <div class="card-body">
                    <h2 class="h5 mb-3">Vos contacts</h2>
                    {#
                      Only the managers explicitly flagged as renter contacts
                      reach this list — the filter is in SQL, never here
                      (§6.3, §6.6). No manager's name, email or phone is ever
                      shown on a public page.
                    #}
                    {% if renter_contacts is not empty %}
                        <ul class="list-unstyled mb-2">
                            {% for contact in renter_contacts %}
                                <li class="mb-2">
                                    <strong>{{ contact.display_name }}</strong>
                                    {% if contact.email %}
                                        <br><a href="mailto:{{ contact.email }}">{{ contact.email }}</a>
                                    {% endif %}
                                    {% if contact.phone %}
                                        <br><a href="tel:{{ contact.phone|replace({' ': ''}) }}">{{ contact.phone }}</a>
                                    {% endif %}
                                </li>
                            {% endfor %}
                        </ul>
                    {% endif %}
                    {% if emergency_phone %}
                        <p class="mb-0">
                            <strong>Numéro d'urgence pendant votre séjour</strong> : {{ emergency_phone }}
                        </p>
                    {% endif %}
                </div>
            </div>
        {% endif %}
    </div>
{% endblock %}
