{#
  "Votre séjour": the dates, the head count, and the price estimate they
  produce.

  Its own partial for the same reason as the calendar beside it: pressing
  « Estimer » fetches this fragment and swaps it in rather than reloading the
  whole page. The <form> is a real GET form and still works untouched with
  JavaScript absent, which is the fallback.

  Three rules this block enforces (§6.7):
  - pressing « Estimer » ALWAYS answers something — the hidden `estimate`
    marker is how the server can tell "the button was pressed with no dates"
    from "the visitor just arrived", and the first deserves an explanation
    where the second deserves an invitation;
  - an asset with no configured rate never shows "0,00 €" as if it were a
    price: it says "tarif sur demande" and keeps the way to the request form
    open;
  - a price line explains its own arithmetic in words ("5,50 € par personne
    et par nuit"), never as a bare machine quantity ("75").

  Requires `asset`, `calendar_month`, `selection`, `form_persons`,
  `form_units`, `form_category`, `categories`, `has_tariff`,
  `estimate_requested` and `estimate`.
#}
{# ── Selection summary and estimate ────────────────────────────── #}
<div class="card mb-4">
    <div class="card-body">
        <h2 class="h5 mb-3">Votre séjour</h2>

        <form method="get" class="row g-2 align-items-end mb-3">
            <input type="hidden" name="month" value="{{ calendar_month }}">
            <input type="hidden" name="estimate" value="1">
            <div class="col-6 col-md-3">
                <label class="form-label" for="arrival">Arrivée</label>
                <input type="date" class="form-control" id="arrival" name="arrival"
                       value="{{ selection ? selection[0] : '' }}">
            </div>
            <div class="col-6 col-md-3">
                <label class="form-label" for="departure">Départ</label>
                <input type="date" class="form-control" id="departure" name="departure"
                       value="{{ selection and selection[1] ? selection[1] : '' }}">
            </div>
            <div class="col-4 col-md-2">
                <label class="form-label" for="persons">Participants</label>
                <input type="number" min="0" class="form-control" id="persons" name="persons"
                       value="{{ form_persons }}">
            </div>
            {% if asset.isStock %}
                <div class="col-4 col-md-2">
                    <label class="form-label" for="units">Quantité</label>
                    <input type="number" min="1" max="{{ asset.quantity }}" class="form-control"
                           id="units" name="units" value="{{ form_units }}">
                </div>
            {% endif %}
            {% if categories is not empty %}
                <div class="col-4 col-md-2">
                    <label class="form-label" for="category">Vous êtes</label>
                    <select class="form-select" id="category" name="category">
                        <option value="">—</option>
                        {% for category in categories %}
                            <option value="{{ category.id }}"
                                    {{ form_category == category.id ? 'selected' : '' }}>{{ category.label }}</option>
                        {% endfor %}
                    </select>
                </div>
            {% endif %}
            <div class="col-12 col-md-2">
                <button type="submit" class="btn btn-primary w-100">Estimer</button>
            </div>
        </form>

        {% if estimate %}
            {% for error in estimate.errors %}
                <div class="alert alert-warning py-2 small">{{ error }}</div>
            {% endfor %}
        {% endif %}

        {% set request_url = '/locations/' ~ asset.slug ~ '/demande'
            ~ (selection ? '?arrival=' ~ selection[0] ~ (selection[1] ? '&departure=' ~ selection[1] : '') : '')
            ~ (selection and form_persons ? '&persons=' ~ form_persons : '')
            ~ (selection and form_units > 1 ? '&units=' ~ form_units : '')
            ~ (selection and form_category ? '&category=' ~ form_category : '') %}

        {% if not has_tariff %}
            {#
              No rate configured at all. An empty table adding up to
              « Dès 0,00 € » read as a price of zero; this says what is
              actually true and keeps the visitor moving (§6.7).
            #}
            <div class="alert alert-info py-2">
                <strong>Tarif sur demande.</strong> L'unité n'a pas encore publié de tarif en ligne
                pour ce bien : introduisez votre demande, elle vous répondra avec une proposition
                de prix.
            </div>
            <a class="btn btn-primary" href="{{ request_url }}">Introduire une demande</a>
        {% elseif estimate %}
            {% set quote = estimate.quote %}
            <table class="table table-sm">
                <caption class="visually-hidden">Détail du prix estimé</caption>
                <thead>
                    <tr>
                        <th scope="col">Détail</th>
                        <th scope="col" class="text-end">Montant</th>
                    </tr>
                </thead>
                <tbody>
                    {% for line in quote.lines %}
                        <tr{{ line.isInformational ? ' class="text-body-secondary fst-italic"' : '' }}>
                            <td>
                                {{ line.label }}
                                {#
                                  The arithmetic in words, not the engine's
                                  quantity: "75" for 25 people × 3 nights
                                  explains nothing to a visitor.
                                #}
                                {% if line.isInformational and line.unitPriceCents is not null %}
                                    <span class="small d-block">
                                        Facturé après le séjour selon relevé —
                                        {{ line.unitPriceCents|money_cents }}{{ line.meta.meter_unit is defined and line.meta.meter_unit ? ' / ' ~ line.meta.meter_unit : '' }}
                                    </span>
                                {% elseif line.rule == 'base' and line.unitPriceCents is not null %}
                                    <span class="small text-body-secondary d-block">
                                        {{ line.unitPriceCents|money_cents }} {{ quote.billingUnit.pricePhrase }}
                                    </span>
                                {% elseif line.rule == 'fee_per_person' and line.unitPriceCents is not null %}
                                    <span class="small text-body-secondary d-block">
                                        {{ line.quantity }} pers. × {{ line.unitPriceCents|money_cents }}
                                    </span>
                                {% endif %}
                            </td>
                            <td class="text-end">
                                {{ line.isInformational
                                    ? 'Selon relevé'
                                    : line.amountCents|money_cents }}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
                <tfoot>
                    <tr class="fw-semibold">
                        <th scope="row" class="text-end">
                            {# "dès X €" whenever something needed is still
                               missing — never a firm figure we would have
                               to walk back (§6.7). #}
                            {{ quote.isComplete ? 'Total estimé' : 'Dès' }}
                        </th>
                        <td class="text-end">{{ quote.totalCents|money_cents }}</td>
                    </tr>
                </tfoot>
            </table>

            {% for warning in quote.warnings %}
                <p class="small text-body-secondary mb-1">{{ warning }}</p>
            {% endfor %}

            <p class="small text-body-secondary mb-2">
                Estimation indicative, sans engagement.
            </p>

            {#
              The way into the request form (§6.13). Placed after the
              estimate rather than beside the calendar on purpose: a
              visitor should see what it costs before they are asked
              for their name, and the dates they chose travel with
              them so they do not retype what they just picked.
            #}
            <a class="btn btn-primary" href="{{ request_url }}">Introduire une demande</a>
        {% else %}
            {% if selection and selection[1] is null %}
                {#
                  Mid-selection: say what the next tap is instead of
                  repeating the generic invitation — the two-tap gesture is
                  not obvious, and this is the moment to teach it.
                #}
                <p class="text-body-secondary mb-2">
                    Arrivée le <strong>{{ selection[0]|date_fr }}</strong> — touchez maintenant
                    votre jour de départ dans le calendrier, ou indiquez-le ci-dessus.
                </p>
            {% elseif estimate_requested %}
                {# « Estimer » was pressed with no usable dates. Answering
                   nothing here is what made the button look broken. #}
                <div class="alert alert-warning py-2 small">
                    Indiquez une date d'arrivée et une date de départ — dans le calendrier ou dans
                    les champs ci-dessus — pour obtenir une estimation.
                </div>
            {% else %}
                <p class="text-body-secondary fst-italic mb-2">
                    Touchez votre jour d'arrivée puis votre jour de départ dans le calendrier
                    pour obtenir une estimation.
                </p>
            {% endif %}

            {#
              Offered here too, not only after an estimate: somebody
              who already knows what they want should not have to
              price it first, and a page whose only way forward is a
              form they did not ask for is a dead end.
            #}
            <a class="btn btn-outline-primary" href="{{ request_url }}">Introduire une demande</a>
        {% endif %}
    </div>
</div>
