{% extends 'base.html.twig' %}
{% block title %}Demande de location — {{ asset.name }} — {{ site_name }}{% endblock %}
{#
  The public request form (§6.13).

  Protected by Core\Security\HumanCheck (never an external captcha) and by
  CSRF. Billing details are NOT asked for here — they are collected later in
  the workflow, when they are actually relevant.

  Phone and purpose are required, in the browser AND in
  Service\RentalBookingService (§22.5): a `required` attribute is a
  convenience for the visitor, never a guarantee to the unit. The
  organisation is not, and deliberately: a family letting the hall for a
  communion has none.

  The two tick-boxes are distinct and both required. The second is worded as
  an acknowledgement, NOT as consent: the processing is necessary to the
  booking, and calling it consent would misrepresent the legal basis.
#}
{% block content %}
    <div class="page-medium">
        {% include 'partials/page_header.html.twig' with {
            title: 'Demande de location — ' ~ asset.name,
        } only %}

        {% for error in errors %}
            <div class="alert alert-danger" role="alert">{{ error }}</div>
        {% endfor %}

        <form method="post" action="/locations/{{ asset.slug }}/demande">
            {{ csrf_field()|raw }}

            <fieldset class="mb-4">
                <legend class="h5">Votre séjour</legend>
                <div class="row g-3">
                    <div class="col-6">
                        {% include 'partials/form_field.html.twig' with {
                            field_id: 'arrival', field_name: 'arrival', type: 'date',
                            label: 'Arrivée', required: true,
                            value: submitted.arrival,
                        } only %}
                    </div>
                    <div class="col-6">
                        {% include 'partials/form_field.html.twig' with {
                            field_id: 'departure', field_name: 'departure', type: 'date',
                            label: 'Départ', required: true,
                            value: submitted.departure,
                        } only %}
                    </div>
                    <div class="col-6">
                        {% include 'partials/form_field.html.twig' with {
                            field_id: 'persons', field_name: 'persons', type: 'number',
                            label: 'Nombre de participants', min: 1, inputmode: 'numeric',
                            help: 'Une estimation suffit à ce stade.',
                            value: submitted.persons,
                        } only %}
                    </div>
                    {% if asset.isStock %}
                        <div class="col-6">
                            {% include 'partials/form_field.html.twig' with {
                                field_id: 'units', field_name: 'units', type: 'number',
                                label: 'Quantité', min: 1, max: asset.quantity, inputmode: 'numeric',
                                value: submitted.units ?: 1,
                            } only %}
                        </div>
                    {% endif %}
                    {% if categories is not empty %}
                        <div class="col-6">
                            {% include 'partials/form_field.html.twig' with {
                                field_id: 'category', field_name: 'category', type: 'select',
                                label: 'Vous êtes',
                                options: [{ value: '', label: '—' }]|merge(categories|map(c => {
                                    value: c.id,
                                    label: c.label,
                                    selected: submitted.category == c.id,
                                })),
                            } only %}
                        </div>
                    {% endif %}
                </div>
            </fieldset>

            <fieldset class="mb-4">
                <legend class="h5">Vos coordonnées</legend>
                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        {% include 'partials/form_field.html.twig' with {
                            field_id: 'name', field_name: 'name',
                            label: 'Nom', required: true, autocomplete: 'name',
                            value: submitted.name,
                        } only %}
                    </div>
                    <div class="col-12 col-md-6">
                        {% include 'partials/form_field.html.twig' with {
                            field_id: 'email', field_name: 'email', type: 'email',
                            label: 'Email', required: true, autocomplete: 'email',
                            value: submitted.email,
                        } only %}
                    </div>
                    <div class="col-12 col-md-6">
                        {% include 'partials/form_field.html.twig' with {
                            field_id: 'phone', field_name: 'phone', type: 'tel',
                            label: 'Téléphone', required: true, autocomplete: 'tel',
                            placeholder: '0470 12 34 56',
                            help: 'Pour vous joindre si quelque chose se décide vite.',
                            value: submitted.phone,
                        } only %}
                    </div>
                    <div class="col-12 col-md-6">
                        {% include 'partials/form_field.html.twig' with {
                            field_id: 'organisation', field_name: 'organisation',
                            label: 'Organisation',
                            placeholder: 'Unité du Petit Ry SV025',
                            help: 'Facultatif. Beaucoup d\'unités appliquent un tarif différent selon qui loue.',
                            value: submitted.organisation,
                        } only %}
                    </div>
                    <div class="col-12">
                        {% include 'partials/form_field.html.twig' with {
                            field_id: 'purpose', field_name: 'purpose',
                            label: 'Objet de la location', required: true,
                            placeholder: 'Week-end de section',
                            value: submitted.purpose,
                        } only %}
                    </div>
                    <div class="col-12">
                        {% include 'partials/form_field.html.twig' with {
                            field_id: 'comment', field_name: 'comment', type: 'textarea',
                            label: 'Commentaire', rows: 3,
                            value: submitted.comment,
                        } only %}
                    </div>
                </div>
            </fieldset>

            {#
              A link, like the privacy notice below, rather than the whole text
              in a scrolling box (issue #494): the conditions have their own
              page now, which an email can point back to. The hidden field is
              the version on that page when the form was drawn — the server
              refuses a submission against any other, so the box accepts
              exactly the text the visitor could open. Never empty either:
              Document\AssetConditions falls back to the standard Belgian body.
            #}
            <input type="hidden" name="conditions_version" value="{{ conditions.version }}">
            <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox" id="accept-conditions" name="accept_conditions" required>
                <label class="form-check-label" for="accept-conditions">
                    J'accepte les <a href="/locations/{{ asset.slug }}/conditions/{{ conditions.version }}" target="_blank" rel="noopener">conditions de location</a>
                </label>
            </div>
            <div class="form-check mb-4">
                <input class="form-check-input" type="checkbox" id="accept-privacy" name="accept_privacy" required>
                <label class="form-check-label" for="accept-privacy">
                    J'ai pris connaissance de la <a href="/rgpd" target="_blank" rel="noopener">politique de confidentialité</a>
                </label>
            </div>

            {% include 'partials/human_check_fields.html.twig' with { human_check: human_check } %}

            <button type="submit" class="btn btn-primary">Envoyer ma demande</button>
        </form>
    </div>
{% endblock %}
