{% extends 'base.html.twig' %}
{% block title %}Biens à louer — {{ site_name }}{% endblock %}
{% block stylesheets %}<link rel="stylesheet" href="{{ asset('/assets/css/components.css') }}">{% endblock %}
{#
  "Espace chefs d'U > Biens à louer" — the park (issue #748).

  Three levels used to share this one column: a chip picker, the chosen
  asset's every section under it, the module's own settings, then a whole
  creation form. An asset's mailbox and the asset above it read as one
  thing. Now this page lists the assets, each with its own page, and keeps
  below the list only what belongs to the module as a whole. Creating an
  asset has its own page too, and the header's one primary action leads
  there — the pattern of « Gérer les photos ».
#}
{% macro asset_row(asset, tariff_missing_ids) %}
    <div class="card" data-asset-row="{{ asset.id }}">
        <div class="card-body d-flex flex-wrap align-items-center gap-3">
            <div class="flex-grow-1" style="min-width:0;">
                <h3 class="h6 mb-1 text-truncate">
                    <a href="/admin/locations/{{ asset.id }}">{{ asset.name }}</a>
                </h3>
                <p class="small text-body-secondary mb-0 d-flex flex-wrap align-items-center gap-2">
                    <span>{{ asset.assetType }}</span>
                    {% if asset.isArchived %}
                        <span class="badge text-bg-secondary">Archivé</span>
                    {% elseif asset.isPublic %}
                        <span class="badge bg-body-tertiary border text-body-secondary">Visible publiquement</span>
                    {% else %}
                        <span class="badge bg-body-tertiary border text-body-secondary">Non publié</span>
                    {% endif %}
                    {% if asset.id in tariff_missing_ids %}
                        <span class="badge text-bg-warning">Tarif manquant</span>
                    {% endif %}
                </p>
            </div>
            <div class="d-flex flex-wrap gap-2 flex-shrink-0">
                <a href="/admin/locations/{{ asset.id }}" class="btn btn-sm btn-outline-secondary"
                   aria-label="Éditer « {{ asset.name }} »">
                    <i class="bi bi-pencil" aria-hidden="true"></i> Éditer
                </a>
                {% if asset.isArchived %}
                    <form method="post" action="/admin/locations/restore">
                        {{ csrf_field()|raw }}
                        <input type="hidden" name="asset_id" value="{{ asset.id }}">
                        <input type="hidden" name="from" value="list">
                        <button type="submit" class="btn btn-sm btn-outline-secondary"
                                aria-label="Désarchiver « {{ asset.name }} »">Désarchiver</button>
                    </form>
                {% else %}
                    <form method="post" action="/admin/locations/archive"
                          data-confirm="Archiver « {{ asset.name }} » ? Le bien disparaît de la page publique et des écrans courants, et n'accepte plus de demande. Rien n'est supprimé.">
                        {{ csrf_field()|raw }}
                        <input type="hidden" name="asset_id" value="{{ asset.id }}">
                        <input type="hidden" name="from" value="list">
                        <button type="submit" class="btn btn-sm btn-outline-secondary"
                                aria-label="Archiver « {{ asset.name }} »">Archiver</button>
                    </form>
                {% endif %}
            </div>
        </div>
    </div>
{% endmacro %}

{% block content %}
    {% import _self as park %}
    <div class="page-medium">
        {% include 'partials/page_header.html.twig' with {
            title: 'Biens à louer',
            subtitle: "Les biens que l'unité met en location, et qui les gère. Tout le reste — règles de
                réservation, tarif, acompte, réservations, contrats, séjour — se règle depuis l'espace
                de gestion de chaque bien, accessible à ses gestionnaires. Le Staff d'U y accède
                partout, sans avoir à être désigné nulle part.",
            action_label: 'Ajouter un bien',
            action_url: '/admin/locations/nouveau',
        } only %}

        {% set active_assets = assets|filter(a => not a.isArchived) %}
        {% set archived_assets = assets|filter(a => a.isArchived) %}

        <section class="mb-5" aria-labelledby="park-heading">
            <h2 class="visually-hidden" id="park-heading">Les biens</h2>
            {% if assets is empty %}
                {# The creation action already lives in the page header above
                   (one btn-primary per screen, design.md §7.4). #}
                {% include 'partials/empty_state.html.twig' with {
                    message: "Aucun bien n'est encore configuré.",
                    icon: 'bi-house',
                } only %}
            {% else %}
                {% if active_assets is not empty %}
                    <div class="d-flex flex-column gap-2" data-active-assets>
                        {% for asset in active_assets %}
                            {{ park.asset_row(asset, tariff_missing_ids) }}
                        {% endfor %}
                    </div>
                {% endif %}

                {% if archived_assets is not empty %}
                    {# Apart, under their own heading: archived assets stay in
                       the administration but must not read as part of the
                       park in use. #}
                    <h3 class="h6 text-body-secondary mt-4 mb-2">Biens archivés</h3>
                    <div class="d-flex flex-column gap-2" data-archived-assets>
                        {% for asset in archived_assets %}
                            {{ park.asset_row(asset, tariff_missing_ids) }}
                        {% endfor %}
                    </div>
                {% endif %}
            {% endif %}
        </section>

        {# ── Ce qui concerne tout le module ───────────────────────────── #}
        {#
          Below the list and under a heading of its own, so that neither
          section reads as a property of the asset just above it — the very
          confusion the old single column produced.
        #}
        <section aria-labelledby="common-heading">
            <h2 class="h5 mb-1" id="common-heading">Pour toutes les locations</h2>
            <p class="text-body-secondary small mb-3">
                Ces réglages valent pour le module Locations dans son ensemble, pas pour un bien en
                particulier.
            </p>

            {# ── Rappels automatiques (§6.29) ────────────────────────── #}
            {# Through the shared partial since issue #248: without a
               crontab the reminders do not arrive late — they do not
               arrive (ARCHITECTURE.md §8.5). #}
            {% include 'partials/cron_warning.html.twig' with {
                cron_detected: cron_detected,
                feature: 'Les rappels automatiques (acompte non reçu, état des lieux à faire, document de conformité expirant, informations pratiques au locataire…)',
                consequence: "Un locataire peut donc arriver sans avoir jamais reçu les informations pratiques.",
            } only %}

            {# ── Courrier entrant (§7.5) ─────────────────────────────── #}
            <div class="card mb-4" id="courrier">
                <div class="card-body">
                    <h3 class="h6 mb-2">Courrier entrant</h3>

                    {% if not inbound_mail_available %}
                        <p class="text-body-secondary small mb-0">
                            Le module « Courrier entrant » n'est pas actif sur ce site. Les locations
                            fonctionnent normalement sans lui : les réponses des locataires arrivent
                            simplement dans la boîte de l'unité, sans être rattachées automatiquement
                            aux réservations.
                        </p>
                    {% elseif inbound_mailboxes is empty %}
                        {# Only the boxes in this module's scope are listed
                           (issue #748): saying « aucune boîte n'est
                           configurée » here would be false on a site whose
                           boxes all serve another module. #}
                        <p class="text-body-secondary small mb-0" data-no-rental-mailbox>
                            Aucune boîte n'est reliée au module Locations. Un superadministrateur peut en
                            dédier une aux locations, ou lui ouvrir une boîte partagée, depuis
                            <em>Configuration &gt; Courrier entrant</em>, sous « Portée ».
                        </p>
                    {% else %}
                        <p class="text-body-secondary small">
                            Les réponses reçues dans ces boîtes sont rattachées automatiquement à la
                            réservation concernée : d'abord par la référence dans le sujet, puis par la
                            conversation, puis par l'adresse de l'expéditeur dans une fenêtre de temps
                            autour du séjour. En cas d'ambiguïté, une proposition est faite, qu'un
                            gestionnaire confirme ou écarte depuis la réservation.
                            Quelles boîtes ce module lit se règle par boîte, dans
                            <em>Configuration &gt; Courrier entrant</em>, sous « Portée ».
                        </p>

                        <ul class="list-group" data-rental-mailboxes>
                            {% for mailbox in inbound_mailboxes %}
                                <li class="list-group-item d-flex flex-wrap align-items-center gap-2">
                                    {# Name and state only: the host, the port and the
                                       account stay on the superadmin page (§7.4). #}
                                    <span class="me-auto">
                                        {{ mailbox.name }}
                                        <span class="form-text">
                                            — {{ mailbox.state }}{% if not mailbox.is_enabled %}, désactivée{% endif %}
                                        </span>
                                    </span>
                                </li>
                            {% endfor %}
                        </ul>
                    {% endif %}
                </div>
            </div>
        </section>
    </div>
{% endblock %}
