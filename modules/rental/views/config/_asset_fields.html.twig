{#
  The "général" field set, shared by the edit form and the creation form so
  the two can never drift apart.

  Requires `asset` (a Modules\Rental\Repository\RentalAsset, or null when
  creating) and `type_suggestions` (string[]). `field_prefix` (optional)
  only disambiguates the `id`/`for` attributes when both forms are on the
  same page — the POST field names are identical either way, since the two
  actions read the same names.
#}
{% set p = field_prefix|default('edit') %}
<div class="row g-3 mb-3">
    <div class="col-12 col-md-6">
        {% include 'partials/form_field.html.twig' with {
            field_id: p ~ '-name', field_name: 'name',
            label: 'Nom du bien', required: true, maxlength: 150,
            value: asset ? asset.name : '',
        } only %}
    </div>
    <div class="col-12 col-md-6">
        {# A closed list, not a free field. The type is what the public index
           groups by and what a contract prints, so free text produced
           "Local", "local" and "Local scout" as three kinds of the same
           thing, and a typo was invisible until it reached a document. The
           list itself is configurable — a unit that lets out something
           nobody anticipated adds it once in « Configuration > Locations »
           rather than retyping it per asset. #}
        <label class="form-label" for="{{ p }}-asset-type">Type</label>
        <select class="form-select" id="{{ p }}-asset-type" name="asset_type" required>
            {% set current = asset ? asset.assetType : '' %}
            {% if current == '' %}
                <option value="" selected disabled>Choisissez un type…</option>
            {% endif %}
            {% for suggestion in type_suggestions %}
                <option value="{{ suggestion }}" {{ current == suggestion ? 'selected' : '' }}>
                    {{ suggestion }}
                </option>
            {% endfor %}
            {% if current != '' and current not in type_suggestions %}
                {# A type this asset was created with before the list was
                   narrowed. Kept selectable so saving the form does not
                   silently retype the asset, and flagged so somebody
                   notices. #}
                <option value="{{ current }}" selected>{{ current }} (hors liste)</option>
            {% endif %}
        </select>
        <div class="form-text">
            Pour ajouter un type, complétez la liste dans « Configuration &gt; Locations ».
        </div>
    </div>

    <div class="col-6 col-md-3">
        {% include 'partials/form_field.html.twig' with {
            field_id: p ~ '-capacity', field_name: 'capacity', type: 'number',
            min: 1, inputmode: 'numeric',
            label: 'Capacité', help: 'Nombre de personnes. Vide si sans objet.',
            value: asset and asset.capacity is not null ? asset.capacity : '',
        } only %}
    </div>
    <div class="col-6 col-md-3">
        {% include 'partials/form_field.html.twig' with {
            field_id: p ~ '-quantity', field_name: 'quantity', type: 'number',
            min: 1, inputmode: 'numeric',
            label: 'Quantité', required: true,
            help: '1 = bien unique. Plus de 1 = stock louable séparément.',
            value: asset ? asset.quantity : 1,
        } only %}
    </div>
    <div class="col-6 col-md-3">
        {% include 'partials/form_field.html.twig' with {
            field_id: p ~ '-arrival-time', field_name: 'arrival_time', type: 'time',
            label: "Heure d'arrivée",
            value: asset and asset.arrivalTime ? asset.arrivalTime : '',
        } only %}
    </div>
    <div class="col-6 col-md-3">
        {% include 'partials/form_field.html.twig' with {
            field_id: p ~ '-departure-time', field_name: 'departure_time', type: 'time',
            label: 'Heure de départ',
            value: asset and asset.departureTime ? asset.departureTime : '',
        } only %}
    </div>

    {% if asset is null %}
        {#
          Creation only: the billing unit decides the calendar, the price and
          the availability model together (§6.8), so it is a decision to make
          up front rather than a default discovered later — "forfait par
          séjour" on a hall was the first wrong thing every new asset
          carried. On an existing asset it stays where the rest of the tariff
          lives, in the asset's own managed space, so the two forms cannot
          fight over one field.

          rental-asset-defaults.js pre-selects a sensible unit when the type
          changes (a hall is usually per person per night, a trailer per full
          day) — a suggestion only, never overriding a choice already made.
        #}
        <div class="col-12 col-md-6">
            <label class="form-label" for="{{ p }}-billing-unit">Mode de location</label>
            <select class="form-select" id="{{ p }}-billing-unit" name="billing_unit"
                    data-explanation-target="{{ p }}-billing-unit-explanation">
                {% for unit in billing_units %}
                    <option value="{{ unit.value }}"
                            data-explanation="{{ unit.availabilityExplanation }}"
                            {{ unit.value == 'per_person_night' ? 'selected' : '' }}>
                        {{ unit.label }}
                    </option>
                {% endfor %}
            </select>
            <div class="form-text" id="{{ p }}-billing-unit-explanation">
                {% for unit in billing_units %}
                    {%- if unit.value == 'per_person_night' %}{{ unit.availabilityExplanation }}{% endif -%}
                {% endfor %}
            </div>
            <div class="form-text">
                Décide ensemble le calendrier, le prix et la disponibilité. Se modifie ensuite,
                avec le reste du tarif, dans les réglages du bien.
            </div>
        </div>
    {% endif %}

    <div class="col-12 col-md-6">
        {% include 'partials/form_field.html.twig' with {
            field_id: p ~ '-emergency-phone', field_name: 'emergency_phone', type: 'tel',
            label: "Téléphone d'urgence",
            help: 'Communiqué uniquement au locataire sur sa page de suivi. Jamais affiché publiquement.',
            value: asset and asset.emergencyPhone ? asset.emergencyPhone : '',
        } only %}
    </div>
</div>

{#
  The only publication switch there is. A public asset is listed on the
  /locations index — which is itself the module's single "Notre unité" menu
  entry — and reached from there; there is deliberately no per-asset menu
  entry to opt into, so this checkbox alone decides public reachability.
#}
<div class="form-check mb-3">
    <input class="form-check-input" type="checkbox" id="{{ p }}-is-public" name="is_public"
           {{ asset and asset.isPublic ? 'checked' : '' }}>
    <label class="form-check-label" for="{{ p }}-is-public">
        Rendre ce bien visible publiquement
    </label>
    <div class="form-text">
        Le bien apparaît alors sur la page « Locations » du menu « Notre unité ».
    </div>
</div>
