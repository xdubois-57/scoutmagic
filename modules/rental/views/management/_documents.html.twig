{#
  Documents attached to a booking (§6.24), on the booking's file.

  Two things worth being clear about on this panel, because both are easy to
  assume the other way:

  - "Destiné au locataire" is an EMAIL flag, not a download right. An
    external renter fetches nothing from this site — they have no account,
    and their tracking token is a capability for their own page, not a file
    credential. The only way a document reaches them is the send button
    here, and the only recourse for a lost email is pressing it again.
  - A generated document is never overwritten. Regenerating adds v2 beside
    v1, because v1 may already be signed.

  Requires `asset`, `booking`, `documents` and `uploadable_types`.
#}
<div class="card mb-4">
    <div class="card-body">
        <h2 class="h5 mb-2">Documents</h2>
        <p class="text-body-secondary small">
            Le locataire ne télécharge rien depuis le site : ses documents lui parviennent
            uniquement par email. En cas d'email perdu, renvoyez-le.
        </p>

        <div class="d-flex flex-wrap gap-2 mb-3">
            <a href="/mes-locations/{{ asset.slug }}/reservations/{{ booking.id }}/document/contract"
               class="btn btn-sm btn-outline-secondary">Rédiger le contrat</a>
            <form method="post" action="/mes-locations/document-generer" class="d-inline">
                {{ csrf_field()|raw }}
                <input type="hidden" name="asset_id" value="{{ asset.id }}">
                <input type="hidden" name="booking_id" value="{{ booking.id }}">
                <input type="hidden" name="document_type" value="contract">
                <button type="submit" class="btn btn-sm btn-outline-secondary">Générer le contrat</button>
            </form>
            <a href="/mes-locations/{{ asset.slug }}/reservations/{{ booking.id }}/document/invoice"
               class="btn btn-sm btn-outline-secondary">Rédiger la facture</a>
            <form method="post" action="/mes-locations/document-generer" class="d-inline">
                {{ csrf_field()|raw }}
                <input type="hidden" name="asset_id" value="{{ asset.id }}">
                <input type="hidden" name="booking_id" value="{{ booking.id }}">
                <input type="hidden" name="document_type" value="invoice">
                <button type="submit" class="btn btn-sm btn-outline-secondary">Générer la facture</button>
            </form>
        </div>

        {% if documents is empty %}
            {% include 'partials/empty_state.html.twig' with {
                message: 'Aucun document.',
                compact: true,
            } only %}
        {% else %}
            <div class="table-responsive">
                <table class="table table-sm align-middle">
                    <caption class="visually-hidden">Documents de la réservation</caption>
                    <thead>
                        <tr>
                            <th scope="col">Document</th>
                            <th scope="col">Ajouté</th>
                            <th scope="col">Envoi</th>
                            <th scope="col"><span class="visually-hidden">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for document in documents %}
                            <tr>
                                <td>
                                    {{ document.label }}
                                    {% if document.isForRenter %}
                                        <span class="badge bg-body-tertiary border text-body-secondary ms-1"
                                              title="Sera joint à un email — jamais téléchargeable par le locataire">
                                            Destiné au locataire
                                        </span>
                                    {% endif %}
                                    <span class="text-body-secondary small d-block">{{ document.originalName }}</span>
                                </td>
                                <td class="small">{{ document.createdAt|date_fr }}</td>
                                <td class="small">
                                    {% if document.hasBeenSent %}
                                        Envoyé le {{ document.sentAt|date_fr }}
                                    {% else %}
                                        <span class="text-body-secondary">Jamais</span>
                                    {% endif %}
                                </td>
                                <td class="text-end">
                                    <div class="d-flex flex-wrap gap-1 justify-content-end">
                                        <a href="{{ file_url(document.fileId) }}"
                                           class="btn btn-sm btn-outline-secondary">Ouvrir</a>
                                        {% if document.isForRenter %}
                                            <form method="post" action="/mes-locations/document-envoyer" class="d-inline">
                                                {{ csrf_field()|raw }}
                                                <input type="hidden" name="asset_id" value="{{ asset.id }}">
                                                <input type="hidden" name="booking_id" value="{{ booking.id }}">
                                                <input type="hidden" name="document_id" value="{{ document.id }}">
                                                <button type="submit" class="btn btn-sm btn-outline-secondary">
                                                    {{ document.hasBeenSent ? 'Renvoyer' : 'Envoyer' }}
                                                </button>
                                            </form>
                                        {% endif %}
                                        {% if not document.type.isGenerated %}
                                            {# Reclassification (§6.24, §7.8): what an email
                                               attachment arriving as « Non classé » is for. A
                                               generated contract or invoice is deliberately
                                               absent — it is what the module produced, and
                                               calling it something else would break the
                                               versioning a signed v1 depends on. #}
                                            <form method="post" action="/mes-locations/document-reclasser"
                                                  class="d-inline d-flex flex-wrap gap-1 align-items-center">
                                                {{ csrf_field()|raw }}
                                                <input type="hidden" name="asset_id" value="{{ asset.id }}">
                                                <input type="hidden" name="booking_id" value="{{ booking.id }}">
                                                <input type="hidden" name="document_id" value="{{ document.id }}">
                                                <label class="visually-hidden" for="reclass-{{ document.id }}">
                                                    Reclasser
                                                </label>
                                                <select class="form-select form-select-sm w-auto"
                                                        id="reclass-{{ document.id }}" name="document_type">
                                                    {% for type in uploadable_types %}
                                                        <option value="{{ type.value }}"
                                                                {{ document.type == type ? 'selected' : '' }}>
                                                            {{ type.label }}
                                                        </option>
                                                    {% endfor %}
                                                </select>
                                                <div class="form-check form-check-inline m-0">
                                                    <input class="form-check-input" type="checkbox"
                                                           id="reclass-renter-{{ document.id }}"
                                                           name="is_for_renter"
                                                           {{ document.isForRenter ? 'checked' : '' }}>
                                                    <label class="form-check-label small"
                                                           for="reclass-renter-{{ document.id }}">
                                                        Destiné au locataire
                                                    </label>
                                                </div>
                                                <button type="submit" class="btn btn-sm btn-outline-secondary">
                                                    Reclasser
                                                </button>
                                            </form>
                                        {% endif %}
                                        <form method="post" action="/mes-locations/document-supprimer" class="d-inline"
                                              data-confirm="Supprimer « {{ document.label }} » ?">
                                            {{ csrf_field()|raw }}
                                            <input type="hidden" name="asset_id" value="{{ asset.id }}">
                                            <input type="hidden" name="booking_id" value="{{ booking.id }}">
                                            <input type="hidden" name="document_id" value="{{ document.id }}">
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Supprimer</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}

        <form method="post" action="/mes-locations/document-ajouter" enctype="multipart/form-data"
              class="row g-2 align-items-end mt-2">
            {{ csrf_field()|raw }}
            <input type="hidden" name="asset_id" value="{{ asset.id }}">
            <input type="hidden" name="booking_id" value="{{ booking.id }}">
            <div class="col-12 col-md-4">
                {% include 'partials/drop_zone.html.twig' with {
                    id: 'document-drop-zone',
                    input_id: 'document-file',
                    input_name: 'document',
                    input_label: 'Document à ajouter',
                    accept: '.pdf,image/jpeg,image/png,image/webp,image/heic',
                    message: 'Déposez le document ici, ou cliquez pour le choisir',
                    data: { 'drop-zone-for': 'document-file' },
                } only %}
                <output class="form-text d-block" id="document-drop-zone-selection"></output>
            </div>
            <div class="col-6 col-md-3">
                <label class="form-label" for="document-type">Type</label>
                <select class="form-select form-select-sm" id="document-type" name="document_type">
                    {% for type in uploadable_types %}
                        <option value="{{ type.value }}">{{ type.label }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-6 col-md-3">
                <div class="form-check mt-4">
                    <input class="form-check-input" type="checkbox" id="document-for-renter" name="is_for_renter">
                    <label class="form-check-label small" for="document-for-renter">
                        À envoyer au locataire
                    </label>
                </div>
            </div>
            <div class="col-12 col-md-2">
                <button type="submit" class="btn btn-sm btn-outline-secondary w-100">Ajouter</button>
            </div>
        </form>
    </div>
</div>

<div class="card mb-4">
    <div class="card-body">
        <h2 class="h5 mb-2">Coordonnées de facturation</h2>
        <p class="text-body-secondary small">
            Demandées au moment utile, pas au formulaire public : un visiteur qui se renseigne sur un
            week-end n'a aucune raison de taper un numéro de TVA. Tout est chiffré au repos.
        </p>
        <form method="post" action="/mes-locations/facturation" class="row g-2">
            {{ csrf_field()|raw }}
            <input type="hidden" name="asset_id" value="{{ asset.id }}">
            <input type="hidden" name="booking_id" value="{{ booking.id }}">
            <div class="col-12 col-md-6">
                <label class="form-label" for="billing-name">Raison sociale</label>
                <input type="text" class="form-control form-control-sm" id="billing-name" name="billing_name"
                       value="{{ billing.name }}">
            </div>
            <div class="col-12 col-md-6">
                <label class="form-label" for="billing-email">Email de facturation</label>
                <input type="email" class="form-control form-control-sm" id="billing-email" name="billing_email"
                       value="{{ billing.email }}">
            </div>
            <div class="col-12">
                <label class="form-label" for="billing-address">Adresse</label>
                <input type="text" class="form-control form-control-sm" id="billing-address" name="billing_address"
                       value="{{ billing.address }}">
            </div>
            <div class="col-4 col-md-2">
                <label class="form-label" for="billing-country">Pays</label>
                <input type="text" class="form-control form-control-sm" id="billing-country" name="billing_country"
                       maxlength="2" placeholder="BE" value="{{ billing.country }}">
            </div>
            <div class="col-8 col-md-3">
                <label class="form-label" for="billing-vat">N° de TVA</label>
                <input type="text" class="form-control form-control-sm" id="billing-vat" name="billing_vat_number"
                       value="{{ billing.vat_number }}">
            </div>
            <div class="col-6 col-md-3">
                <label class="form-label" for="billing-enterprise">N° BCE</label>
                <input type="text" class="form-control form-control-sm" id="billing-enterprise"
                       name="billing_enterprise_number" value="{{ billing.enterprise_number }}">
            </div>
            <div class="col-6 col-md-4">
                <label class="form-label" for="billing-reference">Référence / bon de commande</label>
                <input type="text" class="form-control form-control-sm" id="billing-reference"
                       name="billing_reference" value="{{ billing.reference }}">
            </div>
            <div class="col-12">
                <button type="submit" class="btn btn-sm btn-outline-secondary">Enregistrer</button>
            </div>
        </form>
    </div>
</div>
