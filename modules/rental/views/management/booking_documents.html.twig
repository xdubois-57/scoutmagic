{% extends '@rental/management/_booking_frame.html.twig' %}
{#
  « Documents » — the papers of one booking (Booking\BookingPage::DOCUMENTS):
  the contract, the invoice, what came back signed. The box arrives open:
  this page exists for it.

  While a modification runs (#927, chantier §2.4), and on this page only,
  a banner says so, and « Contrat » lists its replacement contract beside
  the contract in force, where its copy is countersigned or refused.
#}
{% block booking_content %}
    <div data-booking-panel="modification-banner">
        {% if progress %}
            <output class="alert alert-info d-block" data-modification-banner>
                <strong>Une modification est en cours</strong> — {{ progress.stage.label }}.
                Les dates, le nombre de participants, le prix et le contrat affichés ci-dessous restent ceux qui
                s'appliquent tant que la modification n'est pas contresignée.
                <a href="{{ booking_url }}/modifications/{{ progress.modification.id }}">Voir la modification</a>
            </output>
        {% endif %}
    </div>
    <div data-booking-panel="contracts">
        {% include '@rental/management/_contracts.html.twig' %}
    </div>
    {% include '@rental/management/_box_documents.html.twig' with { open: true } %}
{% endblock %}

{% block booking_scripts %}
    <script src="{{ asset('/assets/js/drop-zone.js') }}" defer></script>
    {# Names the file that was picked: the zone's input is visually hidden,
       so a zone that says nothing looks the same before and after a drop. #}
    <script src="{{ asset('/assets/js/upload-drop-zone.js') }}" defer></script>
    {# No `form-submit-lock.js`: the one form these panels show is sent by
       `rental-booking.js` with `fetch`, so it deliberately does not carry
       `data-submit-lock` (the reason is written above that form in
       `_documents.html.twig`) and the script would find nothing to bind
       on every view of this page. #}
{% endblock %}
