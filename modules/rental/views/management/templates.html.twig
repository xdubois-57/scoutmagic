{% extends 'base.html.twig' %}
{% block title %}Gabarits — {{ asset.name }} — {{ site_name }}{% endblock %}
{#
  The asset's Gabarits page (#708, IT-10): the documents a manager
  can word, as a LIST — contract, invoice and the rental conditions —
  each with its state and a pencil to its own page
  (template_document.html.twig, template_conditions.html.twig). Then the
  calendar publication, the meters and the inventory checklist, the last
  two edited without reloading the page.

  In the MANAGED space rather than the configuration one: the wording a
  unit lets its hall under is its managers' business, and a manager is not
  necessarily a chief (§6.4).
#}
{% block content %}
    <div class="page-medium">
        {% include 'partials/page_header.html.twig' with {
            title: 'Gabarits — ' ~ asset.name,
        } only %}

        {% include '@rental/management/_nav.html.twig' %}

        {# The same list as Documents and Conformité, without drag or bin: a
           document is neither deleted nor reordered. #}
        <div class="card mb-4">
            <div class="card-body">
                <h2 class="h5 mb-3">Documents</h2>
                {% embed 'partials/list_editor.html.twig' with {
                    list_id: 'template-list',
                    items: documents,
                    sortable: false,
                    asset: asset,
                } only %}
                    {% block item_content %}
                        <div class="d-flex flex-wrap align-items-baseline gap-2">
                            <span class="fw-semibold">{{ item.label }}</span>
                            {% if item.has_unknown_keywords %}
                                <span class="badge text-bg-warning">Mots-clés non reconnus</span>
                            {% endif %}
                        </div>
                        <div class="small text-body-secondary">
                            {{ item.state }}
                            {% if item.since %} · version en vigueur depuis le {{ item.since|date_fr }}{% endif %}
                        </div>
                    {% endblock %}
                    {% block item_edit %}
                        <a href="/mes-locations/{{ asset.slug }}/gabarits/{{ item.id }}"
                           class="btn btn-sm btn-outline-secondary"
                           aria-label="Modifier — {{ item.label }}" title="Modifier — {{ item.label }}">
                            <i class="bi bi-pencil" aria-hidden="true"></i>
                        </a>
                    {% endblock %}
                {% endembed %}
            </div>
        </div>

        {# ── Calendar publication (§6.30) ──────────────────────────── #}
        <div class="card mb-4">
            <div class="card-body">
                <h2 class="h5 mb-2">Publication dans le calendrier</h2>

                {% if not calendar_available %}
                    <p class="text-body-secondary small mb-0">
                        Le module « Calendrier » n'est pas actif sur ce site. Les locations
                        fonctionnent normalement sans lui : l'occupation reste visible sur le
                        calendrier du bien, dans cet espace.
                    </p>
                {% else %}
                    <p class="text-body-secondary small">
                        L'occupation apparaît comme <strong>événement calculé</strong> : rien n'est
                        jamais écrit dans le calendrier, la réservation reste la seule source de
                        vérité. Un lecteur ordinaire voit
                        « <em>{{ asset.name }} — loué</em> » et rien d'autre ; seuls les
                        gestionnaires du bien et le staff d'unité voient le détail. Ce n'est pas
                        configurable.
                    </p>

                    <form method="post" action="/mes-locations/calendrier-publication" class="row g-3">
                        {{ csrf_field()|raw }}
                        <input type="hidden" name="asset_id" value="{{ asset.id }}">

                        <div class="col-12">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="publication-enabled"
                                       name="publication_enabled"
                                       {{ asset.calendarPublicationEnabled ? 'checked' : '' }}>
                                <label class="form-check-label" for="publication-enabled">
                                    Publier l'occupation de ce bien dans un calendrier
                                </label>
                            </div>
                        </div>

                        <div class="col-12 col-md-6">
                            {# Checkboxes, not a single select: a hall is very
                               often both the unit's business and one section's,
                               and one choice meant the other group never saw
                               it. Labels come from the calendar module
                               (CalendarService::listSelectableCalendars) — a
                               section calendar has no name of its own.

                               No literal HTML tag in this comment, and kept
                               outside the fieldset below rather than
                               between it and its legend: Twig comments are
                               not HTML comments, so an analyser reading the
                               rendered-source text would take one for real
                               markup breaking that direct-child relationship. #}
                            <fieldset>
                                <legend class="form-label">Calendriers</legend>
                                {% if calendars is empty %}
                                    <p class="form-text mt-0">
                                        Aucun calendrier n'existe encore. Créez-en un dans
                                        « Configuration &gt; Calendrier ».
                                    </p>
                                {% else %}
                                    {% for calendar in calendars %}
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox"
                                                   id="publication-calendar-{{ calendar.id }}"
                                                   name="calendar_ids[]" value="{{ calendar.id }}"
                                                   {{ calendar.id in asset.calendarIds ? 'checked' : '' }}>
                                            <label class="form-check-label" for="publication-calendar-{{ calendar.id }}">
                                                {{ calendar.label }}
                                            </label>
                                        </div>
                                    {% endfor %}
                                    <div class="form-text">
                                        L'occupation apparaît sur chacun des calendriers cochés.
                                    </div>
                                {% endif %}
                            </fieldset>
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label" for="publication-from">Publier à partir de</label>
                            {# Each option carries its own consequence text, exactly
                               as the billing unit select does in the configuration
                               page: the server stays the single source of truth and
                               rental-publish-from.js only moves the selected one
                               into the note below. Without that the note described
                               whatever was saved, not what you had just picked. #}
                            <select class="form-select" id="publication-from" name="publish_from"
                                    data-explanation-target="publication-from-explanation">
                                {% for option in publish_from_options %}
                                    <option value="{{ option.value }}"
                                            data-explanation="{{ option.explanation }}"
                                            {{ asset.calendarPublishFrom.value == option.value ? 'selected' : '' }}>
                                        {{ option.label }}
                                    </option>
                                {% endfor %}
                            </select>
                            <div class="form-text" id="publication-from-explanation">
                                {{ asset.calendarPublishFrom.explanation }}
                            </div>
                        </div>

                        <div class="col-12">
                            <button type="submit" class="btn btn-primary">Enregistrer la publication</button>
                        </div>
                    </form>
                {% endif %}
            </div>
        </div>

        {# ── Meters (§6.22) ────────────────────────────────────────── #}
        <div class="card mb-4">
            <div class="card-body">
                <h2 class="h5 mb-2">Compteurs</h2>
                <p class="text-body-secondary small">
                    Ce qui se relève sur ce bien : électricité, eau, gaz, mazout. Un relevé est pris à
                    l'arrivée et au départ, et la différence apparaît sur le décompte final du séjour.
                </p>

                {% include '@rental/management/_meter_list.html.twig' %}
            </div>
        </div>

        {# ── Inventory checklist (§6.23) ───────────────────────────── #}
        <div class="card">
            <div class="card-body">
                <h2 class="h5 mb-2">Modèle d'état des lieux</h2>
                <p class="text-body-secondary small">
                    Copié dans chaque réservation à sa confirmation, dans cet ordre — faites glisser
                    un élément pour le déplacer. Modifier ce modèle ensuite ne change aucun état des
                    lieux déjà figé — c'est voulu : un élément renommé ne doit pas réécrire ce qui a
                    été constaté.
                </p>

                {% include '@rental/management/_inventory_list.html.twig' %}
            </div>
        </div>
    </div>
{% endblock %}

{% block scripts %}
    {# The three lists. sortable.js is the drag toolbox the inventory list
       binds; the meters and the documents are not sortable. #}
    <script src="{{ asset('/assets/js/sortable.js') }}" defer></script>
    <script src="{{ asset('/assets/js/list-editor.js') }}" defer></script>
    {# type="module": these files use `export`, and a classic <script> tag
       rejects such a file with a SyntaxError before a line of it runs — a
       failure that leaves no trace on the page itself. #}
    <script type="module" src="{{ asset('/assets/js/rental-inventory-template.js') }}"></script>
    {# Keeps the note under "Publier à partir de" describing the option
       currently selected rather than the one that happens to be saved. #}
    <script type="module" src="{{ asset('/assets/js/select-explanation.js') }}"></script>
{% endblock %}
