{#
  The payment panel on a booking's file (§6.19, §6.20).

  Two things that must never be confused, and are therefore two separate
  blocks: the RENTAL, where the deposit is a threshold on one receivable, and
  the SECURITY DEPOSIT, which is a different debt with a different
  communication and is never rental revenue.

  With Finance off, this renders one honest sentence instead of a dead panel.

  Requires `asset`, `booking` and `payment`.
#}
<div class="card mb-4">
    <div class="card-body">
        <h2 class="h5 mb-2">Paiements</h2>

        {% if not payment.available %}
            <p class="text-body-secondary small mb-0">
                Le module « Finances » n'est pas actif : aucune créance n'est créée et le suivi des
                paiements se fait hors ScoutMagic.
            </p>
        {% elseif not payment.enabled %}
            <p class="text-body-secondary small mb-0">
                Les paiements ne sont pas activés pour ce bien. Ils se configurent dans
                « Espace chefs d'U &gt; Locations ».
            </p>
        {% else %}
            <dl class="row mb-3">
                <dt class="col-sm-5">Total de la location</dt>
                <dd class="col-sm-7">
                    {% if payment.total_cents is not null %}
                        {{ payment.total_cents|money_cents }}
                    {% else %}
                        —
                    {% endif %}
                </dd>
                <dt class="col-sm-5">Reçu</dt>
                <dd class="col-sm-7">{{ payment.received_cents|money_cents }}</dd>
                <dt class="col-sm-5">Restant dû</dt>
                <dd class="col-sm-7">{{ payment.remaining_cents|money_cents }}</dd>
                {% if payment.communication %}
                    <dt class="col-sm-5">Communication</dt>
                    <dd class="col-sm-7"><code>{{ payment.communication }}</code></dd>
                {% endif %}
            </dl>

            {% if payment.deposit_cents is not null %}
                <p class="mb-3">
                    {# A threshold on the one receivable, compared live —
                       never a stored "deposit paid" flag that would spend
                       part of its life disagreeing with the account. #}
                    <span class="badge {{ payment.deposit_received ? 'bg-success' : 'bg-secondary' }}">
                        Acompte {{ payment.deposit_received ? 'reçu' : 'en attente' }}
                    </span>
                    <span class="text-body-secondary small">
                        seuil de {{ payment.deposit_cents|money_cents }}
                        {% if payment.deposit_due_date %}, attendu pour le {{ payment.deposit_due_date }}{% endif %}
                        — même communication que le solde
                    </span>
                </p>
            {% endif %}

            {% if payment.fully_paid %}
                <p class="mb-3"><span class="badge bg-success">Location intégralement payée</span></p>
            {% elseif payment.balance_due_date %}
                <p class="text-body-secondary small mb-3">Solde attendu pour le {{ payment.balance_due_date }}.</p>
            {% endif %}

            {% if payment.security_deposit.amount_cents is not null %}
                <hr>
                <h3 class="h6">Caution</h3>
                <p class="text-body-secondary small">
                    Créance distincte, communication distincte. La caution n'entre jamais dans le
                    revenu de location.
                </p>
                <dl class="row mb-3">
                    <dt class="col-sm-5">État</dt>
                    <dd class="col-sm-7">
                        <span class="badge bg-secondary">{{ payment.security_deposit.status.label }}</span>
                    </dd>
                    <dt class="col-sm-5">Montant</dt>
                    <dd class="col-sm-7">
                        {{ payment.security_deposit.amount_cents|money_cents }}
                    </dd>
                    <dt class="col-sm-5">Reçu</dt>
                    <dd class="col-sm-7">
                        {{ payment.security_deposit.received_cents|money_cents }}
                    </dd>
                    {% if payment.security_deposit.communication %}
                        <dt class="col-sm-5">Communication</dt>
                        <dd class="col-sm-7"><code>{{ payment.security_deposit.communication }}</code></dd>
                    {% endif %}
                    {% if payment.security_deposit.returned_at %}
                        <dt class="col-sm-5">Restituée le</dt>
                        <dd class="col-sm-7">
                            {{ payment.security_deposit.returned_at }} —
                            {{ payment.security_deposit.returned_cents|money_cents }}
                            {% if payment.security_deposit.withheld_cents %}
                                (retenu {{ payment.security_deposit.withheld_cents|money_cents }})
                            {% endif %}
                        </dd>
                    {% endif %}
                    {% if payment.security_deposit.note %}
                        <dt class="col-sm-5">Motif de la retenue</dt>
                        <dd class="col-sm-7">{{ payment.security_deposit.note|nl2br }}</dd>
                    {% endif %}
                </dl>

                {% if not payment.security_deposit.status.isSettled %}
                    <p class="text-body-secondary small">
                        La restitution se saisit ici, à la main : Finances rapproche les virements
                        entrants, pas les sortants. C'est une limite assumée du module, pas un oubli.
                    </p>
                    <form method="post" action="/mes-locations/caution" class="row g-2 align-items-end">
                        {{ csrf_field()|raw }}
                        <input type="hidden" name="asset_id" value="{{ asset.id }}">
                        <input type="hidden" name="booking_id" value="{{ booking.id }}">
                        <div class="col-6 col-md-3">
                            <label class="form-label" for="deposit-returned">Montant restitué (€)</label>
                            <input type="text" class="form-control form-control-sm" id="deposit-returned"
                                   name="returned" inputmode="decimal"
                                   value="{{ (payment.security_deposit.amount_cents / 100)|number_format(2, ',', '') }}">
                        </div>
                        <div class="col-6 col-md-3">
                            <label class="form-label" for="deposit-returned-at">Le</label>
                            <input type="date" class="form-control form-control-sm" id="deposit-returned-at"
                                   name="returned_at">
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label" for="deposit-note">Motif d'une retenue</label>
                            <input type="text" class="form-control form-control-sm" id="deposit-note" name="note">
                        </div>
                        <div class="col-12 col-md-2">
                            <button type="submit" class="btn btn-sm btn-outline-primary w-100">Enregistrer</button>
                        </div>
                    </form>
                {% endif %}
            {% endif %}
        {% endif %}
    </div>
</div>
