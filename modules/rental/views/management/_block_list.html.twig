{#
  The unit's periods under the managed calendar (§6.18). Its own partial
  because the calendar's gesture re-renders it: a period blocked or released
  on the grid shows up here without a reload (#708, IT-07).

  A period blocked by a gesture has no reason: it is given, and changed,
  here. Deleting a whole period stays the fastest way to free a long one.

  Requires `asset` and `blocks` (Repository\RentalBlock[]).
#}
{% if blocks is empty %}
    {% include 'partials/empty_state.html.twig' with {
        message: 'Aucune période réservée.',
        compact: true,
    } only %}
{% else %}
    <ul class="list-unstyled mb-0">
        {% for block in blocks %}
            <li class="border-bottom py-2">
                <div class="d-flex justify-content-between align-items-start gap-2">
                    <span class="fw-semibold">du {{ block.startDate|date_fr }} au {{ block.endDate|date_fr }}</span>
                    <form method="post" action="/mes-locations/blocage-supprimer"
                          data-confirm="Remettre cette période à la location ?">
                        {{ csrf_field()|raw }}
                        <input type="hidden" name="asset_id" value="{{ asset.id }}">
                        <input type="hidden" name="block_id" value="{{ block.id }}">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Supprimer</button>
                    </form>
                </div>
                <form method="post" action="/mes-locations/blocage-motif" class="d-flex gap-2 align-items-end mt-1">
                    {{ csrf_field()|raw }}
                    <input type="hidden" name="asset_id" value="{{ asset.id }}">
                    <input type="hidden" name="block_id" value="{{ block.id }}">
                    <div class="flex-grow-1">
                        {% include 'partials/form_field.html.twig' with {
                            field_id: 'block-reason-' ~ block.id, field_name: 'reason',
                            label: 'Motif', placeholder: 'Chantier toiture',
                            value: block.reason, maxlength: 255,
                            size: 'sm', wrapper_class: 'mb-0',
                        } only %}
                    </div>
                    <button type="submit" class="btn btn-sm btn-outline-secondary">Enregistrer</button>
                </form>
            </li>
        {% endfor %}
    </ul>
{% endif %}
