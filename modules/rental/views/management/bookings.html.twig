{% extends 'base.html.twig' %}
{% block title %}Réservations — {{ asset.name }} — {{ site_name }}{% endblock %}
{#
  The bookings list with its filters (§6.4).

  Renter names are shown here because this page is behind
  RentalAuthorizationService and only a manager of THIS asset reaches it —
  the same data the public pages never carry a word of (§6.6).
#}
{% block content %}
    <div class="page-wide">
        {% include 'partials/page_header.html.twig' with {
            title: 'Réservations — ' ~ asset.name,
        } only %}

        {% include '@rental/management/_nav.html.twig' %}

        {#
          A single select, on the model of modules/mass_mail's own list
          filter. It used to be a second row of chips directly under the
          page picker above: two rows of the same-looking pills, one
          choosing a PAGE and one choosing a FILTER, which read as one
          confused control — and eleven statuses made the second row wrap
          onto three lines on a phone.

          No literal HTML tag in this comment: Twig comments are not HTML
          comments, so an analyser reading the rendered-source text would
          take one for a real unlabelled control.
        #}
        <form method="get" action="/mes-locations/{{ asset.slug }}/reservations"
              class="row g-2 align-items-end mb-3">
            <div class="col-12 col-sm-6 col-md-4">
                <label class="form-label small" for="booking-filter">État</label>
                <select class="form-select form-select-sm" id="booking-filter" name="statut">
                    <option value="" {{ filter == '' ? 'selected' : '' }}>Toutes</option>
                    <option value="a_traiter" {{ filter == 'a_traiter' ? 'selected' : '' }}>
                        À traiter
                    </option>
                    {% for status in statuses %}
                        <option value="{{ status.value }}" {{ filter == status.value ? 'selected' : '' }}>
                            {{ status.label }}
                        </option>
                    {% endfor %}
                </select>
            </div>
            {% if years is not empty %}
                <div class="col-6 col-sm-3 col-md-2">
                    <label class="form-label small" for="booking-year">Année</label>
                    <select class="form-select form-select-sm" id="booking-year" name="annee">
                        <option value="" {{ year == '' ? 'selected' : '' }}>Toutes</option>
                        {% for value in years %}
                            <option value="{{ value }}" {{ year == value ? 'selected' : '' }}>{{ value }}</option>
                        {% endfor %}
                    </select>
                </div>
            {% endif %}
            <div class="col-12 col-sm-6 col-md-3">
                <label class="form-label small" for="booking-search">Recherche</label>
                <input type="search" class="form-control form-control-sm" id="booking-search"
                       name="q" value="{{ search }}" placeholder="Référence ou nom">
            </div>
            <div class="col-6 col-sm-3 col-md-2">
                <button type="submit" class="btn btn-sm btn-primary w-100">Filtrer</button>
            </div>
            {% if filter != '' or year != '' or search != '' %}
                <div class="col-6 col-sm-3 col-md-2">
                    <a href="/mes-locations/{{ asset.slug }}/reservations"
                       class="btn btn-sm btn-outline-secondary w-100">Tout voir</a>
                </div>
            {% endif %}
        </form>

        {% if bookings is empty %}
            {% include 'partials/empty_state.html.twig' with {
                message: 'Aucune réservation ne correspond à ce filtre.',
                icon: 'bi-calendar-x',
            } only %}
        {% else %}
            <p class="text-body-secondary small">
                {{ total_matching }} réservation{{ total_matching > 1 ? 's' : '' }}.
            </p>
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th scope="col">Référence</th>
                            <th scope="col">Locataire</th>
                            <th scope="col">Séjour</th>
                            <th scope="col">État</th>
                            <th scope="col" class="text-end">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for booking in bookings %}
                            <tr>
                                <td>
                                    <a href="/mes-locations/{{ asset.slug }}/reservations/{{ booking.id }}">{{ booking.reference }}</a>
                                </td>
                                <td>
                                    {{ booking.renterName }}
                                    {% if booking.renterOrganisation %}
                                        <span class="text-body-secondary small d-block">{{ booking.renterOrganisation }}</span>
                                    {% endif %}
                                </td>
                                <td class="small">
                                    du {{ booking.arrivalDate|date_fr }}<br>au {{ booking.departureDate|date_fr }}
                                </td>
                                <td>{% include '@rental/_status_badge.html.twig' with { status: booking.status } only %}</td>
                                <td class="text-end">
                                    {% if booking.effectiveTotalCents is not null %}
                                        {{ booking.effectiveTotalCents|money_cents }}
                                    {% else %}
                                        —
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

            {% include 'partials/pagination.html.twig' with {
                page: page,
                total_pages: total_pages,
                base_url: pagination_base_url,
                label: 'Pagination des réservations',
            } only %}
        {% endif %}
    </div>
{% endblock %}
