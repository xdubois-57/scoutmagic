{% extends 'base.html.twig' %}
{% block title %}{{ asset.name }} — Gestion — {{ site_name }}{% endblock %}
{#
  One asset's managed space, first page (§6.4).

  Answers the only question a manager opens this page with: what needs me
  today. Everything else is one chip away.
#}
{% block content %}
    <div class="page-medium">
        {% include 'partials/page_header.html.twig' with {
            title: asset.name,
            subtitle: asset.assetType,
        } only %}
        {% if asset.isArchived or not asset.isPublic %}
            <p class="mb-3">
                {% if asset.isArchived %}{% include 'partials/status_badge.html.twig' with { status: 'archived', label: 'Archivé' } only %}{% endif %}
                {% if not asset.isPublic %}<span class="badge bg-body-tertiary border text-body-secondary">Non public</span>{% endif %}
            </p>
        {% endif %}

        {% include '@rental/management/_nav.html.twig' %}

        {% if tariff_missing %}
            {#
              The one configuration gap a manager cannot see from here and a
              visitor meets first: a public asset with no rate estimates
              nothing. Said where the manager actually is, with the link to
              the exact field that fixes it.
            #}
            <output class="alert alert-warning d-block">
                <strong>Ce bien est visible publiquement mais n'a encore aucun tarif.</strong>
                Les visiteurs voient « Tarif sur demande » à la place d'une estimation.
                <a href="/mes-locations/{{ asset.slug }}/reglages#tarification" class="alert-link">Définir
                le tarif</a> — le champ « Tarif par défaut » suffit pour commencer.
            </output>
        {% endif %}

        {#
          Where the money is configured, said on the page a manager actually
          opens. Tariff, billable minimum, deposit and security deposit live
          in the CHIEFS' space, not here (§6.4) — which is right, but left
          nobody able to find them.
        #}
        <p class="text-body-secondary small">
            Tarif, minimum facturable, acompte, caution et règles de réservation de ce bien
            se configurent dans <a href="/mes-locations/{{ asset.slug }}/reglages">les réglages du bien</a>.
        </p>

        {% if statistics %}
            {#
              Three figures, no graph and no dedicated page (§6.34). They read
              the live bookings AND the anonymous aggregates a purge left
              behind — otherwise the year's revenue would drop to zero on the
              morning the purge ran, and nobody would know why.
            #}
            {% include 'partials/stat_tiles.html.twig' with {
                tiles: [
                    { label: 'Demandes en attente', value: statistics.pending, icon: 'bi-hourglass-split', tone: 'warning' },
                    { label: 'Jours loués cette année', value: statistics.occupied_days, icon: 'bi-calendar-check', tone: 'primary' },
                    { label: "Revenu de l'année", value: statistics.revenue_cents|money_cents, icon: 'bi-cash-coin', tone: 'success' },
                ],
                columns: 3,
            } only %}
        {% endif %}

        <div class="card mb-4">
            <div class="card-body">
                <h2 class="h5 mb-3">À traiter</h2>
                {% if needs_attention is empty %}
                    {% include 'partials/empty_state.html.twig' with {
                        message: 'Aucune demande en attente.',
                        compact: true,
                    } only %}
                {% else %}
                    <div class="list-group list-group-flush">
                        {% for booking in needs_attention %}
                            <a href="/mes-locations/{{ asset.slug }}/reservations/{{ booking.id }}"
                               class="list-group-item list-group-item-action px-0">
                                <div class="d-flex justify-content-between align-items-center gap-2">
                                    <span>
                                        <span class="fw-semibold">{{ booking.reference }}</span>
                                        <span class="text-body-secondary small d-block">
                                            du {{ booking.arrivalDate|date_fr }} au {{ booking.departureDate|date_fr }}
                                        </span>
                                    </span>
                                    {% include '@rental/_status_badge.html.twig' with { status: booking.status } only %}
                                </div>
                            </a>
                        {% endfor %}
                    </div>
                {% endif %}
            </div>
        </div>

        {% if in_progress is not empty %}
            <div class="card mb-4">
                <div class="card-body">
                    {# Derived from the dates, never stored — it can therefore
                       never disagree with the calendar (§6.15). #}
                    <h2 class="h5 mb-3">En cours en ce moment</h2>
                    <ul class="list-unstyled mb-0">
                        {% for booking in in_progress %}
                            <li class="mb-1">
                                <a href="/mes-locations/{{ asset.slug }}/reservations/{{ booking.id }}">{{ booking.reference }}</a>
                                — jusqu'au {{ booking.departureDate|date_fr }}
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            </div>
        {% endif %}

        <div class="card">
            <div class="card-body">
                {# "Blocages" on its own said nothing about who blocks what, or
                   why one would. Named and explained for what it is: dates the
                   unit keeps for itself. #}
                <h2 class="h5 mb-1">Périodes réservées par l'unité</h2>
                <p class="text-body-secondary small">
                    Les dates que vous retirez de la location — un week-end d'unité, des
                    travaux, un camp — pour qu'aucune demande ne puisse tomber dessus. Elles
                    apparaissent comme « occupé » sur le calendrier public, sans qu'on sache
                    pourquoi.
                </p>
                {% if upcoming_blocks is empty %}
                    {% include 'partials/empty_state.html.twig' with {
                        message: 'Aucune période réservée à venir.',
                        compact: true,
                        action_label: 'En poser une depuis le calendrier',
                        action_url: '/mes-locations/' ~ asset.slug ~ '/calendrier',
                        icon: 'bi-calendar-plus',
                    } only %}
                {% else %}
                    <ul class="list-unstyled mb-0">
                        {% for block in upcoming_blocks %}
                            <li class="mb-1">
                                du {{ block.startDate|date_fr }} au {{ block.endDate|date_fr }}
                                {% if block.reason %}— {{ block.reason }}{% endif %}
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}
