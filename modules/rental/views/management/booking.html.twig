{% extends 'base.html.twig' %}
{% block title %}{{ booking.reference }} — {{ asset.name }} — {{ site_name }}{% endblock %}
{#
  One booking's file (§6.4, §6.12, §6.15, §6.16).

  Behind RentalAuthorizationService and reached only by a manager of THIS
  asset, which is why it carries everything the public surfaces never do:
  the renter's identity, the internal comments, the full history.

  The milestone checklist is DERIVED from the booking's own records —
  nothing on it is stored, so it can never drift from what the page below it
  shows. A line still renders greyed when it belongs to something this
  installation cannot do at all (no security deposit configured, the stay
  module off): an unreachable box reads as outstanding work.

  **Every panel here is refreshable.** Each region that an action can change
  sits inside an always-present `data-booking-panel` wrapper — always
  present, so a panel that appears or disappears (the option card once the
  booking is final) swaps like any other. public/assets/js/rental-booking.js
  posts the page's forms with fetch and replaces those wrappers' contents
  from a fresh render of this same template, which is what makes pressing
  « Envoyer » tick « Contrat envoyé » without a page load — and what keeps
  the two from ever disagreeing, since there is still exactly one renderer.
#}
{% block content %}
    <div class="page-medium" data-rental-booking>
        {% include 'partials/page_header.html.twig' with {
            title: booking.reference,
            subtitle: asset.name ~ ' · du ' ~ booking.arrivalDate|date_fr ~ ' au ' ~ booking.departureDate|date_fr,
        } only %}
        <div data-booking-panel="in-progress">
            {% if is_in_progress %}
                <p class="mb-3">{% include 'partials/status_badge.html.twig' with { status: 'active', label: 'En cours' } only %}</p>
            {% endif %}
        </div>

        {% include '@rental/management/_nav.html.twig' %}

        {# ── Milestones ────────────────────────────────────────────── #}
        <div data-booking-panel="milestones">
        <div class="card mb-4">
            <div class="card-body">
                <h2 class="h5 mb-3">Où en est cette location</h2>
                <ul class="list-unstyled mb-0">
                    {% for milestone in milestones %}
                        <li class="mb-1 {{ milestone.isApplicable ? '' : 'text-body-secondary opacity-50' }}">
                            {% if not milestone.isApplicable %}
                                <i class="bi bi-dash-square" aria-hidden="true"></i>
                                <span class="visually-hidden">Sans objet :</span>
                            {% elseif milestone.isDone %}
                                <i class="bi bi-check-square" aria-hidden="true"></i>
                                <span class="visually-hidden">Fait :</span>
                            {% else %}
                                <i class="bi bi-square" aria-hidden="true"></i>
                                <span class="visually-hidden">À faire :</span>
                            {% endif %}
                            {{ milestone.label }}
                            {% if milestone.detail %}
                                <span class="text-body-secondary small">— {{ milestone.detail }}</span>
                            {% endif %}
                        </li>
                    {% endfor %}
                </ul>
            </div>
        </div>
        </div>

        {# ── Renter ────────────────────────────────────────────────── #}
        <div data-booking-panel="renter">
        <div class="card mb-4">
            <div class="card-body">
                <h2 class="h5 mb-3">Le locataire</h2>
                <dl class="row mb-0">
                    <dt class="col-sm-4">Nom</dt>
                    <dd class="col-sm-8">{{ booking.renterName }}</dd>
                    <dt class="col-sm-4">Email</dt>
                    <dd class="col-sm-8"><a href="mailto:{{ booking.renterEmail }}">{{ booking.renterEmail }}</a></dd>
                    {% if booking.renterPhone %}
                        <dt class="col-sm-4">Téléphone</dt>
                        <dd class="col-sm-8"><a href="tel:{{ booking.renterPhone|replace({' ': ''}) }}">{{ booking.renterPhone }}</a></dd>
                    {% endif %}
                    {% if booking.renterOrganisation %}
                        <dt class="col-sm-4">Organisation</dt>
                        <dd class="col-sm-8">{{ booking.renterOrganisation }}</dd>
                    {% endif %}
                    {% if booking.estimatedPersons %}
                        <dt class="col-sm-4">Participants annoncés</dt>
                        <dd class="col-sm-8">{{ booking.estimatedPersons }}</dd>
                    {% endif %}
                    {% if booking.purpose %}
                        <dt class="col-sm-4">Objet</dt>
                        <dd class="col-sm-8">{{ booking.purpose }}</dd>
                    {% endif %}
                    {% if booking.renterComment %}
                        <dt class="col-sm-4">Message</dt>
                        <dd class="col-sm-8">{{ booking.renterComment|nl2br }}</dd>
                    {% endif %}
                </dl>

                {# Le lien de suivi ne s'affiche nulle part : sa possession
                   EST l'autorisation (§8.52). Il ne se récupère donc pas —
                   il se remplace, et le nouveau part par email au locataire. #}
                <form method="post" action="/mes-locations/lien-suivi" class="mt-3"
                      data-confirm="Régénérer le lien ? L'ancien cessera de fonctionner et le locataire devra recevoir le nouveau.">
                    {{ csrf_field()|raw }}
                    <input type="hidden" name="asset_id" value="{{ asset.id }}">
                    <input type="hidden" name="booking_id" value="{{ booking.id }}">
                    <button type="submit" class="btn btn-sm btn-outline-secondary">
                        Régénérer le lien de suivi
                    </button>
                    <div class="form-text">
                        À faire si le locataire a perdu son lien, ou l'a transmis à quelqu'un
                        qui ne devait pas le recevoir. Le nouveau lien lui est envoyé par email.
                    </div>
                </form>
            </div>
        </div>
        </div>

        {# ── Lifecycle ─────────────────────────────────────────────── #}
        <div data-booking-panel="lifecycle">
        <div class="card mb-4">
            <div class="card-body">
                <h2 class="h5 mb-3">État</h2>
                <p class="mb-3">{% include '@rental/_status_badge.html.twig' with { status: booking.status } only %}</p>

                {% if allowed_transitions is empty %}
                    <p class="text-body-secondary mb-0">
                        Cette réservation est dans un état définitif : elle ne peut plus changer.
                        Une nouvelle demande est nécessaire.
                    </p>
                {% else %}
                    {#
                      Every transition the renter hears about asks first, and
                      the dialog carries the free-text box the manager's word
                      goes in (base.html.twig's data-confirm-note, handled in
                      /assets/js/confirm.js). Which ones those are comes from
                      Booking\RenterDecision::forStatus(), never re-derived
                      here — a status added to that enum must not need this
                      template edited to stop being silent.

                      The rest — « en cours d'examen », a closure — send
                      nothing and ask nothing: they are bookkeeping, and a
                      dialog in front of bookkeeping is a dialog nobody reads.
                    #}
                    <div class="d-flex flex-wrap gap-2">
                        {% for target in allowed_transitions %}
                            {% set decision = renter_decisions[target.value]|default(null) %}
                            <form method="post" action="/mes-locations/statut" class="d-inline"
                                  {% if decision %}
                                      data-confirm="{{ decision.question }}"
                                      data-confirm-label="{{ target.label }}"
                                      data-confirm-note="{{ decision.note_label }}"
                                      data-confirm-note-name="message"
                                  {% elseif target.value in ['refused', 'cancelled'] %}
                                      data-confirm="Confirmer le passage à « {{ target.label }} » ? Les dates seront libérées."
                                  {% endif %}>
                                {{ csrf_field()|raw }}
                                <input type="hidden" name="asset_id" value="{{ asset.id }}">
                                <input type="hidden" name="booking_id" value="{{ booking.id }}">
                                <input type="hidden" name="status" value="{{ target.value }}">
                                <button type="submit"
                                        class="btn btn-sm {{ target.value == 'confirmed' ? 'btn-primary' : 'btn-outline-secondary' }}">
                                    {{ target.label }}
                                </button>
                            </form>
                        {% endfor %}
                    </div>
                    <p class="text-body-secondary small mb-0 mt-2">
                        Le locataire est prévenu par email d'une confirmation, d'un refus,
                        d'une annulation, d'une proposition ou d'une demande de précision.
                    </p>
                {% endif %}
            </div>
        </div>
        </div>

        {# ── Manager's option (§6.14) ──────────────────────────────── #}
        <div data-booking-panel="hold">
        {% if not booking.status.isFinal %}
            <div class="card mb-4">
                <div class="card-body">
                    <h2 class="h5 mb-2">Blocage des dates</h2>
                    <p class="text-body-secondary small">
                        Une option engage l'unité jusqu'à l'échéance. Si elle passe sans confirmation,
                        la réservation devient expirée et les dates se libèrent.
                    </p>
                    <form method="post" action="/mes-locations/option" class="row g-2 align-items-end">
                        {{ csrf_field()|raw }}
                        <input type="hidden" name="asset_id" value="{{ asset.id }}">
                        <input type="hidden" name="booking_id" value="{{ booking.id }}">
                        <div class="col-12 col-sm-7">
                            {% include 'partials/form_field.html.twig' with {
                                field_id: 'option-until', field_name: 'until', type: 'datetime-local',
                                label: 'Option jusqu\'au',
                                value: booking.holdUntil ? booking.holdUntil|date('Y-m-d\\TH:i') : '',
                            } only %}
                        </div>
                        <div class="col-12 col-sm-5">
                            <button type="submit" class="btn btn-outline-secondary w-100">Enregistrer l'option</button>
                        </div>
                        {# Under the row, not under the field — see
                           design.md §7.6: `align-items-end` aligns the
                           bottoms of the columns, not their controls. #}
                        <p class="form-text col-12 mb-0">Laisser vide et enregistrer lève le blocage.</p>
                    </form>
                </div>
            </div>
        {% endif %}
        </div>

        {# ── Price (§6.12) ─────────────────────────────────────────── #}
        <div data-booking-panel="price">
        <div class="card mb-4">
            <div class="card-body">
                <h2 class="h5 mb-2">Prix</h2>
                {% if booking.status.value == 'confirmed' %}
                    <div class="alert alert-warning" role="status">
                        <strong>Cette réservation est confirmée.</strong> Modifier le prix maintenant :
                        <ul class="mb-0">
                            <li>le contrat sera à régénérer en nouvelle version ;</li>
                            <li>la créance sera mise à jour ;</li>
                            <li>le changement est visible immédiatement du locataire ;</li>
                            <li>les paiements déjà reçus ne sont pas touchés — seul le solde change,
                                et un trop-perçu est possible si le nouveau total passe sous le montant encaissé.</li>
                        </ul>
                    </div>
                {% endif %}

                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-2">
                        <thead>
                            <tr>
                                <th scope="col">Ligne</th>
                                <th scope="col" class="text-end">Quantité</th>
                                <th scope="col" class="text-end">Montant</th>
                                <th scope="col"><span class="visually-hidden">Actions</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for line in quote.lines %}
                                <tr>
                                    <td>
                                        {{ line.label }}
                                        {% if line.isManual %}
                                            <span class="badge text-bg-info ms-1"
                                                  title="Cette ligne ne sera plus recalculée">Modifiée à la main</span>
                                        {% endif %}
                                        {% if line.isInformational %}
                                            <span class="text-body-secondary small d-block">
                                                Facturé sur relevé — hors total
                                            </span>
                                        {% endif %}
                                    </td>
                                    <td class="text-end">{{ line.quantity }}</td>
                                    <td class="text-end">{{ line.amountCents|money_cents }}</td>
                                    <td class="text-end">
                                        <form method="post" action="/mes-locations/ligne" class="d-inline"
                                              data-confirm="Supprimer la ligne « {{ line.label }} » ?">
                                            {{ csrf_field()|raw }}
                                            <input type="hidden" name="asset_id" value="{{ asset.id }}">
                                            <input type="hidden" name="booking_id" value="{{ booking.id }}">
                                            <input type="hidden" name="line_action" value="remove">
                                            <input type="hidden" name="index" value="{{ loop.index0 }}">
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                Supprimer
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                                <tr>
                                    <td colspan="4" class="pt-0">
                                        <form method="post" action="/mes-locations/ligne" class="row g-2 align-items-end">
                                            {{ csrf_field()|raw }}
                                            <input type="hidden" name="asset_id" value="{{ asset.id }}">
                                            <input type="hidden" name="booking_id" value="{{ booking.id }}">
                                            <input type="hidden" name="line_action" value="edit">
                                            <input type="hidden" name="index" value="{{ loop.index0 }}">
                                            <div class="col-12 col-md-5">
                                                <label class="form-label visually-hidden" for="label-{{ loop.index0 }}">Libellé</label>
                                                <input type="text" class="form-control form-control-sm"
                                                       id="label-{{ loop.index0 }}" name="label" value="{{ line.label }}">
                                            </div>
                                            <div class="col-6 col-md-2">
                                                <label class="form-label visually-hidden" for="qty-{{ loop.index0 }}">Quantité</label>
                                                <input type="number" inputmode="numeric" min="1" class="form-control form-control-sm"
                                                       id="qty-{{ loop.index0 }}" name="quantity" value="{{ line.quantity }}">
                                            </div>
                                            <div class="col-6 col-md-3">
                                                <label class="form-label visually-hidden" for="amount-{{ loop.index0 }}">Montant</label>
                                                <input type="text" class="form-control form-control-sm"
                                                       id="amount-{{ loop.index0 }}" name="amount"
                                                       value="{{ (line.amountCents / 100)|number_format(2, ',', '') }}"
                                                       inputmode="decimal">
                                            </div>
                                            <div class="col-12 col-md-2">
                                                <button type="submit" class="btn btn-sm btn-outline-secondary w-100">Modifier</button>
                                            </div>
                                        </form>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                        <tfoot>
                            <tr class="fw-semibold">
                                <td colspan="2">Total</td>
                                <td class="text-end">{{ quote.totalCents|money_cents }}</td>
                                <td></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>

                <form method="post" action="/mes-locations/ligne" class="row g-2 align-items-end mb-3">
                    {{ csrf_field()|raw }}
                    <input type="hidden" name="asset_id" value="{{ asset.id }}">
                    <input type="hidden" name="booking_id" value="{{ booking.id }}">
                    <input type="hidden" name="line_action" value="add">
                    <div class="col-12 col-md-5">
                        <label class="form-label" for="new-label">Nouvelle ligne</label>
                        <input type="text" class="form-control form-control-sm" id="new-label" name="label"
                               placeholder="Remise exceptionnelle">
                    </div>
                    <div class="col-6 col-md-2">
                        <label class="form-label" for="new-quantity">Quantité</label>
                        <input type="number" inputmode="numeric" min="1" class="form-control form-control-sm" id="new-quantity"
                               name="quantity" value="1">
                    </div>
                    <div class="col-6 col-md-3">
                        <label class="form-label" for="new-amount">Montant</label>
                        <input type="text" class="form-control form-control-sm" id="new-amount" name="amount"
                               inputmode="decimal" placeholder="-50,00">
                    </div>
                    <div class="col-12 col-md-2">
                        <button type="submit" class="btn btn-sm btn-outline-secondary w-100">Ajouter</button>
                    </div>
                </form>

                <form method="post" action="/mes-locations/ligne">
                    {{ csrf_field()|raw }}
                    <input type="hidden" name="asset_id" value="{{ asset.id }}">
                    <input type="hidden" name="booking_id" value="{{ booking.id }}">
                    <input type="hidden" name="line_action" value="recalculate">
                    <button type="submit" class="btn btn-sm btn-outline-secondary">
                        Recalculer les lignes automatiques
                    </button>
                    <span class="form-text d-block">
                        Reprend le tarif en vigueur pour les lignes automatiques. Les lignes modifiées
                        à la main sont conservées telles quelles.
                    </span>
                </form>
            </div>
        </div>
        </div>

        <div class="card mb-4">
            <div class="card-body d-flex justify-content-between align-items-center gap-2">
                <span>
                    <span class="fw-semibold">Séjour</span>
                    <span class="text-body-secondary small d-block">
                        Relevés de compteurs, état des lieux, incidents et décompte final.
                    </span>
                </span>
                <a href="/mes-locations/{{ asset.slug }}/reservations/{{ booking.id }}/sejour"
                   class="btn btn-outline-secondary">Ouvrir</a>
            </div>
        </div>

        <div data-booking-panel="payment">
            {% include '@rental/management/_payment.html.twig' %}
        </div>

        <div data-booking-panel="documents">
            {% include '@rental/management/_documents.html.twig' %}
        </div>

        <div data-booking-panel="communications">
            {% if communications_available %}
                {% include '@rental/management/_communications.html.twig' %}
            {% endif %}
        </div>

        {# ── Change requests (§6.16) ───────────────────────────────── #}
        <div data-booking-panel="changes">
        <div class="card mb-4">
            <div class="card-body">
                <h2 class="h5 mb-2">Demandes et propositions</h2>
                <p class="text-body-secondary small">
                    Une demande ne modifie jamais la réservation d'elle-même : elle attend une décision.
                </p>

                {% if change_requests is empty %}
                    {% include 'partials/empty_state.html.twig' with {
                        message: 'Aucune demande.',
                        compact: true,
                    } only %}
                {% else %}
                    <ul class="list-unstyled">
                        {% for change in change_requests %}
                            <li class="border-bottom py-2">
                                <div class="d-flex justify-content-between align-items-start gap-2">
                                    <span>
                                        <span class="fw-semibold">{{ change.origin.label }}</span> —
                                        {{ change.kind.label }}
                                        <span class="text-body-secondary small d-block">{{ change.summary }}</span>
                                        {% if change.message %}
                                            <span class="small d-block">{{ change.message|nl2br }}</span>
                                        {% endif %}
                                    </span>
                                    {% include 'partials/status_badge.html.twig' with { status: change.status.value, label: change.status.label } only %}
                                </div>
                                {% if change.isPending and change.origin.value == 'renter' %}
                                    <div class="d-flex gap-2 mt-2">
                                        <form method="post" action="/mes-locations/demande"
                                              data-confirm="Accepter cette demande ? Elle sera appliquée à la réservation, et le locataire en sera informé."
                                              data-confirm-label="Accepter"
                                              data-confirm-note="Un mot au locataire (facultatif)"
                                              data-confirm-note-name="message">
                                            {{ csrf_field()|raw }}
                                            <input type="hidden" name="asset_id" value="{{ asset.id }}">
                                            <input type="hidden" name="booking_id" value="{{ booking.id }}">
                                            <input type="hidden" name="request_id" value="{{ change.id }}">
                                            <input type="hidden" name="decision" value="accept">
                                            <button type="submit" class="btn btn-sm btn-outline-secondary">Accepter</button>
                                        </form>
                                        <form method="post" action="/mes-locations/demande"
                                              data-confirm="Refuser cette demande ? La réservation reste inchangée, et le locataire en sera informé."
                                              data-confirm-label="Refuser"
                                              data-confirm-note="Dire pourquoi, si vous le souhaitez (facultatif)"
                                              data-confirm-note-name="message">
                                            {{ csrf_field()|raw }}
                                            <input type="hidden" name="asset_id" value="{{ asset.id }}">
                                            <input type="hidden" name="booking_id" value="{{ booking.id }}">
                                            <input type="hidden" name="request_id" value="{{ change.id }}">
                                            <input type="hidden" name="decision" value="refuse">
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Refuser</button>
                                        </form>
                                    </div>
                                {% endif %}
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}

                {% if not booking.status.isFinal %}
                    <form method="post" action="/mes-locations/proposition" class="row g-2 align-items-end mt-2">
                        {{ csrf_field()|raw }}
                        <input type="hidden" name="asset_id" value="{{ asset.id }}">
                        <input type="hidden" name="booking_id" value="{{ booking.id }}">
                        <input type="hidden" name="kind" value="dates">
                        <div class="col-6 col-md-3">
                            <label class="form-label" for="propose-arrival">Proposer du</label>
                            <input type="date" class="form-control form-control-sm" id="propose-arrival" name="arrival">
                        </div>
                        <div class="col-6 col-md-3">
                            <label class="form-label" for="propose-departure">au</label>
                            <input type="date" class="form-control form-control-sm" id="propose-departure" name="departure">
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label" for="propose-message">Message au locataire</label>
                            <input type="text" class="form-control form-control-sm" id="propose-message" name="message"
                                   aria-describedby="propose-message-help">
                            <div class="form-text" id="propose-message-help">Envoyé avec la proposition.</div>
                        </div>
                        <div class="col-12 col-md-2">
                            <button type="submit" class="btn btn-sm btn-outline-secondary w-100">Proposer</button>
                        </div>
                    </form>
                {% endif %}
            </div>
        </div>
        </div>

        {# ── Internal comments (§6.6) ──────────────────────────────── #}
        <div data-booking-panel="comments">
        <div class="card mb-4">
            <div class="card-body">
                <h2 class="h5 mb-2">Commentaires internes</h2>
                <p class="text-body-secondary small">
                    Visibles des seuls gestionnaires. Ils n'apparaissent jamais sur la page de suivi du locataire.
                </p>

                {% if comments is empty %}
                    {% include 'partials/empty_state.html.twig' with {
                        message: 'Aucun commentaire.',
                        compact: true,
                    } only %}
                {% else %}
                    <ul class="list-unstyled">
                        {% for comment in comments %}
                            <li class="border-bottom py-2">
                                <div class="small text-body-secondary">
                                    {{ comment.author_name ?: 'Auteur inconnu' }} —
                                    {{ comment.created_at|datetime_fr }}
                                </div>
                                {{ comment.body|nl2br }}
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}

                <form method="post" action="/mes-locations/commentaire">
                    {{ csrf_field()|raw }}
                    <input type="hidden" name="asset_id" value="{{ asset.id }}">
                    <input type="hidden" name="booking_id" value="{{ booking.id }}">
                    <label class="form-label" for="comment-body">Ajouter un commentaire</label>
                    <textarea class="form-control mb-2" id="comment-body" name="body" rows="3"></textarea>
                    <button type="submit" class="btn btn-sm btn-outline-secondary">Enregistrer</button>
                </form>
            </div>
        </div>
        </div>

        {# ── History (§6.15) ───────────────────────────────────────── #}
        <div data-booking-panel="history">
        <div class="card">
            <div class="card-body">
                <h2 class="h5 mb-2">Historique</h2>
                {% include 'partials/audit_timeline.html.twig' with {
                    entity_type: 'rental_booking',
                    entity_id: booking.id,
                    audit_page: audit_page,
                    labels: audit_labels,
                } only %}
            </div>
        </div>
        </div>
    </div>
{% endblock %}

{% block scripts %}
    {# Turns every form above into a fetch, then re-renders the panels. #}
    <script src="{{ asset('/assets/js/rental-booking.js') }}" defer></script>
    <script src="{{ asset('/assets/js/drop-zone.js') }}" defer></script>
    {# Names the file that was picked: the zone's input is visually hidden,
       so a zone that says nothing looks the same before and after a drop. #}
    <script src="{{ asset('/assets/js/upload-drop-zone.js') }}" defer></script>
{% endblock %}
