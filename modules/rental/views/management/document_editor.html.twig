{% extends 'base.html.twig' %}
{% block title %}{{ document_type.label }} {{ booking.reference }} — {{ site_name }}{% endblock %}
{#
  The booking's OWN copy of a template (§6.25, level 2).

  Taken from the asset the first time this page is opened, and independent
  from then on: editing the asset's template afterwards touches nothing
  here, and editing here touches no other booking.

  **This was a plain textarea, and the comment that said why was right.** A
  contenteditable surface splits a run of text across elements as it is
  edited, so `{{ '{{ prix_total }}' }}` becomes `{{ '{{ pri<b>x</b>_total }}' }}`
  the moment somebody bolds a word that overlaps it — still readable to a
  human, no longer a keyword to the substituter, and only noticed once a
  contract has gone out with braces in it.

  What changed is that the hazard is answered rather than avoided, on three
  levels (§22.6):

  - every keyword of the closed list renders as one indivisible
    `contenteditable="false"` chip the generic field already produces, so it
    cannot be split or half-deleted;
  - the SERVER repairs what survives anyway — a paste, an author with no
    JavaScript — after sanitizing and before substitution
    (Core\Template\TokenEngine);
  - and the « mots-clés non reconnus » warning below stays the net: when the
    repair declines, it shows on screen rather than in a signed contract.

  **Read-only once sent.** Until a document of this type has gone out, the
  text is a draft; afterwards the renter holds a copy, and what that copy
  was made from must not move under it.
#}
{% block content %}
    <div class="page-medium">
        {% include 'partials/page_header.html.twig' with {
            title: document_type.label ~ ' — ' ~ booking.reference,
            subtitle: asset.name,
        } only %}

        <div class="alert alert-info">
            Ce texte n'appartient qu'à cette réservation. Modifier le gabarit du bien ensuite ne le
            changera pas, et le modifier ici ne change aucune autre réservation.
        </div>

        {% if is_locked %}
            <output class="alert alert-warning d-block">{{ locked_reason }}</output>
        {% endif %}

        {% if unknown_keywords is not empty %}
            <output class="alert alert-warning d-block">
                Mots-clés non reconnus, qui apparaîtront tels quels dans le document :
                {% for keyword in unknown_keywords %}
                    <code>{{ '{{ ' ~ keyword ~ ' }}' }}</code>{{ not loop.last ? ', ' : '' }}
                {% endfor %}
            </output>
        {% endif %}

        {% if is_locked %}
            {# Shown, never offered for editing: a manager still has to be
               able to read what went out. #}
            <div class="rich-text border rounded-3 p-3 mb-3 bg-body-tertiary">{{ body_html|sanitized_html }}</div>
        {% else %}
            {% include '@rental/management/_keywords.html.twig' %}

            <form method="post" action="/mes-locations/document-texte">
                {{ csrf_field()|raw }}
                <input type="hidden" name="asset_id" value="{{ asset.id }}">
                <input type="hidden" name="booking_id" value="{{ booking.id }}">
                <input type="hidden" name="document_type" value="{{ document_type.value }}">

                {% include 'partials/rich_text_form_field.html.twig' with {
                    field_id: 'document-body',
                    field_name: 'body',
                    value: body_html,
                    label: 'Texte du document',
                    help: 'Mettez en forme le texte comme ailleurs sur le site. Les mots-clés insérés
                           — en bleu — sont remplacés par les valeurs de cette réservation au moment
                           où le document est généré.',
                    placeholders: keywords,
                    rows_height: '22rem',
                } %}

                <div class="d-flex flex-wrap gap-2">
                    <button type="submit" class="btn btn-primary">Enregistrer</button>
                </div>
            </form>
        {% endif %}

        {% if asset_template %}
            <details class="mt-4">
                <summary class="fw-semibold">Gabarit du bien, pour comparaison</summary>
                <div class="border rounded p-3 mt-2 bg-body-tertiary rich-text">{{ asset_template|sanitized_html }}</div>
            </details>
        {% endif %}
    </div>
{% endblock %}

{% block scripts %}
    {# type="module" — the file uses `export`, and a classic <script> tag
       rejects it with a SyntaxError before a line of it runs. #}
    <script type="module" src="{{ asset('/assets/js/rich-text-form-field.js') }}"></script>
{% endblock %}
