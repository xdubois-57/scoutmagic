{#
  Sub-navigation of one asset's managed space (§6.4), rendered through the
  shared partials/page_picker.html.twig (design.md §7.6) rather than a copy
  of the pages[] → nav rail mapping layer.

  Requires `asset` and `nav_page` in scope. A page that does not exist yet is
  deliberately absent rather than shown disabled — a chip that does nothing is
  worse than one that is not there. The nav_page key → URL mapping stays here
  because booking and stay pages select « Réservations » without carrying its
  URL as their own.
#}
{% set management_pages = [
    {'key': 'overview', 'url': '/mes-locations/' ~ asset.slug, 'label': "Vue d'ensemble"},
    {'key': 'calendar', 'url': '/mes-locations/' ~ asset.slug ~ '/calendrier', 'label': 'Calendrier'},
    {'key': 'bookings', 'url': '/mes-locations/' ~ asset.slug ~ '/reservations', 'label': 'Réservations'},
    {'key': 'templates', 'url': '/mes-locations/' ~ asset.slug ~ '/gabarits', 'label': 'Gabarits'},
    {'key': 'compliance', 'url': '/mes-locations/' ~ asset.slug ~ '/conformite', 'label': 'Conformité'},
    {'key': 'settings', 'url': '/mes-locations/' ~ asset.slug ~ '/reglages', 'label': 'Réglages'},
] %}
{% set pages = [] %}
{% set current_management_path = '' %}
{% for page in management_pages %}
    {% set pages = pages|merge([{url: page.url, label: page.label}]) %}
    {% if nav_page == page.key %}
        {% set current_management_path = page.url %}
    {% endif %}
{% endfor %}
{% include 'partials/page_picker.html.twig' with {
    picker_id: 'rental-management-picker',
    pages: pages,
    current_path: current_management_path,
    sheet_title: 'Choisir une page',
} only %}
