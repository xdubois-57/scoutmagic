{#
  « Contrat » on Documents (#927, chantier §2.4): the contract in force and,
  beside it while a modification runs, its replacement contract — with the
  renter's copy of it, « Refuser la copie » and « Contresigner », which
  opens the core's signature dialog (issue #926).
  Countersigning the replacement contract IS applying the modification:
  there is no button of its own for that.

  The contract in force keeps its own steps on the dashboard; here it is
  listed, so the two read side by side.

  Requires `asset`, `booking`, `booking_url`, `contract_in_force`,
  `final_contract`, `progress` (a Booking\ModificationProgress or null),
  `has_signature` and `max_refusal_length`.
#}
{% if contract_in_force or progress %}
    <div class="card mb-3" id="contrat">
        <div class="card-body">
            <h2 class="h5 mb-3">Contrat</h2>
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-2">
                    <caption class="visually-hidden">Contrat en vigueur et contrat de remplacement</caption>
                    <thead>
                        <tr>
                            <th scope="col">Version</th>
                            <th scope="col">État</th>
                            <th scope="col"><span class="visually-hidden">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% if contract_in_force %}
                            <tr data-contract-in-force>
                                <td>
                                    {{ contract_in_force.label }}
                                    <span class="text-body-secondary small d-block">
                                        du {{ booking.arrivalDate|date_fr }} au {{ booking.departureDate|date_fr }}
                                        {%- if booking.estimatedPersons %}, {{ booking.estimatedPersons }} pers.{% endif %}
                                        {%- if booking.effectiveTotalCents is not null %}, {{ booking.effectiveTotalCents|money_cents }}{% endif %}
                                    </span>
                                </td>
                                <td class="small">
                                    {% include 'partials/status_badge.html.twig' with { status: 'active', label: 'En vigueur' } only %}
                                    <span class="d-block">
                                        {{ final_contract ? 'signé par les deux parties' : 'envoyé le ' ~ contract_in_force.sentAt|date_fr }}
                                    </span>
                                </td>
                                <td class="text-end">
                                    {% set in_force_file = final_contract ?: contract_in_force %}
                                    <a href="{{ file_url(in_force_file.fileId) }}" target="_blank" rel="noopener"
                                       class="btn btn-sm btn-outline-secondary">Ouvrir</a>
                                </td>
                            </tr>
                        {% endif %}
                        {% if progress %}
                            {% set m = progress.modification %}
                            {% set replacement = progress.contract %}
                            <tr data-replacement-contract>
                                <td>
                                    {{ replacement ? 'Contrat de remplacement v' ~ replacement.version : 'Contrat de remplacement' }}
                                    <span class="text-body-secondary small d-block">
                                        du {{ m.arrivalDate|date_fr }} au {{ m.departureDate|date_fr }}
                                        {%- if m.persons %}, {{ m.persons }} pers.{% endif %}
                                        {%- if m.totalCents is not null %}, {{ m.totalCents|money_cents }}{% endif %}
                                    </span>
                                    <a class="small" href="{{ booking_url }}/modifications/{{ m.id }}">Modification du {{ m.createdAt|date_fr }}</a>
                                </td>
                                <td class="small">
                                    {% include 'partials/status_badge.html.twig' with { status: progress.stage.badgeStatus, label: progress.stage.label } only %}
                                    <span class="d-block">
                                        {% if progress.stage.value == 'draft' %}
                                            Pas encore généré
                                        {% elseif progress.stage.value == 'copy_received' %}
                                            Copie reçue le {{ progress.pendingCopy.createdAt|date_fr }} — à vérifier
                                        {% elseif progress.stage.value == 'copy_refused' %}
                                            Copie du {{ progress.refusedCopy.createdAt|date_fr }} refusée : « {{ progress.refusedCopy.refusalReason }} »
                                        {% elseif replacement and replacement.sentAt %}
                                            Envoyé le {{ replacement.sentAt|date_fr }} — copie attendue
                                        {% else %}
                                            Pas encore envoyé : renvoyez-le depuis la modification
                                        {% endif %}
                                    </span>
                                </td>
                                <td class="text-end">
                                    <div class="d-flex flex-wrap gap-1 justify-content-end">
                                        {% if progress.stage.value == 'draft' %}
                                            <a class="btn btn-sm btn-outline-secondary" href="{{ booking_url }}/modifications/{{ m.id }}">Préparer depuis la modification</a>
                                        {% elseif progress.stage.value == 'copy_received' %}
                                            {% set copy = progress.pendingCopy %}
                                            {# Opens the signature dialog, rendered below the table. #}
                                            <button type="button" class="btn btn-sm btn-primary"
                                                    data-bs-toggle="modal" data-bs-target="#countersign-{{ copy.id }}">Contresigner</button>
                                            <a href="{{ file_url(copy.fileId) }}" target="_blank" rel="noopener"
                                               class="btn btn-sm btn-outline-secondary">Ouvrir la copie</a>
                                        {% elseif replacement %}
                                            <a href="{{ file_url(replacement.fileId) }}" target="_blank" rel="noopener"
                                               class="btn btn-sm btn-outline-secondary">Ouvrir</a>
                                        {% endif %}
                                    </div>
                                </td>
                            </tr>
                        {% endif %}
                    </tbody>
                </table>
            </div>
            {% if progress and progress.stage.value == 'copy_received' %}
                {% set copy = progress.pendingCopy %}
                {% set m = progress.modification %}
                {#
                  The core's signature dialog (issue #926), outside the
                  table it is opened from: it is the confirmation, with the
                  manager's stored signature or one given now. It posts
                  without rental-booking.js (`data-async: off`): an open
                  dialog would not survive the panels being re-rendered.
                #}
                {% include 'partials/signature_dialog.html.twig' with {
                    id: 'countersign-' ~ copy.id,
                    title: 'Contresigner le contrat de remplacement',
                    action: '/mes-locations/contrat-contresigner',
                    fields: { asset_id: asset.id, booking_id: booking.id, booking_page: 'documents', document_id: copy.id },
                    consequence: "La modification s'applique aussitôt : la réservation passe au " ~ m.arrivalDate|date_fr ~ ' → ' ~ m.departureDate|date_fr
                        ~ (m.persons ? ', ' ~ m.persons ~ ' personnes' : '')
                        ~ (m.totalCents is not null ? ', ' ~ m.totalCents|money_cents : '')
                        ~ ", et la créance suit, avec la même communication. Les nuits libérées par l'ancien séjour le sont aussi. Le locataire reçoit le contrat signé par les deux parties par e-mail. Le statut de confirmation ne change pas.",
                    has_stored_signature: has_signature,
                    manage_return: booking_url ~ '/documents',
                    form_attributes: { 'data-async': 'off' },
                } only %}
                <details class="mb-2">
                    <summary>Refuser la copie</summary>
                    <form method="post" action="/mes-locations/copie-refuser" class="mt-2"
                          data-confirm="Refuser cette copie ? Le locataire reçoit un e-mail avec la raison et peut déposer une autre copie du même contrat. La modification reste en cours, ses dates restent bloquées."
                          data-confirm-label="Refuser la copie">
                        {{ csrf_field()|raw }}
                        <input type="hidden" name="asset_id" value="{{ asset.id }}">
                        <input type="hidden" name="booking_id" value="{{ booking.id }}">
                        <input type="hidden" name="booking_page" value="documents">
                        <input type="hidden" name="document_id" value="{{ copy.id }}">
                        <label class="form-label" for="replacement-refusal-{{ copy.id }}">Raison (montrée au locataire)</label>
                        <textarea class="form-control form-control-sm" id="replacement-refusal-{{ copy.id }}" name="reason"
                                  rows="3" maxlength="{{ max_refusal_length }}" required
                                  aria-describedby="replacement-refusal-help-{{ copy.id }}"></textarea>
                        <p class="form-text" id="replacement-refusal-help-{{ copy.id }}">
                            {{ max_refusal_length }} caractères au plus — par exemple : « La deuxième page n'est pas
                            signée. »
                        </p>
                        <button type="submit" class="btn btn-sm btn-outline-danger">Refuser la copie</button>
                    </form>
                </details>
            {% endif %}
            {% if progress and contract_in_force %}
                <p class="text-body-secondary small mb-0">
                    {{ contract_in_force.label }} reste le contrat en vigueur jusqu'à la contresignature du contrat de
                    remplacement ; il passe alors « Remplacé ». Même communication structurée sur les deux.
                </p>
            {% endif %}
        </div>
    </div>
{% endif %}
