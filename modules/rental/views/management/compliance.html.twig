{% extends 'base.html.twig' %}

{% block title %}Conformité — {{ asset.name }} — {{ site_name }}{% endblock %}

{% block content %}
    <div class="page-wide">
        {% include 'partials/page_header.html.twig' with {
            title: 'Conformité — ' ~ asset.name,
            action_label: 'Ajouter une entrée',
            action_url: '/mes-locations/' ~ asset.slug ~ '/conformite/nouvelle',
        } only %}

        {% include '@rental/management/_nav.html.twig' %}

        {# The whole point of the page, said before anything else on it — and said
           in terms of what a manager DOES with it, because "conformité" on its own
           read as a compliance check the software was performing. #}
        <p class="text-body-secondary">
            Les papiers du bien et leurs dates d'expiration&nbsp;: contrôle des extincteurs,
            visite de la chaudière, attestation d'assurance incendie, contrôle électrique,
            autorisation communale… Vous les inscrivez ici avec leur échéance, ScoutMagic
            vous prévient quand elle approche, et le document lui-même reste attaché — de
            sorte qu'on le retrouve le jour où quelqu'un le demande.
        </p>
        <div class="alert alert-info">
            <strong>Un pense-bête, pas une vérification.</strong>
            ScoutMagic ne connaît aucune règle réglementaire, ne vérifie rien et ne donne
            aucun avis juridique&nbsp;: il vous rappelle uniquement ce que vous y avez inscrit
            et ce qui arrive à échéance. Ce qu'un bien doit posséder dépend de votre
            commune, de votre fédération et de l'année — c'est à vous de le savoir.
        </div>

        {#
          The register on the shared list editor, like Documents (#708,
          IT-09): one row per entry, a pencil to its own page, the bin with
          its confirmation. Not sortable — the entries stay sorted by due
          date, nearest first, the ones without a date last.
        #}
        {% set list_items = [] %}
        {% for item in items %}
            {% set list_items = list_items|merge([{
                id: item.id,
                entry: item,
                delete_confirm: 'Supprimer « ' ~ item.label ~ ' » du registre ?',
            }]) %}
        {% endfor %}

        {% embed 'partials/list_editor.html.twig' with {
            list_id: 'compliance-list',
            items: list_items,
            sortable: false,
            delete_url: '/mes-locations/' ~ asset.slug ~ '/conformite/supprimer',
            empty_label: "Aucun document au registre. Ajoutez ce qui a une date d'expiration — extincteurs, chaudière, assurance, contrôle électrique — pour être prévenu avant qu'elle ne tombe.",
        } %}
            {% block item_content %}
                {% set entry = item.entry %}
                <div class="d-flex flex-wrap align-items-baseline gap-2">
                    <span class="fw-semibold">{{ entry.label }}</span>
                    {% if entry.expiresOn %}
                        {# A statement about a date, never a verdict about the
                           asset: the unit may have renewed the paper and not
                           typed it in yet. #}
                        {% if entry.hasExpired(today) %}
                            <span class="badge text-bg-danger">Échéance dépassée</span>
                        {% elseif entry.expiresWithin(warning_days, today) %}
                            <span class="badge text-bg-warning">Dans {{ entry.daysUntilExpiry(today) }} jour(s)</span>
                        {% endif %}
                    {% endif %}
                </div>
                <div class="small text-body-secondary">
                    {{ entry.expiresOn ? 'Échéance le ' ~ entry.expiresOn|date_fr : 'Sans échéance' }}
                    {% if entry.remindedOn %} · rappel envoyé le {{ entry.remindedOn|date_fr }}{% endif %}
                </div>
                {% if entry.remark %}
                    <div class="small">{{ entry.remark }}</div>
                {% endif %}
                {% if entry.fileId %}
                    <a href="{{ file_url(entry.fileId) }}" class="small">Ouvrir le document</a>
                {% else %}
                    <span class="small text-body-secondary">Aucun document joint</span>
                {% endif %}
            {% endblock %}
            {% block item_edit %}
                <a href="/mes-locations/{{ asset.slug }}/conformite/{{ item.entry.id }}/modifier"
                   class="btn btn-sm btn-outline-secondary"
                   aria-label="Modifier « {{ item.entry.label }} »" title="Modifier « {{ item.entry.label }} »">
                    <i class="bi bi-pencil" aria-hidden="true"></i>
                </a>
            {% endblock %}
        {% endembed %}
    </div>
{% endblock %}

{% block scripts %}
<script src="{{ asset('/assets/js/list-editor.js') }}" defer></script>
{% endblock %}
