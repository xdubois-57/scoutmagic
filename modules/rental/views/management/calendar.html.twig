{% extends 'base.html.twig' %}
{% block title %}Calendrier — {{ asset.name }} — {{ site_name }}{% endblock %}
{#
  The availability grid (partials/month_day_grid.html.twig) is styled by
  components.css, which base.html.twig deliberately does NOT load — it is
  opt-in per page, the same way members/show.html.twig, chefs/staffs.html.twig
  and registration/departures.html.twig link it.

  Without this link every `.daygrid-week` falls back to `display: block` and
  the month renders as a vertical stack of 42 unstyled cells: the calendar is
  unreadable and, because the cells lose their sizing, effectively unusable.
  That is the actual root cause of "le calendrier ne s'affiche pas" — not the
  grid builder, which was producing the right cells all along.
#}
{% block stylesheets %}
<link rel="stylesheet" href="/assets/css/components.css">
{% endblock %}
{#
  The private calendar (§6.18).

  Two things it does that the public one deliberately does not: it pages into
  the past — half a manager's work is about stays that already happened — and
  it DISTINGUISHES what occupies each day. A visitor sees one undifferentiated
  "occupé" because there is nothing in an Occupancy to tell a booking from a
  block; a manager needs to know which is which before deciding anything, so
  the two are listed separately below the grid rather than merged.
#}
{% block content %}
    <div class="page-medium">
        {% include 'partials/page_header.html.twig' with {
            title: 'Calendrier — ' ~ asset.name,
        } only %}

        {% include '@rental/management/_nav.html.twig' %}

        <div class="card mb-4">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3 gap-2">
                    {% if previous_month %}
                        <a class="btn btn-sm btn-outline-secondary" href="?month={{ previous_month }}"
                           aria-label="Mois précédent">&larr;</a>
                    {% else %}
                        <button type="button" class="btn btn-sm btn-outline-secondary" disabled
                                aria-label="Mois précédent (indisponible)">&larr;</button>
                    {% endif %}

                    <h2 class="h5 mb-0 text-capitalize">{{ calendar_label }}</h2>

                    {% if next_month %}
                        <a class="btn btn-sm btn-outline-secondary" href="?month={{ next_month }}"
                           aria-label="Mois suivant">&rarr;</a>
                    {% else %}
                        <button type="button" class="btn btn-sm btn-outline-secondary" disabled
                                aria-label="Mois suivant (indisponible)">&rarr;</button>
                    {% endif %}
                </div>

                {% include 'partials/month_day_grid.html.twig' with {
                    weeks: calendar,
                    caption: 'Occupation de ' ~ calendar_label,
                } %}
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-body">
                <h2 class="h5 mb-3">Réservations sur la période</h2>
                {% if bookings is empty %}
                    {% include 'partials/empty_state.html.twig' with {
                        message: 'Aucune réservation sur cette période.',
                        compact: true,
                    } only %}
                {% else %}
                    <ul class="list-unstyled mb-0">
                        {% for booking in bookings %}
                            <li class="mb-2">
                                <a href="/mes-locations/{{ asset.slug }}/reservations/{{ booking.id }}">{{ booking.reference }}</a>
                                — du {{ booking.arrivalDate|date_fr }} au {{ booking.departureDate|date_fr }}
                                {% include '@rental/_status_badge.html.twig' with { status: booking.status } only %}
                                {% if booking.holdOrigin %}
                                    <span class="badge text-bg-info ms-1">{{ booking.holdOrigin.managerLabel }}</span>
                                {% endif %}
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </div>
        </div>

        <div class="card">
            <div class="card-body">
                <h2 class="h5 mb-2">Périodes réservées par l'unité</h2>
                <p class="text-body-secondary small">
                    Les dates que vous retirez de la location — un week-end d'unité, des travaux,
                    un camp — pour qu'aucune demande ne puisse tomber dessus. Le calendrier public
                    les montre comme « occupé » et ne dit jamais pourquoi. Une période peut
                    recouvrir une réservation existante : les deux coexistent et apparaissent
                    toutes les deux ici, à traiter chacune de son côté.
                </p>

                {% if blocks is empty %}
                    {% include 'partials/empty_state.html.twig' with {
                        message: 'Aucune période réservée.',
                        compact: true,
                    } only %}
                {% else %}
                    <ul class="list-unstyled">
                        {% for block in blocks %}
                            <li class="d-flex justify-content-between align-items-center gap-2 border-bottom py-2">
                                <span>
                                    du {{ block.startDate|date_fr }} au {{ block.endDate|date_fr }}
                                    {% if block.units > 1 %}<span class="text-body-secondary">({{ block.units }} unités)</span>{% endif %}
                                    {% if block.reason %}
                                        <span class="text-body-secondary small d-block">{{ block.reason }}</span>
                                    {% endif %}
                                </span>
                                <form method="post" action="/mes-locations/blocage-supprimer"
                                      data-confirm="Remettre cette période à la location ?">
                                    {{ csrf_field()|raw }}
                                    <input type="hidden" name="asset_id" value="{{ asset.id }}">
                                    <input type="hidden" name="block_id" value="{{ block.id }}">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Supprimer</button>
                                </form>
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}

                <form method="post" action="/mes-locations/blocage" class="row g-2 align-items-end mt-2">
                    {{ csrf_field()|raw }}
                    <input type="hidden" name="asset_id" value="{{ asset.id }}">
                    <div class="col-6 col-md-3">
                        {% include 'partials/form_field.html.twig' with {
                            field_id: 'block-start', field_name: 'start', type: 'date',
                            label: 'Du', required: true, size: 'sm', wrapper_class: 'mb-0',
                        } only %}
                    </div>
                    <div class="col-6 col-md-3">
                        {% include 'partials/form_field.html.twig' with {
                            field_id: 'block-end', field_name: 'end', type: 'date',
                            label: 'Au', required: true, size: 'sm', wrapper_class: 'mb-0',
                        } only %}
                    </div>
                    {% if asset.quantity > 1 %}
                        <div class="col-6 col-md-2">
                            {% include 'partials/form_field.html.twig' with {
                                field_id: 'block-units', field_name: 'units', type: 'number',
                                label: 'Quantité', inputmode: 'numeric',
                                min: 1, max: asset.quantity, value: 1,
                                size: 'sm', wrapper_class: 'mb-0',
                            } only %}
                        </div>
                    {% endif %}
                    <div class="col-12 col-md-{{ asset.quantity > 1 ? 2 : 4 }}">
                        {% include 'partials/form_field.html.twig' with {
                            field_id: 'block-reason', field_name: 'reason',
                            label: 'Motif', placeholder: 'Chantier toiture',
                            size: 'sm', wrapper_class: 'mb-0',
                        } only %}
                    </div>
                    <div class="col-12 col-md-2">
                        <button type="submit" class="btn btn-sm btn-primary w-100">Réserver</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
{% endblock %}
