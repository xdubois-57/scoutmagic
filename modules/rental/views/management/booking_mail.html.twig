{% extends '@rental/management/_booking_frame.html.twig' %}
{#
  « Courrier » — this booking's mail and nothing else (Booking\BookingPage::MAIL,
  #720), most recent first (Mail\BookingMailTimeline). Always there, whatever
  the mailbox configuration: what the module's rules filed under the booking
  is shown, what they could not attribute is shown nowhere in the rentals.

  One action on a message: « Détacher », final for this booking
  (RentalCommunicationService::detach()). Its form carries the page's own
  context (asset, booking, page), so it answers through bookingAction() like
  every other form of the file — asynchronously, the panel below re-rendered
  in place — and, without JavaScript, comes back here.
#}
{% block booking_content %}
    {% if not mail_module_active %}
        <p class="small text-body-secondary">
            Le module « Courrier entrant » n'est pas actif sur ce site : les réponses des
            locataires arrivent dans la boîte de l'unité, sans apparaître ici.
        </p>
    {% elseif not mail_collected %}
        {# Said once, above the list, rather than in place of it: the
           page has its use without a box. #}
        <p class="small text-body-secondary" data-mail-not-collected>
            Aucune boîte e-mail ne relève le courrier des locations : les réponses des locataires
            n'apparaissent pas ici. Un superadministrateur peut ouvrir une boîte aux Locations depuis
            <em>Configuration &gt; Courrier entrant</em>, sous « Portée ».
        </p>
    {% endif %}

    <div id="{{ boxes.mail.anchor }}">
        <div data-booking-panel="mail">
            {% if mail_entries is empty %}
                {% include 'partials/empty_state.html.twig' with {
                    message: "Aucun message pour cette réservation.",
                    icon: 'bi-envelope',
                } only %}
            {% else %}
                <div class="d-flex flex-column gap-3" data-mail-timeline>
                    {% for entry in mail_entries %}
                        {% if entry.message %}
                        {% set message = entry.message %}
                        {# Read in a box: received, or sent from its « Envoyés »
                           by somebody of the unit (#720). Either way the person
                           on the other side is the line under the subject. #}
                        {% set counterpart = message.isSent() ? 'À : ' ~ message.toEmails|join(', ') : message.displayFrom() %}
                        <div class="card" data-mail-entry="{{ message.id }}" data-mail-direction="{{ entry.direction }}">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start gap-2 flex-wrap">
                                    <div class="min-w-0">
                                        <div class="fw-semibold">
                                            <span class="badge bg-body-tertiary border text-body-secondary me-1">{{ message.isSent() ? 'Envoyé' : 'Reçu' }}</span>
                                            {{ message.subject ?: 'Sans objet' }}
                                        </div>
                                        <div class="small text-body-secondary">{{ counterpart }}</div>
                                        {# How it was filed, when that is a guess: a message
                                           matched on the sender's address alone may still be
                                           somebody else's (§22.9). #}
                                        {% if not message.linkOrigin.isCertain %}
                                            <span class="badge text-bg-warning mt-1">Rattachement incertain · {{ message.linkOrigin.label }}</span>
                                        {% endif %}
                                    </div>
                                    <span class="small text-body-secondary text-nowrap">{{ message.sentAt|datetime_fr }}</span>
                                </div>

                                {% if entry.has_body %}
                                    <div class="small text-body-secondary text-truncate mt-2">{{ entry.excerpt }}</div>
                                    {# The body is rendered HERE, hidden, and MOVED into
                                       the dialog on opening (mail-message-dialog.js): no
                                       HTML string travels through an attribute or
                                       innerHTML. #}
                                    <div class="d-none mail-message-body" id="mail-message-body-{{ message.id }}">
                                        {% include '@inbound_mail/partials/message_body.html.twig' with { message: message } only %}
                                    </div>
                                {% endif %}

                                {% if message.hasAttachments or message.hasOmittedAttachments %}
                                    <div class="mt-2">
                                        {% include '@inbound_mail/partials/attachments.html.twig' with { message: message, downloadable: true } only %}
                                    </div>
                                {% endif %}

                                <div class="d-flex flex-wrap gap-2 mt-3">
                                    {% if entry.has_body %}
                                        <button type="button" class="btn btn-outline-secondary btn-sm"
                                                data-mail-message-open="mail-message-body-{{ message.id }}"
                                                data-mail-message-title="{{ message.subject ?: 'Sans objet' }}"
                                                data-mail-message-meta="{{ counterpart }} · {{ message.sentAt|datetime_fr }}">
                                            <i class="bi bi-envelope-open" aria-hidden="true"></i> Lire le message
                                        </button>
                                    {% endif %}
                                    <form method="post" action="/mes-locations/courrier/detacher"
                                          data-confirm="Ce message ne concerne pas cette réservation ? Il la quitte, avec ses pièces jointes encore « Non classé », et n'y sera plus jamais rattaché automatiquement.">
                                        {{ csrf_field()|raw }}
                                        <input type="hidden" name="asset_id" value="{{ asset.id }}">
                                        <input type="hidden" name="booking_id" value="{{ booking.id }}">
                                        <input type="hidden" name="booking_page" value="{{ booking_page.value }}">
                                        <input type="hidden" name="message_id" value="{{ message.id }}">
                                        <button type="submit" class="btn btn-outline-secondary btn-sm"
                                                aria-label="Détacher « {{ message.subject ?: 'Sans objet' }} »">
                                            <i class="bi bi-x-lg" aria-hidden="true"></i> Détacher
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                        {% else %}
                            {% set sent = entry.sent %}
                            <div class="card{{ sent.failed ? ' border-danger' : '' }}" data-sent-entry="{{ sent.id }}">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-start gap-2 flex-wrap">
                                        <div class="min-w-0">
                                            <div class="fw-semibold">
                                                {% if sent.failed %}
                                                    <span class="badge text-bg-danger me-1">Non envoyé</span>
                                                {% elseif sent.beingResent %}
                                                    <span class="badge text-bg-warning me-1">Renvoi en cours</span>
                                                {% else %}
                                                    <span class="badge bg-body-tertiary border text-body-secondary me-1">Envoyé</span>
                                                {% endif %}
                                                {{ sent.subject }}
                                            </div>
                                            <div class="small text-body-secondary">À {{ sent.recipient }}</div>
                                        </div>
                                        <span class="small text-body-secondary text-nowrap">{{ sent.sentAt|datetime_fr }}</span>
                                    </div>

                                    {% if entry.has_body %}
                                        <div class="small text-body-secondary text-truncate mt-2">{{ entry.excerpt }}</div>
                                        {# The site's own text, as sent, with the tracking link
                                           masked — never the stored HTML. #}
                                        <div class="d-none mail-message-body" id="mail-message-body-sent-{{ sent.id }}">
                                            <div style="white-space: pre-wrap;">{{ sent.displayText }}</div>
                                        </div>
                                    {% endif %}

                                    {% if entry.attachment_names is not empty %}
                                        <ul class="list-unstyled small mt-2 mb-0">
                                            {% for name in entry.attachment_names %}
                                                <li><i class="bi bi-paperclip" aria-hidden="true"></i> {{ name }}</li>
                                            {% endfor %}
                                        </ul>
                                    {% endif %}

                                    <div class="d-flex flex-wrap gap-2 mt-3">
                                        {% if entry.has_body %}
                                            <button type="button" class="btn btn-outline-secondary btn-sm"
                                                    data-mail-message-open="mail-message-body-sent-{{ sent.id }}"
                                                    data-mail-message-title="{{ sent.subject }}"
                                                    data-mail-message-meta="À {{ sent.recipient }} · {{ sent.sentAt|datetime_fr }}">
                                                <i class="bi bi-envelope-open" aria-hidden="true"></i> Lire le message
                                            </button>
                                        {% endif %}
                                        {% if sent.failed %}
                                            <form method="post" action="/mes-locations/courrier/renvoyer"
                                                  data-confirm="Renvoyer cet e-mail au locataire, {{ sent.recipient }} ?{{ sent.carriesTheTrackingLink ? ' Il partira avec le lien de suivi actuel de la réservation.' : '' }}">
                                                {{ csrf_field()|raw }}
                                                <input type="hidden" name="asset_id" value="{{ asset.id }}">
                                                <input type="hidden" name="booking_id" value="{{ booking.id }}">
                                                <input type="hidden" name="booking_page" value="{{ booking_page.value }}">
                                                <input type="hidden" name="sent_email_id" value="{{ sent.id }}">
                                                <button type="submit" class="btn btn-outline-secondary btn-sm"
                                                        aria-label="Renvoyer « {{ sent.subject }} »">
                                                    <i class="bi bi-arrow-repeat" aria-hidden="true"></i> Renvoyer
                                                </button>
                                            </form>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                        {% endif %}
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    </div>
    {# The page's own reading dialog, the same ids as the inbound mail
       screens' so mail-message-dialog.js opens it: the site's sent mail is
       shown here even without that module, whose templates are then not
       registered. #}
    {% embed 'partials/modal.html.twig' with { id: 'mail-message-modal', title: 'Message', scrollable: true, size: 'lg' } only %}
        {% block body %}
            <p id="mail-message-modal-meta" class="small text-body-secondary"></p>
            <div id="mail-message-modal-body"></div>
        {% endblock %}
        {% block footer %}
            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Fermer</button>
        {% endblock %}
    {% endembed %}
{% endblock %}

{% block booking_scripts %}
    <script src="{{ asset('/assets/js/mail-message-dialog.js') }}" defer></script>
{% endblock %}
