{#
  What a manager decided, said to the renter (§6.15, §6.16). One template
  for all of them: the decision supplies the announcement, the call to
  action and whether the tracking link belongs in it
  (Booking\RenterDecision), so a new decision is a case in that enum rather
  than a seventh near-copy of this file.

  `manager_word` is the manager's own sentence, optional, and it is quoted
  as theirs rather than folded into the announcement — the renter should be
  able to tell what the site says from what a person wrote.
#}
{% extends 'email/base.html.twig' %}
{% block content %}
    <h2 style="margin:0 0 20px;font-size:20px;line-height:1.3;color:#212529;">{{ decision_subject }}</h2>
    <p style="margin:0 0 16px;">Bonjour {{ renter_name }},</p>
    <p style="margin:0 0 16px;">{{ announcement }}</p>
    <p style="margin:0 0 16px;">
        <strong>{{ asset_name }}</strong>, du {{ arrival_date }} au {{ departure_date }}<br>
        Votre référence : <strong>{{ reference }}</strong>
    </p>
    {% if manager_word %}
        <blockquote style="margin:16px 0;padding:4px 0 4px 12px;border-left:3px solid #dee2e6;color:#4b5563;">
            {{ manager_word|nl2br }}
        </blockquote>
    {% endif %}
    {% if call_to_action %}
        <p style="margin:0 0 16px;">{{ call_to_action }}</p>
    {% endif %}
    {% if tracking_url %}
        <p style="margin:24px 0;text-align:center;">
            <a href="{{ tracking_url }}"
               style="display:inline-block;padding:12px 28px;background-color:#0d6efd;color:#ffffff;text-decoration:none;border-radius:6px;font-weight:bold;">
                Voir ma réservation
            </a>
        </p>
    {% endif %}
{% endblock %}
