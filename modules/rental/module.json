  "settings": [
    {
      "key": "asset_type_suggestions",
      "default_value": "Local, Salle, Terrain, Terrain de camp, Tente, Remorque, Matériel, Autre",
      "type": "text",
      "label": "Types de biens proposés",
      "description": "Liste, séparée par des virgules, des types proposés à la création d'un bien. C'est une liste fermée : la création d'un bien propose exactement ces types et rien d'autre. Pour louer quelque chose qui n'y figure pas, ajoutez-le ici d'abord — le type est repris sur la page publique et sur le contrat, donc un type saisi librement produisait « Local », « local » et « Local scout » comme trois choses différentes."
    },
    {
      "key": "automatic_hold_hours",
      "default_value": "48",
      "type": "number",
      "label": "Blocage automatique des dates (heures)",
      "description": "Durée pendant laquelle les dates d'une demande reçue sont retenues, en heures, le temps que les gestionnaires y répondent. Pendant ce délai les dates n'apparaissent plus libres pour les autres visiteurs ; passé ce délai elles se libèrent seules et la demande reste en attente — rien n'est refusé automatiquement. 0 désactive le blocage automatique : les dates restent alors proposées à tout le monde jusqu'à la confirmation."
    },
    {
      "key": "inbound_mailbox_ids",
      "default_value": "",
      "type": "text",
      "label": "Boîtes de courrier entrant surveillées",
      "description": "Identifiants des boîtes, séparés par des virgules, dont les messages sont rattachés automatiquement aux réservations. Vide = toutes les boîtes configurées. Se règle depuis la page Locations plutôt qu'ici : elle affiche le nom de chaque boîte, ce que cette liste d'identifiants ne fait pas."
    },
    {
      "key": "compliance_label_suggestions",
      "default_value": "Attestation incendie, Assurance RC, Autorisation communale, Label Atouts Camps, Numéro d'enregistrement",
      "type": "text",
      "label": "Intitulés proposés au registre de conformité",
      "description": "Liste, séparée par des virgules, des intitulés proposés comme point de départ dans le registre de conformité d'un bien. Ce ne sont que des suggestions : n'importe quel autre intitulé peut être saisi. ScoutMagic ne connaît aucune règle réglementaire et ne vérifie aucune conformité — le registre rappelle uniquement ce qui expire."
    },
    {
      "key": "purge_retention_years",
      "default_value": "7",
      "type": "number",
      "label": "Rétention des réservations (années)",
      "description": "Nombre d'années pendant lesquelles une réservation et ses documents sont conservés, comptées depuis la clôture de l'exercice comptable contenant le séjour — pas depuis le séjour lui-même, pour que toutes les locations d'un même exercice se purgent ensemble. Passé ce délai, la réservation, ses lignes, ses documents, ses jetons, ses relevés et les emails qui lui sont rattachés sont supprimés définitivement ; seule subsiste une ligne d'agrégat anonyme (bien, mois, nombre de jours, montant) pour que les statistiques de l'année restent justes. La valeur par défaut de 7 ans reprend l'usage comptable belge courant : c'est une aide, jamais un conseil juridique."
    }
  ],
