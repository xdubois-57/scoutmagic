  "settings": [
    {
      "key": "asset_type_suggestions",
      "default_value": "Local, Terrain, Tente, Remorque, Matériel, Autre",
      "type": "text",
      "label": "Types de biens proposés",
      "description": "Liste, séparée par des virgules, des types proposés à la création d'un bien. Ce ne sont que des suggestions : n'importe quel autre type peut être saisi."
    },
    {
      "key": "automatic_hold_hours",
      "default_value": "48",
      "type": "number",
      "label": "Blocage automatique des dates (heures)",
      "description": "Durée pendant laquelle les dates d'une demande reçue sont retenues, en heures, le temps que les gestionnaires y répondent. Pendant ce délai les dates n'apparaissent plus libres pour les autres visiteurs ; passé ce délai elles se libèrent seules et la demande reste en attente — rien n'est refusé automatiquement. 0 désactive le blocage automatique : les dates restent alors proposées à tout le monde jusqu'à la confirmation."
    }
  ],
