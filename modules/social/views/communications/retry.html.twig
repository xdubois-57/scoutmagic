{% extends "base.html.twig" %}

{% block title %}Réessayer sur {{ label }} ? — {{ site_name }}{% endblock %}

{% block content %}
{% include 'partials/page_header.html.twig' with { title: 'Réessayer sur ' ~ label ~ ' ?' } only %}

<div class="card mb-3">
    <div class="card-body">
        <h2 class="h6 mb-1">{{ source.title }}</h2>
        <p class="small text-body-secondary mb-0">Tenté le {{ failed.attemptedAt|french_date }}</p>
    </div>
</div>

<p>
    {# Since issue #706, IT-02 the image is settled for a source-backed
       share too — but only when a card was actually kept. Dropping the
       condition altogether, on the grounds that the two branches now say
       the same thing, was a defect found in the review of #850: a share
       made before IT-02, a browser with no `DataTransfer` constructor,
       or an attempt published from a canvas that never drew leaves no
       card, and then the album's CURRENT title and cover are what this
       retry composes from. `image_is_settled` carries the whole rule;
       `from_source` was passed to this page and no longer read.
       {@see CommunicationController::imageIsSettled()} #}
    {% if image_is_settled %}
        La même image et le même texte repartiront vers {{ label }}.
    {% else %}
        Le même texte repartira vers {{ label }}. L'image, elle, sera refaite
        à partir de {{ source_label|default('la source') }}, dans son état
        d'aujourd'hui : son titre et sa photo de couverture ont pu changer
        depuis la première tentative.
    {% endif %}
    {% for p in published %}
        {{ p.destination == 'facebook' ? 'La Page Facebook' : (p.destination == 'instagram' ? 'Instagram' : '« ' ~ p.destinationLabel|default('Groupe') ~ ' »') }}, déjà publié le {{ p.publishedAt|french_date }}
        à {{ p.publishedAt|time_fr }}, ne sera pas touché — il n'y aura donc pas de doublon.
    {% endfor %}
</p>
<div class="alert alert-warning">
    L'échec précédent : {{ failed.errorMessage|default('la publication a été interrompue.') }}
    Si rien n'a changé depuis, il se répétera.
</div>

<form method="post" action="{{ self_path }}" class="d-flex flex-wrap gap-2 justify-content-end">
    {{ csrf_field()|raw }}
    <a class="btn btn-outline-secondary" href="/medias-sociaux">Annuler</a>
    <button type="submit" class="btn btn-primary"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Réessayer</button>
</form>
{% endblock %}
