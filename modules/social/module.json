{
  "id": "social",
  "name": "Réseaux sociaux",
  "description": "Relie la Page Facebook et le compte Instagram de l'unité, pour y publier depuis le site.",
  "version": "1.0.0",
  "enabled_by_default": false,
  "routes": [
    {
      "path": "/config/reseaux-sociaux",
      "method": "GET",
      "controller": "Modules\\Social\\Controller\\ConfigController",
      "action": "index",
      "menu": "configuration",
      "role_min": "superadmin",
      "label": "Réseaux sociaux",
      "menu_icon": "bi-share",
      "menu_group": "modules",
      "menu_order": 245,
      "breadcrumb": {
        "label": "Réseaux sociaux",
        "parents": [
          "Configuration"
        ]
      }
    },
    {
      "path": "/config/reseaux-sociaux/{platform}/identifiants",
      "method": "POST",
      "controller": "Modules\\Social\\Controller\\ConfigController",
      "action": "saveCredentials",
      "menu": "configuration",
      "role_min": "superadmin",
      "label": ""
    },
    {
      "path": "/config/reseaux-sociaux/{platform}/connecter",
      "method": "GET",
      "controller": "Modules\\Social\\Controller\\ConfigController",
      "action": "connect",
      "menu": "configuration",
      "role_min": "superadmin",
      "label": ""
    },
    {
      "path": "/config/reseaux-sociaux/{platform}/retour",
      "method": "GET",
      "controller": "Modules\\Social\\Controller\\ConfigController",
      "action": "callback",
      "menu": "configuration",
      "role_min": "superadmin",
      "label": ""
    },
    {
      "path": "/config/reseaux-sociaux/facebook/page",
      "method": "POST",
      "controller": "Modules\\Social\\Controller\\ConfigController",
      "action": "choosePage",
      "menu": "configuration",
      "role_min": "superadmin",
      "label": ""
    },
    {
      "path": "/config/reseaux-sociaux/{platform}/tester",
      "method": "POST",
      "controller": "Modules\\Social\\Controller\\ConfigController",
      "action": "test",
      "menu": "configuration",
      "role_min": "superadmin",
      "label": ""
    },
    {
      "path": "/config/reseaux-sociaux/{platform}/deconnecter",
      "method": "POST",
      "controller": "Modules\\Social\\Controller\\ConfigController",
      "action": "disconnect",
      "menu": "configuration",
      "role_min": "superadmin",
      "label": ""
    },
    {
      "path": "/partage/carte/{token}",
      "method": "GET",
      "controller": "Modules\\Social\\Controller\\CardController",
      "action": "show",
      "menu": "notre_unite",
      "role_min": "public",
      "label": ""
    }
  ],
  "settings": [
    {
      "key": "social_card_blur_ratio",
      "default_value": "0.05",
      "type": "text",
      "label": "Intensité du flou des images publiées",
      "description": "Rayon du flou appliqué à toute photo de la galerie avant publication, en proportion du petit côté de l'image. Calibré sur de vraies photos ; jamais en dessous de 0,05. Non modifiable.",
      "editable": false
    }
  ],
  "cookies": [],
  "scheduled_tasks": [
    {
      "key": "check_connections",
      "handler": "Modules\\Social\\Task\\CheckConnectionsHandler"
    },
    {
      "key": "purge_cards",
      "handler": "Modules\\Social\\Task\\PurgeCardsHandler"
    }
  ],
  "storage": {},
  "category": "communication"
}
