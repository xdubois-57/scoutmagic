{
  "id": "llm_connector",
  "name": "Intelligence artificielle",
  "description": "Fournisseur d'IA utilisé par d'autres modules.",
  "version": "1.4.0",
  "routes": [
    {
      "path": "/config/llm",
      "method": "GET",
      "controller": "Modules\\LlmConnector\\Controller\\ConfigController",
      "action": "index",
      "menu": "configuration",
      "role_min": "superadmin",
      "label": "Intelligence artificielle",
      "menu_icon": "bi-cpu",
      "menu_group": "modules",
      "menu_order": 240,
      "breadcrumb": {
        "label": "Intelligence artificielle",
        "parents": [
          "Configuration"
        ]
      }
    },
    {
      "path": "/config/llm/providers",
      "method": "POST",
      "controller": "Modules\\LlmConnector\\Controller\\ConfigController",
      "action": "saveProvider",
      "menu": "configuration",
      "role_min": "superadmin",
      "label": ""
    },
    {
      "path": "/config/llm/providers/{id}/test",
      "method": "POST",
      "controller": "Modules\\LlmConnector\\Controller\\ConfigController",
      "action": "testConnection",
      "menu": "configuration",
      "role_min": "superadmin",
      "label": ""
    }
  ],
  "settings": [
    {
      "key": "llm_last_failure_at",
      "default_value": "",
      "type": "text",
      "label": "Dernier appel en échec",
      "description": "Horodatage interne : le dernier appel au fournisseur d'intelligence artificielle a échoué à ce moment, et aucun n'a réussi depuis. Vide après un appel réussi. Non modifiable.",
      "editable": false
    },
    {
      "key": "llm_last_failure_code",
      "default_value": "",
      "type": "text",
      "label": "Nature du dernier échec",
      "description": "Marqueur interne : le type d'erreur du dernier appel en échec (délai dépassé, quota, erreur du fournisseur). Non modifiable.",
      "editable": false
    }
  ],
  "cookies": [],
  "scheduled_tasks": [
    {
      "key": "refresh_models",
      "handler": "Modules\\LlmConnector\\Task\\RefreshModelsHandler"
    }
  ],
  "storage": {},
  "category": "technique"
}
