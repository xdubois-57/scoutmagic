{#
  Shared calendar-picker — used by both public.html.twig and chief.html.twig
  (Service\CalendarPickerService::buildOptions() builds `options`; the two
  pages only differ in which calendars are eligible to appear, not in how
  the picker itself is built or rendered).

  Usage — UNCHANGED, do not modify either call site:
  {% include '@calendar/partials/calendar_picker.html.twig' with {
      options: calendar_options,
      selected_id: selected_calendar_id,
      base_url: '/calendar?calendar=',
      extra_query: '&month=' ~ month_param
  } %}

  Thin mapping layer over the generic partials/select_bar.html.twig
  (mode: single) — see docs/module-development.md for that contract.
  A calendar list is open-ended and comes from the database, which is the
  select bar's case rather than the nav rail's.

  public.html.twig is `role_min: public`, so this must never assume a
  session — it does not, and neither does the select bar.
#}
{% set _items = [] %}
{% for option in options %}
    {% set _items = _items|merge([{
        id: option.id,
        label: option.label,
        color: option.color is defined ? option.color : null,
        selected: option.id == selected_id,
    }]) %}
{% endfor %}
<div class="calendar-picker mb-3">
    {% include 'partials/select_bar.html.twig' with {
        picker_id: 'calendar-picker',
        label: 'Calendrier',
        items: _items,
        mode: 'single',
        base_url: base_url,
        extra_query: extra_query|default(''),
        none_selected_text: 'Choisir un calendrier',
        empty_text: 'Aucun calendrier disponible.',
    } %}
</div>
