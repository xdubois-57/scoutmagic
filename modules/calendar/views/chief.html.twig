{% extends "base.html.twig" %}

{% block title %}Calendrier — {{ site_name }}{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" href="{{ asset('/assets/css/components.css') }}">
{% endblock %}

{% block content %}
    {% include 'partials/page_header.html.twig' with { title: 'Calendrier' } only %}

    {% include '@calendar/partials/calendar_picker.html.twig' with {
        options: calendar_options,
        selected_id: selected_calendar_id,
        base_url: '/chefs/calendar?calendar=',
        extra_query: '&month=' ~ month_param
    } %}

    <div class="d-flex align-items-center justify-content-between mb-3">
        <a href="/chefs/calendar?month={{ prev_month_param }}&calendar={{ selected_calendar_id }}"
           class="btn btn-sm btn-outline-secondary" aria-label="Mois précédent">
            <i class="bi bi-chevron-left" aria-hidden="true"></i>
        </a>
        <h2 class="h5 mb-0">{{ month_label }}</h2>
        <a href="/chefs/calendar?month={{ next_month_param }}&calendar={{ selected_calendar_id }}"
           class="btn btn-sm btn-outline-secondary" aria-label="Mois suivant">
            <i class="bi bi-chevron-right" aria-hidden="true"></i>
        </a>
    </div>

    {% if no_staffed_section %}
        <div class="alert alert-info small py-2 mb-3">
            <i class="bi bi-info-circle" aria-hidden="true"></i>
            Vous voyez tout le calendrier de l'unité, mais les évènements d'une section ne sont modifiables que par ses animateurs, et aucune fonction d'animateur ne vous est rattachée à une section pour l'année en cours. Les calendriers supplémentaires, eux, vous restent ouverts. Faites compléter votre fonction dans le Desk, puis relancez l'import&nbsp;: un chef d'unité peut le faire pour vous.
        </div>
    {% else %}
        <p class="text-body-secondary small mb-2">
            <i class="bi bi-info-circle" aria-hidden="true"></i> Cliquez sur un jour pour ajouter un évènement, ou sur un évènement d'une de vos sections pour le modifier.
        </p>
    {% endif %}

    <div class="mb-4">
        {% include 'partials/month_grid.html.twig' with { weeks: weeks, days_clickable: true, events_clickable: true } %}
    </div>

    {# Add/edit event dialog. The shared embed renders header/body/footer as
       direct children of .modal-content (what .modal-dialog-scrollable
       needs), so the form now lives entirely inside the body and the
       footer's submit button reaches it through form="event-form". The
       title id follows the embed's contract: eventModal-title.

       The embed is `only`, so the dialog sees exactly what is listed in its
       `with` hash — and what it needs is editable_calendar_options, the
       WRITE set, never the page picker's wider view set. #}
    {% embed 'partials/modal.html.twig' with {
        id: 'eventModal',
        title: 'Ajouter un évènement',
        scrollable: true,
        editable_calendar_options: editable_calendar_options,
        retro_module_active: retro_module_active,
    } only %}
        {% block body %}
                <form id="event-form">
                        <input type="hidden" id="event-id" value="">
                        <div class="row g-2 mb-2">
                            {# No `field_name` anywhere in this dialog:
                               calendar-chief.js reads the fields by id and
                               posts the event itself. #}
                            <div class="col-12 col-md-6">
                                {% include 'partials/form_field.html.twig' with {
                                    field_id: 'event-title', label: 'Titre',
                                    size: 'sm', wrapper_class: '',
                                } only %}
                            </div>
                            <div class="col-12 col-md-6">
                                {# editable_calendar_options is the WRITE set, not
                                   the view set: an animateur only files events in
                                   the sections they animate, while the picker at
                                   the top of the page still lists everything the
                                   unit does. #}
                                {% include 'partials/form_field.html.twig' with {
                                    field_id: 'event-calendar', label: 'Calendrier',
                                    type: 'select', size: 'sm', wrapper_class: '',
                                    options: editable_calendar_options|default([])|filter(option => option.id != 0)
                                        |map(option => { value: option.id, label: option.label }),
                                } only %}
                            </div>
                        </div>
                        <div class="row g-2 mb-2">
                            {% for field in [
                                { id: 'event-start-date', label: 'Date de début', type: 'date' },
                                { id: 'event-end-date', label: 'Date de fin', type: 'date' },
                                { id: 'event-start-time', label: 'Heure de début', type: 'time' },
                                { id: 'event-end-time', label: 'Heure de fin', type: 'time' },
                            ] %}
                                <div class="col-6 col-md-3">
                                    {% include 'partials/form_field.html.twig' with {
                                        field_id: field.id, label: field.label, type: field.type,
                                        size: 'sm', wrapper_class: '',
                                    } only %}
                                </div>
                            {% endfor %}
                        </div>
                        {% include 'partials/form_field.html.twig' with {
                            field_id: 'event-location', label: 'Localisation',
                            size: 'sm', wrapper_class: 'mb-2',
                        } only %}
                        {% include 'partials/form_field.html.twig' with {
                            field_id: 'event-description', label: 'Description',
                            type: 'textarea', rows: 2, size: 'sm', wrapper_class: 'mb-2',
                        } only %}
                        {% if retro_module_active %}
                            <div class="mb-2 d-none" id="event-retro-auto-create-wrap">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="event-retro-auto-create">
                                    <label class="form-check-label small" for="event-retro-auto-create">
                                        Créer automatiquement une rétrospective au démarrage de cet évènement
                                    </label>
                                </div>
                            </div>
                            <div class="mb-2 d-none small" id="event-retro-link-wrap">
                                <i class="bi bi-link-45deg" aria-hidden="true"></i> Rétrospective liée :
                                <a href="#" id="event-retro-link" target="_blank" rel="noopener">Ouvrir la rétrospective</a>
                            </div>
                        {% endif %}
                        <div class="text-danger small d-none" id="event-form-error" role="alert"></div>
                </form>
        {% endblock %}
        {% block footer %}
                <button type="button" class="btn btn-outline-danger me-auto d-none" id="event-form-delete">
                    <i class="bi bi-trash" aria-hidden="true"></i> Supprimer
                </button>
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Annuler</button>
                <button type="submit" class="btn btn-primary" form="event-form" id="event-form-submit">Ajouter</button>
        {% endblock %}
    {% endembed %}
{% endblock %}

{% block scripts %}
{# Server data as a JSON ISLAND, not an inline assignment: an island is
   data to the parser, so the default event title or location — free text
   an admin types on the calendar configuration page — cannot end the
   block, and the template needs no nonce for it.
   JSON_HEX_TAG/JSON_HEX_AMP escape those characters anyway.
   calendar-chief.js reads it through ScoutMagicApi.pageData().

   defaultCalendarId stays LAST: CalendarChiefControllerTest asserts on
   "defaultCalendarId":{id}} and leans on that closing brace so an id that
   merely starts with another one cannot match it. #}
{% set json_flags = constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_UNESCAPED_UNICODE') %}
<script type="application/json" id="calendar-chief-data">
{{ {
    defaultTitle: default_title,
    defaultStartTime: default_start_time,
    defaultEndTime: default_end_time,
    defaultLocation: default_location,
    editableCalendarIds: editable_calendar_ids|default([]),
    defaultCalendarId: default_calendar_id
}|json_encode(json_flags)|raw }}
</script>
<script src="{{ asset('/assets/js/calendar-chief.js') }}" defer></script>
{% endblock %}
