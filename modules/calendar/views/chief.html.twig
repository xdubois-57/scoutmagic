{% extends "base.html.twig" %}

{% block title %}Calendrier — {{ site_name }}{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" href="/assets/css/components.css">
{% endblock %}

{% block content %}
    {% include 'partials/page_header.html.twig' with { title: 'Calendrier' } only %}

    {% include '@calendar/partials/calendar_picker.html.twig' with {
        options: calendar_options,
        selected_id: selected_calendar_id,
        base_url: '/chefs/calendar?calendar=',
        extra_query: '&month=' ~ month_param
    } %}

    <div class="d-flex align-items-center justify-content-between mb-3">
        <a href="/chefs/calendar?month={{ prev_month_param }}&calendar={{ selected_calendar_id }}"
           class="btn btn-sm btn-outline-secondary" aria-label="Mois précédent">
            <i class="bi bi-chevron-left" aria-hidden="true"></i>
        </a>
        <h2 class="h5 mb-0">{{ month_label }}</h2>
        <a href="/chefs/calendar?month={{ next_month_param }}&calendar={{ selected_calendar_id }}"
           class="btn btn-sm btn-outline-secondary" aria-label="Mois suivant">
            <i class="bi bi-chevron-right" aria-hidden="true"></i>
        </a>
    </div>

    <p class="text-body-secondary small mb-2">
        <i class="bi bi-info-circle" aria-hidden="true"></i> Cliquez sur un jour pour ajouter un évènement, ou sur un évènement pour le modifier.
    </p>

    <div class="mb-4">
        {% include 'partials/month_grid.html.twig' with { weeks: weeks, days_clickable: true, events_clickable: true } %}
    </div>

    {# Add/edit event dialog. The shared embed renders header/body/footer as
       direct children of .modal-content (what .modal-dialog-scrollable
       needs), so the form now lives entirely inside the body and the
       footer's submit button reaches it through form="event-form". The
       title id follows the embed's contract: eventModal-title. #}
    {% embed 'partials/modal.html.twig' with {
        id: 'eventModal',
        title: 'Ajouter un évènement',
        scrollable: true,
        calendar_options: calendar_options,
        retro_module_active: retro_module_active,
    } only %}
        {% block body %}
                <form id="event-form">
                        <input type="hidden" id="event-id" value="">
                        <div class="row g-2 mb-2">
                            <div class="col-12 col-md-6">
                                <label class="form-label small" for="event-title">Titre</label>
                                <input type="text" class="form-control form-control-sm" id="event-title">
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label small" for="event-calendar">Calendrier</label>
                                <select class="form-select form-select-sm" id="event-calendar">
                                    {% for option in calendar_options %}
                                        {% if option.id != 0 %}
                                            <option value="{{ option.id }}">{{ option.label }}</option>
                                        {% endif %}
                                    {% endfor %}
                                </select>
                            </div>
                        </div>
                        <div class="row g-2 mb-2">
                            <div class="col-6 col-md-3">
                                <label class="form-label small" for="event-start-date">Date de début</label>
                                <input type="date" class="form-control form-control-sm" id="event-start-date">
                            </div>
                            <div class="col-6 col-md-3">
                                <label class="form-label small" for="event-end-date">Date de fin</label>
                                <input type="date" class="form-control form-control-sm" id="event-end-date">
                            </div>
                            <div class="col-6 col-md-3">
                                <label class="form-label small" for="event-start-time">Heure de début</label>
                                <input type="time" class="form-control form-control-sm" id="event-start-time">
                            </div>
                            <div class="col-6 col-md-3">
                                <label class="form-label small" for="event-end-time">Heure de fin</label>
                                <input type="time" class="form-control form-control-sm" id="event-end-time">
                            </div>
                        </div>
                        <div class="mb-2">
                            <label class="form-label small" for="event-location">Localisation</label>
                            <input type="text" class="form-control form-control-sm" id="event-location">
                        </div>
                        <div class="mb-2">
                            <label class="form-label small" for="event-description">Description</label>
                            <textarea class="form-control form-control-sm" id="event-description" rows="2"></textarea>
                        </div>
                        {% if retro_module_active %}
                            <div class="mb-2 d-none" id="event-retro-auto-create-wrap">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="event-retro-auto-create">
                                    <label class="form-check-label small" for="event-retro-auto-create">
                                        Créer automatiquement une rétrospective au démarrage de cet évènement
                                    </label>
                                </div>
                            </div>
                            <div class="mb-2 d-none small" id="event-retro-link-wrap">
                                <i class="bi bi-link-45deg" aria-hidden="true"></i> Rétrospective liée :
                                <a href="#" id="event-retro-link" target="_blank" rel="noopener"></a>
                            </div>
                        {% endif %}
                        <div class="text-danger small d-none" id="event-form-error" role="alert"></div>
                </form>
        {% endblock %}
        {% block footer %}
                <button type="button" class="btn btn-outline-danger me-auto d-none" id="event-form-delete">
                    <i class="bi bi-trash" aria-hidden="true"></i> Supprimer
                </button>
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Annuler</button>
                <button type="submit" class="btn btn-primary" form="event-form" id="event-form-submit">Ajouter</button>
        {% endblock %}
    {% endembed %}
{% endblock %}

{% block scripts %}
{# Server data as a JSON ISLAND, not an inline assignment: an island is
   data to the parser, so the default event title or location — free text
   an admin types on the calendar configuration page — cannot end the
   block, and the template needs no nonce for it.
   JSON_HEX_TAG/JSON_HEX_AMP escape those characters anyway.
   calendar-chief.js reads it through ScoutMagicApi.pageData(). #}
{% set json_flags = constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_UNESCAPED_UNICODE') %}
<script type="application/json" id="calendar-chief-data">
{{ {
    defaultTitle: default_title,
    defaultStartTime: default_start_time,
    defaultEndTime: default_end_time,
    defaultLocation: default_location,
    defaultCalendarId: default_calendar_id
}|json_encode(json_flags)|raw }}
</script>
<script src="/assets/js/calendar-chief.js" defer></script>
{% endblock %}
