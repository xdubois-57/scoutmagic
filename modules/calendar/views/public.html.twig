{% extends "base.html.twig" %}

{% block title %}Calendrier — {{ site_name }}{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" href="{{ asset('/assets/css/components.css') }}">
{% endblock %}

{% block content %}
    {% include 'partials/page_header.html.twig' with { title: 'Calendrier' } only %}

    {{ editable('calendar.intro', '<p>Retrouvez ici les prochaines activités de notre unité.</p>') }}

    {% include '@calendar/partials/calendar_picker.html.twig' with {
        options: calendar_options,
        selected_id: selected_calendar_id,
        base_url: '/calendar?calendar=',
        extra_query: '&month=' ~ month_param
    } %}

    <div class="d-flex align-items-center justify-content-between mb-3">
        <a href="/calendar?month={{ prev_month_param }}&calendar={{ selected_calendar_id }}"
           class="btn btn-sm btn-outline-secondary" aria-label="Mois précédent">
            <i class="bi bi-chevron-left" aria-hidden="true"></i>
        </a>
        <h2 class="h5 mb-0">{{ month_label }}</h2>
        <a href="/calendar?month={{ next_month_param }}&calendar={{ selected_calendar_id }}"
           class="btn btn-sm btn-outline-secondary" aria-label="Mois suivant">
            <i class="bi bi-chevron-right" aria-hidden="true"></i>
        </a>
    </div>

    <div class="mb-4">
        {% include 'partials/month_grid.html.twig' with { weeks: weeks, events_clickable: true } %}
    </div>

    <h2 class="h5 mb-3">Prochains évènements</h2>
    {% if upcoming_events is empty %}
        <div class="mb-4">
            {% include 'partials/empty_state.html.twig' with {
                message: 'Aucun évènement à venir.',
                compact: true,
            } only %}
        </div>
    {% else %}
        <ul class="list-group mb-4">
            {% for event in upcoming_events %}
                {# Same GridEvent shape/data-* attributes as a grid bar (see
                   partials/month_grid.html.twig) so both feed the same
                   showEventDetails() below — color travels via data-color
                   since, unlike a bar, this list item has no colored
                   background of its own to read the color back off of.

                   The control is the label button, not the list item: a list
                   item holding several block-level children cannot be a
                   button, and must not fake one with role/tabindex either —
                   the keyboard handler that would need is an inline attribute
                   this site's CSP forbids. Bootstrap's .stretched-link spreads
                   the button's hit area over the whole (position:relative)
                   list item, so the entire row stays clickable as before. #}
                <li class="list-group-item d-flex justify-content-between align-items-start calendar-upcoming-event-item">
                    <div>
                        <div class="fw-semibold">
                            <button type="button" class="calendar-upcoming-event-trigger stretched-link"
                                    data-color="{{ event.color }}"
                                    {%- for key, value in event.data %} data-{{ key }}="{{ value }}"{% endfor %}>{{ event.label }}</button>
                        </div>
                        <div class="text-body-secondary small d-flex align-items-center gap-1">
                            <span class="d-inline-block rounded-circle" style="width:0.5rem;height:0.5rem;background-color:{{ event.color }};"></span>
                            {{ event.data['calendar-label'] }}
                        </div>
                        {% if event.data['start-time'] %}
                            <div class="text-body-secondary small">
                                <i class="bi bi-clock" aria-hidden="true"></i> {{ event.data['start-time'] }}{% if event.data['end-time'] %} - {{ event.data['end-time'] }}{% endif %}
                            </div>
                        {% endif %}
                        {% if event.data['location'] %}
                            <div class="text-body-secondary small"><i class="bi bi-geo-alt" aria-hidden="true"></i> {{ event.data['location'] }}</div>
                        {% endif %}
                    </div>
                    <span class="badge text-bg-primary text-nowrap">
                        {{ event.startDate|date_fr }}{% if event.endDate and event.endDate != event.startDate %} - {{ event.endDate|date_fr }}{% endif %}
                    </span>
                </li>
            {% endfor %}
        </ul>
    {% endif %}

    <hr class="my-4">

    <h2 class="h5 mb-3">S'abonner au calendrier</h2>
    {% if is_authenticated %}
        <p class="text-body-secondary small mb-2">
            Ajoutez ce lien personnel dans votre application de calendrier (iPhone, Google Calendar,
            Android, macOS Calendar, Outlook, Thunderbird…) pour recevoir automatiquement vos évènements.
        </p>
        <div class="input-group mb-2" style="max-width:520px;">
            <input type="text" class="form-control form-control-sm" id="personal-ics-link"
                   aria-label="Lien ICS personnel"
                   value="{{ param('base_url')|trim('/') }}/calendar/feed/personal/{{ personal_token }}.ics" readonly>
            <button type="button" class="btn btn-sm btn-outline-secondary" id="copy-personal-link">
                <i class="bi bi-clipboard" aria-hidden="true"></i> Copier
            </button>
        </div>
        <button type="button" class="btn btn-sm btn-outline-danger" id="regenerate-personal-link">
            Régénérer le lien
        </button>
    {% else %}
        <p class="text-body-secondary small">
            <i class="bi bi-lock" aria-hidden="true"></i> Connectez-vous pour obtenir un lien de calendrier personnalisé,
            regroupant les évènements de vos sections.
        </p>
    {% endif %}

    {# Read-only event detail dialog, opened by clicking a bar in the grid.
       The shared embed names the title id eventDetailsModal-title — the id
       calendar-public.js fills in; the title starts empty and is set
       per event. #}
    {% embed 'partials/modal.html.twig' with { id: 'eventDetailsModal', title: '' } only %}
        {% block body %}
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="d-inline-block rounded-circle" id="event-details-calendar-dot" style="width:0.6rem;height:0.6rem;"></span>
                <span class="text-body-secondary small" id="event-details-calendar-label"></span>
            </div>
            <div class="small mb-1"><i class="bi bi-calendar-event" aria-hidden="true"></i> <span id="event-details-dates"></span></div>
            <div class="small mb-1 d-none" id="event-details-time-row"><i class="bi bi-clock" aria-hidden="true"></i> <span id="event-details-time"></span></div>
            <div class="small mb-2 d-none" id="event-details-location-row"><i class="bi bi-geo-alt" aria-hidden="true"></i> <span id="event-details-location"></span></div>
            <p class="small mb-0" style="white-space:pre-line;" id="event-details-description"></p>
        {% endblock %}
        {% block footer %}
            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Fermer</button>
        {% endblock %}
    {% endembed %}
{% endblock %}

{% block scripts %}
<script src="{{ asset('/assets/js/calendar-public.js') }}" defer nonce="{{ csp_nonce }}"></script>
{% endblock %}
