{% extends 'email/base.html.twig' %}
{% block content %}
    <h2 style="margin:0 0 20px;font-size:20px;line-height:1.3;color:#212529;">Rappel — {{ event_title }}</h2>
    <p style="margin:0 0 16px;">Bonjour {{ display_name }},</p>
    <p style="margin:0 0 16px;">
        L'évènement <strong>{{ event_title }}</strong>, du {{ start_date }} au {{ end_date }},
        approche. Merci de vérifier les deux points suivants :
    </p>
    <ul style="margin:0 0 16px;padding-left:20px;">
        <li style="margin-bottom:4px;">Déclarer l'évènement dans Desk, si ce n'est pas encore fait.</li>
        <li>Envoyer la liste des intendants au Staff d'U, à l'avance.</li>
    </ul>
    <p style="margin:0;font-size:13px;color:#6c757d;">
        Vous recevez ce rappel parce que vous faites partie du staff de la section concernée.
    </p>
{% endblock %}
