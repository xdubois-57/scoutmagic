{% extends 'base.html.twig' %}
{% block title %}Passage — {{ site_name }}{% endblock %}
{% block content %}
    <div class="container py-4" style="max-width: 1100px;">
        <h1 class="h3 mb-1">Passage</h1>
        <p class="text-body-secondary small mb-4">
            Répartit les arrivants de l'année {{ target_year_label }} entre les sections — toujours calculé sur
            l'année {{ target_year_label }} (l'année publique + 1), quelle que soit l'année actuellement prévisualisée.
        </p>

        <div class="card mb-4">
            <div class="card-body">
                <h2 class="h5 mb-3">Nouvelles inscriptions — année {{ target_year_label }}</h2>
                <p class="small text-body-secondary">Demandes acceptées, pas encore encodées dans Desk. La section prévue choisie ici est la même donnée que sur la fiche de la demande.</p>
                <div class="table-responsive">
                    <table class="table table-sm align-middle">
                        <thead>
                            <tr>
                                <th>Enfant</th>
                                <th>Créneau visé</th>
                                <th>Section souhaitée</th>
                                <th>Remarques</th>
                                <th>Fratrie</th>
                                <th>Section prévue</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for row in new_registrations %}
                                {% set r = row.request %}
                                <tr>
                                    <td>{{ r.childFirstName }} {{ r.childLastName }}</td>
                                    <td>{{ row.slot_label }}</td>
                                    <td>{{ row.desired_section_label ?? '—' }}</td>
                                    <td>{{ r.remarks ?? '—' }}</td>
                                    <td>
                                        {% if row.siblings is empty %}
                                            —
                                        {% else %}
                                            {% for sibling in row.siblings %}
                                                <div>{{ sibling.name }} ({{ sibling.section_label ?? '—' }})</div>
                                            {% endfor %}
                                        {% endif %}
                                    </td>
                                    <td style="min-width:240px;">
                                        <div class="d-flex gap-2 align-items-center">
                                            <select class="form-select form-select-sm passage-select"
                                                    data-endpoint="/passage/inscription/{{ r.id }}/section"
                                                    data-field="intended_section_id"
                                                    aria-label="Section prévue pour {{ r.childFirstName }} {{ r.childLastName }}">
                                                <option value="0">— Non défini —</option>
                                                {% for section in row.sections_in_branch %}
                                                    <option value="{{ section.id }}" {{ r.intendedSectionId == section.id ? 'selected' : '' }}>{{ section.name ?? section.desk_code }}</option>
                                                {% endfor %}
                                            </select>
                                            <button type="button" class="btn btn-sm btn-outline-primary passage-save text-nowrap">Enregistrer</button>
                                        </div>
                                        <div class="form-text passage-feedback" role="status" aria-live="polite"></div>
                                    </td>
                                </tr>
                            {% else %}
                                <tr><td colspan="6" class="text-body-secondary text-center py-3">Aucune inscription acceptée en attente d'affectation pour cette année.</td></tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-body">
                <h2 class="h5 mb-3">Changements de branche — animés actuels</h2>
                <p class="small text-body-secondary">Seuls les animés au dernier rang de leur branche apparaissent ici (hors marqués partants, hors fin de parcours). « Même adresse » ne signifie pas « fratrie » : colocation, deux familles au même numéro, garde alternée sont possibles.</p>

                {% if branch_changes is empty %}
                    <p class="text-body-secondary fst-italic mb-0">Aucun changement de branche pour cette année.</p>
                {% endif %}

                {% for key, group in branch_changes %}
                    <h3 class="h6 mt-4">Actuellement {{ group.section_label }}</h3>
                    <div class="table-responsive">
                        <table class="table table-sm align-middle">
                            <thead>
                                <tr>
                                    <th>Nom</th>
                                    <th class="d-none d-md-table-cell">Année de parcours</th>
                                    <th>Même adresse</th>
                                    <th style="min-width:200px;">Destination</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for member in group.members %}
                                    <tr>
                                        <td>{{ member.name }}</td>
                                        <td class="d-none d-md-table-cell">{{ member.branch_year_label }}</td>
                                        <td>
                                            {% if member.household is empty %}
                                                —
                                            {% else %}
                                                {% for person in member.household %}
                                                    <div>{{ person.name }} ({{ person.section_label ?? '—' }})</div>
                                                {% endfor %}
                                            {% endif %}
                                        </td>
                                        <td style="min-width:240px;">
                                            <div class="d-flex gap-2 align-items-center">
                                                <select class="form-select form-select-sm passage-select"
                                                        data-endpoint="/passage/membre/{{ member.member_id }}/destination"
                                                        data-field="destination_section_id"
                                                        aria-label="Destination pour {{ member.name }}">
                                                    <option value="0">— Non défini —</option>
                                                    {% for section in member.destination_options %}
                                                        <option value="{{ section.id }}" {{ member.destination_section_id == section.id ? 'selected' : '' }}>{{ section.name ?? section.desk_code }}</option>
                                                    {% endfor %}
                                                </select>
                                                <button type="button" class="btn btn-sm btn-outline-primary passage-save text-nowrap">Enregistrer</button>
                                            </div>
                                            {% if member.destination_options is empty %}
                                                <div class="form-text">Aucune section configurée pour la branche d'arrivée.</div>
                                            {% endif %}
                                            <div class="form-text passage-feedback" role="status" aria-live="polite"></div>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>
{% endblock %}

{# Saving happens in place, without reloading the page — same JSON contract
   as departures.html.twig above (Controller\DeparturesController::update()).
   Deliberately a nonce-carrying <script> rather than an inline onchange=
   attribute: the site's CSP sets script-src without 'unsafe-inline', and a
   nonce never covers an on* attribute, so an inline handler here is silently
   blocked by the browser — which is exactly what made both selects on this
   page unable to save anything at all. See core/Http/Response.php and the
   same note in core/View/templates/members/show.html.twig. #}
{% block scripts %}
<script nonce="{{ csp_nonce }}">
(function () {
    const csrf = () => document.querySelector('meta[name="csrf-token"]')?.content;

    function feedback(cell, message, isError) {
        const box = cell.querySelector('.passage-feedback');
        if (!box) return;
        box.textContent = message;
        box.classList.toggle('text-danger', !!isError);
        box.classList.toggle('text-success', !isError);
    }

    document.querySelectorAll('.passage-save').forEach(function (button) {
        const cell = button.closest('td');
        const select = cell.querySelector('.passage-select');

        button.addEventListener('click', function () {
            const payload = { _csrf_token: csrf() };
            payload[select.dataset.field] = parseInt(select.value, 10);

            button.disabled = true;
            feedback(cell, 'Enregistrement…', false);

            fetch(select.dataset.endpoint, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            })
            .then(r => r.json())
            .then(data => {
                if (data.success) {
                    feedback(cell, 'Enregistré.', false);
                } else {
                    feedback(cell, data.error || 'Erreur lors de l\'enregistrement.', true);
                }
            })
            .catch(() => feedback(cell, 'Erreur réseau.', true))
            .finally(() => { button.disabled = false; });
        });

        // A pick that hasn't been saved yet shouldn't still show the
        // previous line's "Enregistré." confirmation.
        select.addEventListener('change', function () {
            feedback(cell, '', false);
        });
    });
})();
</script>
{% endblock %}
