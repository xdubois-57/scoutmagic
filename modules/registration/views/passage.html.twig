{% extends 'base.html.twig' %}
{% block title %}Passage — {{ site_name }}{% endblock %}
{% block content %}
    <div class="page-wide">
        {% include 'partials/page_header.html.twig' with {
            title: 'Passage',
            subtitle: "Répartit les arrivants de l'année " ~ target_year_label ~ " entre les sections — toujours calculé sur
                l'année " ~ target_year_label ~ " (l'année publique + 1), quelle que soit l'année actuellement prévisualisée.",
        } only %}

        {# Spec §8 — where the evening's decisions land, above the tables
           that make them. Refreshed by the save round trip itself
           (registration-passage.js), never by a request of its own. #}
        {% include '@registration/_passage_statistics.html.twig' with {
            statistics: statistics,
        } only %}

        {# IT-18 — « Optimiser la répartition » and « Réinitialiser ».
           The dialog announces what the run will and will not touch before
           anybody presses anything: a chief who has spent an evening
           placing children by hand needs to read « 12 assignations
           conservées » before, not after. #}
        {% if optimization.to_place + optimization.kept > 0 %}
        <div class="d-flex flex-wrap gap-2 align-items-center mb-4">
            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#passage-optimize-dialog"
                    {{ optimization.to_place == 0 ? 'disabled' : '' }}>
                <i class="bi bi-magic" aria-hidden="true"></i> Optimiser la répartition
            </button>
            <form method="post" action="/passage/reinitialiser" id="passage-reset-form"
                  data-confirm="Réinitialiser toute la répartition de l'année {{ target_year_label }} ? Les sections choisies à la main seront effacées, et seules les branches n'ayant qu'une section seront reposées automatiquement.">
                <button type="button" class="btn btn-outline-secondary" id="passage-reset"
                        data-endpoint="/passage/reinitialiser">Réinitialiser</button>
            </form>
            <span class="form-text mb-0" id="passage-optimize-feedback" role="status" aria-live="polite"></span>
        </div>

        <div class="modal fade" id="passage-optimize-dialog" tabindex="-1" aria-labelledby="passage-optimize-title" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h2 class="modal-title h5" id="passage-optimize-title">Optimiser la répartition</h2>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
                    </div>
                    <div class="modal-body">
                        <p class="small text-body-secondary">
                            <strong>{{ optimization.to_place }}</strong>
                            {{ optimization.to_place > 1 ? 'personnes à répartir' : 'personne à répartir' }} —
                            <strong>{{ optimization.kept }}</strong>
                            {{ optimization.kept > 1 ? 'assignations déjà faites seront conservées' : 'assignation déjà faite sera conservée' }}.
                            Une ligne qui porte déjà une section n'est jamais touchée ; pour tout reprendre, réinitialisez d'abord.
                        </p>

                        <div class="form-check mb-2">
                            <input class="form-check-input" type="radio" name="passage-optimize-method"
                                   id="passage-method-balanced" value="balanced" checked>
                            <label class="form-check-label" for="passage-method-balanced">
                                <strong>Souhaits et équilibre</strong>
                                <span class="d-block small text-body-secondary">
                                    Respecte les souhaits autant que possible, sans dépasser l'écart configuré entre les
                                    sections d'une même branche.
                                </span>
                            </label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="passage-optimize-method"
                                   id="passage-method-wishes" value="wishes">
                            <label class="form-check-label" for="passage-method-wishes">
                                <strong>Respecter les souhaits</strong>
                                <span class="d-block small text-body-secondary">
                                    Chacun va dans la section demandée ou avec les personnes citées, sans aucun
                                    équilibrage.
                                </span>
                            </label>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Annuler</button>
                        <button type="button" class="btn btn-primary" id="passage-optimize-run"
                                data-endpoint="/passage/optimiser">Répartir</button>
                    </div>
                </div>
            </div>
        </div>
        {% endif %}

        {# IT-17 — the optional AI re-reading, offered only when the
           llm_connector module is there AND has an active provider. The
           button says how many comments would be sent, because sending a
           family's words to an external provider is a transmission and
           nobody should start one blind. #}
        {% if ai_available %}
            <div class="alert alert-info d-flex flex-wrap gap-2 align-items-center" role="status">
                <span class="me-auto small">
                    <i class="bi bi-robot" aria-hidden="true"></i>
                    Une relecture par IA peut signaler un souhait exprimé dans un commentaire libre plutôt que dans
                    les champs prévus. Elle envoie ces commentaires au fournisseur configuré.
                </span>
                <button type="button" id="passage-ai-review" class="btn btn-sm btn-outline-primary text-nowrap"
                        data-endpoint="/passage/relire-commentaires" {{ ai_pending == 0 ? 'disabled' : '' }}>
                    Relire {{ ai_pending }} commentaire{{ ai_pending > 1 ? 's' : '' }}
                </button>
                <span class="form-text w-100 mb-0" id="passage-ai-review-feedback" role="status" aria-live="polite"></span>
            </div>
        {% endif %}

        <div class="card mb-4">
            <div class="card-body">
                <h2 class="h5 mb-3">Nouvelles inscriptions — année {{ target_year_label }}</h2>
                <p class="small text-body-secondary">Demandes acceptées, pas encore encodées dans Desk. La section prévue choisie ici est la même donnée que sur la fiche de la demande.</p>
                <div class="table-responsive">
                    <table class="table table-sm align-middle">
                        <thead>
                            <tr>
                                <th>Enfant</th>
                                <th>Créneau visé</th>
                                <th>Section souhaitée</th>
                                <th>Remarques</th>
                                <th>Fratrie</th>
                                <th class="d-none d-lg-table-cell">Souhaits de la famille</th>
                                <th class="passage-assign-col">Section prévue</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for row in new_registrations %}
                                {% set r = row.request %}
                                <tr>
                                    <td>{{ r.childFirstName }} {{ r.childLastName }}</td>
                                    <td>{{ row.slot_label }}</td>
                                    <td>{{ row.desired_section_label ?? '—' }}</td>
                                    <td>{{ r.remarks ?? '—' }}</td>
                                    <td>
                                        {% if row.siblings is empty %}
                                            —
                                        {% else %}
                                            {% for sibling in row.siblings %}
                                                <div>{{ sibling.name }} ({{ sibling.section_label ?? '—' }})</div>
                                            {% endfor %}
                                        {% endif %}
                                    </td>
                                    <td class="d-none d-lg-table-cell">
                                        {% include '@registration/_passage_wish_summary.html.twig' with {
                                            planning: planning_requests[r.id]|default(null),
                                        } only %}
                                    </td>
                                    <td class="passage-assign-col">
                                        <div class="d-flex gap-2 align-items-center">
                                            <label for="passage-section-{{ r.id }}" class="visually-hidden">Section prévue pour {{ r.childFirstName }} {{ r.childLastName }}</label>
                                            <select id="passage-section-{{ r.id }}" class="form-select form-select-sm passage-select flex-grow-1"
                                                    data-endpoint="/passage/inscription/{{ r.id }}/section"
                                                    data-field="intended_section_id">
                                                <option value="0">— Non défini —</option>
                                                {% for section in row.sections_in_branch %}
                                                    <option value="{{ section.id }}" {{ r.intendedSectionId == section.id ? 'selected' : '' }}>{{ section.name ?? section.desk_code }}</option>
                                                {% endfor %}
                                            </select>
                                            <button type="button" class="btn btn-sm btn-outline-primary passage-save text-nowrap flex-shrink-0">Enregistrer</button>
                                        </div>
                                        <div class="form-text passage-feedback" role="status" aria-live="polite"></div>
                                    </td>
                                </tr>
                                {% if planning_requests[r.id]|default(null) and planning_requests[r.id].wishes is not empty %}
                                    <tr class="passage-planning-row">
                                        <td colspan="7" class="pt-0">
                                            <div class="passage-planning-inner">
                                            {% include '@registration/_passage_planning.html.twig' with {
                                                key: 'req-' ~ r.id,
                                                endpoint_prefix: '',
                                                planning: planning_requests[r.id],
                                                sections: [],
                                                editable: false,
                                            } only %}
                                            </div>
                                        </td>
                                    </tr>
                                {% endif %}
                            {% else %}
                                {% include 'partials/empty_state.html.twig' with {
                                    message: "Aucune inscription acceptée en attente d'affectation pour cette année.",
                                    compact: true,
                                    colspan: 7,
                                } only %}
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-body">
                <h2 class="h5 mb-3">Changements de branche — animés actuels</h2>
                <p class="small text-body-secondary">Seuls les animés au dernier rang de leur branche apparaissent ici (hors marqués partants, hors fin de parcours). « Même adresse » ne signifie pas « fratrie » : colocation, deux familles au même numéro, garde alternée sont possibles.</p>

                {% if branch_changes is empty %}
                    {% include 'partials/empty_state.html.twig' with {
                        message: 'Aucun changement de branche pour cette année.',
                        compact: true,
                    } only %}
                {% endif %}

                {% for key, group in branch_changes %}
                    <h3 class="h6 mt-4">Actuellement {{ group.section_label }}</h3>
                    <div class="table-responsive">
                        <table class="table table-sm align-middle">
                            <thead>
                                <tr>
                                    <th>Nom</th>
                                    <th class="d-none d-md-table-cell">Année de parcours</th>
                                    <th>Même adresse</th>
                                    <th class="d-none d-lg-table-cell">Souhaits de la famille</th>
                                    <th class="passage-assign-col">Destination</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for member in group.members %}
                                    <tr>
                                        <td>{{ member.name }}</td>
                                        <td class="d-none d-md-table-cell">{{ member.branch_year_label }}</td>
                                        <td>
                                            {% if member.household is empty %}
                                                —
                                            {% else %}
                                                {% for person in member.household %}
                                                    <div>{{ person.name }} ({{ person.section_label ?? '—' }})</div>
                                                {% endfor %}
                                            {% endif %}
                                        </td>
                                        <td class="d-none d-lg-table-cell">
                                            {% include '@registration/_passage_wish_summary.html.twig' with {
                                                planning: planning_members[member.member_id]|default(null),
                                            } only %}
                                        </td>
                                        <td class="passage-assign-col">
                                            <div class="d-flex gap-2 align-items-center">
                                                <label for="passage-destination-{{ member.member_id }}" class="visually-hidden">Destination pour {{ member.name }}</label>
                                                <select id="passage-destination-{{ member.member_id }}" class="form-select form-select-sm passage-select flex-grow-1"
                                                        data-endpoint="/passage/membre/{{ member.member_id }}/destination"
                                                        data-field="destination_section_id">
                                                    <option value="0">— Non défini —</option>
                                                    {% for section in member.destination_options %}
                                                        <option value="{{ section.id }}" {{ member.destination_section_id == section.id ? 'selected' : '' }}>{{ section.name ?? section.desk_code }}</option>
                                                    {% endfor %}
                                                </select>
                                                <button type="button" class="btn btn-sm btn-outline-primary passage-save text-nowrap flex-shrink-0">Enregistrer</button>
                                            </div>
                                            {% if member.destination_options is empty %}
                                                <div class="form-text">Aucune section configurée pour la branche d'arrivée.</div>
                                            {% endif %}
                                            <div class="form-text passage-feedback" role="status" aria-live="polite"></div>
                                        </td>
                                    </tr>
                                    <tr class="passage-planning-row">
                                        <td colspan="5" class="pt-0">
                                            <div class="passage-planning-inner">
                                            {% include '@registration/_passage_planning.html.twig' with {
                                                key: member.member_id,
                                                endpoint_prefix: '/passage/membre/' ~ member.member_id,
                                                planning: planning_members[member.member_id]|default({
                                                    family_section_label: null, family_comment: null, answered_at: null,
                                                    staff_section_id: null, staff_note: null, wishes: [],
                                                }),
                                                sections: member.destination_options,
                                                editable: true,
                                            } only %}
                                            </div>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>
{% endblock %}

{# Saving happens in place, without reloading the page — same JSON contract
   as departures.html.twig above (Controller\DeparturesController::update()).
   The behaviour is in public/assets/js/registration-passage.js, never in an
   inline onchange= attribute: the site's CSP sets script-src without
   'unsafe-inline', and a nonce never covers an on* attribute, so an inline
   handler here is silently blocked by the browser — which is exactly what
   made both selects on this page unable to save anything at all. See
   core/Http/Response.php and the same note in
   core/View/templates/members/show.html.twig. #}
{% block scripts %}
<script src="{{ asset('/assets/js/registration-passage.js') }}" defer nonce="{{ csp_nonce }}"></script>
{% endblock %}
