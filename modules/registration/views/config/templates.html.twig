{% extends 'base.html.twig' %}
{% block title %}Gabarits — Formulaire d'inscription — {{ site_name }}{% endblock %}
{#
  « Gabarits » (issue #905): the four e-mails of the request flow, in the
  table Configuration > E-mails uses (partials/email_template_table), each
  linking to the shared editor reached under this page's own address —
  Controller\RegistrationTemplateController, the core controller narrowed
  to these four.

  Requires `groups` (the core controller's) and `page_url`.
#}
{% block content %}
    <div class="page-wide">
        {% include 'partials/page_header.html.twig' with { title: "Formulaire d'inscription" } only %}
        {% include '@registration/config/_nav.html.twig' %}

        <div class="card mb-4">
            <div class="card-body">
                <h2 class="h5 mb-3">Gabarits des e-mails de demande</h2>

                {% include 'partials/email_template_table.html.twig' with {
                    templates: groups|map(g => g.templates)|reduce((all, t) => all|merge(t), []),
                    page_url: page_url,
                } only %}

                <p class="small text-body-secondary mt-3">
                    L'accusé de réception, l'acceptation et le refus doivent contenir le lien de suivi de la
                    demande (la variable <code>{{ '{{ lien_suivi }}' }}</code>) : c'est le même lien dans les trois
                    e-mails, et un texte sans lui n'est ni enregistré ni envoyé.
                </p>
                <p class="small text-body-secondary mb-0">
                    Les e-mails de réinscription se règlent dans la
                    <a href="/config/reinscription/reglages">gestion des réinscriptions</a>.
                </p>
            </div>
        </div>
    </div>
{% endblock %}
