{# The in-year code of the current public year. Requires
   `public_year_label` and `year_code`. #}
<div class="card mb-4">
    <div class="card-body">
        <h2 class="h5 mb-3">Code d'inscription en cours d'année — année {{ public_year_label }}</h2>
        <p class="text-body-secondary small mb-3">Ce code permet à une famille d'accéder au formulaire même lorsque les inscriptions sont fermées.</p>
        {% if year_code and year_code.isActive %}
            <p>Code actif : <strong class="font-monospace">{{ year_code.code }}</strong></p>
        {% elseif year_code %}
            <p class="text-body-secondary">Dernier code (désactivé) : <span class="font-monospace">{{ year_code.code }}</span></p>
        {% else %}
            {% include 'partials/empty_state.html.twig' with {
                message: 'Aucun code généré pour cette année.',
                compact: true,
            } only %}
        {% endif %}
        <div class="d-flex gap-2">
            {# Both forms ask first (design.md §7.5): a new code silently
               invalidates the one already handed to families, and
               deactivating it shuts them out. The attribute is always
               there; only the sentence depends on whether a code is live. #}
            <form method="post" action="/config/inscriptions/code/regenerate"
                  data-confirm="{{ year_code and year_code.isActive ? 'Générer un nouveau code ? L\'ancien ne fonctionnera plus pour les familles qui l\'ont reçu.' : 'Générer un code ? Les familles qui le reçoivent pourront accéder au formulaire même lorsque les inscriptions sont fermées.' }}">
                {{ csrf_field()|raw }}
                <button type="submit" class="btn btn-outline-primary btn-sm">Générer un nouveau code</button>
            </form>
            {% if year_code and year_code.isActive %}
                <form method="post" action="/config/inscriptions/code/deactivate"
                      data-confirm="Désactiver ce code ? Les familles qui l'ont reçu ne pourront plus accéder au formulaire.">
                    {{ csrf_field()|raw }}
                    <button type="submit" class="btn btn-outline-danger btn-sm">Désactiver</button>
                </form>
            {% endif %}
        </div>
    </div>
</div>
