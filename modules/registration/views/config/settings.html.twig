{% extends 'base.html.twig' %}
{% block title %}Réglages — Formulaire d'inscription — {{ site_name }}{% endblock %}
{% block stylesheets %}<link rel="stylesheet" href="{{ asset('/assets/css/components.css') }}">{% endblock %}
{% block content %}
    <div class="page-wide">
        {% include 'partials/page_header.html.twig' with { title: "Formulaire d'inscription" } only %}
        {% include '@registration/config/_nav.html.twig' %}
        <p class="text-body-secondary small mb-4">
            Les textes des e-mails de demande se rédigent dans <a href="/config/inscriptions/gabarits">Gabarits</a>.
            L'adresse d'alerte, la conservation des demandes et les autres réglages du module se trouvent dans
            <a href="/config/settings">Configuration &gt; Paramètres</a>.
        </p>

        {% include '@registration/config/_settings_form.html.twig' %}
        {% include '@registration/config/_settings_code.html.twig' %}
        {% include '@registration/config/_settings_capacities.html.twig' %}
        {% include '@registration/config/_settings_priorities.html.twig' %}
        {% include '@registration/config/_settings_copy.html.twig' %}
    </div>
{% endblock %}

{% block scripts %}
<script src="{{ asset('/assets/js/sortable.js') }}" defer></script>
<script src="{{ asset('/assets/js/list-editor.js') }}" defer></script>
<script src="{{ asset('/assets/js/registration-capacity-settings.js') }}" defer></script>
<script src="{{ asset('/assets/js/registration-copy-settings.js') }}" defer></script>
{% endblock %}
