{% extends 'email/base.html.twig' %}
{% block content %}
    <h2 style="margin:0 0 16px;font-size:20px;">Réinscription {{ target_year_label }}</h2>
    <p>Bonjour,</p>
    <p>Il est temps de nous dire si votre enfant revient l'année prochaine. La réponse se donne en ligne, en une minute, et vous pouvez la modifier jusqu'au {{ close_date }}.</p>
    <p style="margin:16px 0 8px;"><strong>Concerné{{ member_names|length > 1 ? 's' : '' }} :</strong></p>
    <ul style="margin:0 0 16px;padding-left:20px;">
        {% for name in member_names %}<li>{{ name }}</li>{% endfor %}
    </ul>
    <p style="text-align:center;margin:24px 0;">
        <a href="{{ reenrollment_url }}"
           style="display:inline-block;padding:10px 24px;background-color:#0d6efd;color:#ffffff;text-decoration:none;border-radius:6px;font-weight:bold;">
            Répondre maintenant
        </a>
    </p>
    <p style="font-size:13px;color:#666;">Vous recevez cet email parce qu'un enfant est inscrit chez nous cette année.</p>
{% endblock %}
