{% extends 'email/base.html.twig' %}
{% block content %}
    <h2 style="margin:0 0 16px;font-size:20px;">La réinscription {{ target_year_label }} est clôturée</h2>
    <p>Bonjour,</p>
    <p>La campagne de réinscription pour l'année {{ target_year_label }} vient de se terminer sans que nous ayons reçu votre réponse.</p>
    <p style="margin:16px 0 8px;"><strong>Concerné{{ member_names|length > 1 ? 's' : '' }} :</strong></p>
    <ul style="margin:0 0 16px;padding-left:20px;">
        {% for name in member_names %}<li>{{ name }}</li>{% endfor %}
    </ul>
    <p style="text-align:center;margin:24px 0;">
        <a href="{{ reenrollment_url }}"
           style="display:inline-block;padding:10px 24px;background-color:#0d6efd;color:#ffffff;text-decoration:none;border-radius:6px;font-weight:bold;">
            Voir la page de réinscription
        </a>
    </p>
    <p style="font-size:13px;color:#666;">Il n'est pas trop tard : contactez le Staff d'U et nous ferons le nécessaire.</p>
{% endblock %}
