{% extends 'email/base.html.twig' %}
{% block content %}
    <h2 style="margin:0 0 20px;font-size:20px;line-height:1.3;color:#212529;">La réinscription {{ target_year_label }} est clôturée</h2>
    <p style="margin:0 0 16px;">Bonjour,</p>
    <p style="margin:0 0 16px;">
        La campagne de réinscription {{ target_year_label }} s'est terminée le {{ close_date }} sans
        que nous ayons reçu votre réponse.
    </p>
    <p style="margin:0 0 16px;">Cela concerne : <strong>{{ member_names }}</strong>.</p>
    <p style="margin:24px 0;text-align:center;">
        <a href="{{ reenrollment_url }}"
           style="display:inline-block;padding:12px 28px;background-color:#0d6efd;color:#ffffff;text-decoration:none;border-radius:6px;font-weight:bold;">
            Voir la page de réinscription
        </a>
    </p>
    <p style="margin:0;font-size:13px;color:#6c757d;">
        Il n'est pas trop tard : contactez le Staff d'U et nous ferons le nécessaire.
    </p>
{% endblock %}
