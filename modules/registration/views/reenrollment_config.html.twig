{% extends 'base.html.twig' %}
{% block title %}Réinscriptions — {{ site_name }}{% endblock %}
{% block content %}
{% include 'partials/page_header.html.twig' with {
    title: 'Réinscriptions',
    subtitle: "Quand demander aux familles si leur enfant revient, et où en est la campagne.",
} only %}

{% include '@registration/_reenrollment_nav.html.twig' %}

<div class="card mb-3">
    <div class="card-body">
        <h2 class="h5 mb-3">État</h2>
        <p class="mb-2">
            {% if is_open %}
                <span class="badge text-bg-success">Ouverte</span>
                {% if opened_early %}<span class="ms-2">Ouverte à la main, avant la date prévue.</span>{% endif %}
                {% if close_date %}<span class="ms-2">Clôture prévue le {{ close_date }}.</span>{% endif %}
            {% else %}
                <span class="badge text-bg-secondary">Fermée</span>
            {% endif %}
        </p>

        <div class="row row-cols-2 row-cols-md-4 g-3 mt-1">
            <div class="col">
                <div class="border rounded p-2 text-center">
                    <div class="h4 mb-0">{{ tracking.answered }} / {{ tracking.total }}</div>
                    <div class="small text-body-secondary">réponses reçues</div>
                </div>
            </div>
            <div class="col">
                <div class="border rounded p-2 text-center">
                    <div class="h4 mb-0">{{ tracking.silent }}</div>
                    <div class="small text-body-secondary">sans réponse</div>
                </div>
            </div>
            <div class="col">
                <div class="border rounded p-2 text-center">
                    <div class="h4 mb-0">{{ tracking.leaving }}</div>
                    <div class="small text-body-secondary">départs annoncés</div>
                </div>
            </div>
            <div class="col">
                <div class="border rounded p-2 text-center">
                    <div class="h4 mb-0">{{ tracking.target_year_label }}</div>
                    <div class="small text-body-secondary">année visée</div>
                </div>
            </div>
        </div>

        {# Deliberately counts only: a list here would be a list of children
           whose parents have said they are leaving, sitting on a
           configuration screen. Passages de branche and Départs de
           l'unité are where individual decisions belong. #}
        <p class="form-text mt-3 mb-0">
            Ces chiffres comptent les animés de l'année en cours. Les décisions individuelles se lisent sur les
            pages « Départs de l'unité » et « Passages de branche ».
        </p>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body">
        <h2 class="h5 mb-3">Relancer maintenant</h2>
        <p class="small text-body-secondary">
            Écrit à toutes les familles qui n'ont pas encore répondu pour tous leurs enfants. Un email par
            adresse, listant les enfants concernés.
        </p>
        {# The campaign of the target year, and each of its four e-mails:
           what went out, or what is planned and when (issue #796, D10) —
           sent, planned, missed, skipped, off. The dialog of the button
           below reads the same timeline (D11): the two cannot disagree. #}
        {% if timeline %}
            <div class="small fw-semibold mb-2">
                Campagne pour {{ timeline.label }} :
                {% if timeline.opened_early_at %}
                    ouverte le {{ timeline.opened_early_at|date_fr }}, fermeture le {{ timeline.closes|date_fr }}
                {% elseif timeline.opened_early %}
                    ouverte à la main, fermeture le {{ timeline.closes|date_fr }}
                {% elseif timeline.opens %}
                    du {{ timeline.opens|date_fr }} au {{ timeline.closes|date_fr }}
                {% else %}
                    fermeture le {{ timeline.closes|date_fr }}
                {% endif %}
            </div>
            <dl class="row small mb-3">
                {% for step in timeline.steps %}
                    <dt class="col-sm-4 fw-normal text-body-secondary">{{ {
                        'opening': 'Ouverture',
                        'reminder_1': 'Premier rappel',
                        'reminder_2': 'Second rappel',
                        'closing': 'Fermeture'
                    }[step.type] }}</dt>
                    <dd class="col-sm-8">
                        {% if step.state == 'sent' %}
                            {% if step.at %}
                                Envoyé le {{ step.at|datetime_fr }}{% if step.manual %} (ouverte à la main){% endif %}
                            {% else %}
                                {# Sent, but before the moment was recorded — an
                                   installation upgraded mid-campaign. Saying
                                   « pas encore » here would be false. #}
                                <span class="text-body-secondary">Envoyé, date inconnue</span>
                            {% endif %}
                        {% elseif step.state == 'planned' %}
                            <span class="text-body-secondary">Pas encore envoyé</span> ·
                            <strong>prévu le {{ step.date|date_fr }}</strong>
                        {% elseif step.state == 'missed' %}
                            <span class="text-warning-emphasis">Pas envoyé</span> ·
                            <span class="text-body-secondary">prévu le {{ step.date|date_fr }}, date passée</span>
                        {% elseif step.state == 'skipped' %}
                            <span class="text-body-secondary">Sauté</span> ·
                            <span class="text-body-secondary">le {{ step.date|date_fr }} tombe avant l'ouverture</span>
                        {% else %}
                            <span class="text-body-secondary">Désactivé</span>
                        {% endif %}
                    </dd>
                {% endfor %}
            </dl>
            {% if timeline.previous %}
                <p class="small text-body-secondary">
                    Campagne précédente, pour {{ timeline.previous.label }} : clôturée le {{ timeline.previous.closed_on|date_fr }}.
                </p>
            {% endif %}
        {% else %}
            <p class="small text-body-secondary">
                Aucune campagne : les dates d'ouverture et de fermeture ne sont pas réglées.
                <a href="/config/reinscription/reglages">Les régler</a>.
            </p>
        {% endif %}
        {% if is_open and emails_enabled %}
            {# Asks first (#485): this reaches EVERY family that has not
               answered, and nothing on this page takes it back.
               The guard missed it for a while because its « sends an e-mail »
               pattern was English-only while the route is French.

               The message says « programmé », not « tout de suite »:
               `remind()` seeds a scheduler task rather than sending, and
               its own success flash says « dans quelques minutes ». The
               first wording said the opposite of the flash the same click
               produces — the third time on this pull request that a verb
               in a route was taken for what the action does.

               Since #732 the question also says where the AUTOMATIC
               reminders stand — the last one sent, the next one due — so a
               chief can see one is two days away before sending another. #}
            <form method="post" action="/config/reinscription/relance"
                  data-confirm="{{ remind_question }}" data-confirm-label="Envoyer la relance">
                {{ csrf_field()|raw }}
                <button type="submit" class="btn btn-outline-primary">Relancer les familles sans réponse</button>
            </form>
        {% else %}
            <button type="button" class="btn btn-outline-primary" disabled>Relancer les familles sans réponse</button>
            <div class="form-text">
                {% if not emails_enabled %}
                    Les e-mails de la campagne sont désactivés : aucun ne part, ni automatique ni à la demande.
                    <a href="/config/reinscription/reglages">Les réactiver dans les réglages</a>.
                {% else %}
                    Indisponible campagne fermée : relancer vers un formulaire qu'une famille ne peut plus remplir
                    ne l'aiderait pas.
                {% endif %}
            </div>
        {% endif %}
    </div>
</div>

{% endblock %}
