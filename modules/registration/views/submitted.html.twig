{% extends 'base.html.twig' %}
{% block title %}Demande envoyée — {{ site_name }}{% endblock %}
{% block content %}
    <div class="page-narrow">
        {% include 'partials/page_header.html.twig' with { title: 'Demande envoyée' } only %}
        <div class="alert alert-success">
            <p class="mb-0">
                <strong>Merci !</strong>
                Votre demande d'inscription pour {{ child_first_name }} a bien été reçue. Ceci n'est pas encore une acceptation — elle sera examinée par l'unité.
            </p>
        </div>
        <p class="text-body-secondary">
            Un email de confirmation vient de vous être envoyé, avec un lien vous permettant de suivre l'état de votre demande à tout moment.
        </p>
        <a href="/inscriptions" class="btn btn-outline-secondary">Voir la page d'inscriptions</a>
    </div>
{% endblock %}
