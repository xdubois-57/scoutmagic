{% extends 'base.html.twig' %}
{% block title %}Inscriptions — {{ site_name }}{% endblock %}
{% block content %}
    <div class="page-medium">
        {% include 'partials/page_header.html.twig' with { title: 'Inscriptions' } only %}

        <div class="mb-4">
            {{ editable('registration_intro', '<p>Bienvenue sur la page d\'inscription de l\'unité. Retrouvez ci-dessous le parcours scout et les places disponibles pour l\'année ' ~ target_year_label ~ '.</p>') }}
        </div>

        <div class="mb-4 text-center">
            {% if parcours_image_file_id > 0 %}
                <img src="{{ file_url(parcours_image_file_id) }}" alt="Parcours scout : Baladins 6-8 ans, Louveteaux 8-12 ans, Éclaireurs 12-16 ans, Pionniers 16-18 ans" class="img-fluid rounded">
            {% else %}
                <img src="{{ asset('/assets/img/parcours_scout.webp') }}" alt="Parcours scout : Baladins 6-8 ans, Louveteaux 8-12 ans, Éclaireurs 12-16 ans, Pionniers 16-18 ans" class="img-fluid rounded">
            {% endif %}
        </div>

        <div class="card mb-4">
            <div class="card-body">
                <h2 class="h5 mb-3">{{ waitlist_enabled ? 'Disponibilités ' ~ target_year_label : 'Année scoute ' ~ target_year_label }}</h2>
                {% if waitlist_enabled %}
                    <p class="small text-body-secondary mb-3">Selon votre année de naissance ci-dessous : « Disponible » (inscription immédiate), « Limitée » (quelques places restantes) ou « Complet » (liste d'attente).</p>
                {% endif %}
                <div class="row g-3">
                    {% for branch in birth_years_by_branch %}
                        <div class="col-6 col-sm-3">
                            <div class="fw-semibold small mb-2">{{ branch.branch_label }}</div>
                            <ul class="list-unstyled small mb-0">
                                {% for year in branch.birth_years %}
                                    <li class="mb-1">
                                        {{ year }}
                                        {% if waitlist_enabled %}
                                            {# « Complet » ne s'affiche que pour une année de naissance
                                               explicitement rangée dans le niveau `heavy` par
                                               Service\SlotService. Une branche sans capacité enregistrée
                                               (NULL en base — « pas de limite », jamais 0) n'y arrive
                                               jamais : elle est annoncée « Disponible », comme une branche
                                               qui a de la place. Ne jamais remplacer cette cascade par un
                                               calcul sur un nombre : un NULL lu comme un nombre vaut 0, et
                                               une branche non configurée basculerait en « Complet ». #}
                                            {% if year in waitlist_tiers.limited|default([]) %}
                                                <span class="badge text-bg-warning ms-1">Limitée</span>
                                            {% elseif year in waitlist_tiers.heavy|default([]) %}
                                                <span class="badge text-bg-danger ms-1">Complet</span>
                                            {% else %}
                                                <span class="badge text-bg-success ms-1">Disponible</span>
                                            {% endif %}
                                        {% endif %}
                                    </li>
                                {% endfor %}
                            </ul>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>

        <div class="bg-body-tertiary rounded-3 p-3 p-sm-4">
            <h2 class="h4 mb-3">Formulaire de demande d'inscription</h2>

            {% if submit_error %}
                <div class="alert alert-danger">{{ submit_error }}</div>
            {% endif %}

            {% if not form_available %}
                <div class="alert alert-secondary">
                    Les inscriptions ne sont pas ouvertes pour le moment. Si vous disposez d'un code d'inscription en cours d'année, vous pouvez le saisir ci-dessous pour vous inscrire.
                </div>
                {% if code_error %}
                    <div class="alert alert-danger">{{ code_error }}</div>
                {% endif %}
                <form method="POST" action="/inscriptions/code" class="row g-2 align-items-end" style="max-width: 480px;">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token }}">
                    <div class="col-12 col-sm">
                        <label class="form-label" for="unlock_year_code">Code d'inscription en cours d'année</label>
                        <input type="text" class="form-control" id="unlock_year_code" name="year_code" maxlength="20" placeholder="ex. 4KX9-7QRM" required>
                    </div>
                    <div class="col-12 col-sm-auto">
                        <button type="submit" class="btn btn-primary">Valider le code</button>
                    </div>
                </form>
            {% else %}
                <form method="POST" action="/inscriptions" id="registration-form">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token }}">
                    {% include 'partials/human_check_fields.html.twig' with { human_check: human_check } %}

                    <h3 class="h6 mb-2">Parent</h3>
                    {% include 'partials/form_field.html.twig' with {
                        field_id: 'parent_name', field_name: 'parent_name',
                        label: 'Nom et prénom du parent', required: true,
                        maxlength: 150, value: sticky.parent_name|default(''),
                    } only %}
                    <div class="row gx-3">
                        <div class="col-12 col-sm-6">
                            {% include 'partials/form_field.html.twig' with {
                                field_id: 'email', field_name: 'email', type: 'email',
                                label: 'Email', required: true,
                                maxlength: 190, value: sticky.email|default(''),
                            } only %}
                        </div>
                        <div class="col-12 col-sm-6">
                            {% include 'partials/form_field.html.twig' with {
                                field_id: 'phone1', field_name: 'phone1', type: 'tel',
                                label: 'Téléphone', required: true,
                                maxlength: 30, value: sticky.phone1|default(''),
                            } only %}
                        </div>
                    </div>
                    {% include 'partials/form_field.html.twig' with {
                        field_id: 'phone2', field_name: 'phone2', type: 'tel',
                        label: 'Téléphone (2, facultatif)',
                        maxlength: 30, value: sticky.phone2|default(''),
                    } only %}

                    <div class="row gx-3">
                        <div class="col-12 col-sm-3">
                            {% include 'partials/form_field.html.twig' with {
                                field_id: 'number', field_name: 'number',
                                label: 'N°', required: true,
                                maxlength: 20, value: sticky.number|default(''),
                            } only %}
                        </div>
                        <div class="col-12 col-sm-9">
                            {% include 'partials/form_field.html.twig' with {
                                field_id: 'street', field_name: 'street',
                                label: 'Rue', required: true,
                                maxlength: 150, value: sticky.street|default(''),
                            } only %}
                        </div>
                    </div>
                    <div class="row gx-3">
                        <div class="col-12 col-sm-4">
                            {% include 'partials/form_field.html.twig' with {
                                field_id: 'postal_code', field_name: 'postal_code',
                                label: 'Code postal', required: true,
                                maxlength: 20, value: sticky.postal_code|default(''),
                            } only %}
                        </div>
                        <div class="col-12 col-sm-8">
                            {% include 'partials/form_field.html.twig' with {
                                field_id: 'city', field_name: 'city',
                                label: 'Ville', required: true,
                                maxlength: 100, value: sticky.city|default(''),
                            } only %}
                        </div>
                    </div>

                    <h3 class="h6 mb-2">Enfant</h3>
                    <div class="row gx-3">
                        <div class="col-12 col-sm-6">
                            {% include 'partials/form_field.html.twig' with {
                                field_id: 'child_first_name', field_name: 'child_first_name',
                                label: 'Prénom', required: true,
                                maxlength: 100, value: sticky.child_first_name|default(''),
                            } only %}
                        </div>
                        <div class="col-12 col-sm-6">
                            {% include 'partials/form_field.html.twig' with {
                                field_id: 'child_last_name', field_name: 'child_last_name',
                                label: 'Nom', required: true,
                                maxlength: 100, value: sticky.child_last_name|default(''),
                            } only %}
                        </div>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-12 col-sm-6">
                            {# Not migrated to partials/form_field.html.twig: the hint
                               below is a JS-managed element (inline script fills
                               #birth-date-branch-hint from #birth_date). #}
                            <label class="form-label" for="birth_date">Date de naissance <span class="text-danger" aria-hidden="true">*</span></label>
                            <input type="date" class="form-control" id="birth_date" name="birth_date" required value="{{ sticky.birth_date|default('') }}" aria-describedby="birth-date-branch-hint">
                            <div class="form-text" id="birth-date-branch-hint"></div>
                        </div>
                        <div class="col-12 col-sm-6">
                            {% include 'partials/form_field.html.twig' with {
                                field_id: 'gender', field_name: 'gender', type: 'select',
                                label: 'Genre', required: true,
                                options: [
                                    { value: '', label: 'Choisissez…' },
                                    { value: 'F', label: 'Fille', selected: sticky.gender|default('') == 'F' },
                                    { value: 'M', label: 'Garçon', selected: sticky.gender|default('') == 'M' },
                                    { value: 'X', label: 'Autre / préfère ne pas préciser', selected: sticky.gender|default('') == 'X' },
                                ],
                            } only %}
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label" for="desired_section_id">Section souhaitée (facultatif)</label>
                        <select class="form-select" id="desired_section_id" name="desired_section_id">
                            <option value="">Aucune préférence</option>
                            {% for section in sections %}
                                <option value="{{ section.id }}" data-branch-id="{{ section.age_branch_id }}">{{ section.branch_name }}{% if section.name %} — {{ section.name }}{% endif %}</option>
                            {% endfor %}
                        </select>
                        <div class="form-text">La section n'est proposée qu'à titre indicatif : elle sera confirmée par l'unité en fonction de plusieurs critères (âge, parité filles/garçons, taille des sections...).</div>
                    </div>

                    {% if is_identified and sibling_candidates is not empty %}
                        <div class="mb-4">
                            <div class="form-label d-block">Frères et sœurs déjà membres de l'unité</div>
                            {% for candidate in sibling_candidates %}
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="sibling_member_ids[]" value="{{ candidate.member_id }}" id="sibling-{{ candidate.member_id }}">
                                    <label class="form-check-label" for="sibling-{{ candidate.member_id }}">{{ candidate.name|normalize_name }}</label>
                                </div>
                            {% endfor %}
                        </div>
                    {% endif %}

                    {% include 'partials/form_field.html.twig' with {
                        field_id: 'remarks', field_name: 'remarks', type: 'textarea',
                        label: 'Remarques (facultatif)', rows: 3,
                        maxlength: 2000, value: sticky.remarks|default(''),
                    } only %}

                    {% if form_open %}
                        <div class="mb-4">
                            <button class="btn btn-link p-0 small" type="button" data-bs-toggle="collapse" data-bs-target="#year-code-collapse">
                                J'ai un code d'inscription en cours d'année
                            </button>
                            <div class="collapse mt-2" id="year-code-collapse">
                                {% include 'partials/form_field.html.twig' with {
                                    field_id: 'year_code', field_name: 'year_code',
                                    label: "Code d'inscription",
                                    maxlength: 20, placeholder: 'ex. 4KX9-7QRM',
                                    value: sticky.year_code|default(''),
                                } only %}
                            </div>
                        </div>
                    {% endif %}

                    <div class="form-check mb-4">
                        <input class="form-check-input" type="checkbox" name="rgpd_accepted" id="rgpd_accepted" required {{ sticky.rgpd_accepted|default('') ? 'checked' : '' }}>
                        <label class="form-check-label" for="rgpd_accepted">
                            J'accepte que ces informations soient utilisées dans le cadre du traitement de cette demande d'inscription — voir notre <a href="/rgpd" target="_blank" rel="noopener">politique de protection des données</a>. <span class="text-danger">*</span>
                        </label>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 w-sm-auto float-sm-end">Envoyer la demande</button>
                </form>
            {% endif %}
        </div>
    </div>
{% endblock %}

{% block scripts %}
{# A JSON island, not an inline assignment: the parser reads it as data,
   so a branch label containing a « < » cannot end the block early, and
   the template needs no nonce for it (base.html.twig's
   `offline-config-data` is the same shape). The rows are the very ones
   Service\SlotService::birthYearsByBranch() gave the « nés en… » table
   above, so the preview cannot drift from it. #}
<script type="application/json" id="registration-slots-data">
{{ {
    birthYearSlots: birth_year_slots,
    waitlistEnabled: waitlist_enabled,
    targetYearLabel: target_year_label
}|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_UNESCAPED_UNICODE'))|raw }}
</script>
<script src="{{ asset('/assets/js/registration-public-form.js') }}" defer></script>
{% endblock %}
