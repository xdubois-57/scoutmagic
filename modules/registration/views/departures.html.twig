{% extends 'base.html.twig' %}

{# The family's answer, rendered identically in two places: a column of its
   own from md up, and inside the full-width detail row below md. It is one
   macro rather than two blocks because the wording of a divergence is the
   kind of thing that gets fixed in one copy and not the other.

   Why two places at all: this table already carried three columns at
   375px, and a fourth pushed « Ne sera plus là l'année prochaine » — the
   page's ONE control — out of view behind a horizontal scroll. A column
   the chief has to scroll to reach is worse than no column. #}
{% macro family_answer(row) %}
    {% if row.answer %}
        {% include 'partials/status_badge.html.twig' with {
            status: row.answer.meansLeaving ? 'closed' : 'active',
            label: row.answer.meansLeaving ? 'Ne se réinscrit pas' : 'Se réinscrit',
        } only %}
        <span class="text-muted small">Répondu le {{ row.answer.answeredAt|date_fr }}</span>
        {% if row.diverges %}
            <div class="text-warning-emphasis small">
                <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
                Votre case dit le contraire — c'est elle qui fait foi.
            </div>
        {% endif %}
    {% else %}
        <span class="text-muted small">Pas encore de réponse</span>
    {% endif %}
{% endmacro %}
{% import _self as answer_ui %}
{% block title %}Départs — {{ site_name }}{% endblock %}
{% block stylesheets %}
<link rel="stylesheet" href="{{ asset('/assets/css/components.css') }}">
{% endblock %}
{% block content %}
    <div class="page-medium">
        {# The badge names the scout year this page writes on — the same
           year the subtitle explains the marking is scoped to, but where
           it is read first instead of mid-paragraph. #}
        {% include 'partials/page_header.html.twig' with {
            title: 'Départs',
            badge: scout_year_label,
            subtitle: "Marque les animés qui ne seront plus là l'année scoute prochaine. Ce marquage porte
                uniquement sur l'année scoute " ~ scout_year_label ~ " : il se réinitialise de lui-même à chaque nouvelle
                année (nouvel import Desk), il n'a donc jamais besoin d'être retiré manuellement d'une année sur l'autre.
                L'enregistrement est automatique — il n'y a pas de bouton « Enregistrer ».",
        } only %}

        {% if sections is empty %}
            {% include 'partials/empty_state.html.twig' with {
                message: "Vous n'êtes animateur d'aucune section.",
                icon: 'bi-people',
            } only %}
        {% else %}
            {# The two numbers a chief reads before the list itself: how
               many lines the staff and the family disagree about, and how
               many families have not answered. Both are counts — who is
               leaving is a decision, and decisions belong on the line they
               concern, never in a summary at the top. #}
            {% if reenrollment.visible %}
                <div class="alert {{ reenrollment.divergences > 0 ? 'alert-warning' : 'alert-info' }} d-flex flex-wrap gap-3 align-items-center" role="status">
                    <span id="departures-divergence-count">
                        <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
                        <strong>{{ reenrollment.divergences }}</strong>
                        {{ reenrollment.divergences > 1 ? 'lignes où votre case ne dit pas la même chose que la famille'
                            : 'ligne où votre case ne dit pas la même chose que la famille' }}
                    </span>
                    <span id="departures-unanswered-count">
                        <i class="bi bi-hourglass" aria-hidden="true"></i>
                        <strong>{{ reenrollment.unanswered }}</strong>
                        {{ reenrollment.unanswered > 1 ? 'familles sans réponse' : 'famille sans réponse' }}
                    </span>
                </div>
            {% endif %}

            {% if sections|length > 1 %}
                <div class="mb-4">
                    {% include 'partials/section_picker.html.twig' with {
                        sections: sections,
                        selected_id: selected_section.id|default(0),
                        base_url: '/departs?section_id='
                    } %}
                </div>
            {% else %}
                <h2 class="h5 mb-3">Actuellement {{ selected_section.name ?? selected_section.desk_code }}</h2>
            {% endif %}

            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>Nom</th>
                            <th>Année de parcours</th>
                            {% if reenrollment.visible %}
                                <th class="d-none d-md-table-cell">Réponse de la famille</th>
                            {% endif %}
                            <th class="text-center">Ne sera plus là l'année prochaine</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for row in rows %}
                            {% set columns = reenrollment.visible ? 4 : 3 %}
                            <tr{{ row.diverges|default(false) ? ' class="table-warning"' : '' }}>
                                <td>{{ row.profile.firstName }} {{ row.profile.lastName }}</td>
                                <td>{{ row.branch_year_label }}</td>
                                {% if reenrollment.visible %}
                                    <td class="d-none d-md-table-cell">{{ answer_ui.family_answer(row) }}</td>
                                {% endif %}
                                <td class="text-center">
                                    <input type="checkbox" class="form-check-input departure-checkbox" data-member-year-id="{{ row.profile.memberYearId }}" aria-label="Ne sera plus là l'année prochaine — {{ row.profile.firstName }} {{ row.profile.lastName }}" {{ row.leaving ? 'checked' : '' }}>
                                </td>
                            </tr>
                            {# One detail row per member, carrying two things that
                               must never be confused: what the family wrote, read
                               only, and the staff's own note. It stays on screen
                               for a family answer even when the box is unticked —
                               unticking is the staff's gesture and has no business
                               hiding what a parent said. #}
                            <tr class="departure-comment-row" data-member-year-id="{{ row.profile.memberYearId }}"
                                data-has-answer="{{ row.answer ? '1' : '0' }}"
                                style="{{ (row.leaving or row.answer) ? '' : 'display:none;' }}">
                                <td colspan="{{ columns }}" class="pt-0">
                                    {# Below md there is no column to put it in, so it lives
                                       here — for a line that HAS an answer. A line with none
                                       renders nothing rather than an empty row: the counter at
                                       the top already says how many families are silent. #}
                                    {% if reenrollment.visible and row.answer %}
                                        <div class="d-md-none mb-2">{{ answer_ui.family_answer(row) }}</div>
                                    {% endif %}
                                    {% if row.answer and row.answer.familyComment %}
                                        <div class="departure-family-comment mb-2">
                                            <div class="text-muted small">
                                                Commentaire de la famille, {{ row.answer.answeredAt|date_fr }} — non modifiable ici.
                                            </div>
                                            <blockquote class="mb-0 small">{{ row.answer.familyComment }}</blockquote>
                                        </div>
                                    {% endif %}
                                    <div class="departure-staff-note" style="{{ row.leaving ? '' : 'display:none;' }}">
                                        {# The member's name is in the accessible name but not on
                                           screen: the row already says whose line this is, and a
                                           label repeated per row is a label nobody reads. It is
                                           what keeps « Note interne » unambiguous when a section
                                           has twenty of them. #}
                                        <label class="form-label small text-muted mb-1" for="departure-comment-{{ row.profile.memberYearId }}">
                                            Note interne — jamais vue par la famille<span class="visually-hidden"> — {{ row.profile.firstName }} {{ row.profile.lastName }}</span>
                                        </label>
                                        <textarea class="form-control form-control-sm departure-comment" id="departure-comment-{{ row.profile.memberYearId }}" data-member-year-id="{{ row.profile.memberYearId }}"
                                            rows="2" placeholder="Commentaire facultatif (motif du départ, jamais visible en dehors de cette section)">{{ row.comment }}</textarea>
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            {% include 'partials/empty_state.html.twig' with {
                                message: 'Aucun animé dans cette section pour cette année.',
                                compact: true,
                                colspan: reenrollment.visible ? 4 : 3,
                            } only %}
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>
{% endblock %}

{% block scripts %}
<script src="{{ asset('/assets/js/registration-departures.js') }}" defer nonce="{{ csp_nonce }}"></script>
{% endblock %}
