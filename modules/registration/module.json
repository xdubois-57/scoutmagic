  "settings": [
    {
      "key": "registration_form_open",
      "default_value": "0",
      "type": "boolean",
      "label": "Formulaire ouvert",
      "description": "Quand actif, la page publique affiche le formulaire d'inscription. Peut aussi être piloté par une ouverture/fermeture programmée ci-dessous."
    },
    {
      "key": "registration_scheduled_open_at",
      "default_value": "09-30",
      "type": "text",
      "label": "Ouverture programmée chaque année",
      "description": "Jour et mois (MM-JJ) auxquels le formulaire s'ouvre automatiquement, chaque année (par défaut le 30 septembre, 09-30) — jamais d'année à indiquer, la même configuration se répète d'une année scoute à l'autre. Laisser vide pour piloter l'ouverture manuellement uniquement (voir Configuration > Inscriptions)."
    },
    {
      "key": "registration_scheduled_close_at",
      "default_value": "08-31",
      "type": "text",
      "label": "Fermeture programmée chaque année",
      "description": "Jour et mois (MM-JJ) auxquels le formulaire se ferme automatiquement, chaque année (par défaut le 31 août, 08-31) — jamais d'année à indiquer. Laisser vide pour piloter la fermeture manuellement uniquement (voir Configuration > Inscriptions)."
    },
    {
      "key": "registration_scheduled_catch_up_days",
      "default_value": "7",
      "type": "number",
      "label": "Fenêtre de rattrapage de la programmation (jours)",
      "description": "Nombre de jours après la date programmée pendant lesquels une ouverture ou une fermeture manquée peut encore se déclencher — utile quand la tâche planifiée n'a pas tourné le jour même (serveur éteint, cron en pause). 0 désactive le rattrapage : la bascule ne se fait alors que le jour exact, et est perdue pour l'année si elle est ratée. Une valeur trop grande ferait qu'une date configurée longtemps après coup — ou l'activation du module en cours d'année — déclencherait rétroactivement la bascule. Maximum 30."
    },
    {
      "key": "registration_scheduled_open_applied_on",
      "default_value": "",
      "type": "text",
      "label": "Dernière ouverture automatique appliquée",
      "description": "Date (AAAA-MM-JJ) à laquelle l'ouverture programmée a été appliquée pour la dernière fois — empêche une nouvelle ouverture automatique le même jour. Géré automatiquement, ne pas modifier."
    },
    {
      "key": "registration_scheduled_close_applied_on",
      "default_value": "",
      "type": "text",
      "label": "Dernière fermeture automatique appliquée",
      "description": "Date (AAAA-MM-JJ) à laquelle la fermeture programmée a été appliquée pour la dernière fois — empêche une nouvelle fermeture automatique le même jour. Géré automatiquement, ne pas modifier."
    },
    {
      "key": "registration_waitlist_enabled",
      "default_value": "1",
      "type": "boolean",
      "label": "Gérer les listes d'attente",
      "description": "Quand actif, la page publique annonce à côté de chaque année de naissance si les places sont disponibles, l'attente limitée ou l'attente importante, et la page Inscriptions de l'Espace chefs d'U affiche le restant et le niveau vu par le public. Quand inactif, rien de tout cela n'apparaît nulle part et les deux seuils ci-dessous ne servent à rien. Se règle aussi depuis l'encart « Capacités par branche » de Configuration > Inscriptions."
    },
    {
      "key": "registration_reference_date",
      "default_value": "12-31",
      "type": "text",
      "label": "Date de référence pour le calcul de l'âge",
      "description": "Jour et mois (MM-JJ) utilisés pour déterminer l'âge d'un enfant au sein de l'année scoute ciblée, et donc son créneau (branche × rang). Par défaut le 31 décembre (12-31)."
    },
    {
      "key": "registration_waitlist_threshold_available",
      "default_value": "0.5",
      "type": "text",
      "label": "Seuil « places disponibles »",
      "description": "Ratio (0 à 1) de la capacité d'un créneau restant estimé au-delà duquel ce créneau est annoncé comme « places disponibles ». Ex. : 0.5 = au moins la moitié de la capacité encore libre."
    },
    {
      "key": "registration_waitlist_threshold_limited",
      "default_value": "0.1",
      "type": "text",
      "label": "Seuil « attente limitée »",
      "description": "Ratio (0 à 1) de la capacité d'un créneau restant estimé au-delà duquel ce créneau est annoncé comme « attente limitée » plutôt que « attente importante ». Doit être inférieur au seuil « places disponibles ». Ne sert que si « Gérer les listes d'attente » est actif ; se règle alors dans l'encart « Capacités par branche » de Configuration > Inscriptions."
    },
    {
      "key": "registration_unit_alert_email",
      "default_value": "",
      "type": "text",
      "label": "Adresse d'alerte de l'unité",
      "description": "Adresse email recevant une notification à chaque nouvelle demande d'inscription (prénom de l'enfant uniquement, jamais de coordonnées). Laisser vide pour désactiver cet envoi."
    },
    {
      "key": "registration_parcours_image_file_id",
      "default_value": "0",
      "type": "number",
      "label": "Image du parcours scout (interne)",
      "description": "Identifiant du fichier téléversé remplaçant l'image du parcours scout livrée par défaut. Géré via le flux de téléversement générique, jamais modifié à la main."
    },
    {
      "key": "registration_espace_animes_retention_months",
      "default_value": "3",
      "type": "number",
      "label": "Disparition de l'Espace des animés (mois)",
      "description": "Nombre de mois après le passage d'une demande refusée ou retirée dans son état final avant qu'elle ne disparaisse de l'Espace des animés de la famille. Une demande encodée dans Desk disparaît immédiatement, remplacée par la vraie fiche membre."
    },
    {
      "key": "registration_purge_retention_years",
      "default_value": "2",
      "type": "number",
      "label": "Suppression définitive (années)",
      "description": "Nombre d'années après le passage d'une demande dans son état final (encodée dans Desk, refusée ou retirée) avant sa suppression définitive et irréversible. Une demande non finalisée n'est jamais supprimée."
    }
  ],
