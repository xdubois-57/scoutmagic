{% extends 'base.html.twig' %}

{% block title %}{{ message.subject }} — Courrier — {{ site_name }}{% endblock %}

{% block content %}
{% include 'partials/page_header.html.twig' with { title: message.subject ?: 'Sans objet' } only %}

<p class="text-body-secondary">
    {{ message.displayFrom }} · {{ message.sentAt|datetime_fr }} ·
    reçu dans {{ mailboxes[message.mailboxId]|default('une boîte supprimée depuis') }}
    {% if message.isBulk %}<span class="badge text-bg-light">automatique</span>{% endif %}
</p>

{% if message.toEmails is not empty %}
    <p class="small text-body-secondary">
        Adressé à : {{ message.toEmails|join(', ') }}
    </p>
{% endif %}

<div class="card mb-4">
    <div class="card-body">
        {% include '@inbound_mail/partials/message_body.html.twig' with { message: message } only %}
    </div>
</div>

{% if message.hasAttachments or message.hasOmittedAttachments %}
    <h2 class="h6">Pièces jointes</h2>
    <div class="card mb-4"><div class="card-body py-2">
        {% include '@inbound_mail/partials/attachments.html.twig' with { message: message, downloadable: true } only %}
    </div></div>
{% endif %}

<h2 class="h6">Rattachements</h2>
{% if message.links is empty %}
    <p class="text-body-secondary">Ce message n'est rattaché à rien.</p>
{% else %}
    <ul class="list-group mb-2">
        {% for link in message.links %}
            {% set label = reference_labels[link.consumerId][link.businessReference]|default(link.businessReference) %}
            {% set url = reference_urls[link.consumerId][link.businessReference]|default(null) %}
            <li class="list-group-item d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div>
                    <div>
                        {{ consumer_names[link.consumerId]|default(link.consumerId) }} —
                        {% if url %}
                            <a href="{{ url }}">{{ label }}</a>
                        {% else %}
                            {{ label }}
                        {% endif %}
                        {% if link.attachmentId > 0 %}
                            <span class="text-body-secondary small">(une pièce jointe seulement)</span>
                        {% endif %}
                    </div>
                    <div class="small text-body-secondary">
                        {{ link.origin.label }}{% if not link.origin.isCertain %} · rattachement incertain{% endif %}
                    </div>
                </div>
                <form method="post" action="/courrier/{{ message.id }}/association/retrait"
                      data-confirm="Détacher ce message ? Il reste dans le courrier de l'unité.">
                    {{ csrf_field()|raw }}
                    <input type="hidden" name="consumer_id" value="{{ link.consumerId }}">
                    <input type="hidden" name="business_reference" value="{{ link.businessReference }}">
                    <button type="submit" class="btn btn-sm btn-outline-danger">Détacher</button>
                </form>
            </li>
        {% endfor %}
    </ul>
    <p class="small text-body-secondary">
        Détacher ne supprime ni le message ni ses autres rattachements.
    </p>
{% endif %}

{% if candidates is not empty %}
    <h2 class="h6 mt-4">Propositions à confirmer</h2>
    <ul class="list-group mb-2">
        {% for candidate in candidates %}
            <li class="list-group-item list-group-item-warning">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <div>
                        <div>
                            {{ consumer_names[candidate.consumerId]|default(candidate.consumerId) }}
                            — {{ candidate.label }}
                            {% if not candidate.isWholeMessage %}
                                <span class="text-body-secondary small">(une pièce jointe seulement)</span>
                            {% endif %}
                        </div>
                        <div class="small">{{ candidate.explanation }}</div>
                    </div>
                    <div class="d-flex gap-2">
                        <form method="post" action="/courrier/{{ message.id }}/proposition/confirmation">
                            {{ csrf_field()|raw }}
                            <input type="hidden" name="candidate_id" value="{{ candidate.id }}">
                            <button type="submit" class="btn btn-sm btn-primary">Rattacher</button>
                        </form>
                        <form method="post" action="/courrier/{{ message.id }}/proposition/rejet">
                            {{ csrf_field()|raw }}
                            <input type="hidden" name="candidate_id" value="{{ candidate.id }}">
                            <button type="submit" class="btn btn-sm btn-outline-secondary">Écarter</button>
                        </form>
                    </div>
                </div>
            </li>
        {% endfor %}
    </ul>
    {% if candidates|length > 1 %}
        <p class="small text-body-secondary">
            Plusieurs cibles sont possibles : ScoutMagic n'en choisit aucune tant que vous n'avez pas
            tranché.
        </p>
    {% endif %}
    <p class="small text-body-secondary">
        Écarter une proposition est définitif, et ne conserve pas le message : un message que rien
        ne rattache est supprimé au terme du délai de conservation.
    </p>
{% endif %}

{% if directories is not empty %}
    {# « Rattacher à… » — the gesture this screen existed for and did not
       offer: a message nobody recognised could be read and left to the
       retention, and that was all. The targets come from each module's
       own directory (Api\ReferenceDirectory), so this page knows nothing
       about what a stay or a booking is. #}
    <h2 class="h6 mt-4">Rattacher à…</h2>
    <form method="post" action="/courrier/{{ message.id }}/association" class="card" data-inbound-attach>
        <div class="card-body">
            {{ csrf_field()|raw }}
            <div class="row g-2 align-items-end">
                <div class="col-12 col-sm-4">
                    <label for="attach-module" class="form-label">Module</label>
                    <select name="consumer_id" id="attach-module" class="form-select form-select-sm" data-attach-module>
                        {% for id, name in directories %}
                            <option value="{{ id }}">{{ name }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-12 col-sm-6 position-relative">
                    <label for="attach-reference" class="form-label">Cible</label>
                    <input type="text" name="business_reference" id="attach-reference"
                           class="form-control form-control-sm" autocomplete="off" required
                           placeholder="Lieu, nom, référence, mois…" data-attach-reference>
                    <div class="list-group position-absolute w-100 shadow-sm d-none" style="z-index: 5"
                         data-attach-results aria-live="polite"></div>
                </div>
                <div class="col-12 col-sm-2">
                    <button type="submit" class="btn btn-sm btn-primary w-100">Rattacher</button>
                </div>
            </div>
            <div class="form-text d-none" data-attach-chosen></div>
            <div class="form-text">
                Tapez ce que vous diriez à voix haute — un lieu et un mois, le nom d'un locataire,
                une référence — et choisissez dans la liste. Rattacher n'enlève rien : un message
                peut appartenir à un séjour et à une facture à la fois.
            </div>
        </div>
    </form>
{% endif %}
{% endblock %}

{% block scripts %}
    <script src="{{ asset('/assets/js/inbound-mail-attach.js') }}" defer></script>
{% endblock %}
