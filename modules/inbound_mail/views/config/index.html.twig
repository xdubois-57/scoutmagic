{% extends 'base.html.twig' %}

{% block title %}Courrier entrant — {{ site_name }}{% endblock %}

{% block content %}
{% include 'partials/page_header.html.twig' with {
    title: 'Courrier entrant',
    action_label: 'Ajouter une adresse',
    action_url: '/config/courrier-entrant/boites/nouvelle',
} only %}

{# One sentence and a link (D12): the long explanations — read-only
   access, retention, why there is no native Gmail connector — live in the
   help topic, not on the page. #}
<p class="text-body-secondary">
    Le site lit ces adresses, sans jamais rien y modifier, pour ranger les réponses dans les bons dossiers.
    <a href="/aide/courrier-entrant">Comment ça marche</a>
</p>

{# Through the shared partial since issue #248, and reworded with it:
   this page said the mailbox was polled « à l'occasion d'une visite du
   site », which stopped being true when the poor man's cron was removed
   (ARCHITECTURE.md §8.5). Without a crontab the box is never polled. #}
{% include 'partials/cron_warning.html.twig' with {
    cron_detected: cron_detected,
    feature: 'La relève du courrier entrant',
    consequence: "Une réponse arrivée dans la boîte n'apparaîtra jamais sur cette page.",
} only %}

{% if mailboxes is empty %}
    {% include 'partials/empty_state.html.twig' with {
        message: "Aucune adresse n'est relevée pour l'instant.",
        action_label: 'Ajouter une adresse',
        action_url: '/config/courrier-entrant/boites/nouvelle',
    } only %}
{% else %}
    {# One card per address: its address as the title, what it is for in
       one sentence, its state, and on a failure what to do about it. No
       host or port: the address is what the operator recognises. #}
    <div class="card mb-4">
        <div class="list-group list-group-flush">
            {% for mailbox in mailboxes %}
                {% set failed = mailbox.isEnabled and mailbox.syncState.value == 'error' %}
                <div class="list-group-item py-3" data-mailbox="{{ mailbox.id }}">
                    <div class="d-flex flex-wrap justify-content-between align-items-start gap-2">
                        <div class="min-w-0">
                            <h2 class="h6 mb-0 text-break">{{ mailbox.displayName }}</h2>
                            <div class="form-text mt-0">{{ usages[mailbox.id]|default('') }}</div>
                        </div>
                        <div>
                            {% if not mailbox.isEnabled %}
                                {% include 'partials/status_badge.html.twig' with { status: 'inactive', label: 'Désactivée' } only %}
                            {% elseif failed %}
                                {% include 'partials/status_badge.html.twig' with {
                                    status: 'error',
                                    label: mailbox.lastErrorAt ? 'Échec ' ~ mailbox.lastErrorAt|relative_date : 'Échec de la relève',
                                } only %}
                            {% elseif mailbox.lastSyncedAt %}
                                {% include 'partials/status_badge.html.twig' with {
                                    status: 'success',
                                    label: 'Relevée ' ~ mailbox.lastSyncedAt|relative_date,
                                } only %}
                            {% else %}
                                {% include 'partials/status_badge.html.twig' with { status: 'neutral', label: 'Pas encore relevée' } only %}
                            {% endif %}
                        </div>
                    </div>

                    <p class="small mb-2 mt-2">
                        {% if mailbox.isDedicated %}
                            Les responsables du module voient tout ce qui y arrive, et le Staff d'U aussi.
                        {% else %}
                            Chaque module actif y reconnaît ses messages. Le Staff d'U voit tout dans
                            <a href="/courrier">Courrier reçu</a>.
                        {% endif %}
                    </p>

                    {% if failed and mailbox.lastError %}
                        {# The sentence MailboxErrorFormatter wrote — never a
                           library's own text — then what to do with it.
                           Rendered with the page and never updated after,
                           so it is no live region. #}
                        <div class="alert alert-danger small py-2 mb-2">
                            {{ mailbox.lastError }} Corrigez ensuite le réglage en cause avec « Modifier ».
                        </div>
                    {% endif %}

                    <div class="d-flex flex-wrap gap-1">
                        <a href="/config/courrier-entrant/boites/{{ mailbox.id }}/modification"
                           class="btn btn-sm {{ failed ? 'btn-primary' : 'btn-outline-secondary' }}">
                            <i class="bi bi-pencil" aria-hidden="true"></i> Modifier
                        </a>
                        <form method="post"
                              action="/config/courrier-entrant/boites/{{ mailbox.id }}/activation"
                              class="d-inline">
                            {{ csrf_field()|raw }}
                            {% if not mailbox.isEnabled %}
                                <input type="hidden" name="enable" value="1">
                            {% endif %}
                            <button type="submit" class="btn btn-sm btn-outline-secondary">
                                <i class="bi {{ mailbox.isEnabled ? 'bi-pause-circle' : 'bi-play-circle' }}" aria-hidden="true"></i>
                                {{ mailbox.isEnabled ? 'Désactiver' : 'Réactiver' }}
                            </button>
                        </form>
                        <form method="post"
                              action="/config/courrier-entrant/boites/{{ mailbox.id }}/suppression"
                              data-confirm="Supprimer cette adresse ? Les messages déjà rattachés à un dossier sont conservés."
                              class="d-inline">
                            {{ csrf_field()|raw }}
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                <i class="bi bi-trash" aria-hidden="true"></i> Supprimer
                            </button>
                        </form>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
{% endif %}
{% endblock %}
