{% extends 'base.html.twig' %}

{% block title %}Courrier entrant — {{ site_name }}{% endblock %}

{% block content %}
{% include 'partials/page_header.html.twig' with { title: 'Courrier entrant' } only %}

<div class="card mb-4">
    <div class="card-body">
        <h2 class="h6 mb-3">À quoi sert ce module ?</h2>
        <p class="mb-2">
            Il connecte ScoutMagic à une ou plusieurs boîtes mail de l'unité <strong>en lecture
            seule</strong>, pour que d'autres modules puissent rattacher automatiquement les
            réponses reçues aux dossiers concernés.
        </p>
        <ul class="mb-3">
            <li>Rien n'est jamais modifié dans la boîte distante : aucun message n'est marqué
                comme lu, déplacé ou supprimé.</li>
            <li><strong>Tout le courrier lu est conservé</strong>, y compris ce qu'aucun module ne
                reconnaît : un message ignoré était un message perdu, et personne ne s'en
                apercevait. Ce qu'aucun module ne rattache ni ne propose est supprimé
                automatiquement au bout du délai de conservation, et le Chef d'Unité est le seul à
                pouvoir consulter ce courrier-là.</li>
            <li>Les identifiants sont chiffrés et ne sont jamais réaffichés, même partiellement.</li>
        </ul>
        {# Le lien direct plutôt que « cherchez dans les paramètres de votre
           compte » : la page des mots de passe d'application n'est pas dans
           le menu de sécurité de Google, elle ne se trouve qu'en la
           cherchant, et c'est l'étape où une unité abandonne. #}
        <div class="alert alert-warning mb-0">
            <strong>Gmail et Outlook :</strong> utilisez un <em>mot de passe d'application</em>
            plutôt que le mot de passe du compte. Pour Gmail, il se crée sur
            <a href="https://myaccount.google.com/apppasswords" target="_blank" rel="noopener noreferrer">
                la page des mots de passe d'application de Google</a> — la création n'y est proposée
            que si la validation en deux étapes est active, et elle reste indisponible sur un compte
            en protection avancée, sur un compte protégé uniquement par une clé de sécurité, ou sur
            un compte Workspace dont l'administrateur l'a désactivée. Le connecteur natif Gmail
            n'existe pas volontairement — il imposerait à votre unité une évaluation de sécurité
            annuelle payante chez Google, sans quoi la synchronisation casserait chaque semaine.
        </div>
    </div>
</div>

{# Through the shared partial since issue #248, and reworded with it:
   this page said the mailbox was polled « à l'occasion d'une visite du
   site », which stopped being true when the poor man's cron was removed
   (ARCHITECTURE.md §8.5). Without a crontab the box is never polled. #}
{% include 'partials/cron_warning.html.twig' with {
    cron_detected: cron_detected,
    feature: 'La relève du courrier entrant',
    consequence: "Une réponse arrivée dans la boîte n'apparaîtra jamais sur cette page.",
} only %}

{# ── Configured mailboxes ───────────────────────────────────────────── #}
<div class="card mb-4">
    <div class="card-body">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
            <h2 class="h6 mb-0">Boîtes configurées</h2>
            <div class="d-flex flex-wrap gap-2">
                {% if can_refresh %}
                    <form method="post" action="/config/courrier-entrant/rafraichir" class="d-inline">
                        {{ csrf_field()|raw }}
                        <button type="submit" class="btn btn-sm btn-outline-secondary">
                            <i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Rafraîchir maintenant
                        </button>
                    </form>
                {% endif %}
                <a href="/config/courrier-entrant/boites/nouvelle" class="btn btn-sm btn-outline-primary">
                    <i class="bi bi-plus-lg" aria-hidden="true"></i> Ajouter une boîte
                </a>
            </div>
        </div>

        {% if mailboxes is empty %}
            {% include 'partials/empty_state.html.twig' with { message: "Aucune boîte n'est configurée pour l'instant.", compact: true } only %}
        {% else %}
            {# One block per box rather than a table: on a phone the table
               clipped its state, its last relève and every action out of
               reach, which is exactly what a superadmin opens this page
               on a phone to check. #}
            <div class="list-group list-group-flush">
                {% for mailbox in mailboxes %}
                    <div class="list-group-item px-0">
                        <div class="d-flex flex-wrap justify-content-between align-items-start gap-2">
                            <div class="min-w-0">
                                <div class="fw-semibold">
                                    {{ mailbox.name }}
                                    <span class="badge text-bg-light">{{ mailbox.purpose.label }}</span>
                                    {% if not mailbox.isEnabled %}
                                        {% include 'partials/status_badge.html.twig' with { status: 'inactive', label: 'désactivée' } only %}
                                    {% endif %}
                                </div>
                                <div class="form-text mb-0">
                                    {{ mailbox.username }} · {{ mailbox.host }}:{{ mailbox.port }} ({{ mailbox.encryption }})
                                </div>
                            </div>
                            <div class="text-sm-end">
                                {% include 'partials/status_badge.html.twig' with {
                                    status: { 'never': 'neutral', 'ok': 'success', 'error': 'error' }[mailbox.syncState.value],
                                    label: mailbox.syncState.label,
                                } only %}
                                <div class="form-text mb-0">
                                    {% if mailbox.lastSyncedAt %}
                                        dernière relève {{ mailbox.lastSyncedAt|datetime_fr }}
                                    {% else %}
                                        jamais relevée
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                        {% if mailbox.lastError %}
                            <div class="form-text text-danger">{{ mailbox.lastError }}</div>
                        {% endif %}

                        <div class="mt-2 d-flex flex-wrap align-items-center gap-1">
                            {% set summary = scope_summaries[mailbox.id]|default([]) %}
                            {% if summary is empty %}
                                <span class="text-body-secondary small">
                                    Aucun module — le courrier est conservé mais rien ne le classe.
                                </span>
                            {% else %}
                                {% for entry in summary %}
                                    <span class="badge {{ entry.read.value == 'all' ? 'text-bg-warning' : 'text-bg-secondary' }}">
                                        {{ entry.name }} · {{ entry.read.pillLabel }}
                                    </span>
                                {% endfor %}
                            {% endif %}
                            <span class="form-text mb-0 ms-1">
                                {{ stored_counts[mailbox.id]|default(0) }} message(s) conservé(s)
                            </span>
                        </div>

                        <div class="mt-2 d-flex flex-wrap gap-1">
                            <form method="post"
                                  action="/config/courrier-entrant/boites/{{ mailbox.id }}/test"
                                  class="d-inline">
                                {{ csrf_field()|raw }}
                                <button type="submit" class="btn btn-sm btn-outline-secondary">
                                    <i class="bi bi-plug" aria-hidden="true"></i> Tester la connexion
                                </button>
                            </form>
                            <a href="/config/courrier-entrant/boites/{{ mailbox.id }}/portee" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-sliders" aria-hidden="true"></i> Portée
                            </a>
                            <a href="/config/courrier-entrant/boites/{{ mailbox.id }}/modification" class="btn btn-sm btn-outline-secondary">
                                <i class="bi bi-pencil" aria-hidden="true"></i> Modifier
                            </a>
                            <form method="post"
                                  action="/config/courrier-entrant/boites/{{ mailbox.id }}/activation"
                                  class="d-inline">
                                {{ csrf_field()|raw }}
                                {% if not mailbox.isEnabled %}
                                    <input type="hidden" name="enable" value="1">
                                {% endif %}
                                <button type="submit" class="btn btn-sm btn-outline-secondary">
                                    <i class="bi {{ mailbox.isEnabled ? 'bi-pause-circle' : 'bi-play-circle' }}" aria-hidden="true"></i>
                                    {{ mailbox.isEnabled ? 'Désactiver' : 'Réactiver' }}
                                </button>
                            </form>
                            <form method="post"
                                  action="/config/courrier-entrant/boites/{{ mailbox.id }}/suppression"
                                  data-confirm="Supprimer cette boîte ? Les messages déjà rattachés à un dossier sont conservés."
                                  class="d-inline">
                                {{ csrf_field()|raw }}
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash" aria-hidden="true"></i> Supprimer
                                </button>
                            </form>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}
