{% extends 'base.html.twig' %}

{% block title %}Courrier entrant — {{ site_name }}{% endblock %}

{% block content %}
{% include 'partials/page_header.html.twig' with { title: 'Courrier entrant' } only %}

<div class="card mb-4">
    <div class="card-body">
        <h2 class="h6 mb-3">À quoi sert ce module ?</h2>
        <p class="mb-2">
            Il connecte ScoutMagic à une ou plusieurs boîtes mail de l'unité <strong>en lecture
            seule</strong>, pour que d'autres modules puissent rattacher automatiquement les
            réponses reçues aux dossiers concernés.
        </p>
        <ul class="mb-3">
            <li>Rien n'est jamais modifié dans la boîte distante : aucun message n'est marqué
                comme lu, déplacé ou supprimé.</li>
            <li>Un message qu'aucun module ne reconnaît est <strong>ignoré</strong> : il n'est ni
                enregistré, ni listé, ni notifié. ScoutMagic n'est pas une archive de votre boîte.</li>
            <li>Les identifiants sont chiffrés et ne sont jamais réaffichés, même partiellement.</li>
        </ul>
        <div class="alert alert-warning mb-0">
            <strong>Gmail et Outlook :</strong> utilisez un <em>mot de passe d'application</em>
            plutôt que le mot de passe du compte. Le connecteur natif Gmail n'existe pas
            volontairement — il imposerait à votre unité une évaluation de sécurité annuelle payante
            chez Google, sans quoi la synchronisation casserait chaque semaine.
        </div>
    </div>
</div>

{# ── Configured mailboxes ───────────────────────────────────────────── #}
<div class="card mb-4">
    <div class="card-body">
        <h2 class="h5 mb-3">Boîtes configurées</h2>

        {% if mailboxes is empty %}
            {% include 'partials/empty_state.html.twig' with { message: "Aucune boîte n'est configurée pour l'instant.", compact: true } only %}
        {% else %}
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th scope="col">Nom</th>
                            <th scope="col">Compte</th>
                            <th scope="col">État</th>
                            <th scope="col">Dernière synchro</th>
                            <th scope="col" class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for mailbox in mailboxes %}
                            <tr>
                                <td>
                                    {{ mailbox.name }}
                                    {% if not mailbox.isEnabled %}
                                        {% include 'partials/status_badge.html.twig' with { status: 'inactive', label: 'désactivée' } only %}
                                    {% endif %}
                                    <div class="form-text">
                                        {{ mailbox.host }}:{{ mailbox.port }} ({{ mailbox.encryption }})
                                    </div>
                                </td>
                                <td>{{ mailbox.username }}</td>
                                <td>
                                    {% include 'partials/status_badge.html.twig' with {
                                        status: { 'never': 'neutral', 'ok': 'success', 'error': 'error' }[mailbox.syncState.value],
                                        label: mailbox.syncState.label,
                                    } only %}
                                    {% if mailbox.lastError %}
                                        {# The operator-facing sentence, written by
                                           MailboxErrorFormatter — never a library's own
                                           exception text, which carries the account name. #}
                                        <div class="form-text text-danger">{{ mailbox.lastError }}</div>
                                    {% endif %}
                                </td>
                                <td>
                                    {% if mailbox.lastSyncedAt %}
                                        {{ mailbox.lastSyncedAt|datetime_fr }}
                                    {% else %}
                                        —
                                    {% endif %}
                                </td>
                                <td class="text-end">
                                    <div class="d-flex flex-wrap gap-2 justify-content-end">
                                        <button type="button" class="btn btn-sm btn-outline-secondary js-edit-mailbox"
                                                data-id="{{ mailbox.id }}"
                                                data-name="{{ mailbox.name|e('html_attr') }}"
                                                data-host="{{ mailbox.host|e('html_attr') }}"
                                                data-port="{{ mailbox.port }}"
                                                data-encryption="{{ mailbox.encryption|e('html_attr') }}"
                                                data-username="{{ mailbox.username|e('html_attr') }}"
                                                data-folders="{{ mailbox.folders|join("\n")|e('html_attr') }}"
                                                data-is-enabled="{{ mailbox.isEnabled ? '1' : '0' }}">
                                            Modifier
                                        </button>
                                        <form method="post"
                                              action="/config/courrier-entrant/boites/{{ mailbox.id }}/test">
                                            {{ csrf_field()|raw }}
                                            <button type="submit" class="btn btn-sm btn-outline-primary">
                                                Tester
                                            </button>
                                        </form>
                                        <form method="post"
                                              action="/config/courrier-entrant/boites/{{ mailbox.id }}/activation">
                                            {{ csrf_field()|raw }}
                                            {% if not mailbox.isEnabled %}
                                                <input type="hidden" name="enable" value="1">
                                            {% endif %}
                                            <button type="submit" class="btn btn-sm btn-outline-secondary">
                                                {{ mailbox.isEnabled ? 'Désactiver' : 'Réactiver' }}
                                            </button>
                                        </form>
                                        <form method="post"
                                              action="/config/courrier-entrant/boites/{{ mailbox.id }}/suppression"
                                              data-confirm="Supprimer cette boîte ? Les messages déjà rattachés à un dossier sont conservés.">
                                            {{ csrf_field()|raw }}
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                Supprimer
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>
</div>

{# ── Add a mailbox ──────────────────────────────────────────────────── #}
<div class="card mb-4">
    <div class="card-body">
        <h2 class="h5 mb-3" id="mailbox-form-title">Ajouter une boîte</h2>

        <form method="post" action="/config/courrier-entrant/boites" class="row g-3" id="mailbox-form">
            {{ csrf_field()|raw }}
            <input type="hidden" name="id" id="mailbox-id" value="0">

            <div class="col-12 col-md-6">
                {% include 'partials/form_field.html.twig' with {
                    field_id: 'mailbox-name', field_name: 'name',
                    label: 'Nom', required: true,
                    maxlength: 150, placeholder: 'Locations',
                    help: "Le seul élément que verront les gestionnaires : ni l'hôte, ni le compte.",
                } only %}
            </div>

            <div class="col-12 col-md-6">
                {% include 'partials/form_field.html.twig' with {
                    field_id: 'mailbox-username', field_name: 'username',
                    label: 'Compte', required: true,
                    autocomplete: 'off', placeholder: 'locations@unite.be',
                } only %}
            </div>

            <div class="col-12 col-md-6">
                {% include 'partials/form_field.html.twig' with {
                    field_id: 'mailbox-host', field_name: 'host',
                    label: 'Serveur IMAP', required: true,
                    placeholder: 'imap.gmail.com',
                } only %}
            </div>

            <div class="col-6 col-md-3">
                {% include 'partials/form_field.html.twig' with {
                    field_id: 'mailbox-port', field_name: 'port', type: 'number',
                    label: 'Port', required: true,
                    value: 993, min: 1, max: 65535,
                } only %}
            </div>

            <div class="col-6 col-md-3">
                {% include 'partials/form_field.html.twig' with {
                    field_id: 'mailbox-encryption', field_name: 'encryption', type: 'select',
                    label: 'Chiffrement',
                    options: [
                        { value: 'ssl', label: 'SSL', selected: true },
                        { value: 'tls', label: 'TLS' },
                        { value: 'starttls', label: 'STARTTLS' },
                    ],
                    help: "Un certificat invalide fait échouer la connexion : il n'y a pas d'option pour l'ignorer.",
                } only %}
            </div>

            <div class="col-12 col-md-6">
                <label class="form-label" for="mailbox-password">Mot de passe</label>
                <input type="password" class="form-control" id="mailbox-password" name="password"
                       autocomplete="new-password" required>
                <div class="form-text">
                    Il ne sera plus jamais réaffiché. Laissez le champ vide lors d'une modification
                    pour conserver celui déjà enregistré.
                </div>
            </div>

            <div class="col-12">
                <div class="d-flex align-items-center gap-3 mb-2">
                    <button type="button" class="btn btn-outline-primary" id="test-connection-btn">
                        <i class="bi bi-plug" aria-hidden="true"></i>
                        Tester la connexion
                    </button>
                    <span id="test-connection-result"></span>
                </div>
            </div>

            <div class="col-12 col-md-6">
                {# Textarea fallback (no-JS) + backing store for the checkbox picker.
                   JS hides it and shows the checkbox container instead. #}
                <div id="mailbox-folders-wrapper">
                    {% include 'partials/form_field.html.twig' with {
                        field_id: 'mailbox-folders', field_name: 'folders', type: 'textarea',
                        label: 'Dossiers surveillés', rows: 3, placeholder: 'INBOX',
                        help: 'Un par ligne, avec leur nom exact sur le serveur. Vide = INBOX.',
                    } only %}
                </div>
                {# Populated by JS after a successful connection test. #}
                <div id="mailbox-folders-picker" class="d-none">
                    <span class="form-label d-block mb-1">Dossiers surveillés</span>
                    <div id="mailbox-folders-list" class="border rounded p-2" style="max-height: 12rem; overflow-y: auto;"></div>
                    <div class="form-text">Cochez les dossiers à surveiller. Vide = INBOX.</div>
                </div>
            </div>

            <div class="col-12">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="mailbox-enabled"
                           name="is_enabled" checked>
                    <label class="form-check-label" for="mailbox-enabled">
                        Synchroniser cette boîte
                    </label>
                </div>
            </div>

            <div class="col-12">
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary" id="mailbox-submit-btn">Ajouter la boîte</button>
                    <button type="button" class="btn btn-outline-secondary d-none" id="mailbox-cancel-btn">Annuler</button>
                </div>
            </div>
        </form>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script src="/assets/js/inbound-mail-config.js"></script>
{% endblock %}
