{% extends 'base.html.twig' %}
{% block title %}Bac à sable e-mail — {{ site_name }}{% endblock %}

{% block content %}
{% include 'partials/page_header.html.twig' with { title: 'Bac à sable e-mail' } only %}

{# ------------------------------------------------------------------ #}
{# State block: the switch, what it currently does, and — only when     #}
{# armed — the consequence an operator has to know before they lock     #}
{# themselves out.                                                      #}
{# ------------------------------------------------------------------ #}
<div class="card mb-4">
    <div class="card-body">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div>
                <p class="mb-1 fw-semibold">
                    {% if armed %}
                        <i class="bi bi-shield-fill-exclamation text-danger" aria-hidden="true"></i>
                        Capture active — aucun e-mail ne quitte le serveur.
                    {% else %}
                        <i class="bi bi-send text-success" aria-hidden="true"></i>
                        Capture inactive — les e-mails partent normalement.
                    {% endif %}
                </p>
                <p class="mb-0 small text-body-secondary">
                    Quand la capture est active, chaque message est assemblé par la vraie
                    librairie d'envoi, signature DKIM comprise, puis rangé ici au lieu d'être
                    remis au serveur de messagerie.
                </p>
            </div>
            <form method="post" action="/test-tools/mail-sandbox/capture" class="mb-0">
                {{ csrf_field()|raw }}
                <input type="hidden" name="armed" value="{{ armed ? '0' : '1' }}">
                <button type="submit"
                        class="btn {{ armed ? 'btn-outline-secondary' : 'btn-danger' }}">
                    {{ armed ? 'Désactiver la capture' : 'Activer la capture' }}
                </button>
            </form>
        </div>

        {% if armed %}
            <div class="alert alert-warning mt-3 mb-0" role="alert">
                <p class="fw-semibold mb-1">Les liens magiques arrivent désormais sur cette page.</p>
                <p class="mb-0 small">
                    Tant que la capture est active, un e-mail de connexion ne sera pas remis à son
                    destinataire : il attendra ici. Connectez-vous avec un mot de passe ou une
                    passkey — pas avec un lien magique — sinon vous risquez de ne plus pouvoir
                    revenir désactiver la capture.
                </p>
            </div>
        {% endif %}
    </div>
</div>

{# ------------------------------------------------------------------ #}
{# Search                                                              #}
{# ------------------------------------------------------------------ #}
<form method="get" action="/test-tools/mail-sandbox" class="row g-2 align-items-end mb-3">
    <div class="col-12 col-lg-4">
        <label for="sandboxSubject" class="form-label small mb-1">Objet</label>
        <input type="search" class="form-control" id="sandboxSubject" name="subject"
               value="{{ filters.subject }}" placeholder="Un mot de l'objet">
    </div>
    <div class="col-12 col-lg-4">
        <label for="sandboxRecipient" class="form-label small mb-1">Destinataire (adresse exacte)</label>
        <input type="email" class="form-control" id="sandboxRecipient" name="recipient"
               value="{{ filters.recipient }}" placeholder="prenom@exemple.be">
    </div>
    <div class="col-12 col-lg-4 d-flex flex-wrap align-items-center gap-3">
        <button type="submit" class="btn btn-primary">Rechercher</button>
        {% if filters.isFiltered %}
            <a href="/test-tools/mail-sandbox" class="btn btn-link px-0">Effacer</a>
        {% endif %}
    </div>
    <div class="col-12">
        <div class="form-check">
            <input class="form-check-input" type="checkbox" value="1" id="sandboxBodies" name="bodies"
                   {{ filters.searchBodies ? 'checked' : '' }}>
            <label class="form-check-label small" for="sandboxBodies">
                Chercher aussi dans le corps des messages — lecture déchiffrée, limitée aux
                {{ body_search_bound }} messages les plus récents. Le champ « Objet » sert alors
                de terme recherché, et le filtre sur l'objet ne s'applique plus.
            </label>
        </div>
    </div>
</form>

{# ------------------------------------------------------------------ #}
{# List                                                                #}
{# ------------------------------------------------------------------ #}
{% if emails is empty %}
    {% if total > 0 %}
        {# Past the last page — the set is not empty, this slice of it is. #}
        {% include 'partials/empty_state.html.twig' with {
            message: 'Cette page ne contient aucun message.',
            icon: 'bi-envelope-paper',
        } only %}
        <p class="text-center">
            <a href="/test-tools/mail-sandbox?{{ filters.queryWithoutPage }}" class="btn btn-outline-secondary">
                Revenir à la première page
            </a>
        </p>
    {% elseif filters.isFiltered %}
        {% include 'partials/empty_state.html.twig' with {
            message: 'Aucun message ne correspond à cette recherche.',
            icon: 'bi-envelope-paper',
        } only %}
        <p class="text-center">
            <a href="/test-tools/mail-sandbox" class="btn btn-outline-secondary">
                Voir tous les messages
            </a>
        </p>
    {% elseif armed %}
        {% include 'partials/empty_state.html.twig' with {
            message: "La capture est active mais rien n'est encore passé. Déclenchez un envoi — une demande de lien magique, un e-mail de test — et il apparaîtra ici.",
            icon: 'bi-envelope-paper',
        } only %}
    {% else %}
        {% include 'partials/empty_state.html.twig' with {
            message: "Rien n'a encore été capturé. Activez la capture ci-dessus, puis déclenchez un envoi depuis le site : le message viendra ici au lieu de partir.",
            icon: 'bi-envelope-paper',
        } only %}
    {% endif %}
{% else %}
    <p class="small text-body-secondary">
        {{ total }} message{{ total > 1 ? 's' : '' }}{{ filters.isFiltered ? ' correspondant à la recherche' : '' }}.
    </p>

    <div class="list-group mb-3">
        {% for email in emails %}
            <a href="/test-tools/mail-sandbox/{{ email.id }}"
               class="list-group-item list-group-item-action py-3">
                <div class="d-flex justify-content-between align-items-start gap-2">
                    <span class="fw-semibold">{{ email.subject }}</span>
                    <span class="text-nowrap small text-body-secondary">
                        {{ email.capturedAt|datetime_fr }}
                    </span>
                </div>
                <div class="small text-body-secondary">{{ email.recipient }}</div>
                <div class="d-flex flex-wrap gap-2 mt-2">
                    <span class="badge text-bg-light">{{ (email.sizeBytes / 1024)|round(1) }} Ko</span>
                    {% if email.attachmentCount > 0 %}
                        <span class="badge text-bg-light">
                            <i class="bi bi-paperclip" aria-hidden="true"></i> {{ email.attachmentCount }}
                        </span>
                    {% endif %}
                    {% if email.hasDkim %}
                        <span class="badge text-bg-success">DKIM</span>
                    {% else %}
                        <span class="badge text-bg-secondary">Sans DKIM</span>
                    {% endif %}
                    {% if email.hasFailed %}
                        <span class="badge text-bg-danger">Échec d'assemblage</span>
                    {% endif %}
                </div>
            </a>
        {% endfor %}
    </div>

    {% set query = filters.queryWithoutPage %}
    {% include 'partials/pagination.html.twig' with {
        page: filters.page,
        total_pages: page_count,
        base_url: '?' ~ query ~ (query ? '&' : '') ~ 'page=',
        label: 'Pagination des messages capturés',
    } only %}
{% endif %}

{# ------------------------------------------------------------------ #}
{# Danger zone — same shape as Configuration > Maintenance's own       #}
{# (ARCHITECTURE.md §8.18): the word is typed, and it is the SERVER    #}
{# that compares it. The script below only gates the button's disabled #}
{# state, so a caller that skips it changes nothing.                   #}
{# ------------------------------------------------------------------ #}
{% if total > 0 %}
    <div class="card border-danger mt-4">
        <div class="card-body">
            <h2 class="h6 text-danger mb-2">
                <i class="bi bi-exclamation-triangle" aria-hidden="true"></i> Vider le bac à sable
            </h2>
            <p class="small text-body-secondary">
                Supprime définitivement les {{ total }} message{{ total > 1 ? 's' : '' }} conservé{{ total > 1 ? 's' : '' }},
                ainsi que leurs pièces jointes et leurs fichiers chiffrés. Sans restauration manuelle,
                cette action est irréversible.
            </p>
            <form method="post" action="/test-tools/mail-sandbox/empty" id="sandbox-empty-form"
                  class="row g-2 align-items-end">
                {{ csrf_field()|raw }}
                <div class="col-12 col-lg-4">
                    <label class="form-label small" for="sandbox-empty-keyword">
                        Tapez <strong>{{ confirmation_word }}</strong> pour confirmer
                    </label>
                    <input type="text" class="form-control" id="sandbox-empty-keyword" name="confirmation"
                           autocomplete="off">
                </div>
                <div class="col-12 col-lg-4">
                    <button type="submit" class="btn btn-outline-danger" id="sandbox-empty-submit"
                            disabled>
                        Tout supprimer
                    </button>
                </div>
            </form>
        </div>
    </div>
{% endif %}
{% endblock %}

{% block scripts %}
<script nonce="{{ csp_nonce }}">
    (function () {
        var keyword = document.getElementById('sandbox-empty-keyword');
        var submit = document.getElementById('sandbox-empty-submit');
        if (!keyword || !submit) {
            return;
        }
        // Convenience only: the server compares the word again and refuses
        // the request outright when it does not match.
        keyword.addEventListener('input', function () {
            submit.disabled = keyword.value !== {{ confirmation_word|json_encode|raw }};
        });
    })();
</script>
{% endblock %}
