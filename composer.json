{
    "name": "les-scouts/unit-website",
    "description": "Open-source website for Belgian scout units (Les Scouts federation)",
    "type": "project",
    "license": "AGPL-3.0-or-later",
    "authors": [
        {
            "name": "Xavier Dubois",
            "role": "Author & Maintainer"
        }
    ],
    "require": {
        "php": "^8.4",
        "twig/twig": "^3.0",
        "phpmailer/phpmailer": "^7.1",
        "smalot/pdfparser": "^2.12",
        "dompdf/dompdf": "^3.1",
        "endroid/qr-code": "^6.1",
        "phpoffice/phpspreadsheet": "^5.9",
        "aws/aws-sdk-php": "^3.0",
        "minishlink/web-push": "^11.0",
        "ifsnop/mysqldump-php": "^2.13"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.3",
        "phpstan/phpstan": "^2.2"
    },
    "autoload": {
        "psr-4": {
            "Core\\": "core/",
            "Modules\\": "modules/",
            "Modules\\Banner\\": "modules/banner/src/",
            "Modules\\Calendar\\": "modules/calendar/src/",
            "Modules\\Finance\\": "modules/finance/src/",
            "Modules\\Gallery\\": "modules/gallery/src/",
            "Modules\\LlmConnector\\": "modules/llm_connector/src/",
            "Modules\\MassMail\\": "modules/mass_mail/src/",
            "Modules\\MemberStats\\": "modules/member_stats/src/",
            "Modules\\News\\": "modules/news/src/",
            "Modules\\Registration\\": "modules/registration/src/",
            "Modules\\Retro\\": "modules/retro/src/",
            "Modules\\SosStaff\\": "modules/sos_staff/src/",
            "Modules\\Trombinoscope\\": "modules/trombinoscope/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "serve": "php -d upload_max_filesize=100M -d post_max_size=110M -S localhost:8000 -t public"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
